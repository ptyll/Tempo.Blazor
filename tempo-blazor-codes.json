    {
      "itemName": "TmBarcode",
      "kind": "Component",
      "category": "Data Display",
      "namespace": "Tempo.Blazor.Components.DataDisplay",
      "description": "Renders a barcode as an SVG element. Supports multiple formats (Code128, Code39, EAN13, UPC, QR) with optional value display below the barcode.",
      "packageId": "Tempo.Blazor.Codes",
      "sourcePath": "src/Tempo.Blazor.Codes/Components/DataDisplay/TmBarcode.razor",
      "documentationStatus": "merged",
      "requiredImports": [
        "@using Tempo.Blazor.Components.DataDisplay"
      ],
      "parameters": [
        {
          "name": "CssClass",
          "type": "string?",
          "isRequired": false,
          "description": "Optional CSS class."
        },
        {
          "name": "DisplayValue",
          "type": "bool",
          "isRequired": false,
          "description": "Whether to display the value as text below the barcode."
        },
        {
          "name": "Format",
          "type": "BarcodeFormat",
          "isRequired": false,
          "default": "BarcodeFormat.Code128",
          "description": "The barcode format. Default is Code128."
        },
        {
          "name": "Height",
          "type": "int",
          "isRequired": false,
          "default": "100",
          "description": "The height in pixels. Default is 100."
        },
        {
          "name": "Value",
          "type": "string",
          "isRequired": false,
          "default": "\"\"",
          "description": "The value to encode."
        },
        {
          "name": "Width",
          "type": "int",
          "isRequired": false,
          "default": "200",
          "description": "The width in pixels. Default is 200."
        }
      ],
      "cssClasses": [
        "tm-barcode",
        "tm-barcode__error"
      ],
      "examples": [
        {
          "title": "Code 128 barcode",
          "code": "<TmBarcode Value=\"TEST1234\" Format=\"BarcodeFormat.Code128\" DisplayValue=\"true\" />"
        },
        {
          "title": "Custom size barcode",
          "code": "<TmBarcode Value=\"ABC-999\" Format=\"BarcodeFormat.Code39\" Width=\"300\" Height=\"120\" />"
        }
      ]
    },
    {
      "itemName": "TmQRCode",
      "kind": "Component",
      "category": "Data Display",
      "namespace": "Tempo.Blazor.Components.DataDisplay",
      "description": "Renders a QR code as an SVG element. Supports custom size, foreground/background colors, and multiple error correction levels.",
      "packageId": "Tempo.Blazor.Codes",
      "sourcePath": "src/Tempo.Blazor.Codes/Components/DataDisplay/TmQRCode.razor",
      "documentationStatus": "merged",
      "requiredImports": [
        "@using Tempo.Blazor.Components.DataDisplay"
      ],
      "parameters": [
        {
          "name": "BackgroundColor",
          "type": "string",
          "isRequired": false,
          "default": "\"#ffffff\"",
          "description": "Background color in hex format. Default is #ffffff."
        },
        {
          "name": "CssClass",
          "type": "string?",
          "isRequired": false,
          "description": "Optional CSS class."
        },
        {
          "name": "ErrorCorrectionLevel",
          "type": "QRErrorCorrectionLevel",
          "isRequired": false,
          "default": "QRErrorCorrectionLevel.M",
          "description": "Error correction level. Default is M (15% recovery)."
        },
        {
          "name": "ForegroundColor",
          "type": "string",
          "isRequired": false,
          "default": "\"#000000\"",
          "description": "Foreground color in hex format. Default is #000000."
        },
        {
          "name": "Size",
          "type": "int",
          "isRequired": false,
          "default": "200",
          "description": "The size in pixels. Default is 200."
        },
        {
          "name": "Value",
          "type": "string",
          "isRequired": false,
          "default": "\"\"",
          "description": "The text or URL to encode."
        }
      ],
      "cssClasses": [
        "tm-qr-code"
      ],
      "examples": [
        {
          "title": "Basic QR code",
          "code": "<TmQRCode Value=\"https://example.com\" />"
        },
        {
          "title": "Large QR code with custom colors",
          "code": "<TmQRCode Value=\"https://example.com\" Size=\"300\" ForegroundColor=\"#3b82f6\" BackgroundColor=\"#f0f9ff\" />"
        },
        {
          "title": "High error correction",
          "code": "<TmQRCode Value=\"important-data\" ErrorCorrectionLevel=\"QRErrorCorrectionLevel.H\" />"
        }
      ]
    }
