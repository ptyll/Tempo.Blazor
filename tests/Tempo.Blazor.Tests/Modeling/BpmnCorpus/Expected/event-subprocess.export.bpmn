<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Process_Main" targetNamespace="http://tempo.example/bpmn/corpus" exporter="Tempo.Blazor" exporterVersion="2.11.0" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tempo="https://tempo.blazor/schemas/bpmn-extensions" name="Main process">
  <process id="Process_Main" name="Main process" isExecutable="false">
    <startEvent id="StartEvent_Main" name="Start">
      <outgoing>Flow_ES1</outgoing>
    </startEvent>
    <userTask id="Task_Review" name="Review document">
      <incoming>Flow_ES1</incoming>
      <outgoing>Flow_ES2</outgoing>
    </userTask>
    <subProcess id="SubProcess_OnSignal" name="Escalation handler" triggeredByEvent="true">
      <startEvent id="StartEvent_Escalation" name="Escalation arrives" isInterrupting="false">
        <outgoing>Flow_ES10</outgoing>
        <escalationEventDefinition id="EscDef" escalationRef="Escalation_Warn" />
      </startEvent>
      <task id="Task_Notify" name="Notify manager">
        <incoming>Flow_ES10</incoming>
        <outgoing>Flow_ES11</outgoing>
      </task>
      <endEvent id="EndEvent_Escalation" name="Handled">
        <incoming>Flow_ES11</incoming>
      </endEvent>
      <sequenceFlow id="Flow_ES10" sourceRef="StartEvent_Escalation" targetRef="Task_Notify" />
      <sequenceFlow id="Flow_ES11" sourceRef="Task_Notify" targetRef="EndEvent_Escalation" />
    </subProcess>
    <endEvent id="EndEvent_Main" name="Done">
      <incoming>Flow_ES2</incoming>
    </endEvent>
    <sequenceFlow id="Flow_ES1" sourceRef="StartEvent_Main" targetRef="Task_Review" />
    <sequenceFlow id="Flow_ES2" sourceRef="Task_Review" targetRef="EndEvent_Main" />
  </process>
  <escalation id="Escalation_Warn" escalationCode="W-1" name="Warning" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_BPMNPlane_1" name="Event subprocess">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Main">
      <bpmndi:BPMNShape id="StartEvent_Main_di" bpmnElement="StartEvent_Main">
        <dc:Bounds x="152" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review">
        <dc:Bounds x="240" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_OnSignal_di" bpmnElement="SubProcess_OnSignal" isExpanded="true">
        <dc:Bounds x="420" y="100" width="400" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Escalation_di" bpmnElement="StartEvent_Escalation">
        <dc:Bounds x="472" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Notify_di" bpmnElement="Task_Notify">
        <dc:Bounds x="560" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Escalation_di" bpmnElement="EndEvent_Escalation">
        <dc:Bounds x="742" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Main_di" bpmnElement="EndEvent_Main">
        <dc:Bounds x="922" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ES1_di" bpmnElement="Flow_ES1">
        <di:waypoint x="188" y="180" />
        <di:waypoint x="240" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ES2_di" bpmnElement="Flow_ES2">
        <di:waypoint x="340" y="180" />
        <di:waypoint x="420" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ES10_di" bpmnElement="Flow_ES10">
        <di:waypoint x="508" y="200" />
        <di:waypoint x="560" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ES11_di" bpmnElement="Flow_ES11">
        <di:waypoint x="660" y="200" />
        <di:waypoint x="742" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>