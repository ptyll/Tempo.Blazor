<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Process_PartialDi" targetNamespace="http://tempo.example/bpmn/corpus/partial-di" exporter="Tempo.Blazor" exporterVersion="2.11.0" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tempo="https://tempo.blazor/schemas/bpmn-extensions" name="Partial DI">
  <process id="Process_PartialDi" name="Partial DI" isExecutable="false">
    <startEvent id="StartEvent_Partial" name="Started">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <task id="Task_Build" name="Build">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </task>
    <task id="Task_QA" name="QA">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_Done</outgoing>
    </task>
    <endEvent id="EndEvent_Done" name="Done">
      <incoming>Flow_Done</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="StartEvent_Partial" targetRef="Task_Build" />
    <sequenceFlow id="Flow_2" sourceRef="Task_Build" targetRef="Task_QA" />
    <sequenceFlow id="Flow_Done" sourceRef="Task_QA" targetRef="EndEvent_Done" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_BPMNPlane_Partial" name="Partial DI">
    <bpmndi:BPMNPlane id="BPMNPlane_Partial" bpmnElement="Process_PartialDi">
      <bpmndi:BPMNShape id="StartEvent_Partial_di" bpmnElement="StartEvent_Partial">
        <dc:Bounds x="172" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Build_di" bpmnElement="Task_Build">
        <dc:Bounds x="260" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_QA_di" bpmnElement="Task_QA">
        <dc:Bounds x="320" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Done_di" bpmnElement="EndEvent_Done">
        <dc:Bounds x="460" y="272" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="208" y="170" />
        <di:waypoint x="260" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="360" y="170" />
        <di:waypoint x="320" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Done_di" bpmnElement="Flow_Done">
        <di:waypoint x="420" y="290" />
        <di:waypoint x="460" y="290" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>