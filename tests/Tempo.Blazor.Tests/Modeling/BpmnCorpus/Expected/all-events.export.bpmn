    <sequenceFlow id="Flow_E16" sourceRef="Throw_Message" targetRef="Throw_Signal" />
    <sequenceFlow id="Flow_E17" sourceRef="Throw_Signal" targetRef="Throw_Escalation" />
    <sequenceFlow id="Flow_E18" sourceRef="Throw_Escalation" targetRef="Throw_Link" />
    <sequenceFlow id="Flow_E19" sourceRef="Throw_Link" targetRef="Task_Events_End" />
    <sequenceFlow id="Flow_E20" sourceRef="Catch_Message" targetRef="Task_Events_End" />
    <sequenceFlow id="Flow_E21" sourceRef="Task_Events_End" targetRef="End_None" />
    <sequenceFlow id="Flow_E22" sourceRef="Task_Events_End" targetRef="End_Message" />
    <sequenceFlow id="Flow_E23" sourceRef="Task_Events_End" targetRef="End_Error" />
    <sequenceFlow id="Flow_E24" sourceRef="Task_Events_End" targetRef="End_Signal" />
    <sequenceFlow id="Flow_E25" sourceRef="Task_Events_End" targetRef="End_Terminate" />
