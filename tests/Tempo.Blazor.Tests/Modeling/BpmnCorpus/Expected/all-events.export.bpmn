<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Process_Events" targetNamespace="http://tempo.example/bpmn/corpus" exporter="Tempo.Blazor" exporterVersion="{version}" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tempo="https://tempo.blazor/schemas/bpmn-extensions" name="Event zoo">
  <process id="Process_Events" name="Event zoo" isExecutable="false">
    <startEvent id="Start_None" name="Plain start">
      <outgoing>Flow_E01</outgoing>
    </startEvent>
    <startEvent id="Start_Message" name="Message start">
      <outgoing>Flow_E02</outgoing>
      <messageEventDefinition id="MsgStartDef" messageRef="Message_StartMsg" />
    </startEvent>
    <startEvent id="Start_Timer" name="Timer start">
      <outgoing>Flow_E03</outgoing>
      <timerEventDefinition id="TimerStartDef">
        <timeCycle xsi:type="tFormalExpression">0 0 6 * * ?</timeCycle>
      </timerEventDefinition>
    </startEvent>
    <startEvent id="Start_Signal" name="Signal start">
      <outgoing>Flow_E04</outgoing>
      <signalEventDefinition id="SignalStartDef" signalRef="Signal_Alarm" />
    </startEvent>
    <startEvent id="Start_Conditional" name="Conditional start">
      <outgoing>Flow_E05</outgoing>
      <conditionalEventDefinition id="CondStartDef">
        <condition xsi:type="tFormalExpression">stock &lt; 5</condition>
      </conditionalEventDefinition>
    </startEvent>
    <task id="Task_Events_Hub" name="Hub">
      <incoming>Flow_E01</incoming>
      <incoming>Flow_E02</incoming>
      <incoming>Flow_E03</incoming>
      <incoming>Flow_E04</incoming>
      <incoming>Flow_E05</incoming>
      <outgoing>Flow_E10</outgoing>
      <outgoing>Flow_E11</outgoing>
      <outgoing>Flow_E12</outgoing>
      <outgoing>Flow_E13</outgoing>
      <outgoing>Flow_E14</outgoing>
      <outgoing>Flow_E15</outgoing>
    </task>
    <intermediateCatchEvent id="Catch_Message" name="Catch message">
      <incoming>Flow_E10</incoming>
      <outgoing>Flow_E20</outgoing>
      <messageEventDefinition id="MsgCatchDef" messageRef="Message_InfoMsg" />
    </intermediateCatchEvent>
    <intermediateCatchEvent id="Catch_Timer" name="Catch timer">
      <incoming>Flow_E11</incoming>
      <timerEventDefinition id="TimerCatchDef">
        <timeDate xsi:type="tFormalExpression">2027-01-01T00:00:00Z</timeDate>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="Catch_Signal" name="Catch signal">
      <incoming>Flow_E12</incoming>
      <signalEventDefinition id="SignalCatchDef" signalRef="Signal_Alarm" />
    </intermediateCatchEvent>
    <intermediateCatchEvent id="Catch_Conditional" name="Catch condition">
      <incoming>Flow_E13</incoming>
      <conditionalEventDefinition id="CondCatchDef">
        <condition xsi:type="tFormalExpression">approved</condition>
      </conditionalEventDefinition>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="Catch_Link" name="Catch link">
      <incoming>Flow_E14</incoming>
      <linkEventDefinition id="LinkCatchDef" name="hop" />
    </intermediateCatchEvent>
    <intermediateThrowEvent id="Throw_Message" name="Throw message">
      <incoming>Flow_E15</incoming>
      <outgoing>Flow_E16</outgoing>
      <messageEventDefinition id="MsgThrowDef" messageRef="Message_InfoMsg" />
    </intermediateThrowEvent>
    <intermediateThrowEvent id="Throw_Signal" name="Throw signal">
      <incoming>Flow_E16</incoming>
      <outgoing>Flow_E17</outgoing>
      <signalEventDefinition id="SignalThrowDef" signalRef="Signal_Alarm" />
    </intermediateThrowEvent>
    <intermediateThrowEvent id="Throw_Escalation" name="Throw escalation">
      <incoming>Flow_E17</incoming>
      <outgoing>Flow_E18</outgoing>
      <escalationEventDefinition id="EscThrowDef" escalationRef="Escalation_Late" />
    </intermediateThrowEvent>
    <intermediateThrowEvent id="Throw_Link" name="Throw link">
      <incoming>Flow_E18</incoming>
      <outgoing>Flow_E19</outgoing>
      <linkEventDefinition id="LinkThrowDef" name="hop" />
    </intermediateThrowEvent>
    <task id="Task_Events_End" name="Finish">
      <incoming>Flow_E19</incoming>
      <incoming>Flow_E20</incoming>
      <outgoing>Flow_E21</outgoing>
      <outgoing>Flow_E22</outgoing>
      <outgoing>Flow_E23</outgoing>
      <outgoing>Flow_E24</outgoing>
      <outgoing>Flow_E25</outgoing>
    </task>
    <endEvent id="End_None" name="Plain end">
      <incoming>Flow_E21</incoming>
    </endEvent>
    <endEvent id="End_Message" name="Message end">
      <incoming>Flow_E22</incoming>
      <messageEventDefinition id="MsgEndDef" messageRef="Message_InfoMsg" />
    </endEvent>
    <endEvent id="End_Error" name="Error end">
      <incoming>Flow_E23</incoming>
      <errorEventDefinition id="ErrorEndDef" errorRef="Error_Broken" />
    </endEvent>
    <endEvent id="End_Signal" name="Signal end">
      <incoming>Flow_E24</incoming>
      <signalEventDefinition id="SignalEndDef" signalRef="Signal_Alarm" />
    </endEvent>
    <endEvent id="End_Terminate" name="Terminate">
      <incoming>Flow_E25</incoming>
      <terminateEventDefinition id="TerminateDef" />
    </endEvent>
    <sequenceFlow id="Flow_E01" sourceRef="Start_None" targetRef="Task_Events_Hub" />
    <sequenceFlow id="Flow_E02" sourceRef="Start_Message" targetRef="Task_Events_Hub" />
