<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Process_Bizagi" targetNamespace="http://tempo.example/bpmn/corpus/bizagi" exporter="Tempo.Blazor" exporterVersion="{version}" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tempo="https://tempo.blazor/schemas/bpmn-extensions" name="Customer onboarding" xmlns:bizagi="http://www.bizagi.com/schemas/2010/Bizagi">
  <process id="Process_Bizagi" name="Customer onboarding" isExecutable="false">
    <startEvent id="StartEvent_NewCustomer" name="New customer" bizagi:property="displayName:Start;category:Events">
      <outgoing>Flow_BZ1</outgoing>
    </startEvent>
    <userTask id="Task_CollectDocs" name="Collect documents" bizagi:property="displayName:Collect;category:Activities">
      <incoming>Flow_BZ1</incoming>
      <outgoing>Flow_BZ2</outgoing>
      <extensionElements>
        <bizagi:BizagiExtensions>
          <bizagi:BizagiProperty name="FormId" value="frm-collect" />
          <bizagi:BizagiProperty name="ApplicationId" value="onboarding-app" />
        </bizagi:BizagiExtensions>
      </extensionElements>
    </userTask>
    <serviceTask id="Task_Verify" name="Verify identity" bizagi:property="category:Activities">
      <incoming>Flow_BZ2</incoming>
      <outgoing>Flow_BZ3</outgoing>
    </serviceTask>
    <endEvent id="EndEvent_Onboarded" name="Onboarded" bizagi:property="category:Events">
      <incoming>Flow_BZ3</incoming>
    </endEvent>
    <sequenceFlow id="Flow_BZ1" sourceRef="StartEvent_NewCustomer" targetRef="Task_CollectDocs" />
    <sequenceFlow id="Flow_BZ2" sourceRef="Task_CollectDocs" targetRef="Task_Verify" />
    <sequenceFlow id="Flow_BZ3" sourceRef="Task_Verify" targetRef="EndEvent_Onboarded" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_BPMNPlane_1" name="Customer onboarding">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Bizagi">
      <bpmndi:BPMNShape id="StartEvent_NewCustomer_di" bpmnElement="StartEvent_NewCustomer">
        <dc:Bounds x="152" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CollectDocs_di" bpmnElement="Task_CollectDocs">
        <dc:Bounds x="240" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Verify_di" bpmnElement="Task_Verify">
        <dc:Bounds x="400" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Onboarded_di" bpmnElement="EndEvent_Onboarded">
        <dc:Bounds x="572" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_BZ1_di" bpmnElement="Flow_BZ1">
        <di:waypoint x="188" y="170" />
        <di:waypoint x="240" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BZ2_di" bpmnElement="Flow_BZ2">
        <di:waypoint x="340" y="170" />
        <di:waypoint x="400" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BZ3_di" bpmnElement="Flow_BZ3">
        <di:waypoint x="500" y="170" />
        <di:waypoint x="572" y="170" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>