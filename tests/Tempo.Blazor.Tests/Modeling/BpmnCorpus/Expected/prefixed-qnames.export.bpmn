<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Process_Prefixed" targetNamespace="http://tempo.example/bpmn/corpus/prefixed" exporter="Tempo.Blazor" exporterVersion="{version}" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tempo="https://tempo.blazor/schemas/bpmn-extensions" name="Prefixed process">
  <process id="Process_Prefixed" name="Prefixed process" isExecutable="false">
    <startEvent id="StartEvent_Prefixed" name="Start">
      <outgoing>Flow_P1</outgoing>
    </startEvent>
    <intermediateCatchEvent id="Catch_Notify" name="Wait for notify">
      <incoming>Flow_P1</incoming>
      <outgoing>Flow_P2</outgoing>
      <messageEventDefinition id="MsgDef_Prefixed" messageRef="tns_Message_Notify" />
    </intermediateCatchEvent>
    <task id="Task_Prefixed" name="Handle notify">
      <incoming>Flow_P2</incoming>
      <outgoing>Flow_P3</outgoing>
    </task>
    <endEvent id="EndEvent_Prefixed" name="Done">
      <incoming>Flow_P3</incoming>
    </endEvent>
    <sequenceFlow id="Flow_P1" sourceRef="StartEvent_Prefixed" targetRef="Catch_Notify" />
    <sequenceFlow id="Flow_P2" sourceRef="Catch_Notify" targetRef="Task_Prefixed" />
    <sequenceFlow id="Flow_P3" sourceRef="Task_Prefixed" targetRef="EndEvent_Prefixed" />
  </process>
  <message id="tns_Message_Notify" name="Notify" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_BPMNPlane_Prefixed" name="Prefixed dialect">
    <bpmndi:BPMNPlane id="BPMNPlane_Prefixed" bpmnElement="Process_Prefixed">
      <bpmndi:BPMNShape id="StartEvent_Prefixed_di" bpmnElement="StartEvent_Prefixed">
        <dc:Bounds x="152" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Catch_Notify_di" bpmnElement="Catch_Notify">
        <dc:Bounds x="250" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Prefixed_di" bpmnElement="Task_Prefixed">
        <dc:Bounds x="350" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Prefixed_di" bpmnElement="EndEvent_Prefixed">
        <dc:Bounds x="512" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_P1_di" bpmnElement="Flow_P1">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="250" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P2_di" bpmnElement="Flow_P2">
        <di:waypoint x="286" y="120" />
        <di:waypoint x="350" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P3_di" bpmnElement="Flow_P3">
        <di:waypoint x="450" y="120" />
        <di:waypoint x="512" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>