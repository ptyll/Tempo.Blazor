<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Process_Nested" targetNamespace="http://tempo.example/bpmn/corpus" exporter="Tempo.Blazor" exporterVersion="2.11.0" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tempo="https://tempo.blazor/schemas/bpmn-extensions" name="Nested">
  <process id="Process_Nested" name="Nested" isExecutable="false">
    <startEvent id="StartEvent_Nested" name="Start">
      <outgoing>Flow_N1</outgoing>
    </startEvent>
    <subProcess id="SubProcess_L1" name="Level 1">
      <startEvent id="StartEvent_L1" name="L1 start">
        <outgoing>Flow_NL1</outgoing>
      </startEvent>
      <subProcess id="SubProcess_L2" name="Level 2">
        <startEvent id="StartEvent_L2" name="L2 start">
          <outgoing>Flow_NL2</outgoing>
        </startEvent>
        <subProcess id="SubProcess_L3" name="Level 3">
          <startEvent id="StartEvent_L3" name="L3 start">
            <outgoing>Flow_N2</outgoing>
          </startEvent>
          <task id="Task_L3" name="Deep work">
            <incoming>Flow_N2</incoming>
            <outgoing>Flow_N3</outgoing>
          </task>
          <endEvent id="EndEvent_L3" name="L3 end">
            <incoming>Flow_N3</incoming>
          </endEvent>
          <sequenceFlow id="Flow_N2" sourceRef="StartEvent_L3" targetRef="Task_L3" />
          <sequenceFlow id="Flow_N3" sourceRef="Task_L3" targetRef="EndEvent_L3" />
        </subProcess>
        <endEvent id="EndEvent_L1" name="L1 end">
          <incoming>Flow_NL3</incoming>
        </endEvent>
        <sequenceFlow id="Flow_NL2" sourceRef="StartEvent_L2" targetRef="SubProcess_L3" />
        <sequenceFlow id="Flow_NL3" sourceRef="SubProcess_L3" targetRef="EndEvent_L1" />
      </subProcess>
      <endEvent id="EndEvent_L0" name="Top end">
        <incoming>Flow_NL4</incoming>
      </endEvent>
      <sequenceFlow id="Flow_NL1" sourceRef="StartEvent_L1" targetRef="SubProcess_L2" />
      <sequenceFlow id="Flow_NL4" sourceRef="SubProcess_L2" targetRef="EndEvent_L0" />
    </subProcess>
    <endEvent id="EndEvent_Nested" name="Done">
      <incoming>Flow_N4</incoming>
    </endEvent>
    <sequenceFlow id="Flow_N1" sourceRef="StartEvent_Nested" targetRef="SubProcess_L1" />
    <sequenceFlow id="Flow_N4" sourceRef="SubProcess_L1" targetRef="EndEvent_Nested" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_BPMNPlane_Nested" name="Nested subprocesses">
    <bpmndi:BPMNPlane id="BPMNPlane_Nested" bpmnElement="Process_Nested">
      <bpmndi:BPMNShape id="StartEvent_Nested_di" bpmnElement="StartEvent_Nested">
        <dc:Bounds x="152" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_L1_di" bpmnElement="SubProcess_L1" isExpanded="true">
        <dc:Bounds x="260" y="120" width="520" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_L1_di" bpmnElement="StartEvent_L1">
        <dc:Bounds x="300" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_L2_di" bpmnElement="SubProcess_L2" isExpanded="true">
        <dc:Bounds x="380" y="170" width="340" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_L2_di" bpmnElement="StartEvent_L2">
        <dc:Bounds x="412" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_L3_di" bpmnElement="SubProcess_L3" isExpanded="true">
        <dc:Bounds x="490" y="200" width="200" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_L3_di" bpmnElement="Task_L3">
        <dc:Bounds x="550" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Nested_di" bpmnElement="EndEvent_Nested">
        <dc:Bounds x="852" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_L3_di" bpmnElement="StartEvent_L3">
        <dc:Bounds x="3336" y="440" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_L3_di" bpmnElement="EndEvent_L3">
        <dc:Bounds x="3616" y="440" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_L1_di" bpmnElement="EndEvent_L1">
        <dc:Bounds x="3712" y="440" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_L0_di" bpmnElement="EndEvent_L0">
        <dc:Bounds x="3808" y="440" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_N1_di" bpmnElement="Flow_N1">
        <di:waypoint x="188" y="260" />
        <di:waypoint x="260" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_N4_di" bpmnElement="Flow_N4">
        <di:waypoint x="780" y="260" />
        <di:waypoint x="852" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_N2_di" bpmnElement="Flow_N2">
        <di:waypoint x="3336" y="458" />
        <di:waypoint x="650" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_N3_di" bpmnElement="Flow_N3">
        <di:waypoint x="650" y="260" />
        <di:waypoint x="3616" y="458" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NL2_di" bpmnElement="Flow_NL2">
        <di:waypoint x="448" y="260" />
        <di:waypoint x="490" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NL3_di" bpmnElement="Flow_NL3">
        <di:waypoint x="690" y="260" />
        <di:waypoint x="3712" y="458" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NL1_di" bpmnElement="Flow_NL1">
        <di:waypoint x="336" y="260" />
        <di:waypoint x="380" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NL4_di" bpmnElement="Flow_NL4">
        <di:waypoint x="720" y="260" />
        <di:waypoint x="3808" y="458" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>