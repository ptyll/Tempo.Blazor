<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Process_AnnotationText" targetNamespace="http://tempo.example/bpmn/corpus" exporter="Tempo.Blazor" exporterVersion="2.11.0" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tempo="https://tempo.blazor/schemas/bpmn-extensions" name="Annotated process">
  <process id="Process_AnnotationText" name="Annotated process" isExecutable="false">
    <startEvent id="StartEvent_Annotated" name="Begin">
      <outgoing>Flow_Annotated_1</outgoing>
    </startEvent>
    <task id="Task_Annotated" name="Do work">
      <incoming>Flow_Annotated_1</incoming>
      <outgoing>Flow_Annotated_2</outgoing>
    </task>
    <endEvent id="EndEvent_Annotated" name="Done">
      <incoming>Flow_Annotated_2</incoming>
    </endEvent>
    <textAnnotation id="TextAnnotation_Standard">
      <text>Standard form: the annotation body lives in a &lt;text&gt; child element.</text>
    </textAnnotation>
    <association id="Association_Standard" sourceRef="TextAnnotation_Standard" targetRef="Task_Annotated" associationDirection="None" />
    <sequenceFlow id="Flow_Annotated_1" sourceRef="StartEvent_Annotated" targetRef="Task_Annotated" />
    <sequenceFlow id="Flow_Annotated_2" sourceRef="Task_Annotated" targetRef="EndEvent_Annotated" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_BPMNPlane_AnnotationText" name="Annotated process">
    <bpmndi:BPMNPlane id="BPMNPlane_AnnotationText" bpmnElement="Process_AnnotationText">
      <bpmndi:BPMNShape id="StartEvent_Annotated_di" bpmnElement="StartEvent_Annotated">
        <dc:Bounds x="172" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Annotated_di" bpmnElement="Task_Annotated">
        <dc:Bounds x="260" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Annotated_di" bpmnElement="EndEvent_Annotated">
        <dc:Bounds x="420" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TextAnnotation_Standard_di" bpmnElement="TextAnnotation_Standard">
        <dc:Bounds x="240" y="250" width="220" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Annotated_1_di" bpmnElement="Flow_Annotated_1">
        <di:waypoint x="208" y="170" />
        <di:waypoint x="260" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Annotated_2_di" bpmnElement="Flow_Annotated_2">
        <di:waypoint x="360" y="170" />
        <di:waypoint x="420" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_Standard_di" bpmnElement="Association_Standard">
        <di:waypoint x="350" y="250" />
        <di:waypoint x="330" y="210" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>