<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Process_Signavio" targetNamespace="http://tempo.example/bpmn/corpus/signavio" exporter="Tempo.Blazor" exporterVersion="{version}" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tempo="https://tempo.blazor/schemas/bpmn-extensions" name="Request approval" xmlns:signavio="http://www.signavio.com">
  <process id="Process_Signavio" name="Request approval" isExecutable="false">
    <startEvent id="StartEvent_Request" name="Request submitted">
      <outgoing>Flow_SV1</outgoing>
      <extensionElements>
        <signavio:signavioMetaData metaKey="elementgeometry" metaValue="" />
      </extensionElements>
    </startEvent>
    <task id="Task_Validate" name="Validate request">
      <incoming>Flow_SV1</incoming>
      <outgoing>Flow_SV2</outgoing>
      <extensionElements>
        <signavio:signavioMetaData metaKey="meta-role" metaValue="Compliance" />
      </extensionElements>
    </task>
    <userTask id="Task_Decide" name="Decide" signavio:assignmentRule="round-robin">
      <incoming>Flow_SV2</incoming>
      <outgoing>Flow_SV3</outgoing>
      <extensionElements>
        <signavio:signavioMetaData metaKey="meta-sla" metaValue="P1D" />
      </extensionElements>
    </userTask>
    <endEvent id="EndEvent_Decided" name="Decided">
      <incoming>Flow_SV3</incoming>
    </endEvent>
    <sequenceFlow id="Flow_SV1" sourceRef="StartEvent_Request" targetRef="Task_Validate" />
    <sequenceFlow id="Flow_SV2" sourceRef="Task_Validate" targetRef="Task_Decide" />
    <sequenceFlow id="Flow_SV3" sourceRef="Task_Decide" targetRef="EndEvent_Decided" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_BPMNPlane_1" name="Request approval">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Signavio">
      <bpmndi:BPMNShape id="StartEvent_Request_di" bpmnElement="StartEvent_Request">
        <dc:Bounds x="152" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Validate_di" bpmnElement="Task_Validate">
        <dc:Bounds x="240" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Decide_di" bpmnElement="Task_Decide">
        <dc:Bounds x="400" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Decided_di" bpmnElement="EndEvent_Decided">
        <dc:Bounds x="572" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_SV1_di" bpmnElement="Flow_SV1">
        <di:waypoint x="188" y="170" />
        <di:waypoint x="240" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SV2_di" bpmnElement="Flow_SV2">
        <di:waypoint x="340" y="170" />
        <di:waypoint x="400" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SV3_di" bpmnElement="Flow_SV3">
        <di:waypoint x="500" y="170" />
        <di:waypoint x="572" y="170" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>