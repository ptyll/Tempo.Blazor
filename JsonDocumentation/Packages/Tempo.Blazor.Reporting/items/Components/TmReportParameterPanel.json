{
  "itemName": "TmReportParameterPanel",
  "kind": "Component",
  "category": "Components",
  "namespace": "Tempo.Blazor.Reporting.Components",
  "description": "Auto-generated report parameter panel for text, number, date, bool, select, and multi-select parameter metadata. It emits changed values and submit events used by TmReportViewer.",
  "packageId": "Tempo.Blazor.Reporting",
  "sourcePath": "src/Tempo.Blazor.Reporting/Components/TmReportParameterPanel.razor",
  "documentationStatus": "manual",
  "requiredImports": [
    "@using Tempo.Blazor.Reporting.Components",
    "@using Tempo.Blazor.Reporting.Models"
  ],
  "relatedTypes": [
    "ReportViewerParameterMetadata",
    "ReportViewerParameterOption",
    "ReportParameterChangedEventArgs",
    "ReportParameterSubmitEventArgs"
  ],
  "parameters": [
    {
      "name": "Parameters",
      "type": "IReadOnlyList<ReportViewerParameterMetadata>",
      "isRequired": false,
      "default": "[]",
      "description": "Parameter metadata to render."
    },
    {
      "name": "Values",
      "type": "IReadOnlyDictionary<string, ReportParameterValue>?",
      "isRequired": false,
      "description": "Current parameter values."
    },
    {
      "name": "OnParameterChanged",
      "type": "EventCallback<ReportParameterChangedEventArgs>",
      "isRequired": false,
      "description": "Fired when a parameter value changes."
    },
    {
      "name": "OnSubmit",
      "type": "EventCallback<ReportParameterSubmitEventArgs>",
      "isRequired": false,
      "description": "Fired when the user submits parameters."
    },
    {
      "name": "Disabled",
      "type": "bool",
      "isRequired": false,
      "description": "Disables parameter controls."
    },
    {
      "name": "Class",
      "type": "string?",
      "isRequired": false,
      "description": "Additional CSS classes."
    }
  ]
}
