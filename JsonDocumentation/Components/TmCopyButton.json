{
  "itemName": "TmCopyButton",
  "kind": "Component",
  "category": "Buttons",
  "description": "Button that copies specified text to the clipboard. Icon-only by default; ShowLabel adds the localized Copy/Copied text. Shows a checkmark for 2 seconds after a successful copy. Uses the browser Clipboard API via JS interop.",
  "requiredImports": [
    "@using Tempo.Blazor.Components.Buttons"
  ],
  "parameters": [
    {
      "name": "Text",
      "type": "string",
      "isRequired": true,
      "description": "Text to copy to clipboard.",
      "editorRequired": true
    },
    {
      "name": "Class",
      "type": "string?",
      "isRequired": false,
      "description": "Additional CSS class."
    },
    {
      "name": "Disabled",
      "type": "bool",
      "isRequired": false,
      "description": "Disables the button."
    },
    {
      "name": "ShowLabel",
      "type": "bool",
      "isRequired": false,
      "description": "Renders the localized Copy/Copied label next to the icon. Defaults to false (icon only)."
    }
  ],
  "cssClasses": [
    "tm-copy-button",
    "tm-copy-button--copied",
    "tm-copy-button--labelled",
    "tm-copy-button-label"
  ],
  "examples": [
    {
      "title": "Copy an API key",
      "code": "<TmCopyButton Text=\"sk-abc123xyz\" />"
    },
    {
      "title": "Copy button with custom class",
      "code": "<TmCopyButton Text=\"@generatedCode\" Class=\"my-custom-class\" />"
    }
  ]
}
