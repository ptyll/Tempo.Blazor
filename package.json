{
  "name": "tempo-blazor-documenteditor-build",
  "private": true,
  "version": "0.0.0",
  "description": "Build and test tooling for Tempo.Blazor JS modules (reporting bundles, document editor Node tests). Not published.",
  "type": "module",
  "scripts": {
    "build:reporting": "node scripts/build-reporting.mjs",
    "build:document-editor": "node scripts/build-document-editor.mjs",
    "check:document-editor-bundle": "node scripts/build-document-editor.mjs --check",
    "test:reporting-modules": "node scripts/run-node-tests.mjs src/Tempo.Blazor.Reporting/wwwroot/js/reporting",
    "test:overlay": "node scripts/run-node-tests.mjs src/Tempo.Blazor/wwwroot/js",
    "test:document-editor": "node scripts/run-node-tests.mjs src/Tempo.Blazor.DocumentEditor/wwwroot/js/document-editor src/Tempo.Blazor.DocumentEditor/wwwroot/js/document-editor-canvas scripts",
    "test:document-editor-modules": "npm run test:document-editor"
  },
  "devDependencies": {
    "esbuild": "^0.21.0"
  }
}
