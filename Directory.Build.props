         a non-public component. It compiled the internal <ViewportProbe /> tag into a literal HTML
         element, so the probe never rendered and no-scope overlays stayed on their initial mode. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer"
                      Version="3.0.110"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>
</Project>
