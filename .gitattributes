# Generated headless layout bundle: keep LF in every working copy so the embedded
# resource bytes (and the esbuild drift comparison) are identical across platforms.
src/Tempo.Blazor.DocumentFormats/HeadlessLayout/*.bundle.mjs text eol=lf

# Generated CSS bundle (BundleCss): the build rewrites it and CI diffs it against the commit —
# CRLF churn on Windows checkouts would false-positive that freshness gate.
src/Tempo.Blazor/wwwroot/css/tempo-blazor.bundled.css text eol=lf

# Generated component-documentation bundles: the generator runs on Windows, and CRLF here is a
# several-hundred-thousand-line diff against any branch that touches them.
tempo-blazor*.json text eol=lf

# Every text file is LF in the index AND in every working copy, whatever core.autocrlf says:
# a CRLF working copy made the workflow-reading guards and the TmTabs byte baseline red, and
# `git add` of a CRLF copy stored CRLF in history (98cc1c99, the commit before 975a75be).
* text=auto eol=lf

# Release evidence is captured tool output and must stay byte-verbatim (13 files are i/mixed today).
eng/release-evidence/** -text
