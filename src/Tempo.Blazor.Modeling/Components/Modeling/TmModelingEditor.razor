@using Tempo.Blazor.Components.Diagram.Models
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Components.Diagram
@using Tempo.Blazor.Modeling

<section class="@RootClass"
         data-testid="@TestId("modeling-editor")"
         @ref="_editorRoot"
         data-state="@StateName"
         data-load-count="@_completedLoadCount"
         data-generation-count="@_completedGenerationCount"
         data-provider="@EffectiveProviderKey"
         data-notation="@EffectiveNotationKey"
         data-viewpoint="@EffectiveViewpointKey"
         data-selected-element-id="@(_selectedElement?.Id ?? string.Empty)"
         data-selected-relationship-id="@(_selectedRelationship?.Id ?? string.Empty)"
         data-element-count="@(_model?.Elements.Count ?? 0)"
         data-relationship-count="@(_model?.Relationships.Count ?? 0)"
         data-diagram-node-count="@(_document?.Nodes.Count ?? 0)"
         data-diagram-edge-count="@(_document?.Edges.Count ?? 0)"
         data-issue-count="@IssueCount"
         data-active-panel="@ActivePanelName"
         data-open-editor="@((_openedEditorDocument is not null).ToString().ToLowerInvariant())">
    <header class="tm-modeling-editor__toolbar" data-testid="@TestId("modeling-editor-toolbar")">
        <div class="tm-modeling-editor__title-group">
            <h2 class="tm-modeling-editor__title">@Loc["TmModelingEditor_Title"]</h2>
            @* Phase 2 (gap #1): the state is a colored badge NEXT TO the title, not a plain
               subtitle line under it. *@
            <span class="tm-modeling-editor__state">
                <TmBadge Variant="@StateBadgeVariant" Style="BadgeStyle.Subtle" Pill="true">@Loc[StateLabelKey]</TmBadge>
            </span>
        </div>
        @* MO3: one provider surface. When the selector is enabled the labeled select owns the
           value (and the model reloads on change); otherwise the provider stays a labeled
           chip. The notation/viewpoint chips are gone — the labeled selects own those values. *@
        @* Review fix (phase 3): the provider surface and the notation/viewpoint selector form one
           right-aligned header group that wraps together — the toolbar keeps only the title. *@
        <div class="tm-modeling-editor__context">
            @if (ShowProviderSelector)
            {
                <label class="tm-modeling-editor__field">
                    <span>@Loc["TmModelingEditor_Provider"]</span>
                    <select data-testid="@TestId("modeling-provider-select")"
                            value="@EffectiveProviderKey"
                            @onchange="HandleProviderChangedAsync">
                        @if (string.IsNullOrWhiteSpace(EffectiveProviderKey))
                        {
                            <option value="">@Loc["TmModelingEditor_SelectProvider"]</option>
                        }
                        @foreach (var option in ProviderOptions)
                        {
                            <option value="@option">@ResolveProviderDisplayName(option)</option>
                        }
                    </select>
                </label>
            }
            else
            {
                <div class="tm-modeling-editor__chips">
                    <span class="tm-modeling-editor__chip">
                        <span>@Loc["TmModelingEditor_Provider"]</span>
                        <strong>@DisplayProviderKey</strong>
                    </span>
                </div>
            }
            <TmModelingViewSelector NotationKey="@EffectiveNotationKey"
                                    ViewpointKey="@EffectiveViewpointKey"
                                    OnNotationChanged="ChangeNotationAsync"
                                    OnViewpointChanged="ChangeViewpointAsync" />
        </div>
    </header>

    @* keepLoadedSurface reloads (force reload over an already loaded model) keep _model alive
       while _state flips back to Loading — rendering the single-state screen here would tear down
       the whole workspace DOM (tree, preview, issue panel) only to rebuild it a moment later,
       which dominates the reload budget on large models. The workspace stays mounted and the
       source panel shows its IsLoading affordance instead. *@
    @if (_state == ModelingEditorState.Loading && _model is null)
    {
        <div class="tm-modeling-editor__single-state" data-testid="@TestId("modeling-editor-loading")" aria-live="polite">
            <TmSpinner Size="SpinnerSize.Lg" />
            <div>
                <h3>@Loc["TmModelingEditor_LoadingTitle"]</h3>
                <p>@Loc["TmModelingEditor_LoadingText"]</p>
                @if (_showLongLoadingMessage)
                {
                    <p class="tm-modeling-editor__detail" data-testid="@TestId("modeling-editor-timeout-message")">@Loc["TmModelingEditor_LongLoadingText"]</p>
                }
            </div>
        </div>
    }
    else if (_state == ModelingEditorState.Empty)
    {
        <div class="tm-modeling-editor__single-state" data-testid="@TestId("modeling-editor-empty")" aria-live="polite">
            @* Phase 2 (gap #7): state marks are icons, not text glyphs ("0" / "!"). *@
            <div class="tm-modeling-editor__state-mark" aria-hidden="true">
                <TmIcon Name="@StateMarkIcon" Size="IconSize.Lg" />
            </div>
            <div>
                <h3>@Loc["TmModelingEditor_EmptyTitle"]</h3>
                <p>@Loc["TmModelingEditor_EmptyText"]</p>
            </div>
        </div>
    }
    else if (_state == ModelingEditorState.Error)
    {
        <div class="tm-modeling-editor__single-state tm-modeling-editor__single-state--error" data-testid="@TestId("modeling-editor-error")" role="alert">
            <div class="tm-modeling-editor__state-mark" aria-hidden="true">
                <TmIcon Name="@StateMarkIcon" Size="IconSize.Lg" />
            </div>
            <div>
                <h3>@Loc["TmModelingEditor_ErrorTitle"]</h3>
                <p>@Loc["TmModelingEditor_ErrorText"]</p>
                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <p class="tm-modeling-editor__detail">@_errorMessage</p>
                }
            </div>
        </div>
    }
    else
    {
        <nav class="tm-modeling-editor__panel-tabs"
             data-testid="@TestId("modeling-panel-tabs")"
             aria-label="@Loc["TmModelingEditor_Panels"]">
            <button type="button"
                    class="@GetPanelTabClass(ModelingEditorPanel.Tree)"
                    data-testid="@TestId("modeling-panel-tab-tree")"
                    aria-pressed="@(_activePanel == ModelingEditorPanel.Tree).ToString().ToLowerInvariant()"
                    @onclick="() => ActivatePanelAsync(ModelingEditorPanel.Tree)">
                @Loc["TmModelingEditor_ModelTree"]
            </button>
            <button type="button"
                    class="@GetPanelTabClass(ModelingEditorPanel.Preview)"
                    data-testid="@TestId("modeling-panel-tab-preview")"
                    aria-pressed="@(_activePanel == ModelingEditorPanel.Preview).ToString().ToLowerInvariant()"
                    @onclick="() => ActivatePanelAsync(ModelingEditorPanel.Preview)">
                @Loc["TmModelingEditor_Preview"]
            </button>
            <button type="button"
                    class="@GetPanelTabClass(ModelingEditorPanel.Inspector)"
                    data-testid="@TestId("modeling-panel-tab-inspector")"
                    aria-pressed="@(_activePanel == ModelingEditorPanel.Inspector).ToString().ToLowerInvariant()"
                    @onclick="() => ActivatePanelAsync(ModelingEditorPanel.Inspector)">
                @Loc["TmModelingEditor_Inspector"]
            </button>
        </nav>

        <div class="tm-modeling-editor__workspace">
            @* Force reload over a live model keeps the workspace mounted (see the single-state
               branch above). The workspace alone must not lose the loading affordance: this badge
               surfaces the same modeling-editor-loading contract while the reload runs. *@
            @if (_state == ModelingEditorState.Loading)
            {
                @* Carry-forward (phase 2 review): the state text is NOT repeated here — the
                   title badge owns it. The indicator keeps the spinner and an sr-only
                   announcement for assistive tech. *@
                <div class="tm-modeling-editor__reload-indicator" data-testid="@TestId("modeling-editor-loading")" role="status" aria-live="polite">
                    <TmSpinner Size="SpinnerSize.Sm" />
                    <span class="tm-sr-only">@Loc["TmModelingEditor_LoadingTitle"]</span>
                </div>
            }
            <aside class="@GetPanelClass(ModelingEditorPanel.Tree, "tm-modeling-editor__panel tm-modeling-editor__tree")" data-testid="@TestId("modeling-model-tree-panel")" aria-label="@Loc["TmModelingEditor_ModelTree"]">
                <TmModelingModelTree Elements="@VisibleTreeElements"
                                     SelectedElement="@_selectedElement"
                                     @bind-CollapsedGroups="_collapsedGroups"
                                     OnElementSelected="SelectElementAsync"
                                     OnElementDragStarted="HandleElementDragStartedAsync"
                                     OnElementDragEnded="HandleElementDragEndedAsync" />
            </aside>

            @* N190: a labelled <section> region — the host layout owns the page's single
               <main> landmark; components never emit it (036ce5fd/a59cac9a rule). *@
            <section class="@GetPanelClass(ModelingEditorPanel.Preview, "tm-modeling-editor__panel tm-modeling-editor__preview")" data-testid="@TestId("modeling-preview-panel")" aria-label="@Loc["TmModelingEditor_Preview"]">
                <TmModelingDiagramPreview Document="@_document"
                                          DocumentChanged="UpdatePreviewDocumentAsync"
                                          ActiveDraggedElement="@_draggedElement"
                                          AllowNodeDrop="@AllowNodeDrop"
                                          OpenInEditorTriggerId="@_openEditorTriggerId"
                                          OnNodeDropped="HandleNodeDroppedAsync"
                                          OnGenerateRequested="GenerateDiagramFromLoadedModelAsync"
                                          OnRelationshipSelected="SelectRelationshipAsync"
                                          OnOpenInEditor="OpenGeneratedDiagramAsync" />
            </section>

            <aside class="@GetPanelClass(ModelingEditorPanel.Inspector, "tm-modeling-editor__panel tm-modeling-editor__inspector")" data-testid="@TestId("modeling-inspector-panel")" aria-label="@Loc["TmModelingEditor_Inspector"]">
                <TmModelingSourcePanel Metadata="@_model?.Metadata"
                                       IsLoading="@(_state == ModelingEditorState.Loading || _isReloading)"
                                       OnLoadRequested="ReloadModelAsync" />
                <TmModelingInspector Element="@_selectedElement"
                                     Relationship="@_selectedRelationship"
                                     Elements="@LoadedElements" />
                <TmModelingIssuePanel Issues="@DisplayIssues"
                                      OnIssueSelected="SelectIssueAsync" />
            </aside>
        </div>

        <footer class="tm-modeling-editor__status"
                data-testid="@TestId("modeling-status-strip")"
                aria-label="@Loc["TmModelingEditor_Status"]"
                role="status"
                aria-live="polite"
                aria-atomic="true">
            @* Review fix (phase 3): the counts lead the strip; the state/last-loaded item is
               pushed to its trailing edge (margin-inline-start:auto). The state label stays
               available to screen readers — an sr-only "Loaded – " leads the last-loaded time
               (visible text alone would be just the time). *@
            <span class="tm-modeling-editor__status-item">@Loc["TmModelingEditor_Elements"]: <strong>@(_model?.Elements.Count ?? 0)</strong></span>
            <span class="tm-modeling-editor__status-item">@Loc["TmModelingEditor_Relationships"]: <strong>@(_model?.Relationships.Count ?? 0)</strong></span>
            <span class="tm-modeling-editor__status-item">@Loc["TmModelingEditor_DiagramNodes"]: <strong>@(_document?.Nodes.Count ?? 0)</strong></span>
            <span class="tm-modeling-editor__status-item">@Loc["TmModelingEditor_DiagramEdges"]: <strong>@(_document?.Edges.Count ?? 0)</strong></span>
            <span class="tm-modeling-editor__status-item tm-modeling-editor__status-item--state">
                <span class="tm-modeling-editor__status-icon" aria-hidden="true">
                    <TmIcon Name="@StatusStripIcon" Size="IconSize.Xs" />
                </span>
                @if (_model?.Metadata.LoadedAt is { } lastLoadedAt && lastLoadedAt != default)
                {
                    <span class="tm-sr-only">@Loc[StateLabelKey] – </span>
                }
                @StatusStripStateText
            </span>
        </footer>

        @* Fáze 4 (G6): the "Open in editor" surface is a core TmModal — a viewport-positioned
           dialog with a scrim, a public focus scope and Escape, sized ~90vw × 90vh on the
           desktop through TmModelingEditor.razor.css. The TmModal header owns the title
           (document title with the "Open in editor" fallback) and the close; the embedded
           diagram editor renders with ShowTitle="false" so the dialog has ONE header. The
           diagram editor keeps every panel and the Full toolbar preset; changes keep
           propagating live (G8 — no footer), so the scrim is not a close affordance. *@
        @if (_openedEditorDocument is not null)
        {
            <TmModal Show="true"
                     Title="@OpenEditorDialogTitle"
                     Subtitle="@Loc["TmModelingDiagramPreview_OpenEditorSummary"]"
                     Size="ModalSize.XLarge"
                     MobilePresentation="MobilePresentation.Dialog"
                     ShowFooter="false"
                     ShowDefaultFooterButtons="false"
                     CloseOnOverlayClick="false"
                     CloseOnEscape="true"
                     OnClose="CloseGeneratedDiagramAsync"
                     RestoreFocusTargetId="@_openEditorTriggerId"
                     Class="tm-modeling-editor__open-editor-modal"
                     CloseButtonAdditionalAttributes="@OpenEditorCloseButtonAttributes"
                     AdditionalAttributes="@OpenEditorModalAttributes">
                <ChildContent>
                    <div class="tm-modeling-editor__open-editor-body">
                        <TmDiagramEditor Document="@_openedEditorDocument"
                                         DocumentChanged="UpdateOpenedEditorDocumentAsync"
                                         ToolbarPreset="DiagramToolbarPreset.Full"
                                         ShowTitle="false"
                                         ShowToolbox="true"
                                         ShowPropertiesPanel="true"
                                         ShowLayersPanel="true"
                                         ShowMinimap="true"
                                         ShowToolbar="true"
                                         Class="tm-modeling-editor__open-editor-diagram" />
                    </div>
                </ChildContent>
            </TmModal>
        }
    }
</section>
