@using Tempo.Blazor.Components.Diagram.Models
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Components.Diagram
@using Tempo.Blazor.Components.Layout
@using Tempo.Blazor.Components.Actions
@using Tempo.Blazor.Components.Overlay
@using Tempo.Blazor.Abstractions.Layout
@using System.Globalization
@using Tempo.Blazor.Modeling

@* Fáze 5 (MO1): the editor resolves its presentation from ITS OWN container (TmLayoutObserver)
   and renders the workspace through the core TmEditorShell (Header, tree, preview + issues dock,
   inspector, status bar); the compact branch keeps the panel-tab DOM both branches freeze. The
   section is the editor's OWN root element (the data-* contract and this stylesheet's scope live
   here — a child component's root would not carry it); the observer hosts the branch. *@
<section class="@RootClass"
         data-testid="@TestId("modeling-editor")"
         @ref="_editorRoot"
         data-state="@StateName"
         data-load-count="@_completedLoadCount"
         data-generation-count="@_completedGenerationCount"
         data-provider="@EffectiveProviderKey"
         data-notation="@EffectiveNotationKey"
         data-viewpoint="@EffectiveViewpointKey"
         data-selected-element-id="@(_selectedElement?.Id ?? string.Empty)"
         data-selected-relationship-id="@(_selectedRelationship?.Id ?? string.Empty)"
         data-element-count="@(_model?.Elements.Count ?? 0)"
         data-relationship-count="@(_model?.Relationships.Count ?? 0)"
         data-diagram-node-count="@(_document?.Nodes.Count ?? 0)"
         data-diagram-edge-count="@(_document?.Edges.Count ?? 0)"
         data-issue-count="@IssueCount"
         data-active-panel="@ActivePanelName"
         data-open-editor="@((_openedEditorDocument is not null).ToString().ToLowerInvariant())"
         data-can-edit-structure="@CanEditModelStructure.ToString().ToLowerInvariant()"
         data-can-edit-layout="@CanEditModelLayout.ToString().ToLowerInvariant()"
         data-writer-capabilities="@EffectiveWriterCapabilities.ToString()"
         @onkeydown="HandleEditorRootKeyDownAsync"
         style="@HeightStyle">
    @* Fáze 6 review fix: the editor tracks its OWN container through this observer (the shell's
       duplicate is an idempotent echo of the same box) — without it an Auto editor's tablet
       sheet rules ran one raise behind. *@
    <TmLayoutObserver LayoutMode="LayoutMode"
                      InitialMode="InitialMode"
                      Breakpoints="EffectiveBreakpoints"
                      ResolvedLayoutChanged="OnShellResolvedLayoutChanged"
                      IsContainer="true"
                      Class="tm-modeling-editor__layout">
        <LayoutContent Context="layout">
        @if (layout.IsMobile)
        {
            @* ── Mobile layout (the editor container is below its own mobile threshold) ─────
               Fáze 7 (G2 — viewing + light edits): a compact header, ONE panel at a time behind
               a real tablist (Preview / Tree / Inspector / Issues), a status card and the F5
               action bar. The editor ROOT is the focusWithin surface, so the dialog's close
               button and the mobile focus return stay inside it. *@
            @* Fáze 7 review fix (blocker): the mobile shell is the ALWAYS-PRESENT chrome — even on
               the empty / error / loading-without-model screens it renders the header, the "Change
               view" sheet and a reduced action bar, with the single-state screen where the tabs
               would be. *@
            <div class="tm-modeling-editor__mobile-shell">
                <header class="tm-modeling-editor__toolbar" data-testid="@TestId("modeling-editor-toolbar")">@MobileHeaderContent</header>

                @if (WorkspaceMounted)
                {
                    <div class="tm-modeling-editor__mobile-panels">
                        @* Force reload over a live model keeps the tab strip mounted (the workspace
                           stays; the source panel shows its IsLoading affordance) — the badge rides
                           over the panel area, under the header. *@
                        @if (_state == ModelingEditorState.Loading)
                        {
                            @ReloadIndicatorContent
                        }
                        <TmTabs ActiveTabId="@MobilePanelTabId"
                                ActiveTabIdChanged="SelectMobilePanelAsync"
                                Class="tm-modeling-editor__panel-tabs"
                                AriaLabel="@Loc["TmModelingEditor_Panels"]"
                                AdditionalAttributes="@MobilePanelTabsAttributes">
                            <TmTabPanel Id="preview"
                                       TabAttributes="@PreviewTabAttributes"
                                       Title="@Loc["TmModelingEditor_Preview"]">
                                @* Fáze 7 review fix: the status card lives in the PREVIEW tab body
                                   (a shell-level card stole ~110px from every tab), above the
                                   scrolling panel so the canvas still fills the tab. *@
                                <div class="tm-modeling-editor__status-card"
                                     data-testid="@TestId("modeling-status-card")"
                                     role="status"
                                     aria-live="polite"
                                     aria-atomic="true"
                                     aria-label="@Loc["TmModelingEditor_Status"]">
                                    @MobileStatusCardContent
                                </div>
                                <section class="tm-modeling-editor__panel tm-modeling-editor__preview tm-modeling-editor__panel--active"
                                         data-testid="@TestId("modeling-preview-panel")"
                                         aria-label="@Loc["TmModelingEditor_Preview"]">
                                    @PreviewContent
                                </section>
                            </TmTabPanel>
                            <TmTabPanel Id="tree"
                                       TabAttributes="@TreeTabAttributes"
                                       Title="@Loc["TmModelingEditor_TreeShort"]">
                                <aside class="tm-modeling-editor__panel tm-modeling-editor__tree tm-modeling-editor__panel--active"
                                       data-testid="@TestId("modeling-model-tree-panel")"
                                       aria-label="@Loc["TmModelingEditor_ModelTree"]">
                                    @ModelTreeContent
                                </aside>
                            </TmTabPanel>
                            <TmTabPanel Id="inspector"
                                       TabAttributes="@InspectorTabAttributes"
                                       Title="@Loc["TmModelingEditor_Inspector"]"
                                       Badge="@InspectorTabBadge">
                                @* Fáze 7 re-review: the aside is the programmatic focus target of
                                   the selection switch (data-modeling-focus hook, tabindex="-1"); a
                                   tree tap is G2 browsing and never lands here. *@
                                <aside class="tm-modeling-editor__panel tm-modeling-editor__inspector tm-modeling-editor__panel--active"
                                       data-testid="@TestId("modeling-inspector-panel")"
                                       data-modeling-focus="inspector-panel"
                                       tabindex="-1"
                                       aria-label="@Loc["TmModelingEditor_Inspector"]">
                                    @CompactInspectorContent
                                </aside>
                            </TmTabPanel>
                            <TmTabPanel Id="issues"
                                       TabAttributes="@IssuesTabAttributes"
                                       Title="@Loc["TmModelingEditor_Issues"]"
                                       Badge="@IssueTabBadge">
                                <section class="tm-modeling-editor__panel tm-modeling-editor__issues tm-modeling-editor__panel--active"
                                         data-testid="@TestId("modeling-issues-panel")"
                                         aria-label="@Loc["TmModelingEditor_Issues"]">
                                    @MobileIssuesContent
                                </section>
                            </TmTabPanel>
                        </TmTabs>
                    </div>
                }
                else
                {
                    @SingleStateContent
                }

                <TmMobileActionBar Items="@MobileActionItems"
                                   Placement="ActionBarPlacement.StickyContainer"
                                   MaxVisible="3"
                                   LayoutMode="TmLayoutMode.Mobile"
                                   Class="tm-modeling-editor__action-bar" />
            </div>
        }
        else
        {
            @* ── Docked layouts (tablet and desktop): the core editor shell owns the chrome; it is
               NOT pinned to the editor's resolved mode (an Auto shell measures its own container,
               so the nested diagram editors resolve from THEIR own boxes). Fáze 6: the tablet
               presentation is the shell's Overlay — tree drawer + inspector side sheet, at most
               ONE open (the "Panels" tabs are the visibility switch). *@
            <TmEditorShell @ref="_shell"
                           Class="tm-modeling-editor__shell"
                           LayoutMode="LayoutMode"
                           Breakpoints="EffectiveBreakpoints"
                           InitialMode="layout.Resolved"
                           ResolvedLayoutChanged="OnShellResolvedLayoutChanged"
                           TabletPanelPresentation="TabletPanelPresentation.Overlay"
                           LeftOverlayTestId="@TestId("modeling-tree-drawer")"
                           RightOverlayTestId="@TestId("modeling-inspector-sheet")"
                           OverlayCloseTestId="@TestId("modeling-sheet-close")"
                           LeftTitle="@Loc["TmModelingEditor_ModelTree"]"
                           RightTitle="@Loc["TmModelingEditor_Inspector"]"
                           CanvasTitle="@Loc["TmModelingEditor_Preview"]"
                           LeftOpen="@TreeSheetOpen" LeftOpenChanged="OnShellLeftOpenChanged"
                           RightOpen="@InspectorSheetOpen" RightOpenChanged="OnShellRightOpenChanged"
                           CollapsedPanels="_shellCollapsed" CollapsedPanelsChanged="OnShellCollapsedPanelsChanged"
                           LeftWidth="260px" MinLeftWidth="200" MaxLeftWidth="360"
                           RightWidth="280px" MinRightWidth="240" MaxRightWidth="440"
                           PersistWidthsKey="@EffectivePersistWidthsKey"
                           Left="@TreeSlot"
                           Right="@RightSlot">
                <Header>
                    <header class="tm-modeling-editor__toolbar" data-testid="@TestId("modeling-editor-toolbar")">@EditorHeaderContent</header>
                    @if (layout.IsTablet)
                    {
                        @* Fáze 6: the "Panels" tabs double as the tablet visibility switch —
                           Tree/Inspector toggle their drawer/sheet (one at a time, aria-expanded);
                           Preview closes both. The compact branch is the mobile-only alternative. *@
                        <nav class="tm-modeling-editor__panel-tabs"
                             data-testid="@TestId("modeling-panel-tabs")"
                             aria-label="@Loc["TmModelingEditor_Panels"]">
                            <button type="button"
                                    class="@GetTabletPanelTabClass(ModelingEditorPanel.Tree)"
                                    data-testid="@TestId("modeling-panel-tab-tree")"
                                    aria-expanded="@TreeSheetOpen.ToString().ToLowerInvariant()"
                                    aria-controls="@(TreeSheetOpen ? _shell?.LeftPanelId : null)"
                                    title="@Loc["TmModelingEditor_ToggleTree"]"
                                    @onclick="ToggleTreeSheetAsync">
                                @Loc["TmModelingEditor_ModelTree"]
                            </button>
                            <button type="button"
                                    class="@GetTabletPanelTabClass(ModelingEditorPanel.Preview)"
                                    data-testid="@TestId("modeling-panel-tab-preview")"
                                    aria-pressed="@((!TreeSheetOpen && !InspectorSheetOpen && !IssuesSheetOpen).ToString().ToLowerInvariant())"
                                    title="@Loc["TmModelingEditor_PreviewOnly"]"
                                    @onclick="ShowPreviewOnlyAsync">
                                @Loc["TmModelingEditor_Preview"]
                            </button>
                            <button type="button"
                                    class="@GetTabletPanelTabClass(ModelingEditorPanel.Inspector)"
                                    data-testid="@TestId("modeling-panel-tab-inspector")"
                                    aria-expanded="@InspectorSheetOpen.ToString().ToLowerInvariant()"
                                    aria-controls="@(InspectorSheetOpen ? _shell?.RightPanelId : null)"
                                    title="@Loc["TmModelingEditor_ToggleInspector"]"
                                    @onclick="ToggleInspectorSheetAsync">
                                @Loc["TmModelingEditor_Inspector"]
                            </button>
                            @* Final UX review (M2): the issues are the fourth panel on the tablet
                               band — a side sheet under the same one-open rule. The visible count
                               rides inside the button (its accessible name includes it). *@
                            <button type="button"
                                    class="@GetTabletPanelTabClass(ModelingEditorPanel.Issues)"
                                    data-testid="@TestId("modeling-panel-tab-issues")"
                                    aria-expanded="@IssuesSheetOpen.ToString().ToLowerInvariant()"
                                    aria-controls="@(IssuesSheetOpen ? _issuesSheetId : null)"
                                    title="@Loc["TmModelingEditor_ToggleIssues"]"
                                    @onclick="ToggleIssuesSheetAsync">
                                @Loc["TmModelingEditor_Issues"]
                                @if (IssueCount > 0)
                                {
                                    <span class="tm-modeling-editor__panel-tab-badge">@IssueCount</span>
                                }
                            </button>
                        </nav>
                    }
                </Header>
                @* Left/Right ride as VALUE attributes (final review M4): a null TreeSlot/RightSlot
                   then reaches the shell and the side is skipped instead of painting an empty
                   column on the empty/error screens. *@
                <Canvas>@CanvasSlot</Canvas>
                <StatusBar>@StatusBarSlot</StatusBar>
            </TmEditorShell>

        }
        </LayoutContent>
    </TmLayoutObserver>

    @* Final review fix (MAJOR): the overlays render ONCE, outside both layout branches — a flip
       across the 768 boundary used to tear the dialog down (a new TmDiagramEditor, a fresh engine
       boot). The editor ROOT is the focusWithin scope in every layout. Phase 3: ONE polite live
       region announces every structural result (insert, connect, delete, rejection). *@
    @* Review U7: the polite live region lives INSIDE the open-editor dialog while it is open (the
       modal's focus scope must contain it — a region behind the modal is neither rendered for a
       screen reader's virtual cursor nor reliably announced), and outside it otherwise. Exactly ONE
       instance exists at any time. *@
    @if (_openedEditorDocument is null)
    {
        <span class="tm-sr-only"
              role="status"
              aria-live="polite"
              aria-atomic="true"
              data-testid="@TestId("modeling-structure-live")">@_structureAnnouncement</span>
    }
    @* The hints a disabled-by-design action points at. They live on the ROOT (always rendered) so a
       button in the header and its twin in the dialog header can share them. *@
    <span id="@_selectElementFirstHintId" class="tm-sr-only">@Loc["TmModelingEditor_SelectElementFirst"]</span>
    <span id="@_diagramNotReadyHintId" class="tm-sr-only">@Loc["TmModelingEditor_DiagramNotReady"]</span>
    @ChangeViewSheetContent
    @LegendSheetContent
    @StructureDialogsContent
    @OpenEditorModalContent
    @EditingOverlaysContent
</section>

@code {
    /// <summary>
    /// The header (title + state badge + one provider/notation/viewpoint group — phase 3). One
    /// fragment for both layouts so the chrome cannot drift between the shell and the compact DOM.
    /// </summary>
    private RenderFragment EditorHeaderContent => @<text>
        <div class="tm-modeling-editor__title-group">
            <h2 class="tm-modeling-editor__title">@Loc["TmModelingEditor_Title"]</h2>
            @* Phase 2 (gap #1): the state is a colored badge NEXT TO the title, not a plain
               subtitle line under it. *@
            <span class="tm-modeling-editor__state">
                <TmBadge Variant="@StateBadgeVariant" Style="BadgeStyle.Subtle" Pill="true">@Loc[StateLabelKey]</TmBadge>
            </span>
        </div>
        @* Phase 3 (MODELING-WRITER-CAPABILITIES): the non-drag structural actions — the
           keyboard/tap alternative (WCAG 2.5.7) to the palette drop, the edge drag and the canvas
           Delete. Rendered only when the writer advertises Structure; a content-only writer gets
           the localized reason instead of dead controls. *@
        @StructureHeaderActions
        @* MO3: one provider surface — a labeled select when enabled (the model reloads on
           change), else a labeled chip. Review fix (phase 3): the provider surface and the
           notation/viewpoint selector form one right-aligned header group; the toolbar keeps only
           the title. *@
        <div class="tm-modeling-editor__context">
            @if (ShowProviderSelector)
            {
                @ProviderSelectContent
            }
            else
            {
                <div class="tm-modeling-editor__chips">
                    <span class="tm-modeling-editor__chip">
                        <span>@Loc["TmModelingEditor_Provider"]</span>
                        <strong>@DisplayProviderKey</strong>
                    </span>
                </div>
            }
            <TmModelingViewSelector NotationKey="@EffectiveNotationKey"
                                    ViewpointKey="@EffectiveViewpointKey"
                                    OnNotationChanged="ChangeNotationAsync"
                                    OnViewpointChanged="ChangeViewpointAsync" />
        </div>
    </text>;
    /// <summary>The labeled provider select (the docked header field and the mobile "Change
    /// view" sheet share one surface, so the value and the reload path cannot drift).</summary>
    private RenderFragment ProviderSelectContent => @<label class="tm-modeling-editor__field">
        <span>@Loc["TmModelingEditor_Provider"]</span>
        <select data-testid="@TestId("modeling-provider-select")"
                value="@EffectiveProviderKey"
                @onchange="HandleProviderChangedAsync">
            @if (string.IsNullOrWhiteSpace(EffectiveProviderKey))
            {
                <option value="">@Loc["TmModelingEditor_SelectProvider"]</option>
            }
            @foreach (var option in ProviderOptions)
            {
                <option value="@option">@ResolveProviderDisplayName(option)</option>
            }
        </select>
    </label>;
    /// <summary>
    /// Fáze 7: the compact mobile header — title + state badge and ONE "⋯" overflow (the
    /// provider/notation/viewpoint selects live in the "Change view" sheet, so the header stays a
    /// single row at 320px). The wrapper div is the dialog's mobile focus-return host.
    /// </summary>
    private RenderFragment MobileHeaderContent => @<text>
        <div class="tm-modeling-editor__title-group">
            <h2 class="tm-modeling-editor__title">@Loc["TmModelingEditor_Title"]</h2>
            <span class="tm-modeling-editor__state">
                <TmBadge Variant="@StateBadgeVariant" Style="BadgeStyle.Subtle" Pill="true">@Loc[StateLabelKey]</TmBadge>
            </span>
        </div>
        <div class="tm-modeling-editor__more-host" data-modeling-focus="open-in-editor" tabindex="-1">
            <TmDropdown Class="tm-modeling-editor__more"
                        Icon="@IconNames.MoreHorizontal"
                        ShowChevron="false"
                        AriaLabel="@Loc["TmModelingEditor_MoreOptions"]"
                        Placement="OverlayPlacement.Bottom"
                        Align="OverlayAlign.End"
                        LayoutMode="TmLayoutMode.Mobile"
                        OnSelect="HandleMobileHeaderMenuAsync">
                <TmDropdownItem Value="change-view" Icon="@IconNames.Sliders">@Loc["TmModelingEditor_ChangeView"]</TmDropdownItem>
                @* Fáze 15: the mobile band explains the preview legend through this sheet — the
                   legend CARD would cover the small preview canvas. *@
                <TmDropdownItem Value="legend" Icon="@IconNames.List" Disabled="@(_document is null)">@Loc["TmModelingEditor_Legend"]</TmDropdownItem>
                @* Fáze 7 review: Generate carries the wand icon — the bar's Reload keeps Refresh,
                   so the two adjacent mobile entries are never the same glyph. *@
                <TmDropdownItem Value="generate" Icon="@IconNames.WandSparkles" Disabled="@(_model is null || _state != ModelingEditorState.Loaded)">@Loc["TmModelingDiagramPreview_Generate"]</TmDropdownItem>
                <TmDropdownItem Value="open-editor" Icon="@IconNames.ExternalLink" Disabled="@(_document is null)">@Loc["TmModelingDiagramPreview_OpenInEditor"]</TmDropdownItem>
            </TmDropdown>
        </div>
    </text>;
    /// <summary>The single-state screens (loading without a model, empty, error) — shared by both layouts.</summary>
    private RenderFragment SingleStateContent => @<text>
        @if (_state == ModelingEditorState.Loading && _model is null)
        {
            <div class="tm-modeling-editor__single-state" data-testid="@TestId("modeling-editor-loading")" aria-live="polite">
                <TmSpinner Size="SpinnerSize.Lg" />
                <div>
                    <h3>@Loc["TmModelingEditor_LoadingTitle"]</h3>
                    <p>@Loc["TmModelingEditor_LoadingText"]</p>
                    @if (_showLongLoadingMessage)
                    {
                        <p class="tm-modeling-editor__detail" data-testid="@TestId("modeling-editor-timeout-message")">@Loc["TmModelingEditor_LongLoadingText"]</p>
                    }
                </div>
            </div>
        }
        else if (_state == ModelingEditorState.Empty)
        {
            <div class="tm-modeling-editor__single-state" data-testid="@TestId("modeling-editor-empty")" aria-live="polite">
                @* Phase 2 (gap #7): state marks are icons, not text glyphs ("0" / "!"). *@
                <div class="tm-modeling-editor__state-mark" aria-hidden="true">
                    <TmIcon Name="@StateMarkIcon" Size="IconSize.Lg" />
                </div>
                <div>
                    <h3>@Loc["TmModelingEditor_EmptyTitle"]</h3>
                    <p>@Loc["TmModelingEditor_EmptyText"]</p>
                    @if (HasReloadableSource)
                    {
                        @* Final UX review (M4): an empty state with a configured source is
                           recoverable — offer the same Reload affordance as the error screen. *@
                        @RetryButtonContent
                    }
                </div>
            </div>
        }
        else if (_state == ModelingEditorState.Error)
        {
            <div class="tm-modeling-editor__single-state tm-modeling-editor__single-state--error" data-testid="@TestId("modeling-editor-error")" role="alert">
                <div class="tm-modeling-editor__state-mark" aria-hidden="true">
                    <TmIcon Name="@StateMarkIcon" Size="IconSize.Lg" />
                </div>
                <div>
                    <h3>@Loc["TmModelingEditor_ErrorTitle"]</h3>
                    <p>@Loc["TmModelingEditor_ErrorText"]</p>
                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <p class="tm-modeling-editor__detail">@_errorMessage</p>
                    }
                    @RetryButtonContent
                </div>
            </div>
        }
    </text>;
    /// <summary>The shared retry affordance of the recoverable single-state screens (M4) — the
    /// action bar's Reload entry and this button share the label and the handler.</summary>
    private RenderFragment RetryButtonContent => @<div class="tm-modeling-editor__state-actions">
        <TmButton Variant="ButtonVariant.Secondary"
                  Icon="@IconNames.Refresh"
                  OnClick="ReloadModelAsync"
                  data-testid="@TestId("modeling-editor-retry")">
            @Loc["TmModelingEditor_Reload"]
        </TmButton>
    </div>;
    /// <summary>The reload affordance (mounted workspace, loading state) — shared by both layouts.</summary>
    private RenderFragment ReloadIndicatorContent => @<div class="tm-modeling-editor__reload-indicator" data-testid="@TestId("modeling-editor-loading")" role="status" aria-live="polite">
        @* Carry-forward (phase 2 review): the state text is NOT repeated here — the
           title badge owns it. The indicator keeps the spinner and an sr-only
           announcement for assistive tech. *@
        <TmSpinner Size="SpinnerSize.Sm" />
        <span class="tm-sr-only">@Loc["TmModelingEditor_LoadingTitle"]</span>
    </div>;
    /// <summary>The model tree. CollapsedGroups / CollapsedElementIds (a separate key space) and
    /// FilterText stay bound to the editor (the tree may remount on a layout flip).
    /// AllowNodeDrop follows the editor's switch; "Insert into preview" routes through the
    /// preview's drop path. Fáze 6: inside the tablet drawer the tree's heading block is hidden
    /// (the sheet title already says "Model tree").</summary>
    private RenderFragment ModelTreeContent
    {
        get
        {
            var (selected, dragStarted, dragEnded, insert, collapsedChanged, collapsedElementsChanged) = TreeCallbacks;
            return @<TmModelingModelTree Elements="@VisibleTreeElements"
                                         SelectedElement="@_selectedElement"
                                         AllowNodeDrop="@EffectiveAllowNodeDrop"
                                         OnInsertIntoPreview="@insert"
                                         Grouping="@TreeGrouping"
                                         CollapsedGroups="@_collapsedGroups"
                                         CollapsedGroupsChanged="@collapsedChanged"
                                         CollapsedElementIds="@_collapsedElementIds"
                                         CollapsedElementIdsChanged="@collapsedElementsChanged"
                                         FilterText="@_treeFilterHolder.Value"
                                         FilterTextChanged="@TreeFilterChanged"
                                         ShowTitle="@(false == IsTablet && !IsMobileLayout)"
                                         OnElementSelected="@selected"
                                         OnElementDragStarted="@dragStarted"
                                         OnElementDragEnded="@dragEnded"
                                         OnDeleteRequested="@TreeDeleteRequested" />;
        }
    }
    /// <summary>The generated diagram preview — shared by both layouts. On the mobile band the
    /// edit actions are gone (G2), the preview is not a drop target and the DE's own chrome and
    /// heading are dropped; Fáze 9: the mobile band opts into the DE's floating zoom pill.</summary>
    private RenderFragment PreviewContent => @<TmModelingDiagramPreview @ref="_preview"
                                                                        Document="@_document"
                                                                        DocumentChanged="UpdatePreviewDocumentAsync"
                                                                        ActiveDraggedElement="@_draggedElement"
                                                                        AllowNodeDrop="@EffectiveAllowNodeDrop"
                                                                        ShowEditActions="@(!IsMobileLayout)"
                                                                        ShowEmbeddedEditorChrome="@(!IsMobileLayout)"
                                                                        ShowZoomOverlay="@IsMobileLayout"
                                                                        ShowHeader="@(!IsMobileLayout)"
                                                                        ShowSummary="false"
                                                                        ShowLegend="@(!IsMobileLayout && ShowPreviewLegend)"
                                                                        LegendEntries="@LegendEntries"
                                                                        LegendDefaultExpanded="@(!IsTablet && LegendStartsExpanded)"
                                                                        OpenInEditorTriggerId="@_openEditorTriggerId"
                                                                        OnNodeDropped="HandleNodeDroppedAsync"
                                                                        OnGenerateRequested="GenerateDiagramFromLoadedModelAsync"
                                                                        OnRelationshipSelected="SelectRelationshipAsync"
                                                                        OnOpenInEditor="OpenGeneratedDiagramAsync" />;
    /// <summary>
    /// The issues dock — MO1 places it UNDER the preview, collapsed to its header on demand (the
    /// canvas grid owns the row height). Fáze 11: the editor owns the filter/sort state and the
    /// SAME fields feed the tablet sheet and the mobile tab.
    /// </summary>
    private RenderFragment IssuesDockContent => @<TmModelingIssuePanel Issues="@DisplayIssues"
                                                                       ContentVersion="@EditContentVersion"
                                                                       OnIssueSelected="SelectIssueAsync"
                                                                       Collapsed="@IssuesCollapsed"
                                                                       CollapsedChanged="SetIssuesCollapsedAsync"
                                                                       ShowFilterBar="true"
                                                                       SeverityFilter="@_issueSeverityFilter"
                                                                       SeverityFilterChanged="SetIssueSeverityFilterAsync"
                                                                       FilterText="@_issueFilterText"
                                                                       FilterTextChanged="SetIssueFilterTextAsync"
                                                                       SortMode="@_issueSortMode"
                                                                       SortModeChanged="SetIssueSortModeAsync"
                                                                       Elements="@_model?.Elements"
                                                                       Relationships="@_model?.Relationships" />;
    /// <summary>
    /// The tablet issues side sheet (M2): the same non-modal TmFocusScope sheet, scoped to the
    /// editor root; the panel renders WITHOUT its collapse toggle (the sheet header owns the
    /// close). The focus scope is a child component root, so it carries no scope attribute — the
    /// positioning rule targets the editor-owned HOST wrapper and the scope fills it.
    /// </summary>
    private RenderFragment? TabletIssuesSheetContent
        => IssuesSheetOpen
            ? @<div class="tm-modeling-editor__issues-sheet-host">
                <TmFocusScope Active="true"
                              Modal="false"
                              CloseOnEscape="true"
                              OnEscape="CloseIssuesSheetAsync"
                              Class="tm-modeling-editor__issues-sheet"
                              AriaLabelledBy="@_issuesSheetTitleId"
                              DataTestId="@TestId("modeling-issues-sheet")">
                    <div class="tm-modeling-editor__sheet-header">
                        <div role="heading" aria-level="2" id="@_issuesSheetTitleId" class="tm-modeling-editor__sheet-title">
                            @Loc["TmModelingEditor_Issues"]
                        </div>
                        <span class="tm-modeling-editor__sheet-count" aria-hidden="true">@IssueCount</span>
                        <button type="button"
                                class="tm-modeling-editor__sheet-close"
                                data-testid="@TestId("modeling-issues-sheet-close")"
                                aria-label="@Loc["TmModelingEditor_CloseIssues"]"
                                title="@Loc["TmModelingEditor_CloseIssues"]"
                                @onclick="CloseIssuesSheetAsync">
                            <TmIcon Name="@IconNames.X" Size="IconSize.Sm" />
                        </button>
                    </div>
                    <div class="tm-modeling-editor__sheet-body" id="@_issuesSheetId">
                        <TmModelingIssuePanel Issues="@DisplayIssues"
                                              ContentVersion="@EditContentVersion"
                                              OnIssueSelected="SelectIssueAsync"
                                              ShowToggle="false"
                                              Collapsed="false"
                                              CollapsedChanged="SetIssuesCollapsedAsync"
                                              ShowFilterBar="true"
                                              SeverityFilter="@_issueSeverityFilter"
                                              SeverityFilterChanged="SetIssueSeverityFilterAsync"
                                              FilterText="@_issueFilterText"
                                              FilterTextChanged="SetIssueFilterTextAsync"
                                              SortMode="@_issueSortMode"
                                              SortModeChanged="SetIssueSortModeAsync"
                                              Elements="@_model?.Elements"
                                              Relationships="@_model?.Relationships" />
                    </div>
                </TmFocusScope>
            </div>
            : null;
    /// <summary>The source panel (the inspector's "Source" tab on the docked layouts).</summary>
    private RenderFragment SourcePanelContent => @<TmModelingSourcePanel Metadata="@_model?.Metadata"
                                                                         IsLoading="@(_state == ModelingEditorState.Loading || _isReloading)"
                                                                         OnLoadRequested="ReloadModelAsync" />;
    /// <summary>The element/relationship inspector. Fáze 14: read-only (MO2) unless the editing
    /// contract is active — the editor passes <c>ReadOnly=false</c> together with the commit
    /// callbacks and the inspector-scope undo/redo wiring; the header hosts the editor's
    /// undo/redo pair (and the docked Save/Discard while a Manual save is pending).</summary>
    private RenderFragment InspectorContent => @<TmModelingInspector Element="@_selectedElement"
                                                                     Relationship="@_selectedRelationship"
                                                                     Elements="@LoadedElements"
                                                                     ReadOnly="@(!IsEditingEnabled)"
                                                                     Saving="@IsSaving"
                                                                     OnElementEdited="CommitElementEditAsync"
                                                                     OnRelationshipEdited="CommitRelationshipEditAsync"
                                                                     OnUndoRequested="UndoModelEditAsync"
                                                                     OnRedoRequested="RedoModelEditAsync"
                                                                     HeaderActions="@(IsEditingEnabled ? InspectorHeaderActions : null)" />;
    /// <summary>
    /// Fáze 14: the inspector header's editing surface — the undo/redo pair (keyboard hints + live
    /// announcement) plus the docked Save/Discard while a Manual save is pending; the MOBILE band
    /// keeps save/discard in the sticky action bar and the header carries the history pair only.
    /// </summary>
    private RenderFragment InspectorHeaderActions => @<text>
        <span class="tm-modeling-editor__history-buttons">
            <button type="button"
                    class="tm-modeling-editor__history-btn"
                    data-testid="@TestId("modeling-inspector-undo")"
                    aria-keyshortcuts="Control+Z"
                    disabled="@(!CanUndoModelEdits)"
                    title="@Loc["TmModelingEditor_Undo"]"
                    @onclick="UndoModelEditAsync">
                <TmIcon Name="@IconNames.Undo2" Size="IconSize.Sm" />
                <span class="tm-sr-only">@Loc["TmModelingEditor_Undo"]</span>
            </button>
            <button type="button"
                    class="tm-modeling-editor__history-btn"
                    data-testid="@TestId("modeling-inspector-redo")"
                    aria-keyshortcuts="Control+Shift+Z"
                    disabled="@(!CanRedoModelEdits)"
                    title="@Loc["TmModelingEditor_Redo"]"
                    @onclick="RedoModelEditAsync">
                <TmIcon Name="@IconNames.Redo2" Size="IconSize.Sm" />
                <span class="tm-sr-only">@Loc["TmModelingEditor_Redo"]</span>
            </button>
            @* Phase 3 review (U10): the mobile band is G2 (viewing + light edits) — no structural
               delete in its inspector; the header actions above hide it too. *@
            @if (!IsMobileLayout && CanEditModelStructure && (_selectedElement is not null || _selectedRelationship is not null))
            {
                <button type="button"
                        class="tm-modeling-editor__history-btn"
                        data-testid="@TestId("modeling-inspector-delete")"
                        aria-keyshortcuts="Delete"
                        title="@Loc["TmModelingEditor_DeleteElement"]"
                        @onclick="RequestDeleteSelectedAsync">
                    <TmIcon Name="@IconNames.Trash2" Size="IconSize.Sm" />
                    <span class="tm-sr-only">@Loc["TmModelingEditor_DeleteElement"]</span>
                </button>
            }
            @if (!IsMobileLayout && SaveMode == ModelingSaveMode.Manual && HasPendingModelChanges)
            {
                <button type="button"
                        class="tm-modeling-editor__history-btn tm-modeling-editor__history-btn--save"
                        data-testid="@TestId("modeling-inspector-save")"
                        disabled="@IsSaving"
                        title="@Loc["TmModelingEditor_Save"]"
                        @onclick="SaveFromInspectorAsync">
                    <TmIcon Name="@IconNames.Save" Size="IconSize.Sm" />
                    <span class="tm-sr-only">@(IsSaving ? Loc["TmModelingEditor_Saving"] : Loc["TmModelingEditor_Save"])</span>
                </button>
                <button type="button"
                        class="tm-modeling-editor__history-btn"
                        data-testid="@TestId("modeling-inspector-discard")"
                        title="@Loc["TmModelingEditor_Discard"]"
                        @onclick="DiscardFromInspectorAsync">
                    <TmIcon Name="@IconNames.RotateCcw" Size="IconSize.Sm" />
                    <span class="tm-sr-only">@Loc["TmModelingEditor_Discard"]</span>
                </button>
            }
        </span>
        <span id="@_historyLiveId" class="tm-sr-only" role="status" aria-live="polite">@_historyAnnouncement</span>
    </text>;
    /// <summary>
    /// Fáze 13: the "Relations" tab body — activations use the SAME selection paths an issue or an
    /// edge pick uses, so a navigation lands in the tree, the preview and the inspector.
    /// </summary>
    private RenderFragment RelatedElementsContent => @<TmModelingRelatedElementsPanel Element="@_selectedElement"
                                                                                      Relationship="@_selectedRelationship"
                                                                                      Elements="@LoadedElements"
                                                                                      Relationships="@(_model?.Relationships ?? [])"
                                                                                      OnElementSelected="SelectRelatedElementAsync"
                                                                                      OnRelationshipSelected="SelectRelatedRelationshipAsync" />;

    /// <summary>
    /// The compact inspector keeps the stacked column (source above properties above issues); the
    /// tabbed inspector is the docked presentation. Fáze 13: the Relations SECTION renders under
    /// the properties — the mobile band has no extra tab level (G2: viewing only).
    /// </summary>
    private RenderFragment CompactInspectorContent => @<text>
        @SourcePanelContent
        @EditingAlertsContent
        @InspectorContent
        @RelatedElementsContent
    </text>;

    /// <summary>
    /// The mobile Issues TAB content: the whole issue panel as the tab body, expanded, with the
    /// collapse toggle hidden (the tab body is the scroll surface; the dock keeps its toggle).
    /// </summary>
    private RenderFragment MobileIssuesContent => @<TmModelingIssuePanel Issues="@DisplayIssues"
                                                                         ContentVersion="@EditContentVersion"
                                                                         OnIssueSelected="SelectIssueAsync"
                                                                         ShowToggle="false"
                                                                         Collapsed="@_mobileIssuesCollapsed"
                                                                         CollapsedChanged="SetIssuesCollapsedAsync"
                                                                         ShowFilterBar="true"
                                                                         SeverityFilter="@_issueSeverityFilter"
                                                                         SeverityFilterChanged="SetIssueSeverityFilterAsync"
                                                                         FilterText="@_issueFilterText"
                                                                         FilterTextChanged="SetIssueFilterTextAsync"
                                                                         SortMode="@_issueSortMode"
                                                                         SortModeChanged="SetIssueSortModeAsync"
                                                                         Elements="@_model?.Elements"
                                                                         Relationships="@_model?.Relationships" />;

    /// <summary>The mobile status card: four tiles with a SHORT visible label above the count
    /// (final UX review M3), an aria-hidden type icon per tile and the loaded line in the aria-live
    /// region; the header's state badge owns the visible state (MO3 dedupe).</summary>
    private RenderFragment MobileStatusCardContent => @<text>
        <div class="tm-modeling-editor__status-grid">
            @foreach (var (label, count, icon) in StatusTiles)
            {
                <div class="tm-modeling-editor__status-tile">
                    <span class="tm-modeling-editor__status-tile-icon" aria-hidden="true">
                        <TmIcon Name="@icon" Size="IconSize.Xs" />
                    </span>
                    <strong>@count</strong>
                    <span class="tm-modeling-editor__status-label">@label</span>
                </div>
            }
        </div>
        <div class="tm-modeling-editor__status-loaded">
            <span class="@StatusStripIconClass" aria-hidden="true">
                <TmIcon Name="@StatusStripIcon" Size="IconSize.Xs" />
            </span>
            @if (_model?.Metadata.LoadedAt is { } mobileLoadedAt && mobileLoadedAt != default)
            {
                <span class="tm-sr-only">@Loc[StateLabelKey] – </span>
            }
            @StatusStripStateText
        </div>
    </text>;

    /// <summary>The status strip — the docked layouts' status bar content.</summary>
    private RenderFragment StatusStripContent => @<text>
        @* Review fix (phase 3): the counts lead the strip; the state/last-loaded item is
           pushed to its trailing edge (margin-inline-start:auto). The state label stays
           available to screen readers — an sr-only "Loaded – " leads the last-loaded time
           (visible text alone would be just the time). *@
        <span class="tm-modeling-editor__status-item">@Loc["TmModelingEditor_Elements"]: <strong>@(_model?.Elements.Count ?? 0)</strong></span>
        <span class="tm-modeling-editor__status-item">@Loc["TmModelingEditor_Relationships"]: <strong>@(_model?.Relationships.Count ?? 0)</strong></span>
        <span class="tm-modeling-editor__status-item">@Loc["TmModelingEditor_DiagramNodes"]: <strong>@(_document?.Nodes.Count ?? 0)</strong></span>
        <span class="tm-modeling-editor__status-item">@Loc["TmModelingEditor_DiagramEdges"]: <strong>@(_document?.Edges.Count ?? 0)</strong></span>
        <span class="tm-modeling-editor__status-item tm-modeling-editor__status-item--state">
            <span class="@StatusStripIconClass" aria-hidden="true">
                <TmIcon Name="@StatusStripIcon" Size="IconSize.Xs" />
            </span>
            @if (_model?.Metadata.LoadedAt is { } lastLoadedAt && lastLoadedAt != default)
            {
                <span class="tm-sr-only">@Loc[StateLabelKey] – </span>
            }
            @StatusStripStateText
        </span>
    </text>;

    /// <summary>
    /// Fáze 7: the mobile "Change view" sheet — a bottom-sheet TmModal with the
    /// provider/notation/viewpoint selects the compact header does not carry (mobile-only, so the
    /// presentation is forced through the mobile LayoutMode).
    /// </summary>
    private RenderFragment ChangeViewSheetContent => @<TmModal Show="@_changeViewOpen"
                                                               Title="@Loc["TmModelingEditor_ChangeView"]"
                                                               MobilePresentation="MobilePresentation.Auto"
                                                               LayoutMode="TmLayoutMode.Mobile"
                                                               ShowFooter="false"
                                                               ShowDefaultFooterButtons="false"
                                                               CloseOnOverlayClick="true"
                                                               CloseOnEscape="true"
                                                               OnClose="CloseChangeViewAsync"
                                                               Class="tm-modeling-editor__change-view-modal"
                                                               AdditionalAttributes="@ChangeViewSheetAttributes">
        <ChildContent>
            <div class="tm-modeling-editor__change-view-body">
                @if (ShowProviderSelector)
                {
                    @ProviderSelectContent
                }
                <TmModelingViewSelector NotationKey="@EffectiveNotationKey"
                                        ViewpointKey="@EffectiveViewpointKey"
                                        OnNotationChanged="ChangeNotationAsync"
                                        OnViewpointChanged="ChangeViewpointAsync" />
            </div>
        </ChildContent>
    </TmModal>;

    /// <summary>
    /// Fáze 15: the mobile legend sheet — the "Change view" sheet's presentation hosting the SAME
    /// legend component the preview card uses (the card would cover the small mobile preview).
    /// </summary>
    private RenderFragment LegendSheetContent => @<TmModal Show="@_legendSheetOpen"
                                                           Title="@Loc["TmModelingEditor_Legend"]"
                                                           MobilePresentation="MobilePresentation.Auto"
                                                           LayoutMode="TmLayoutMode.Mobile"
                                                           ShowFooter="false"
                                                           ShowDefaultFooterButtons="false"
                                                           CloseOnOverlayClick="true"
                                                           CloseOnEscape="true"
                                                           OnClose="CloseLegendSheetAsync"
                                                           AdditionalAttributes="@LegendSheetAttributes">
        <ChildContent>
            <div class="tm-modeling-editor__legend-sheet-body">
                <TmModelingDiagramLegend Entries="@LegendEntries" DefaultExpanded="true" Collapsible="false" />
            </div>
        </ChildContent>
    </TmModal>;

    /// <summary>
    /// Fáze 14: the editing overlays rendered ONCE — the feedback alerts (placed in the inspector
    /// surfaces by the fragments above) and the discard-confirmation modal (a core TmModal with
    /// Confirm/Cancel).
    /// </summary>
    private readonly string _historyLiveId = $"tm-modeling-history-live-{Guid.NewGuid():N}";

    /// <summary>The save/conflict alerts of the editing surface: the conflict alert carries the
    /// localized "Reload" action; a failed save shows its message. Rendered above the inspector in
    /// every band.</summary>
    private RenderFragment EditingAlertsContent => @<text>
        @if (_structureErrorText is not null)
        {
            <div class="tm-modeling-editor__editing-alert" data-testid="@TestId("modeling-structure-error")">
                <TmAlert Severity="AlertSeverity.Error" Variant="AlertVariant.Soft" Title="@_structureErrorTitle">
                    <p>@_structureErrorText</p>
                    @if (!string.IsNullOrWhiteSpace(_structureErrorFix))
                    {
                        <p class="tm-modeling-editor__detail">@_structureErrorFix</p>
                    }
                </TmAlert>
                <button type="button"
                        class="tm-modeling-editor__conflict-reload"
                        data-testid="@TestId("modeling-structure-error-dismiss")"
                        @onclick="DismissStructureErrorAsync">
                    <TmIcon Name="@IconNames.X" Size="IconSize.Sm" />
                    @Loc["TmModal_Close"]
                </button>
            </div>
        }
        @if (ShowConflictAlert)
        {
            <div class="tm-modeling-editor__editing-alert" data-testid="@TestId("modeling-inspector-conflict")">
                <TmAlert Severity="AlertSeverity.Warning" Variant="AlertVariant.Soft" Title="@Loc["TmModelingEditor_SaveConflict"]">
                    <p>@(LastSaveResultText)</p>
                </TmAlert>
                <button type="button"
                        class="tm-modeling-editor__conflict-reload"
                        data-testid="@TestId("modeling-conflict-reload")"
                        @onclick="RequestConflictReloadAsync">
                    <TmIcon Name="@IconNames.RotateCw" Size="IconSize.Sm" />
                    @Loc["TmModelingEditor_ReloadChanges"]
                </button>
            </div>
        }
        else if (ShowSaveFailure)
        {
            <div class="tm-modeling-editor__editing-alert" data-testid="@TestId("modeling-inspector-save-failure")">
                <TmAlert Severity="AlertSeverity.Error" Variant="AlertVariant.Soft" Title="@Loc["TmModelingEditor_SaveFailed"]">
                    <p>@(LastSaveResultText)</p>
                </TmAlert>
            </div>
        }
    </text>;

    /// <summary>
    /// Phase 3 (decision <c>MODELING-WRITER-CAPABILITIES</c>): the non-drag structural actions of the
    /// docked header — Insert element, Connect to… and Delete. They are the keyboard/tap alternative
    /// (WCAG 2.5.7) to the palette drop, the edge drag and the canvas Delete, and they render only
    /// when the effective writer advertises Structure. A content-only writer shows the localized
    /// reason instead of dead controls (a keyboard user never tabs onto a disabled-by-design entry).
    /// The mobile band is G2 (viewing + light edits) — it has no structural entry at all.
    /// </summary>
    private RenderFragment StructureHeaderActions => @<text>
        @if (!IsMobileLayout && (CanEditModelStructure || CanEditModelLayout))
        {
            <div class="tm-modeling-editor__structure-actions" role="group" aria-label="@Loc["TmModelingEditor_StructureActions"]">
                @if (CanEditModelStructure)
                {
                    <button type="button"
                            class="tm-modeling-editor__structure-btn"
                            data-testid="@TestId("modeling-insert-element")"
                            title="@Loc["TmModelingEditor_InsertElement"]"
                            @onclick="OpenInsertElementDialogAsync">
                        <TmIcon Name="@IconNames.Plus" Size="IconSize.Sm" />
                        <span class="tm-sr-only">@Loc["TmModelingEditor_InsertElement"]</span>
                    </button>
                    @* Phase 3 review (U11): a structurally-disabled action keeps its TAB STOP and its
                       accessible name (aria-disabled, never the native disabled attribute) and points
                       at the sr-only hint that says WHAT is missing — a disabled-by-design button a
                       keyboard user can never reach explains nothing. The handler still early-returns. *@
                    <button type="button"
                            class="tm-modeling-editor__structure-btn"
                            data-testid="@TestId("modeling-connect-to")"
                            aria-disabled="@((_selectedElement is null).ToString().ToLowerInvariant())"
                            aria-describedby="@((_selectedElement is null) ? _selectElementFirstHintId : null)"
                            title="@Loc["TmModelingEditor_ConnectTo"]"
                            @onclick="OpenConnectDialogAsync">
                        <TmIcon Name="@IconNames.Link" Size="IconSize.Sm" />
                        <span class="tm-sr-only">@Loc["TmModelingEditor_ConnectTo"]</span>
                    </button>
                    <button type="button"
                            class="tm-modeling-editor__structure-btn"
                            id="@_deleteHeaderButtonId"
                            data-testid="@TestId("modeling-delete-selection")"
                            aria-disabled="@((_selectedElement is null && _selectedRelationship is null).ToString().ToLowerInvariant())"
                            aria-describedby="@((_selectedElement is null && _selectedRelationship is null) ? _selectElementFirstHintId : null)"
                            title="@Loc["TmModelingEditor_DeleteElement"]"
                            @onclick="RequestDeleteSelectedAsync">
                        <TmIcon Name="@IconNames.Trash2" Size="IconSize.Sm" />
                        <span class="tm-sr-only">@Loc["TmModelingEditor_DeleteElement"]</span>
                    </button>
                }
                @* Phase 4: the two NON-DRAG layout entries (WCAG 2.5.7) — "Move to container" and the
                   undoable "Arrange". Both are gated on the LAYOUT capability, not on Structure: a host
                   may persist geometry without allowing semantic inserts. A disabled-by-design action
                   keeps its tab stop and points aria-describedby at the sr-only hint that says WHAT is
                   missing (review U10). *@
                @if (CanEditModelLayout)
                {
                    <button type="button"
                            class="tm-modeling-editor__structure-btn"
                            data-testid="@TestId("modeling-move-to-container")"
                            data-modeling-focus="move-to-container"
                            aria-disabled="@((_selectedElement is null).ToString().ToLowerInvariant())"
                            aria-describedby="@((_selectedElement is null) ? _selectElementFirstHintId : null)"
                            title="@Loc["TmModelingEditor_MoveToContainer"]"
                            @onclick="OpenMoveToContainerDialogAsync">
                        <TmIcon Name="@IconNames.Box" Size="IconSize.Sm" />
                        <span class="tm-sr-only">@Loc["TmModelingEditor_MoveToContainer"]</span>
                    </button>
                    <button type="button"
                            class="tm-modeling-editor__structure-btn"
                            data-testid="@TestId("modeling-arrange")"
                            aria-disabled="@((_document is null).ToString().ToLowerInvariant())"
                            aria-describedby="@((_document is null) ? _diagramNotReadyHintId : null)"
                            title="@Loc["TmModelingEditor_Arrange"]"
                            @onclick="OpenArrangeDialog">
                        <TmIcon Name="@IconNames.ListTree" Size="IconSize.Sm" />
                        <span class="tm-sr-only">@Loc["TmModelingEditor_Arrange"]</span>
                    </button>
                }
            </div>
        }
        else if (!IsMobileLayout && IsEditingEnabled)
        {
            <span class="tm-modeling-editor__capability-hint"
                  data-testid="@TestId("modeling-capability-hint")"
                  title="@Loc["TmModelingEditor_CapabilityMissing"]">@Loc["TmModelingEditor_CapabilityHint"]</span>
        }
    </text>;

    /// <summary>
    /// The three NON-DRAG authoring dialogs (phase 3) — the editor owns every piece of their state
    /// and commits through the same semantic command the drag path uses, so there is exactly ONE
    /// commit path per operation. The renderer is INTERNAL (review A8): the sheets are the editor's
    /// own surface, never public API.
    /// </summary>
    /// <summary>The authoring sheets (insert / relationship / delete / arrange / move) — the renderer
    /// lives in the code-behind partial so this file stays under the 1200-line source ceiling.</summary>
    private RenderFragment StructureDialogsContent => RenderStructureDialogs();

    private string LastSaveResultText => _lastSaveResult?.Message ?? string.Empty;

    /// <summary>The discard-confirmation modal (Fáze 14): a reload, a provider switch or a
    /// discard with pending edits asks first; confirm runs the guarded action.</summary>
    private RenderFragment EditingOverlaysContent => @<TmModal Show="@DiscardConfirmationOpen"
                                                               Title="@Loc["TmModelingEditor_DiscardChangesTitle"]"
                                                               Size="ModalSize.Small"
                                                               ShowFooter="false"
                                                               ShowDefaultFooterButtons="false"
                                                               CloseOnOverlayClick="false"
                                                               CloseOnEscape="true"
                                                               OnClose="CancelDiscardAsync"
                                                               Class="tm-modeling-editor__discard-modal"
                                                               AdditionalAttributes="@DiscardModalAttributes">
        <ChildContent>
            <div class="tm-modeling-editor__discard-body">
                <p>@string.Format(CultureInfo.CurrentUICulture, Loc["TmModelingEditor_PendingChanges"], PendingChangeCount)</p>
                <p>@Loc["TmModelingEditor_DiscardChangesText"]</p>
                <div class="tm-modeling-editor__discard-actions">
                    <TmButton Variant="ButtonVariant.Secondary" OnClick="CancelDiscardAsync" data-testid="@TestId("modeling-discard-cancel")">
                        @Loc["TmModelingEditor_Cancel"]
                    </TmButton>
                    <TmButton Variant="ButtonVariant.Primary" OnClick="ConfirmDiscardAsync" data-testid="@TestId("modeling-discard-confirm")">
                        @Loc["TmModelingEditor_Discard"]
                    </TmButton>
                </div>
            </div>
        </ChildContent>
    </TmModal>;

    /// <summary>The discard-confirmation modal's attributes (see `TmModelingEditor.Dialog.cs`).</summary>
    private Dictionary<string, object> DiscardModalAttributes => BuildDiscardModalAttributes();

    /// <summary>How many element / relationship / layout entries are pending (see `TmModelingEditor.Dialog.cs`).</summary>
    public int PendingChangeCount => CountPendingChanges();

    /// <summary>The dialog DE's toolbar group selection (see `TmModelingEditor.Dialog.cs`).</summary>
    private Tempo.Blazor.Components.Diagram.DiagramToolbarGroups? DialogToolbarGroups => ResolveDialogToolbarGroups();

    /// <summary>
    /// The editor's undo/redo pair inside the dialog header (review A5) — the ONE semantic stack, so
    /// an insert made in the dialog can be undone from the dialog without a second diagram stack
    /// shadowing it. The keyboard shortcuts are advertised on the buttons.
    /// </summary>
    private RenderFragment? DialogHeaderActions => !CanEditModelStructure && !CanEditModelLayout ? null : @<span class="tm-modeling-editor__history-buttons">
        @if (CanEditModelLayout)
        {
            @* Phase 4 (U8 + U5): the dialog-scoped non-drag layout entries. The dialog toolbar no
               longer offers the DE's Layout (dagre) menu, so "Arrange" lives HERE, and "Move to
               container" is the keyboard/tap path for the drag the dialog hosts. *@
            <button type="button"
                    class="tm-modeling-editor__history-btn"
                    data-testid="@TestId("modeling-dialog-arrange")"
                    aria-disabled="@((_document is null).ToString().ToLowerInvariant())"
                    aria-describedby="@((_document is null) ? _diagramNotReadyHintId : null)"
                    title="@Loc["TmModelingEditor_Arrange"]"
                    @onclick="OpenArrangeDialog">
                <TmIcon Name="@IconNames.ListTree" Size="IconSize.Sm" />
                <span class="tm-sr-only">@Loc["TmModelingEditor_Arrange"]</span>
            </button>
            <button type="button"
                    class="tm-modeling-editor__history-btn"
                    data-testid="@TestId("modeling-dialog-move-to-container")"
                    aria-disabled="@((_selectedElement is null).ToString().ToLowerInvariant())"
                    aria-describedby="@((_selectedElement is null) ? _selectElementFirstHintId : null)"
                    title="@Loc["TmModelingEditor_MoveToContainer"]"
                    @onclick="OpenMoveToContainerDialogAsync">
                <TmIcon Name="@IconNames.Box" Size="IconSize.Sm" />
                <span class="tm-sr-only">@Loc["TmModelingEditor_MoveToContainer"]</span>
            </button>
        }
        <button type="button"
                class="tm-modeling-editor__history-btn"
                data-testid="@TestId("modeling-dialog-undo")"
                aria-keyshortcuts="Control+Z"
                aria-disabled="@((!CanUndoModelEdits).ToString().ToLowerInvariant())"
                title="@Loc["TmModelingEditor_Undo"]"
                @onclick="UndoModelEditAsync">
            <TmIcon Name="@IconNames.Undo2" Size="IconSize.Sm" />
            <span class="tm-sr-only">@Loc["TmModelingEditor_Undo"]</span>
        </button>
        <button type="button"
                class="tm-modeling-editor__history-btn"
                data-testid="@TestId("modeling-dialog-redo")"
                aria-keyshortcuts="Control+Shift+Z"
                aria-disabled="@((!CanRedoModelEdits).ToString().ToLowerInvariant())"
                title="@Loc["TmModelingEditor_Redo"]"
                @onclick="RedoModelEditAsync">
            <TmIcon Name="@IconNames.Redo2" Size="IconSize.Sm" />
            <span class="tm-sr-only">@Loc["TmModelingEditor_Redo"]</span>
        </button>
    </span>;

    private RenderFragment? OpenEditorHeaderActions => IsMobileLayout ? null : @<text>
        <TmButton Variant="ButtonVariant.Ghost"
                  Icon="x"
                  OnClick="CloseGeneratedDiagramAsync"
                  AdditionalAttributes="@OpenEditorCloseButtonAttributes">
            @Loc["TmModal_Close"]
        </TmButton>
    </text>;

    /// <summary>
    /// Fáze 4 (G6): the "Open in editor" surface is a core TmModal (scrim, focus scope, Escape).
    /// Its header owns the title and the close; the embedded editor renders with ShowTitle="false"
    /// and changes propagate live (G8). Fáze 7: the mobile band presents FULLSCREEN. The modal's
    /// own focus restore is DISABLED (the editor's focusWithin path is the single owner).
    /// </summary>
    private RenderFragment OpenEditorModalContent => @<text>
        @if (_openedEditorDocument is not null)
        {
            <TmModal Show="true"
                     Title="@OpenEditorDialogTitle"
                     Subtitle="@Loc["TmModelingDiagramPreview_OpenEditorSummary"]"
                     Size="ModalSize.XLarge"
                     MobilePresentation="@(IsMobileLayout ? MobilePresentation.Fullscreen : MobilePresentation.Dialog)"
                     ShowFooter="false"
                     ShowDefaultFooterButtons="false"
                     CloseOnOverlayClick="false"
                     CloseOnEscape="true"
                     RestoreFocus="false"
                     OnClose="CloseGeneratedDiagramAsync"
                     Class="tm-modeling-editor__open-editor-modal"
                     ShowCloseButton="@(IsMobileLayout)"
                     HeaderActions="@OpenEditorHeaderActions"
                     CloseButtonAdditionalAttributes="@OpenEditorCloseButtonAttributes"
                     AdditionalAttributes="@OpenEditorModalAttributes">
                <ChildContent>
                    <div class="tm-modeling-editor__open-editor-body">
                        @* Review U7: the ONE structure live region, inside the dialog body while the
                           dialog is open. A drag to another lane speaks the lane's name here. *@
                        <span class="tm-sr-only"
                              role="status"
                              aria-live="polite"
                              aria-atomic="true"
                              data-testid="@TestId("modeling-dialog-structure-live")">@_structureAnnouncement</span>
                        @* The dialog body is its own layout scope: the embedded editor resolves
                           AUTO from the dialog body (its own container) — NOT pinned to the
                           editor's resolved mode (Fáze 6 review fix: the pin went stale the
                           moment the editor's container and the ~90vw dialog body disagreed).
                           The dialog breakpoints are 768/1100 so BOTH tablet viewports (the 90vw
                           body of a 1024 or 1180 window is 922/1062px — below the 1100 desktop
                           threshold) present the DE tablet layout, while a desktop dialog body
                           (≥1100px) still resolves desktop. Fáze 9: the editor's resolved tablet
                           mode seeds the DE's MinimapInitiallyCollapsed — the floating overlay
                           starts collapsed on a tablet (it covered the touch canvas) and reopens
                           from its button; a desktop body keeps the expanded card. *@
                        @* Phase 3 review (A3): the dialog never adds or switches the diagram PAGE —
                           a page flip is a navigation gesture the semantic model cannot express, and
                           the structure diff would read the old page's nodes as deletions. The tabs
                           render only for a non-structural preview.
                           Review A5: while the editor owns the semantic undo stack, the dialog's DE
                           gives up its OWN History group (no second stack to get lost in) and hosts
                           the editor's undo/redo pair in its header; Ctrl+Z / Ctrl+Shift+Z / Ctrl+Y
                           reach the editor through OnHistoryRequested. *@
                        <TmDiagramEditor Document="@_openedEditorDocument"
                                         DocumentChanged="UpdateOpenedEditorDocumentAsync"
                                         LayoutMode="TmLayoutMode.Auto"
                                         LayoutBreakpoints="@OpenEditorBreakpoints"
                                         MinimapInitiallyCollapsed="@IsTablet"
                                         ToolbarPreset="DiagramToolbarPreset.Full"
                                         ToolbarGroups="@DialogToolbarGroups"
                                         ShowPageTabs="@(!CanEditModelStructure)"
                                         HeaderActions="@DialogHeaderActions"
                                         OnHistoryRequested="@DialogHistoryRequestedCallback"
                                         PreferredStencilIds="@NotationPaletteStencilIds"
                                         PreferredStencilsLabel="@NotationPaletteLabel"
                                         SnapDocumentOnLoad="false"
                                         ShowTitle="false"
                                         ShowToolbox="@CanEditModelStructure"
                                         ShowPropertiesPanel="true"
                                         ShowLayersPanel="true"
                                         ShowMinimap="true"
                                         ShowToolbar="true"
                                         Class="tm-modeling-editor__open-editor-diagram" />
                    </div>
                </ChildContent>
            </TmModal>
        }
    </text>;

    // ── Docked (shell) slots ─────────────────────────────────────────────────

    /// <summary>The tree panel content for the shell's left dock; the shell aside carries the
    /// landmark, this wrapper carries the frozen panel test id.</summary>
    private RenderFragment? TreeSlot => WorkspaceMounted ? @<div class="tm-modeling-editor__panel tm-modeling-editor__tree" data-testid="@TestId("modeling-model-tree-panel")" aria-label="@Loc["TmModelingEditor_ModelTree"]">
        @ModelTreeContent
    </div> : null;

    /// <summary>The canvas slot: a state screen while no workspace is mounted, otherwise the
    /// preview with the collapsible issues dock under it on the DESKTOP band (final UX review
    /// M2: the tablet band presents the issues as a side sheet instead — the dock row under the
    /// canvas would starve the touch canvas there). The open-editor dialog renders ONCE after
    /// the layout observer, so this surface no longer contains it.</summary>
    private RenderFragment? CanvasSlot
    {
        get
        {
            if (!WorkspaceMounted)
            {
                return SingleStateContent;
            }

            return @<text>
                @if (_state == ModelingEditorState.Loading)
                {
                    @ReloadIndicatorContent
                }
                <div class="@CanvasBodyClass">
                    @* N190: the preview keeps its labelled <section> region; the issues dock is the
                       sibling row under it (the shell canvas region never emits a <main>). *@
                    <section class="tm-modeling-editor__preview" data-testid="@TestId("modeling-preview-panel")" aria-label="@Loc["TmModelingEditor_Preview"]">
                        @PreviewContent
                    </section>
                    @if (!IsTablet)
                    {
                        @IssuesDockContent
                    }
                    @* Final UX review (M2): the tablet issues sheet lives INSIDE the canvas body —
                       anchored below the header/panel-tabs row, so the switches stay reachable
                       while the sheet is open (the shell's overlay contract). *@
                    @if (IsTablet)
                    {
                        @TabletIssuesSheetContent
                    }
                </div>
            </text>;
        }
    }

    /// <summary>The inspector panel for the shell's right dock: "Properties | Relations | Source"
    /// tabs (MO1 + Fáze 13). Only the active tab renders its body (TmTabs, M26 budget); a stale
    /// source marks the Source tab with a badge and an sr-only hint OUTSIDE the tablist
    /// (aria-describedby); the Relations tab carries the related-row count badge.</summary>
    private RenderFragment? RightSlot => WorkspaceMounted ? @<div class="tm-modeling-editor__inspector" data-testid="@TestId("modeling-inspector-panel")">
        @if (SourceIsStale)
        {
            @* aria-describedby target: a sibling of the tablist (a description inside the
               role="tablist" would break its content model). Per-instance id. *@
            <span id="@_sourceStaleHintId" class="tm-sr-only">@Loc["TmModelingEditor_SourceStaleHint"]</span>
        }
        <TmTabs ActiveTabId="@_inspectorTab" ActiveTabIdChanged="SelectInspectorTab" Class="tm-modeling-editor__inspector-tabs" AriaLabel="@Loc["TmModelingEditor_Inspector"]">
            <TmTabPanel Id="properties"
                        Title="@Loc["TmModelingEditor_Properties"]"
                        TabAttributes="@PropertiesTabAttributes">
                @EditingAlertsContent
                @InspectorContent
            </TmTabPanel>
            <TmTabPanel Id="relations"
                        Title="@Loc["TmModelingEditor_Relations"]"
                        Badge="@RelationsTabBadge"
                        TabAttributes="@RelationsTabAttributes">
                @RelatedElementsContent
            </TmTabPanel>
            <TmTabPanel Id="source"
                        Title="@Loc["TmModelingEditor_Source"]"
                        Badge="@SourceTabBadge"
                        TabAttributes="@SourceTabAttributes">
                @SourcePanelContent
            </TmTabPanel>
        </TmTabs>
    </div> : null;

    /// <summary>The status strip for the shell's status bar region.</summary>
    private RenderFragment? StatusBarSlot => WorkspaceMounted ? @<div class="tm-modeling-editor__status"
            data-testid="@TestId("modeling-status-strip")"
            aria-label="@Loc["TmModelingEditor_Status"]"
            role="status"
            aria-live="polite"
            aria-atomic="true">
        @StatusStripContent
    </div> : null;
}
