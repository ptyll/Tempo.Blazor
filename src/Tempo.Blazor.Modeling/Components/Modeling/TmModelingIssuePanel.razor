@using Tempo.Blazor.Modeling
@inherits Tempo.Blazor.Components.TmComponentBase

<section class="@RootClass"
         data-testid="@TestId("modeling-issue-panel")"
         data-issue-count="@Issues.Count"
         aria-label="@Loc["TmModelingIssuePanel_Title"]">
    <header class="tm-modeling-issue-panel__header">
        <h3 class="tm-modeling-issue-panel__title">@Loc["TmModelingIssuePanel_Title"]</h3>
        @* Neutral count formulation (B16) rendered as a COUNT-ONLY badge (gap #12): the visible
           text is the bare number, the localized "Issues: {0}" formulation lives on the
           visually-hidden span, so no language has to pick a grammatical form in the visible
           header and the accessible name comes from the real content. *@
        <span class="tm-modeling-issue-panel__count"
              data-testid="@TestId("modeling-issue-count")">
            <span aria-hidden="true">@Issues.Count</span>
            <span class="tm-sr-only">@Loc["TmModelingIssuePanel_Count", Issues.Count]</span>
        </span>
    </header>

    @if (Issues.Count == 0)
    {
        <div class="tm-modeling-issue-panel__empty" data-testid="@TestId("modeling-issue-empty")">
            <strong>@Loc["TmModelingIssuePanel_EmptyTitle"]</strong>
            <span>@Loc["TmModelingIssuePanel_EmptyText"]</span>
        </div>
    }
    else
    {
        <ol class="tm-modeling-issue-panel__list" data-testid="@TestId("modeling-issue-list")">
            @foreach (var issue in Issues.Select((value, index) => (value, index)))
            {
                <li role="listitem">
                    @* Nálezy bez zdroje (no SourceElementId/SourceRelationshipId) have no navigation
                       target: they render as a non-interactive list item — no <button>, no pointer
                       cursor, no hover affordance, no chevron. Navigable issues keep the button
                       whose accessible name is its visible content (NO aria-label override) plus a
                       visually-hidden navigation hint. Both wrappers share ONE body fragment below,
                       so the row content can never drift between the two variants. *@
                    @if (IsNavigable(issue.value))
                    {
                        <button type="button"
                                class="@GetIssueClass(issue.value) tm-modeling-issue-panel__item--navigable"
                                data-testid="@($"modeling-issue-{issue.index}")"
                                data-severity="@GetSeverityKey(issue.value)"
                                data-source-element-id="@issue.value.SourceElementId"
                                data-source-relationship-id="@issue.value.SourceRelationshipId"
                                @onclick="() => SelectIssueAsync(issue.value)">
                            @IssueBody(issue.value, issue.index)
                            <span class="tm-sr-only">@Loc["TmModelingIssuePanel_NavigateHint"]</span>
                        </button>
                    }
                    else
                    {
                        <div class="@GetIssueClass(issue.value)"
                             data-testid="@($"modeling-issue-{issue.index}")"
                             data-severity="@GetSeverityKey(issue.value)"
                             data-source-element-id="@issue.value.SourceElementId"
                             data-source-relationship-id="@issue.value.SourceRelationshipId">
                            @IssueBody(issue.value, issue.index)
                        </div>
                    }
                </li>
            }
        </ol>
    }
</section>

@code {
    /// <summary>
    /// The shared row body (severity icon, meta, message, suggested fix) rendered by BOTH the
    /// navigable button and the sourceless div wrapper — one source of truth for the content.
    /// The trailing chevron is part of the shared fragment and is keyed off the same
    /// <see cref="IsNavigable"/> predicate as the wrapper, so the two variants cannot drift.
    /// </summary>
    private RenderFragment IssueBody(ModelingIssueDto issue, int index) => @<text>
        <span class="@GetIconClass(issue)" aria-hidden="true">
            <TmIcon Name="@GetSeverityIcon(issue)" Size="IconSize.Sm" />
        </span>
        <span class="tm-modeling-issue-panel__body">
            <span class="tm-modeling-issue-panel__meta">
                <strong class="@GetSeverityClass(issue)">@GetSeverityLabel(issue)</strong>
                @if (!string.IsNullOrWhiteSpace(issue.Category))
                {
                    <span class="tm-modeling-issue-panel__category">@issue.Category</span>
                }
            </span>
            <span class="tm-modeling-issue-panel__message">@GetMessage(issue)</span>
            @if (!string.IsNullOrWhiteSpace(issue.SuggestedFix))
            {
                <span class="@GetFixClass(issue)" data-testid="@($"modeling-issue-fix-{index}")">
                    <span class="tm-modeling-issue-panel__fix-icon" aria-hidden="true">
                        <TmIcon Name="@IconNames.WandSparkles" Size="IconSize.Xs" />
                    </span>
                    <span class="tm-modeling-issue-panel__fix-label">@Loc["TmModelingIssuePanel_SuggestedFixLabel"]</span>
                    <span class="tm-modeling-issue-panel__fix-text">@issue.SuggestedFix</span>
                </span>
            }
        </span>
        @if (IsNavigable(issue))
        {
            <span class="tm-modeling-issue-panel__chevron" aria-hidden="true">
                <TmIcon Name="@IconNames.ChevronRight" Size="IconSize.Xs" />
            </span>
        }
    </text>;
}
