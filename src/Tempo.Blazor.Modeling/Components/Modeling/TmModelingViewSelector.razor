@using Tempo.Blazor.Modeling
@inherits Tempo.Blazor.Components.TmComponentBase

<section class="@RootClass"
         data-testid="@TestId("modeling-view-selector")"
         data-notation="@CurrentNotation"
         data-viewpoint="@CurrentViewpoint"
         aria-label="@Loc["TmModelingViewSelector_Title"]">
    <label class="tm-modeling-view-selector__field">
        <span>@Loc["TmModelingViewSelector_Notation"]</span>
        <select data-testid="@TestId("modeling-notation-select")"
                value="@CurrentNotation"
                @onchange="HandleNotationChangedAsync">
            <option value="">@Loc["TmModelingViewSelector_SelectNotation"]</option>
            @foreach (var option in NotationOptions)
            {
                <option value="@option.Key">@option.Label</option>
            }
        </select>
    </label>

    @if (ShouldShowViewpointSelect)
    {
        <label class="tm-modeling-view-selector__field">
            <span>@Loc["TmModelingViewSelector_Viewpoint"]</span>
            <select data-testid="@TestId("modeling-viewpoint-select")"
                    value="@CurrentViewpoint"
                    @onchange="HandleViewpointChangedAsync">
                @foreach (var option in ViewpointOptions)
                {
                    <option value="@option.Key">@option.Label</option>
                }
            </select>
        </label>
    }
    else
    {
        @* Review fix (phase 3): the Viewpoint field keeps its shape — a labeled DISABLED select
           (described by the hint) plus a plain hint span, instead of a boxed message. The
           visible span is not a wrapping <label>, so the select carries its name on aria-label
           (axe select-name rule); the per-instance id pairs it with the hint for assistive tech. *@
        <div class="tm-modeling-view-selector__field" data-testid="@TestId("modeling-viewpoint-empty")">
            <span>@Loc["TmModelingViewSelector_Viewpoint"]</span>
            <select disabled
                    aria-label="@Loc["TmModelingViewSelector_Viewpoint"]"
                    aria-describedby="@ViewpointHintId"></select>
            <span id="@ViewpointHintId" class="tm-modeling-view-selector__hint">@ViewpointEmptyText</span>
        </div>
    }
</section>
