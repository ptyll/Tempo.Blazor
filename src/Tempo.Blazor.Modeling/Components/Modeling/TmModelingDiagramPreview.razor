@using Microsoft.AspNetCore.Components.Web
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Components.Diagram
@using Tempo.Blazor.Components.Diagram.Models

<section class="@RootClass"
         data-testid="@TestId("modeling-diagram-preview")"
         data-state="@StateName"
         data-node-count="@NodeCount"
         data-edge-count="@EdgeCount"
         data-drop-enabled="@AllowNodeDrop.ToString().ToLowerInvariant()">
    <header class="tm-modeling-diagram-preview__header">
        <div class="tm-modeling-diagram-preview__title-group">
            <h3>@Loc["TmModelingDiagramPreview_Title"]</h3>
            <span>@SummaryText</span>
        </div>
        @* Fáze 7 (G2): on a mobile layout the preview shows viewer controls only — the edit
           entries (generate / open in editor) live in the editor's action bar and header
           overflow, so no header actions render here. *@
        @if (ShowEditActions)
        {
            <div class="tm-modeling-diagram-preview__actions">
                @if (OnGenerateRequested.HasDelegate)
                {
                    <TmButton Variant="ButtonVariant.Secondary"
                              Size="ButtonSize.Sm"
                              Icon="@IconNames.Refresh"
                              OnClick="HandleGenerateRequestedAsync"
                              data-testid="@TestId("modeling-generate-diagram-button")">
                        @Loc["TmModelingDiagramPreview_Generate"]
                    </TmButton>
                }
                <TmButton Variant="ButtonVariant.Primary"
                          Size="ButtonSize.Sm"
                          Icon="@IconNames.ExternalLink"
                          Disabled="@(Document is null)"
                          OnClick="HandleOpenInEditorAsync"
                          AriaLabel="@Loc["TmModelingDiagramPreview_OpenInEditor"]"
                          data-modeling-focus="open-in-editor"
                          id="@OpenInEditorTriggerId"
                          data-testid="@TestId("modeling-open-in-editor-button")">
                    @Loc["TmModelingDiagramPreview_OpenInEditor"]
                </TmButton>
            </div>
        }
    </header>

    @if (Document is null)
    {
        <div class="tm-modeling-diagram-preview__empty" data-testid="@TestId("modeling-diagram-preview-empty")">
            <strong>@Loc["TmModelingDiagramPreview_EmptyTitle"]</strong>
            <span>@Loc["TmModelingDiagramPreview_EmptyText"]</span>
        </div>
    }
    else
    {
        <div class="tm-modeling-diagram-preview__canvas-shell"
             data-testid="@TestId("modeling-diagram-preview-canvas-shell")"
             data-drop-enabled="@AllowNodeDrop.ToString().ToLowerInvariant()"
             data-dragging="@((ActiveDraggedElement is not null).ToString().ToLowerInvariant())"
             @ondragover="HandleDragOver"
             @ondragover:preventDefault
             @ondrop="HandleDropAsync"
             @ondrop:preventDefault>
            @if (IsEmptyDiagram)
            {
                <div class="tm-modeling-diagram-preview__empty-diagram-hint" data-testid="@TestId("modeling-diagram-preview-empty-diagram-hint")">
                    @Loc["TmModelingDiagramPreview_EmptyDiagramHint"]
                </div>
            }
            @* The viewer keeps ONE toolbar row through the editor's own API: the Viewer group set
               minus export (a preview never exports) — the explicit flags override the preset,
               so no export group folds into a second row. Never CSS on the editor's internals.
               Fáze 7 review: on the mobile band the host drops the chrome entirely through
               ShowToolbar=false — the DE header bar would hold ONLY the "⋯" trigger there (the
               floating zoom pill duplicates the canvas pinch) and the page tabs stay (no public
               hide switch — noted for the DE plan). The @ref backs GetViewport: the non-drag
               "Insert into preview" path targets the center of what the user SEES, not the page
               center. *@
            <TmDiagramEditor @ref="_editor"
                             Document="@Document"
                             DocumentChanged="HandleDocumentChangedAsync"
                             ReadOnly="true"
                             ToolbarPreset="DiagramToolbarPreset.Viewer"
                             ToolbarGroups="DiagramToolbarGroups.Zoom | DiagramToolbarGroups.View | DiagramToolbarGroups.Search"
                             ShowTitle="false"
                             ShowToolbox="false"
                             ShowPropertiesPanel="false"
                             ShowLayersPanel="false"
                             ShowMinimap="false"
                             ShowPageView="false"
                             ShowToolbar="@ShowEmbeddedEditorChrome"
                             OnSelectedIdsChanged="HandleSelectedIdsChangedAsync"
                             Class="tm-modeling-diagram-preview__editor" />
        </div>
        @if (ActiveDraggedElement is not null && AllowNodeDrop)
        {
            @* Only while a model-tree drag is live (review fix, phase 5): a permanent hint row
               ate a slice of the canvas column at every viewport, and the dashed drop-zone
               border read as a permanent affordance. Gated on AllowNodeDrop too — a layout that
               ignores drops (mobile, Fáze 7) never paints the affordance. *@
            <div class="tm-modeling-diagram-preview__drop-hint" data-testid="@TestId("modeling-diagram-preview-drop-hint")">
                @Loc["TmModelingDiagramPreview_DropHint"]
            </div>
        }
    }
</section>
