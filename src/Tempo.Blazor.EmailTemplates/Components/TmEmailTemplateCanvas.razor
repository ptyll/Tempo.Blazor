@namespace Tempo.Blazor.EmailTemplates.Components

@* Fáze 9A — the canvas is WYSIWYG: the "paper" below is the email as it will look (an approximation of
   the MJML output, the authoritative output stays the server preview). The block chrome (selection frame,
   drag handle, actions) lives on the WRAPPER element, so selecting a block never rebuilds its body.
   Security: block text goes through IHtmlContentSanitizer, an mj-raw block is never markup, no link is
   navigable and every URL passes the pipeline's allow-list (see EmailCanvasMarkup / EmailCanvasValue). *@
<div class="tm-email-canvas-doc" data-tm-canvas-doc data-tm-canvas-paper tabindex="0" @ref="_rootRef"
     role="list" aria-label="@Loc["EmailEditor_Panel_Blocks"]"
     data-tm-readonly="@(ReadOnly ? "true" : "false")"
     style="@PaperStyle"
     @onkeydown="HandleKeyDownAsync">
    @if (Document.Sections.Count == 0)
    {
        <TmEmptyState Icon="mail" Title="@Loc["EmailEditor_Canvas_Empty"]" />
    }
    else
    {
        @* The one tab stop of the list, resolved ONCE per render: asking per item would walk the whole
           document for every block (O(n²) on a 200-block template). *@
        var tabStopId = FirstTabStopId;
        @foreach (var section in Document.Sections)
        {
            @* The @key is the node identity: without it Blazor matches items by POSITION, so moving a section
               (or deleting one above another) re-used the previous component instance for the next model
               item — the render gate then compared a signature of a DIFFERENT block and the @ref map pointed
               at a detached element. *@
            <div @key="section.Id"
                 class="tm-email-canvas-section @SelectedClass(section.Id)"
                 @ref="_sectionRefs[section.Id]"
                 data-tm-section="@(section.Id)" role="group" tabindex="@RovingTabIndex(section.Id, tabStopId)"
                 aria-label="@Loc["EmailEditor_Canvas_SectionLabel", SectionNumber(section)]"
                 aria-current="@AriaCurrent(section.Id)"
                 style="@SectionStyle(section)"
                 @onclick="() => SelectAsync(section.Id)" @onclick:stopPropagation="true">
                @if (SectionBackground(section) is { } background)
                {
                    <img class="tm-email-canvas-section__bg" src="@background" alt="" aria-hidden="true"
                         referrerpolicy="no-referrer" loading="lazy" />
                }
                else if (IsSectionBackgroundBlocked(section))
                {
                    <span class="tm-email-canvas-section__bg-blocked" data-tm-image-blocked="true"
                          title="@Loc["EmailEditor_Canvas_ImageBlocked"]">
                        <TmIcon Name="alert-triangle" Size="IconSize.Xs" />
                        <span class="tm-sr-only">@Loc["EmailEditor_Canvas_ImageBlocked"]</span>
                    </span>
                }
                @if (!ReadOnly)
                {
                    <div class="tm-email-canvas-section__toolbar">
                        <button type="button" data-tm-section-action="add-column"
                                aria-label="@Loc["EmailEditor_Section_AddColumn"]"
                                @onclick="() => AddColumnAsync(section)" @onclick:stopPropagation="true">
                            <TmIcon Name="columns" Size="IconSize.Xs" />
                        </button>
                        <button type="button" data-tm-section-action="up"
                                aria-label="@Loc["EmailEditor_Action_MoveUp"]"
                                @onclick="() => MoveSectionAsync(section, -1)" @onclick:stopPropagation="true">
                            <TmIcon Name="chevron-up" Size="IconSize.Xs" />
                        </button>
                        <button type="button" data-tm-section-action="down"
                                aria-label="@Loc["EmailEditor_Action_MoveDown"]"
                                @onclick="() => MoveSectionAsync(section, 1)" @onclick:stopPropagation="true">
                            <TmIcon Name="chevron-down" Size="IconSize.Xs" />
                        </button>
                        <button type="button" data-tm-section-action="duplicate"
                                aria-label="@Loc["EmailEditor_Action_Duplicate"]"
                                @onclick="() => DuplicateSectionAsync(section)" @onclick:stopPropagation="true">
                            <TmIcon Name="copy" Size="IconSize.Xs" />
                        </button>
                        <button type="button" data-tm-section-action="delete"
                                aria-label="@Loc["EmailEditor_Action_Delete"]"
                                @onclick="() => DeleteSectionAsync(section)" @onclick:stopPropagation="true">
                            <TmIcon Name="trash-2" Size="IconSize.Xs" />
                        </button>
                    </div>
                }
                <div class="tm-email-canvas-section__columns">
                    @foreach (var column in section.Columns)
                    {
                        <div @key="column.Id"
                             class="tm-email-canvas-column @SelectedClass(column.Id)"
                             data-tm-column="@column.Id" role="group"
                             aria-current="@AriaCurrent(column.Id)"
                             style="@TmEmailCanvasBlock.ColumnStyle(column)"
                             @onclick="() => SelectAsync(column.Id)" @onclick:stopPropagation="true">
                            @if (section.Columns.Count > 1 && !ReadOnly)
                            {
                                <button type="button" class="tm-email-canvas-column__remove"
                                        data-tm-column-action="remove"
                                        aria-label="@Loc["EmailEditor_Section_RemoveColumn"]"
                                        @onclick="() => RemoveColumnAsync(section, column)" @onclick:stopPropagation="true">
                                    <TmIcon Name="x" Size="IconSize.Xs" />
                                </button>
                            }
                            @if (column.Blocks.Count == 0)
                            {
                                <div class="tm-email-canvas-column__empty @(DragActive ? "is-drop-active" : "")"
                                     data-tm-drop-col="@column.Id" data-tm-drop-index="0" data-tm-drop-empty
                                     @ondragenter:preventDefault="true"
                                     @ondragover:preventDefault="true"
                                     @ondrop="() => OnDropInColumn.InvokeAsync((column.Id, 0))"
                                     @ondrop:preventDefault="true"
                                     @ondrop:stopPropagation="true">
                                    @Loc["EmailEditor_Canvas_EmptyColumn"]
                                </div>
                            }
                            @for (var i = 0; i < column.Blocks.Count; i++)
                            {
                                var block = column.Blocks[i];
                                var index = i;
                                var columnId = column.Id;
                                if (DragActive)
                                {
                                    <div class="tm-email-canvas-dropzone" data-tm-drop-col="@columnId" data-tm-drop-index="@index"
                                         @ondragenter:preventDefault="true"
                                         @ondragover:preventDefault="true"
                                         @ondrop="() => OnDropInColumn.InvokeAsync((columnId, index))"
                                         @ondrop:preventDefault="true"
                                         @ondrop:stopPropagation="true"></div>
                                }
                                <div @key="block.Id"
                                     class="@BlockClass(block, index)"
                                     @ref="_blockRefs[block.Id]"
                                     data-tm-block-id="@block.Id" role="listitem" tabindex="@RovingTabIndex(block.Id, tabStopId)"
                                     draggable="@(ReadOnly ? null : "true")"
                                     data-tm-block-kind="@BlockKind(block)"
                                     aria-label="@BlockLabel(block)"
                                     aria-current="@AriaCurrent(block.Id)"
                                     @ondragstart="() => OnBlockDragStart.InvokeAsync(block.Id)"
                                     @onclick="() => SelectAsync(block.Id)" @onclick:stopPropagation="true">
                                    @if (!ReadOnly)
                                    {
                                        <div class="tm-email-canvas-block__toolbar">
                                            <span class="tm-email-canvas-block__grip" data-tm-block-grip
                                                  aria-hidden="true">
                                                <TmIcon Name="grip-vertical" Size="IconSize.Xs" />
                                            </span>
                                            <button type="button" data-tm-block-action="up"
                                                    aria-label="@Loc["EmailEditor_Action_MoveUp"]"
                                                    @onclick="() => MoveBlockAsync(block, -1)" @onclick:stopPropagation="true">
                                                <TmIcon Name="chevron-up" Size="IconSize.Xs" />
                                            </button>
                                            <button type="button" data-tm-block-action="down"
                                                    aria-label="@Loc["EmailEditor_Action_MoveDown"]"
                                                    @onclick="() => MoveBlockAsync(block, 1)" @onclick:stopPropagation="true">
                                                <TmIcon Name="chevron-down" Size="IconSize.Xs" />
                                            </button>
                                            <button type="button" data-tm-block-action="duplicate"
                                                    aria-label="@Loc["EmailEditor_Action_Duplicate"]"
                                                    @onclick="() => DuplicateBlockAsync(block)" @onclick:stopPropagation="true">
                                                <TmIcon Name="copy" Size="IconSize.Xs" />
                                            </button>
                                            <button type="button" data-tm-block-action="delete"
                                                    aria-label="@Loc["EmailEditor_Action_Delete"]"
                                                    @onclick="() => DeleteBlockAsync(block)" @onclick:stopPropagation="true">
                                                <TmIcon Name="trash-2" Size="IconSize.Xs" />
                                            </button>
                                        </div>
                                    }
                                    <TmEmailCanvasBlock Block="block" CanvasImageLoading="CanvasImageLoading" />
                                </div>
                            }
                            @if (DragActive && column.Blocks.Count > 0)
                            {
                                <div class="tm-email-canvas-dropzone tm-email-canvas-dropzone--end"
                                     data-tm-drop-col="@column.Id" data-tm-drop-index="@column.Blocks.Count"
                                     @ondragenter:preventDefault="true"
                                     @ondragover:preventDefault="true"
                                     @ondrop="() => OnDropInColumn.InvokeAsync((column.Id, column.Blocks.Count))"
                                     @ondrop:preventDefault="true"
                                     @ondrop:stopPropagation="true"></div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>
