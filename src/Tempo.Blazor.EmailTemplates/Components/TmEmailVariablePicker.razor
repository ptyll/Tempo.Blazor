@namespace Tempo.Blazor.EmailTemplates.Components
@implements IAsyncDisposable
@inject IJSRuntime JS

@* The variable catalogue: every row is the token in a code chip plus — when the host supplied one — the
   human description, grouped under the host's group heading. Search covers BOTH the path and the
   description (diacritics folded), so a user who does not know the token can find it by what it means.
   Keyboard: the search takes focus when the picker opens, ArrowDown reaches the first row and
   ArrowUp/ArrowDown walk a roving tabindex; Enter activates the row natively. *@
<div class="tm-email-variables" data-tm-variable-picker>
    <TmSearchInput @ref="_searchField" Value="@_search" ValueChanged="OnSearchChanged" Disabled="ReadOnly"
                   Placeholder="@Loc["EmailEditor_Variables_Search"]" OnKeyDown="OnSearchKeyDown" />

    @if (Variables.Count == 0)
    {
        <p class="tm-email-variables__empty" data-tm-variable-empty>@Loc["EmailEditor_Variables_Empty"]</p>
    }
    else if (Rows.Count == 0)
    {
        <p class="tm-email-variables__empty" data-tm-variable-nomatch>@Loc["EmailEditor_Variables_NoMatch", _search]</p>
    }
    else
    {
        var rowIndex = 0;
        @foreach (var group in Groups)
        {
            <div class="tm-email-variables__group" data-tm-variable-group="@group.Heading">
                @if (!string.IsNullOrEmpty(group.Heading))
                {
                    <header class="tm-email-variables__group-heading">@group.Heading</header>
                }
                <ul class="tm-email-variables__list">
                    @foreach (var variable in group.Variables)
                    {
                        var path = variable.Path;
                        var index = rowIndex++;
                        var height = index;
                        <li>
                            <button type="button" class="tm-email-variables__item" data-tm-variable="@path"
                                    @ref="_rowRefs[path]"
                                    tabindex="@(height == _focusIndex ? "0" : "-1")"
                                    title="@Token(path)" disabled="@ReadOnly"
                                    @onclick="() => InsertAsync(path)"
                                    @onkeydown="args => OnRowKeyDownAsync(args, height)">
                                <code>@Token(path)</code>
                                @if (variable.Kind == VariableKind.Collection)
                                {
                                    <span class="tm-email-variables__badge">[]</span>
                                }
                                @if (!string.IsNullOrEmpty(variable.Description))
                                {
                                    <span class="tm-email-variables__description">@variable.Description</span>
                                }
                            </button>
                        </li>
                    }
                </ul>
            </div>
        }
    }
</div>

@code {
    /// <summary>The variables available to insert (extracted from the document plus host-provided).</summary>
    [Parameter] public IReadOnlyList<TemplateVariableInfo> Variables { get; set; } = Array.Empty<TemplateVariableInfo>();

    /// <summary>Raised with the <c>{{ path }}</c> token when a variable is chosen.</summary>
    [Parameter] public EventCallback<string> OnInsert { get; set; }

    /// <summary>
    /// Renders the picker read-only: inserting a variable edits the document, so the list is disabled and
    /// <see cref="InsertAsync"/> never calls the host's <see cref="OnInsert"/>.
    /// </summary>
    [Parameter] public bool ReadOnly { get; set; }

    private const string ModulePath = "./_content/Tempo.Blazor.EmailTemplates/tm-email-variable-insert.js";

    /// <summary>
    /// The text in the picker's search field - two-way bindable (<c>@bind-Filter</c>, decision
    /// EMAIL-VARIABLE-PICKER-FILTER). A host that keeps the value outside the picker (the editor's inspector
    /// state) gets the filter back after the picker is remounted, e.g. by a desktop ↔ tablet layout flip.
    /// <see langword="null"/> is the empty filter. Without a binding the picker keeps the text itself,
    /// exactly as before.
    /// </summary>
    [Parameter] public string? Filter { get; set; }

    /// <summary>Raised with the new text whenever the user edits the search field.</summary>
    [Parameter] public EventCallback<string> FilterChanged { get; set; }

    private string _search = string.Empty;
    // The Filter parameter value this component last adopted: a re-render that hands the same value back
    // (the echo of our own FilterChanged, or a host that never binds it) must not overwrite what was typed.
    private string? _filterSeen;
    private IJSObjectReference? _module;
    private TmSearchInput? _searchField;
    private readonly Dictionary<string, ElementReference> _rowRefs = new(StringComparer.Ordinal);
    private int _focusIndex;
    private bool _focusPending;

    /// <summary>The filtered catalogue in display order; the roving tabindex walks THIS list.</summary>
    private IReadOnlyList<TemplateVariableInfo> Rows
        => string.IsNullOrWhiteSpace(_search)
            ? Variables
            : Variables
                .Where(variable =>
                    EmailSearchText.Contains(variable.Path, _search)
                    || EmailSearchText.Contains(variable.Description, _search))
                .ToList();

    private sealed record VariableGroup(string Heading, IReadOnlyList<TemplateVariableInfo> Variables);

    private IReadOnlyList<VariableGroup> Groups
    {
        get
        {
            var filtered = Rows;
            if (filtered.Count == 0) return Array.Empty<VariableGroup>();

            var grouped = filtered
                .GroupBy(variable => variable.Group)
                .OrderBy(group => group.Key is null ? 1 : 0)
                .ThenBy(group => group.Key, StringComparer.CurrentCulture)
                .ToList();

            // A single unnamed bucket needs no heading at all: a picker with no host metadata stays a flat
            // list, exactly as before.
            if (grouped.Count == 1 && grouped[0].Key is null)
                return new[] { new VariableGroup(string.Empty, grouped[0].OrderBy(v => v.Path, StringComparer.Ordinal).ToList()) };

            return grouped
                .Select(group => new VariableGroup(
                    group.Key ?? Loc["EmailEditor_Variables_Group_Other"],
                    group.OrderBy(v => v.Path, StringComparer.Ordinal).ToList()))
                .ToList();
        }
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (string.Equals(Filter, _filterSeen, StringComparison.Ordinal)) return;

        _filterSeen = Filter;
        var next = Filter ?? string.Empty;
        if (!string.Equals(next, _search, StringComparison.Ordinal))
        {
            _search = next;
            _focusIndex = 0;
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _searchField is not null)
        {
            // A picker that opens on a keyboard shortcut must be usable without a mouse: the caret starts in
            // the filter, and one ArrowDown reaches the catalogue.
            await _searchField.FocusAsync();
        }

        if (_focusPending && Rows.Count > 0)
        {
            _focusPending = false;
            var path = Rows[Math.Clamp(_focusIndex, 0, Rows.Count - 1)].Path;
            if (_rowRefs.TryGetValue(path, out var row)) await row.FocusAsync();
        }
    }

    private Task OnSearchChanged(string value)
    {
        _search = value ?? string.Empty;
        _focusIndex = 0;
        return FilterChanged.InvokeAsync(_search);
    }

    private Task OnSearchKeyDown(KeyboardEventArgs args)
        => string.Equals(args.Key, "ArrowDown", StringComparison.Ordinal) ? FocusRowAsync(0) : Task.CompletedTask;

    private Task OnRowKeyDownAsync(KeyboardEventArgs args, int index) => args.Key switch
    {
        "ArrowDown" => FocusRowAsync(index + 1),
        "ArrowUp" => FocusRowAsync(index - 1),
        "Home" => FocusRowAsync(0),
        "End" => FocusRowAsync(int.MaxValue),
        _ => Task.CompletedTask,
    };

    /// <summary>
    /// Roving tabindex: exactly one row is the tab stop, and the arrow keys move focus through the list with
    /// <see cref="ElementReference.FocusAsync"/> (no JS, no scroll maths — focus scrolls the row into view).
    /// </summary>
    private Task FocusRowAsync(int index)
    {
        if (Rows.Count == 0) return Task.CompletedTask;

        _focusIndex = Math.Clamp(index, 0, Rows.Count - 1);
        _focusPending = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private static string Token(string path) => "{{ " + path + " }}";

    /// <summary>
    /// Inserts the token at the caret of the last-focused field via JS interop; falls back to the
    /// <see cref="OnInsert"/> callback when no field is focused or interop is unavailable (tests/prerender).
    /// </summary>
    private async Task InsertAsync(string path)
    {
        if (ReadOnly) return;
        var token = Token(path);
        var inserted = false;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            if (_module is not null) inserted = await _module.InvokeAsync<bool>("insertToken", token);
        }
        catch (JSException)
        {
            // Interop not available — use the model-level fallback below.
        }

        if (!inserted) await OnInsert.InvokeAsync(token);
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
