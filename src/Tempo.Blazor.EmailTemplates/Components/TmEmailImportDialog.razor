@namespace Tempo.Blazor.EmailTemplates.Components

<TmModal Show="Show" Title="@Loc["EmailEditor_Import_Title"]" Size="ModalSize.Large" OnClose="OnClose">
    <div class="tm-email-import">
        <div class="tm-email-import__modes" role="group">
            <TmButton Size="ButtonSize.Sm" Variant="@ModeVariant(false)" data-tm-import-mode="mjml"
                      OnClick="() => SetJsonMode(false)">MJML</TmButton>
            <TmButton Size="ButtonSize.Sm" Variant="@ModeVariant(true)" data-tm-import-mode="json"
                      OnClick="() => SetJsonMode(true)">JSON</TmButton>
        </div>

        <TmFileDropZone Accept="@(_json ? ".json" : ".mjml,.html,.txt")" InputAriaLabel="@Loc["EmailEditor_Import_Title"]"
                        InputTestId="tm-import-file" OnFilesSelected="OnFileSelectedAsync" />

        <textarea class="tm-email-import__input" data-tm-import-input rows="14"
                  placeholder="@Loc["EmailEditor_Import_Placeholder"]"
                  value="@_input" @oninput="OnInput"></textarea>

        @if (_errors.Count > 0)
        {
            <TmAlert Severity="AlertSeverity.Error" data-tm-import-errors="true">
                <ul>@foreach (var e in _errors) { <li>@e</li> }</ul>
            </TmAlert>
        }

        @* The imported document's own findings (a preheader over the limit, an image without alt text) are
           warnings, not failures. They go through the same formatter as the validation panel, so a rule that
           names its threshold shows the number instead of a literal „{0}“. *@
        @if (_warnings.Count > 0)
        {
            <TmAlert Severity="AlertSeverity.Info" data-tm-import-warnings="true">
                <ul>@foreach (var w in _warnings) { <li>@w</li> }</ul>
            </TmAlert>
        }

        @if (_errors.Count == 0 && _preview is not null)
        {
            <p class="tm-email-import__summary" data-tm-import-summary>
                @Loc["EmailEditor_Import_Summary", _preview.Sections.Count, _warnings.Count]
            </p>
        }

        <TmButton Variant="ButtonVariant.Primary" data-tm-import-confirm="true"
                  Disabled="@(_preview is null)" OnClick="ConfirmAsync">@Loc["EmailEditor_Import_Confirm"]</TmButton>
    </div>
</TmModal>

@code {
    /// <summary>Whether the dialog is shown.</summary>
    [Parameter] public bool Show { get; set; }

    /// <summary>Raised with the imported document when the user confirms.</summary>
    [Parameter] public EventCallback<EmailTemplateDocument> OnImport { get; set; }

    /// <summary>Raised when the dialog is closed.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    private string _input = string.Empty;
    private bool _json;
    private EmailTemplateDocument? _preview;
    private List<string> _warnings = new();
    private List<string> _errors = new();

    private void OnInput(ChangeEventArgs e)
    {
        _input = e.Value?.ToString() ?? string.Empty;
        Parse();
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024));
        _input = await reader.ReadToEndAsync();
        Parse();
    }

    private void SetJsonMode(bool json)
    {
        _json = json;
        Parse();
    }

    private void Parse()
    {
        _preview = null;
        _warnings = new();
        _errors = new();

        if (string.IsNullOrWhiteSpace(_input)) return;

        if (_json)
        {
            try
            {
                _preview = EmailTemplateSerializer.Deserialize(_input);
            }
            catch (EmailTemplateSerializationException ex)
            {
                _errors.Add(ex.Message);
            }
        }
        else
        {
            var result = new MjmlImporter().Import(_input);
            _preview = result.Document;
            _warnings = result.Warnings.Select(MessageText).ToList();
            _errors = result.Errors.Select(MessageText).ToList();
        }
    }

    /// <summary>
    /// The localized text of one import diagnostic. A rule key resolves through
    /// <see cref="ValidationMessageText"/> (its threshold is formatted there); a message that carries a
    /// detail (an element name, a parse position) formats that detail into the sentence.
    /// </summary>
    private string MessageText(ImportMessage message)
        => string.Equals(message.Key, DocumentValidationKeys.PreheaderTooLong, StringComparison.Ordinal)
            || message.Detail is null
                ? ValidationMessageText.Of(Loc, message.Key)
                : Loc[message.Key, message.Detail];

    private async Task ConfirmAsync()
    {
        if (_preview is not null) await OnImport.InvokeAsync(_preview);
    }

    private ButtonVariant ModeVariant(bool json) => _json == json ? ButtonVariant.Primary : ButtonVariant.Ghost;
}
