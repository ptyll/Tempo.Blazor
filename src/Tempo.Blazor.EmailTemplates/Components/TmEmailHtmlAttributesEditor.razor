@namespace Tempo.Blazor.EmailTemplates.Components

<div class="tm-email-html-attrs" data-tm-html-attrs-editor>
    @for (var i = 0; i < Selectors.Count; i++)
    {
        var selector = Selectors[i];
        <div class="tm-email-html-attrs__selector" data-tm-html-selector>
            <div class="tm-email-html-attrs__selector-head">
                <TmTextInput Placeholder="@Loc["EmailEditor_HtmlAttr_Path"]" Value="@selector.Path" Disabled="ReadOnly"
                             ValueChanged="@(v => SetPathAsync(selector, v))" />
                <button type="button" data-tm-html-selector-remove aria-label="@Loc["EmailEditor_Action_Delete"]"
                        disabled="@ReadOnly" @onclick="() => RemoveAsync(selector)">
                    <TmIcon Name="trash-2" Size="IconSize.Xs" />
                </button>
            </div>
            <TmEmailKeyValueEditor Items="selector.Attributes" OnChanged="OnChanged" ReadOnly="ReadOnly" />
        </div>
    }
    <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Secondary" Icon="plus" Disabled="ReadOnly"
              data-tm-html-add="true" OnClick="AddAsync">@Loc["EmailEditor_HtmlAttr_Add"]</TmButton>
</div>

@code {
    /// <summary>The <c>mj-html-attributes</c> selectors (round-trip only; not rendered by Mjml.Net).</summary>
    [Parameter, EditorRequired] public IList<MjHtmlSelector> Selectors { get; set; } = default!;

    /// <summary>Raised after the selectors change.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Renders the selector list read-only (disabled controls plus early returns in every mutator).</summary>
    [Parameter] public bool ReadOnly { get; set; }

    private Task SetPathAsync(MjHtmlSelector selector, string path)
    {
        if (ReadOnly) return Task.CompletedTask;
        selector.Path = path;
        return OnChanged.InvokeAsync();
    }

    private async Task AddAsync()
    {
        if (ReadOnly) return;
        Selectors.Add(new MjHtmlSelector());
        await OnChanged.InvokeAsync();
    }

    private async Task RemoveAsync(MjHtmlSelector selector)
    {
        if (ReadOnly) return;
        Selectors.Remove(selector);
        await OnChanged.InvokeAsync();
    }
}
