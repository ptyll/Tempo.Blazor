@namespace Tempo.Blazor.EmailTemplates.Components

<div class="tm-email-fields">
    @foreach (var field in _primary)
    {
        @RenderField(field)
    }
    @if (_advanced.Count > 0)
    {
        <details class="tm-email-fields__advanced">
            <summary>@Loc["EmailEditor_Properties_Advanced"]</summary>
            @foreach (var field in _advanced)
            {
                @RenderField(field)
            }
        </details>
    }
</div>

@code {
    /// <summary>The model object whose scalar properties are edited.</summary>
    [Parameter, EditorRequired] public object Target { get; set; } = default!;

    /// <summary>Property names shown above the "Advanced" section, in order.</summary>
    [Parameter] public IReadOnlyList<string> Primary { get; set; } = Array.Empty<string>();

    /// <summary>Property names to omit (rendered by a dedicated editor elsewhere).</summary>
    [Parameter] public IReadOnlyList<string> Exclude { get; set; } = Array.Empty<string>();

    /// <summary>Raised after any field changes.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Renders every input disabled, so a read-only inspector shows the values but cannot edit them.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    private List<PropertyField> _primary = new();
    private List<PropertyField> _advanced = new();

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        var fields = PropertyReflection.GetFields(Target).Where(f => !Exclude.Contains(f.Name)).ToList();
        _primary = Primary
            .Select(name => fields.FirstOrDefault(f => f.Name == name))
            .Where(f => f is not null)
            .Select(f => f!)
            .ToList();
        _advanced = fields.Where(f => !Primary.Contains(f.Name)).ToList();
    }

    private RenderFragment RenderField(PropertyField field) => builder =>
    {
        var label = Humanize(field.Name);
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "tm-email-fields__field");
        builder.AddAttribute(2, "data-tm-prop", field.Name);

        switch (field.Kind)
        {
            case PropertyFieldKind.Text:
                builder.OpenComponent<TmTextInput>(10);
                builder.AddComponentParameter(11, nameof(TmTextInput.Label), label);
                builder.AddComponentParameter(14, nameof(TmTextInput.Disabled), ReadOnly);
                builder.AddComponentParameter(12, nameof(TmTextInput.Value), field.GetText());
                builder.AddComponentParameter(13, nameof(TmTextInput.ValueChanged),
                    EventCallback.Factory.Create<string>(this, async v => { if (ReadOnly) return; field.SetText(v); await OnChanged.InvokeAsync(); }));
                builder.CloseComponent();
                break;
            case PropertyFieldKind.MultilineText:
                builder.OpenComponent<TmTextArea>(20);
                builder.AddComponentParameter(21, nameof(TmTextArea.Label), label);
                builder.AddComponentParameter(24, nameof(TmTextArea.Disabled), ReadOnly);
                builder.AddComponentParameter(22, nameof(TmTextArea.Value), field.GetText());
                builder.AddComponentParameter(23, nameof(TmTextArea.ValueChanged),
                    EventCallback.Factory.Create<string>(this, async v => { if (ReadOnly) return; field.SetText(v); await OnChanged.InvokeAsync(); }));
                builder.CloseComponent();
                break;
            case PropertyFieldKind.Bool:
                builder.OpenComponent<TmToggle>(30);
                builder.AddComponentParameter(31, nameof(TmToggle.Label), label);
                builder.AddComponentParameter(34, nameof(TmToggle.Disabled), ReadOnly);
                builder.AddComponentParameter(32, nameof(TmToggle.Value), field.GetBool());
                builder.AddComponentParameter(33, nameof(TmToggle.ValueChanged),
                    EventCallback.Factory.Create<bool>(this, async v => { if (ReadOnly) return; field.SetBool(v); await OnChanged.InvokeAsync(); }));
                builder.CloseComponent();
                break;
            case PropertyFieldKind.Number:
                builder.OpenComponent<TmNumberInput>(40);
                builder.AddComponentParameter(41, nameof(TmNumberInput.Label), label);
                builder.AddComponentParameter(44, nameof(TmNumberInput.Disabled), ReadOnly);
                builder.AddComponentParameter(42, nameof(TmNumberInput.Value), field.GetNumber());
                builder.AddComponentParameter(43, nameof(TmNumberInput.ValueChanged),
                    EventCallback.Factory.Create<int?>(this, async v => { if (ReadOnly) return; field.SetNumber(v); await OnChanged.InvokeAsync(); }));
                builder.CloseComponent();
                break;
        }

        builder.CloseElement();
    };

    private static string Humanize(string name)
    {
        var sb = new System.Text.StringBuilder(name.Length + 4);
        for (var i = 0; i < name.Length; i++)
        {
            var c = name[i];
            if (i > 0 && char.IsUpper(c)) sb.Append(' ').Append(char.ToLowerInvariant(c));
            else sb.Append(i == 0 ? char.ToUpperInvariant(c) : c);
        }
        return sb.ToString();
    }
}
