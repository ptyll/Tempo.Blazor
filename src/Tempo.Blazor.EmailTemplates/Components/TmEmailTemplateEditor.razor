@namespace Tempo.Blazor.EmailTemplates.Components
@implements IDisposable
@inject IBlockRegistry Registry
@inject IServiceProvider Services
@inject IJSRuntime JS

@* Fáze 8: the editor owns NO layout of its own. The three regions are the CORE TmEditorShell's slots
   (F6): Header / Toolbar / Left (+ LeftRail) / Canvas / Right / StatusBar / MobileActions. The shell
   resolves the layout from its own CONTAINER (Breakpoints 768/1200) and renders docked panels on
   desktop AND tablet (at most one expanded — F6-TABLET-DOCKED-PANELS), a bottom sheet (default) or a
   Left | Canvas | Right tablist on mobile (EM3). Everything the editor does here is forwarding
   (D7/D10/D20) plus the two host fragments the shell cannot know about. *@
<div class="tm-email-editor" data-tm-email-editor tabindex="0" @ref="_rootRef"
     data-tm-readonly="@(ReadOnly ? "true" : "false")"
     data-tm-dirty="@(IsDirty ? "true" : "false")"
     data-tm-saving="@(IsSaving ? "true" : "false")"
     @onkeydown="HandleEditorKeyDownAsync">
    <TmEditorShell Class="tm-email-editor__shell"
                   LayoutMode="LayoutMode"
                   InitialMode="InitialMode"
                   Breakpoints="EffectiveBreakpoints"
                   ResolvedLayoutChanged="OnResolvedLayoutChangedAsync"
                   MobilePanelPresentation="MobilePanelPresentation"
                   ActiveMobilePanel="EffectiveActiveMobilePanel"
                   ActiveMobilePanelChanged="OnShellActiveMobilePanelChangedAsync"
                   CollapsedPanels="ShellCollapsedPanels"
                   CollapsedPanelsChanged="OnShellCollapsedPanelsChangedAsync"
                   LeftOpen="_leftOpen"
                   LeftOpenChanged="OnLeftOpenChangedAsync"
                   RightOpen="_rightOpen"
                   RightOpenChanged="OnRightOpenChangedAsync"
                   MobileSheetSnapPoints="MobileSheetSnaps"
                   MobileSheetSnapIndex="_sheetSnapIndex"
                   MobileSheetSnapIndexChanged="OnSheetSnapIndexChangedAsync"
                   LeftTitle="@Loc["EmailEditor_Panel_Blocks"]"
                   RightTitle="@Loc["EmailEditor_Panel_Properties"]"
                   CanvasTitle="@Loc["EmailEditor_Panel_Canvas"]"
                   Header="HeaderSlot"
                   Toolbar="CommandBar"
                   Left="ToolboxPanel"
                   LeftRail="ToolboxRail"
                   Canvas="CanvasPanel"
                   Right="InspectorPanel"
                   StatusBar="StatusBarPanel"
                   MobileActions="MobileActionItems" />

    @* One polite announcer for the outcome the user cannot see (the badge is a visual pill, not a live
       region any more — a live region that also changes on every dirty keystroke would narrate the whole
       editing session). It speaks only for a CONFIRMED manual/shortcut/programmatic save and never for a
       successful auto-save, for "Saving…" or for the minute tick; Failed/Conflict are announced by the
       alert (role="alert"), so they are not repeated here. *@
    <span class="tm-sr-only" role="status" aria-live="polite" data-tm-save-announcer>@_announcement</span>
</div>

<TmEmailExportDialog Show="_showExport" Document="_document" OnClose="() => _showExport = false" />
<TmEmailImportDialog Show="_showImport" OnImport="ApplyImportAsync" OnClose="() => _showImport = false" />
@* XLarge, because the Tablet scene is 768 px (EmailPreviewMetrics.TabletWidth): in a 680 px dialog the
   scene would be clamped to the desktop width, so the device switch would be a label that changes
   nothing. 900 px leaves room for the paper plus its stage margin at every device. *@
<TmModal Show="_showPreview" Title="@Loc["EmailEditor_Toolbar_Preview"]" Size="ModalSize.XLarge"
         OnClose="() => _showPreview = false">
    <ChildContent>
        <TmEmailTemplatePreview @ref="_preview" Document="_document" />
    </ChildContent>
    <Footer>
        @* "Refresh preview" forces a new render and cancels the one in flight; the editor itself never
           sends anything — FooterActions is the host's slot ("Send test email", …). *@
        <div class="tm-email-editor__preview-footer" data-tm-preview-dialog-footer>
            <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Secondary" Icon="@IconNames.RefreshCcw"
                      data-tm-preview-dialog-refresh="true"
                      OnClick="RefreshPreviewAsync">@Loc["EmailEditor_Preview_Refresh"]</TmButton>
            <div class="tm-email-editor__preview-footer-end">
                <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Secondary" data-tm-preview-dialog-close="true"
                          OnClick="ClosePreview">@Loc["EmailEditor_Preview_Close"]</TmButton>
                @FooterActions
            </div>
        </div>
    </Footer>
</TmModal>
<TmModal Show="_showValidation" Title="@Loc["EmailEditor_Validation_Title"]" Size="ModalSize.Medium"
         OnClose="() => _showValidation = false">
    <TmEmailValidationPanel Document="_document" OnNavigate="OnValidationNavigateAsync" />
</TmModal>
<TmKeyboardShortcutsHelp IsVisible="_showShortcuts" Categories="ShortcutCategories"
                         OnClose="() => _showShortcuts = false" />

@code {
    private const string SaveShortcutModulePath = "./_content/Tempo.Blazor.EmailTemplates/tm-email-save-shortcut.js";

    /// <summary>Gets or sets the edited document. Two-way bindable via <see cref="DocumentChanged"/>.</summary>
    [Parameter] public EmailTemplateDocument? Document { get; set; }

    /// <summary>Raised when the document changes (for <c>@bind-Document</c>).</summary>
    [Parameter] public EventCallback<EmailTemplateDocument> DocumentChanged { get; set; }

    /// <summary>
    /// Optional host save handler. It receives a deep-copy snapshot with the trigger, the editor revision
    /// and the editor's <see cref="CancellationToken"/>, and answers with an
    /// <see cref="EmailSaveResult"/>. The host <b>must</b> answer — a handler that never completes leaves the
    /// editor in <see cref="IsSaving"/> forever; pass <see cref="EmailSaveRequest.CancellationToken"/> to the
    /// host's own I/O and keep its own timeout for it (the token is cancelled when the editor is disposed).
    /// The editor only clears the dirty flag and shows "Saved" after <see cref="EmailSaveResult.Saved"/>; an
    /// exception is reported as a failed save and logged. When <see langword="null"/>, <see cref="SaveAsync"/>
    /// returns a failed result without calling anything.
    /// </summary>
    [Parameter] public Func<EmailSaveRequest, Task<EmailSaveResult>>? OnSave { get; set; }

    /// <summary>
    /// Auto-save configuration; when enabled, a dirty document is saved through <see cref="OnSave"/> with
    /// <see cref="EmailSaveTrigger.AutoSave"/> after the debounce interval. A clean document is never sent,
    /// and a conflict pauses auto-save until the next successful non-auto-save save (manual button,
    /// Ctrl/⌘+S or the host's <see cref="SaveAsync"/>) or a new document reference.
    /// </summary>
    [Parameter] public AutoSaveOptions? AutoSave { get; set; }

    /// <summary>
    /// Raised when <see cref="IsDirty"/> changes — only on a transition, never on initialization and never
    /// for an edit that keeps the document dirty.
    /// </summary>
    [Parameter] public EventCallback<bool> IsDirtyChanged { get; set; }

    /// <summary>
    /// Disables every editing path (toolbox, canvas drag&amp;drop and inline actions, inspector inputs,
    /// import, undo/redo and the shortcuts that mutate the document) while keeping preview, validation and
    /// export available. <see cref="SaveAsync"/> returns a failed result without calling the host. The
    /// component never changes this value itself.
    /// </summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Optional host actions rendered at the start of the command bar (back, title, …).</summary>
    [Parameter] public RenderFragment? ToolbarStart { get; set; }

    /// <summary>Optional host actions rendered at the end of the command bar, before the save chrome.</summary>
    [Parameter] public RenderFragment? ToolbarEnd { get; set; }

    /// <summary>Whether the Save button is rendered. Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool ShowSaveButton { get; set; } = true;

    /// <summary>
    /// Whether the save-status badge is rendered. Defaults to <see langword="true"/>; the badge announces
    /// unsaved changes, the in-flight save, the relative time of the last confirmed save, a failure with
    /// the host's message and a conflict.
    /// </summary>
    [Parameter] public bool ShowSaveStatus { get; set; } = true;

    /// <summary>
    /// Client-side limits (<c>Accept</c>, <c>MaxBytes</c>) applied to a picked image <b>before</b>
    /// <see cref="OnImageUpload"/> is called. <see langword="null"/> uses the defaults (5 MB, images only).
    /// </summary>
    [Parameter] public ImageUploadOptions? ImageUpload { get; set; }

    /// <summary>Clock used for the auto-save debounce and the relative "saved" time (overridable in tests).</summary>
    [Parameter] public TimeProvider TimeProvider { get; set; } = TimeProvider.System;

    /// <summary>Host-provided variables offered by the variable picker (merged with extracted ones).</summary>
    [Parameter] public IReadOnlyList<TemplateVariableInfo> Variables { get; set; } = Array.Empty<TemplateVariableInfo>();

    /// <summary>Optional host image-upload handler: receives a picked file, returns the hosted URL.</summary>
    [Parameter] public Func<IBrowserFile, Task<string>>? OnImageUpload { get; set; }

    /// <summary>
    /// Optional host actions rendered at the end of the preview dialog's footer — for example "Send test
    /// email". The editor never sends anything itself; the host owns that action and its result.
    /// </summary>
    [Parameter] public RenderFragment? FooterActions { get; set; }

    /// <summary>
    /// Whether the blocks palette is collapsed. The editor mirrors the state it is given and reports every
    /// toggle through <see cref="ToolboxCollapsedChanged"/>; F8 maps the same parameter onto
    /// <c>TmEditorShell.CollapsedPanels</c> (D10).
    /// </summary>
    [Parameter] public bool ToolboxCollapsed { get; set; }

    /// <summary>
    /// Raised with the new state when the user collapses or expands the blocks palette. Bind it back into
    /// <see cref="ToolboxCollapsed"/> for a controlled palette; without a binding the palette toggles on its
    /// own (seeded from the parameter).
    /// </summary>
    [Parameter] public EventCallback<bool> ToolboxCollapsedChanged { get; set; }

    /// <summary>
    /// The layout the editor renders. <see cref="TmLayoutMode.Auto"/> (default) lets the core
    /// <c>TmEditorShell</c> measure the EDITOR'S OWN CONTAINER — never the viewport — and follow its
    /// width; a forced value renders that mode without a DOM, which is how a host (and a test) pins a
    /// tablet or phone layout. The editor keeps no copy of the breakpoint logic: this value is
    /// forwarded to the shell unchanged.
    /// </summary>
    [Parameter] public TmLayoutMode LayoutMode { get; set; } = TmLayoutMode.Auto;

    /// <summary>
    /// The layout rendered before the shell's first measurement. Defaults to
    /// <see cref="TmLayoutMode.Desktop"/> (a desktop host never sees a wrong compact frame).
    /// </summary>
    [Parameter] public TmLayoutMode InitialMode { get; set; } = TmLayoutMode.Desktop;

    /// <summary>
    /// Raised when the shell's RESOLVED layout changes (the container crossed a breakpoint, or the host
    /// forced another <see cref="LayoutMode"/>). The initial value is not a change. Never bind this to
    /// <see cref="LayoutMode"/> — that would pin the layout and stop the shell from measuring.
    /// </summary>
    [Parameter] public EventCallback<TmLayoutMode> ResolvedLayoutChanged { get; set; }

    /// <summary>
    /// The two container widths that decide the layout, forwarded to the shell. <see langword="null"/>
    /// (default) uses <c>new TmLayoutBreakpoints(768, 1200)</c> (D7): below 768 the editor is a phone
    /// layout, from 1200 it is the full desktop chrome, in between it is the tablet layout — the pair the
    /// DiagramEditor uses, chosen because the toolbox and the inspector need the wider canvas before the
    /// editor may drop a panel.
    /// </summary>
    [Parameter] public TmLayoutBreakpoints? Breakpoints { get; set; }

    /// <summary>
    /// How the two panels present on a mobile layout. <see cref="Tempo.Blazor.Components.Layout.MobilePanelPresentation.Sheet"/>
    /// (default, EM3) keeps the canvas visible with a bottom sheet — a Bloky | Vlastnosti tab strip inside
    /// it while both panels are open; <see cref="Tempo.Blazor.Components.Layout.MobilePanelPresentation.Tabs"/>
    /// is a full-region Bloky | Plátno | Vlastnosti tablist with no sheet.
    /// </summary>
    [Parameter] public MobilePanelPresentation MobilePanelPresentation { get; set; }

    /// <summary>
    /// The panel the mobile layout shows, two-way with <see cref="ActiveMobilePanelChanged"/>. The editor
    /// switches it to <see cref="EditorShellPanel.Right"/> when the user selects a block (the inspector is
    /// where that selection is edited), and a host may drive it too.
    /// </summary>
    [Parameter] public EditorShellPanel ActiveMobilePanel { get; set; }

    /// <summary>Raised when the user picks another mobile tab, or when the editor follows a selection.</summary>
    [Parameter] public EventCallback<EditorShellPanel> ActiveMobilePanelChanged { get; set; }

    /// <summary>The layout the shell resolved: the forced <see cref="LayoutMode"/>, else the measured mode, else <see cref="InitialMode"/>.</summary>
    private TmLayoutMode EffectiveResolvedLayout
        => LayoutMode != TmLayoutMode.Auto ? LayoutMode : _measuredLayout ?? InitialMode;

    private bool IsMobileLayout => EffectiveResolvedLayout == TmLayoutMode.Mobile;

    /// <summary>
    /// The mobile panels sheet's snaps: the DEFAULT half snap leaves a phone the tabs plus the palette
    /// SEARCH box only (a host with its own page chrome above the editor pushes the first block tile below
    /// the fold — measured at 390 px), so the closed-to-open snap starts at two thirds of the stage, which
    /// shows the first tile row while the canvas stays visible behind it. The second snap is full height.
    /// </summary>
    private static readonly IReadOnlyList<double> MobileSheetSnaps = new[] { 0.65, 1.0 };

    private TmLayoutBreakpoints EffectiveBreakpoints => Breakpoints ?? new TmLayoutBreakpoints(768, 1200);

    private async Task OnResolvedLayoutChangedAsync(TmLayoutMode mode)
    {
        if (_measuredLayout == mode) return;
        _measuredLayout = mode;
        // The mobile-only chrome (the compact header) is a markup branch, not a CSS step: switching it
        // needs a render the shell's own callback does not trigger.
        StateHasChanged();
        await ResolvedLayoutChanged.InvokeAsync(mode);
    }

    /// <summary>The D10 mapping: the host's <see cref="ToolboxCollapsed"/> IS the shell's left-panel rail.</summary>
    private EditorShellPanel ShellCollapsedPanels
        => ToolboxCollapsedEffective ? EditorShellPanel.Left : EditorShellPanel.None;

    /// <summary>
    /// The shell changed the collapse set on its own (a tablet rail, the panel toggle): the host hears it
    /// through <see cref="ToolboxCollapsedChanged"/>, which is the parameter D10 keeps as the public API.
    /// The right panel's rail is deliberately not surfaced — the editor has no parameter for it, and a
    /// state the host cannot bind would only be noise.
    /// </summary>
    /// <summary>
    /// The shell's collapse set changed. The host is always told (D10), but the editor only ADOPTS it when a
    /// USER changed it — a rail the shell imposed on a LAYOUT TRANSITION (the tablet one-expanded-panel rule)
    /// is a layout state, not a collapsed preference, and adopting it would pin the palette railed for ever
    /// (measured: the Mobile→Tablet flip raised <c>Left</c> one step before the editor learned the new
    /// layout, so the stale measurement adopted it and no toggle could ever undo it).
    /// <para>
    /// The decision is therefore deferred to <see cref="OnAfterRenderAsync"/>: by then
    /// <c>ResolvedLayoutChanged</c> has landed, so "the layout changed in this batch" is exact.
    /// </para>
    /// </summary>
    private Task OnShellCollapsedPanelsChangedAsync(EditorShellPanel panels)
    {
        if (panels.HasFlag(EditorShellPanel.Left) == ToolboxCollapsedEffective) return Task.CompletedTask;
        _pendingCollapsedRaise = panels;
        return Task.CompletedTask;
    }

    /// <summary>
    /// Applies the collapse set the shell reported, unless a layout transition produced it. Runs after the
    /// render so the resolved layout is current (the shell raises its layout callback after the collapse
    /// one).
    /// </summary>
    private async Task ApplyPendingCollapseRaiseAsync()
    {
        var layoutNow = EffectiveResolvedLayout;
        var layoutChanged = _layoutAtLastRender != layoutNow;
        _layoutAtLastRender = layoutNow;

        if (_pendingCollapsedRaise is not { } pending) return;
        _pendingCollapsedRaise = null;

        var collapsed = pending.HasFlag(EditorShellPanel.Left);
        if (layoutChanged || collapsed == ToolboxCollapsedEffective) return;

        _toolboxCollapsedInternal = collapsed;
        StateHasChanged();
        await ToolboxCollapsedChanged.InvokeAsync(collapsed);
    }

    /// <summary>The mobile panel shown: the host's parameter while its callback is bound, else the editor's own state.</summary>
    private EditorShellPanel EffectiveActiveMobilePanel
        => ActiveMobilePanelChanged.HasDelegate ? ActiveMobilePanel : _activeMobilePanel ?? ActiveMobilePanel;

    private async Task OnShellActiveMobilePanelChangedAsync(EditorShellPanel panel)
    {
        _activeMobilePanel = panel;
        await ActiveMobilePanelChanged.InvokeAsync(panel);
        StateHasChanged();
    }

    /// <summary>
    /// Shows a panel on a mobile layout (the selection and "add block" flows). A no-op above the mobile
    /// breakpoint: a desktop host's click must not silently change what the phone layout will show.
    /// </summary>
    private async Task ShowMobilePanelAsync(EditorShellPanel panel)
    {
        if (!IsMobileLayout) return;

        // The sheet may be CLOSED (the user dismissed it, or an insert collapsed it): a selection has to
        // bring the panel it needs back, otherwise the tap looks like it did nothing.
        if (panel == EditorShellPanel.Right) _rightOpen = true;
        else if (panel == EditorShellPanel.Left) _leftOpen = true;

        if (EffectiveActiveMobilePanel != panel)
        {
            _activeMobilePanel = panel;
            await ActiveMobilePanelChanged.InvokeAsync(panel);
        }

        StateHasChanged();
    }

    /// <summary>
    /// Collapses the mobile sheet so the just-added block is visible on the canvas (and the focus lands on
    /// it). Above the mobile breakpoint the docked panels are untouched.
    /// </summary>
    private Task CollapseMobileSheetAsync()
    {
        if (!IsMobileLayout) return Task.CompletedTask;
        _mobileOverflowOpen = false;
        _leftOpen = false;
        _rightOpen = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnLeftOpenChangedAsync(bool open)
    {
        _leftOpen = open;
        return Task.CompletedTask;
    }

    private Task OnRightOpenChangedAsync(bool open)
    {
        _rightOpen = open;
        return Task.CompletedTask;
    }

    private Task OnSheetSnapIndexChangedAsync(int index)
    {
        _sheetSnapIndex = index;
        return Task.CompletedTask;
    }

    private Task OnMobileOverflowOpenChanged(bool open)
    {
        _mobileOverflowOpen = open;
        return Task.CompletedTask;
    }

    /// <summary>
    /// Gets whether the document differs from the last state the host confirmed (or the document it handed
    /// over). Owned by the editor — it is not a <c>[Parameter]</c>, so <c>@bind-IsDirty</c> is not used;
    /// observe changes through <see cref="IsDirtyChanged"/>.
    /// </summary>
    public bool IsDirty { get; private set; }

    /// <summary>Gets whether a save request is in flight (at most one at a time).</summary>
    public bool IsSaving { get; private set; }

    private readonly object _saveSync = new();
    private readonly CancellationTokenSource _disposeCts = new();

    private EditorHistoryService _history = new();
    private readonly ClipboardService _clipboard = new();

    private EmailTemplateDocument _document = new();
    private string _baselineJson = string.Empty;
    private long _revision;

    /// <summary>
    /// Bumped whenever the editor throws its state away and adopts a new document from the host. A save that
    /// was in flight against the previous document compares its captured epoch and only answers its caller;
    /// it must not move the baseline, the badge or the auto-save pause of a document it never saw.
    /// </summary>
    private long _documentEpoch;

    private bool _initialized;
    private bool _disposed;

    /// <summary>
    /// The last <see cref="Document"/> reference the HOST handed over. A re-render with that same instance
    /// (including a host that only passes <see cref="Document"/> one way and listens to
    /// <see cref="IsDirtyChanged"/>) is not a decision and must not reset history or baseline.
    /// </summary>
    private EmailTemplateDocument? _hostDocument;

    /// <summary>
    /// The last reference the editor itself put on the wire through <see cref="DocumentChanged"/>. A host
    /// that echoes it back (synchronously or after its own await) is not a new document either — comparing
    /// against the live <see cref="_document"/> would mistake an undo/redo snapshot for a host reload.
    /// </summary>
    private EmailTemplateDocument? _emittedDocument;

    private Guid? _selectedId;
    private bool? _toolboxCollapsedInternal;
    // The shell's OWN state, mirrored only so the parameters keep their two-way contract (the shell
    // raises a callback and a host is free to ignore it).
    private TmLayoutMode? _measuredLayout;
    private EditorShellPanel? _activeMobilePanel;
    private bool _mobileOverflowOpen;
    private bool _leftOpen = true;
    private bool _rightOpen = true;
    // Set by a structural change, consumed in OnAfterRenderAsync: the block the caller wants focused.
    private Guid? _focusBlockAfterRender;
    // The collapse set the shell reported, applied after the render (see ApplyPendingCollapseRaiseAsync).
    private EditorShellPanel? _pendingCollapsedRaise;
    private TmLayoutMode? _layoutAtLastRender;
    private int _sheetSnapIndex;
    private object? _dragPayload;
    private ITimer? _autoSaveTimer;
    private ITimer? _savedAgeTimer;

    private bool _saveInProgress;
    private PendingSave? _followUpJob;
    private EmailSaveStatus? _lastSaveOutcome;
    private string? _saveErrorMessage;
    private string? _conflictMessage;
    private DateTimeOffset? _lastSavedAt;
    private bool _autoSavePaused;
    private string _announcement = string.Empty;
    private TmEmailTemplateCanvas? _canvas;
    private ITmRelativeTimeFormatter? _relativeTime;

    private ElementReference _rootRef;
    private IJSObjectReference? _shortcutModule;

    private bool _showExport;
    private bool _showImport;
    private bool _showPreview;
    private bool _showValidation;
    private bool _showShortcuts;
    private TmEmailTemplatePreview? _preview;

    private IEnumerable<TmShortcutCategory> ShortcutCategories => new[]
    {
        new TmShortcutCategory(Loc["EmailEditor_Shortcut_Category_Edit"], new[]
        {
            new TmKeyboardShortcut("Ctrl/⌘+Z", Loc["EmailEditor_Toolbar_Undo"]),
            new TmKeyboardShortcut("Ctrl/⌘+Y", Loc["EmailEditor_Toolbar_Redo"]),
            new TmKeyboardShortcut("Ctrl/⌘+Shift+Z", Loc["EmailEditor_Toolbar_Redo"]),
            new TmKeyboardShortcut("Ctrl/⌘+C", Loc["EmailEditor_Shortcut_Copy"]),
            new TmKeyboardShortcut("Ctrl/⌘+X", Loc["EmailEditor_Shortcut_Cut"]),
            new TmKeyboardShortcut("Ctrl/⌘+V", Loc["EmailEditor_Shortcut_Paste"]),
            new TmKeyboardShortcut("Ctrl/⌘+D", Loc["EmailEditor_Action_Duplicate"]),
            new TmKeyboardShortcut("Delete", Loc["EmailEditor_Action_Delete"]),
        }),
        new TmShortcutCategory(Loc["EmailEditor_Shortcut_Category_Navigate"], new[]
        {
            // ↑ and ↓ are two separate entries: the core help renders a "+"-joined string as ONE chord,
            // which read "Arrow Up + Arrow Down" as a key combination.
            new TmKeyboardShortcut("↑", Loc["EmailEditor_Shortcut_NavigateUp"]),
            new TmKeyboardShortcut("↓", Loc["EmailEditor_Shortcut_NavigateDown"]),
            new TmKeyboardShortcut("Esc", Loc["EmailEditor_Shortcut_Deselect"]),
        }),
        new TmShortcutCategory(Loc["EmailEditor_Shortcut_Category_File"], new[]
        {
            new TmKeyboardShortcut("Ctrl/⌘+S", Loc["EmailEditor_Toolbar_Save"]),
        }),
    };

    // ── Shell slots (Fáze 8) ─────────────────────────────────────────────────────────────────
    //
    // Hosts and E2E key off data-tm-group / data-tm-save / data-tm-save-badge, never off the position of a
    // button in the DOM: where a group renders (the command row, the mobile "⋮" overflow, the action bar)
    // is a layout detail, so each task keeps ONE fragment that the three surfaces reuse. The fragments
    // are private on purpose — the stable contract is the data-tm-* hook, not the fragment.

    private RenderFragment CommandBar => @<TmToolbar Overflow="ToolbarOverflow.Menu"
                                                     Class="tm-email-editor__toolbar"
                                                     AriaLabel="@Loc["EmailEditor_Toolbar_GroupLabel"]"
                                                     data-tm-email-toolbar>
        <ChildContent>
            @if (ToolbarStart is not null)
            {
                <div class="tm-email-editor__toolbar-group" data-tm-toolbar-start>@ToolbarStart</div>
            }

            <TmToolbarGroup Label="@Loc["EmailEditor_Toolbar_GroupHistory"]" data-tm-group="history">
                @HistoryButtons
            </TmToolbarGroup>

            <TmToolbarGroup Label="@Loc["EmailEditor_Toolbar_GroupReview"]" data-tm-group="review">
                @ReviewButtons
            </TmToolbarGroup>

            <TmToolbarGroup Label="@Loc["EmailEditor_Toolbar_GroupFile"]" data-tm-group="file">
                @FileButtons
            </TmToolbarGroup>

            <TmToolbarGroup Label="@Loc["EmailEditor_Toolbar_GroupHelp"]" data-tm-group="help">
                @HelpButtons
            </TmToolbarGroup>

            @if (ToolbarEnd is not null)
            {
                <div class="tm-email-editor__toolbar-group" data-tm-toolbar-end>@ToolbarEnd</div>
            }
        </ChildContent>

        <Actions>
            @* Save chrome: ONE nowrap group pinned to the end of the row. The badge lives in the shell's
               status bar (Fáze 8) — a pill squeezed between the actions and the primary button told the
               user nothing and a long host message pushed Save onto a second row. *@
            <div class="tm-email-editor__save-chrome" data-tm-save-chrome>
                @SaveButton
            </div>
        </Actions>
    </TmToolbar>;

    /// <summary>
    /// The shell's Header slot. It is ALWAYS supplied (the shell decides nothing about the branch) and the
    /// slot itself renders only on a mobile layout, reading the layout the shell cascades — never measuring
    /// on its own. The empty desktop band collapses through :empty in the stylesheet.
    /// </summary>
    private RenderFragment HeaderSlot => builder =>
    {
        // Built from C#: the slot component is internal (the desktop band must stay empty and the mobile
        // actions must never exist twice in the DOM), and Razor only resolves markup tags to public
        // components.
        builder.OpenComponent<TmEmailMobileHeaderSlot>(0);
        builder.AddComponentParameter(1, nameof(TmEmailMobileHeaderSlot.ResolvedLayoutChanged),
            EventCallback.Factory.Create<TmLayoutMode>(this, OnResolvedLayoutChangedAsync));
        builder.AddComponentParameter(2, nameof(TmEmailMobileHeaderSlot.ChildContent), (RenderFragment)MobileHeader);
        builder.CloseComponent();
    };

    /// <summary>
    /// Mobile header (D20): the primary Save and the host's <see cref="ToolbarStart"/> stay on the bar;
    /// everything else <see cref="ToolbarEnd"/> and the file/review/help groups move into the "⋮"
    /// overflow, so the canvas keeps the height. The shell never renders the Toolbar slot on a mobile
    /// layout — the action bar replaces it.
    /// </summary>
    private RenderFragment MobileHeader => @<div class="tm-email-editor__mobile-header" data-tm-mobile-header>
        @if (ToolbarStart is not null)
        {
