    /// <summary>
    /// Saves the document through <see cref="OnSave"/> — the hook a host wires into
    /// <c>TmNavigationGuard.OnSaveAndLeave</c> (<c>OnSaveAndLeave="@(async () => (await editor.SaveAsync()).IsSaved)"</c>).
    /// A trigger that arrives while another save runs merges into one follow-up save and this call returns
    /// that follow-up's result. Read-only editors and editors without a save handler answer a failed result
    /// without calling the host.
    /// </summary>
    public async Task<EmailSaveResult> SaveAsync()
    {
        // A host calls this from wherever its own flow runs (a navigation guard, a command handler, a
        // background continuation) — i.e. possibly off the renderer's dispatcher. The save mutates component
        // state and renders, so it runs inside InvokeAsync; the caller still gets the host's own answer.
        EmailSaveResult result = EmailSaveResult.Failed(Loc["EmailEditor_SaveStatus_Cancelled"]);
        await InvokeAsync(async () =>
        {
            result = await RequestSaveAsync(EmailSaveTrigger.Programmatic);
        });
        return result;
    }

    /// <summary>Forces a new preview render, cancelling the one that may still be in flight.</summary>
    public Task RefreshPreviewAsync()
        => _preview is null ? Task.CompletedTask : _preview.RefreshAsync();

    private void ClosePreview() => _showPreview = false;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (!_initialized)
        {
            _initialized = true;
            _document = Document ?? new EmailTemplateDocument();
            _hostDocument = Document;
            _history = new EditorHistoryService(TimeProvider);
            _history.Initialize(_document);
            _baselineJson = ContentSignature(_document);
            return;
        }

        if (Document is null) return;

        // Only a reference the HOST has not handed over before can be a decision (it reloaded, resolved a
        // conflict or switched templates). A one-way host re-renders with the same instance after every
        // IsDirtyChanged; treating that as a reload would wipe the undo history mid-edit.
        if (ReferenceEquals(Document, _hostDocument)) return;
        _hostDocument = Document;

        // The editor's own echo: the host stored the instance the editor emitted and passed it straight
        // back. Its undo/redo snapshots are NOT host reloads.
        if (ReferenceEquals(Document, _emittedDocument)) return;
        if (ReferenceEquals(Document, _document)) return;

        ResetToHostDocument(Document);
    }

    /// <summary>
    /// Adopts a new document reference from the host: a fresh baseline, a cleared dirty flag, no pending
    /// conflict and a new undo history. The document epoch moves so a save still in flight cannot report its
    /// outcome onto this document.
    /// </summary>
    private void ResetToHostDocument(EmailTemplateDocument document)
    {
        _document = document;
        _documentEpoch++;
        _selectedId = null;
        _dragPayload = null;
        _history = new EditorHistoryService(TimeProvider);
        _history.Initialize(_document);
        _baselineJson = ContentSignature(_document);
        _revision++;
        _lastSaveOutcome = null;
        _saveErrorMessage = null;
        _conflictMessage = null;
        _lastSavedAt = null;
        _announcement = string.Empty;
        _autoSavePaused = false;
        SetDirty(false);
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await AttachSaveShortcutAsync();

        // A structural change armed the canvas focus; it runs AFTER the render, because the element
        // reference only exists once the new block is in the DOM (a focus call during the handler would
        // find the old tree — the block the user just inserted was not in _blockRefs yet).
        if (_focusBlockAfterRender is { } target)
        {
            _focusBlockAfterRender = null;
            await FocusCanvasAsync(target);
        }

        await ApplyPendingCollapseRaiseAsync();
    }

    // ── Saving ───────────────────────────────────────────────────────────────────────────────

    private Task OnSaveClickedAsync() => RequestSaveAsync(EmailSaveTrigger.Manual);

    /// <summary>The alert's "Try again": the user's explicit retry is a manual save, never an auto-save.</summary>
    private Task OnRetrySaveAsync() => RequestSaveAsync(EmailSaveTrigger.Manual);

    private async Task<EmailSaveResult> RequestSaveAsync(EmailSaveTrigger trigger)
    {
        if (_disposed)
        {
            return await RejectSaveAsync(Loc["EmailEditor_SaveStatus_Cancelled"], trigger);
        }

        if (ReadOnly)
        {
            return await RejectSaveAsync(Loc["EmailEditor_SaveStatus_ReadOnly"], trigger);
        }

        if (OnSave is null)
        {
            return await RejectSaveAsync(Loc["EmailEditor_SaveStatus_NoHost"], trigger);
        }

        PendingSave? job = null;
        Task<EmailSaveResult>? merged = null;
        lock (_saveSync)
        {
            if (_saveInProgress)
            {
                // Single-flight: the trigger joins ONE follow-up save, and this caller is answered by it.
                _followUpJob ??= new PendingSave(trigger);
                _followUpJob.Merge(trigger);
                merged = _followUpJob.Completion;
            }
            else
            {
                _saveInProgress = true;
                job = new PendingSave(trigger);
            }
        }

        if (merged is not null) return await merged;

        _ = PumpAsync(job!);
        return await job!.Completion;
    }

    /// <summary>
    /// The editor refuses a save without touching the host (read-only, no handler, disposed): the answer is
    /// a failed result, and the badge says why. Rendering goes through the dispatcher so a host calling
    /// <see cref="SaveAsync"/> from outside the render loop is safe.
    /// </summary>
    private async Task<EmailSaveResult> RejectSaveAsync(string message, EmailSaveTrigger trigger)
    {
        var result = Record(EmailSaveResult.Failed(message), null, trigger, _documentEpoch);
        await InvokeAsync(StateHasChanged);
        return result;
    }

    /// <summary>
    /// Runs the save queue: one host request at a time, then at most one merged follow-up while the document
    /// is still dirty. A follow-up that finds a clean document is answered with the previous result and no
    /// second write, and a follow-up that can no longer write (paused auto-save after a conflict, a new
    /// read-only pin, a removed handler, a disposed editor) is answered without touching the host.
    /// </summary>
    private async Task PumpAsync(PendingSave job)
    {
        while (true)
        {
            EmailSaveResult result;
            try
            {
                result = await ExecuteSaveAsync(job.Trigger);
            }
            catch (Exception ex)
            {
                LogError(ex, "The email template save pipeline failed unexpectedly.");
                result = Record(EmailSaveResult.Failed(null), null, job.Trigger, _documentEpoch);
            }

            job.Complete(result);

            PendingSave? next;
            bool stillDirty;
            lock (_saveSync)
            {
                next = _followUpJob;
                _followUpJob = null;
                stillDirty = IsDirty;
                if (next is null || !stillDirty)
                {
                    _saveInProgress = false;
                }
            }

            if (next is null) return;
            if (!stillDirty)
            {
                next.Complete(result);
                return;
            }

            // A conflict pauses auto-save: a queue entry that arrived as an auto-save must not turn into the
            // second write the pause exists to prevent (the user's own trigger, merged in, still may).
            if (next.Trigger == EmailSaveTrigger.AutoSave && _autoSavePaused)
            {
                lock (_saveSync) { _saveInProgress = false; }
                next.Complete(result);
                return;
            }

            // The world may have changed while the previous request was in flight: re-check every reason the
            // editor refuses a save before starting the follow-up (the badge explains which one).
            var refusal = RefusalKey();
            if (refusal is not null)
            {
                var refused = Record(EmailSaveResult.Failed(Loc[refusal]), null, next.Trigger, _documentEpoch);
                lock (_saveSync) { _saveInProgress = false; }
                next.Complete(refused);
                return;
            }

            job = next;
        }
    }

    /// <summary>The localization key of the reason a save may not start right now, or <see langword="null"/>.</summary>
    private string? RefusalKey()
        => _disposed ? "EmailEditor_SaveStatus_Cancelled"
        : ReadOnly ? "EmailEditor_SaveStatus_ReadOnly"
        : OnSave is null ? "EmailEditor_SaveStatus_NoHost"
        : null;

    private async Task<EmailSaveResult> ExecuteSaveAsync(EmailSaveTrigger trigger)
    {
        var revision = _revision;
        var epoch = _documentEpoch;
        var snapshot = _document.DeepClone();

        IsSaving = true;
        _saveErrorMessage = null;
        await InvokeAsync(StateHasChanged);

        EmailSaveResult result;
        try
        {
            EmailSaveResult? answered = null;
            try
            {
                answered = await OnSave!(new EmailSaveRequest(snapshot, trigger, revision, _disposeCts.Token));
            }
            catch (OperationCanceledException) when (_disposed)
            {
                answered = EmailSaveResult.Failed(Loc["EmailEditor_SaveStatus_Cancelled"]);
            }
            catch (Exception ex)
            {
                LogError(ex, "The host's email template save handler threw; the save is reported as failed.");
                // No detail: the badge's own label already is "Save failed", and repeating it under the label
                // reads as two different errors. The alert carries the retry affordance instead.
                answered = EmailSaveResult.Failed(null);
            }

            result = answered ?? EmailSaveResult.Failed(Loc["EmailEditor_SaveStatus_NoResult"]);
        }
        finally
        {
            IsSaving = false;
        }

        result = Record(result, snapshot, trigger, epoch);
        await InvokeAsync(StateHasChanged);
        return result;
    }

    /// <summary>
    /// Stores the outcome (dirty baseline, badge state, conflict pause, announcement) and returns it
    /// unchanged. An outcome that belongs to a document the host has since replaced only answers its caller.
    /// </summary>
    private EmailSaveResult Record(EmailSaveResult result, EmailTemplateDocument? snapshot, EmailSaveTrigger trigger, long epoch)
    {
        if (epoch != _documentEpoch) return result;

        _lastSaveOutcome = result.Status;

        switch (result.Status)
        {
            case EmailSaveStatus.Saved when snapshot is not null:
                // The baseline is the SNAPSHOT the host confirmed, not the live document: an edit made
                // while the save was in flight stays dirty after success.
                _baselineJson = ContentSignature(snapshot);
                _lastSavedAt = TimeProvider.GetUtcNow();
                _saveErrorMessage = null;
                _conflictMessage = null;
                if (trigger is not EmailSaveTrigger.AutoSave)
                {
                    // Any explicit save the host confirmed resolves the conflict — including Ctrl/⌘+S: the
                    // user has just proved the template can be written again (D26).
                    _autoSavePaused = false;
                }

                // Announced only for a save the user asked for: a background auto-save must not narrate the
                // editing session, and "Saving…"/the minute tick never touch the live region at all.
                if (trigger is not EmailSaveTrigger.AutoSave)
                {
                    _announcement = Loc["EmailEditor_SaveStatus_Saved"];
                }

                EnsureSavedAgeTimer();
                break;

            case EmailSaveStatus.Conflict:
                _conflictMessage = result.Message;
                _saveErrorMessage = null;
                _autoSavePaused = true;
                // The alert (role="alert") announces this; the announcer stays quiet so it is not repeated.
                _announcement = string.Empty;
                break;

            case EmailSaveStatus.Failed:
                _saveErrorMessage = result.Message;
                _announcement = string.Empty;
                break;
        }

        RecomputeDirty();
        return result;
    }

    // ── Dirty state ─────────────────────────────────────────────────────────────────────────

    /// <summary>
    /// The canonical JSON of the document's content, used to compare against the confirmed baseline.
    /// <paramref name="document"/>'s timestamp is cleared and restored instead of being serialized through a
    /// deep copy: this runs on every edit (and twice per save), and a full clone of the tree per keystroke is
    /// pure overhead. Every caller runs on the renderer's dispatcher, so no other thread observes the
    /// temporarily null timestamp.
    /// </summary>
    private static string ContentSignature(EmailTemplateDocument document)
    {
        var updatedAt = document.UpdatedAt;
        // Timestamps are not content: undoing back to the confirmed state must count as clean.
        document.UpdatedAt = null;
        try
        {
            return EmailTemplateSerializer.Serialize(document);
        }
        finally
        {
            document.UpdatedAt = updatedAt;
        }
    }

    private void RecomputeDirty()
        => SetDirty(!string.Equals(ContentSignature(_document), _baselineJson, StringComparison.Ordinal));

    private void SetDirty(bool dirty)
    {
        if (IsDirty == dirty) return;
        IsDirty = dirty;
        _ = NotifyDirtyChangedAsync(dirty);
    }

    private async Task NotifyDirtyChangedAsync(bool dirty)
    {
        if (!IsDirtyChanged.HasDelegate) return;
        try
        {
            await IsDirtyChanged.InvokeAsync(dirty);
        }
        catch (Exception ex)
        {
            LogError(ex, "The IsDirtyChanged handler threw.");
        }
    }

    // ── Save badge ──────────────────────────────────────────────────────────────────────────

    private enum EditorSaveBadge { None, Dirty, Saving, Saved, Failed, Conflict }

    private EditorSaveBadge SaveBadgeKind =>
        IsSaving ? EditorSaveBadge.Saving
        : _lastSaveOutcome == EmailSaveStatus.Conflict ? EditorSaveBadge.Conflict
        : _lastSaveOutcome == EmailSaveStatus.Failed ? EditorSaveBadge.Failed
        : IsDirty ? EditorSaveBadge.Dirty
        : _lastSavedAt is not null ? EditorSaveBadge.Saved
        : EditorSaveBadge.None;

    private string SaveBadgeStateName => SaveBadgeKind switch
    {
        EditorSaveBadge.Dirty => "dirty",
        EditorSaveBadge.Saving => "saving",
        EditorSaveBadge.Saved => "saved",
        EditorSaveBadge.Failed => "failed",
        EditorSaveBadge.Conflict => "conflict",
        _ => "none",
    };

    private string SaveBadgeIcon => SaveBadgeKind switch
    {
        EditorSaveBadge.Dirty => IconNames.Edit,
        EditorSaveBadge.Saving => IconNames.Refresh,
        EditorSaveBadge.Saved => IconNames.CheckCircle,
        EditorSaveBadge.Failed => IconNames.AlertCircle,
        EditorSaveBadge.Conflict => IconNames.AlertTriangle,
        _ => IconNames.Circle,
    };

    private string SaveBadgeLabel => SaveBadgeKind switch
    {
        EditorSaveBadge.Dirty => Loc["EmailEditor_SaveStatus_Dirty"],
        EditorSaveBadge.Saving => Loc["EmailEditor_SaveStatus_Saving"],
        EditorSaveBadge.Saved => SavedAgoText(),
        EditorSaveBadge.Failed => Loc["EmailEditor_SaveStatus_Failed"],
        EditorSaveBadge.Conflict => Loc["EmailEditor_SaveStatus_Conflict"],
        _ => string.Empty,
    };

    /// <summary>
    /// The host's reason under the badge label — <see langword="null"/> when there is none, and also when it
    /// is just the label repeated (a handler that throws is reported as <see cref="EmailSaveResult.Failed()"/>
    /// without a message precisely so the pill does not read the same sentence twice).
    /// </summary>
    private string? SaveBadgeDetail
    {
        get
        {
            var detail = SaveBadgeKind switch
            {
                EditorSaveBadge.Failed => _saveErrorMessage,
                EditorSaveBadge.Conflict => _conflictMessage,
                _ => null,
            };

            if (string.IsNullOrWhiteSpace(detail)) return null;
            return string.Equals(detail.Trim(), SaveBadgeLabel.Trim(), StringComparison.Ordinal) ? null : detail;
        }
    }

    /// <summary>The badge's tooltip: the label, plus the host's reason when it sent one.</summary>
    private string SaveBadgeTitle => SaveBadgeDetail is { } detail
        ? SaveBadgeLabel + ": " + detail
        : SaveBadgeLabel;

    /// <summary>The badge kind the full-width alert reports, or <see langword="null"/> for a quiet state.</summary>
    private EditorSaveBadge? SaveAlertKind => SaveBadgeKind is EditorSaveBadge.Failed or EditorSaveBadge.Conflict
        ? SaveBadgeKind
        : null;

    /// <summary>The host's own reason in the alert; the localized label stands in when it sent none.</summary>
    private string SaveAlertMessage => SaveBadgeKind switch
    {
        EditorSaveBadge.Conflict => string.IsNullOrWhiteSpace(_conflictMessage) ? Loc["EmailEditor_SaveStatus_Conflict"] : _conflictMessage!,
        EditorSaveBadge.Failed => string.IsNullOrWhiteSpace(_saveErrorMessage) ? Loc["EmailEditor_SaveStatus_Failed"] : _saveErrorMessage!,
        _ => string.Empty,
    };

    /// <summary>What the user can do about it — the alert must not be a diagnosis without a next step.</summary>
    private string SaveAlertHint => SaveBadgeKind == EditorSaveBadge.Conflict
        ? Loc["EmailEditor_SaveStatus_ConflictHint"]
        : Loc["EmailEditor_SaveStatus_FailedHint"];

    /// <summary>
    /// "Saved just now" / "Saved 5 min ago" — the language's own relative phrase comes from the core
    /// <see cref="ITmRelativeTimeFormatter"/> (the host may replace it, and it knows the plural forms),
    /// wrapped in the editor's "Saved {0}" pattern so the verb stays the editor's wording.
    /// </summary>
    private string SavedAgoText()
    {
        if (_lastSavedAt is not { } savedAt) return Loc["EmailEditor_SaveStatus_Saved"];

        var now = TimeProvider.GetUtcNow();
        if (now - savedAt < TimeSpan.FromMinutes(1)) return Loc["EmailEditor_SaveStatus_SavedJustNow"];

        // No core localization registered at all (a host that replaced every string): the badge still says
        // "Saved", just without a relative phrase, instead of formatting a key.
        if (RelativeTimeFormatter is not { } formatter) return Loc["EmailEditor_SaveStatus_Saved"];

        return Loc["EmailEditor_SaveStatus_SavedAgo", formatter.Format(savedAt, now)];
    }

    /// <summary>
    /// The relative-time formatter: the host's registration when it has one (<c>AddTempoBlazor</c> wires a
    /// scoped default that reads the user's time zone), otherwise the core implementation over the core
    /// localizer this editor's chrome already needs and this editor's <see cref="TimeProvider"/>.
    /// </summary>
    private ITmRelativeTimeFormatter? RelativeTimeFormatter
    {
        get
        {
            if (_relativeTime is not null) return _relativeTime;
            if (Services.GetService(typeof(ITmRelativeTimeFormatter)) is ITmRelativeTimeFormatter registered)
            {
                return _relativeTime = registered;
            }

            return Services.GetService(typeof(ITmLocalizer)) is ITmLocalizer core
                ? _relativeTime = new TmRelativeTimeFormatter(core, TimeProvider)
                : null;
        }
    }

    private void EnsureSavedAgeTimer()
    {
        if (_savedAgeTimer is not null || _disposed) return;
        _savedAgeTimer = TimeProvider.CreateTimer(_ => _ = InvokeAsync(OnSavedAgeTickAsync), null,
            TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
    }

    private Task OnSavedAgeTickAsync()
    {
        if (_disposed || !ShowSaveStatus) return Task.CompletedTask;
        StateHasChanged();
        return Task.CompletedTask;
    }

    // ── Auto-save ───────────────────────────────────────────────────────────────────────────

    private void ScheduleAutoSave()
    {
        if (ReadOnly || _disposed) return;
        if (AutoSave is not { Enabled: true }) return;

        _autoSaveTimer?.Dispose();
        _autoSaveTimer = TimeProvider.CreateTimer(_ => _ = InvokeAsync(RunAutoSaveAsync), state: null,
            dueTime: AutoSave.Interval, period: Timeout.InfiniteTimeSpan);
    }

    private async Task RunAutoSaveAsync()
    {
        _autoSaveTimer?.Dispose();
        _autoSaveTimer = null;

        if (_disposed || ReadOnly || _autoSavePaused) return;
        if (!IsDirty) return;
        if (OnSave is null) return;

        await RequestSaveAsync(EmailSaveTrigger.AutoSave);
    }

    // ── Mutations ───────────────────────────────────────────────────────────────────────────

    private async Task AddBlockAsync(BlockDescriptor descriptor)
    {
        if (ReadOnly) return;
        var block = Registry.CreateInstance(descriptor.Type);
        ResolveTargetColumn().Blocks.Add(block);
        _selectedId = block.Id;
        await CommitAsync();
        // Mobile: the sheet is covering the canvas, so the block the user just inserted has to be
        // revealed — column click-to-add inserts AFTER the selected block, which can be anywhere.
        await CollapseMobileSheetAsync();
        _focusBlockAfterRender = block.Id;
    }

    private async Task AddSectionAsync(LayoutPreset preset)
    {
        if (ReadOnly) return;
        var section = LayoutPresets.Create(preset);
        _document.Sections.Add(section);
        _selectedId = section.Id;
        await CommitAsync();
        await CollapseMobileSheetAsync();
        _focusBlockAfterRender = section.Id;
    }

    private async Task HandleDropAsync((Guid ColumnId, int Index) target)
    {
        if (ReadOnly) return;
        switch (_dragPayload)
        {
            case BlockDescriptor descriptor:
                var block = Registry.CreateInstance(descriptor.Type);
                if (_document.AddBlock(target.ColumnId, block, target.Index)) _selectedId = block.Id;
                break;
            case Guid blockId:
                _document.MoveBlock(blockId, target.ColumnId, target.Index);
                _selectedId = blockId;
                break;
            default:
                return;
        }

        _dragPayload = null;
        await CommitAsync();
    }

    private Task OnStructuralChangeAsync() => ReadOnly ? Task.CompletedTask : CommitAsync();

    private async Task ApplyImportAsync(EmailTemplateDocument imported)
    {
        if (ReadOnly) return;
        _document = imported;
        _selectedId = null;
        _showImport = false;
        await CommitAsync();
    }

    private async Task OnSelectionChangedAsync(Guid? id)
    {
        _selectedId = id;
        // A selected block is edited in the inspector, so on a phone layout the sheet follows the
        // selection (EM3) instead of leaving the user on the palette.
        if (id is not null) await ShowMobilePanelAsync(EditorShellPanel.Right);
        StateHasChanged();
    }

    private Task OnValidationNavigateAsync(Guid? id)
    {
        _selectedId = id;
        _showValidation = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnPropertyChangeAsync() => ReadOnly ? Task.CompletedTask : CommitAsync(coalesceKey: "props");

    // ── Undo / redo ─────────────────────────────────────────────────────────────────────────

    private async Task UndoAsync()
    {
        if (ReadOnly) return;
        var state = _history.Undo();
        if (state is null) return;
        _document = state;
        await AfterHistoryAsync();
    }

    private async Task RedoAsync()
    {
        if (ReadOnly) return;
        var state = _history.Redo();
        if (state is null) return;
        _document = state;
        await AfterHistoryAsync();
    }

    private async Task AfterHistoryAsync()
    {
        _revision++;
        RecomputeDirty();
        await EmitDocumentChangedAsync();
        ScheduleAutoSave();
        StateHasChanged();
    }

    // ── Clipboard ───────────────────────────────────────────────────────────────────────────

    private void CopySelected()
    {
        if (_selectedId is Guid id && _document.FindBlock(id) is { } block) _clipboard.Copy(block);
    }

    private async Task CutSelectedAsync()
    {
        if (ReadOnly) return;
        if (_selectedId is not Guid id || _document.FindBlock(id) is not { } block) return;
        _clipboard.Copy(block);
        _document.RemoveBlock(id);
        _selectedId = null;
        await CommitAsync();
    }

    private async Task PasteAsync()
    {
        if (ReadOnly) return;
        var copy = _clipboard.Paste();
        if (copy is null) return;

        if (_selectedId is Guid id && _document.FindParentColumn(id) is { } column)
        {
            var index = IndexOf(column.Blocks, b => b.Id == id);
            column.Blocks.Insert(index + 1, copy);
        }
        else
        {
            ResolveTargetColumn().Blocks.Add(copy);
        }

        _selectedId = copy.Id;
        await CommitAsync();
    }

    // ── Inspector header actions ────────────────────────────────────────────────────────────

    /// <summary>
    /// The collapsed state the palette renders: the host's parameter while a
    /// <see cref="ToolboxCollapsedChanged"/> handler is bound (controlled), otherwise the state the palette
    /// itself reported, seeded from the parameter (uncontrolled).
    /// </summary>
    private bool ToolboxCollapsedEffective
        => ToolboxCollapsedChanged.HasDelegate ? ToolboxCollapsed : (_toolboxCollapsedInternal ?? ToolboxCollapsed);

    /// <summary>Duplicates the selected block as ONE history step (the inspector's header action).</summary>
    private async Task DuplicateSelectedAsync(Guid blockId)
    {
        if (ReadOnly) return;
        if (_document.DuplicateBlock(blockId) is not { } copy) return;
        _selectedId = copy.Id;
        await CommitAsync();
    }

    /// <summary>
    /// Deletes the selected block as ONE history step (the inspector's danger action). The deleted block took
    /// the focused Delete button with it, so focus is handed back into the canvas (a neighbouring block when
    /// one is left, the canvas root otherwise) and the polite live region names the outcome with the undo
    /// chord — a silent disappearance is indistinguishable from a crash.
    /// </summary>
    private async Task DeleteSelectedAsync(Guid blockId)
    {
        if (ReadOnly) return;
        if (_document.FindBlock(blockId) is null) return;
        var neighbour = NeighbourOf(blockId);
        _selectedId = neighbour;
        _document.RemoveBlock(blockId);
        _announcement = Loc["EmailEditor_Announce_BlockDeleted"];
        await CommitAsync();
        await FocusAfterDeleteAsync(neighbour);
    }

    /// <summary>
    /// The block that visually follows the deleted one in its column, else the one before it. Returns null
    /// when the column becomes empty (or the block lived in a non-column container).
    /// </summary>
    private Guid? NeighbourOf(Guid blockId)
    {
        var column = _document.FindParentColumn(blockId);
        if (column is null) return null;

        var index = column.Blocks.ToList().FindIndex(block => block.Id == blockId);
        if (index < 0) return null;
        if (index + 1 < column.Blocks.Count) return column.Blocks[index + 1].Id;
        return index > 0 ? column.Blocks[index - 1].Id : null;
    }

    /// <summary>
    /// Moves focus back into the canvas after a structural delete. Focus runs after the re-render so the
    /// element reference points at a live node; the canvas focuses the neighbouring block or its own root.
    /// </summary>
    private Task FocusAfterDeleteAsync(Guid? neighbour) => FocusCanvasAsync(neighbour);

    /// <summary>
    /// Moves focus into the canvas (the block when it is still rendered, the canvas root otherwise) and
    /// lets the browser scroll it into view. Used after a structural change that removed or added the
    /// focused element — focus must never fall to <c>&lt;body&gt;</c>.
    /// </summary>
    private async Task FocusCanvasAsync(Guid? id)
    {
        if (_canvas is null) return;
        try
        {
            await _canvas.FocusAsync(id);
        }
        catch (JSDisconnectedException)
        {
            // A disconnected circuit has no focus to move.
        }
    }

    private static int IndexOf<T>(IList<T> items, Predicate<T> predicate)
    {
        for (var i = 0; i < items.Count; i++)
            if (predicate(items[i]))
                return i;

        return -1;
    }

    // ── Keyboard ────────────────────────────────────────────────────────────────────────────

    private async Task HandleEditorKeyDownAsync(KeyboardEventArgs e)
    {
        if (!e.CtrlKey && !e.MetaKey) return;

        switch (e.Key)
        {
            case "s" or "S" when !e.AltKey:
                // The browser's own "save page" default is cancelled for exactly this chord by the
                // package's JS module; the save itself runs here, in the component. A read-only editor
                // has nothing to save, so the chord is a silent no-op (no error badge for a keystroke the
                // user did not aim at a broken action) — SaveAsync() still reports Failed to a host.
                if (!ReadOnly) await RequestSaveAsync(EmailSaveTrigger.Shortcut);
                break;
            case "z" or "Z" when e.ShiftKey:
                await RedoAsync();
                break;
            case "z" or "Z":
                await UndoAsync();
                break;
            case "y" or "Y":
                await RedoAsync();
                break;
            case "c" or "C":
                CopySelected();
                break;
            case "x" or "X":
                await CutSelectedAsync();
                break;
            case "v" or "V":
                await PasteAsync();
                break;
        }
    }

    // ── Helpers ─────────────────────────────────────────────────────────────────────────────

    private EmailColumn ResolveTargetColumn()
    {
        if (_selectedId is Guid selected)
        {
            var parentOfBlock = _document.FindParentColumn(selected);
            if (parentOfBlock is not null) return parentOfBlock;

            var selectedColumn = DocumentTree.AllColumns(_document).FirstOrDefault(c => c.Id == selected);
            if (selectedColumn is not null) return selectedColumn;

            var selectedSection = _document.Sections.FirstOrDefault(s => s.Id == selected);
            if (selectedSection is { Columns.Count: > 0 }) return selectedSection.Columns[0];
        }

        var lastSection = _document.Sections.LastOrDefault(s => s.Columns.Count > 0);
        if (lastSection is not null) return lastSection.Columns[0];

        var created = LayoutPresets.Create(LayoutPreset.Single);
        _document.Sections.Add(created);
        return created.Columns[0];
    }

    private Task StartBlockDragAsync(BlockDescriptor descriptor)
    {
        if (ReadOnly) return Task.CompletedTask;
        _dragPayload = descriptor;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task StartExistingBlockDragAsync(Guid blockId)
    {
        if (ReadOnly) return Task.CompletedTask;
        _dragPayload = blockId;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task CommitAsync(string? coalesceKey = null)
    {
        if (ReadOnly) return;

        _revision++;
        _document.UpdatedAt = TimeProvider.GetUtcNow().UtcDateTime;
        _history.Push(_document, coalesceKey);
        RecomputeDirty();
        await EmitDocumentChangedAsync();
        ScheduleAutoSave();
        StateHasChanged();
    }

    /// <summary>
    /// Hands the current document to the host, remembering it as the editor's own emission: a host that
    /// stores the value and passes it back is echoing, not reloading, and must not reset the undo history.
    /// </summary>
    private Task EmitDocumentChangedAsync()
    {
        _emittedDocument = _document;
        return DocumentChanged.InvokeAsync(_document);
    }

    // ── JS interop: cancel the browser's own Ctrl/⌘+S -----------------------------------------

    private async Task AttachSaveShortcutAsync()
    {
        try
        {
            _shortcutModule ??= await JS.InvokeAsync<IJSObjectReference>("import", SaveShortcutModulePath);
            if (_disposed)
            {
                // Disposed while the module import was in flight: the root element is gone, so attaching now
                // would guard an element nothing can ever detach (the per-element WeakMap lives in the JS
                // module, and its listener would outlive the component).
                DetachSaveShortcut();
                return;
            }

            if (_shortcutModule is not null)
            {
                await _shortcutModule.InvokeVoidAsync("attachSaveShortcut", _rootRef);
            }
        }
        catch (JSException)
        {
            // Interop is unavailable (prerendering, tests): the Blazor handler still saves; only the
            // browser's "save page" default is left untouched.
        }
        catch (InvalidOperationException)
        {
            // No JS runtime during prerendering.
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; nothing to guard.
        }
        catch (TaskCanceledException)
        {
            // The render was cancelled (navigation/disposal mid-import).
        }
    }

    private void DetachSaveShortcut()
    {
        var module = _shortcutModule;
        _shortcutModule = null;
        if (module is null) return;
        _ = DetachSaveShortcutCoreAsync(module, _rootRef);
    }

    /// <summary>
    /// Releases the chord guard for exactly this element (the module keys its listeners per element, so two
    /// editors on one page cannot detach each other) and disposes the module handle. Never throws: disposal
    /// runs after the circuit may already be gone.
    /// </summary>
    private static async Task DetachSaveShortcutCoreAsync(IJSObjectReference module, ElementReference element)
    {
        try
        {
            await module.InvokeVoidAsync("detachSaveShortcut", element);
            await module.DisposeAsync();
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
        catch (TaskCanceledException)
        {
        }
    }

    private ILogger? Logger => Services.GetService(typeof(ILogger<TmEmailTemplateEditor>)) as ILogger<TmEmailTemplateEditor>;

    private void LogError(Exception exception, string message)
        => Logger?.LogError(exception, "{Message}", message);

    /// <inheritdoc />
    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;

        _autoSaveTimer?.Dispose();
        _autoSaveTimer = null;
        _savedAgeTimer?.Dispose();
        _savedAgeTimer = null;

        // The token lives as long as the host's in-flight work needs it, so the source is cancelled but
        // not disposed: a disposed token throws on registration.
        if (!_disposeCts.IsCancellationRequested)
        {
            try { _disposeCts.Cancel(); }
            catch (ObjectDisposedException) { }
        }

        DetachSaveShortcut();
    }

    /// <summary>One queued save request and the caller waiting for its result.</summary>
    private sealed class PendingSave
    {
        // Asynchronous continuations: the queue completes this from PumpAsync, and the awaiting caller then
        // renders/awaits on its own context. Without the flag the completion can run the caller's
        // continuation inline on the save pipeline's stack, which re-enters the component mid-save.
        private readonly TaskCompletionSource<EmailSaveResult> _completion =
            new(TaskCreationOptions.RunContinuationsAsynchronously);

        public PendingSave(EmailSaveTrigger trigger) => Trigger = trigger;

        public EmailSaveTrigger Trigger { get; private set; }

        public Task<EmailSaveResult> Completion => _completion.Task;

        public void Complete(EmailSaveResult result) => _completion.TrySetResult(result);

        /// <summary>A host-visible manual/programmatic save outranks an auto-save in the merged request.</summary>
        public void Merge(EmailSaveTrigger trigger)
        {
            if (Rank(trigger) > Rank(Trigger)) Trigger = trigger;
        }

        private static int Rank(EmailSaveTrigger trigger) => trigger switch
        {
            EmailSaveTrigger.Programmatic => 3,
            EmailSaveTrigger.Manual => 2,
            EmailSaveTrigger.Shortcut => 1,
            _ => 0,
        };
    }
}
