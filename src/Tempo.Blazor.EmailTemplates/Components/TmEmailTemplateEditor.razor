@namespace Tempo.Blazor.EmailTemplates.Components
@implements IDisposable
@inject IBlockRegistry Registry
@inject IServiceProvider Services
@inject IJSRuntime JS

@* Fáze 8: the editor owns NO layout of its own. The three regions are the CORE TmEditorShell's slots
   (F6): Header / Toolbar / Left (+ LeftRail) / Canvas / Right / StatusBar / MobileActions. The shell
   resolves the layout from its own CONTAINER (Breakpoints 768/1200) and renders docked panels on
   desktop AND tablet (at most one expanded — F6-TABLET-DOCKED-PANELS), a bottom sheet (default) or a
   Left | Canvas | Right tablist on mobile (EM3). Everything the editor does here is forwarding
   (D7/D10/D20) plus the two host fragments the shell cannot know about. *@
<div class="tm-email-editor" data-tm-email-editor tabindex="0" @ref="_rootRef"
     data-tm-readonly="@(ReadOnly ? "true" : "false")"
     data-tm-dirty="@(IsDirty ? "true" : "false")"
     data-tm-saving="@(IsSaving ? "true" : "false")"
     @onkeydown="HandleEditorKeyDownAsync">
    @* D20 names exactly FOUR bar actions (undo / redo / preview / validate), so the shell's default
       three-slot budget would push "Validate" into the bar's own More menu — hence MobileActionsMaxVisible="4".
       This comment sits OUTSIDE the element on purpose: a Razor comment between two attributes is not
       stripped by the compiler, it is splatted as an unmatched attribute (AdditionalAttributes) and the
       browser then dies on setAttribute with an invalid name. bUnit accepts it silently, only a real
       browser throws. *@
    <TmEditorShell Class="tm-email-editor__shell"
                   LayoutMode="LayoutMode"
                   InitialMode="InitialMode"
                   Breakpoints="EffectiveBreakpoints"
                   ResolvedLayoutChanged="OnResolvedLayoutChangedAsync"
                   MobilePanelPresentation="MobilePanelPresentation"
                   ActiveMobilePanel="EffectiveActiveMobilePanel"
                   ActiveMobilePanelChanged="OnShellActiveMobilePanelChangedAsync"
                   CollapsedPanels="ShellCollapsedPanels"
                   CollapsedPanelsChanged="OnShellCollapsedPanelsChangedAsync"
                   LeftOpen="_leftOpen"
                   LeftOpenChanged="OnLeftOpenChangedAsync"
                   RightOpen="_rightOpen"
                   RightOpenChanged="OnRightOpenChangedAsync"
                   MobileSheetSnapPoints="MobileSheetSnaps"
                   MobileSheetSnapIndex="_sheetSnapIndex"
                   MobileSheetSnapIndexChanged="OnSheetSnapIndexChangedAsync"
                   LeftTitle="@Loc["EmailEditor_Panel_Blocks"]"
                   RightTitle="@Loc["EmailEditor_Panel_Properties"]"
                   CanvasTitle="@Loc["EmailEditor_Panel_Canvas"]"
                   Header="HeaderSlot"
                   Toolbar="CommandBar"
                   Left="ToolboxPanel"
                   LeftRail="ToolboxRail"
                   Canvas="CanvasPanel"
                   Right="InspectorPanel"
                   RightRail="InspectorRail"
                   StatusBar="StatusBarPanel"
                   MobileActionsMaxVisible="4"
                   MobileActions="MobileActionItems" />

    @* One polite announcer for the outcome the user cannot see (the badge is a visual pill, not a live
       region any more — a live region that also changes on every dirty keystroke would narrate the whole
       editing session). It speaks only for a CONFIRMED manual/shortcut/programmatic save and never for a
       successful auto-save, for "Saving…" or for the minute tick; Failed/Conflict are announced by the
       alert (role="alert"), so they are not repeated here. *@
    <span class="tm-sr-only" role="status" aria-live="polite" data-tm-save-announcer>@_announcement</span>
</div>

@* Fáze 10: both dialogs take the layout the editor already resolved, so a phone gets the core sheet with
   the sticky footer from F2 (the editor passes its own resolved mode instead of adding yet another viewport
   measurement), and the import applies the host's ImportOptions limits. *@
<TmEmailExportDialog Show="_showExport" Document="_document" LayoutMode="EffectiveResolvedLayout"
                     OnClose="() => _showExport = false" />
<TmEmailImportDialog Show="_showImport" LayoutMode="EffectiveResolvedLayout" ImportOptions="ImportOptions"
                     OnImport="ApplyImportAsync" OnClose="() => _showImport = false" />
@* XLarge, because the Tablet scene is 768 px (EmailPreviewMetrics.TabletWidth): in a 680 px dialog the
   scene would be clamped to the desktop width, so the device switch would be a label that changes
   nothing. 900 px leaves room for the paper plus its stage margin at every device. *@
<TmModal Show="_showPreview" Title="@Loc["EmailEditor_Toolbar_Preview"]" Size="ModalSize.XLarge"
         LayoutMode="EffectiveResolvedLayout" OnClose="() => _showPreview = false">
    <ChildContent>
        <TmEmailTemplatePreview @ref="_preview" Document="_document" />
    </ChildContent>
    <Footer>
        @* "Refresh preview" forces a new render and cancels the one in flight; the editor itself never
           sends anything — FooterActions is the host's slot ("Send test email", …). *@
        <div class="tm-email-editor__preview-footer" data-tm-preview-dialog-footer>
            <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Secondary" Icon="@IconNames.RefreshCcw"
                      data-tm-preview-dialog-refresh="true"
                      OnClick="RefreshPreviewAsync">@Loc["EmailEditor_Preview_Refresh"]</TmButton>
            <div class="tm-email-editor__preview-footer-end">
                <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Secondary" data-tm-preview-dialog-close="true"
                          OnClick="ClosePreview">@Loc["EmailEditor_Preview_Close"]</TmButton>
                @FooterActions
            </div>
        </div>
    </Footer>
</TmModal>
<TmModal Show="_showValidation" Title="@Loc["EmailEditor_Validation_Title"]"
         Subtitle="@Loc["EmailEditor_Validation_Subtitle"]" Size="ModalSize.Medium"
         LayoutMode="EffectiveResolvedLayout" OnClose="() => _showValidation = false"
         data-tm-validation-dialog="true">
    <ChildContent>
        <TmEmailValidationPanel Document="_document" ImportOptions="ImportOptions"
                                OnNavigate="OnValidationNavigateAsync" />
    </ChildContent>
    <Footer>
        @* The dialog needs its own dismiss in the footer: on a phone the sheet's footer is the sticky action
           row, and the header close button scrolls away with the body. A direct .tm-btn child on purpose. *@
        <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" data-tm-validation-close="true"
                  OnClick="() => _showValidation = false">@Loc["EmailEditor_Validation_Close"]</TmButton>
    </Footer>
</TmModal>
<TmKeyboardShortcutsHelp IsVisible="_showShortcuts" Categories="ShortcutCategories"
                         Description="@Loc["EmailEditor_Shortcuts_Description"]"
                         OnClose="() => _showShortcuts = false" />


@code {
    private IEnumerable<TmShortcutCategory> ShortcutCategories => new[]
    {
        new TmShortcutCategory(Loc["EmailEditor_Shortcut_Category_Edit"], new[]
        {
            new TmKeyboardShortcut("Ctrl/⌘+Z", Loc["EmailEditor_Toolbar_Undo"]),
            new TmKeyboardShortcut("Ctrl/⌘+Y", Loc["EmailEditor_Toolbar_Redo"]),
            new TmKeyboardShortcut("Ctrl/⌘+Shift+Z", Loc["EmailEditor_Toolbar_Redo"]),
            new TmKeyboardShortcut("Ctrl/⌘+C", Loc["EmailEditor_Shortcut_Copy"]),
            new TmKeyboardShortcut("Ctrl/⌘+X", Loc["EmailEditor_Shortcut_Cut"]),
            new TmKeyboardShortcut("Ctrl/⌘+V", Loc["EmailEditor_Shortcut_Paste"]),
            new TmKeyboardShortcut("Ctrl/⌘+D", Loc["EmailEditor_Action_Duplicate"]),
            new TmKeyboardShortcut("Delete", Loc["EmailEditor_Action_Delete"]),
        }),
        new TmShortcutCategory(Loc["EmailEditor_Shortcut_Category_Navigate"], new[]
        {
            // ↑ and ↓ are two separate entries: the core help renders a "+"-joined string as ONE chord,
            // which read "Arrow Up + Arrow Down" as a key combination.
            new TmKeyboardShortcut("↑", Loc["EmailEditor_Shortcut_NavigateUp"]),
            new TmKeyboardShortcut("↓", Loc["EmailEditor_Shortcut_NavigateDown"]),
            new TmKeyboardShortcut("Esc", Loc["EmailEditor_Shortcut_Deselect"]),
        }),
        new TmShortcutCategory(Loc["EmailEditor_Shortcut_Category_File"], new[]
        {
            new TmKeyboardShortcut("Ctrl/⌘+S", Loc["EmailEditor_Toolbar_Save"]),
        }),
    };

    // ── Shell slots (Fáze 8) ─────────────────────────────────────────────────────────────────
    //
    // Hosts and E2E key off data-tm-group / data-tm-save / data-tm-save-badge, never off the position of a
    // button in the DOM: where a group renders (the command row, the mobile "⋮" overflow, the action bar)
    // is a layout detail, so each task keeps ONE fragment that the three surfaces reuse. The fragments
    // are private on purpose — the stable contract is the data-tm-* hook, not the fragment.

    private RenderFragment CommandBar => @<TmToolbar Overflow="ToolbarOverflow.Menu"
                                                     Class="tm-email-editor__toolbar"
                                                     AriaLabel="@Loc["EmailEditor_Toolbar_GroupLabel"]"
                                                     data-tm-email-toolbar>
        <ChildContent>
            @if (ToolbarStart is not null)
            {
                <div class="tm-email-editor__toolbar-group" data-tm-toolbar-start>@ToolbarStart</div>
            }

            <TmToolbarGroup Label="@Loc["EmailEditor_Toolbar_GroupHistory"]" data-tm-group="history">
                @HistoryButtons
            </TmToolbarGroup>

            <TmToolbarGroup Label="@Loc["EmailEditor_Toolbar_GroupReview"]" data-tm-group="review">
                @ReviewButtons
            </TmToolbarGroup>

            <TmToolbarGroup Label="@Loc["EmailEditor_Toolbar_GroupFile"]" data-tm-group="file">
                @FileButtons
            </TmToolbarGroup>

            <TmToolbarGroup Label="@Loc["EmailEditor_Toolbar_GroupHelp"]" data-tm-group="help">
                @HelpButtons
            </TmToolbarGroup>

            @if (ToolbarEnd is not null)
            {
                <div class="tm-email-editor__toolbar-group" data-tm-toolbar-end>@ToolbarEnd</div>
            }
        </ChildContent>

        <Actions>
            @* Save chrome: ONE nowrap group pinned to the end of the row. The badge lives in the shell's
               status bar (Fáze 8) — a pill squeezed between the actions and the primary button told the
               user nothing and a long host message pushed Save onto a second row. *@
            <div class="tm-email-editor__save-chrome" data-tm-save-chrome>
                @SaveButton
            </div>
        </Actions>
    </TmToolbar>;

    /// <summary>
    /// The shell's Header slot. It is ALWAYS supplied (the shell decides nothing about the branch) and the
    /// slot itself renders only on a mobile layout, reading the layout the shell cascades — never measuring
    /// on its own. The empty desktop band collapses through :empty in the stylesheet.
    /// </summary>
    private RenderFragment HeaderSlot => builder =>
    {
        // Built from C#: the slot component is internal (the desktop band must stay empty and the mobile
        // actions must never exist twice in the DOM), and Razor only resolves markup tags to public
        // components.
        builder.OpenComponent<TmEmailMobileHeaderSlot>(0);
        builder.AddComponentParameter(1, nameof(TmEmailMobileHeaderSlot.ResolvedLayoutChanged),
            EventCallback.Factory.Create<TmLayoutMode>(this, OnResolvedLayoutChangedAsync));
        builder.AddComponentParameter(2, nameof(TmEmailMobileHeaderSlot.ChildContent), (RenderFragment)MobileHeader);
        builder.CloseComponent();
    };

    /// <summary>
    /// Mobile header (D20): the primary Save and the host's <see cref="ToolbarStart"/> stay on the bar;
    /// everything else <see cref="ToolbarEnd"/> and the file/review/help groups move into the "⋮"
    /// overflow, so the canvas keeps the height. The shell never renders the Toolbar slot on a mobile
    /// layout — the action bar replaces it.
    /// </summary>
    private RenderFragment MobileHeader => @<div class="tm-email-editor__mobile-header" data-tm-mobile-header>
        @if (ToolbarStart is not null)
        {
            <div class="tm-email-editor__toolbar-group tm-email-editor__mobile-title" data-tm-toolbar-start>@ToolbarStart</div>
        }
        else if (DocumentTitle is { } title)
        {
            @* Without a host title the header names the DOCUMENT: two icon-sized controls and no idea
               which template is open is not a header. One ellipsised line. *@
            <span class="tm-email-editor__mobile-doc-title" data-tm-mobile-title title="@title">@title</span>
        }

        <div class="tm-email-editor__mobile-header-end">
            @* Read-only shows NO save affordance at all (the status bar carries the read-only badge —
               rendering it twice would name the mode twice on one screen). *@
            @SaveButton
            @MobileOverflow
        </div>
    </div>;

    /// <summary>
    /// The "⋮" overflow of the mobile header. A <see cref="TmPopover"/> (core F3), so its body presents as
    /// a content-height bottom sheet on a narrow viewport (MobilePresentation=Auto) and stays an anchored
    /// popover if the host widened the editor again. The body is free content, not a <c>role="menu"</c>:
    /// it carries the host's own <see cref="ToolbarEnd"/> fragment, which a menu of TmActionItems cannot.
    /// </summary>
    private RenderFragment MobileOverflow => @<TmPopover Class="tm-email-editor__mobile-overflow"
                                                          Position="PopoverPosition.Bottom"
                                                          Title="@Loc["EmailEditor_Mobile_MoreActions"]"
                                                          IsOpen="_mobileOverflowOpen"
                                                          IsOpenChanged="OnMobileOverflowOpenChanged"
                                                          data-tm-mobile-overflow>
        <TriggerContent>
            <span class="tm-email-editor__mobile-overflow-trigger">
                <TmIcon Name="@IconNames.MoreVertical" Size="IconSize.Sm" />
                @* An icon-only trigger is announced as "button" without this: the popover's Title is the
                   popup's name, not the trigger's. *@
                <span class="tm-sr-only">@Loc["EmailEditor_Mobile_MoreActions"]</span>
            </span>
        </TriggerContent>
        <ChildContent>
            <div class="tm-email-editor__mobile-overflow-panel" data-tm-mobile-overflow-panel>
                @* No Preview here: it is one of the four ACTION BAR commands (D20), so offering it twice
                   on the same phone screen is a second path to the same modal. What is left is the long
                   tail — file, validation, help — each group separated by a token border. *@
                <div class="tm-email-editor__toolbar-group" data-tm-group="file">@FileButtons</div>
                <div class="tm-email-editor__toolbar-group" data-tm-group="review">@ValidateButton</div>
                <div class="tm-email-editor__toolbar-group" data-tm-group="help">@HelpButtons</div>
                @if (ToolbarEnd is not null)
                {
                    @* The host's own fragment cannot be re-wired from here, so the close rides the bubble:
                       a host command dismisses the overflow the same way the built-in ones do. *@
                    <div class="tm-email-editor__toolbar-group" data-tm-toolbar-end
                         @onclick="CloseMobileOverflowAsync">@ToolbarEnd</div>
                }
            </div>
        </ChildContent>
    </TmPopover>;

    private RenderFragment HistoryButtons => @<text>
        <TmToolbarButton Icon="rotate-ccw" Text="@Loc["EmailEditor_Toolbar_Undo"]"
                         Tooltip="@Loc["EmailEditor_Toolbar_Undo"]"
                         Priority="ToolbarButtonPriority.Primary"
                         Disabled="@(!_history.CanUndo || ReadOnly)"
                         OnClick="UndoAsync" data-tm-undo="true"
                         aria-keyshortcuts="Control+Z Meta+Z" />
        <TmToolbarButton Icon="rotate-cw" Text="@Loc["EmailEditor_Toolbar_Redo"]"
                         Tooltip="@Loc["EmailEditor_Toolbar_Redo"]"
                         Priority="ToolbarButtonPriority.Primary"
                         Disabled="@(!_history.CanRedo || ReadOnly)"
                         OnClick="RedoAsync" data-tm-redo="true"
                         aria-keyshortcuts="Control+Y Control+Shift+Z Meta+Shift+Z" />
    </text>;

    private RenderFragment ReviewButtons => @<text>@PreviewButton@ValidateButton</text>;

    private RenderFragment PreviewButton => @<TmToolbarButton Icon="eye" Text="@Loc["EmailEditor_Toolbar_Preview"]"
                                                              Tooltip="@Loc["EmailEditor_Toolbar_Preview"]"
                                                              Priority="ToolbarButtonPriority.Primary"
                                                              OnClick="() => _showPreview = true" data-tm-preview-btn="true" />;

    private RenderFragment ValidateButton => @<TmToolbarButton Icon="check-circle" Text="@Loc["EmailEditor_Toolbar_Validate"]"
                                                               Tooltip="@Loc["EmailEditor_Toolbar_Validate"]"
                                                               Priority="ToolbarButtonPriority.Primary"
                                                               OnClick="OpenValidationAsync" data-tm-validate-btn="true" />;

    private RenderFragment FileButtons => @<text>
        <TmToolbarButton Icon="upload" Text="@Loc["EmailEditor_Toolbar_Import"]"
                         Tooltip="@Loc["EmailEditor_Toolbar_Import"]"
                         Priority="ToolbarButtonPriority.Secondary"
                         Disabled="@ReadOnly"
                         OnClick="OpenImportAsync" data-tm-import-btn="true" />
        @* EM5 (2.10.0): the visible label is "Export" (the action exports MJML/JSON), the
           data-tm-mjml-btn hook stays because hosts and E2E select the action by it. *@
        <TmToolbarButton Icon="download" Text="@Loc["EmailEditor_Toolbar_Export"]"
                         Tooltip="@Loc["EmailEditor_Toolbar_Export"]"
                         Priority="ToolbarButtonPriority.Secondary"
                         OnClick="OpenExportAsync" data-tm-mjml-btn="true" />
    </text>;

    private RenderFragment HelpButtons => @<text>
        <TmToolbarButton Icon="help-circle" Text="@Loc["EmailEditor_Toolbar_Help"]"
                         Tooltip="@Loc["EmailEditor_Toolbar_Help"]"
                         Priority="ToolbarButtonPriority.Secondary"
                         OnClick="OpenShortcutsAsync" data-tm-help-btn="true" />
    </text>;

    private RenderFragment ReadOnlyBadge => @<div class="tm-email-editor__readonly" data-tm-readonly-badge
                                                title="@Loc["EmailEditor_ReadOnly_Badge"]">
        <TmIcon Name="@IconNames.Lock" Size="IconSize.Xs" />
        <span class="tm-email-editor__readonly-label">@Loc["EmailEditor_ReadOnly_Badge"]</span>
        @if (IsDirty)
        {
            @* Unsaved changes stay visible, but only as a secondary fact — a read-only editor offers no
               save affordance to act on them. *@
            <span class="tm-email-editor__readonly-dirty" data-tm-readonly-dirty>@Loc["EmailEditor_SaveStatus_Dirty"]</span>
        }
    </div>;

    private RenderFragment SaveBadge => @<text>
        @if (ShowSaveStatus && SaveBadgeKind is not EditorSaveBadge.None)
        {
            <div class="tm-email-editor__save-status tm-email-editor__save-status--@(SaveBadgeStateName)"
                 data-tm-save-badge data-tm-save-state="@SaveBadgeStateName"
                 title="@SaveBadgeTitle">
                <TmIcon Name="@SaveBadgeIcon" Size="IconSize.Xs" />
                <span class="tm-email-editor__save-label">@SaveBadgeLabel</span>
                @if (SaveBadgeDetail is { } detail)
                {
                    <span class="tm-email-editor__save-message" data-tm-save-message>@detail</span>
                }
            </div>
        }
    </text>;

    private RenderFragment SaveButton => @<text>
        @if (ShowSaveButton && !ReadOnly)
        {
            @* NOT natively disabled while a save is in flight: a disabled button drops focus (a keyboard user
               who pressed Enter on Save lands on <body>), and the single-flight queue already makes a second
               click harmless. aria-disabled keeps the state in the accessibility tree. A read-only editor
               renders no Save button at all — see ReadOnlyBadge. *@
            <TmButton Variant="ButtonVariant.Primary" Size="ButtonSize.Sm" Icon="save"
                      title="@Loc["EmailEditor_Toolbar_SaveTitle"]"
                      aria-keyshortcuts="Control+S Meta+S"
                      aria-disabled="@(IsSaving ? "true" : null)"
                      OnClick="OnSaveClickedAsync" data-tm-save="true">@Loc["EmailEditor_Toolbar_Save"]</TmButton>
        }
    </text>;

    /// <summary>
    /// The shell's status bar: the Failed/Conflict alert (the host's whole reason plus a retry, readable
    /// without hovering a truncated pill — carry-forward from Fáze 7) above the save-status badge or the
    /// read-only badge.
    /// </summary>
    private RenderFragment StatusBarPanel => @<div class="tm-email-editor__status" data-tm-status>
        @if (SaveAlertKind is { } alertKind)
        {
            <TmAlert Severity="@(alertKind == EditorSaveBadge.Conflict ? AlertSeverity.Warning : AlertSeverity.Error)"
                     Class="tm-email-editor__save-alert" data-tm-save-alert="@SaveBadgeStateName">
                <p class="tm-email-editor__save-alert-message">@SaveAlertMessage</p>
                <p class="tm-email-editor__save-alert-hint">@SaveAlertHint</p>
                @if (!ReadOnly && ShowSaveButton)
                {
                    <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" Icon="rotate-cw"
                              OnClick="OnRetrySaveAsync" data-tm-save-retry="true">@Loc["EmailEditor_SaveStatus_Retry"]</TmButton>
                }
            </TmAlert>
        }
        <div class="tm-email-editor__status-row">
            @if (ReadOnly)
            {
                @ReadOnlyBadge
            }
            else
            {
                @SaveBadge
            }
        </div>
    </div>;

    // No panel header above the palette: the palette itself pairs its title with the search field, so a
    // second heading for the same surface would only cost height (and it clipped in the rail).
    private RenderFragment ToolboxPanel => @<section class="tm-email-editor__panel tm-email-editor__panel--toolbox"
                                                   data-tm-toolbox aria-label="@Loc["EmailEditor_Panel_Blocks"]">
        <div class="tm-email-editor__panel-body">
            <TmEmailTemplateToolbox OnAddBlock="AddBlockAsync" OnAddSection="AddSectionAsync"
                                    OnDragBlockStart="StartBlockDragAsync" ReadOnly="ReadOnly"
                                    ShowCollapseToggle="false" />
        </div>
    </section>;

    /// <summary>
    /// The collapsed palette (the shell's <c>LeftRail</c>): every registered block as an icon button,
    /// finger-sized (<c>--tm-touch-target</c>), with the localized name as its title and accessible name.
    /// A collapsed panel whose rail was empty would be a dead end.
    /// </summary>
    private RenderFragment ToolboxRail => @<div class="tm-email-editor__rail" data-tm-toolbox-rail
                                               aria-label="@Loc["EmailEditor_Panel_Blocks"]">
        @foreach (var descriptor in Registry.GetAll())
        {
            <button type="button"
                    class="tm-email-editor__rail-item"
                    data-tm-rail-block="@descriptor.Id"
                    title="@Loc[descriptor.NameKey]"
                    aria-label="@Loc[descriptor.NameKey]"
                    disabled="@ReadOnly"
                    @onclick="() => AddBlockAsync(descriptor)">
                <TmIcon Name="@descriptor.Icon" Size="IconSize.Md" />
            </button>
        }
    </div>;

    /// <summary>
    /// The collapsed INSPECTOR's rail (the shell's <c>RightRail</c> slot): on a tablet the palette wins the
    /// one expanded panel by default, and without this the properties were reachable only through the
    /// palette's rail — a dead end for the panel the user was editing in. One finger-sized button expands
    /// the inspector (and, because a tablet expands at most one panel, rails the palette).
    /// </summary>
    private RenderFragment InspectorRail => @<div class="tm-email-editor__rail" data-tm-properties-rail
                                                aria-label="@Loc["EmailEditor_Panel_Properties"]">
        <button type="button" class="tm-email-editor__rail-item" data-tm-expand-properties="true"
                title="@Loc["EmailEditor_Panel_Properties"]" aria-label="@Loc["EmailEditor_Panel_Properties"]"
                @onclick="ExpandPropertiesPanelAsync">
            <TmIcon Name="@IconNames.Sliders" Size="IconSize.Md" />
        </button>
    </div>;

    private RenderFragment CanvasPanel => @<section class="tm-email-editor__canvas" data-tm-canvas
                                                  aria-label="@Loc["EmailEditor_Panel_Canvas"]">
        <TmEmailTemplateCanvas @ref="_canvas" Document="_document" SelectedId="_selectedId"
                               SelectedIdChanged="OnSelectionChangedAsync"
                               OnDocumentChanged="OnStructuralChangeAsync"
                               DragActive="!ReadOnly && _dragPayload is not null"
                               OnBlockDragStart="StartExistingBlockDragAsync"
                               OnDropInColumn="HandleDropAsync"
                               CanvasImageLoading="CanvasImageLoading"
                               ReadOnly="ReadOnly" />
    </section>;

    private RenderFragment InspectorPanel => @<section class="tm-email-editor__panel" data-tm-properties
                                                     aria-label="@Loc["EmailEditor_Panel_Properties"]">
        <header class="tm-email-editor__panel-header">@Loc["EmailEditor_Panel_Properties"]</header>
        <div class="tm-email-editor__panel-body">
            <TmEmailPropertyPanel Document="_document" SelectedId="_selectedId"
                                  Variables="Variables" OnImageUpload="OnImageUpload"
                                  ImageUpload="ImageUpload" ReadOnly="ReadOnly"
                                  ItemEditingMode="ItemEditingMode"
                                  OnDuplicate="DuplicateSelectedAsync" OnDelete="DeleteSelectedAsync"
                                  OnChanged="OnPropertyChangeAsync" />
        </div>
    </section>;

    /// <summary>
    /// The shell's mobile action bar (F5): ONLY undo, redo, preview and validate (D20) — Save is the
    /// header's primary action, and everything else is a long-tail command in the "⋮" overflow.
    /// </summary>
    private IReadOnlyList<TmActionItem> MobileActionItems => new[]
    {
        new TmActionItem
        {
            Id = "undo",
            Label = Loc["EmailEditor_Toolbar_Undo"],
            Icon = "rotate-ccw",
            Disabled = !_history.CanUndo || ReadOnly,
            OnClick = EventCallback.Factory.Create(this, UndoAsync),
        },
        new TmActionItem
        {
            Id = "redo",
            Label = Loc["EmailEditor_Toolbar_Redo"],
            Icon = "rotate-cw",
            Disabled = !_history.CanRedo || ReadOnly,
            OnClick = EventCallback.Factory.Create(this, RedoAsync),
        },
        new TmActionItem
        {
            Id = "preview",
            Label = Loc["EmailEditor_Toolbar_Preview"],
            Icon = "eye",
            OnClick = EventCallback.Factory.Create(this, () => { _showPreview = true; return Task.CompletedTask; }),
        },
        new TmActionItem
        {
            Id = "validate",
            Label = Loc["EmailEditor_Toolbar_Validate"],
            Icon = "check-circle",
            OnClick = EventCallback.Factory.Create(this, () => { _showValidation = true; return Task.CompletedTask; }),
        },
    };
}
