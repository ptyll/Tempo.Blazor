<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- NuGet Package Metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>Tempo.Blazor.EmailTemplates</PackageId>
    <Version>2.9.1</Version>
    <Authors>ptyll</Authors>
    <Title>Tempo.Blazor.EmailTemplates</Title>
    <Description>Drag-and-drop email template editor component (TmEmailTemplateEditor) for Tempo.Blazor. Visual MJML editor with full MJML 4 parity, bidirectional MJML import/export, Scriban variable templating and live preview. Built entirely on Tempo.Blazor components.</Description>
    <PackageTags>blazor;email;mjml;templates;editor;component</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ptyll/Tempo.Blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ptyll/Tempo.Blazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The node:test files for the package's ES modules live inside wwwroot (the root package.json is
       "type": "module", so they import the modules directly) and are a test asset, not a published one:
       keeping them as Content shipped __tests__/*.test.mjs to every consumer's static web assets. -->
  <ItemGroup>
    <Content Remove="wwwroot\**\__tests__\**" />
    <None Include="wwwroot\**\__tests__\**" Pack="false" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tempo.Blazor\Tempo.Blazor.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.EmailTemplates.Abstractions\Tempo.Blazor.EmailTemplates.Abstractions.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.FluentValidation\Tempo.Blazor.FluentValidation.csproj" />
  </ItemGroup>

  <!-- ═══ Localization: JSON resources embedded in THIS assembly ═══
       The editor's strings live in Resources/TmEmailResources[.<culture>].json — a flat
       { "Key": "Value" } map read by the CLOSED IStringLocalizer<TmEmailResources>
       (JsonStringLocalizer<T>, registered by AddTempoEmailTemplates) — exactly the scheme the Tempo
       core uses for TmResources*.json. They used to be .resx, which resolves through whatever
       IStringLocalizerFactory the host registered: a host that replaces that factory (PostrionCore's
       AddJsonLocalization calls RemoveAll<IStringLocalizerFactory>()) saw bare keys in the editor, and
       the resource-manager pipeline returns raw keys under published Blazor WebAssembly as well. -->
  <ItemGroup>
    <!-- WithCulture=false stops the SDK inferring a culture from the ".cs."/".fr." in the file name
         (which would route them into satellite assemblies — exactly what breaks under WASM). All four
         embed into the main Tempo.Blazor.EmailTemplates.dll. -->
    <EmbeddedResource Include="Resources/TmEmailResources.json">
      <WithCulture>false</WithCulture>
      <LogicalName>Tempo.Blazor.EmailTemplates.Resources.TmEmailResources.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources/TmEmailResources.cs.json">
      <WithCulture>false</WithCulture>
      <LogicalName>Tempo.Blazor.EmailTemplates.Resources.TmEmailResources.cs.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources/TmEmailResources.sk.json">
      <WithCulture>false</WithCulture>
      <LogicalName>Tempo.Blazor.EmailTemplates.Resources.TmEmailResources.sk.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources/TmEmailResources.fr.json">
      <WithCulture>false</WithCulture>
      <LogicalName>Tempo.Blazor.EmailTemplates.Resources.TmEmailResources.fr.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Tempo.Blazor.EmailTemplates.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
