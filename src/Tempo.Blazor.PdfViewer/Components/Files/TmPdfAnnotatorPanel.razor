@namespace Tempo.Blazor.Components.Files
@inherits Tempo.Blazor.Components.TmComponentBase
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using Tempo.Blazor.Abstractions.Models

<aside class="tm-pdf-annotator-panel" data-testid="@TestId("pdf-annotator-panel")" aria-label="@Loc["TmPdfAnnotator_PanelLabel"]">

    <header class="tm-pdf-annotator-panel__header">
        <span class="tm-pdf-annotator-panel__title">@Loc["TmPdfAnnotator_Annotations"]</span>
        <label class="tm-pdf-annotator-panel__filter">
            <input type="checkbox"
                   checked="@ShowResolved"
                   disabled="@Disabled"
                   data-testid="@TestId("pdf-annotator-show-resolved")"
                   @onchange="ToggleResolvedAsync" />
            @Loc["TmPdfAnnotator_ShowResolved"]
        </label>
    </header>

    @if (Draft is not null && !Disabled)
    {
        <div class="tm-pdf-annotator-panel__new" data-testid="@TestId("pdf-annotator-new")">
            <div class="tm-pdf-annotator-panel__prompt">
                <span class="tm-pdf-annotator-panel__dot" style="background:@DraftColor" aria-hidden="true"></span>
                @DraftPrompt()
            </div>
            @if (!string.IsNullOrWhiteSpace(Draft.Anchor?.HighlightedText))
            {
                <div class="tm-pdf-annotator-panel__quote">@Truncate(Draft.Anchor!.HighlightedText!)</div>
            }
            @if (Draft.Kind == DocumentAnnotationKind.Drawing)
            {
                <div class="tm-pdf-annotator-panel__meta">@(string.Format(Loc["TmPdfAnnotator_DraftStrokes"], Draft.Strokes.Count))</div>
            }
            <textarea class="tm-pdf-annotator-panel__input"
                      placeholder="@Loc["TmPdfAnnotator_NotePlaceholder"]"
                      data-testid="@TestId("pdf-annotator-new-input")"
                      @bind="_newBody"
                      @bind:event="oninput"></textarea>
            <div class="tm-pdf-annotator-panel__actions">
                <button type="button"
                        class="tm-pdf-annotator-panel__btn tm-pdf-annotator-panel__btn--primary"
                        disabled="@(!CanSubmitDraft)"
                        data-testid="@TestId("pdf-annotator-new-submit")"
                        @onclick="CreateAsync">
                    @Loc["TmPdfAnnotator_Add"]
                </button>
                <button type="button"
                        class="tm-pdf-annotator-panel__btn tm-pdf-annotator-panel__btn--ghost"
                        data-testid="@TestId("pdf-annotator-new-cancel")"
                        @onclick="CancelDraftAsync">
                    @Loc["TmPdfAnnotator_Cancel"]
                </button>
            </div>
        </div>
    }

    @if (!VisibleThreads.Any())
    {
        <div class="tm-pdf-annotator-panel__empty" data-testid="@TestId("pdf-annotator-empty")">
            @Loc["TmPdfAnnotator_NoAnnotations"]
        </div>
    }
    else
    {
        <ul class="tm-pdf-annotator-panel__list">
            @foreach (var thread in VisibleThreads)
            {
                <li class="@ThreadItemClass(thread)">
                    <button type="button"
                            class="tm-pdf-annotator-panel__thread-head"
                            data-thread-id="@thread.Id"
                            data-testid="@TestId("pdf-annotator-thread")"
                            aria-expanded="@(IsSelected(thread) ? "true" : "false")"
                            aria-controls="@(IsSelected(thread) ? DetailId(thread) : null)"
                            @onclick="() => SelectAsync(thread.Id)">
                        <span class="tm-pdf-annotator-panel__badge" style="background:@Color(thread)">@ThreadNumber(thread)</span>
                        <span class="tm-pdf-annotator-panel__kind">@KindLabel(thread)</span>
                        <span class="tm-pdf-annotator-panel__preview">@Preview(thread)</span>
                        @if (thread.Status == DocumentCommentThreadStatus.Resolved)
                        {
                            <span class="tm-pdf-annotator-panel__status">@Loc["TmPdfAnnotator_Resolved"]</span>
                        }
                    </button>

                    @if (IsSelected(thread))
                    {
                        <div class="tm-pdf-annotator-panel__detail" id="@DetailId(thread)" data-testid="@TestId("pdf-annotator-detail")">
                            @if (!string.IsNullOrWhiteSpace(thread.Anchor.HighlightedText))
                            {
                                <div class="tm-pdf-annotator-panel__quote">@Truncate(thread.Anchor.HighlightedText!)</div>
                            }

                            @foreach (var comment in thread.Comments)
                            {
                                <div class="tm-pdf-annotator-panel__comment" data-testid="@TestId("pdf-annotator-comment")">
                                    <div class="tm-pdf-annotator-panel__comment-head">
                                        <span class="tm-pdf-annotator-panel__author">@comment.AuthorName</span>
                                        <span class="tm-pdf-annotator-panel__time">@FormatTime(comment.CreatedAt)</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(comment.Body))
                                    {
                                        <div class="tm-pdf-annotator-panel__comment-body">@comment.Body</div>
                                    }
                                    @if (comment.CanDelete && !Disabled)
                                    {
                                        <button type="button"
                                                class="tm-pdf-annotator-panel__link"
                                                data-testid="@TestId("pdf-annotator-delete")"
                                                @onclick="() => DeleteAsync(thread.Id, comment.Id)">
                                            @Loc["TmPdfAnnotator_Delete"]
                                        </button>
                                    }
                                </div>
                            }

                            @if (!Disabled)
                            {
                                <textarea class="tm-pdf-annotator-panel__input"
                                          placeholder="@Loc["TmPdfAnnotator_ReplyPlaceholder"]"
                                          data-testid="@TestId("pdf-annotator-reply-input")"
                                          @bind="_replyBody"
                                          @bind:event="oninput"></textarea>
                                <div class="tm-pdf-annotator-panel__actions">
                                    <button type="button"
                                            class="tm-pdf-annotator-panel__btn tm-pdf-annotator-panel__btn--primary"
                                            disabled="@(string.IsNullOrWhiteSpace(_replyBody))"
                                            data-testid="@TestId("pdf-annotator-reply-submit")"
                                            @onclick="() => ReplyAsync(thread.Id)">
                                        @Loc["TmPdfAnnotator_Reply"]
                                    </button>
                                    @if (thread.Status == DocumentCommentThreadStatus.Open)
                                    {
                                        <button type="button"
                                                class="tm-pdf-annotator-panel__btn tm-pdf-annotator-panel__btn--ghost"
                                                data-testid="@TestId("pdf-annotator-resolve")"
                                                @onclick="() => ResolveAsync(thread.Id)">
                                            @Loc["TmPdfAnnotator_Resolve"]
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="tm-pdf-annotator-panel__btn tm-pdf-annotator-panel__btn--ghost"
                                                data-testid="@TestId("pdf-annotator-reopen")"
                                                @onclick="() => ReopenAsync(thread.Id)">
                                            @Loc["TmPdfAnnotator_Reopen"]
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </li>
            }
        </ul>
    }
</aside>

@code {
    private string? _newBody;
    private string? _replyBody;

    // Per-instance id prefix: two annotators on one page each render this panel,
    // and identical detail ids would break aria-controls/aria-labelledby.
    private string _uid = "tm-pdf-an-" + Guid.NewGuid().ToString("N")[..8];

    /// <summary>Annotation threads to render.</summary>
    [Parameter] public IReadOnlyList<DocumentCommentThread> Threads { get; set; } = [];

    /// <summary>Selected thread id.</summary>
    [Parameter] public string? SelectedThreadId { get; set; }

    /// <summary>Callback invoked when the selected thread id changes.</summary>
    [Parameter] public EventCallback<string?> SelectedThreadIdChanged { get; set; }

    /// <summary>Whether resolved threads are shown.</summary>
    [Parameter] public bool ShowResolved { get; set; }

    /// <summary>Callback invoked when the resolved filter toggles.</summary>
    [Parameter] public EventCallback<bool> ShowResolvedChanged { get; set; }

    /// <summary>Resolves the display color of a thread.</summary>
    [Parameter] public Func<DocumentCommentThread, string>? ColorResolver { get; set; }

    /// <summary>Pending annotation draft awaiting a note, when present.</summary>
    [Parameter] public PdfAnnotatorDraft? Draft { get; set; }

    /// <summary>Color used for the draft indicator. Defaults to <see cref="PdfAnnotationColorHelper.DefaultColor"/>.</summary>
    [Parameter] public string DraftColor { get; set; } = PdfAnnotationColorHelper.DefaultColor;

    /// <summary>Whether panel interaction is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Callback invoked with the note body when creating the draft annotation.</summary>
    [Parameter] public EventCallback<string> OnCreateRequested { get; set; }

    /// <summary>Callback invoked when the draft is dismissed.</summary>
    [Parameter] public EventCallback OnDraftDismissed { get; set; }

    /// <summary>Callback invoked when a reply is requested.</summary>
    [Parameter] public EventCallback<DocumentCommentReplyRequest> OnReplyRequested { get; set; }

    /// <summary>Callback invoked when resolving a thread is requested.</summary>
    [Parameter] public EventCallback<string> OnResolveRequested { get; set; }

    /// <summary>Callback invoked when reopening a thread is requested.</summary>
    [Parameter] public EventCallback<string> OnReopenRequested { get; set; }

    /// <summary>Callback invoked when deleting a comment is requested.</summary>
    [Parameter] public EventCallback<DocumentCommentDeleteRequest> OnDeleteRequested { get; set; }

    private IEnumerable<DocumentCommentThread> VisibleThreads => Threads
        .Where(thread => ShowResolved || thread.Status == DocumentCommentThreadStatus.Open);

    private bool IsSelected(DocumentCommentThread thread)
        => string.Equals(thread.Id, SelectedThreadId, StringComparison.Ordinal);

    /// <summary>
    /// DOM id of the thread's expandable detail region, referenced by the header's
    /// aria-controls. Unique per panel instance (Guid prefix) and per thread
    /// (list index), so two panels on one page never collide.
    /// </summary>
    private string DetailId(DocumentCommentThread thread)
    {
        for (var i = 0; i < Threads.Count; i++)
        {
            if (ReferenceEquals(Threads[i], thread) || string.Equals(Threads[i].Id, thread.Id, StringComparison.Ordinal))
            {
                return $"{_uid}-{i}";
            }
        }

        return $"{_uid}-x";
    }

    // A plain comment needs text; highlights and drawings carry their own visual content.
    private bool CanSubmitDraft
        => Draft is not null
           && (!string.IsNullOrWhiteSpace(_newBody) || Draft.Kind != DocumentAnnotationKind.Comment);

    private async Task CreateAsync()
    {
        if (!CanSubmitDraft)
        {
            return;
        }

        var body = _newBody ?? string.Empty;
        _newBody = null;
        await OnCreateRequested.InvokeAsync(body);
    }

    private Task CancelDraftAsync()
    {
        _newBody = null;
        return OnDraftDismissed.InvokeAsync();
    }

    private async Task ReplyAsync(string threadId)
    {
        if (string.IsNullOrWhiteSpace(_replyBody))
        {
            return;
        }

        var request = new DocumentCommentReplyRequest { ThreadId = threadId, Body = _replyBody };
        _replyBody = null;
        await OnReplyRequested.InvokeAsync(request);
    }

    private Task ResolveAsync(string threadId) => OnResolveRequested.InvokeAsync(threadId);

    private Task ReopenAsync(string threadId) => OnReopenRequested.InvokeAsync(threadId);

    private Task DeleteAsync(string threadId, string commentId)
        => OnDeleteRequested.InvokeAsync(new DocumentCommentDeleteRequest { ThreadId = threadId, CommentId = commentId });

    private async Task SelectAsync(string threadId)
    {
        _replyBody = null;
        var next = string.Equals(threadId, SelectedThreadId, StringComparison.Ordinal) ? null : threadId;
        await SelectedThreadIdChanged.InvokeAsync(next);
    }

    private Task ToggleResolvedAsync(ChangeEventArgs e)
    {
        var value = e.Value is bool b ? b : bool.TryParse(e.Value?.ToString(), out var parsed) && parsed;
        return ShowResolvedChanged.InvokeAsync(value);
    }

    private string Color(DocumentCommentThread thread)
        => ColorResolver?.Invoke(thread)
           ?? PdfAnnotationColorHelper.ResolveColor(thread, null, null, null);

    private string DraftPrompt()
        => Draft?.Kind switch
        {
            DocumentAnnotationKind.Highlight => Loc["TmPdfAnnotator_DraftHighlight"],
            DocumentAnnotationKind.Drawing => Loc["TmPdfAnnotator_DraftDrawing"],
            _ => Loc["TmPdfAnnotator_DraftComment"]
        };

    private string KindLabel(DocumentCommentThread thread)
        => thread.Kind switch
        {
            DocumentAnnotationKind.Highlight => Loc["TmPdfAnnotator_KindHighlight"],
            DocumentAnnotationKind.Stamp => Loc["TmPdfAnnotator_KindStamp"],
            DocumentAnnotationKind.Drawing => Loc["TmPdfAnnotator_KindDrawing"],
            _ => Loc["TmPdfAnnotator_KindComment"]
        };

    private int ThreadNumber(DocumentCommentThread thread)
    {
        for (var i = 0; i < Threads.Count; i++)
        {
            if (ReferenceEquals(Threads[i], thread) || string.Equals(Threads[i].Id, thread.Id, StringComparison.Ordinal))
            {
                return i + 1;
            }
        }

        return 1;
    }

    private string ThreadItemClass(DocumentCommentThread thread)
    {
        var classes = new List<string> { "tm-pdf-annotator-panel__item" };
        if (string.Equals(thread.Id, SelectedThreadId, StringComparison.Ordinal))
        {
            classes.Add("tm-pdf-annotator-panel__item--selected");
        }

        if (thread.Status == DocumentCommentThreadStatus.Resolved)
        {
            classes.Add("tm-pdf-annotator-panel__item--resolved");
        }

        return string.Join(" ", classes);
    }

    private string Preview(DocumentCommentThread thread)
    {
        var first = thread.Comments.FirstOrDefault()?.Body;
        if (string.IsNullOrWhiteSpace(first))
        {
            first = thread.Anchor.HighlightedText ?? thread.StampText ?? string.Empty;
        }

        return Truncate(first ?? string.Empty, 60);
    }

    private static string Truncate(string text, int max = 120)
    {
        text = text.Trim();
        return text.Length <= max ? text : text[..max] + "…";
    }

    private static string FormatTime(DateTimeOffset value)
        => value.ToLocalTime().ToString("g", CultureInfo.CurrentCulture);
}
