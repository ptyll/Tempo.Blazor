@namespace Tempo.Blazor.Components.Files
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Abstractions.Models
@using Tempo.Blazor.Components.Icons

@* Thread panel of TmPdfAnnotator (PdfViewer redesign phase 4): keeps only its own header
   (resolved filter, ✕ close button — OnCloseRequested, surfaced as two-way ShowPanel on the
   annotator) and the draft prompt; the thread cards themselves render through the shared
   TmPdfThreadList (PD4), which composes TmPdfThreadCard / TmPdfCommentItem / TmPdfComposer.
   Comment edits flow through OnEditRequested to the provider. ShowChrome=false drops the
   panel's own title and close button for the mobile bottom-sheet presentation (the shell's
   sheet header owns them there, FZE-8); the resolved filter stays in both presentations and
   the draft composer pins to the sheet bottom with full-width buttons. *@

<aside class="@PanelClass" data-testid="@TestId("pdf-annotator-panel")" aria-label="@Loc["TmPdfAnnotator_PanelLabel"]">

    @if (ShowChrome)
    {
        <header class="tm-pdf-annotator-panel__header">
            <span class="tm-pdf-annotator-panel__title">@Loc["TmPdfAnnotator_Annotations"]</span>
            <label class="tm-pdf-annotator-panel__filter">
                <input type="checkbox"
                       checked="@ShowResolved"
                       disabled="@Disabled"
                       data-testid="@TestId("pdf-annotator-show-resolved")"
                       @onchange="ToggleResolvedAsync" />
                @Loc["TmPdfAnnotator_ShowResolved"]
            </label>
            <button type="button"
                    class="tm-pdf-annotator-panel__close"
                    data-testid="@TestId("pdf-annotator-close")"
                    aria-label="@Loc["TmPdfThread_ClosePanel"]"
                    title="@Loc["TmPdfThread_ClosePanel"]"
                    @onclick="() => OnCloseRequested.InvokeAsync()">
                <TmIcon Name="@IconNames.X" />
            </button>
        </header>
    }
    else
    {
        <div class="tm-pdf-annotator-panel__header tm-pdf-annotator-panel__header--sheet">
            <label class="tm-pdf-annotator-panel__filter">
                <input type="checkbox"
                       checked="@ShowResolved"
                       disabled="@Disabled"
                       data-testid="@TestId("pdf-annotator-show-resolved")"
                       @onchange="ToggleResolvedAsync" />
                @Loc["TmPdfAnnotator_ShowResolved"]
            </label>
        </div>
    }

    @if (Draft is not null && !Disabled)
    {
        <div class="tm-pdf-annotator-panel__new" data-testid="@TestId("pdf-annotator-new")">
            <div class="tm-pdf-annotator-panel__prompt">
                <span class="tm-pdf-annotator-panel__dot" style="background:@DraftColor" aria-hidden="true"></span>
                @DraftPrompt()
            </div>
            @if (!string.IsNullOrWhiteSpace(Draft.Anchor?.HighlightedText))
            {
                <div class="tm-pdf-annotator-panel__quote">@PdfAnnotationTextHelper.Truncate(Draft.Anchor!.HighlightedText!)</div>
            }
            @if (Draft.Kind == DocumentAnnotationKind.Drawing)
            {
                <div class="tm-pdf-annotator-panel__meta">@Loc.Plural("TmPdfAnnotator_DraftStrokes", Draft.Strokes.Count)</div>
            }
            <TmPdfComposer Placeholder="@Loc["TmPdfAnnotator_NotePlaceholder"]"
                           SubmitLabel="@Loc["TmPdfAnnotator_Add"]"
                           AllowEmptySubmit="@(Draft.Kind != DocumentAnnotationKind.Comment)"
                           Sticky="@(!ShowChrome)"
                           InputTestId="@TestId("pdf-annotator-new-input")"
                           SubmitTestId="@TestId("pdf-annotator-new-submit")"
                           SecondaryLabel="@Loc["TmPdfAnnotator_Cancel"]"
                           SecondaryTestId="@TestId("pdf-annotator-new-cancel")"
                           OnSecondary="CancelDraftAsync"
                           OnSubmit="CreateAsync" />
        </div>
    }

    <TmPdfThreadList Threads="@Threads"
                     SelectedThreadId="@SelectedThreadId"
                     SelectedThreadIdChanged="SelectedThreadIdChanged"
                     CurrentUserId="@CurrentUserId"
                     ShowResolved="ShowResolved"
                     Disabled="Disabled"
                     TestIdBase="@TestId("pdf-annotator")"
                     ColorResolver="@ColorResolver"
                     EmptyText="@Loc["TmPdfAnnotator_NoAnnotations"]"
                     ReplyPlaceholder="@Loc["TmPdfAnnotator_ReplyPlaceholder"]"
                     ReplySubmitLabel="@Loc["TmPdfAnnotator_Reply"]"
                     ResolveLabel="@Loc["TmPdfAnnotator_Resolve"]"
                     ReopenLabel="@Loc["TmPdfAnnotator_Reopen"]"
                     OnReplyRequested="OnReplyRequested"
                     OnEditRequested="OnEditRequested"
                     OnResolveRequested="OnResolveRequested"
                     OnReopenRequested="OnReopenRequested"
                     OnDeleteRequested="OnDeleteRequested" />
</aside>

@code {
    /// <summary>Annotation threads to render.</summary>
    [Parameter] public IReadOnlyList<DocumentCommentThread> Threads { get; set; } = [];

    /// <summary>Selected thread id.</summary>
    [Parameter] public string? SelectedThreadId { get; set; }

    /// <summary>Callback invoked when the selected thread id changes.</summary>
    [Parameter] public EventCallback<string?> SelectedThreadIdChanged { get; set; }

    /// <summary>Current user id, used for comment permission checks.</summary>
    [Parameter] public string? CurrentUserId { get; set; }

    /// <summary>Whether resolved threads are shown.</summary>
    [Parameter] public bool ShowResolved { get; set; }

    /// <summary>Callback invoked when the resolved filter toggles.</summary>
    [Parameter] public EventCallback<bool> ShowResolvedChanged { get; set; }

    /// <summary>Resolves the display color of a thread.</summary>
    [Parameter] public Func<DocumentCommentThread, string>? ColorResolver { get; set; }

    /// <summary>
    /// Whether the panel renders its own header (title + ✕ close). Default true — the docked
    /// desktop/tablet presentation. When the panel is hosted inside the annotator's mobile
    /// bottom sheet (FZE-8), the sheet header owns the title and the close button, so the host
    /// passes false and the panel renders only the resolved filter and its body, with the draft
    /// composer pinned to the sheet bottom and its buttons split across one row (phase 8
    /// review 12).
    /// </summary>
    [Parameter] public bool ShowChrome { get; set; } = true;

    /// <summary>Pending annotation draft awaiting a note, when present.</summary>
    [Parameter] public PdfAnnotatorDraft? Draft { get; set; }

    /// <summary>Color used for the draft indicator. Defaults to <see cref="PdfAnnotationColorHelper.DefaultColor"/>.</summary>
    [Parameter] public string DraftColor { get; set; } = PdfAnnotationColorHelper.DefaultColor;

    /// <summary>Whether panel interaction is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Callback invoked with the note body when creating the draft annotation.</summary>
    [Parameter] public EventCallback<string> OnCreateRequested { get; set; }

    /// <summary>Callback invoked when the draft is dismissed.</summary>
    [Parameter] public EventCallback OnDraftDismissed { get; set; }

    /// <summary>Callback invoked when a reply is requested.</summary>
    [Parameter] public EventCallback<DocumentCommentReplyRequest> OnReplyRequested { get; set; }

    /// <summary>Callback invoked when an existing comment body is edited.</summary>
    [Parameter] public EventCallback<DocumentCommentEditRequest> OnEditRequested { get; set; }

    /// <summary>Callback invoked when resolving a thread is requested.</summary>
    [Parameter] public EventCallback<string> OnResolveRequested { get; set; }

    /// <summary>Callback invoked when reopening a thread is requested.</summary>
    [Parameter] public EventCallback<string> OnReopenRequested { get; set; }

    /// <summary>Callback invoked when deleting a comment is requested.</summary>
    [Parameter] public EventCallback<DocumentCommentDeleteRequest> OnDeleteRequested { get; set; }

    /// <summary>Callback invoked when the panel's close button is pressed.</summary>
    [Parameter] public EventCallback OnCloseRequested { get; set; }

    /// <summary>
    /// The panel's class: the base plus the <c>--sheet</c> modifier when the panel renders
    /// inside the mobile bottom sheet (<see cref="ShowChrome"/> false) — the sheet owns the
    /// width there, so the docked 300px column and its left border give way.
    /// </summary>
    private string PanelClass => ShowChrome
        ? "tm-pdf-annotator-panel"
        : "tm-pdf-annotator-panel tm-pdf-annotator-panel--sheet";

    private Task CreateAsync(string body) => OnCreateRequested.InvokeAsync(body);

    private Task CancelDraftAsync() => OnDraftDismissed.InvokeAsync();

    private Task ToggleResolvedAsync(ChangeEventArgs e)
    {
        var value = e.Value is bool b ? b : bool.TryParse(e.Value?.ToString(), out var parsed) && parsed;
        return ShowResolvedChanged.InvokeAsync(value);
    }

    private string DraftPrompt()
        => Draft?.Kind switch
        {
            DocumentAnnotationKind.Highlight => Loc["TmPdfAnnotator_DraftHighlight"],
            DocumentAnnotationKind.Drawing => Loc["TmPdfAnnotator_DraftDrawing"],
            _ => Loc["TmPdfAnnotator_DraftComment"]
        };
}
