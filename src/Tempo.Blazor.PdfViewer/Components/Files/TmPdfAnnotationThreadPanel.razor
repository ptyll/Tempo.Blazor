@namespace Tempo.Blazor.Components.Files
@inherits Tempo.Blazor.Components.TmComponentBase
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using Tempo.Blazor.Abstractions.Models

<aside class="tm-pdf-annotation-panel" data-testid="@TestId("pdf-annotation-panel")" aria-label="@Loc["TmPdfViewer_AnnotationsPanelLabel"]">

    <header class="tm-pdf-annotation-panel__header">
        <span class="tm-pdf-annotation-panel__title">@Loc["TmPdfViewer_Annotations"]</span>
        <label class="tm-pdf-annotation-panel__filter">
            <input type="checkbox"
                   checked="@ShowResolved"
                   disabled="@Disabled"
                   data-testid="@TestId("pdf-annotation-show-resolved")"
                   @onchange="ToggleResolvedAsync" />
            @Loc["TmPdfViewer_ShowResolved"]
        </label>
    </header>

    @if (PendingSelection is not null && !Disabled)
    {
        <div class="tm-pdf-annotation-panel__new" data-testid="@TestId("pdf-annotation-new")">
            <div class="tm-pdf-annotation-panel__prompt">@Loc["TmPdfViewer_SelectionPrompt"]</div>
            @if (!string.IsNullOrWhiteSpace(PendingSelection.Text))
            {
                <div class="tm-pdf-annotation-panel__quote">@Truncate(PendingSelection.Text)</div>
            }
            <textarea class="tm-pdf-annotation-panel__input"
                      placeholder="@Loc["TmPdfViewer_NewCommentPlaceholder"]"
                      data-testid="@TestId("pdf-annotation-new-input")"
                      @bind="_newBody"
                      @bind:event="oninput"></textarea>
            <div class="tm-pdf-annotation-panel__actions">
                <button type="button"
                        class="tm-pdf-annotation-panel__btn tm-pdf-annotation-panel__btn--primary"
                        disabled="@(string.IsNullOrWhiteSpace(_newBody))"
                        data-testid="@TestId("pdf-annotation-new-submit")"
                        @onclick="CreateThreadAsync">
                    @Loc["TmPdfViewer_Comment"]
                </button>
                <button type="button"
                        class="tm-pdf-annotation-panel__btn tm-pdf-annotation-panel__btn--ghost"
                        data-testid="@TestId("pdf-annotation-new-cancel")"
                        @onclick="CancelSelectionAsync">
                    @Loc["TmPdfViewer_Cancel"]
                </button>
            </div>
        </div>
    }

    @if (!VisibleThreads.Any())
    {
        <div class="tm-pdf-annotation-panel__empty" data-testid="@TestId("pdf-annotation-empty")">
            @Loc["TmPdfViewer_NoAnnotations"]
        </div>
    }
    else
    {
        <ul class="tm-pdf-annotation-panel__list">
            @foreach (var thread in VisibleThreads)
            {
                <li class="@ThreadItemClass(thread)">
                    <button type="button"
                            class="tm-pdf-annotation-panel__thread-head"
                            data-thread-id="@thread.Id"
                            data-testid="@TestId("pdf-annotation-thread")"
                            aria-expanded="@(IsSelected(thread) ? "true" : "false")"
                            aria-controls="@(IsSelected(thread) ? DetailId(thread) : null)"
                            @onclick="() => SelectAsync(thread.Id)">
                        <span class="tm-pdf-annotation-panel__badge">@ThreadNumber(thread)</span>
                        <span class="tm-pdf-annotation-panel__preview">@Preview(thread)</span>
                        @if (thread.Status == DocumentCommentThreadStatus.Resolved)
                        {
                            <span class="tm-pdf-annotation-panel__status">@Loc["TmPdfViewer_Resolved"]</span>
                        }
                    </button>

                    @if (IsSelected(thread))
                    {
                        <div class="tm-pdf-annotation-panel__detail" id="@DetailId(thread)" data-testid="@TestId("pdf-annotation-detail")">
                            @if (!string.IsNullOrWhiteSpace(thread.Anchor.HighlightedText))
                            {
                                <div class="tm-pdf-annotation-panel__quote">@Truncate(thread.Anchor.HighlightedText!)</div>
                            }

                            @foreach (var comment in thread.Comments)
                            {
                                <div class="tm-pdf-annotation-panel__comment" data-testid="@TestId("pdf-annotation-comment")">
                                    <div class="tm-pdf-annotation-panel__comment-head">
                                        <span class="tm-pdf-annotation-panel__author">@comment.AuthorName</span>
                                        <span class="tm-pdf-annotation-panel__time">@FormatTime(comment.CreatedAt)</span>
                                    </div>
                                    <div class="tm-pdf-annotation-panel__comment-body">@comment.Body</div>
                                    @if (comment.CanDelete && !Disabled)
                                    {
                                        <button type="button"
                                                class="tm-pdf-annotation-panel__link"
                                                data-testid="@TestId("pdf-annotation-delete")"
                                                @onclick="() => DeleteAsync(thread.Id, comment.Id)">
                                            @Loc["TmPdfViewer_Delete"]
                                        </button>
                                    }
                                </div>
                            }

                            @if (!Disabled)
                            {
                                <textarea class="tm-pdf-annotation-panel__input"
                                          placeholder="@Loc["TmPdfViewer_ReplyPlaceholder"]"
                                          data-testid="@TestId("pdf-annotation-reply-input")"
                                          @bind="_replyBody"
                                          @bind:event="oninput"></textarea>
                                <div class="tm-pdf-annotation-panel__actions">
                                    <button type="button"
                                            class="tm-pdf-annotation-panel__btn tm-pdf-annotation-panel__btn--primary"
                                            disabled="@(string.IsNullOrWhiteSpace(_replyBody))"
                                            data-testid="@TestId("pdf-annotation-reply-submit")"
                                            @onclick="() => ReplyAsync(thread.Id)">
                                        @Loc["TmPdfViewer_Reply"]
                                    </button>
                                    @if (thread.Status == DocumentCommentThreadStatus.Open)
                                    {
                                        <button type="button"
                                                class="tm-pdf-annotation-panel__btn tm-pdf-annotation-panel__btn--ghost"
                                                data-testid="@TestId("pdf-annotation-resolve")"
                                                @onclick="() => ResolveAsync(thread.Id)">
                                            @Loc["TmPdfViewer_Resolve"]
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="tm-pdf-annotation-panel__btn tm-pdf-annotation-panel__btn--ghost"
                                                data-testid="@TestId("pdf-annotation-reopen")"
                                                @onclick="() => ReopenAsync(thread.Id)">
                                            @Loc["TmPdfViewer_Reopen"]
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </li>
            }
        </ul>
    }
</aside>

@code {
    private string? _newBody;
    private string? _replyBody;

    // Per-instance id prefix: two viewers (Notion blocks) on one page each render
    // this panel, and identical detail ids would break aria-controls/aria-labelledby.
    private string _uid = "tm-pdf-th-" + Guid.NewGuid().ToString("N")[..8];

    /// <summary>Annotation threads to render.</summary>
    [Parameter] public IReadOnlyList<DocumentCommentThread> Threads { get; set; } = [];

    /// <summary>Selected thread id.</summary>
    [Parameter] public string? SelectedThreadId { get; set; }

    /// <summary>Callback invoked when the selected thread id changes.</summary>
    [Parameter] public EventCallback<string?> SelectedThreadIdChanged { get; set; }

    /// <summary>Current user id used for mention styling.</summary>
    [Parameter] public string? CurrentUserId { get; set; }

    /// <summary>Whether resolved threads are shown.</summary>
    [Parameter] public bool ShowResolved { get; set; }

    /// <summary>Callback invoked when the resolved filter toggles.</summary>
    [Parameter] public EventCallback<bool> ShowResolvedChanged { get; set; }

    /// <summary>Pending text selection awaiting a new comment, when present.</summary>
    [Parameter] public PdfTextSelection? PendingSelection { get; set; }

    /// <summary>Whether panel interaction is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Callback invoked with the body of a new thread requested from the pending selection.</summary>
    [Parameter] public EventCallback<string> OnCreateThreadRequested { get; set; }

    /// <summary>Callback invoked when a reply is requested.</summary>
    [Parameter] public EventCallback<DocumentCommentReplyRequest> OnReplyRequested { get; set; }

    /// <summary>Callback invoked when resolving a thread is requested.</summary>
    [Parameter] public EventCallback<string> OnResolveRequested { get; set; }

    /// <summary>Callback invoked when reopening a thread is requested.</summary>
    [Parameter] public EventCallback<string> OnReopenRequested { get; set; }

    /// <summary>Callback invoked when deleting a comment is requested.</summary>
    [Parameter] public EventCallback<DocumentCommentDeleteRequest> OnDeleteRequested { get; set; }

    /// <summary>Callback invoked when the pending selection is dismissed.</summary>
    [Parameter] public EventCallback OnSelectionDismissed { get; set; }

    private IEnumerable<DocumentCommentThread> VisibleThreads => Threads
        .Where(thread => ShowResolved || thread.Status == DocumentCommentThreadStatus.Open);

    private bool IsSelected(DocumentCommentThread thread)
        => string.Equals(thread.Id, SelectedThreadId, StringComparison.Ordinal);

    /// <summary>
    /// DOM id of the thread's expandable detail region, referenced by the header's
    /// aria-controls. Unique per panel instance (Guid prefix) and per thread
    /// (list index), so two panels on one page never collide.
    /// </summary>
    private string DetailId(DocumentCommentThread thread)
    {
        for (var i = 0; i < Threads.Count; i++)
        {
            if (ReferenceEquals(Threads[i], thread) || string.Equals(Threads[i].Id, thread.Id, StringComparison.Ordinal))
            {
                return $"{_uid}-{i}";
            }
        }

        return $"{_uid}-x";
    }

    private async Task CreateThreadAsync()
    {
        if (string.IsNullOrWhiteSpace(_newBody))
        {
            return;
        }

        var body = _newBody;
        _newBody = null;
        await OnCreateThreadRequested.InvokeAsync(body);
    }

    private Task CancelSelectionAsync()
    {
        _newBody = null;
        return OnSelectionDismissed.InvokeAsync();
    }

    private async Task ReplyAsync(string threadId)
    {
        if (string.IsNullOrWhiteSpace(_replyBody))
        {
            return;
        }

        var request = new DocumentCommentReplyRequest { ThreadId = threadId, Body = _replyBody };
        _replyBody = null;
        await OnReplyRequested.InvokeAsync(request);
    }

    private Task ResolveAsync(string threadId) => OnResolveRequested.InvokeAsync(threadId);

    private Task ReopenAsync(string threadId) => OnReopenRequested.InvokeAsync(threadId);

    private Task DeleteAsync(string threadId, string commentId)
        => OnDeleteRequested.InvokeAsync(new DocumentCommentDeleteRequest { ThreadId = threadId, CommentId = commentId });

    private async Task SelectAsync(string threadId)
    {
        // The selected thread id is owned by the parent; do not mutate the parameter here.
        _replyBody = null;
        var next = string.Equals(threadId, SelectedThreadId, StringComparison.Ordinal) ? null : threadId;
        await SelectedThreadIdChanged.InvokeAsync(next);
    }

    private Task ToggleResolvedAsync(ChangeEventArgs e)
    {
        var value = e.Value is bool b ? b : bool.TryParse(e.Value?.ToString(), out var parsed) && parsed;
        return ShowResolvedChanged.InvokeAsync(value);
    }

    private int ThreadNumber(DocumentCommentThread thread)
    {
        for (var i = 0; i < Threads.Count; i++)
        {
            if (ReferenceEquals(Threads[i], thread) || string.Equals(Threads[i].Id, thread.Id, StringComparison.Ordinal))
            {
                return i + 1;
            }
        }

        return 1;
    }

    private string ThreadItemClass(DocumentCommentThread thread)
    {
        var classes = new List<string> { "tm-pdf-annotation-panel__item" };
        if (string.Equals(thread.Id, SelectedThreadId, StringComparison.Ordinal))
        {
            classes.Add("tm-pdf-annotation-panel__item--selected");
        }

        if (thread.Status == DocumentCommentThreadStatus.Resolved)
        {
            classes.Add("tm-pdf-annotation-panel__item--resolved");
        }

        return string.Join(" ", classes);
    }

    private static string Preview(DocumentCommentThread thread)
    {
        var first = thread.Comments.FirstOrDefault()?.Body ?? string.Empty;
        return Truncate(first, 60);
    }

    private static string Truncate(string text, int max = 120)
    {
        text = text.Trim();
        return text.Length <= max ? text : text[..max] + "…";
    }

    private static string FormatTime(DateTimeOffset value)
        => value.ToLocalTime().ToString("g", CultureInfo.CurrentCulture);
}
