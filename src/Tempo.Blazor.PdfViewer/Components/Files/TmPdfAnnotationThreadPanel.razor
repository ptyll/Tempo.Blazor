@namespace Tempo.Blazor.Components.Files
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Abstractions.Models
@using Tempo.Blazor.Components.Icons

@* Thread panel of TmPdfViewer (PdfViewer redesign phase 4): keeps only its own header (title,
   resolved filter, ✕ close) and the new-thread prompt for the pending selection; the thread
   cards themselves render through the shared TmPdfThreadList (PD4), which composes
   TmPdfThreadCard / TmPdfCommentItem / TmPdfComposer. Comment edits flow through
   OnEditRequested to the provider. ShowChrome=false drops the panel's own title and close
   button for the responsive sheet presentations (the TmSidePanel sheet owns them there); the
   resolved filter stays in both presentations. *@

<aside class="@PanelClass" data-testid="@TestId("pdf-annotation-panel")" aria-label="@Loc["TmPdfViewer_AnnotationsPanelLabel"]">

    @if (ShowChrome)
    {
        <header class="tm-pdf-annotation-panel__header">
            <span class="tm-pdf-annotation-panel__title">@Loc["TmPdfViewer_Annotations"]</span>
            <label class="tm-pdf-annotation-panel__filter">
                <input type="checkbox"
                       checked="@ShowResolved"
                       disabled="@Disabled"
                       data-testid="@TestId("pdf-annotation-show-resolved")"
                       @onchange="ToggleResolvedAsync" />
                @Loc["TmPdfViewer_ShowResolved"]
            </label>
            <button type="button"
                    class="tm-pdf-annotation-panel__close"
                    data-testid="@TestId("pdf-annotation-close")"
                    aria-label="@Loc["TmPdfThread_ClosePanel"]"
                    title="@Loc["TmPdfThread_ClosePanel"]"
                    @onclick="() => OnCloseRequested.InvokeAsync()">
                <TmIcon Name="@IconNames.X" />
            </button>
        </header>
    }
    else
    {
        <div class="tm-pdf-annotation-panel__header tm-pdf-annotation-panel__header--sheet">
            <label class="tm-pdf-annotation-panel__filter">
                <input type="checkbox"
                       checked="@ShowResolved"
                       disabled="@Disabled"
                       data-testid="@TestId("pdf-annotation-show-resolved")"
                       @onchange="ToggleResolvedAsync" />
                @Loc["TmPdfViewer_ShowResolved"]
            </label>
        </div>
    }

    @if (PendingSelection is not null && !Disabled)
    {
        <div class="tm-pdf-annotation-panel__new" data-testid="@TestId("pdf-annotation-new")">
            <div class="tm-pdf-annotation-panel__prompt">@Loc["TmPdfViewer_SelectionPrompt"]</div>
            @if (!string.IsNullOrWhiteSpace(PendingSelection.Text))
            {
                <div class="tm-pdf-annotation-panel__quote">@PdfAnnotationTextHelper.Truncate(PendingSelection.Text)</div>
            }
            <TmPdfComposer Placeholder="@Loc["TmPdfViewer_NewCommentPlaceholder"]"
                           SubmitLabel="@Loc["TmPdfViewer_Comment"]"
                           InputTestId="@TestId("pdf-annotation-new-input")"
                           SubmitTestId="@TestId("pdf-annotation-new-submit")"
                           SecondaryLabel="@Loc["TmPdfViewer_Cancel"]"
                           SecondaryTestId="@TestId("pdf-annotation-new-cancel")"
                           OnSecondary="CancelSelectionAsync"
                           OnSubmit="CreateThreadAsync" />
        </div>
    }

    <TmPdfThreadList Threads="@Threads"
                     SelectedThreadId="@SelectedThreadId"
                     SelectedThreadIdChanged="SelectedThreadIdChanged"
                     CurrentUserId="@CurrentUserId"
                     ShowResolved="ShowResolved"
                     Disabled="Disabled"
                     TestIdBase="@TestId("pdf-annotation")"
                     HideCommentKind="true"
                     EmptyText="@Loc["TmPdfViewer_NoAnnotations"]"
                     ReplyPlaceholder="@Loc["TmPdfViewer_ReplyPlaceholder"]"
                     ReplySubmitLabel="@Loc["TmPdfViewer_Reply"]"
                     ResolveLabel="@Loc["TmPdfViewer_Resolve"]"
                     ReopenLabel="@Loc["TmPdfViewer_Reopen"]"
                     OnReplyRequested="OnReplyRequested"
                     OnEditRequested="OnEditRequested"
                     OnResolveRequested="OnResolveRequested"
                     OnReopenRequested="OnReopenRequested"
                     OnDeleteRequested="OnDeleteRequested" />
</aside>

@code {
    /// <summary>
    /// The panel's class: the base plus the <c>--sheet</c> modifier when the panel renders
    /// inside a responsive sheet (<see cref="ShowChrome"/> false) — the sheet owns the width
    /// there, so the docked 280px column and its left border give way.
    /// </summary>
    private string PanelClass => ShowChrome ? "tm-pdf-annotation-panel" : "tm-pdf-annotation-panel tm-pdf-annotation-panel--sheet";

    /// <summary>
    /// Whether the panel renders its own header (title + ✕ close). Default true — the docked
    /// desktop presentation. When the panel is hosted inside a responsive sheet
    /// (<c>TmSidePanel</c>), the sheet header owns the title and the close button, so the
    /// host passes false and the panel renders only the resolved filter and its body.
    /// </summary>
    [Parameter] public bool ShowChrome { get; set; } = true;

    /// <summary>Annotation threads to render.</summary>
    [Parameter] public IReadOnlyList<DocumentCommentThread> Threads { get; set; } = [];

    /// <summary>Selected thread id.</summary>
    [Parameter] public string? SelectedThreadId { get; set; }

    /// <summary>Callback invoked when the selected thread id changes.</summary>
    [Parameter] public EventCallback<string?> SelectedThreadIdChanged { get; set; }

    /// <summary>Current user id used for mention styling and permission checks.</summary>
    [Parameter] public string? CurrentUserId { get; set; }

    /// <summary>Whether resolved threads are shown.</summary>
    [Parameter] public bool ShowResolved { get; set; }

    /// <summary>Callback invoked when the resolved filter toggles.</summary>
    [Parameter] public EventCallback<bool> ShowResolvedChanged { get; set; }

    /// <summary>Pending text selection awaiting a new comment, when present.</summary>
    [Parameter] public PdfTextSelection? PendingSelection { get; set; }

    /// <summary>Whether panel interaction is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Callback invoked with the body of a new thread requested from the pending selection.</summary>
    [Parameter] public EventCallback<string> OnCreateThreadRequested { get; set; }

    /// <summary>Callback invoked when a reply is requested.</summary>
    [Parameter] public EventCallback<DocumentCommentReplyRequest> OnReplyRequested { get; set; }

    /// <summary>Callback invoked when an existing comment body is edited.</summary>
    [Parameter] public EventCallback<DocumentCommentEditRequest> OnEditRequested { get; set; }

    /// <summary>Callback invoked when resolving a thread is requested.</summary>
    [Parameter] public EventCallback<string> OnResolveRequested { get; set; }

    /// <summary>Callback invoked when reopening a thread is requested.</summary>
    [Parameter] public EventCallback<string> OnReopenRequested { get; set; }

    /// <summary>Callback invoked when deleting a comment is requested.</summary>
    [Parameter] public EventCallback<DocumentCommentDeleteRequest> OnDeleteRequested { get; set; }

    /// <summary>Callback invoked when the pending selection is dismissed.</summary>
    [Parameter] public EventCallback OnSelectionDismissed { get; set; }

    /// <summary>Callback invoked when the panel's close button is pressed.</summary>
    [Parameter] public EventCallback OnCloseRequested { get; set; }

    private Task CreateThreadAsync(string body) => OnCreateThreadRequested.InvokeAsync(body);

    private Task CancelSelectionAsync() => OnSelectionDismissed.InvokeAsync();

    private Task ToggleResolvedAsync(ChangeEventArgs e)
    {
        var value = e.Value is bool b ? b : bool.TryParse(e.Value?.ToString(), out var parsed) && parsed;
        return ShowResolvedChanged.InvokeAsync(value);
    }
}
