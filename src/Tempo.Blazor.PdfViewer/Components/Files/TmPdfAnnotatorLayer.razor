@namespace Tempo.Blazor.Components.Files
@inherits Tempo.Blazor.Components.TmComponentBase
@using System.Globalization
@using System.Text
@using Tempo.Blazor.Abstractions.Models

<div class="tm-pdf-annotator-layer" data-testid="@TestId("pdf-annotator-layer")" aria-label="@Loc["TmPdfAnnotator_LayerLabel"]">

    @{
        var visibleThreads = VisibleThreads.ToList();
        var hasInk = visibleThreads.Any(thread => thread.InkStrokes.Count > 0) || DraftHasInk;
    }
    @if (hasInk)
    {
        <svg class="tm-pdf-annotator-layer__svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            @foreach (var thread in visibleThreads)
            {
                @foreach (var stroke in thread.InkStrokes)
                {
                    <polyline class="@InkClass(thread)"
                              data-testid="@TestId("pdf-annotator-ink")"
                              data-thread-id="@thread.Id"
                              points="@ToPolylinePoints(stroke)"
                              fill="none"
                              stroke="@Color(thread)"
                              vector-effect="non-scaling-stroke" />
                }
            }

            @if (Draft is not null)
            {
                @foreach (var stroke in Draft.Strokes)
                {
                    <polyline class="tm-pdf-annotator-layer__ink tm-pdf-annotator-layer__ink--draft"
                              data-testid="@TestId("pdf-annotator-draft")"
                              points="@ToPolylinePoints(stroke)"
                              fill="none"
                              stroke="@DraftColor"
                              vector-effect="non-scaling-stroke" />
                }
            }

            @if (ActiveStroke is { Count: > 1 })
            {
                <polyline class="tm-pdf-annotator-layer__ink tm-pdf-annotator-layer__ink--draft"
                          points="@ToPolylinePoints(ActiveStroke)"
                          fill="none"
                          stroke="@DraftColor"
                          vector-effect="non-scaling-stroke" />
            }
        </svg>
    }

    @foreach (var thread in visibleThreads)
    {
        @if (thread.Kind == DocumentAnnotationKind.Highlight || thread.Anchor.Kind == DocumentCommentAnchorKind.TextRange)
        {
            @foreach (var rect in thread.Anchor.Rects)
            {
                <button type="button"
                        class="@HighlightClass(thread)"
                        style="@(DocumentCommentGeometryHelper.ToRectStyle(rect) + $" background:{Color(thread)};")"
                        aria-label="@AnnotationLabel(thread)"
                        data-thread-id="@thread.Id"
                        data-testid="@TestId("pdf-annotator-highlight")"
                        @onclick:stopPropagation="true"
                        @onclick="() => SelectAsync(thread.Id)"></button>
            }
        }
        else if (thread.Kind == DocumentAnnotationKind.Stamp)
        {
            <button type="button"
                    class="@StampClass(thread)"
                    style="@(DocumentCommentGeometryHelper.ToAreaStyle(thread.Anchor) + $" color:{Color(thread)}; border-color:{Color(thread)};")"
                    aria-label="@AnnotationLabel(thread)"
                    data-thread-id="@thread.Id"
                    data-testid="@TestId("pdf-annotator-stamp")"
                    @onclick:stopPropagation="true"
                    @onclick="() => SelectAsync(thread.Id)">
                <span>@thread.StampText</span>
            </button>
        }
        else
        {
            <button type="button"
                    class="@MarkerClass(thread)"
                    style="@(DocumentCommentGeometryHelper.ToPointStyle(thread.Anchor) + $" background:{Color(thread)};")"
                    aria-label="@AnnotationLabel(thread)"
                    data-thread-id="@thread.Id"
                    data-testid="@TestId(thread.Kind == DocumentAnnotationKind.Drawing ? "pdf-annotator-drawing-marker" : "pdf-annotator-marker")"
                    @onclick:stopPropagation="true"
                    @onclick="() => SelectAsync(thread.Id)">
                <span>@ThreadNumber(thread)</span>
            </button>
        }
    }

    @if (Draft?.Anchor is not null)
    {
        @if (Draft.Anchor.Kind == DocumentCommentAnchorKind.TextRange)
        {
            @foreach (var rect in Draft.Anchor.Rects)
            {
                <div class="tm-pdf-annotator-layer__highlight tm-pdf-annotator-layer__highlight--draft"
                     style="@(DocumentCommentGeometryHelper.ToRectStyle(rect) + $" background:{DraftColor};")"
                     data-testid="@TestId("pdf-annotator-draft")"
                     aria-hidden="true"></div>
            }
        }
        else if (Draft.Kind == DocumentAnnotationKind.Comment)
        {
            <div class="tm-pdf-annotator-layer__marker tm-pdf-annotator-layer__marker--draft"
                 style="@(DocumentCommentGeometryHelper.ToPointStyle(Draft.Anchor) + $" background:{DraftColor};")"
                 data-testid="@TestId("pdf-annotator-draft")"
                 aria-hidden="true"><span>+</span></div>
        }
    }
</div>

@code {
    /// <summary>Annotation threads available to render.</summary>
    [Parameter] public IReadOnlyList<DocumentCommentThread> Threads { get; set; } = [];

    /// <summary>One-based current page number.</summary>
    [Parameter] public int PageNumber { get; set; } = 1;

    /// <summary>Selected thread id.</summary>
    [Parameter] public string? SelectedThreadId { get; set; }

    /// <summary>Whether resolved threads should be rendered.</summary>
    [Parameter] public bool ShowResolved { get; set; }

    /// <summary>Resolves the display color of a thread. Falls back to the default palette.</summary>
    [Parameter] public Func<DocumentCommentThread, string>? ColorResolver { get; set; }

    /// <summary>Current pending draft, when any.</summary>
    [Parameter] public PdfAnnotatorDraft? Draft { get; set; }

    /// <summary>Stroke currently being drawn, when any.</summary>
    [Parameter] public IReadOnlyList<DocumentInkPoint>? ActiveStroke { get; set; }

    /// <summary>Color used for the draft and the active stroke. Defaults to <see cref="PdfAnnotationColorHelper.DefaultColor"/>.</summary>
    [Parameter] public string DraftColor { get; set; } = PdfAnnotationColorHelper.DefaultColor;

    /// <summary>Whether interaction is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Callback invoked when an annotation is selected.</summary>
    [Parameter] public EventCallback<string> OnThreadSelected { get; set; }

    private IEnumerable<DocumentCommentThread> VisibleThreads => Threads
        .Where(thread => thread.Anchor.PageNumber == PageNumber)
        .Where(thread => ShowResolved || thread.Status == DocumentCommentThreadStatus.Open);

    private bool DraftHasInk
        => Draft is { Strokes.Count: > 0 } || ActiveStroke is { Count: > 1 };

    private Task SelectAsync(string threadId)
        => Disabled ? Task.CompletedTask : OnThreadSelected.InvokeAsync(threadId);

    private string Color(DocumentCommentThread thread)
        => ColorResolver?.Invoke(thread)
           ?? PdfAnnotationColorHelper.ResolveColor(thread, null, null, null);

    private int ThreadNumber(DocumentCommentThread thread)
    {
        for (var i = 0; i < Threads.Count; i++)
        {
            if (ReferenceEquals(Threads[i], thread) || string.Equals(Threads[i].Id, thread.Id, StringComparison.Ordinal))
            {
                return i + 1;
            }
        }

        return 1;
    }

    private string AnnotationLabel(DocumentCommentThread thread)
    {
        var kind = thread.Kind switch
        {
            DocumentAnnotationKind.Highlight => Loc["TmPdfAnnotator_KindHighlight"],
            DocumentAnnotationKind.Stamp => Loc["TmPdfAnnotator_KindStamp"],
            DocumentAnnotationKind.Drawing => Loc["TmPdfAnnotator_KindDrawing"],
            _ => Loc["TmPdfAnnotator_KindComment"]
        };
        var state = thread.Status == DocumentCommentThreadStatus.Resolved
            ? Loc["TmPdfAnnotator_Resolved"]
            : Loc["TmPdfAnnotator_StatusOpen"];
        return Loc["TmPdfAnnotator_AnnotationAriaLabel", kind, ThreadNumber(thread), thread.Anchor.PageNumber, state];
    }

    private string HighlightClass(DocumentCommentThread thread)
        => Compose("tm-pdf-annotator-layer__highlight", thread);

    private string StampClass(DocumentCommentThread thread)
        => Compose("tm-pdf-annotator-layer__stamp", thread);

    private string MarkerClass(DocumentCommentThread thread)
        => Compose("tm-pdf-annotator-layer__marker", thread);

    private string InkClass(DocumentCommentThread thread)
        => Compose("tm-pdf-annotator-layer__ink", thread);

    private string Compose(string baseClass, DocumentCommentThread thread)
    {
        var classes = new List<string> { baseClass };
        if (string.Equals(thread.Id, SelectedThreadId, StringComparison.Ordinal))
        {
            classes.Add(baseClass + "--selected");
        }

        if (thread.Status == DocumentCommentThreadStatus.Resolved)
        {
            classes.Add(baseClass + "--resolved");
        }

        return string.Join(" ", classes);
    }

    private static string ToPolylinePoints(DocumentInkStroke stroke)
        => ToPolylinePoints(stroke.Points);

    private static string ToPolylinePoints(IReadOnlyList<DocumentInkPoint> points)
    {
        var builder = new StringBuilder();
        for (var i = 0; i < points.Count; i++)
        {
            if (i > 0)
            {
                builder.Append(' ');
            }

            builder.Append((points[i].X * 100).ToString("0.###", CultureInfo.InvariantCulture))
                .Append(',')
                .Append((points[i].Y * 100).ToString("0.###", CultureInfo.InvariantCulture));
        }

        return builder.ToString();
    }
}
