@namespace Tempo.Blazor.Components.Files
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Abstractions.Models
@using Tempo.Blazor.Abstractions.Layout
@using Tempo.Blazor.Components.Actions
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Components.Layout
@using Tempo.Blazor.Components.Toolbar

@* FZE-8: the responsive annotator. The annotator is laid out on the core TmEditorShell (F6):
   the viewer — with its own thumbnails — is the shell's Canvas, the thread panel is the docked
   Right (a non-modal bottom sheet on a mobile layout) and the F5 action bar carries the export,
   flatten and print commands on a phone. ShowPanel/ShowPanelChanged map onto the shell's
   RightOpen. The wrapper div keeps the component's root contract (the pdf-annotator test id and
   the data-editor-layout mirror the diagram editor uses). *@

<div class="tm-pdf-annotator @Class"
     style="@RootStyle"
     data-editor-layout="@LayoutName"
     data-testid="@TestId("pdf-annotator")"
     @ref="_annotatorRef">

    <TmEditorShell Class="tm-pdf-annotator__shell"
                   LayoutMode="@LayoutMode"
                   ResolvedLayoutChanged="OnShellResolvedLayoutChanged"
                   Canvas="@ViewerSlot"
                   Right="@PanelSlot"
                   RightOpen="_panelVisible"
                   RightOpenChanged="HandleRightOpenChangedAsync"
                   CollapsedPanels="_collapsedPanels"
                   CollapsedPanelsChanged="HandleCollapsedPanelsChangedAsync"
                   RightTitle="@Loc["TmPdfAnnotator_PanelLabel"]"
                   MobileActions="@MobileBarItems"
                   ShowMobilePanelsToggle="false"
                   MobileSheetSnapIndex="_mobileSnapIndex"
                   MobileSheetSnapIndexChanged="SilentSnapChangedAsync"
                   MobileSheetSnapPoints="MobileSheetSnapPoints" />

    @* FZE-12: the shared color palette popover/sheet — anchored to whichever control opened
       it (the toolbar trigger or the mobile palette tile); renders nothing while closed. *@
    @ColorPickerPanel

    @* FZE-15 review: the short VISIBLE status near the toolbar (conflict / failure hints —
       the live region below is invisible to sighted users). A floating, dismissible chip that
       auto-times-out after ~5 s; it overlays the canvas without shifting the layout. *@
    @if (_statusMessage is not null)
    {
        <div class="tm-pdf-annotator__status" role="status" aria-live="polite"
             data-testid="@TestId("pdf-annotator-status")">
            <span class="tm-pdf-annotator__status-text">@_statusMessage</span>
            <button type="button"
                    class="tm-pdf-annotator__status-dismiss"
                    aria-label="@Loc["TmPdfAnnotator_Dismiss"]"
                    data-testid="@TestId("pdf-annotator-status-dismiss")"
                    @onclick="DismissStatusAsync">
                <TmIcon Name="x" Size="IconSize.Sm" />
            </button>
        </div>
    }

    @* FZE-15: the visually-hidden live region announcing undo/redo results and the
       conflict hint ("another user has changed the thread") to assistive technology. *@
    <div class="tm-pdf-annotator__announcer"
         role="status"
         aria-live="polite"
         aria-atomic="true"
         data-testid="@TestId("pdf-annotator-announcer")">@_announcement</div>
</div>

@code {
    /// <summary>
    /// FZE-15: the undo/redo pair as its OWN sibling group — the frozen DiagramEditor
    /// <c>data-tm-group="history"</c> contract, rendered BEFORE the tools at every call site
    /// (merged viewer toolbar, tablet/compact row, fallback row). The buttons are core
    /// <see cref="TmToolbarButton"/>s (Primary priorities), so a merged toolbar can move them
    /// into its "More" menu when the row runs out of room. On a tablet layout the pair is
    /// icon-only (<see cref="HistoryLabelPosition"/>) so the labelled Stamp/Draw pills fit.
    /// </summary>
    private RenderFragment HistoryGroup => @<div class="tm-pdf-annotator__history"
                                                   role="group"
                                                   aria-label="@Loc["TmPdfAnnotator_HistoryGroup"]"
                                                   data-tm-group="history"
                                                   data-testid="@TestId("pdf-annotator-history")">
        <TmToolbarButton Icon="@IconNames.Undo2"
                         Text="@Loc["TmPdfAnnotator_Undo"]"
                         Tooltip="@UndoTooltip"
                         Priority="ToolbarButtonPriority.Primary"
                         LabelPosition="@HistoryLabelPosition"
                         Disabled="@(!CanUndo)"
                         aria-disabled="@(!CanUndo ? "true" : null)"
                         aria-keyshortcuts="Control+Z"
                         data-testid="@TestId("pdf-annotator-undo")"
                         OnClick="UndoAsync" />
        <TmToolbarButton Icon="@IconNames.Redo2"
                         Text="@Loc["TmPdfAnnotator_Redo"]"
                         Tooltip="@RedoTooltip"
                         Priority="ToolbarButtonPriority.Primary"
                         LabelPosition="@HistoryLabelPosition"
                         Disabled="@(!CanRedo)"
                         aria-disabled="@(!CanRedo ? "true" : null)"
                         aria-keyshortcuts="Control+Shift+Z Control+Y"
                         data-testid="@TestId("pdf-annotator-redo")"
                         OnClick="RedoAsync" />
    </div>;

    /// <summary>
    /// The annotator's tool group (mode pills, stamp picker, color picker trigger) shared by
    /// the merged viewer toolbar (<see cref="TmPdfViewer.ToolbarStart"/>) and the fallback row.
    /// The tools are core <see cref="TmToolbarButton"/>s (Primary priorities), so the merged
    /// toolbar can move them into its "More" menu when the row runs out of room; the group
    /// carries the stable <c>data-tm-group</c> contract value. On a tablet layout with labels
    /// shown the pills render their text under the icon.
    /// </summary>
    private RenderFragment ToolsGroup => @<div class="tm-pdf-annotator__tools"
                                                    role="group"
                                                    aria-label="@Loc["TmPdfAnnotator_ToolsGroup"]"
                                                    data-tm-group="tools"
                                                    data-testid="@TestId("pdf-annotator-tools")">
        <div class="tm-pdf-annotator__modes">
            <TmToolbarButton Icon="mouse-pointer"
                             Text="@Loc["TmPdfAnnotator_ModeBrowse"]"
                             Tooltip="@Loc["TmPdfAnnotator_ModeBrowse"]"
                             Priority="ToolbarButtonPriority.Primary"
                             LabelPosition="@ToolLabelPosition"
                             Pressed="@(_mode == PdfAnnotatorMode.Browse)"
                             Class="@ModeClass(PdfAnnotatorMode.Browse)"
                             data-testid="@TestId("pdf-annotator-mode-browse")"
                             OnClick="() => SetModeAsync(PdfAnnotatorMode.Browse)" />
            <TmToolbarButton Icon="highlighter"
                             Text="@Loc["TmPdfAnnotator_ModeHighlight"]"
                             Tooltip="@Loc["TmPdfAnnotator_ModeHighlight"]"
                             Priority="ToolbarButtonPriority.Primary"
                             LabelPosition="@ToolLabelPosition"
                             Pressed="@(_mode == PdfAnnotatorMode.Highlight)"
                             Class="@ModeClass(PdfAnnotatorMode.Highlight)"
                             data-testid="@TestId("pdf-annotator-mode-highlight")"
                             OnClick="() => SetModeAsync(PdfAnnotatorMode.Highlight)" />
            <TmToolbarButton Icon="message-square"
                             Text="@Loc["TmPdfAnnotator_ModeComment"]"
                             Tooltip="@Loc["TmPdfAnnotator_ModeComment"]"
                             Priority="ToolbarButtonPriority.Primary"
                             LabelPosition="@ToolLabelPosition"
                             Pressed="@(_mode == PdfAnnotatorMode.Comment)"
                             Class="@ModeClass(PdfAnnotatorMode.Comment)"
                             data-testid="@TestId("pdf-annotator-mode-comment")"
                             OnClick="() => SetModeAsync(PdfAnnotatorMode.Comment)" />
            <TmToolbarButton Icon="stamp"
                             Text="@Loc["TmPdfAnnotator_ModeStamp"]"
                             Tooltip="@Loc["TmPdfAnnotator_ModeStamp"]"
                             Priority="ToolbarButtonPriority.Primary"
                             LabelPosition="@ToolLabelPosition"
                             Pressed="@(_mode == PdfAnnotatorMode.Stamp)"
                             Class="@ModeClass(PdfAnnotatorMode.Stamp)"
                             data-testid="@TestId("pdf-annotator-mode-stamp")"
                             OnClick="() => SetModeAsync(PdfAnnotatorMode.Stamp)" />
            <TmToolbarButton Icon="pencil"
                             Text="@Loc["TmPdfAnnotator_ModeDraw"]"
                             Tooltip="@Loc["TmPdfAnnotator_ModeDraw"]"
                             Priority="ToolbarButtonPriority.Primary"
                             LabelPosition="@ToolLabelPosition"
                             Pressed="@(_mode == PdfAnnotatorMode.Draw)"
                             Class="@ModeClass(PdfAnnotatorMode.Draw)"
                             data-testid="@TestId("pdf-annotator-mode-draw")"
                             OnClick="() => SetModeAsync(PdfAnnotatorMode.Draw)" />
        </div>

        @if (_mode == PdfAnnotatorMode.Stamp)
        {
            <label class="tm-pdf-annotator__stamp-picker">
                <span class="tm-pdf-annotator__stamp-label">@Loc["TmPdfAnnotator_StampLabel"]</span>
                <select class="tm-pdf-annotator__stamp-select"
                        aria-label="@Loc["TmPdfAnnotator_StampLabel"]"
                        data-testid="@TestId("pdf-annotator-stamp-select")"
                        @onchange="HandleStampSelectionChanged">
                    @{ var stampOptions = EffectiveStampOptions; }
                    @for (var i = 0; i < stampOptions.Count; i++)
                    {
                        var index = i;
                        <option value="@index" selected="@(index == _selectedStampIndex)">@stampOptions[index]</option>
                    }
                </select>
            </label>
        }

        <div class="tm-pdf-annotator__color">
            @if (AllowColorPicker)
            {
                @* FZE-12: the runtime color picker. The chip rides the trigger button; the
                   visible label span keeps the pre-phase-12 accessible name plus the current
                   color's name in the aria-label. The palette opens in the shared overlay
                   (bottom sheet on a mobile layout — see the TmOverlayPanel below). *@
                <button type="button"
                        class="tm-pdf-annotator__color-trigger"
                        aria-haspopup="dialog"
                        aria-expanded="@(_colorPickerOpen ? "true" : "false")"
                        aria-label="@ColorTriggerAriaLabel"
                        title="@ColorTriggerAriaLabel"
                        data-testid="@TestId("pdf-annotator-color-trigger")"
                        @ref="_colorTriggerRef"
                        @onclick="OpenColorPickerAsync">
                    <span class="tm-pdf-annotator__color-chip"
                          style="background:@CurrentAuthorColor"
                          aria-hidden="true"></span>
                    <span class="tm-pdf-annotator__color-label"
                          data-testid="@TestId("pdf-annotator-color-label")">@Loc["TmPdfAnnotator_ColorLabel"]</span>
                    @* TmIcon renders aria-hidden="true" on the svg itself — the chevron is decorative. *@
                    <TmIcon Name="chevron-down" Size="IconSize.Xs" Class="tm-pdf-annotator__color-chevron" />
                </button>
            }
            else
            {
                @* The static pre-phase-12 indicator: the chip is decorative, the visible label
                   span is the color indicator's accessible name. *@
                <span class="tm-pdf-annotator__color-chip"
                      style="background:@CurrentAuthorColor"
                      aria-hidden="true"></span>
                <span class="tm-pdf-annotator__color-label"
                      data-testid="@TestId("pdf-annotator-color-label")">@Loc["TmPdfAnnotator_ColorLabel"]</span>
            }
        </div>
    </div>;

    /// <summary>
    /// The export group (Export / flattened export / Print) as secondary buttons, shared by
    /// the toolbar end and the header row. Carries the stable <c>data-tm-group</c> contract value.
    /// A mobile layout offers the same commands through the action bar instead.
    /// </summary>
    private RenderFragment ExportGroup => @<div class="tm-pdf-annotator__export-group"
                                                role="group"
                                                aria-label="@Loc["TmPdfAnnotator_ExportGroup"]"
                                                data-tm-group="export"
                                                data-testid="@TestId("pdf-annotator-export-group")">
        <button type="button"
                class="tm-pdf-annotator__action tm-pdf-annotator__action--secondary"
                title="@Loc["TmPdfAnnotator_Export"]"
                aria-label="@Loc["TmPdfAnnotator_Export"]"
                data-testid="@TestId("pdf-annotator-export")"
                @onclick="() => ExportAsync(false)">
            <TmIcon Name="file-down" Size="IconSize.Sm" />
            <span class="tm-pdf-annotator__action-text">@Loc["TmPdfAnnotator_Export"]</span>
        </button>
        <button type="button"
                class="tm-pdf-annotator__action tm-pdf-annotator__action--secondary"
                title="@Loc["TmPdfAnnotator_ExportFlattened"]"
                aria-label="@Loc["TmPdfAnnotator_ExportFlattened"]"
                data-testid="@TestId("pdf-annotator-export-flat")"
                @onclick="() => ExportAsync(true)">
            <TmIcon Name="layers" Size="IconSize.Sm" />
            <span class="tm-pdf-annotator__action-text">@Loc["TmPdfAnnotator_ExportFlattened"]</span>
        </button>
        <button type="button"
                class="tm-pdf-annotator__action tm-pdf-annotator__action--secondary"
                title="@Loc["TmPdfAnnotator_Print"]"
                aria-label="@Loc["TmPdfAnnotator_Print"]"
                data-testid="@TestId("pdf-annotator-print")"
                @onclick="PrintAsync">
            <TmIcon Name="printer" Size="IconSize.Sm" />
            <span class="tm-pdf-annotator__action-text">@Loc["TmPdfAnnotator_Print"]</span>
        </button>
    </div>;

    /// <summary>
    /// The panel toggle: keeps the panel reachable when <see cref="ShowPanel"/> is unbound —
    /// the ✕ inside the panel only flips the internal state, this button flips it back
    /// (aria-pressed reflects the current visibility). A core <see cref="TmToolbarButton"/>
    /// (Pinned — the trailing reopen affordance stays on the bar at every width, exactly like
    /// the primary Save call to action). A mobile layout reaches the panel through the action
    /// bar and the thread markers instead.
    /// </summary>
    private RenderFragment PanelToggleButton => @<TmToolbarButton Icon="@IconNames.PanelRight"
                 Text="@Loc["TmPdfAnnotator_TogglePanel"]"
                 Tooltip="@Loc["TmPdfAnnotator_TogglePanel"]"
                 Priority="ToolbarButtonPriority.Pinned"
                 LabelPosition="ToolbarLabelPosition.Hidden"
                 Pressed="@_panelVisible"
                 Class="tm-pdf-annotator__panel-toggle"
                 data-testid="@TestId("pdf-annotator-panel-toggle")"
                 OnClick="TogglePanelAsync" />;

    /// <summary>
    /// The shell's canvas region: the compact fallback row (when the annotator does not merge
    /// into the viewer toolbar and the layout offers the full tool set) and the viewer itself.
    /// The thumbnails stay inside the viewer — they are its own sidebar and mobile sheet.
    /// </summary>
    private RenderFragment ViewerSlot => @<div class="tm-pdf-annotator__viewer">

        @* G2 mobile tool palette: a horizontally scrollable tile row with exactly the two
           light-edit tools (browse and add comment); the editing tools stay tablet+. *@
        @if (IsMobileLayout)
        {
            @MobilePalette
        }

        @* Compact fallback row: rendered when the annotator does NOT merge into the viewer
           toolbar (ShowViewerToolbar=false, or no document yet) on a desktop layout, and — per
           the phase 8 review — on a TABLET layout always: the tablet ribbon renders the tools
           and the export group as their own full-width labelled row above the canvas instead of
           squeezing them into the narrow viewer toolbar's "More" overflow (where the color chip
           would wrap as a stray dot). With the default settings the desktop annotator has no
           toolbar of its own — its groups are composed into the single viewer toolbar through
           the ToolbarStart/ToolbarEnd slots (phase 3). *@
        @if ((!UseMergedToolbar || IsTabletLayout) && !IsMobileLayout)
        {
            <div class="tm-pdf-annotator__toolbar @(IsTabletLayout ? "tm-pdf-annotator__toolbar--tablet" : null)"
                 role="group"
                 aria-label="@Loc["TmPdfAnnotator_ToolbarLabel"]"
                 data-testid="@TestId("pdf-annotator-toolbar")">
                @if (AllowUndo)
                {
                    @HistoryGroup
                }
                @ToolsGroup
                <div class="tm-pdf-annotator__toolbar-end">
                    @if (AllowExport && !ShowHeader)
                    {
                        @ExportGroup
                    }
                    @PanelToggleButton
                </div>
            </div>
        }

        @* FZE-14: the PD1 pin is lifted — ViewMode passes through (default SinglePage keeps
           the pre-FZE-14 behavior) and the host may offer the viewer's toggle. In Continuous
           the annotator renders its layer and surface per page through the viewer's
           PageOverlayContent slots (FZE-13); the single-page OverlayContent below stays the
           one-surface presentation. On a mobile layout the annotator injects nothing into
           the viewer's compact row: paging and zoom are the viewer's own F7 chrome and the
           annotator's commands live in the palette and the action bar. *@
        <TmPdfViewer @ref="_viewer"
                     Url="@Url"
                     DocumentId="@DocumentId"
                     Height="@ViewerHeight"
                     ShowToolbar="UseMergedToolbar"
                     ShowHeader="ShowHeader"
                     Title="@Title"
                     Subtitle="@Subtitle"
                     ShowOpenLink="ShowOpenLink"
                     HeaderStart="@HeaderStart"
                     ToolbarLabels="ToolbarLabels"
                     ShowThumbnails="ShowThumbnails"
                     ThumbnailsCollapsed="_thumbnailsCollapsed"
                     ThumbnailsCollapsedChanged="HandleThumbnailsCollapsedChangedAsync"
                     ShowSearch="ShowSearch"
                     SearchPresentation="SearchPresentation"
                     ShowMobileActionBar="false"
                     AllowRotation="AllowRotation"
                     ZoomMode="_zoomMode"
                     ZoomModeChanged="HandleZoomModeChangedAsync"
                     ViewMode="@_viewMode"
                     ViewModeChanged="HandleViewModeChangedAsync"
                     ShowViewModeToggle="ShowViewModeToggle"
                     ShowTextLayer="true"
                     EnableTextSelectionEvents="true"
                     AllowDownload="false"
                     Page="_currentPage"
                     PageChanged="HandlePageChangedAsync"
                     OnDocumentLoaded="HandleDocumentLoaded"
                     OnTextSelected="HandleTextSelectedAsync"
                     PageOverlayContent="@ContinuousPageOverlay">
            <ToolbarStart>
                @if (InjectToolbarGroups)
                {
                    @if (AllowUndo)
                    {
                        @HistoryGroup
                    }
                    @ToolsGroup
                }
            </ToolbarStart>
            <ToolbarEnd>@(InjectToolbarGroups ? ToolbarEndFragment : null)</ToolbarEnd>
            @* Row 1 (rendered only when the viewer header is on): the viewer header hosts
               the title/subtitle plus the export group (secondary buttons) followed by the
               host's own actions. *@
            <HeaderActions>
                @if (AllowExport && !IsMobileLayout)
                {
                    @ExportGroup
                }
                @HeaderActions
            </HeaderActions>
            <OverlayContent>
                <TmPdfAnnotatorLayer Threads="_threads"
                                     PageNumber="_currentPage"
                                     SelectedThreadId="@_selectedThreadId"
                                     ShowResolved="_showResolved"
                                     ColorResolver="_colorResolver"
                                     Draft="_draft"
                                     ActiveStroke="_activeStroke"
                                     DraftColor="@CurrentAuthorColor"
                                     OnThreadSelected="SelectThreadAsync" />
                <div @ref="_surfaceRef"
                     class="tm-pdf-annotator__surface @(SurfaceActive ? "tm-pdf-annotator__surface--active" : "") @(_mode == PdfAnnotatorMode.Draw ? "tm-pdf-annotator__surface--draw" : "")"
                     data-testid="@TestId("pdf-annotator-surface")"
                     tabindex="-1"
                     @onclick="e => HandleSurfaceClickAsync(e)"
                     @onpointerdown="(PointerEventArgs e) => HandlePointerDownAsync(e)"
                     @onpointerdown:preventDefault="true"
                     @onpointermove="(PointerEventArgs e) => HandlePointerMoveAsync(e)"
                     @onpointerup="(PointerEventArgs e) => HandlePointerUpAsync(e)"
                     @onpointercancel="HandlePointerCancel"
                     @onpointerleave="(PointerEventArgs e) => HandlePointerLeaveAsync(e)"></div>
            </OverlayContent>
            @* FZE-9 review (M4/UX3): the sticky Highlight CTA (tablet only — G2 keeps the edit
               tools off a phone) rides the viewer's in-flow SelectionCtaContent row, OUTSIDE
               the scroll area, so a zoom or a scroll never carries it away. The touch
               selection creates the draft; the CTA is the finger-sized path to its composer
               when the panel is closed or out of reach. *@
            <SelectionCtaContent>
                @if (IsTabletLayout && _mode == PdfAnnotatorMode.Highlight && _draft?.Kind == DocumentAnnotationKind.Highlight)
                {
                    <button type="button"
                            class="tm-pdf-annotator__selection-cta"
                            data-testid="@TestId("pdf-annotator-highlight-cta")"
                            @onclick="OpenDraftComposerAsync">
                        <TmIcon Name="highlighter" Size="IconSize.Sm" />
                        <span>@Loc["TmPdfAnnotator_HighlightSelection"]</span>
                    </button>
                }
            </SelectionCtaContent>
        </TmPdfViewer>
    </div>;

    /// <summary>The toolbar end (the export group and the panel toggle) injected into the merged
    /// viewer toolbar on desktop and tablet.</summary>
    private RenderFragment ToolbarEndFragment => @<div class="tm-pdf-annotator__toolbar-end">
        @if (AllowExport && !ShowHeader)
        {
            @ExportGroup
        }
        @PanelToggleButton
    </div>;

    /// <summary>
    /// FZE-14: the annotator's per-page overlay for <see cref="PdfViewMode.Continuous"/> —
    /// one marker layer plus one interaction surface per mounted page slot (FZE-13). The slot
    /// context carries the page number and the page's geometry box, so the pointer handlers
    /// normalize against THE page and every tool anchors on the slot's page — the annotator's
    /// current page is navigation state only. Null in SinglePage: the single-surface
    /// <c>OverlayContent</c> above owns that presentation unchanged.
    /// </summary>
    private RenderFragment<PdfPageOverlayContext>? ContinuousPageOverlay
        => _viewMode == PdfViewMode.Continuous ? ContinuousPageSurface : null;

    /// <summary>The per-page fragment: the layer paints only this page's threads, the active
    /// stroke and draft render in the page they belong to, and the surface normalizes its
    /// pointer offsets against the slot's geometry box. Builder code on purpose — a razor
    /// template cannot be written here (the compiler mis-binds the template's context), and
    /// the element styling is restored through the `::deep` scoped-CSS descendants (the
    /// slot renders inside the annotator root, which carries the scope attribute).</summary>
    private RenderFragment<PdfPageOverlayContext> ContinuousPageSurface => context => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "tm-pdf-annotator__page-surface-host");

        builder.OpenComponent<TmPdfAnnotatorLayer>(2);
        builder.AddAttribute(3, nameof(TmPdfAnnotatorLayer.Threads), _threads);
        builder.AddAttribute(4, nameof(TmPdfAnnotatorLayer.PageNumber), context.PageNumber);
        builder.AddAttribute(5, nameof(TmPdfAnnotatorLayer.SelectedThreadId), _selectedThreadId);
        builder.AddAttribute(6, nameof(TmPdfAnnotatorLayer.ShowResolved), _showResolved);
        builder.AddAttribute(7, nameof(TmPdfAnnotatorLayer.ColorResolver), _colorResolver);
        builder.AddAttribute(8, nameof(TmPdfAnnotatorLayer.Draft), _draft);
        builder.AddAttribute(9, nameof(TmPdfAnnotatorLayer.ActiveStroke),
            _activeStrokePage == context.PageNumber ? _activeStroke : null);
        builder.AddAttribute(10, nameof(TmPdfAnnotatorLayer.DraftColor), CurrentAuthorColor);
        builder.AddAttribute(11, nameof(TmPdfAnnotatorLayer.OnThreadSelected),
            EventCallback.Factory.Create<string>(this, SelectThreadAsync));
        builder.CloseComponent();

        builder.OpenElement(12, "div");
        builder.AddMultipleAttributes(13, PageSurfaceAttributes(context));
        builder.CloseElement();

        builder.CloseElement();
    };

    /// <summary>The per-page surface's attributes: the stable test id plus the page number,
    /// and the pointer handlers carrying the slot context (FZE-14). The Draw-only
    /// <c>touch-action: none</c> rides the class, so the other tools keep the native pan
    /// and pinch of the wrap beneath.</summary>
    private Dictionary<string, object> PageSurfaceAttributes(PdfPageOverlayContext page) => new()
    {
        ["class"] = PageSurfaceClass,
        ["data-testid"] = TestId("pdf-annotator-surface"),
        ["data-page"] = page.PageNumber.ToString(System.Globalization.CultureInfo.InvariantCulture),
        ["tabindex"] = "-1",
        ["onclick"] = EventCallback.Factory.Create<MouseEventArgs>(this, e => HandleSurfaceClickAsync(page, e)),
        ["onpointerdown"] = EventCallback.Factory.Create<PointerEventArgs>(this, e => HandlePointerDownAsync(page, e)),
        ["onpointerdown:preventDefault"] = true,
        ["onpointermove"] = EventCallback.Factory.Create<PointerEventArgs>(this, e => HandlePointerMoveAsync(page, e)),
        ["onpointerup"] = EventCallback.Factory.Create<PointerEventArgs>(this, e => HandlePointerUpAsync(page, e)),
        ["onpointercancel"] = EventCallback.Factory.Create<PointerEventArgs>(this, HandlePointerCancel),
        ["onpointerleave"] = EventCallback.Factory.Create<PointerEventArgs>(this, e => HandlePointerLeaveAsync(page, e)),
    };

    /// <summary>The interaction surface classes — the same rule as the single-page surface:
    /// active for the click/draw tools, <c>touch-action: none</c> in Draw only (the other
    /// tools keep the native pan and pinch of the wrap beneath).</summary>
    private string PageSurfaceClass
        => $"tm-pdf-annotator__surface {(SurfaceActive ? "tm-pdf-annotator__surface--active" : "")} {(_mode == PdfAnnotatorMode.Draw ? "tm-pdf-annotator__surface--draw" : "")}";

    /// <summary>
    /// The annotator's thread panel: the shell's docked Right region on desktop and tablet, the
    /// shell's non-modal bottom sheet on mobile (where the sheet header owns the title and the
    /// close button, so the panel drops its own chrome).
    /// </summary>
    private RenderFragment PanelSlot => @<TmPdfAnnotatorPanel Threads="_threads"
                                 SelectedThreadId="@_selectedThreadId"
                                 SelectedThreadIdChanged="SelectThreadAsync"
                                 CurrentUserId="@(CurrentUser?.UserId)"
                                 ShowResolved="_showResolved"
                                 ShowResolvedChanged="SetShowResolvedAsync"
                                 ColorResolver="_colorResolver"
                                 Draft="_draft"
                                 DraftColor="@CurrentAuthorColor"
                                 ShowChrome="@(!IsMobileLayout)"
                                 OnCreateRequested="CreateFromDraftAsync"
                                 OnDraftDismissed="DismissDraftAsync"
                                 OnReplyRequested="ReplyToThreadAsync"
                                 OnEditRequested="EditCommentAsync"
                                 OnResolveRequested="ResolveThreadAsync"
                                 OnReopenRequested="ReopenThreadAsync"
                                 OnDeleteRequested="DeleteCommentAsync"
                                 OnCloseRequested="ClosePanelAsync" />;

    /// <summary>
    /// The G2 mobile tool palette: a horizontally scrollable track of 44px tiles (the two
    /// light-edit tools plus the color picker tile — FZE-12: the color decides how a new
    /// comment marker renders too) followed by the localized hint that the editing tools
    /// need a larger screen. The hint rides at the end of the palette so it never pushes the
    /// tiles away.
    /// </summary>
    private RenderFragment MobilePalette => @<div class="tm-pdf-annotator__palette"
                                                  role="group"
                                                  aria-label="@Loc["TmPdfAnnotator_ToolsGroup"]"
                                                  data-testid="@TestId("pdf-annotator-palette")">
        <div class="tm-pdf-annotator__palette-track">
            <button type="button"
                    class="@PaletteTileClass(PdfAnnotatorMode.Browse)"
                    aria-pressed="@(_mode == PdfAnnotatorMode.Browse ? "true" : "false")"
                    data-testid="@TestId("pdf-annotator-mode-browse")"
                    @onclick="() => SetModeAsync(PdfAnnotatorMode.Browse)">
                <TmIcon Name="mouse-pointer" Size="IconSize.Sm" />
                <span class="tm-pdf-annotator__tile-text">@Loc["TmPdfAnnotator_ModeBrowse"]</span>
            </button>
            <button type="button"
                    class="@PaletteTileClass(PdfAnnotatorMode.Comment)"
                    aria-pressed="@(_mode == PdfAnnotatorMode.Comment ? "true" : "false")"
                    data-testid="@TestId("pdf-annotator-mode-comment")"
                    @onclick="() => SetModeAsync(PdfAnnotatorMode.Comment)">
                <TmIcon Name="message-square" Size="IconSize.Sm" />
                <span class="tm-pdf-annotator__tile-text">@Loc["TmPdfAnnotator_ModeComment"]</span>
            </button>
            @if (AllowColorPicker)
            {
                @* FZE-12: the color makes sense for comments too (it decides how the new
                   marker renders), so the picker tile rides the Browse/Add-comment row. *@
                <button type="button"
                        class="tm-pdf-annotator__tile"
                        aria-haspopup="dialog"
                        aria-expanded="@(_colorPickerOpen ? "true" : "false")"
                        aria-label="@ColorTriggerAriaLabel"
                        data-testid="@TestId("pdf-annotator-color-tile")"
                        @ref="_colorTileRef"
                        @onclick="OpenMobileColorPickerAsync">
                    <span class="tm-pdf-annotator__tile-swatch"
                          style="background:@CurrentAuthorColor"
                          aria-hidden="true"></span>
                    <span class="tm-pdf-annotator__tile-text">@Loc["TmPdfAnnotator_ColorLabel"]</span>
                </button>
            }
        </div>
        <span class="tm-pdf-annotator__palette-hint">@Loc["TmPdfAnnotator_EditOnLargerScreen"]</span>
    </div>;

    /// <summary>
    /// The shared color palette (FZE-12): the core <see cref="TmColorPalette"/> plus the reset
    /// action, presented through the overlay panel — an anchored popover on desktop and tablet,
    /// the F3 bottom sheet on a mobile layout. Rendered once at the annotator root; the anchor
    /// is whichever control opened it (the toolbar trigger button or the mobile palette tile).
    /// </summary>
    private RenderFragment ColorPickerPanel => @<TmOverlayPanel Anchor="@_colorAnchor"
                                 IsOpen="_colorPickerOpen"
                                 IsOpenChanged="HandleColorPickerOpenChangedAsync"
                                 Placement="OverlayPlacement.Bottom"
                                 Align="OverlayAlign.Start"
                                 Offset="4"
                                 Role="dialog"
                                 AriaLabel="@Loc["TmPdfAnnotator_ChooseColor"]"
                                 LayoutMode="@_resolved"
                                 MobilePresentation="PanelPresentation.Auto"
                                 Class="tm-pdf-annotator__color-panel">
        @* FZE-12: the display Value is the chip color (the picked color or the per-author/role
           fallback) — the active swatch is checked even while no explicit color is picked.
           Selecting that checked swatch is a no-op (HandleColorPickedAsync keeps the implicit
           resolution); the reset action is disabled while the author color is already shown. *@
        <TmColorPalette Value="@CurrentAuthorColor"
                        ValueChanged="HandleColorPickedAsync"
                        Colors="@EffectiveColorPalette"
                        ColorNames="@_effectiveColorNames"
                        ShowClearButton="false" />
        <button type="button"
                class="tm-pdf-annotator__color-reset"
                data-testid="@TestId("pdf-annotator-color-reset")"
                disabled="@(_annotationColor is null)"
                @onclick="ResetColorAsync">
            @Loc["TmPdfAnnotator_ResetColor"]
        </button>
    </TmOverlayPanel>;
}
