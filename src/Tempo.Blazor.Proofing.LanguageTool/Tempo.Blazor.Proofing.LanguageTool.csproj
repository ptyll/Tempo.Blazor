<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Tempo.Blazor.Proofing.LanguageTool</PackageId>
    <Version>2.8.17</Version>
    <Title>Tempo.Blazor.Proofing.LanguageTool</Title>
    <Description>Reference LanguageTool proofing provider (ITempoProofingProvider) for the Tempo.Blazor document editor, including Czech spellcheck support against a self-hosted LanguageTool server.</Description>
    <Authors>Tempo</Authors>
    <PackageTags>blazor;documents;proofing;spellcheck;languagetool;document-editor</PackageTags>
    <RepositoryUrl>https://github.com/tempo/tempo-blazor</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tempo.Blazor.Abstractions\Tempo.Blazor.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
  </ItemGroup>
</Project>
