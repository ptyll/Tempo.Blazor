<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Tempo.Blazor.DocumentFormats</PackageId>
    <Version>2.8.22</Version>
    <Title>Tempo.Blazor.DocumentFormats</Title>
    <Description>Optional server-side DOCX and ODT import/export support for TmDocumentEditor.</Description>
    <Authors>Tempo</Authors>
    <PackageTags>blazor;documents;docx;odt;openxml;document-editor</PackageTags>
    <RepositoryUrl>https://github.com/tempo/tempo-blazor</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="Jint" Version="4.13.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tempo.Blazor.Abstractions\Tempo.Blazor.Abstractions.csproj" />
    <ProjectReference Include="..\Tempo.Reporting.Engine\Tempo.Reporting.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Headless layout bundle: the canvas layout chain compiled to one ESM file by
         `npm run build:document-editor` (scripts/build-document-editor.mjs). -->
    <EmbeddedResource Include="HeadlessLayout\tempo-document-headless-layout.bundle.mjs"
                      LogicalName="Tempo.Blazor.DocumentFormats.HeadlessLayout.tempo-document-headless-layout.bundle.mjs" />
  </ItemGroup>

  <!-- Drift gate: fail the build when the embedded bundle no longer matches the .mjs sources.
       Runs only where the Node toolchain is installed (dev/CI after `npm install`); incremental
       via a stamp so it re-checks only after a source or artifact change. -->
  <PropertyGroup>
    <TempoRepoRoot>$(MSBuildThisFileDirectory)..\..\</TempoRepoRoot>
  </PropertyGroup>
  <ItemGroup>
    <TempoHeadlessBundleInput Include="$(TempoRepoRoot)src\Tempo.Blazor.DocumentEditor\wwwroot\js\document-editor\**\*.mjs" />
    <TempoHeadlessBundleInput Include="$(TempoRepoRoot)src\Tempo.Blazor.DocumentEditor\wwwroot\js\document-editor-canvas\**\*.mjs" />
    <TempoHeadlessBundleInput Include="$(TempoRepoRoot)scripts\build-document-editor.mjs" />
    <TempoHeadlessBundleInput Include="HeadlessLayout\tempo-document-headless-layout.bundle.mjs" />
  </ItemGroup>
  <Target Name="TempoVerifyHeadlessLayoutBundle"
          BeforeTargets="CoreCompile"
          Condition="Exists('$(TempoRepoRoot)node_modules\esbuild')"
          Inputs="@(TempoHeadlessBundleInput)"
          Outputs="$(IntermediateOutputPath)tempo-headless-layout-bundle.check.stamp">
    <Exec Command="node scripts/build-document-editor.mjs --check"
          WorkingDirectory="$(TempoRepoRoot)" />
    <Touch Files="$(IntermediateOutputPath)tempo-headless-layout-bundle.check.stamp" AlwaysCreate="true" />
  </Target>
</Project>
