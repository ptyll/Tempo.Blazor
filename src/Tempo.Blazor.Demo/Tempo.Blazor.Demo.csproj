<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- EarlyCulture reads localStorage through [JSImport] before the host builds, which needs this. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tempo.Blazor\Tempo.Blazor.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.Codes\Tempo.Blazor.Codes.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.DiagramEditor\Tempo.Blazor.DiagramEditor.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.DocumentEditor\Tempo.Blazor.DocumentEditor.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.DataTableXlsx\Tempo.Blazor.DataTableXlsx.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.FluentValidation\Tempo.Blazor.FluentValidation.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.GanttXlsx\Tempo.Blazor.GanttXlsx.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.Modeling\Tempo.Blazor.Modeling.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.NotionEditor\Tempo.Blazor.NotionEditor.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.PdfViewer\Tempo.Blazor.PdfViewer.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.Signing\Tempo.Blazor.Signing.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.Spreadsheet\Tempo.Blazor.Spreadsheet.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.Wireframe\Tempo.Blazor.Wireframe.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.Demo.Shared\Tempo.Blazor.Demo.Shared.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.Demo.SharedUI\Tempo.Blazor.Demo.SharedUI.csproj" />
  </ItemGroup>

  <!-- Link shared UI components from SharedUI project -->
  <ItemGroup>
    <Compile Remove="Services\**" />
    <Compile Remove="Validators\**" />
    <Compile Remove="Layout\**" />
    <Compile Remove="Pages\**" />
    <Content Remove="Services\**" />
    <Content Remove="Validators\**" />
    <Content Remove="Layout\**" />
    <Content Remove="Pages\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.3" />
  </ItemGroup>

</Project>
