@namespace Tempo.Blazor.Components.AI
@inherits Tempo.Blazor.Components.TmComponentBase
@using System.Globalization
@using Tempo.Blazor.AI.Models
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Components.Inputs

@* The agents' branches as one file × agent grid.

   The rows come from ConflictMatrix, never from the markup: the conflicts, their order and their directory groups are
   COMPUTED, so the summary, the "Conflict" badge and the order of the rows cannot disagree with each other.

   Every cell names its change with an icon AND a word; an untouched file is an em dash plus the spoken words "No
   change", never an empty box a reader has to interpret. A conflicting file grows its own side choice (a native radio
   group per file, so the browser's arrow keys apply) and the merge action stays disabled until every conflict is
   decided.

   The whole grid is a NATIVE <table> with no explicit ARIA roles: a header cell per agent (name and branch), a
   <th scope="rowgroup"> per directory and a <th scope="row"> per file, plus a resolution row whose cell names that
   header through `headers`. The roles a table already carries (row/columnheader/rowheader/cell) are NOT re-declared,
   because `role="grid"` on a table with no roving tabindex and no arrow-key model makes NVDA/JAWS switch to focus
   mode, swallow the table reading commands and expect keys this surface does not handle. Exactly ONE polite live
   region announces a resolution, a merge, the filter and a collapsed directory. *@
<section class="@RootClass"
         data-testid="@RootTestId("conflict-radar")"
         data-conflicts="@Count(Matrix.ConflictCount)"
         data-agents="@Count(Matrix.ColumnCount)"
         data-rows="@Count(Matrix.RowCount)"
         data-conflict-only="@(_conflictOnly ? "true" : "false")"
         @attributes="AdditionalAttributes">

    <div class="tm-ai-radar__header">
        @if (ShowTitle)
        {
            @SurfaceTitle
        }

        <p class="tm-ai-radar__summary" data-testid="@TestId("radar-summary")">@SummaryText</p>

        <div class="tm-ai-radar__filter">
            <TmToggle Value="_conflictOnly"
                      Label="@Loc["TmConflictRadar_ConflictsOnly"]"
                      ValueChanged="OnConflictOnlyChangedAsync"
                      data-testid="@TestId("radar-conflicts-only")" />
        </div>

        <button type="button"
                class="tm-ai-radar__merge"
                data-testid="@TestId("radar-merge")"
                disabled="@(!CanMerge)"
                aria-describedby="@MergeHintId"
                @onclick="OnMergeAsync">
            <span class="tm-ai-radar__merge-icon" aria-hidden="true">
                <TmIcon Name="@IconNames.GitCompare" Size="IconSize.Sm" />
            </span>
            <span class="tm-ai-radar__merge-text">@Loc["TmConflictRadar_Merge"]</span>
        </button>
    </div>

    <p class="tm-ai-radar__instructions" id="@InstructionsId" data-testid="@TestId("radar-instructions")">
        @Loc["TmConflictRadar_Instructions"]
    </p>

    <p class="tm-ai-radar__merge-hint" id="@MergeHintId" data-testid="@TestId("radar-merge-hint")">@MergeHint</p>

    @if (Matrix.IsEmpty)
    {
        <p class="tm-ai-radar__empty" data-testid="@TestId("radar-empty")">@Loc["TmConflictRadar_Empty"]</p>
    }
    else if (ShowFilteredEmpty)
    {
        <p class="tm-ai-radar__empty" data-testid="@TestId("radar-empty")">@Loc["TmConflictRadar_EmptyConflicts"]</p>
    }
    else
    {
        <div class="tm-ai-radar__grid-wrap" data-testid="@TestId("radar-grid-wrap")">
            <table class="tm-ai-radar__grid"
                   aria-label="@EffectiveLabel"
                   aria-describedby="@InstructionsId"
                   data-testid="@TestId("conflict-radar-grid")">
                <thead>
                    <tr class="tm-ai-radar__head-row">
                        <th scope="col" class="tm-ai-radar__cell tm-ai-radar__cell--file">
                            <span class="tm-sr-only">@Loc["TmConflictRadar_FileColumn"]</span>
                        </th>
                        @foreach (var column in Matrix.Columns)
                        {
                            <th scope="col"
                                class="tm-ai-radar__cell tm-ai-radar__cell--agent"
                                data-testid="@TestId("radar-agent-header")"
                                data-agent-id="@column.Agent.Id">
                                <TmAgentBadge Agent="column.Agent"
                                              Size="AgentBadgeSize.Sm"
                                              ShowStatus="false" />
                                <span class="tm-ai-radar__branch" data-testid="@TestId("radar-branch")">
                                    @BranchText(column)
                                </span>
                            </th>
                        }
                    </tr>
                </thead>

                @foreach (var directory in Directories)
                {
                    var group = directory;
                    <tbody class="tm-ai-radar__group"
                           data-testid="@TestId("radar-directory")"
                           data-directory="@group.Directory"
                           data-collapsed="@(group.Collapsed ? "true" : "false")">
                        <tr class="tm-ai-radar__directory-row">
                            @* scope="rowgroup" heads the FILE ROWS below it (a column group would be wrong here),
                               and no role is declared so the header keeps its native semantics. *@
                            <th scope="rowgroup"
                                colspan="@Count(Matrix.ColumnCount + 1)"
                                class="tm-ai-radar__directory-cell">
                                <button type="button"
                                        class="tm-ai-radar__directory-toggle"
                                        data-testid="@TestId("radar-directory-toggle")"
                                        aria-expanded="@(group.Collapsed ? "false" : "true")"
                                        @onclick="() => ToggleDirectory(group.Directory)">
                                    <span class="tm-ai-radar__directory-icon" aria-hidden="true">
                                        <TmIcon Name="@(group.Collapsed ? IconNames.ChevronRight : IconNames.ChevronDown)"
                                                Size="IconSize.Sm" />
                                    </span>
                                    <span class="tm-ai-radar__directory-name">@DirectoryName(group.Directory)</span>
                                    <span class="tm-ai-radar__directory-meta">@DirectoryMeta(group)</span>
                                </button>
                            </th>
                        </tr>

                        @if (!group.Collapsed)
                        {
                            @foreach (var row in group.Rows)
                            {
                                var entry = row;
                                var conflicting = entry.IsConflict;
                                <tr class="@(conflicting ? "tm-ai-radar__row tm-ai-radar__row--conflict" : "tm-ai-radar__row")"
                                    data-testid="@TestId("radar-row")"
                                    data-path="@entry.Path"
                                    data-conflict="@(conflicting ? "true" : "false")">
                                    <th scope="row"
                                        id="@RowHeaderId(entry)"
                                        class="tm-ai-radar__cell tm-ai-radar__cell--file"
                                        data-testid="@TestId("radar-file")">
                                        <span class="tm-ai-radar__file-name">@entry.FileName</span>
                                        @if (!string.Equals(entry.Path, entry.FileName, StringComparison.Ordinal))
                                        {
                                            @* A file at the repository root would print its own name twice. *@
                                            <span class="tm-ai-radar__file-path">@entry.Path</span>
                                        }
                                        @if (conflicting)
                                        {
                                            <span class="tm-ai-radar__conflict" data-testid="@TestId("radar-row-conflict")">
                                                <span class="tm-ai-radar__conflict-icon" aria-hidden="true">
                                                    <TmIcon Name="@IconNames.AlertTriangle" Size="IconSize.Xs" />
                                                </span>
                                                <span class="tm-ai-radar__conflict-text">@Loc["TmConflictRadar_Conflict"]</span>
                                            </span>
                                        }
                                    </th>

                                    @foreach (var cell in entry.Cells)
                                    {
                                        var change = cell;
                                        <td class="tm-ai-radar__cell tm-ai-radar__cell--change"
                                            data-testid="@TestId("radar-cell")"
                                            data-agent-id="@(change?.Agent.Id)"
                                            data-kind="@(change is null ? "none" : KindSlug(change.Kind))">
                                            @if (change is null)
                                            {
                                                <span class="tm-ai-radar__none">
                                                    <span class="tm-ai-radar__none-mark" aria-hidden="true">—</span>
                                                    <span class="tm-sr-only">@Loc["TmConflictRadar_NoChange"]</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="tm-ai-radar__change tm-ai-radar__change--@KindSlug(change.Kind)">
                                                    <span class="tm-ai-radar__change-icon"
                                                          data-testid="@TestId("radar-cell-icon")"
                                                          aria-hidden="true">
                                                        <TmIcon Name="@KindIcon(change.Kind)" Size="IconSize.Xs" />
                                                    </span>
                                                    <span class="tm-ai-radar__change-kind">@KindText(change.Kind)</span>
                                                    @if (change.IsRename && change.PreviousPath is { } previous)
                                                    {
                                                        <span class="tm-ai-radar__change-from">
                                                            @Loc["TmConflictRadar_RenamedFrom", previous]
                                                        </span>
                                                    }
                                                </span>
                                            }
                                        </td>
                                    }
                                </tr>

                                @if (conflicting)
                                {
                                    <tr class="tm-ai-radar__row tm-ai-radar__row--resolution">
                                        @* An anonymous row would be read as unrelated to the file above it: the
                                           cell names that file's row header through `headers`. *@
                                        <td class="tm-ai-radar__resolution-cell"
                                            headers="@RowHeaderId(entry)"
                                            colspan="@Count(Matrix.ColumnCount + 1)">
                                            <div class="tm-ai-radar__sides"
                                                 role="radiogroup"
                                                 aria-label="@ResolveLabel(entry)"
                                                 @key="(entry.Path, RadioVersion)">
                                                @foreach (var side in entry.Changed)
                                                {
                                                    var option = side;
                                                    <label class="tm-ai-radar__side">
                                                        <input type="radio"
                                                               class="tm-ai-radar__side-input"
                                                               name="@RadioGroupName(entry)"
                                                               data-side="@option.Agent.Id"
                                                               checked="@IsAgentSide(entry, option.Agent.Id)"
                                                               @onchange="() => OnSideChosenAsync(entry, ConflictResolutionKind.Agent, option.Agent.Id)" />
                                                        <span class="tm-ai-radar__side-text">@AgentName(option.Agent)</span>
                                                    </label>
                                                }
                                                <label class="tm-ai-radar__side">
                                                    <input type="radio"
                                                           class="tm-ai-radar__side-input"
                                                           name="@RadioGroupName(entry)"
                                                           data-side="manual"
                                                           checked="@IsManualSide(entry)"
                                                           @onchange="() => OnSideChosenAsync(entry, ConflictResolutionKind.Manual, null)" />
                                                    <span class="tm-ai-radar__side-text">@Loc["TmConflictRadar_ManualSide"]</span>
                                                </label>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                }
            </table>
        </div>
    }

    <p class="tm-sr-only" aria-live="polite" data-testid="@TestId("radar-announcement")">@_announcement</p>
</section>
