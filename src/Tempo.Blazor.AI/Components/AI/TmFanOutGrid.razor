@namespace Tempo.Blazor.Components.AI
@inherits Tempo.Blazor.Components.TmComponentBase
@using System.Globalization
@using Tempo.Blazor.AI.Models
@using Tempo.Blazor.Components.Icons

@* An orchestrator splitting one job across N workers: a tile per unit of work with its state, its attempts and its
   countdown, a summary above the grid that says how much finished, what it cost and when the whole fan-out should be
   over, and a detail card that follows the focused (or hovered) tile and carries the retry / cancel actions.

   The grid is an APG grid: ONE tab stop (a roving tabindex), the arrow keys walking the tiles in reading order,
   Home/End inside a row and Ctrl+Home/Ctrl+End across the whole grid. A state is painted as an icon, a WORD and a tone
   — never as a colour alone. Hundreds of tasks mount a bounded window while the grid still declares its full
   aria-rowcount, so the geometry a screen reader reads stays honest.

   ONE polite live region announces a filter change, a moved focus after a filter, and a retry / cancel request;
   everything else is carried by the buttons themselves. *@
<section class="@RootClass"
         data-testid="@RootTestId("fan-out")"
         data-filter="@FilterSlug"
         data-columns="@EffectiveColumns.ToString(CultureInfo.InvariantCulture)"
         data-compact="@(Compact ? "true" : null)"
         style="--tm-fan-out-columns: @EffectiveColumns.ToString(CultureInfo.InvariantCulture)"
         @attributes="AdditionalAttributes">

    <div class="tm-ai-fan-out__header">
        @if (ShowTitle)
        {
            @Heading
        }

        @if (ShowSummary)
        {
            @* The roll-up sits in a named group (a dl may not be named) so a reader can jump straight to it. *@
            <div class="tm-ai-fan-out__summary"
                 role="group"
                 aria-label="@Loc["TmFanOutGrid_SummaryLabel"]"
                 data-testid="@TestId("fan-out-summary")">
                <dl class="tm-ai-fan-out__stats">
                    <div class="tm-ai-fan-out__stat">
                        <dt class="tm-ai-fan-out__stat-label">@Loc["TmFanOutGrid_SummaryDone"]</dt>
                        <dd class="tm-ai-fan-out__stat-value"
                            data-testid="@TestId("fan-out-summary-succeeded")">@SummaryData.Succeeded</dd>
                    </div>
                    <div class="tm-ai-fan-out__stat">
                        <dt class="tm-ai-fan-out__stat-label">@Loc["TmFanOutGrid_SummaryRunning"]</dt>
                        <dd class="tm-ai-fan-out__stat-value"
                            data-testid="@TestId("fan-out-summary-running")">@SummaryData.Running</dd>
                    </div>
                    <div class="tm-ai-fan-out__stat">
                        <dt class="tm-ai-fan-out__stat-label">@Loc["TmFanOutGrid_SummaryFailed"]</dt>
                        <dd class="tm-ai-fan-out__stat-value"
                            data-testid="@TestId("fan-out-summary-failed")">@SummaryData.Failed</dd>
                    </div>
                    <div class="tm-ai-fan-out__stat">
                        <dt class="tm-ai-fan-out__stat-label">@Loc["TmFanOutGrid_SummaryTasks"]</dt>
                        <dd class="tm-ai-fan-out__stat-value"
                            data-testid="@TestId("fan-out-summary-tasks")">@TasksText</dd>
                    </div>
                    @if (SummaryData.HasCost)
                    {
                        <div class="tm-ai-fan-out__stat">
                            <dt class="tm-ai-fan-out__stat-label">@Loc["TmFanOutGrid_SummaryCost"]</dt>
                            <dd class="tm-ai-fan-out__stat-value"
                                data-testid="@TestId("fan-out-summary-cost")">@CostText</dd>
                        </div>
                    }
                    <div class="tm-ai-fan-out__stat">
                        <dt class="tm-ai-fan-out__stat-label">@Loc["TmFanOutGrid_SummaryEndsIn"]</dt>
                        <dd class="tm-ai-fan-out__stat-value"
                            data-testid="@TestId("fan-out-summary-eta")">@EtaText</dd>
                    </div>
                </dl>
            </div>
        }
    </div>

    <p class="tm-sr-only" id="@InstructionsId" data-testid="@TestId("fan-out-instructions")">@Loc["TmFanOutGrid_Instructions"]</p>

    @if (ShowFilter)
    {
        <div class="tm-ai-fan-out__filters"
             role="group"
             aria-label="@Loc["TmFanOutGrid_FilterLabel"]"
             data-testid="@TestId("fan-out-filters")">
            @foreach (var filter in FanOutPresentation.Filters)
            {
                <button type="button"
                        class="@FilterClass(filter)"
                        aria-pressed="@(filter == _filter ? "true" : "false")"
                        aria-label="@Loc["TmFanOutGrid_FilterAriaLabel", FilterText(filter) ?? string.Empty, FilterCount(filter)]"
                        data-filter="@FanOutPresentation.Slug(filter)"
                        data-testid="@TestId("fan-out-filter")"
                        @onclick="() => SetFilterAsync(filter)">
                    <span class="tm-ai-fan-out__filter-label">@FilterText(filter)</span>
                    <span class="tm-ai-fan-out__filter-count" aria-hidden="true">@FilterCount(filter)</span>
                </button>
            }
        </div>
    }

    @if (TaskList.Count == 0)
    {
        <p class="tm-ai-fan-out__empty" data-testid="@TestId("fan-out-empty")">@Loc["TmFanOutGrid_Empty"]</p>
    }
    else if (VisibleTasks.Count == 0)
    {
        <p class="tm-ai-fan-out__empty" data-testid="@TestId("fan-out-empty")">@Loc["TmFanOutGrid_EmptyFiltered"]</p>
    }
    else
    {
        <div class="tm-ai-fan-out__grid"
             role="grid"
             aria-label="@Loc["TmFanOutGrid_GridLabel"]"
             aria-describedby="@InstructionsId"
             aria-rowcount="@RowCount.ToString(CultureInfo.InvariantCulture)"
             aria-colcount="@EffectiveColumns.ToString(CultureInfo.InvariantCulture)"
             data-testid="@TestId("fan-out-grid-body")">
            @foreach (var row in Rows)
            {
                <div class="tm-ai-fan-out__row"
                     role="row"
                     aria-rowindex="@row.Index.ToString(CultureInfo.InvariantCulture)"
                     data-testid="@TestId("fan-out-row")"
                     @key="row.Index">
                    @foreach (var cell in row.Cells)
                    {
                        var task = cell.Task;
                        var handle = HandleFor(task.Id);
                        <div class="tm-ai-fan-out__cell"
                             role="gridcell"
                             aria-colindex="@cell.Column.ToString(CultureInfo.InvariantCulture)"
                             data-testid="@TestId("fan-out-cell")">
                            @* A native button per tile: native Enter/Space activation (no emulation), a real focus
                               ring and a 44 px coarse target, with the roving tabindex making the whole grid ONE tab
                               stop. *@
                            <button type="button"
                                    class="@TileClass(task)"
                                    tabindex="@(IsActive(task.Id) ? "0" : "-1")"
                                    aria-label="@TileAriaLabel(task)"
                                    title="@TileTitle(task)"
                                    data-task-id="@task.Id"
                                    data-status="@AgentStatusPresentation.Tone(task.Status)"
                                    data-testid="@TestId("fan-out-tile")"
                                    @ref="handle.Ref"
                                    @onclick="() => OnTilePinnedAsync(task.Id)"
                                    @onfocus="() => OnTileFocused(task.Id)"
                                    @onmouseover="() => OnTileHovered(task.Id)"
                                    @onkeydown="args => OnTileKeyDownAsync(task, args)">
                                <span class="tm-ai-fan-out__tile-avatar"
                                      style="@AvatarStyle(task)"
                                      aria-hidden="true">
                                    <span class="tm-ai-fan-out__tile-initials">@task.Initials</span>
                                </span>
                                <span class="tm-ai-fan-out__tile-text">
                                    <span class="tm-ai-fan-out__tile-label">@TileLabel(task)</span>
                                    <span class="tm-ai-fan-out__tile-meta">
                                        <span class="tm-ai-fan-out__tile-state">
                                            <span class="tm-ai-fan-out__tile-state-icon" aria-hidden="true">
                                                <TmIcon Name="@AgentStatusPresentation.Icon(task.Status)" Size="IconSize.Xs" />
                                            </span>
                                            <span class="tm-ai-fan-out__tile-state-text">@AgentStatusPresentation.Text(Loc, task.Status)</span>
                                        </span>
                                        @if (BadgeText(task) is { } badge)
                                        {
                                            <span class="tm-ai-fan-out__badge">@badge</span>
                                        }
                                        @if (!Compact && EtaOf(task) is { } eta)
                                        {
                                            <span class="tm-ai-fan-out__tile-eta">@eta</span>
                                        }
                                        @if (!Compact && task.HasWorker)
                                        {
                                            <span class="tm-ai-fan-out__tile-worker">@task.WorkerName</span>
                                        }
                                    </span>
                                </span>
                            </button>
                        </div>
                    }
                </div>
            }
        </div>

        @if (IsWindowed)
        {
            <p class="tm-sr-only" data-testid="@TestId("fan-out-window")">
                @Loc["TmFanOutGrid_Window",
                    (WindowStart + 1).ToString(CultureInfo.CurrentCulture),
                    (WindowStart + WindowCount).ToString(CultureInfo.CurrentCulture),
                    VisibleTasks.Count.ToString(CultureInfo.CurrentCulture)]
            </p>
        }
    }

    @if (DetailTask is { } detail)
    {
        <div class="tm-ai-fan-out__detail"
             role="region"
             aria-label="@Loc["TmFanOutGrid_Detail"]"
             data-testid="@TestId("fan-out-detail")"
             data-task-id="@detail.Id">
            <div class="tm-ai-fan-out__detail-head">
                @DetailTitle(detail)
                <span class="tm-ai-fan-out__detail-state" data-status="@AgentStatusPresentation.Tone(detail.Status)">
                    <span class="tm-ai-fan-out__detail-state-icon" aria-hidden="true">
                        <TmIcon Name="@AgentStatusPresentation.Icon(detail.Status)" Size="IconSize.Sm" />
                    </span>
                    <span class="tm-ai-fan-out__detail-state-text">@AgentStatusPresentation.Text(Loc, detail.Status)</span>
                </span>
            </div>

            <dl class="tm-ai-fan-out__detail-facts">
                @if (detail.HasWorker)
                {
                    <dt>@Loc["TmFanOutGrid_DetailWorker"]</dt>
                    <dd data-testid="@TestId("fan-out-detail-worker")">@detail.WorkerName</dd>
                }
                <dt>@Loc["TmFanOutGrid_DetailAttempt"]</dt>
                <dd data-testid="@TestId("fan-out-detail-attempt")">@AttemptText(detail)</dd>
                @if (detail.StartedAt is { } started)
                {
                    <dt>@Loc["TmFanOutGrid_DetailStarted"]</dt>
                    <dd data-testid="@TestId("fan-out-detail-started")">@TimeText(started)</dd>
                }
                @if (detail.EstimatedEndAt is { } ends && detail.IsActive)
                {
                    <dt>@Loc["TmFanOutGrid_DetailEnds"]</dt>
                    <dd data-testid="@TestId("fan-out-detail-ends")">@TimeText(ends)</dd>
                }
                @if (detail.HasCost)
                {
                    <dt>@Loc["TmFanOutGrid_DetailCost"]</dt>
                    <dd data-testid="@TestId("fan-out-detail-cost")">@FormatCost(detail.CostMicroUnits!.Value)</dd>
                }
                @if (detail.HasError)
                {
                    <dt>@Loc["TmFanOutGrid_DetailError"]</dt>
                    <dd class="tm-ai-fan-out__detail-error"
                        data-testid="@TestId("fan-out-detail-error")">@detail.Error</dd>
                }
            </dl>

            @if (detail.CanRetry || detail.CanCancel)
            {
                <div class="tm-ai-fan-out__detail-actions">
                    @if (detail.CanRetry)
                    {
                        <button type="button"
                                class="tm-ai-fan-out__action"
                                data-testid="@TestId("fan-out-detail-retry")"
                                @onclick="() => RetryAsync(detail)">@Loc["TmFanOutGrid_Retry"]</button>
                    }
                    @if (detail.CanCancel)
                    {
                        <button type="button"
                                class="tm-ai-fan-out__action tm-ai-fan-out__action--danger"
                                data-testid="@TestId("fan-out-detail-cancel")"
                                @onclick="() => CancelAsync(detail)">@Loc["TmFanOutGrid_Cancel"]</button>
                    }
                </div>
            }
        </div>
    }

    <div class="tm-sr-only"
         role="status"
         aria-live="polite"
         aria-atomic="true"
         data-testid="@TestId("fan-out-announcement")">@_announcement</div>
</section>

@code {
    /// <summary>The heading, built at the requested level without duplicating the markup six times.</summary>
    private RenderFragment Heading => builder =>
    {
        builder.OpenElement(0, "h" + EffectiveHeadingLevel.ToString(CultureInfo.InvariantCulture));
        builder.AddAttribute(1, "class", "tm-ai-fan-out__title");
        builder.AddAttribute(2, "id", TitleId);
        builder.AddAttribute(3, "data-testid", TestId("fan-out-title"));
        builder.AddContent(4, HeadingText);
        builder.CloseElement();
    };

    /// <summary>
    /// The detail card's title, built at <see cref="DetailHeadingLevel"/> — one level below the surface heading and
    /// capped at h6 — so the card is a section of the surface instead of a heading level that skips.
    /// </summary>
    private RenderFragment DetailTitle(FanOutTask task) => builder =>
    {
        builder.OpenElement(0, "h" + DetailHeadingLevel.ToString(CultureInfo.InvariantCulture));
        builder.AddAttribute(1, "class", "tm-ai-fan-out__detail-title");
        builder.AddAttribute(2, "data-testid", TestId("fan-out-detail-title"));
        builder.AddContent(3, TileLabel(task));
        builder.CloseElement();
    };
}
