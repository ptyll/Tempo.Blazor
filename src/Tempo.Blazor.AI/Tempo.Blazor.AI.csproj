<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Tempo.Blazor</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Tempo.Blazor.AI</PackageId>
    <Version>2.11.0</Version>
    <Authors>ptyll</Authors>
    <Title>Tempo.Blazor.AI</Title>
    <Description>AI conversation components for Tempo.Blazor: a safe Markdig markdown view, messages with citations and feedback, a streaming conversation container, a composer and tool-call/reasoning panels. Generic contracts live in Tempo.Blazor.Abstractions, so no LLM SDK is referenced.</Description>
    <PackageTags>blazor;components;ai;llm;chat;streaming;markdown</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ptyll/Tempo.Blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ptyll/Tempo.Blazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Markdown processor for the AI package's safe markdown pipeline (Markdig, BSD-2-Clause,
         pure managed, IsTrimmable); trim warnings verified in the WASM publish of plan 7f21f26b
         Fáze 7. Never reference an LLM SDK or PromptHelper. -->
    <PackageReference Include="Markdig" Version="1.5.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.12" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tempo.Blazor\Tempo.Blazor.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.Abstractions\Tempo.Blazor.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Tempo.Blazor.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Keep the node test suites out of the NuGet package (the pattern every other JS-shipping
       package declares): without it wwwroot/js/__tests__/*.test.mjs would be packed as static web
       assets and published to consumers as _content/Tempo.Blazor.AI/js/__tests__/. -->
  <ItemGroup>
    <Content Remove="wwwroot\js\**\*.test.mjs" />
    <Content Remove="wwwroot\js\**\__tests__\**" />
    <Content Remove="wwwroot\js\**\*.md" />
    <None Include="wwwroot\js\**\*.test.mjs" Pack="false" Visible="false" />
    <None Include="wwwroot\js\**\__tests__\**" Pack="false" Visible="false" />
    <None Include="wwwroot\js\**\*.md" Pack="false" Visible="false" />
  </ItemGroup>

</Project>
