@namespace Tempo.Blazor.Components.Diagram
@using Tempo.Blazor.Models
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="tm-diagram-arrow-select @Class" style="position:relative;width:100%;display:block;" @onfocusout="OnFocusOut" @onfocusin="OnFocusIn">
    <button type="button"
            class="tm-diagram-arrow-select__trigger"
            style="display:flex;align-items:center;gap:6px;width:100%;min-height:34px;padding:5px 10px;background:#ffffff;border:1px solid #d1d5db;border-radius:6px;font-size:13px;color:#111827;cursor:pointer;text-align:left;box-sizing:border-box;"
            @onclick="Toggle"
            @onclick:stopPropagation="true">
        <span style="flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;width:28px;height:20px;">
            @((MarkupString)GetPreviewSvg(Value))
        </span>
        <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">
            @GetLabel(Value)
        </span>
        <svg style="flex-shrink:0;width:14px;height:14px;color:#6b7280;@(_isOpen ? "transform:rotate(180deg);" : "")transition:transform 150ms ease;"
             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9" />
        </svg>
    </button>
    @if (_isOpen)
    {
        <div id="@_menuId"
             style="position:absolute;top:calc(100% + 3px);left:0;right:0;z-index:var(--tm-z-popover);background:#ffffff;border:1px solid #d1d5db;border-radius:6px;box-shadow:0 10px 28px rgba(0,0,0,0.15);max-height:260px;overflow-y:auto;padding:4px 0;min-width:180px;"
             role="listbox"
             tabindex="-1">
            @for (int i = 0; i < (Options?.Count ?? 0); i++)
            {
                var idx = i;
                var opt = Options![i];
                <button type="button"
                        id="@(_menuId)-opt-@idx"
                        style="@GetOptionStyle(opt, idx == _focusedIndex)"
                        role="option"
                        @onclick="() => SelectAsync(opt.Value)">
                    <span style="flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;width:28px;height:20px;">
                        @((MarkupString)GetPreviewSvg(opt.Value))
                    </span>
                    <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">
                        @opt.Label
                    </span>
                </button>
            }
        </div>
    }
</div>

@code {
    /// <summary>Selected option value (arrowhead or dash pattern id).</summary>
    [Parameter] public string? Value { get; set; }
    /// <summary>Raised when the user picks another option.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    /// <summary>Options to choose from; each label is shown next to its preview.</summary>
    [Parameter] public IReadOnlyList<SelectOption<string>>? Options { get; set; }
    /// <summary>Returns the inline SVG preview markup for an option value.</summary>
    [Parameter] public Func<string?, string>? PreviewRenderer { get; set; }
    /// <summary>Additional CSS class applied to the root.</summary>
    [Parameter] public string? Class { get; set; }

    private bool _isOpen;
    private int _focusedIndex = -1;
    private bool _isClosing;
    private bool _needsJsInit;
    private DotNetObjectReference<TmDiagramArrowSelect>? _dotNetRef;
    private readonly string _menuId = "tas-menu-" + Guid.NewGuid().ToString("N")[..6];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_needsJsInit && _isOpen)
        {
            _needsJsInit = false;
            await InitJsAsync();
        }
    }

    private int FindOptionIndex(string? searchValue)
    {
        if (Options is null || searchValue is null) return -1;
        for (int i = 0; i < Options.Count; i++)
            if (Options[i].Value == searchValue)
                return i;
        return -1;
    }

    private void Toggle()
    {
        if (_isOpen)
        {
            Close();
        }
        else
        {
            _isOpen = true;
            _needsJsInit = true;
            _focusedIndex = FindOptionIndex(Value);
            if (_focusedIndex < 0) _focusedIndex = 0;
        }
    }

    private async Task InitJsAsync()
    {
        try
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("tmDiagramArrowSelect.init", _menuId, _dotNetRef, _focusedIndex);
        }
        catch { }
    }

    private async Task DestroyJsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("tmDiagramArrowSelect.destroy", _menuId);
        }
        catch { }
    }

    private void Close()
    {
        _isOpen = false;
        _needsJsInit = false;
        _isClosing = false;
        _ = DestroyJsAsync();
    }

    private void OnFocusOut()
    {
        _isClosing = true;
        _ = Task.Run(async () =>
        {
            await Task.Delay(200);
            if (_isClosing)
            {
                _isClosing = false;
                await InvokeAsync(() => Close());
            }
        });
    }

    private void OnFocusIn() => _isClosing = false;

    [JSInvokable] public void OnArrowDown()
    {
        var count = Options?.Count ?? 0;
        if (count == 0) return;
        _focusedIndex = Math.Min(_focusedIndex + 1, count - 1);
        _ = ScrollToFocusedAsync();
        StateHasChanged();
    }

    [JSInvokable] public void OnArrowUp()
    {
        var count = Options?.Count ?? 0;
        if (count == 0) return;
        _focusedIndex = Math.Max(_focusedIndex - 1, 0);
        _ = ScrollToFocusedAsync();
        StateHasChanged();
    }

    [JSInvokable] public void OnEnter()
    {
        var count = Options?.Count ?? 0;
        if (_focusedIndex >= 0 && _focusedIndex < count)
        {
            _ = SelectAsync(Options![_focusedIndex].Value);
        }
    }

    [JSInvokable] public void OnEscape()
    {
        Close();
        StateHasChanged();
    }

    private async Task ScrollToFocusedAsync()
    {
        try { await JS.InvokeVoidAsync("tmDiagramArrowSelect.scrollToOption", _menuId, _focusedIndex); }
        catch { }
    }

    private async Task SelectAsync(string? selectedValue)
    {
        Value = selectedValue;
        Close();
        await ValueChanged.InvokeAsync(selectedValue);
    }

    private string GetLabel(string? val)
    {
        var opt = Options?.FirstOrDefault(o => o.Value == val);
        return opt?.Label ?? val ?? "";
    }

    private string GetOptionStyle(SelectOption<string> opt, bool isFocused)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append("display:flex;align-items:center;gap:6px;width:100%;min-height:34px;padding:5px 10px;background:none;border:none;font-size:13px;color:#111827;cursor:pointer;text-align:left;box-sizing:border-box;");
        if (opt.Value == Value)
            sb.Append("background:#eff6ff;color:#2563eb;");
        if (isFocused)
            sb.Append("outline:2px solid #3b82f6;outline-offset:-2px;");
        return sb.ToString();
    }

    private string GetPreviewSvg(string? val)
    {
        if (PreviewRenderer is not null) return PreviewRenderer(val);
        if (string.IsNullOrEmpty(val)) return GetEmptyPreview();
        var def = DiagramArrowheadRegistry.Get(val);
        if (def is null || def.FillMode == "none") return GetEmptyPreview();

        var isFilled = def.FillMode == "filled";
        var fill = isFilled ? "#374151" : "none";
        var stroke = "#374151";
        var sw = isFilled ? "0" : "1.5";
        var w = def.Width; var h = def.Height; var pad = 3;

        var sb = new System.Text.StringBuilder();
        sb.Append("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"");
        sb.Append((-pad).ToString()); sb.Append(" "); sb.Append((-pad).ToString()); sb.Append(" ");
        sb.Append((w + pad * 2).ToString()); sb.Append(" "); sb.Append((h + pad * 2).ToString());
        sb.Append("\" width=\"26\" height=\"18\" style=\"display:block;overflow:visible;\">");
        sb.Append("<path d=\""); sb.Append(def.PathData);
        sb.Append("\" fill=\""); sb.Append(fill); sb.Append("\" stroke=\""); sb.Append(stroke);
        sb.Append("\" stroke-width=\""); sb.Append(sw); sb.Append("\" stroke-linejoin=\"round\" />");
        if (!string.IsNullOrEmpty(def.ExtraPath))
        {
            sb.Append("<path d=\""); sb.Append(def.ExtraPath);
            sb.Append("\" fill=\""); sb.Append(fill); sb.Append("\" stroke=\""); sb.Append(stroke);
            sb.Append("\" stroke-width=\""); sb.Append(sw); sb.Append("\" stroke-linejoin=\"round\" />");
        }
        sb.Append("</svg>");
        return sb.ToString();
    }

    private static string GetEmptyPreview()
        => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 4\" width=\"22\" height=\"6\" style=\"display:block;\"><line x1=\"0\" y1=\"2\" x2=\"24\" y2=\"2\" stroke=\"#9ca3af\" stroke-width=\"1.5\" /></svg>";

    public async ValueTask DisposeAsync()
    {
        await DestroyJsAsync();
        _dotNetRef?.Dispose();
    }
}
