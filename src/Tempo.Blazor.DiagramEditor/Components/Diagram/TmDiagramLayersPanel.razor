@namespace Tempo.Blazor.Components.Diagram
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Components.Diagram.Commands
@using Tempo.Blazor.Components.Diagram.Models

<div class="tm-diagram-layers @Class" data-collapsed="@_collapsed" data-testid="@RootTestId("diagram-layers")">
    <button type="button" class="tm-diagram-layers__toggle" @onclick="ToggleCollapse"
            aria-label="@Loc["TmDiagramLayers_Toggle"]" title="@Loc["TmDiagramLayers_Toggle"]">
        <TmIcon Name="@(_collapsed ? IconNames.ChevronLeft : IconNames.ChevronRight)" />
    </button>

    <div class="tm-diagram-layers__inner">
        <div class="tm-diagram-layers__header">
            <h3 class="tm-diagram-layers__title">@Loc["TmDiagramLayers_Title"]</h3>
            <button type="button" class="tm-diagram-layers__add-btn"
                    aria-label="@Loc["TmDiagramLayers_AddLayer"]"
                    title="@Loc["TmDiagramLayers_AddLayer"]"
                    @onclick="OnAddLayer"
                    disabled="@ReadOnly">
                <TmIcon Name="@IconNames.Plus" />
            </button>
        </div>

        <div class="tm-diagram-layers__list" role="radiogroup" aria-label="@Loc["TmDiagramLayers_Title"]">
            @foreach (var layer in SortedLayers)
            {
                var isActive = ActiveLayerId == layer.Id;
                var isEditing = _editingLayerId == layer.Id;
                <div class="tm-diagram-layers__item @(isActive ? "tm-diagram-layers__item--active" : "") @(_dragOverLayerId == layer.Id ? "tm-diagram-layers__item--drag-over" : "")"
                     data-layer-id="@layer.Id"
                     draggable="true"
                     @ondragstart="e => OnDragStart(e, layer.Id)"
                     @ondragover="OnDragOver"
                     @ondragover:preventDefault
                     @ondrop="e => OnDrop(e, layer.Id)"
                     @ondrop:preventDefault
                     @ondragenter="e => OnDragEnter(e, layer.Id)"
                     @ondragleave="OnDragLeave">
                    <div class="tm-diagram-layers__drag-handle">
                        <TmIcon Name="@IconNames.GripVertical" />
                    </div>

                    <button type="button"
                            class="tm-diagram-layers__active @(_defaultLayerId == layer.Id ? "tm-diagram-layers__active--default" : "")"
                            role="radio"
                            aria-checked="@(isActive ? "true" : "false")"
                            aria-label="@Loc["TmDiagramLayers_SetActiveWithName", layer.Name]"
                            title="@Loc["TmDiagramLayers_SetActiveWithName", layer.Name]"
                            @onclick="() => OnSetActive(layer.Id)"
                            disabled="@ReadOnly">
                        <span class="tm-diagram-layers__radio @(isActive ? "tm-diagram-layers__radio--checked" : "")"></span>
                    </button>

                    <button type="button"
                            class="tm-diagram-layers__visibility"
                            aria-label="@(layer.IsVisible ? Loc["TmDiagramLayers_Hide"] : Loc["TmDiagramLayers_Show"])"
                            title="@(layer.IsVisible ? Loc["TmDiagramLayers_Hide"] : Loc["TmDiagramLayers_Show"])"
                            @onclick="() => OnToggleVisibility(layer)"
                            disabled="@ReadOnly">
                        <TmIcon Name="@(layer.IsVisible ? IconNames.Eye : IconNames.EyeOff)" />
                    </button>

                    <button type="button"
                            class="tm-diagram-layers__lock"
                            aria-label="@(layer.IsLocked ? Loc["TmDiagramLayers_Unlock"] : Loc["TmDiagramLayers_Lock"])"
                            title="@(layer.IsLocked ? Loc["TmDiagramLayers_Unlock"] : Loc["TmDiagramLayers_Lock"])"
                            @onclick="() => OnToggleLock(layer)"
                            disabled="@ReadOnly">
                        <TmIcon Name="@(layer.IsLocked ? IconNames.Lock : IconNames.Unlock)" />
                    </button>

                    @if (isEditing)
                    {
                        <input class="tm-diagram-layers__name-input"
                               type="text"
                               value="@_editName"
                               aria-label="@Loc["TmDiagramLayers_Rename"]"
                               @oninput="e => _editName = e.Value?.ToString() ?? _editName"
                               @onkeydown="e => OnNameKeyDown(e, layer)"
                               @onblur="() => OnNameBlur(layer)"
                               @ref="_nameInputRef" />
                    }
                    else
                    {
                        <span class="tm-diagram-layers__name"
                              tabindex="0"
                              role="button"
                              @ondblclick="() => OnStartEdit(layer)"
                              @onkeydown="e => OnNameKeyDown(e, layer)"
                              @onkeyup="e => OnNameKeyUp(e, layer)"
                              title="@Loc["TmDiagramLayers_DoubleClickToEdit"]">
                            @layer.Name
                        </span>
                    }

                    @if (Document?.Layers.Count > 1 && layer.Id != _defaultLayerId)
                    {
                        <button type="button"
                                class="tm-diagram-layers__delete"
                                aria-label="@Loc["TmDiagramLayers_Delete"]"
                                title="@Loc["TmDiagramLayers_Delete"]"
                                @onclick="() => OnRemoveLayer(layer)"
                                disabled="@ReadOnly">
                            <TmIcon Name="@IconNames.Trash" />
                        </button>
                    }

                    @* Phase 6 (tablet and touch): the row's non-drag alternative to the layer
                       DnD — a "⋯" menu with Rename, Move up, Move down and Delete. *@
                    <button type="button"
                            class="tm-diagram-layers__row-menu-trigger"
                            aria-label="@Loc["TmDiagramLayers_RowActions"]"
                            title="@Loc["TmDiagramLayers_RowActions"]"
                            aria-haspopup="true"
                            aria-expanded="@(_rowMenuLayerId == layer.Id ? "true" : "false")"
                            @onclick="() => ToggleRowMenu(layer.Id)"
                            disabled="@ReadOnly">
                        <TmIcon Name="@IconNames.MoreHorizontal" />
                    </button>
                    @if (_rowMenuLayerId == layer.Id)
                    {
                        <div class="tm-diagram-layers__row-menu-backdrop" @onclick="() => ToggleRowMenu(layer.Id)"></div>
                        <div class="tm-diagram-layers__row-menu" role="menu" aria-label="@Loc["TmDiagramLayers_RowActions"]">
                            <button type="button"
                                    class="tm-diagram-layers__row-menu-item tm-diagram-layers__row-menu-item--rename"
                                    role="menuitem"
                                    @onclick="() => OnRowMenuRename(layer)">
                                @Loc["TmDiagramLayers_Rename"]
                            </button>
                            <button type="button"
                                    class="tm-diagram-layers__row-menu-item tm-diagram-layers__row-menu-item--up"
                                    role="menuitem"
                                    disabled="@RowMenuIsFirst"
                                    @onclick="() => OnMoveLayer(layer, -1)">
                                @Loc["TmDiagramLayers_MoveUp"]
                            </button>
                            <button type="button"
                                    class="tm-diagram-layers__row-menu-item tm-diagram-layers__row-menu-item--down"
                                    role="menuitem"
                                    disabled="@RowMenuIsLast"
                                    @onclick="() => OnMoveLayer(layer, +1)">
                                @Loc["TmDiagramLayers_MoveDown"]
                            </button>
                            @if (Document?.Layers.Count > 1 && layer.Id != _defaultLayerId)
                            {
                                <button type="button"
                                        class="tm-diagram-layers__row-menu-item tm-diagram-layers__row-menu-item--delete"
                                        role="menuitem"
                                        @onclick="() => OnRowMenuDelete(layer)">
                                    @Loc["TmDiagramLayers_Delete"]
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @if (SelectedNodes.Count > 0 && !ReadOnly)
        {
            <div class="tm-diagram-layers__move-section">
                <label class="tm-diagram-layers__move-label" for="@_moveSelectId">@Loc["TmDiagramLayers_MoveToLayer"]</label>
                <TmSelect TValue="string"
                          Id="@_moveSelectId"
                          Value="_moveTargetLayerId"
                          ValueChanged="OnMoveNodesToLayer"
                          Options="MoveLayerOptions"
                          Placeholder="@Loc["TmDiagramLayers_SelectLayer"]" />
            </div>
        }
    </div>
</div>
