@namespace Tempo.Blazor.Components.Diagram
@using Tempo.Blazor.Components.Inputs
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Components.Buttons

<div class="tm-diagram-search-panel">
    <div class="tm-diagram-search-panel__inputs">
        <div class="tm-diagram-search-panel__input-wrap">
            <TmSearchInput Value="@Query"
                           ValueChanged="OnQueryChanged"
                           Placeholder="@Loc["TmDiagram_SearchPlaceholder"]"
                           aria-invalid="@(HasError ? "true" : null)"
                           aria-describedby="@(HasError ? ErrorId : null)" />
        </div>
        @if (!ReadOnly)
        {
            <div class="tm-diagram-search-panel__input-wrap tm-diagram-search-panel__replace">
                <TmSearchInput Value="@ReplaceQuery"
                               ValueChanged="OnReplaceQueryChanged"
                               Placeholder="@Loc["TmDiagram_ReplacePlaceholder"]" />
            </div>
        }
        @if (HasError)
        {
            @* role="alert" announces the pattern error immediately; the id ties it to the
               query input through aria-describedby / aria-invalid (review M). *@
            <span id="@ErrorId" class="tm-diagram-search-panel__error" role="alert">@RegexError</span>
        }
    </div>
    <label class="tm-diagram-search-panel__all-pages">
        <input type="checkbox"
               checked="@SearchAllPages"
               @onchange="e => OnSearchAllPagesChanged((bool)(e.Value ?? false))" />
        <span>@Loc["TmDiagram_SearchAllPages"]</span>
    </label>
    <TmToggle Value="UseRegex"
              ValueChanged="OnUseRegexChanged"
              Label=".*"
              Class="tm-diagram-search-panel__regex-toggle"
              title="@Loc["TmDiagram_UseRegex"]" />
    @* The result counter is a live region: prev/next navigation announces "n of m" without
       moving focus (review O). *@
    <span class="tm-diagram-search-panel__counter" role="status" aria-live="polite" aria-atomic="true">
        @if (ResultsCount > 0)
        {
            @string.Format(Loc["TmDiagram_SearchResults"], CurrentIndex + 1, ResultsCount)
        }
        else if (!string.IsNullOrEmpty(Query))
        {
            @Loc["TmDiagram_SearchNoResults"]
        }
    </span>
    @if (!ReadOnly)
    {
        <div class="tm-diagram-search-panel__actions">
            <TmButton Variant="ButtonVariant.Default"
                      Size="ButtonSize.Sm"
                      OnClick="OnReplaceClick"
                      Disabled="@(!CanReplace)">
                @Loc["TmDiagram_Replace"]
            </TmButton>
            <TmButton Variant="ButtonVariant.Primary"
                      Size="ButtonSize.Sm"
                      OnClick="OnReplaceAllClick"
                      Disabled="@(!CanReplaceAll)">
                @Loc["TmDiagram_ReplaceAll"]
            </TmButton>
        </div>
    }
    <button type="button"
            class="tm-diagram-search-panel__nav"
            aria-label="@Loc["TmDiagram_SearchPrevious"]"
            title="@Loc["TmDiagram_SearchPrevious"]"
            @onclick="OnPreviousClick"
            disabled="@(ResultsCount == 0)">
        <TmIcon Name="@IconNames.ChevronLeft" />
    </button>
    <button type="button"
            class="tm-diagram-search-panel__nav"
            aria-label="@Loc["TmDiagram_SearchNext"]"
            title="@Loc["TmDiagram_SearchNext"]"
            @onclick="OnNextClick"
            disabled="@(ResultsCount == 0)">
        <TmIcon Name="@IconNames.ChevronRight" />
    </button>
    <button type="button"
            class="tm-diagram-search-panel__close"
            aria-label="@Loc["TmDiagram_SearchClose"]"
            title="@Loc["TmDiagram_SearchClose"]"
            @onclick="OnCloseClick">
        <TmIcon Name="@IconNames.X" />
    </button>
</div>
