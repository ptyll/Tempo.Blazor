@namespace Tempo.Blazor.Components.Diagram
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Inputs
@using Tempo.Blazor.Components.Diagram.Services
@using Tempo.Blazor.Components.Diagram.Models
@using Tempo.Blazor.Models
@using Tempo.Blazor.Abstractions.Layout
@implements IDisposable

<TmModal Show="@Show"
         OnClose="OnClose"
         Title="@Loc["TmDiagramCsvImportDialog_Title"]"
         Subtitle="@Loc["TmDiagramCsvImportDialog_Subtitle"]"
         ShowDefaultFooterButtons="false"
         Size="ModalSize.Large"
         MobilePresentation="MobilePresentation.Auto"
         FooterLayout="FooterLayout.Inline"
         LayoutMode="@LayoutMode"
         CloseOnOverlayClick="true"
         CloseOnEscape="true"
         RestoreFocusTarget="@RestoreFocusTarget">
    <ChildContent>
        <div class="tm-diagram-csv-import">
            <div class="tm-diagram-csv-import__field">
                <label class="tm-diagram-csv-import__label" for="@_csvFieldId">@Loc["TmDiagramCsvImportDialog_CsvLabel"]</label>
                <TmTextArea Id="@_csvFieldId"
                            @bind-Value="_csvText"
                            @bind-Value:after="OnCsvChanged"
                            Immediate="true"
                            Rows="8"
                            Placeholder="@Loc["TmDiagramCsvImportDialog_CsvPlaceholder"]"
                            Class="tm-diagram-csv-import__textarea"
                            aria-invalid="@(HasPreviewError ? "true" : null)"
                            aria-describedby="@(HasPreviewError ? _previewErrorId : null)" />
            </div>

            <div class="tm-diagram-csv-import__field">
                <label class="tm-diagram-csv-import__label" for="@_typeFieldId">@Loc["TmDiagramCsvImportDialog_TypeLabel"]</label>
                <TmSelect Id="@_typeFieldId"
                          @bind-Value="_diagramType"
                          @bind-Value:after="OnDiagramTypeChanged"
                          Options="TypeOptions"
                          Class="tm-diagram-csv-import__select" />
            </div>

            @if (_mappings.Count > 0)
            {
                <div class="tm-diagram-csv-import__mappings">
                    <span class="tm-diagram-csv-import__mappings-title">@Loc["TmDiagramCsvImportDialog_MappingsTitle"]</span>
                    <div class="tm-diagram-csv-import__mappings-grid">
                        @foreach (var mapping in _mappings)
                        {
                            var mappingFieldId = $"csv-map-{mapping.SemanticField.ToLowerInvariant()}-{_uid}";
                            <div class="tm-diagram-csv-import__mapping-row">
                                <label class="tm-diagram-csv-import__mapping-label" for="@mappingFieldId">
                                    @GetSemanticFieldLabel(mapping.SemanticField)
                                    @if (mapping.IsRequired)
                                    {
                                        <span class="tm-diagram-csv-import__required" aria-hidden="true">*</span>
                                    }
                                </label>
                                <TmSelect Id="@mappingFieldId"
                                          Value="mapping.SelectedColumn"
                                          ValueChanged="(string? v) => OnMappingChanged(mapping, v)"
                                          Options="_headerOptions"
                                          Placeholder="@Loc["TmDiagramCsvImportDialog_SelectColumn"]"
                                          Required="mapping.IsRequired"
                                          Class="tm-diagram-csv-import__mapping-select" />
                            </div>
                        }
                    </div>
                </div>
            }

            @if (_previewRows.Count > 0)
            {
                <div class="tm-diagram-csv-import__preview-table-wrap">
                    <span class="tm-diagram-csv-import__preview-title">
                        @Loc["TmDiagramCsvImportDialog_PreviewTitle"]
                    </span>
                    <table class="tm-diagram-csv-import__preview-table">
                        <thead>
                            <tr>
                                @foreach (var h in _previewHeaders)
                                {
                                    <th>@h</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _previewRows)
                            {
                                <tr>
                                    @foreach (var cell in row)
                                    {
                                        <td>@cell</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @* Live region (D12): the wrapper is always in the DOM so screen readers announce the
               preview (and the debounced preview error — POLITE, never role=alert) when it appears.
               The debounced preview reports problems as you type; only the Import click promotes
               an error to the assertive TmAlert below. The textarea points aria-describedby here
               and carries aria-invalid while a preview error is shown. *@
            <div class="tm-diagram-csv-import__status" role="status" aria-live="polite" aria-atomic="true">
                @if (_previewNodes >= 0)
                {
                    @* Mockup: the live parse result paints as one summary box holding icon stats. *@
                    <div class="tm-diagram-csv-import__preview">
                        <span class="tm-diagram-csv-import__stat">
                            <TmIcon Name="@IconNames.Square" Size="IconSize.Sm" />
                            @Loc["TmDiagramCsvImportDialog_PreviewNodes", _previewNodes]
                        </span>
                        <span class="tm-diagram-csv-import__stat">
                            <TmIcon Name="@IconNames.ArrowRight" Size="IconSize.Sm" />
                            @Loc["TmDiagramCsvImportDialog_PreviewEdges", _previewEdges]
                        </span>
                    </div>
                }
                @if (HasPreviewError)
                {
                    <p class="tm-diagram-csv-import__status-error" id="@_previewErrorId">@_previewError</p>
                }
            </div>

            @* Import-click failures only: role=alert, asserted. Typing-time problems stay polite
               in the status region above. *@
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <TmAlert Severity="AlertSeverity.Error" Dismissable="false" Class="tm-diagram-csv-import__error">
                    @_errorMessage
                </TmAlert>
            }
        </div>
    </ChildContent>
    <Footer>
        <TmButton Variant="ButtonVariant.Ghost" OnClick="OnClose">
            @Loc["Tm_Cancel"]
        </TmButton>
        <TmButton Variant="ButtonVariant.Primary"
                  OnClick="OnImportClick"
                  Disabled="string.IsNullOrWhiteSpace(_csvText) || !AreRequiredMappingsFilled()">
            @Loc["TmDiagramCsvImportDialog_ImportButton"]
        </TmButton>
    </Footer>
</TmModal>

@code {
    /// <summary>Whether the dialog is visible; hidden resets the entered CSV, mappings and preview.</summary>
    [Parameter] public bool Show { get; set; }

    /// <summary>Raised when the user cancels or closes the dialog.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Raised on import with the generated document and the layout id for the chosen type.</summary>
    [Parameter] public EventCallback<CsvImportResult> OnImport { get; set; }

    /// <summary>
    /// The layout the modal renders. <see cref="TmLayoutMode.Auto"/> follows the viewport scope; a
    /// forced value never measures, so a test can render the mobile sheet without a DOM.
    /// </summary>
    [Parameter] public TmLayoutMode LayoutMode { get; set; } = TmLayoutMode.Auto;

    /// <summary>The element (typically the canvas) focus returns to when the dialog closes.</summary>
    [Parameter] public ElementReference? RestoreFocusTarget { get; set; }

    private string _csvText = string.Empty;
    private CsvDiagramType _diagramType = CsvDiagramType.OrgChart;
    private string? _previewError;
    private string? _errorMessage;

    private readonly List<CsvColumnMapping> _mappings = [];
    private readonly List<SelectOption<string>> _headerOptions = [];
    private readonly List<string> _previewHeaders = [];
    private readonly List<List<string>> _previewRows = [];
    private int _previewNodes = -1;
    private int _previewEdges = -1;

    // Per-instance field ids: the fixed "csv-data"/"diagram-type" ids collided
    // when two dialogs were rendered at once and the diagram-type label pointed
    // at a non-existent id (TmSelect generated its own random id).
    private readonly string _uid = Guid.NewGuid().ToString("n")[..8];
    private string _csvFieldId => $"csv-data-{_uid}";
    private string _typeFieldId => $"diagram-type-{_uid}";
    private string _previewErrorId => $"csv-preview-error-{_uid}";
    private bool HasPreviewError => !string.IsNullOrEmpty(_previewError);

    /// <summary>Diagram type choices, localized at render time.</summary>
    private List<SelectOption<CsvDiagramType>> TypeOptions => new()
    {
        new() { Value = CsvDiagramType.OrgChart, Label = Loc["TmDiagramCsvImportDialog_Type_OrgChart"] },
        new() { Value = CsvDiagramType.Flowchart, Label = Loc["TmDiagramCsvImportDialog_Type_Flowchart"] },
        new() { Value = CsvDiagramType.Timeline, Label = Loc["TmDiagramCsvImportDialog_Type_Timeline"] }
    };

    /// <summary>Localized display label for a semantic mapping field (falls back to the machine key).</summary>
    private string GetSemanticFieldLabel(string semanticField) => semanticField switch
    {
        "Name" => Loc["TmDiagramCsvImportDialog_Field_Name"],
        "Manager" => Loc["TmDiagramCsvImportDialog_Field_Manager"],
        "From" => Loc["TmDiagramCsvImportDialog_Field_From"],
        "To" => Loc["TmDiagramCsvImportDialog_Field_To"],
        "Label" => Loc["TmDiagramCsvImportDialog_Field_Label"],
        "Date" => Loc["TmDiagramCsvImportDialog_Field_Date"],
        "Event" => Loc["TmDiagramCsvImportDialog_Field_Event"],
        _ => semanticField
    };

    protected override void OnParametersSet()
    {
        if (!Show)
        {
            _csvText = string.Empty;
            _diagramType = CsvDiagramType.OrgChart;
            _previewError = null;
            _errorMessage = null;
            _mappings.Clear();
            _headerOptions.Clear();
            _previewHeaders.Clear();
            _previewRows.Clear();
            _previewNodes = -1;
            _previewEdges = -1;
            CancelPreviewTimer();
            _parsed = null;
        }
        if (_mappings.Count == 0)
            InitMappings();
    }

    private void InitMappings()
    {
        _mappings.Clear();
        switch (_diagramType)
        {
            case CsvDiagramType.OrgChart:
                _mappings.Add(new CsvColumnMapping { SemanticField = "Name", IsRequired = true });
                _mappings.Add(new CsvColumnMapping { SemanticField = "Manager", IsRequired = true });
                break;
            case CsvDiagramType.Flowchart:
                _mappings.Add(new CsvColumnMapping { SemanticField = "From", IsRequired = true });
                _mappings.Add(new CsvColumnMapping { SemanticField = "To", IsRequired = true });
                _mappings.Add(new CsvColumnMapping { SemanticField = "Label", IsRequired = false });
                break;
            case CsvDiagramType.Timeline:
                _mappings.Add(new CsvColumnMapping { SemanticField = "Date", IsRequired = true });
                _mappings.Add(new CsvColumnMapping { SemanticField = "Event", IsRequired = true });
                break;
        }
    }

    private void OnDiagramTypeChanged()
    {
        InitMappings();
        if (_parsed is not null)
        {
            _previewError = null;
            _errorMessage = null;
        }
        RefreshPreview();
    }

    /// <summary>Live-preview debounce. Internal so tests can reference it.</summary>
    internal const int PreviewDebounceMs = DiagramPreviewDebouncer.DebounceMs;

    [Inject] private IServiceProvider ServiceProvider { get; set; } = default!;
    private TimeProvider Clock => _clock ??= ServiceProvider.GetService(typeof(TimeProvider)) as TimeProvider ?? TimeProvider.System;
    private TimeProvider? _clock;

    /// <summary>Shared debounced-timer plumbing (see <see cref="DiagramPreviewDebouncer"/>).</summary>
    private DiagramPreviewDebouncer? _debouncer;
    private DiagramPreviewDebouncer Debouncer => _debouncer ??= new DiagramPreviewDebouncer(InvokeAsync, Clock);

    /// <summary>Last successful parse of <c>_csvText</c> — parsed ONCE per debounced edit.</summary>
    private CsvParseResult? _parsed;

    /// <summary>Live preview: each input re-arms a single-shot timer; the parse runs once typing pauses.</summary>
    private void OnCsvChanged() => SchedulePreview();

    private void SchedulePreview()
    {
        Debouncer.Cancel();
        if (string.IsNullOrWhiteSpace(_csvText))
        {
            ReparseCsv();
            return;
        }

        Debouncer.Schedule(() =>
        {
            ReparseCsv();
            StateHasChanged();
            return Task.CompletedTask;
        });
    }

    private void CancelPreviewTimer() => _debouncer?.Cancel();

    /// <summary>Stops a pending preview timer.</summary>
    public void Dispose()
    {
        _debouncer?.Dispose();
    }

    /// <summary>Re-parses the typed CSV once per debounced edit and refreshes every dependent surface.</summary>
    private void ReparseCsv()
    {
        _parsed = null;
        _headerOptions.Clear();
        _previewHeaders.Clear();
        _previewRows.Clear();
        _previewError = null;
        _errorMessage = null;

        if (!string.IsNullOrWhiteSpace(_csvText))
        {
            try
            {
                _parsed = CsvParser.Parse(_csvText);
                _headerOptions.AddRange(_parsed.Headers.Select(h => new SelectOption<string> { Value = h, Label = h }));
                _previewHeaders.AddRange(_parsed.Headers);
                _previewRows.AddRange(_parsed.Rows.Take(5).Select(r => r.ToList()));
            }
            catch (Exception ex)
            {
                _previewError = GetPreviewError(ex);
            }
        }

        AutoMapEmptyMappings();
        ClearInvalidMappings();
        RefreshPreview();
    }

    /// <summary>
    /// Fills still-empty mappings with the header that matches the semantic field name or its
    /// localized label (case/diacritic-insensitive fold compare, D7) — pasting a CSV whose
    /// header reads "Název" or "name" pre-selects the Name column without a manual step.
    /// </summary>
    private void AutoMapEmptyMappings()
    {
        if (_parsed is null) return;
        foreach (var mapping in _mappings)
        {
            if (!string.IsNullOrEmpty(mapping.SelectedColumn)) continue;
            var foldedField = DiagramSearchText.Fold(mapping.SemanticField);
            var foldedLabel = DiagramSearchText.Fold(GetSemanticFieldLabel(mapping.SemanticField));
            var match = _parsed.Headers.FirstOrDefault(h =>
                string.Equals(DiagramSearchText.Fold(h), foldedField, StringComparison.OrdinalIgnoreCase)
                || string.Equals(DiagramSearchText.Fold(h), foldedLabel, StringComparison.OrdinalIgnoreCase));
            if (match is not null)
                mapping.SelectedColumn = match;
        }
    }

    /// <summary>
    /// A mapping whose column vanished from the header (edited CSV) is cleared, never kept stale —
    /// and the user is told through the POLITE preview error (the mapping is their data, the alert
    /// stays reserved for the Import click). A transient failed parse wipes nothing: the previous
    /// mappings survive until a successful parse re-validates them.
    /// </summary>
    private void ClearInvalidMappings()
    {
        if (_parsed is null) return;
        var headers = _parsed.Headers;
        foreach (var mapping in _mappings)
        {
            if (string.IsNullOrEmpty(mapping.SelectedColumn)) continue;
            if (headers.Any(h => string.Equals(h, mapping.SelectedColumn, StringComparison.OrdinalIgnoreCase))) continue;
            var cleared = mapping.SelectedColumn;
            mapping.SelectedColumn = string.Empty;
            _previewError = Loc["TmDiagramCsvImportDialog_ErrorColumnNotFound",
                cleared, GetSemanticFieldLabel(mapping.SemanticField)];
        }
    }

    private void OnMappingChanged(CsvColumnMapping mapping, string? value)
    {
        mapping.SelectedColumn = value ?? string.Empty;
        if (_parsed is not null)
        {
            _previewError = null;
            _errorMessage = null;
        }
        RefreshPreview();
    }

    private void RefreshPreview()
    {
        _previewNodes = -1;
        _previewEdges = -1;
        if (_parsed is null || !AreRequiredMappingsFilled()) return;

        try
        {
            var doc = GenerateDocument(_parsed);
            _previewNodes = doc.ActivePage.Nodes.Count;
            _previewEdges = doc.ActivePage.Edges.Count;
        }
        catch (Exception ex)
        {
            _previewError = GetErrorMessage(ex);   // surfaced politely, not swallowed
        }
    }

    /// <summary>
    /// Localized POLITE preview error for a parse failure. The "no data rows" and "fewer than
    /// two columns" wordings wait until the pasted text has at least two lines — with a single
    /// line typed the user is still mid-paste, and shouting about a half-written snippet is noise.
    /// </summary>
    private string? GetPreviewError(Exception ex)
    {
        if (ex is not DiagramImportException import)
            return Loc["TmDiagramCsvImportDialog_ErrorUnexpected"];
        if (import.Error is DiagramImportError.CsvNoData or DiagramImportError.CsvMinColumns
            && LineCount(_csvText) < 2)
            return null;
        return GetErrorMessage(import);
    }

    private static int LineCount(string text) =>
        string.IsNullOrEmpty(text) ? 0 : text.Split('\n').Length;

    /// <summary>Localized text for an import failure. Never returns <see cref="Exception.Message"/>.</summary>
    private string GetErrorMessage(Exception ex) => ex is DiagramImportException import
        ? import.Error switch
        {
            DiagramImportError.CsvEmpty => Loc["TmDiagramCsvImportDialog_ErrorEmpty"],
            DiagramImportError.CsvNoData => Loc["TmDiagramCsvImportDialog_ErrorNoData"],
            DiagramImportError.CsvMinColumns => Loc["TmDiagramCsvImportDialog_ErrorMinColumns"],
            DiagramImportError.MappingMissing => Loc["TmDiagramCsvImportDialog_ErrorMappings"],
            DiagramImportError.ColumnNotFound => Loc["TmDiagramCsvImportDialog_ErrorColumnNotFound",
                import.Column ?? string.Empty, GetSemanticFieldLabel(import.Field ?? string.Empty)],
            DiagramImportError.InputTooComplex => Loc["TmDiagramCsvImportDialog_ErrorTooLarge"],
            _ => Loc["TmDiagramCsvImportDialog_ErrorUnexpected"]
        }
        : Loc["TmDiagramCsvImportDialog_ErrorUnexpected"];

    private bool AreRequiredMappingsFilled()
    {
        return _mappings.Where(m => m.IsRequired).All(m => !string.IsNullOrWhiteSpace(m.SelectedColumn));
    }

    private async Task OnImportClick()
    {
        if (string.IsNullOrWhiteSpace(_csvText))
        {
            _previewError = null;
            _errorMessage = Loc["TmDiagramCsvImportDialog_ErrorEmpty"];
            return;
        }

        if (!AreRequiredMappingsFilled())
        {
            _previewError = null;
            _errorMessage = Loc["TmDiagramCsvImportDialog_ErrorMappings"];
            return;
        }

        CancelPreviewTimer();
        ReparseCsv();
        if (_parsed is null)
        {
            // The parse failed: promote the polite preview wording to the assertive alert.
            _errorMessage = _previewError ?? Loc["TmDiagramCsvImportDialog_ErrorUnexpected"];
            _previewError = null;
            return;
        }

        try
        {
            var doc = GenerateDocument(_parsed);
            var layout = _diagramType switch
            {
                CsvDiagramType.OrgChart => "tree",
                CsvDiagramType.Flowchart => "dagre",
                _ => string.Empty
            };
            await OnImport.InvokeAsync(new CsvImportResult(doc, layout));
            _errorMessage = null;
        }
        catch (Exception ex)
        {
            _previewError = null;
            _errorMessage = GetErrorMessage(ex);
        }
    }

    private DiagramDocument GenerateDocument(CsvParseResult parseResult)
    {
        return _diagramType switch
        {
            CsvDiagramType.OrgChart => CsvToOrgChartGenerator.Generate(parseResult, _mappings),
            CsvDiagramType.Flowchart => CsvToFlowchartGenerator.Generate(parseResult, _mappings),
            CsvDiagramType.Timeline => CsvToTimelineGenerator.Generate(parseResult, _mappings),
            _ => throw new InvalidOperationException("Unsupported diagram type.")
        };
    }
}
