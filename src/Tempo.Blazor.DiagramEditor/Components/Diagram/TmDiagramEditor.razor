@namespace Tempo.Blazor.Components.Diagram
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Abstractions.Layout
@using Tempo.Blazor.Components.Diagram.Models
@using Tempo.Blazor.Components.Diagram.Commands
@using Microsoft.AspNetCore.Components.Forms
@using Tempo.Blazor.Components.Actions
@using Tempo.Blazor.Components.Layout
@using Tempo.Blazor.Components.Overlay
@using Tempo.Blazor.Components.Toolbar
@using Tempo.Blazor.Components.Dropdowns

<CascadingValue Value="ActiveCommandStack" IsFixed="false">

<div class="tm-diagram-editor @Class @(IsReadOnly ? "tm-diagram-editor--readonly" : "")"
     @ref="_editorRoot"
     data-editor-layout="@(_resolvedLayout.ToString().ToLowerInvariant())"
     data-testid="@TestId("diagram-editor")">

    @* Phase 4 (desktop restructure): the shell owns the editor chrome — a header (page tabs,
       title, named panel toggles, "⋯" view settings), a single command row (core TmToolbar with
       overflow), docked left/right panels, the canvas and a status bar with the zoom controls.
       The desktop reference: output/imagegen/tempo-reimagined/Tempo.Blazor.DiagramEditor. *@
    <TmEditorShell Class="tm-diagram-editor__shell"
                   Left="@LeftSlot"
                   Right="@RightSlot"
                   StatusBar="@(IsMobileLayout ? null : StatusBarSlot)"
                   Toolbar="@(IsMobileLayout ? null : ToolbarSlot)"
                   LeftRail="@ToolboxRail"
                   LayoutMode="LayoutMode"
                   Breakpoints="@(LayoutBreakpoints ?? EditorBreakpoints)"
                   ResolvedLayoutChanged="OnShellResolvedLayoutChanged"
                   CollapsedPanels="_shellCollapsed"
                   CollapsedPanelsChanged="OnShellCollapsedPanelsChanged"
                   LeftWidthChanged="OnShellLeftWidthChanged"
                   RightWidthChanged="OnShellRightWidthChanged"
                   LeftOpen="LeftDockOpen"
                   LeftOpenChanged="OnShellLeftDockOpenChanged"
                   RightOpen="RightDockOpen"
                   RightOpenChanged="OnShellRightDockOpenChanged"
                   LeftTitle="@(IsMobileLayout ? MobileShapesTitle : Loc["TmDiagramEditor_PanelToolbox"])"
                   RightTitle="@InspectorTitle"
                                      MobileActions="@EffectiveMobileActions"
                   ActiveMobilePanel="_activeMobilePanel"
                   ActiveMobilePanelChanged="SilentActivePanelChanged"
                   MobileSheetSnapIndex="_mobileSnapIndex"
                   MobileSheetSnapIndexChanged="SilentSnapChanged"
                   MobileSheetSnapPoints="MobileSheetSnapPoints"
                   LeftWidth="220px" MinLeftWidth="180" MaxLeftWidth="360"
                   RightWidth="300px" MinRightWidth="240" MaxRightWidth="440">
        <Header>
            @* ── Page tabs (DI3: pages stay on top) ──────────────────────────── *@
            <div class="tm-diagram-editor__page-tabs"
                 role="@(IsReadOnly ? null : "tablist")"
                 aria-label="@(IsReadOnly ? null : Loc["TmDiagramEditor_PageName"])"
                 @ondragover:preventDefault
                 @ondrop:preventDefault>
                @if (_document?.Pages is not null)
                {
                    @foreach (var pg in _document.Pages)
                    {
                        var isActive = pg.Id == _document.ActivePage.Id;
                        var isDragOver = _pageDragOverId == pg.Id;
                        <div class="tm-diagram-editor__page-tab @(isActive ? "tm-diagram-editor__page-tab--active" : "") @(_pageRenamingId == pg.Id ? "tm-diagram-editor__page-tab--renaming" : "") @(isDragOver ? "tm-diagram-editor__page-tab--drag-over" : "")"
                             @onclick="() => SelectPage(pg.Id)"
                             @ondblclick="() => StartRenamePage(pg.Id)"
                             @ondragstart="() => OnPageTabDragStart(pg.Id)"
                             @ondragenter="() => OnPageTabDragEnter(pg.Id)"
                             @ondragleave="OnPageTabDragLeave"
                             @ondrop="() => OnPageTabDrop(pg.Id)"
                             draggable="true"
                             title="@pg.Name"
                             role="@(IsReadOnly ? null : "tab")"
                             aria-selected="@(IsReadOnly ? null : isActive.ToString().ToLowerInvariant())">
                            @if (_pageRenamingId == pg.Id)
                            {
                                <input type="text"
                                       class="tm-diagram-editor__page-tab-input"
                                       value="@_pageRenameInput"
                                       @oninput="e => _pageRenameInput = e.Value?.ToString() ?? _pageRenameInput"
                                       @onkeydown="e => OnRenamePageKeyDown(e, pg.Id)"
                                       @onblur="() => CommitRenamePage(pg.Id)"
                                       @ref="_pageRenameInputRef" />
                            }
                            else
                            {
                                <span class="tm-diagram-editor__page-tab-name">@pg.Name</span>
                                @if (ActiveCommandStack.CanUndo)
                                {
                                    <span class="tm-diagram-editor__page-tab-dot" aria-hidden="true"></span>
                                }
                                @if (!IsReadOnly)
                                {
                                    <button class="tm-diagram-editor__page-tab-duplicate"
                                            aria-label="@Loc["TmDiagramEditor_DuplicatePage"]"
                                            title="@Loc["TmDiagramEditor_DuplicatePage"]"
                                            @onclick:stopPropagation
                                            @onclick="() => DuplicatePage(pg.Id)">
                                        <TmIcon Name="@DiagramEditorIconNames.Duplicate" Size="IconSize.Xs" />
                                    </button>
                                    @if (_document.Pages.Count > 1)
                                    {
                                        <button class="tm-diagram-editor__page-tab-close"
                                                aria-label="@Loc["TmDiagramEditor_ClosePage", pg.Name]"
                                                title="@Loc["TmDiagramEditor_ClosePage", pg.Name]"
                                                @onclick:stopPropagation
                                                @onclick="() => RemovePage(pg.Id)">
                                            <TmIcon Name="@IconNames.X" Size="IconSize.Xs" />
                                        </button>
                                    }
                                }
                            }
                        </div>
                    }
                    @if (!IsReadOnly)
                    {
                        <button class="tm-diagram-editor__page-tab-add"
                                aria-label="@Loc["TmDiagramEditor_AddPage"]"
                                title="@Loc["TmDiagramEditor_AddPage"]"
                                @onclick="AddPage">
                            <TmIcon Name="@IconNames.Plus" Size="IconSize.Xs" />
                        </button>
                    }
                }
            </div>

            @* ── Header bar: host slot, title, named panel toggles, "⋯" view settings ── *@
            @if (ShowsHeaderBar)
            {
            <div class="tm-diagram-editor__header-bar">

                @if (HeaderStart is not null)
                {
                    @* G9 host slot: host content opens the header, before the built-in title. *@
                    <div class="tm-diagram-editor__header-start">@HeaderStart</div>
                }

                @if (ShowsHeaderControls && ShowTitle)
                {
                    <input class="tm-diagram-editor__title"
                           type="text"
                           value="@_document?.Title"
                           placeholder="@Loc["TmDiagramEditor_UntitledPlaceholder"]"
                           aria-label="@Loc["TmDiagramEditor_DocumentTitleLabel"]"
                           @onchange="OnTitleChanged"
                           disabled="@IsReadOnly"
                           title="@Loc["TmDiagramEditor_DocumentTitleLabel"]" />
                }

                <div class="tm-diagram-editor__header-spacer"></div>

                @* Phase 7 (mobile): compact header — title, Undo/Redo and the "⋯" view menu.
                   The panel toggles make no sense (the panels live in the sheet) and the search
                   moves into the "⋯" menu, so the header holds three icon targets at 320px. *@
                @if (ShowsHeaderControls && IsMobileLayout && Shows(DiagramToolbarGroups.History))
                {
                    <div class="tm-diagram-editor__toolbar-group tm-diagram-editor__header-history" data-tm-group="history">
                        <button type="button"
                                class="tm-diagram-editor__more-btn"
                                disabled="@(!ActiveCommandStack.CanUndo || IsReadOnly)"
                                aria-label="@Loc["TmDiagramEditor_Undo"]"
                                title="@Loc["TmDiagramEditor_Undo"]"
                                @onclick="OnUndoClicked">
                            <TmIcon Name="@IconNames.RotateCcw" Size="IconSize.Sm" />
                        </button>
                        <button type="button"
                                class="tm-diagram-editor__more-btn"
                                disabled="@(!ActiveCommandStack.CanRedo || IsReadOnly)"
                                aria-label="@Loc["TmDiagramEditor_Redo"]"
                                title="@Loc["TmDiagramEditor_Redo"]"
                                @onclick="OnRedoClicked">
                            <TmIcon Name="@IconNames.RotateCw" Size="IconSize.Sm" />
                        </button>
                    </div>
                }

                @* Search toggle (named, with a visible label); on mobile it lives in the "⋯" menu. *@
                @if (ShowsHeaderControls && Shows(DiagramToolbarGroups.Search) && !IsMobileLayout)
                {
                    <div class="tm-diagram-editor__toolbar-group" data-tm-group="search">
                        <button type="button"
                                class="tm-diagram-editor__panel-toggle @(_showSearchPanel ? "tm-diagram-editor__panel-toggle--active" : "")"
                                title="@Loc["TmDiagramEditor_Search"]"
                                aria-label="@Loc["TmDiagramEditor_Search"]"
                                aria-pressed="@(_showSearchPanel.ToString().ToLowerInvariant())"
                                @onclick="OnSearchClicked">
                            <TmIcon Name="@IconNames.Search" Size="IconSize.Sm" />
                            <span class="tm-diagram-editor__panel-toggle-label">@Loc["TmDiagramEditor_Search"]</span>
                        </button>
                    </div>
                }

                @* Named panel toggles (desktop/tablet chrome; on mobile the panels live in the sheet) *@
                @if (ShowsHeaderControls && Shows(DiagramToolbarGroups.Panels) && !IsMobileLayout)
                {
                    <div class="tm-diagram-editor__toolbar-group" data-tm-group="panels">
                        @if (ShowToolbox)
                        {
                            @* WCAG 2.5.3: the accessible name carries the VISIBLE label text; the
                               tooltip keeps the action wording ("Toggle …"). *@
                            <button type="button"
                                    class="tm-diagram-editor__panel-toggle @(IsToolboxExpanded ? "tm-diagram-editor__panel-toggle--active" : "")"
                                    title="@Loc["TmDiagramEditor_ToggleToolbox"]"
                                    aria-label="@Loc["TmDiagramEditor_PanelToolbox"]"
                                    aria-pressed="@(IsToolboxExpanded.ToString().ToLowerInvariant())"
                                    data-testid="@TestId("diagram-editor-toggle-toolbox")"
                                    @onclick="ToggleToolboxFromHeaderAsync">
                                <TmIcon Name="@IconNames.Grid" Size="IconSize.Sm" />
                                <span class="tm-diagram-editor__panel-toggle-label">@Loc["TmDiagramEditor_PanelToolbox"]</span>
                            </button>
                        }
                        @if (ShowPropertiesPanel || ShowLayersPanel)
                        {
                            <button type="button"
                                    class="tm-diagram-editor__panel-toggle @(IsInspectorExpanded ? "tm-diagram-editor__panel-toggle--active" : "")"
                                    title="@Loc["TmDiagramEditor_ToggleInspector"]"
                                    aria-label="@InspectorToggleLabel"
                                    aria-pressed="@(IsInspectorExpanded.ToString().ToLowerInvariant())"
                                    data-testid="@TestId("diagram-editor-toggle-inspector")"
                                    @onclick="ToggleInspectorFromHeaderAsync">
                                <TmIcon Name="@(ShowPropertiesPanel ? IconNames.Sliders : IconNames.Layers)" Size="IconSize.Sm" />
                                <span class="tm-diagram-editor__panel-toggle-label">@InspectorToggleLabel</span>
                            </button>
                        }
                        @if (ShowMinimap)
                        {
                            <button type="button"
                                    class="tm-diagram-editor__panel-toggle @(!_minimapCollapsed ? "tm-diagram-editor__panel-toggle--active" : "")"
                                    title="@Loc["TmDiagramEditor_ToggleMinimap"]"
                                    aria-label="@Loc["TmDiagramEditor_PanelMinimap"]"
                                    aria-pressed="@((!_minimapCollapsed).ToString().ToLowerInvariant())"
                                    data-testid="@TestId("diagram-editor-toggle-minimap")"
                                    @onclick="ToggleMinimap">
                                <TmIcon Name="@IconNames.Map" Size="IconSize.Sm" />
                                <span class="tm-diagram-editor__panel-toggle-label">@Loc["TmDiagramEditor_PanelMinimap"]</span>
                            </button>
                        }
                    </div>
                }

                @* "⋯" view settings menu: the view and canvas-size groups live here (in the DOM
                   even while closed, so the data-tm-group contract stays stable). *@
                @if (ShowsViewMenu)
                {
                    <div class="tm-diagram-editor__view-menu" @onkeydown="OnViewMenuKeyDown">
                        @if (_viewMenuOpen)
                        {
                            <div class="tm-diagram-editor__view-menu-backdrop" @onclick="CloseViewMenu"></div>
                        }
                        <button type="button"
                                class="tm-diagram-editor__more-btn"
                                aria-expanded="@(_viewMenuOpen ? "true" : "false")"
                                aria-controls="@_viewMenuId"
                                aria-label="@(IsMobileLayout ? Loc["TmDiagramEditor_MoreActions"] : Loc["TmDiagramEditor_ViewSettings"])"
                                title="@(IsMobileLayout ? Loc["TmDiagramEditor_MoreActions"] : Loc["TmDiagramEditor_ViewSettings"])"
                                data-testid="@TestId("diagram-editor-more")"
                                @onclick="ToggleViewMenu">
                            <TmIcon Name="@IconNames.MoreHorizontal" Size="IconSize.Sm" />
                        </button>
                        <div id="@_viewMenuId" class="tm-diagram-editor__view-menu-panel" role="group"
                             aria-label="@(IsMobileLayout ? Loc["TmDiagramEditor_MoreActions"] : Loc["TmDiagramEditor_ViewSettings"])"
                             hidden="@(!_viewMenuOpen)">

                            @* Phase 7 (mobile): the compact header drops the search toggle, so the
                               "⋯" menu carries it; the read-only toggle lives here too (there is no
                               status bar row on mobile — the floating zoom owns that spot). *@
                            @if (IsMobileLayout && Shows(DiagramToolbarGroups.Search))
                            {
                                <div class="tm-diagram-editor__toolbar-group" data-tm-group="search">
                                    <TmToolbarButton Icon="@IconNames.Search"
                                                     Text="@Loc["TmDiagramEditor_Search"]"
                                                     Tooltip="@Loc["TmDiagramEditor_Search"]"
                                                     Pressed="_showSearchPanel"
                                                     OnClick="OnSearchClicked" />
                                </div>
                            }
                            @if (IsMobileLayout && ShowsReadOnlyToggle)
                            {
                                <div class="tm-diagram-editor__toolbar-group" data-tm-group="readonly">
                                    <TmToolbarButton Icon="@(IsReadOnly ? IconNames.Lock : IconNames.Unlock)"
                                                     Text="@Loc["TmDiagramEditor_ReadOnly"]"
                                                     Tooltip="@(IsReadOnly ? Loc["TmDiagramEditor_SwitchToEditMode"] : Loc["TmDiagramEditor_SwitchToReadOnlyMode"])"
                                                     Pressed="IsReadOnly"
                                                     OnClick="ToggleReadOnly" />
                                </div>
                            }

                            @* View toggles: Grid / Snap / PageView / Rulers *@
                            @if (Shows(DiagramToolbarGroups.View))
                            {
                                <div class="tm-diagram-editor__toolbar-group" data-tm-group="view">
                                    <TmToolbarButton Icon="@IconNames.Grid"
                                                     Text="@Loc[ShowGrid ? "TmDiagramEditor_HideGrid" : "TmDiagramEditor_ShowGrid"]"
                                                     Tooltip="@Loc[ShowGrid ? "TmDiagramEditor_HideGrid" : "TmDiagramEditor_ShowGrid"]"
                                                     Pressed="ShowGrid"
                                                     OnClick="OnToggleGrid" />
                                    <TmToolbarButton Icon="@IconNames.PlusCircle"
                                                     Text="@Loc[GridSize == 0 ? "TmDiagramEditor_EnableSnap" : "TmDiagramEditor_DisableSnap"]"
                                                     Tooltip="@Loc[GridSize == 0 ? "TmDiagramEditor_EnableSnap" : "TmDiagramEditor_DisableSnap"]"
                                                     Pressed="@(GridSize != 0)"
                                                     OnClick="OnToggleSnap" />
                                    <TmToolbarButton Icon="@IconNames.FileText"
                                                     Text="@Loc[ShowPageView ? "TmDiagramEditor_HidePageView" : "TmDiagramEditor_ShowPageView"]"
                                                     Tooltip="@Loc[ShowPageView ? "TmDiagramEditor_HidePageView" : "TmDiagramEditor_ShowPageView"]"
                                                     Pressed="ShowPageView"
                                                     OnClick="OnTogglePageView" />
                                    <TmToolbarButton Icon="@IconNames.Ruler"
                                                     Text="@Loc["TmDiagramEditor_ToggleRulers"]"
                                                     Tooltip="@Loc["TmDiagramEditor_ToggleRulers"]"
                                                     Pressed="_showRulers"
                                                     OnClick="ToggleRulers" />
                                </div>
                            }

                            @* Canvas size + Ruler unit *@
                            @if (Shows(DiagramToolbarGroups.CanvasSize))
                            {
                                <div class="tm-diagram-editor__toolbar-group" data-tm-group="canvas-size">
                                    <select class="tm-diagram-editor__unit-select" disabled="@IsReadOnly"
                                            aria-label="@Loc["TmDiagramEditor_RulerUnitLabel"]"
                                            title="@Loc["TmDiagramEditor_RulerUnitLabel"]"
                                            value="@(_document?.ActivePage?.RulerUnit ?? MeasurementUnit.Px)"
                                            @onchange='async e => await OnRulerUnitChanged(Enum.Parse<MeasurementUnit>(e.Value?.ToString() ?? "Px"))'>
                                        @foreach (var opt in _rulerUnitOptions)
                                        {
                                            <option value="@opt.Value">@opt.Label</option>
                                        }
                                    </select>
                                    @if (_canvasSizeEditing)
                                    {
                                        <input class="tm-diagram-editor__props-input tm-diagram-editor__canvas-size-input"
                                               type="number" min="100" max="9999" step="1"
                                               aria-label="@Loc["TmDiagramEditor_CanvasWidth"]"
                                               value="@_canvasWInput"
                                               @oninput="e => _canvasWInput = e.Value?.ToString() ?? _canvasWInput" />
                                        <span class="tm-diagram-editor__canvas-size-sep">×</span>
                                        <input class="tm-diagram-editor__props-input tm-diagram-editor__canvas-size-input"
                                               type="number" min="100" max="9999" step="1"
                                               aria-label="@Loc["TmDiagramEditor_CanvasHeight"]"
                                               value="@_canvasHInput"
                                               @oninput="e => _canvasHInput = e.Value?.ToString() ?? _canvasHInput" />
                                        <TmToolbarButton Icon="@IconNames.Check"
                                                         Tooltip="@Loc["TmDiagramEditor_Apply"]"
                                                         OnClick="ApplyCanvasSize" />
                                        <TmToolbarButton Icon="@IconNames.X"
                                                         Tooltip="@Loc["TmDiagramEditor_Cancel"]"
                                                         OnClick="() => _canvasSizeEditing = false" />
                                    }
                                    else
                                    {
                                        <TmToolbarButton Text="@($"{(int)(_document?.Width ?? 3000)}×{(int)(_document?.Height ?? 2000)}")"
                                                         Tooltip="@Loc["TmDiagramEditor_ChangeCanvasSize"]" Disabled="@IsReadOnly"
                                                         OnClick="OpenCanvasSize" />
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (HeaderActions is not null)
                {
                    @* G9 host slot: host actions close the header, after the built-in controls. *@
                    <div class="tm-diagram-editor__header-actions">@HeaderActions</div>
                }
            </div>
            }
        </Header>

        <Canvas>
            @* ── Search panel ────────────────────────────────────────────────── *@
            @if (_showSearchPanel)
            {
                <TmDiagramSearchPanel Query="@_searchQuery"
                                      QueryChanged="OnSearchQueryChanged"
                                      ResultsCount="_searchResults.Count"
                                      CurrentIndex="_searchCurrentIndex"
                                      CurrentIndexChanged="OnSearchIndexChanged"
                                      SearchAllPages="_searchAllPages"
                                      SearchAllPagesChanged="OnSearchAllPagesChanged"
                                      ReplaceQuery="@_replaceQuery"
                                      ReplaceQueryChanged="OnReplaceQueryChanged"
                                      UseRegex="_searchUseRegex"
                                      UseRegexChanged="OnSearchUseRegexChanged"
                                      RegexError="@_regexError"
                                      ReadOnly="@IsReadOnly"
                                      OnReplace="OnReplace"
                                      OnReplaceAll="OnReplaceAll"
                                      OnClose="CloseSearchPanel" />
            }

            @* ── Import / export error banners ───────────────────────────────── *@
            @if (_importError is not null)
            {
                <TmAlert Severity="AlertSeverity.Error"
                         Dismissable="true"
                         OnDismiss="() => _importError = null"
                         Class="tm-diagram-editor__banner">
                    @_importError
                </TmAlert>
            }

            @if (_exportError is not null)
            {
                <TmAlert Severity="AlertSeverity.Error"
                         Dismissable="true"
                         OnDismiss="() => _exportError = null"
                         Class="tm-diagram-editor__banner">
                    @_exportError
                </TmAlert>
            }

            <div class="tm-diagram-editor__canvas-wrap @(_showRulers ? "tm-diagram-editor__canvas-wrap--rulers" : "")">
                @if (_showRulers)
                {
                    <div class="tm-diagram-editor__ruler-corner"></div>
                    <div class="tm-diagram-editor__ruler-h">
                        <TmDiagramRuler Orientation="horizontal"
                                        ViewportX="_rulerViewportX"
                                        ViewportY="_rulerViewportY"
                                        ViewportW="_rulerViewportW"
                                        ViewportH="_rulerViewportH"
                                        Zoom="_zoomLevel"
                                        Unit="_document?.ActivePage?.RulerUnit ?? MeasurementUnit.Px"
                                        Scale="_document?.ActivePage?.PageScale ?? 1.0"
                                        CursorX="_rulerCursorX"
                                        CursorY="_rulerCursorY" />
                    </div>
                    <div class="tm-diagram-editor__ruler-v">
                        <TmDiagramRuler Orientation="vertical"
                                        ViewportX="_rulerViewportX"
                                        ViewportY="_rulerViewportY"
                                        ViewportW="_rulerViewportW"
                                        ViewportH="_rulerViewportH"
                                        Zoom="_zoomLevel"
                                        Unit="_document?.ActivePage?.RulerUnit ?? MeasurementUnit.Px"
                                        Scale="_document?.ActivePage?.PageScale ?? 1.0"
                                        CursorX="_rulerCursorX"
                                        CursorY="_rulerCursorY" />
                    </div>
                }
                <TmDiagramCanvas @ref="_canvas"
                                 Document="@_document"
                                 DocumentChanged="OnDocumentChanged"
                                 ShowGrid="@ShowGrid"
                                 GridSize="@GridSize"
                                 ReadOnly="@IsReadOnly"
                                 ShowTransformHandles="@(!IsMobileLayout)"
                                 ShowConnectArrows="@(!IsMobileLayout)"
                                 Zoom="@_zoomLevel"
                                 ShowPageView="@ShowPageView"
                                 OnSelectionChanged="OnSelectionChanged"
                                 OnToolModeChanged="OnCanvasToolModeChanged"
                                 ZoomChanged="OnCanvasZoomChanged"
                                 ViewportChanged="OnCanvasViewportChanged"
                                 OnToolboxDrop="OnToolboxDrop"
                                 OnPortMouseDownEvent="OnPortMouseDownEvent"
                                 OnEdgeCreated="OnEdgeCreated"
                                 OnNodeContextMenu="OnNodeContextMenu"
                                 OnEdgeContextMenu="OnEdgeContextMenu"
                                 OnTableCellContextMenu="OnTableCellContextMenu"
                                 OnCanvasContextMenu="OnCanvasContextMenu"
                                 OnCloseContextMenu="CloseContextMenu"
                                 OnConnectArrowClicked="OnConnectArrowClicked"
                                 OnShowSearch="OpenSearchPanel"
                                 OnShowReplace="OpenReplacePanel"
                                 OnQuickInsert="HandleQuickInsert"
                                 OnNavigateToCorner="HandleNavigateToCorner"
                                 OnSwitchPage="HandleSwitchPage"
                                 OnGroupSelected="HandleGroupSelected"
                                 OnLockSelected="HandleLockSelected"
                                 OnEnterGroup="HandleEnterGroup"
                                 OnExitGroup="HandleExitGroup"
                                 OnToggleBold="HandleToggleBold"
                                 OnToggleItalic="HandleToggleItalic"
                                 OnToggleUnderline="HandleToggleUnderline"
                                 OnNodeLinkClicked="HandleNodeLinkClicked"
                                 ActiveGroupId="@ActiveGroupId"
                                 SelectedTableCells="_selectedTableCells"
                                 OnTableCellSelect="HandleTableCellSelect"
                                 OnClearTableCellSelection="HandleClearTableCellSelection"
                                 Class="tm-diagram-editor__canvas" />
                @* ── Floating zoom overlay (phase 7, mobile): the status bar does not render on
                   a mobile layout — the + / % / − / fit pill floats over the canvas corner like
                   the minimap, outside the SVG (the mockup's left-side pill). *@
                @if (IsMobileLayout && ShowToolbar && Shows(DiagramToolbarGroups.Zoom))
                {
                    <div class="tm-diagram-editor__zoom-overlay"
                         role="group"
                         aria-label="@Loc["TmDiagramEditor_ZoomControls"]"
                         data-testid="@TestId("diagram-editor-zoom-overlay")">
                        <button type="button"
                                class="tm-diagram-editor__zoom-overlay-btn"
                                aria-label="@Loc["TmDiagramEditor_ZoomIn"]"
                                title="@Loc["TmDiagramEditor_ZoomIn"]"
                                disabled="@(!CanZoomIn)"
                                @onclick="ZoomIn">
                            <TmIcon Name="@IconNames.Plus" Size="IconSize.Sm" />
                        </button>
                        <span class="tm-diagram-editor__zoom-label" role="status" aria-live="polite" aria-label="@(string.Format(Loc["TmDiagramEditor_ZoomAria"], _zoomLabel))">@_zoomLabel</span>
                        <button type="button"
                                class="tm-diagram-editor__zoom-overlay-btn"
                                aria-label="@Loc["TmDiagramEditor_ZoomOut"]"
                                title="@Loc["TmDiagramEditor_ZoomOut"]"
                                disabled="@(!CanZoomOut)"
                                @onclick="ZoomOut">
                            <TmIcon Name="@IconNames.Minus" Size="IconSize.Sm" />
                        </button>
                        <button type="button"
                                class="tm-diagram-editor__zoom-overlay-btn"
                                aria-label="@Loc["TmDiagramEditor_FitToView"]"
                                title="@Loc["TmDiagramEditor_FitToView"]"
                                @onclick="FitToView">
                            <TmIcon Name="@IconNames.Maximize2" Size="IconSize.Sm" />
                        </button>
                    </div>
                }
                @* ── Minimap overlay (DI3, phase 6): from tablet down the minimap floats over
                   the canvas corner instead of taking a column of its own; a tap or drag on it
                   navigates the canvas. *@
                @if (ShowMinimap && MinimapAsOverlay && !_minimapCollapsed)
                {
                    <div class="tm-diagram-editor__minimap-overlay" data-testid="@TestId("diagram-editor-minimap-overlay")">
                        <TmDiagramMinimap Document="_document"
                                          SelectedIds="_selectedIds"
                                          Viewport="_minimapViewport"
                                          NavigateRequested="OnMinimapNavigate"
                                          Class="tm-diagram-editor__minimap" />
                    </div>
                }
                @* Context menu (long-press / right-click). Desktop/tablet keep the anchored
                   position:fixed menu; phase 7 (G2) presents the same commands as the shared F3
                   bottom sheet on a mobile layout — the long-press has no hover-accurate anchor
                   and a fixed menu clips at phone widths. The items are ONE fragment
                   (<see cref="ContextMenuItems"/>) so the two presentations cannot drift. *@
                @if (_contextMenuOpen && !IsMobileLayout)
                {
                    <div @ref="_contextMenuRef" class="tm-diagram-editor__context-menu" role="menu"
                         data-screen-x="@_contextMenuScreenX.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                         data-screen-y="@_contextMenuScreenY.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                         data-anchor="@(_contextMenuOrigin == "touch" ? "touch" : null)"
                         style="@($"position:fixed;left:{_contextMenuScreenX.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;top:{_contextMenuScreenY.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;z-index:1000;")"
                         @onclick:stopPropagation
                         @oncontextmenu:preventDefault>
                        @ContextMenuItems
                    </div>
                }
                @if (_contextMenuOpen && IsMobileLayout)
                {
                    <TmOverlayPanel IsOpen="true"
                                    IsOpenChanged="OnContextMenuSheetOpenChanged"
                                    MobilePresentation="PanelPresentation.Sheet"
                                    LayoutMode="TmLayoutMode.Mobile"
                                    InitialMode="TmLayoutMode.Mobile"
                                    Role="menu"
                                    Title="@Loc["TmDiagramEditor_ActionsSheetTitle"]"
                                    AriaLabel="@Loc["TmDiagramEditor_ActionsSheetTitle"]"
                                    Class="tm-diagram-editor__context-sheet">
                        @ContextMenuItems
                    </TmOverlayPanel>
                }

            </div>
        </Canvas>
    </TmEditorShell>

    @* UX review phase 4 (high): the table picker must never be a descendant of a toolbar item —
       a group that collapses into "More" turns its bar copy inert and hidden and would take the
       picker with it. It renders at the editor root as a fixed popover anchored where the user
       invoked it (the Insert trigger on the bar, the "More" trigger once collapsed); both entry
       points — the bar dropdown and the More "Table" entry — open this same surface. *@
    @if (_showTableInserter)
    {
        <div class="tm-diagram-table-inserter-popover" style="@TableInserterStyle">
            <TmDiagramTableInserter OnInsert="HandleTableInsert" />
        </div>
    }

</div>

@* Connect stencil picker (DI4): its own component — the default palette is the source
   node's stencil set, "Show all" opts into the whole node library, focus returns to the
   canvas through the modal's public focus scope. The editor's resolved layout is passed as
   the dialog's LayoutMode so the picker opens directly in grid/list form — a forced value
   never measures, so there is no grid→list flash while the modal resolves on a phone.
   The recents travel as a per-render snapshot: the internal list mutates in place, and a
   stable reference would let the renderer skip the (possibly open) dialog on a re-render. *@
<TmDiagramConnectDialog Show="@_connectModalOpen"
                        SourceStencilId="@ConnectSourceStencilId"
                        RecentStencilIds="@_recentStencilIds.ToArray()"
                        SourceLabel="@ConnectSourceLabel"
                        LayoutMode="@(LayoutMode != TmLayoutMode.Auto ? LayoutMode : _resolvedLayout)"
                        OnClose="CloseConnectModal"
                        OnStencilSelected="OnStencilSelectedForConnect"
                        RestoreFocusTarget="@(_canvas?.GetContainerRef())" />

@* SQL Import dialog *@
<TmDiagramSqlImportDialog Show="@_sqlImportDialogOpen"
                          OnClose="CloseSqlImportDialog"
                          OnImport="OnSqlImport"
                          RestoreFocusTarget="@(_canvas?.GetContainerRef())" />

@* CSV Import dialog *@
<TmDiagramCsvImportDialog Show="@_csvImportDialogOpen"
                          OnClose="CloseCsvImportDialog"
                          OnImport="OnCsvImport"
                          RestoreFocusTarget="@(_canvas?.GetContainerRef())" />

@* Template gallery *@
<TmDiagramTemplateGallery Show="@_showTemplateGallery"
                            OnClose="CloseTemplateGallery"
                            OnSelect="OnTemplateSelected"
                            RestoreFocusTarget="@(_canvas?.GetContainerRef())" />

</CascadingValue>

@* Hidden download anchor for export *@
<a @ref="_downloadAnchor" style="display:none"></a>

@code {
    /// <summary>The palette rail content (phase 6): a labelled expand affordance beside the
    /// shell's chevron, so the 44px rail names what it opens.</summary>
    private RenderFragment? ToolboxRail => ShowToolbox
        ? @<button type="button"
                   class="tm-diagram-editor__rail-btn"
                   aria-label="@Loc["TmDiagramEditor_PanelToolbox"]"
                   title="@Loc["TmDiagramEditor_PanelToolbox"]"
                   @onclick="() => SetToolboxExpandedAsync(true)">
            <TmIcon Name="@IconNames.Grid" Size="IconSize.Sm" />
        </button>
        : null;

    /// <summary>
    /// The context menu items, shared by the desktop anchored menu and the phase-7 mobile
    /// sheet. G2 gates travel here: the auto-layout entries (canvas menu) and the align /
    /// distribute entries (node menu) render from tablet up only — light mobile edits keep
    /// selection, clipboard, lock, shape replace and delete.
    /// </summary>
    private RenderFragment ContextMenuItems => @<text>
        @switch (_contextMenuType)
        {
            case ContextMenuType.Canvas:
                <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(!DiagramClipboard.HasNodes)" @onclick="ContextMenuPaste">@Loc["TmDiagramEditor_Paste"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(!DiagramClipboard.HasNodes)" @onclick="ContextMenuPasteHere">@Loc["TmDiagramEditor_PasteHere"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuSelectAll">@Loc["TmDiagramEditor_SelectAll"]</button>
                <div class="tm-diagram-editor__context-sep" role="separator"></div>
                <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(IsReadOnly || !ActiveCommandStack.CanUndo)" @onclick="ContextMenuUndo">@Loc["TmDiagramEditor_Undo"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(IsReadOnly || !ActiveCommandStack.CanRedo)" @onclick="ContextMenuRedo">@Loc["TmDiagramEditor_Redo"]</button>
                <div class="tm-diagram-editor__context-sep" role="separator"></div>
                <span class="tm-diagram-editor__context-heading">@Loc["TmDiagramEditor_Insert"]</span>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuInsertText">@Loc["TmDiagramEditor_Text"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuInsertRectangle">@Loc["TmDiagramEditor_Rectangle"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuInsertEllipse">@Loc["TmDiagramEditor_Ellipse"]</button>
                @if (!IsMobileLayout)
                {
                    <div class="tm-diagram-editor__context-sep" role="separator"></div>
                    <span class="tm-diagram-editor__context-heading">@Loc["TmDiagramEditor_Layout"]</span>
                    <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuRunLayout("dagre", "TB")'>@Loc["TmDiagramEditor_LayoutDagreTb"]</button>
                    <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuRunLayout("dagre", "LR")'>@Loc["TmDiagramEditor_LayoutDagreLr"]</button>
                    <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuRunLayout("tree", "TB")'>@Loc["TmDiagramEditor_LayoutTree"]</button>
                    <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuRunLayout("force", "")'>@Loc["TmDiagramEditor_LayoutForce"]</button>
                    <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuRunLayout("circle", "")'>@Loc["TmDiagramEditor_LayoutCircle"]</button>
                }
                <div class="tm-diagram-editor__context-sep" role="separator"></div>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuToggleGrid">@Loc[ShowGrid ? "TmDiagramEditor_HideGrid" : "TmDiagramEditor_ShowGrid"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuTogglePageView">@Loc[ShowPageView ? "TmDiagramEditor_HidePageView" : "TmDiagramEditor_ShowPageView"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuToggleSnapToGrid">@Loc[GridSize == 0 ? "TmDiagramEditor_EnableSnap" : "TmDiagramEditor_DisableSnap"]</button>
                break;

            case ContextMenuType.Node:
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuCut">@Loc["TmDiagramEditor_Cut"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuCopy">@Loc["TmDiagramEditor_Copy"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuDuplicate">@Loc["TmDiagramEditor_Duplicate"]</button>
                <div class="tm-diagram-editor__context-sep" role="separator"></div>
                <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(DiagramClipboard.Style is null)" @onclick="ContextMenuPasteStyle">@Loc["TmDiagramEditor_PasteStyle"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(DiagramClipboard.Width is null)" @onclick="ContextMenuPasteSize">@Loc["TmDiagramEditor_PasteSize"]</button>
                <div class="tm-diagram-editor__context-sep" role="separator"></div>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuBringToFront">@Loc["TmDiagramEditor_BringToFront"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuSendToBack">@Loc["TmDiagramEditor_SendToBack"]</button>
                @if (!IsMobileLayout && CanAlign)
                {
                    <div class="tm-diagram-editor__context-sep" role="separator"></div>
                    <span class="tm-diagram-editor__context-heading">@Loc["TmDiagramProperties_Distribute"]</span>
                    <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => OnAlign("left")'>@Loc["TmDiagramProperties_AlignLeft"]</button>
                    <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => OnAlign("center")'>@Loc["TmDiagramProperties_AlignCenter"]</button>
                    <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => OnAlign("right")'>@Loc["TmDiagramProperties_AlignRight"]</button>
                    <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => OnAlign("top")'>@Loc["TmDiagramProperties_AlignTop"]</button>
                    <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => OnAlign("middle")'>@Loc["TmDiagramProperties_AlignMiddle"]</button>
                    <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => OnAlign("bottom")'>@Loc["TmDiagramProperties_AlignBottom"]</button>
                    <div class="tm-diagram-editor__context-sep" role="separator"></div>
                }
                @if (!IsMobileLayout && CanDistribute)
                {
                    <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => OnDistribute("horizontal")'>@Loc["TmDiagramProperties_DistributeHorizontal"]</button>
                    <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => OnDistribute("vertical")'>@Loc["TmDiagramProperties_DistributeVertical"]</button>
                    <div class="tm-diagram-editor__context-sep" role="separator"></div>
                }
                @if (GetContextMenuNodeLocked())
                {
                    <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuUnlock">@Loc["TmDiagramEditor_Unlock"]</button>
                }
                else
                {
                    <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuLock">@Loc["TmDiagramEditor_Lock"]</button>
                }
                @if (CanContextMenuGroup())
                {
                    <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuGroup">@Loc["TmDiagramEditor_Group"]</button>
                }
                @if (CanContextMenuUngroup())
                {
                    <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuUngroup">@Loc["TmDiagramEditor_Ungroup"]</button>
                }
                <div class="tm-diagram-editor__context-sep" role="separator"></div>
                <span class="tm-diagram-editor__context-heading">@Loc["TmDiagramEditor_ChangeShape"]</span>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuReplaceShape("general.rectangle")'>@Loc["TmDiagramEditor_Rectangle"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuReplaceShape("general.ellipse")'>@Loc["TmDiagramEditor_Ellipse"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuReplaceShape("general.text")'>@Loc["TmDiagramEditor_Text"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuReplaceShape("general.diamond")'>@Loc["TmDiagramEditor_Diamond"]</button>
                <div class="tm-diagram-editor__context-sep" role="separator"></div>
                <button class="tm-diagram-editor__context-item tm-diagram-editor__context-item--danger" role="menuitem" @onclick="ContextMenuDelete">@Loc["TmDiagramEditor_Delete"]</button>
                break;

            case ContextMenuType.Edge:
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuEditEdgeLabel">@Loc["TmDiagramEditor_EditLabel"]</button>
                <div class="tm-diagram-editor__context-sep" role="separator"></div>
                <span class="tm-diagram-editor__context-heading">@Loc["TmDiagramEditor_Connector"]</span>
                <div class="tm-diagram-edge-routing-picker">
                    @{
                        var ctxEdge = _document?.Edges.FirstOrDefault(e => e.Id == _contextMenuEdgeId);
                    }
                    @foreach (var routing in new[] { "straight", "orthogonal", "elbow", "segment", "curved" })
                    {
                        <TmDiagramRoutingPreview Routing="@routing"
                                                 IsSelected="@(ctxEdge?.Routing == routing)"
                                                 OnClick="() => ContextMenuChangeEdgeConnector(routing)" />
                    }
                </div>
                <div class="tm-diagram-editor__context-sep" role="separator"></div>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuFlipEdge">@Loc["TmDiagramEditor_FlipEdge"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuClearWaypoints">@Loc["TmDiagramEditor_ClearWaypoints"]</button>
                <div class="tm-diagram-editor__context-sep" role="separator"></div>
                <span class="tm-diagram-editor__context-heading">@Loc["TmDiagramEditor_StartArrow"]</span>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeArrowheadStart("none")'>@Loc["TmDiagramEditor_ArrowNone"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeArrowheadStart("classic")'>@Loc["TmDiagramEditor_ArrowClassic"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeArrowheadStart("block")'>@Loc["TmDiagramEditor_ArrowBlock"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeArrowheadStart("crow")'>@Loc["TmDiagramEditor_ArrowCrow"]</button>
                <div class="tm-diagram-editor__context-sep" role="separator"></div>
                <span class="tm-diagram-editor__context-heading">@Loc["TmDiagramEditor_EndArrow"]</span>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeArrowheadEnd("none")'>@Loc["TmDiagramEditor_ArrowNone"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeArrowheadEnd("classic")'>@Loc["TmDiagramEditor_ArrowClassic"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeArrowheadEnd("block")'>@Loc["TmDiagramEditor_ArrowBlock"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeArrowheadEnd("crow")'>@Loc["TmDiagramEditor_ArrowCrow"]</button>
                <div class="tm-diagram-editor__context-sep" role="separator"></div>
                <span class="tm-diagram-editor__context-heading">@Loc["TmDiagramEditor_LineStyle"]</span>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="() => ContextMenuChangeEdgeLineStyle(null)">@Loc["TmDiagramEditor_LineSolid"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeLineStyle("5,5")'>@Loc["TmDiagramEditor_LineDashed"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeLineStyle("2,2")'>@Loc["TmDiagramEditor_LineDotted"]</button>
                <div class="tm-diagram-editor__context-sep" role="separator"></div>
                <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(!ContextMenuCanDetachEdgeEndpoints())" @onclick="ContextMenuDetachEdgeEndpoints">@Loc["TmDiagramEditor_DetachEndpoints"]</button>
                <div class="tm-diagram-editor__context-sep" role="separator"></div>
                <button class="tm-diagram-editor__context-item tm-diagram-editor__context-item--danger" role="menuitem" @onclick="ContextMenuDeleteEdge">@Loc["TmDiagramEditor_Delete"]</button>
                break;

            case ContextMenuType.TableCell:
                <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(IsReadOnly || IsContextMenuNodeLocked())" @onclick="ContextMenuInsertRowAbove">@Loc["TmDiagramEditor_InsertRowAbove"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(IsReadOnly || IsContextMenuNodeLocked())" @onclick="ContextMenuInsertRowBelow">@Loc["TmDiagramEditor_InsertRowBelow"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(IsReadOnly || IsContextMenuNodeLocked())" @onclick="ContextMenuInsertColumnLeft">@Loc["TmDiagramEditor_InsertColumnLeft"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(IsReadOnly || IsContextMenuNodeLocked())" @onclick="ContextMenuInsertColumnRight">@Loc["TmDiagramEditor_InsertColumnRight"]</button>
                <div class="tm-diagram-editor__context-sep" role="separator"></div>
                <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(IsReadOnly || IsContextMenuNodeLocked() || !CanContextMenuMergeCells())" @onclick="ContextMenuMergeCells">@Loc["TmDiagramEditor_MergeCells"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(IsReadOnly || IsContextMenuNodeLocked() || !CanContextMenuSplitCell())" @onclick="ContextMenuSplitCell">@Loc["TmDiagramEditor_SplitCell"]</button>
                <div class="tm-diagram-editor__context-sep" role="separator"></div>
                <span class="tm-diagram-editor__context-heading">@Loc["TmDiagramEditor_FormatCell"]</span>
                <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(IsReadOnly || IsContextMenuNodeLocked())" @onclick='() => ContextMenuFormatTableCell("#ffffff", "#e5e7eb")'>@Loc["TmDiagramEditor_CellWhite"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(IsReadOnly || IsContextMenuNodeLocked())" @onclick='() => ContextMenuFormatTableCell("#f3f4f6", "#d1d5db")'>@Loc["TmDiagramEditor_CellLightGray"]</button>
                <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(IsReadOnly || IsContextMenuNodeLocked())" @onclick='() => ContextMenuFormatTableCell("#d1d5db", "#9ca3af")'>@Loc["TmDiagramEditor_CellGray"]</button>
                break;
        }
    </text>;

    /// <summary>The left dock: the stencil toolbox (null when the host hides it or a mobile
    /// viewer presentation suppresses the editing panels, G2).</summary>
    private RenderFragment? LeftSlot
    {
        get
        {
            if (!ShowToolbox || (IsMobileLayout && !MobilePanelsAllowed)) return null;
            return @<div class="tm-diagram-editor__toolbox-wrap">
                <TmDiagramToolbox StencilDragStart="OnToolboxDragStart"
                                  StencilKeyboardInsert="HandleQuickInsert"
                                  ReadOnly="@IsReadOnly"
                                  Class="tm-diagram-editor__toolbox" />
            </div>;
        }
    }

    /// <summary>The right dock: the inspector (tabs or stacked, DI2) above the collapsible minimap card.
    /// On a mobile layout the card never renders (the minimap is an overlay) and a viewer gets no panel.</summary>
    private RenderFragment? RightSlot
    {
        get
        {
            if (IsMobileLayout)
            {
                if (!MobilePanelsAllowed || !InspectorVisible) return null;
            }
            else if (!InspectorVisible && !ShowsMinimapCard) return null;
            return @<div class="tm-diagram-editor__right-stack">
                @if (InspectorVisible)
                {
                    <div class="tm-diagram-editor__inspector"
                         data-inspector-layout="@InspectorLayout.ToString().ToLowerInvariant()"
                         data-testid="@TestId("diagram-editor-inspector")">
                        @if (InspectorLayout == DiagramInspectorLayout.Tabs && InspectorHasTabs)
                        {
                            <TmTabs ActiveTabId="@EffectiveInspectorTab"
                                    ActiveTabIdChanged="SelectInspectorTab"
                                    Class="tm-diagram-editor__inspector-tabs">
                                <TmTabPanel Id="properties" Title="@Loc["TmDiagramInspector_PropertiesTab"]">
                                    <div class="tm-diagram-editor__props-wrap">
                                        <TmDiagramPropertiesPanel Document="_document"
                                                                  DocumentChanged="OnDocumentChanged"
                                                                  SelectedIds="_selectedIds"
                                                                  OnEdgeRoutingChanged="HandleEdgeRoutingChanged"
                                                                  OnEdgeManualRoutingChanged="HandleEdgeManualRoutingChanged"
                                                                  OnApplyLayout="args => RunLayout(args.Algorithm, args.Direction)"
                                                                  OnPageSizeChanged="HandlePageSizeChanged"
                                                                  OnDeleteRequested="OnDeleteClicked"
                                                                  SelectedTableCells="_selectedTableCells"
                                                                  SelectedTableCellsChanged="OnSelectedTableCellsChanged"
                                                                  ReadOnly="@IsReadOnly"
                                                                  Class="tm-diagram-editor__props" />
                                    </div>
                                </TmTabPanel>
                                <TmTabPanel Id="layers" Title="@Loc["TmDiagramInspector_LayersTab"]">
                                    <div class="tm-diagram-editor__layers-wrap">
                                        <TmDiagramLayersPanel Document="_document"
                                                              DocumentChanged="OnDocumentChanged"
                                                              SelectedIds="_selectedIds"
                                                              ActiveLayerId="@_activeLayerId"
                                                              ActiveLayerIdChanged="id => _activeLayerId = id"
                                                              ReadOnly="@IsReadOnly"
                                                              ShowCollapseToggle="false"
                                                              RowMenuPresentation="@(IsMobileLayout ? PanelPresentation.Sheet : PanelPresentation.Popover)"
                                                              Class="tm-diagram-editor__layers" />
                                    </div>
                                </TmTabPanel>
                            </TmTabs>
                        }
                        else
                        {
                            @* Opt-in legacy layout: both panels stacked in one column (G5 aliases). *@
                            <div class="tm-diagram-editor__right-wrap">
                                @if (ShowPropertiesPanel && !_propsCollapsed)
                                {
                                    <div class="tm-diagram-editor__props-wrap">
                                        <TmDiagramPropertiesPanel Document="_document"
                                                                  DocumentChanged="OnDocumentChanged"
                                                                  SelectedIds="_selectedIds"
                                                                  OnEdgeRoutingChanged="HandleEdgeRoutingChanged"
                                                                  OnEdgeManualRoutingChanged="HandleEdgeManualRoutingChanged"
                                                                  OnApplyLayout="args => RunLayout(args.Algorithm, args.Direction)"
                                                                  OnPageSizeChanged="HandlePageSizeChanged"
                                                                  OnDeleteRequested="OnDeleteClicked"
                                                                  SelectedTableCells="_selectedTableCells"
                                                                  SelectedTableCellsChanged="OnSelectedTableCellsChanged"
                                                                  ReadOnly="@IsReadOnly"
                                                                  Class="tm-diagram-editor__props" />
                                    </div>
                                }
                                @if (ShowLayersPanel && !_layersCollapsed)
                                {
                                    <div class="tm-diagram-editor__layers-wrap">
                                        <TmDiagramLayersPanel Document="_document"
                                                              DocumentChanged="OnDocumentChanged"
                                                              SelectedIds="_selectedIds"
                                                              ActiveLayerId="@_activeLayerId"
                                                              ActiveLayerIdChanged="id => _activeLayerId = id"
                                                              ReadOnly="@IsReadOnly"
                                                              ShowCollapseToggle="false"
                                                              RowMenuPresentation="@(IsMobileLayout ? PanelPresentation.Sheet : PanelPresentation.Popover)"
                                                              Class="tm-diagram-editor__layers" />
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                @if (ShowsMinimapCard)
                {
                    <div class="tm-diagram-editor__minimap-card" data-testid="@TestId("diagram-editor-minimap-card")">
                        <button type="button"
                                class="tm-diagram-editor__minimap-card-toggle"
                                aria-expanded="@(!_minimapCollapsed ? "true" : "false")"
                                title="@Loc["TmDiagramEditor_ToggleMinimap"]"
                                @onclick="ToggleMinimap">
                            <TmIcon Name="@IconNames.Map" Size="IconSize.Sm" />
                            <span class="tm-diagram-editor__minimap-card-title">@Loc["TmDiagramEditor_PanelMinimap"]</span>
                            <TmIcon Name="@(_minimapCollapsed ? IconNames.ChevronDown : IconNames.ChevronUp)" Size="IconSize.Sm" />
                        </button>
                        @if (!_minimapCollapsed)
                        {
                            <div class="tm-diagram-editor__minimap-body">
                                <TmDiagramMinimap Document="_document"
                                                  SelectedIds="_selectedIds"
                                                  Viewport="_minimapViewport"
                                                  NavigateRequested="OnMinimapNavigate"
                                                  Class="tm-diagram-editor__minimap" />
                            </div>
                        }
                    </div>
                }
            </div>;
        }
    }

    /// <summary>The single command row: a core TmToolbar with the stable data-tm-group contract,
    /// Priority-driven overflow into its "More" menu and visible labels (desktop mockup).</summary>
    private RenderFragment? ToolbarSlot
    {
        get
        {
            if (!HasCommandToolbar) return null;
            return @<div class="tm-diagram-editor__toolbar"
                         role="group"
                         aria-label="@Loc["TmDiagramEditor_ToolbarAriaLabel"]"
                         data-testid="@TestId("diagram-editor-toolbar")">
                <TmToolbar Overflow="ToolbarOverflow.Menu"
                           Labels="ToolbarLabels.IconsWithText"
                           AriaLabel="@Loc["TmDiagramEditor_ToolbarAriaLabel"]"
                           Class="tm-diagram-editor__commandbar">

                    @* History: Undo / Redo *@
                    @if (Shows(DiagramToolbarGroups.History))
                    {
                        <TmToolbarGroup Label="@Loc["TmDiagramEditor_GroupHistory"]"
                                        Class="tm-diagram-editor__toolbar-group"
                                        data-tm-group="history">
                            <TmToolbarButton Icon="@IconNames.RotateCcw"
                                             Text="@Loc["TmDiagramEditor_Undo"]"
                                             Tooltip="@($"{Loc["TmDiagramEditor_Undo"]} {ActiveCommandStack.NextUndoName}")"
                                             LabelPosition="ToolbarLabelPosition.Below"
                                             Disabled="@(!ActiveCommandStack.CanUndo || IsReadOnly)"
                                             OnClick="OnUndoClicked" />
                            <TmToolbarButton Icon="@IconNames.RotateCw"
                                             Text="@Loc["TmDiagramEditor_Redo"]"
                                             Tooltip="@($"{Loc["TmDiagramEditor_Redo"]} {ActiveCommandStack.NextRedoName}")"
                                             LabelPosition="ToolbarLabelPosition.Below"
                                             Disabled="@(!ActiveCommandStack.CanRedo || IsReadOnly)"
                                             OnClick="OnRedoClicked" />
                        </TmToolbarGroup>
                    }

                    @* Clipboard: Cut / Copy / Paste / Duplicate / Delete *@
                    @if (Shows(DiagramToolbarGroups.Clipboard))
                    {
                        <TmToolbarGroup Label="@Loc["TmDiagramEditor_GroupClipboard"]"
                                        Class="tm-diagram-editor__toolbar-group"
                                        data-tm-group="clipboard">
                            <TmToolbarButton Icon="@IconNames.Scissors" Text="@Loc["TmDiagramEditor_Cut"]" Tooltip="@Loc["TmDiagramEditor_Cut"]" LabelPosition="ToolbarLabelPosition.Below" Disabled="@(_selectedIds.Length == 0 || IsReadOnly)" OnClick="OnCutClicked" />
                            <TmToolbarButton Icon="@IconNames.Copy" Text="@Loc["TmDiagramEditor_Copy"]" Tooltip="@Loc["TmDiagramEditor_Copy"]" LabelPosition="ToolbarLabelPosition.Below" Disabled="@(_selectedIds.Length == 0 || IsReadOnly)" OnClick="OnCopyClicked" />
                            <TmToolbarButton Icon="@IconNames.Clipboard" Text="@Loc["TmDiagramEditor_Paste"]" Tooltip="@Loc["TmDiagramEditor_Paste"]" LabelPosition="ToolbarLabelPosition.Below" Disabled="@IsReadOnly" OnClick="OnPasteClicked" />
                            <TmToolbarButton Icon="@DiagramEditorIconNames.Duplicate" Text="@Loc["TmDiagramEditor_Duplicate"]" Tooltip="@Loc["TmDiagramEditor_Duplicate"]" LabelPosition="ToolbarLabelPosition.Below" Disabled="@(_selectedIds.Length == 0 || IsReadOnly)" OnClick="OnDuplicateClicked" />
                            <TmToolbarButton Icon="@IconNames.Trash" Text="@Loc["TmDiagramEditor_Delete"]" Tooltip="@Loc["TmDiagramEditor_Delete"]" LabelPosition="ToolbarLabelPosition.Below" Disabled="@(_selectedIds.Length == 0 || IsReadOnly)" OnClick="OnDeleteClicked" />
                        </TmToolbarGroup>
                    }

                    @* Tool mode: Select / Pan / Edge *@
                    @if (Shows(DiagramToolbarGroups.Tools))
                    {
                        <TmToolbarGroup Label="@Loc["TmDiagramEditor_GroupTools"]"
                                        Class="tm-diagram-editor__toolbar-group"
                                        data-tm-group="tools">
                            <TmToolbarButton Icon="@IconNames.MousePointer"
                                             Text="@Loc["TmDiagramEditor_ToolSelect"]"
                                             Tooltip="@Loc["TmDiagramEditor_SelectTool"]"
                                             LabelPosition="ToolbarLabelPosition.Below"
                                             Pressed="@(_toolMode == "select")"
                                             OnClick='() => SetToolMode("select")' />
                            <TmToolbarButton Icon="@IconNames.Hand"
                                             Text="@Loc["TmDiagramEditor_ToolPan"]"
                                             Tooltip="@Loc["TmDiagramEditor_PanToolHint"]"
                                             LabelPosition="ToolbarLabelPosition.Below"
                                             Pressed="@(_toolMode == "pan")"
                                             OnClick='() => SetToolMode("pan")' />
                            <TmToolbarButton Icon="@IconNames.ArrowRight"
                                             Text="@Loc["TmDiagramEditor_ToolEdge"]"
                                             Tooltip="@Loc["TmDiagramEditor_EdgeToolHint"]"
                                             LabelPosition="ToolbarLabelPosition.Below"
                                             Pressed="@(_toolMode == "edge")"
                                             Disabled="@IsReadOnly"
                                             OnClick='() => SetToolMode("edge")' />
                        </TmToolbarGroup>
                    }

                    @* Format painter *@
                    @if (Shows(DiagramToolbarGroups.Format))
                    {
                        <TmToolbarGroup Label="@Loc["TmDiagramEditor_GroupFormat"]"
                                        Class="tm-diagram-editor__toolbar-group"
                                        data-tm-group="format">
                            <TmToolbarButton Icon="@IconNames.Brush" Text="@Loc["TmDiagramEditor_FormatCopy"]" Tooltip="@Loc["TmDiagramEditor_CopyStyle"]" LabelPosition="ToolbarLabelPosition.Below" Priority="ToolbarButtonPriority.Secondary" Disabled="@IsReadOnly" OnClick="OnCopyStyle" />
                            <TmToolbarButton Icon="@IconNames.Paintbrush" Text="@Loc["TmDiagramEditor_FormatPaste"]" Tooltip="@Loc["TmDiagramEditor_PasteStyle"]" LabelPosition="ToolbarLabelPosition.Below" Priority="ToolbarButtonPriority.Secondary" Disabled="@IsReadOnly" OnClick="OnPasteStyle" />
                            <TmToolbarButton Icon="@IconNames.Maximize2" Text="@Loc["TmDiagramEditor_PasteSize"]" Tooltip="@Loc["TmDiagramEditor_PasteSize"]" LabelPosition="ToolbarLabelPosition.Below" Priority="ToolbarButtonPriority.Secondary" Disabled="@IsReadOnly" OnClick="OnPasteSize" />
                        </TmToolbarGroup>
                    }

                    @* Insert: Table / Text — the picker itself renders at the editor root (never
                       inside this group: a collapsed bar copy is inert and hidden), see the
                       popover below the shell. *@
                    @if (Shows(DiagramToolbarGroups.Insert))
                    {
                        <TmToolbarGroup Label="@Loc["TmDiagramEditor_Insert"]"
                                        Class="tm-diagram-editor__toolbar-group tm-diagram-insert-dropdown"
                                        data-tm-group="insert">
                            <TmToolbarItem MenuLabel="@Loc["TmDiagramEditor_Insert"]"
                                           Priority="ToolbarButtonPriority.Primary"
                                           MenuItems="@BuildInsertMenuItems()">
                                <TmDropdown Text="@Loc["TmDiagramEditor_Insert"]" Icon="@IconNames.Plus" Disabled="@IsReadOnly" OnSelect="HandleInsertSelect">
                                    <TmDropdownItem Value="table" Icon="@IconNames.Grid">@Loc["TmDiagramEditor_InsertTable"]</TmDropdownItem>
                                    <TmDropdownItem Value="text" Icon="@IconNames.Type">@Loc["TmDiagramEditor_InsertText"]</TmDropdownItem>
                                </TmDropdown>
                            </TmToolbarItem>
                        </TmToolbarGroup>
                    }

                    @* Arrange: Align / Distribute *@
                    @if (Shows(DiagramToolbarGroups.Arrange))
                    {
                        <TmToolbarGroup Label="@Loc["TmDiagramProperties_Distribute"]"
                                        Class="tm-diagram-editor__toolbar-group"
                                        data-tm-group="arrange">
                            <TmToolbarItem MenuLabel="@Loc["TmDiagramProperties_Distribute"]"
                                           Priority="ToolbarButtonPriority.Secondary"
                                           MenuItems="@BuildArrangeMenuItems()"
                                           Class="tm-diagram-arrange-dropdown">
                                <TmDropdown Text="@Loc["TmDiagramProperties_Distribute"]" Icon="@IconNames.Layout" Disabled="@(!CanAlign || IsReadOnly)" OnSelect="HandleArrangeSelect" Class="tm-diagram-arrange-dropdown">
                                    <TmDropdownItem Value="align-left" Icon="@IconNames.AlignLeft">@Loc["TmDiagramProperties_AlignLeft"]</TmDropdownItem>
                                    <TmDropdownItem Value="align-center" Icon="@IconNames.AlignCenter">@Loc["TmDiagramProperties_AlignCenter"]</TmDropdownItem>
                                    <TmDropdownItem Value="align-right" Icon="@IconNames.AlignRight">@Loc["TmDiagramProperties_AlignRight"]</TmDropdownItem>
                                    <div class="tm-dropdown-sep" role="separator"></div>
                                    <TmDropdownItem Value="align-top" Icon="@IconNames.ArrowUp">@Loc["TmDiagramProperties_AlignTop"]</TmDropdownItem>
                                    <TmDropdownItem Value="align-middle" Icon="@IconNames.AlignVerticalJustifyCenter">@Loc["TmDiagramProperties_AlignMiddle"]</TmDropdownItem>
                                    <TmDropdownItem Value="align-bottom" Icon="@IconNames.ArrowDown">@Loc["TmDiagramProperties_AlignBottom"]</TmDropdownItem>
                                    <div class="tm-dropdown-sep" role="separator"></div>
                                    <TmDropdownItem Value="distribute-horizontal">@Loc["TmDiagramProperties_DistributeHorizontal"]</TmDropdownItem>
                                    <TmDropdownItem Value="distribute-vertical">@Loc["TmDiagramProperties_DistributeVertical"]</TmDropdownItem>
                                </TmDropdown>
                            </TmToolbarItem>
                        </TmToolbarGroup>
                    }

                    @* Auto layout *@
                    @if (Shows(DiagramToolbarGroups.Layout))
                    {
                        <TmToolbarGroup Label="@Loc["TmDiagram_Layout"]"
                                        Class="tm-diagram-editor__toolbar-group"
                                        data-tm-group="layout">
                            <TmToolbarItem MenuLabel="@Loc["TmDiagram_Layout"]"
                                           Priority="ToolbarButtonPriority.Primary"
                                           MenuItems="@BuildLayoutMenuItems()">
                                <TmDropdown Text="@Loc["TmDiagram_Layout"]" Icon="@IconNames.Layout" Disabled="@IsReadOnly" OnSelect="HandleLayoutSelect">
                                    <TmDropdownItem Value="dagre-tb" Icon="@IconNames.ArrowDown">@Loc["TmDiagram_LayoutHierarchicalTopDown"]</TmDropdownItem>
                                    <TmDropdownItem Value="dagre-lr" Icon="@IconNames.ArrowRight">@Loc["TmDiagram_LayoutHierarchicalLeftRight"]</TmDropdownItem>
                                    <TmDropdownItem Value="tree-tb" Icon="@IconNames.FolderOpen">@Loc["TmDiagram_LayoutTree"]</TmDropdownItem>
                                    <TmDropdownItem Value="tree-lr" Icon="@IconNames.FolderOpen">@Loc["TmDiagram_LayoutTreeLR"]</TmDropdownItem>
                                    <TmDropdownItem Value="force" Icon="@IconNames.Zap">@Loc["TmDiagram_LayoutForce"]</TmDropdownItem>
                                    <TmDropdownItem Value="circle" Icon="@IconNames.Circle">@Loc["TmDiagram_LayoutCircle"]</TmDropdownItem>
                                    <TmDropdownItem Value="grid" Icon="@IconNames.Grid">@Loc["TmDiagram_LayoutGrid"]</TmDropdownItem>
                                </TmDropdown>
                            </TmToolbarItem>
                        </TmToolbarGroup>
                    }

                    @* Export *@
                    @if (Shows(DiagramToolbarGroups.Export))
                    {
                        <TmToolbarGroup Label="@Loc["TmDiagramEditor_Export"]"
                                        Class="tm-diagram-editor__toolbar-group"
                                        data-tm-group="export">
                            <TmToolbarItem MenuLabel="@Loc["TmDiagramEditor_Export"]"
                                           Priority="ToolbarButtonPriority.Secondary"
                                           Disabled="@_exporting"
                                           MenuItems="@BuildExportMenuItems()">
                                <TmDropdown Text="@Loc["TmDiagramEditor_Export"]" Icon="@IconNames.Download" Disabled="@_exporting" OnSelect="HandleExportSelect">
                                    @if (_exporting)
                                    {
                                        <TmSpinner Size="SpinnerSize.Xs" />
                                    }
                                    <TmDropdownItem Value="json" Icon="@IconNames.FileText">@Loc["TmDiagramEditor_ExportJson"]</TmDropdownItem>
                                    <TmDropdownItem Value="svg" Icon="@IconNames.Image">@Loc["TmDiagramEditor_ExportSvg"]</TmDropdownItem>
                                    <TmDropdownItem Value="png" Icon="@IconNames.Image">@Loc["TmDiagramEditor_ExportPng"]</TmDropdownItem>
                                    <TmDropdownItem Value="pdf" Icon="@IconNames.File">@Loc["TmDiagramEditor_ExportPdf"]</TmDropdownItem>
                                    <TmDropdownItem Value="viewportSvg" Icon="@IconNames.Image">@Loc["TmDiagramEditor_ExportViewportSvg"]</TmDropdownItem>
                                </TmDropdown>
                            </TmToolbarItem>
                        </TmToolbarGroup>
                    }

                    @* Import: pinned to the bar — the JSON file picker lives in the bar dropdown (a "More" entry cannot open the browser file dialog); SQL/CSV are also offered as menu entries. *@
                    @if (Shows(DiagramToolbarGroups.Import))
                    {
                        <TmToolbarGroup Label="@Loc["TmDiagramEditor_Import"]"
                                        Class="tm-diagram-editor__toolbar-group"
                                        data-tm-group="import">
                            <TmToolbarItem MenuLabel="@Loc["TmDiagramEditor_Import"]"
                                           Priority="ToolbarButtonPriority.Pinned"
                                           MenuItems="@BuildImportMenuItems()">
                                <TmDropdown Text="@Loc["TmDiagramEditor_Import"]" Icon="@IconNames.Upload" Disabled="@IsReadOnly" OnSelect="HandleImportSelect">
                                    <label class="tm-dropdown-item tm-diagram-editor__import-file-label" title="@Loc["TmDiagramEditor_ImportJson"]" aria-label="@Loc["TmDiagramEditor_ImportJson"]">
                                        <TmIcon Name="@IconNames.FileText" Size="IconSize.Sm" />
                                        <span>@Loc["TmDiagramEditor_ImportJson"]</span>
                                        <InputFile style="display:none;" OnChange="OnImportFile" accept=".json,.diagram.json" />
                                    </label>
                                    <TmDropdownItem Value="sql" Icon="@IconNames.Database">@Loc["TmDiagramEditor_ImportSql"]</TmDropdownItem>
                                    <TmDropdownItem Value="csv" Icon="@IconNames.FileText">@Loc["TmDiagramEditor_ImportCsv"]</TmDropdownItem>
                                </TmDropdown>
                            </TmToolbarItem>
                        </TmToolbarGroup>
                    }

                    @* Templates *@
                    @if (Shows(DiagramToolbarGroups.Templates))
                    {
                        <TmToolbarGroup Label="@Loc["TmDiagramEditor_Templates"]"
                                        Class="tm-diagram-editor__toolbar-group"
                                        data-tm-group="templates">
                            <TmToolbarButton Icon="@IconNames.FolderOpen"
                                             Text="@Loc["TmDiagramEditor_Templates"]"
                                             Tooltip="@Loc["TmDiagramEditor_Templates"]"
                                             LabelPosition="ToolbarLabelPosition.Below"
                                             Priority="ToolbarButtonPriority.Secondary" Disabled="@IsReadOnly"
                                             OnClick="OpenTemplateGallery" />
                        </TmToolbarGroup>
                    }
                </TmToolbar>
            </div>;
        }
    }

    /// <summary>The status bar: zoom controls (the .tm-diagram-editor__zoom-label selector is a
    /// Modeling E2E contract) and the read-only toggle at the far end. On a mobile layout the
    /// floating zoom overlay replaces the row (phase 7).</summary>
    private RenderFragment? StatusBarSlot
    {
        get
        {
            if (!ShowsStatusBar || IsMobileLayout) return null;
            return @<div class="tm-diagram-editor__statusbar"
                         role="group"
                         aria-label="@Loc["TmDiagramEditor_StatusBar"]"
                         data-testid="@TestId("diagram-editor-statusbar")">
                @if (Shows(DiagramToolbarGroups.Zoom))
                {
                    <div class="tm-diagram-editor__toolbar-group tm-diagram-editor__zoom-group" data-tm-group="zoom">
                        <TmToolbarButton Icon="@IconNames.Minus" Tooltip="@Loc["TmDiagramEditor_ZoomOut"]" OnClick="ZoomOut" Disabled="@(!CanZoomOut)" />
                        <span class="tm-diagram-editor__zoom-label" role="status" aria-live="polite" aria-label="@(string.Format(Loc["TmDiagramEditor_ZoomAria"], _zoomLabel))">@_zoomLabel</span>
                        <TmToolbarButton Icon="@IconNames.Plus" Tooltip="@Loc["TmDiagramEditor_ZoomIn"]" OnClick="ZoomIn" Disabled="@(!CanZoomIn)" />
                        <TmToolbarButton Icon="@IconNames.Maximize2" Tooltip="@Loc["TmDiagramEditor_FitToView"]" OnClick="FitToView" />
                    </div>
                }
                <div class="tm-diagram-editor__statusbar-spacer"></div>
                @if (ShowsReadOnlyToggle)
                {
                    @* Read-only toggle: hidden when the host pins ReadOnly (DI1) or the group is off *@
                    <div class="tm-diagram-editor__toolbar-group" data-tm-group="readonly">
                        <TmToolbarButton Icon="@(IsReadOnly ? IconNames.Lock : IconNames.Unlock)"
                                         Text="@Loc["TmDiagramEditor_ReadOnly"]"
                                         Tooltip="@(IsReadOnly ? Loc["TmDiagramEditor_SwitchToEditMode"] : Loc["TmDiagramEditor_SwitchToReadOnlyMode"])"
                                         Pressed="IsReadOnly"
                                         OnClick="ToggleReadOnly" />
                    </div>
                }
            </div>;
        }
    }
}
