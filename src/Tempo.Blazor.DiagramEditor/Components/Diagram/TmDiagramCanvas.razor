@namespace Tempo.Blazor.Components.Diagram
@inherits Tempo.Blazor.Components.TmComponentBase
@using System.Globalization
@using System.Linq
@using Tempo.Blazor.Components.Diagram.Models
@using Tempo.Blazor.Components.Diagram.Commands

<div class="tm-diagram-canvas @Class @(IsOnlyEdgeSelected() ? "tm-diagram-canvas--edge-selected" : null)"
     data-testid="@TestId("diagram-canvas")"
     tabindex="0"
     @ref="_containerRef"
     @onmousemove="OnCanvasMouseMove"
     @onmouseup="OnCanvasMouseUp"
     @onmouseleave="OnCanvasMouseUp">
    @* Unified SVG scene (4-pane structure inspired by mxGraph / draw.io) *@
    <svg @ref="_svgRef"
         id="@_svgId"
         class="tm-diagram-canvas__svg"
         viewBox="@_viewBox"
         xmlns="http://www.w3.org/2000/svg"
         aria-label="@Loc["TmDiagramCanvas_AriaLabel"]"
         style="width:100%;height:100%;display:block;overflow:hidden;">

        <defs>
            @if (ShowGrid)
            {
                <pattern id="@_gridSmallId" width="@_gs" height="@_gs" patternUnits="userSpaceOnUse">
                    <path d="M @_gs 0 L 0 0 0 @_gs" fill="none" stroke="#e5e7eb" stroke-width="0.5" />
                </pattern>
                <pattern id="@_gridLargeId" width="@_gl" height="@_gl" patternUnits="userSpaceOnUse">
                    <rect width="@_gl" height="@_gl" fill="url(#@_gridSmallId)" />
                    <path d="M @_gl 0 L 0 0 0 @_gl" fill="none" stroke="#d1d5db" stroke-width="1" />
                </pattern>
            }

            @if (ShowPageView)
            {
                <filter id="@_pageShadowFilterId" x="-50%" y="-50%" width="200%" height="200%">
                    <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="rgba(0,0,0,0.15)" />
                </filter>
            }

            @* Arrowheads are rendered as standalone SVG paths, not markers *@
        </defs>

        @* ── Pane 1 / backgroundPane: page frame, grid, model-level group bounds ───── *@
        <g class="tm-diagram-bg-pane">
        @* Canvas background + page view + grid *@
        @if (ShowPageView)
        {
            <rect x="-100000" y="-100000" width="200000" height="200000" fill="#f3f4f6" />
        }
        <rect x="0" y="0"
              width="@(Document?.Width ?? 3000)" height="@(Document?.Height ?? 2000)"
              fill="white" stroke="#d1d5db" stroke-width="1"
              rx="@(ShowPageView ? 0 : 4)"
              filter="@(ShowPageView ? $"url(#{_pageShadowFilterId})" : null)" />
        @if (ShowGrid)
        {
            <rect x="0" y="0"
                  width="@(Document?.Width ?? 3000)" height="@(Document?.Height ?? 2000)"
                  fill="url(#@_gridLargeId)"
                  pointer-events="none" />
        }

        @* Group bounds (model-level, rendered from Document.Nodes) *@
        @if (Document is not null)
        {
            var groups = Document.Nodes
                .Where(n => !string.IsNullOrEmpty(n.GroupId))
                .GroupBy(n => n.GroupId!)
                .ToList();
            @foreach (var g in groups)
            {
                // Only show bounds for groups whose container is at the current level
                var container = Document.Nodes.FirstOrDefault(n => n.Id == g.Key && n.StencilId == "general.group");
                var isAtCurrentLevel = container?.ParentGroupId == ActiveGroupId;
                var hasOldStyleGroup = container is null && string.IsNullOrEmpty(ActiveGroupId);
                if (!isAtCurrentLevel && !hasOldStyleGroup) continue;
                var minX = g.Min(n => n.X);
                var minY = g.Min(n => n.Y);
                var maxX = g.Max(n => n.X + n.W);
                var maxY = g.Max(n => n.Y + n.H);
                const double pad = 8;
                <rect class="tm-diagram-group-bounds"
                      data-group-id="@g.Key"
                      x="@F(minX - pad)" y="@F(minY - pad)"
                      width="@F(maxX - minX + pad * 2)" height="@F(maxY - minY + pad * 2)" />
            }
        }
        </g>

        @* ── Pane 2 / drawPane: scene content (edges + nodes, interleaved by ZIndex) ─
           F3.B builds a single scene list containing nodes and edges together and
           emits them in ZIndex order; at equal ZIndex, nodes come first (preserving
           the pre-F3 visual) and ties within the same kind are broken by insertion
           order — the same deterministic rule draw.io uses (mxGraph childAt). *@
        <g class="tm-diagram-scene-pane">

        @{
            var _sceneItems = new List<(string Kind, int Z, int Idx, DiagramNode? Node, DiagramEdge? Edge)>();
            if (Document is not null)
            {
                var _visibleNodes = Document.Nodes.Where(IsNodeVisible).Where(IsLayerVisible).ToList();
                for (int i = 0; i < _visibleNodes.Count; i++)
                    _sceneItems.Add(("node", _visibleNodes[i].ZIndex, i, _visibleNodes[i], null));
                var _visibleEdges = Document.Edges.Where(IsLayerVisible).ToList();
                for (int i = 0; i < _visibleEdges.Count; i++)
                    _sceneItems.Add(("edge", _visibleEdges[i].ZIndex, i, null, _visibleEdges[i]));
            }
            var _orderedScene = _sceneItems
                .OrderBy(s => s.Z)
                .ThenBy(s => s.Kind == "node" ? 0 : 1)
                .ThenBy(s => s.Idx)
                .ToList();
        }

        @foreach (var _item in _orderedScene)
        {
            if (_item.Kind == "edge")
            {
                var edge = _item.Edge!;
                var pathD = ComputeEdgePath(edge);
                var isSelected = _currentSelectionIds.Contains(edge.Id);
                <g class="tm-diagram-edge-group" data-edge-id="@edge.Id" opacity="@F(GetEdgeOpacity(edge))">
                    @* Selection outline (rendered behind the edge) *@
                    @if (isSelected)
                    {
                        <path class="tm-diagram-edge-path--selected-outline"
                              d="@pathD"
                              fill="none" />
                    }
                    @* Invisible hit path *@
                    <path class="tm-diagram-edge-hit-path"
                          d="@pathD"
                          data-edge-id="@edge.Id"
                          @onclick="e => OnEdgeClicked(edge.Id, e)"
                          @ondblclick="e => OnEdgeDoubleClicked(edge.Id, e)" />
                    @* Visible path *@
                    @if (edge.Shape == "link")
                    {
                        var offsetPathD = ComputeEdgeOffsetPath(edge, 3);
                        <path class="tm-diagram-edge-path @(isSelected ? "tm-diagram-edge-path--selected" : "") @(_activeSearchResultId == edge.Id ? "tm-diagram-search-match" : "")"
                              d="@pathD"
                              stroke="@GetEdgeColor(edge)"
                              stroke-width="@F(GetEdgeStrokeWidth(edge))"
                              stroke-dasharray="@GetEdgeStrokeDasharray(edge)"
                              fill="none" />
                        @if (!string.IsNullOrEmpty(offsetPathD))
                        {
                            <path class="tm-diagram-edge-path @(isSelected ? "tm-diagram-edge-path--selected" : "") @(_activeSearchResultId == edge.Id ? "tm-diagram-search-match" : "")"
                                  d="@offsetPathD"
                                  stroke="@GetEdgeColor(edge)"
                                  stroke-width="@F(GetEdgeStrokeWidth(edge))"
                                  stroke-dasharray="@GetEdgeStrokeDasharray(edge)"
                                  fill="none" />
                        }
                        @((MarkupString)GetArrowheadSvg(edge, true))
                        @((MarkupString)GetArrowheadSvg(edge, false))
                    }
                    else if (edge.Shape == "pipe")
                    {
                        <path class="tm-diagram-edge-path @(isSelected ? "tm-diagram-edge-path--selected" : "") @(_activeSearchResultId == edge.Id ? "tm-diagram-search-match" : "")"
                              d="@pathD"
                              stroke="@GetEdgeColor(edge)"
                              stroke-width="@F(GetEdgeStrokeWidth(edge))"
                              stroke-dasharray="@GetEdgeStrokeDasharray(edge)"
                              stroke-linecap="butt" />
                        <path d="@pathD"
                              stroke="white"
                              stroke-width="@F(Math.Max(1, GetEdgeStrokeWidth(edge) - 4))"
                              stroke-dasharray="@GetEdgeStrokeDasharray(edge)"
                              stroke-linecap="butt"
                              fill="none"
                              pointer-events="none" />
                        @((MarkupString)GetArrowheadSvg(edge, true))
                        @((MarkupString)GetArrowheadSvg(edge, false))
                    }
                    else if (edge.Shape is "blockArrow" or "doubleArrow" or "flexArrow")
                    {
                        var polygonD = ComputeBlockArrowPolygon(edge);
                        <path class="tm-diagram-edge-path @(isSelected ? "tm-diagram-edge-path--selected" : "") @(_activeSearchResultId == edge.Id ? "tm-diagram-search-match" : "")"
                              d="@polygonD"
                              stroke="@GetEdgeColor(edge)"
                              stroke-width="1"
                              stroke-linejoin="round"
                              fill="@GetEdgeColor(edge)" />
                    }
                    else
                    {
                        <path class="tm-diagram-edge-path @(isSelected ? "tm-diagram-edge-path--selected" : "") @(_activeSearchResultId == edge.Id ? "tm-diagram-search-match" : "")"
                              d="@pathD"
                              stroke="@GetEdgeColor(edge)"
                              stroke-width="@F(GetEdgeStrokeWidth(edge))"
                              stroke-dasharray="@GetEdgeStrokeDasharray(edge)"
 />
                        @((MarkupString)GetArrowheadSvg(edge, true))
                        @((MarkupString)GetArrowheadSvg(edge, false))
                    }
                    @* Edge label *@
                    @{
                        var labelPos = ComputeEdgePointAtT(edge, edge.LabelPositionT);
                    }
                    <g class="tm-diagram-edge-label-group"
                       transform="translate(@F(edge.LabelOffsetX), @F(edge.LabelOffsetY))"
                       data-edge-id="@edge.Id"
                       data-label-t="@F(edge.LabelPositionT)"
                       data-label-ox="@F(edge.LabelOffsetX)"
                       data-label-oy="@F(edge.LabelOffsetY)"
                       @onclick:stopPropagation="true" @onclick="() => OnEdgeLabelSelect(edge.Id)"
                       @ondblclick:stopPropagation="true" @ondblclick="() => OnEdgeLabelEdit(edge.Id)">
                        <rect class="tm-diagram-edge-label-hit"
                              x="@F(labelPos.X - 24)"
                              y="@F(labelPos.Y - 12)"
                              width="48"
                              height="24"
                              fill="transparent"
                              data-edge-id="@edge.Id"
                              data-label-handle="true" />
                        @if (!string.IsNullOrEmpty(edge.Label))
                        {
                            @* pointer-events:none so the label's 160x28 hit-box doesn't
                               swallow clicks on ports / nodes directly under it. Double-click
                               editing is initiated via the `rect.tm-diagram-edge-label-handle`
                               sibling (below the label group). *@
                            <foreignObject x="@F(labelPos.X - 80)" y="@F(labelPos.Y - 14)" width="160" height="28"
                                           style="pointer-events: none;">
                                <div xmlns="http://www.w3.org/1999/xhtml"
                                     class="tm-diagram-edge-label"
                                     style="display:flex;align-items:center;justify-content:center;height:100%;font-size:12px;line-height:1;">
                                    @if (edge.Style?.EnableMathJax == true && ContainsMath(edge.Label))
                                    {
                                        <span class="tm-diagram-math">@edge.Label</span>
                                    }
                                    else
                                    {
                                        @edge.Label
                                    }
                                </div>
                            </foreignObject>
                        }
                    </g>
                    @if (_editingEdgeLabelId == edge.Id)
                    {
                        <foreignObject x="@F(labelPos.X - 60)" y="@F(labelPos.Y - 14)" width="120" height="28">
                            <input @ref="_labelInputRef"
                                   class="tm-diagram-edge-label-input"
                                   value="@_editingLabelValue"
                                   @oninput="OnLabelInputChanged"
                                   @onkeydown="OnLabelInputKeyDown"
                                   @onblur="OnLabelInputBlur"
                                   @onmousedown:stopPropagation="true"
                                   @onmousemove:stopPropagation="true"
                                   @onmouseup:stopPropagation="true"
                                   @onwheel:stopPropagation="true"
                                   placeholder="@Loc["TmDiagramProperties_Label"]" />
                        </foreignObject>
                    }
                    @* Cardinality symbols *@
                    @if (!string.IsNullOrEmpty(edge.SourceCardinality))
                    {
                        var srcCard = ComputeCardinalityPosition(edge, true);
                        @((MarkupString)$"<text x=\"{F(srcCard.X)}\" y=\"{F(srcCard.Y)}\" text-anchor=\"{srcCard.TextAnchor}\" dominant-baseline=\"{srcCard.Baseline}\" class=\"tm-diagram-edge-cardinality\">{edge.SourceCardinality}</text>")
                    }
                    @if (!string.IsNullOrEmpty(edge.TargetCardinality))
                    {
                        var tgtCard = ComputeCardinalityPosition(edge, false);
                        @((MarkupString)$"<text x=\"{F(tgtCard.X)}\" y=\"{F(tgtCard.Y)}\" text-anchor=\"{tgtCard.TextAnchor}\" dominant-baseline=\"{tgtCard.Baseline}\" class=\"tm-diagram-edge-cardinality\">{edge.TargetCardinality}</text>")
                    }
                    @* Selection handles (control points) *@
                    @if (isSelected)
                    {
                        var pts = DiagramGeometryHelper.GetEdgePoints(Document, edge);
                        for (int i = 0; i < pts.Length; i++)
                        {
                            var pt = pts[i];
                            var isWaypoint = i > 0 && i < pts.Length - 1;
                            <circle class="tm-diagram-edge-handle"
                                    cx="@F(pt.X)"
                                    cy="@F(pt.Y)"
                                    r="5"
                                    data-edge-id="@edge.Id"
                                    data-handle-index="@i"
                                    data-waypoint="@(isWaypoint.ToString().ToLowerInvariant())"
                                    @ondblclick:stopPropagation="true"
                                    @ondblclick="() => OnEdgeWaypointDoubleClick(edge.Id, i)" />
                        }
                        @if (edge.Routing is "orthogonal" or "elbow" or "segment")
                        {
                            @for (int i = 0; i < pts.Length - 1; i++)
                            {
                                var midX = (pts[i].X + pts[i + 1].X) / 2.0;
                                var midY = (pts[i].Y + pts[i + 1].Y) / 2.0;
                                var isVert = Math.Abs(pts[i].X - pts[i + 1].X) < 0.5;
                                <circle class="tm-diagram-edge-handle tm-diagram-edge-segment-handle"
                                        cx="@F(midX)"
                                        cy="@F(midY)"
                                        r="4"
                                        data-edge-id="@edge.Id"
                                        data-segment-index="@i"
                                        style="cursor: @(isVert ? "col-resize" : "row-resize")" />
                            }
                        }
                        else
                        {
                            @for (int i = 0; i < pts.Length - 1; i++)
                            {
                                var midX = (pts[i].X + pts[i + 1].X) / 2.0;
                                var midY = (pts[i].Y + pts[i + 1].Y) / 2.0;
                                <circle class="tm-diagram-edge-handle tm-diagram-edge-virtual-bend"
                                        cx="@F(midX)"
                                        cy="@F(midY)"
                                        r="4"
                                        data-edge-id="@edge.Id"
                                        data-segment-index="@i" />
                            }
                        }
                        @if (edge.Routing == "orthogonal")
                        {
                            var srcNode = Document.Nodes.FirstOrDefault(n => n.Id == edge.SourceNodeId);
                            var tgtNode = Document.Nodes.FirstOrDefault(n => n.Id == edge.TargetNodeId);
                            if (srcNode is not null && string.IsNullOrEmpty(edge.SourceEdgeId))
                            {
                                var srcPort = edge.SourcePortId is not null
                                    ? srcNode.Ports.FirstOrDefault(p => p.Id == edge.SourcePortId)
                                    : srcNode.Ports.FirstOrDefault();
                                var sPort = srcPort ?? new DiagramPort { Side = PortSide.Right, Offset = 0.5 };
                                <circle class="tm-diagram-edge-handle tm-diagram-edge-handle--jetty"
                                        cx="@F(pts[0].X)" cy="@F(pts[0].Y)" r="4"
                                        data-edge-id="@edge.Id" data-jetty="source" data-jetty-side="@sPort.Side.ToString().ToLowerInvariant()" data-node-id="@edge.SourceNodeId" />
                            }
                            if (tgtNode is not null && string.IsNullOrEmpty(edge.TargetEdgeId))
                            {
                                var tgtPort = edge.TargetPortId is not null
                                    ? tgtNode.Ports.FirstOrDefault(p => p.Id == edge.TargetPortId)
                                    : tgtNode.Ports.FirstOrDefault();
                                var tPort = tgtPort ?? new DiagramPort { Side = PortSide.Left, Offset = 0.5 };
                                <circle class="tm-diagram-edge-handle tm-diagram-edge-handle--jetty"
                                        cx="@F(pts[^1].X)" cy="@F(pts[^1].Y)" r="4"
                                        data-edge-id="@edge.Id" data-jetty="target" data-jetty-side="@tPort.Side.ToString().ToLowerInvariant()" data-node-id="@edge.TargetNodeId" />
                            }
                        }
                        @* Dangling terminal handles: visible when end is dangling, OR when edge is selected and end is connected to a node (allows connected terminal drag) *@
                        bool sourceFloating = string.IsNullOrEmpty(edge.SourceNodeId) && string.IsNullOrEmpty(edge.SourceEdgeId) && edge.SourcePoint is not null;
                        bool targetFloating = string.IsNullOrEmpty(edge.TargetNodeId) && string.IsNullOrEmpty(edge.TargetEdgeId) && edge.TargetPoint is not null;
                        bool edgeSelected = _currentSelectionIds.Contains(edge.Id);
                        var sourceHandleX = sourceFloating && edge.SourcePoint is not null ? edge.SourcePoint.X : pts[0].X;
                        var sourceHandleY = sourceFloating && edge.SourcePoint is not null ? edge.SourcePoint.Y : pts[0].Y;
                        var targetHandleX = targetFloating && edge.TargetPoint is not null ? edge.TargetPoint.X : pts[^1].X;
                        var targetHandleY = targetFloating && edge.TargetPoint is not null ? edge.TargetPoint.Y : pts[^1].Y;
                        @if (sourceFloating ||
                             (edgeSelected && !string.IsNullOrEmpty(edge.SourceNodeId) && string.IsNullOrEmpty(edge.SourceEdgeId)))
                        {
                            <rect class="tm-diagram-edge-handle tm-diagram-edge-handle--dangling"
                                  x="@F(sourceHandleX - 4)" y="@F(sourceHandleY - 4)" width="8" height="8"
                                  data-edge-id="@edge.Id" data-dangling="source"
                                  data-doc-x="@F(sourceHandleX)" data-doc-y="@F(sourceHandleY)" />
                        }
                        @if (targetFloating ||
                             (edgeSelected && !string.IsNullOrEmpty(edge.TargetNodeId) && string.IsNullOrEmpty(edge.TargetEdgeId)))
                        {
                            <rect class="tm-diagram-edge-handle tm-diagram-edge-handle--dangling"
                                  x="@F(targetHandleX - 4)" y="@F(targetHandleY - 4)" width="8" height="8"
                                  data-edge-id="@edge.Id" data-dangling="target"
                                  data-doc-x="@F(targetHandleX)" data-doc-y="@F(targetHandleY)" />
                        }
                        @* Phase 3.9: subtle open-circle marker on unselected edges whose
                           endpoint is floating, so a hover reveals that the end is not
                           attached. Hidden by default, shown via CSS when hovering the
                           edge group. *@
                        @if (sourceFloating && !edgeSelected)
                        {
                            <circle class="tm-diagram-edge-floating-marker"
                                    cx="@F(sourceHandleX)" cy="@F(sourceHandleY)" r="5"
                                    data-edge-id="@edge.Id" data-floating="source"
                                    pointer-events="none" />
                        }
                        @if (targetFloating && !edgeSelected)
                        {
                            <circle class="tm-diagram-edge-floating-marker"
                                    cx="@F(targetHandleX)" cy="@F(targetHandleY)" r="5"
                                    data-edge-id="@edge.Id" data-floating="target"
                                    pointer-events="none" />
                        }
                    }
                </g>
            }
            else
            {
                var node = _item.Node!;
                var _nodeCx = F(node.W / 2.0);
                var _nodeCy = F(node.H / 2.0);
                var _nodeTransform = $"translate({F(node.X)},{F(node.Y)}) rotate({F(node.Rotation)} {_nodeCx} {_nodeCy})";
                var _nodeLayout = StencilRegistry.GetStencil(node.StencilId)?.Layout;
                var _shapeKind = _nodeLayout.GetNativeShapeKind();
                var _shapeFill = node.Style.Fill ?? _nodeLayout?.Fill ?? "#ffffff";
                var _shapeStroke = node.Style.Stroke ?? _nodeLayout?.Stroke ?? "#111827";
                var _shapeStrokeWidth = F(node.Style.StrokeWidth ?? _nodeLayout?.StrokeWidth ?? 1.5);
                var _shapeOpacity = F(node.Style.Opacity ?? 1.0);
                <g @key="@node.Id"
                   class="tm-diagram-node @(_activeSearchResultId == node.Id ? "tm-diagram-search-match" : "")"
                   data-node-id="@node.Id"
                   data-stencil-id="@node.StencilId"
                   data-source-id="@GetNodeDataString(node, "sourceId")"
                   data-model-element-id="@GetNodeDataString(node, "modelElementId")"
                   data-w="@node.W"
                   data-h="@node.H"
                   data-group-id="@node.GroupId"
                   data-parent-id="@node.ParentNodeId"
                   data-parent-group-id="@node.ParentGroupId"
                   data-locked="@(IsNodeLocked(node) ? "true" : "false")"
                   data-link="@node.Link"
                   data-shape-kind="@_shapeKind.ToString().ToLowerInvariant()"
                   transform="@_nodeTransform">
                    @* F3.E — native SVG primitive behind the foreignObject for simple stencils.
                       Custom stencils fall back to the HTML/CSS shape inside TmDiagramStencilShape. *@
                    @switch (_shapeKind)
                    {
                        case DiagramShapeKind.Rectangle:
                            <rect class="tm-diagram-node__shape-bg" data-shape-kind="rectangle"
                                  x="0" y="0" width="@F(node.W)" height="@F(node.H)"
                                  fill="@_shapeFill" stroke="@_shapeStroke"
                                  stroke-width="@_shapeStrokeWidth" opacity="@_shapeOpacity" />
                            break;
                        case DiagramShapeKind.RoundedRectangle:
                            <rect class="tm-diagram-node__shape-bg" data-shape-kind="rounded"
                                  x="0" y="0" width="@F(node.W)" height="@F(node.H)"
                                  rx="8" ry="8"
                                  fill="@_shapeFill" stroke="@_shapeStroke"
                                  stroke-width="@_shapeStrokeWidth" opacity="@_shapeOpacity" />
                            break;
                        case DiagramShapeKind.Ellipse:
                            <ellipse class="tm-diagram-node__shape-bg" data-shape-kind="ellipse"
                                     cx="@_nodeCx" cy="@_nodeCy"
                                     rx="@F(node.W / 2.0)" ry="@F(node.H / 2.0)"
                                     fill="@_shapeFill" stroke="@_shapeStroke"
                                     stroke-width="@_shapeStrokeWidth" opacity="@_shapeOpacity" />
                            break;
                        case DiagramShapeKind.Diamond:
                            <polygon class="tm-diagram-node__shape-bg" data-shape-kind="diamond"
                                     points="@($"{_nodeCx},0 {F(node.W)},{_nodeCy} {_nodeCx},{F(node.H)} 0,{_nodeCy}")"
                                     fill="@_shapeFill" stroke="@_shapeStroke"
                                     stroke-width="@_shapeStrokeWidth" opacity="@_shapeOpacity" />
                            break;
                        case DiagramShapeKind.Triangle:
                            <polygon class="tm-diagram-node__shape-bg" data-shape-kind="triangle"
                                     points="@($"{_nodeCx},0 {F(node.W)},{F(node.H)} 0,{F(node.H)}")"
                                     fill="@_shapeFill" stroke="@_shapeStroke"
                                     stroke-width="@_shapeStrokeWidth" opacity="@_shapeOpacity" />
                            break;
                        case DiagramShapeKind.Hexagon:
                            <polygon class="tm-diagram-node__shape-bg" data-shape-kind="hexagon"
                                     points="@($"{F(node.W * 0.25)},0 {F(node.W * 0.75)},0 {F(node.W)},{_nodeCy} {F(node.W * 0.75)},{F(node.H)} {F(node.W * 0.25)},{F(node.H)} 0,{_nodeCy}")"
                                     fill="@_shapeFill" stroke="@_shapeStroke"
                                     stroke-width="@_shapeStrokeWidth" opacity="@_shapeOpacity" />
                            break;
                        case DiagramShapeKind.Parallelogram:
                            <polygon class="tm-diagram-node__shape-bg" data-shape-kind="parallelogram"
                                     points="@($"{F(node.W * 0.2)},0 {F(node.W)},0 {F(node.W * 0.8)},{F(node.H)} 0,{F(node.H)}")"
                                     fill="@_shapeFill" stroke="@_shapeStroke"
                                     stroke-width="@_shapeStrokeWidth" opacity="@_shapeOpacity" />
                            break;
                    }
                    <foreignObject x="0" y="0"
                                   width="@F(node.W)" height="@F(node.H)"
                                   class="tm-diagram-node__fo"
                                   style="overflow: visible;">
                        <div xmlns="http://www.w3.org/1999/xhtml" class="tm-diagram-node__body"
                             data-native-shape="@(_shapeKind != DiagramShapeKind.Custom ? "true" : "false")">
                            <TmDiagramStencilShape Node="node"
                                                   IsSelected="_currentSelectionIds.Contains(node.Id)"
                                                   ReadOnly="ReadOnly"
                                                   OnPortMouseDownEvent="(portId) => HandlePortMouseDown(node.Id, portId)"
                                                   OnSectionEdit="(args) => HandleSectionEdit(node.Id, args.DataKey, args.Value)"
                                                   SelectedTableCells="SelectedTableCells"
                                                   Page="Document?.ActivePage"
                                                   Document="Document" />

                        @if (node.IsCollapsible && !ReadOnly)
                        {
                            <button type="button"
                                    class="tm-diagram-node__collapse-btn"
                                    aria-label="@(node.Collapsed ? Loc["TmDiagramNode_Expand"] : Loc["TmDiagramNode_Collapse"])"
                                    title="@(node.Collapsed ? Loc["TmDiagramNode_Expand"] : Loc["TmDiagramNode_Collapse"])"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => ToggleCollapse(node.Id)">
                                <span>@(node.Collapsed ? "+" : "−")</span>
                            </button>
                        }

                        @if (_currentSelectionIds.Contains(node.Id) && IsNodeLocked(node))
                        {
                            <div class="tm-diagram-node__lock-indicator"
                                 title="@Loc["TmDiagramNode_Locked"]"
                                 aria-label="@Loc["TmDiagramNode_Locked"]"
                                 style="position:absolute;right:4px;bottom:4px;width:14px;height:14px;pointer-events:none;z-index:100;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:100%;height:100%;display:block;">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                </svg>
                            </div>
                        }

                        @* F5: resize / rotate / connect-arrow handles rendered into
                           `.tm-diagram-decorator-pane` below so they (a) are not
                           clipped by the node's foreignObject box and (b) stack
                           above every other pane regardless of Z-order. *@
                        </div>
                    </foreignObject>

                    @* Ports + connection points rendered as SVG primitives OUTSIDE the
                       <foreignObject>. Chromium's hit-testing clips <foreignObject> to
                       its x/y/width/height box and — more importantly — treats the
                       foreignObject itself as the hit target even when `pointer-events`
                       is none on it, so HTML ports positioned at the node's edges are
                       not reliably clickable. Keeping ports as native SVG ensures
                       `document.elementFromPoint` / real mouse events target the port
                       element, matching draw.io's approach. *@
                    @if (!ReadOnly)
                    {
                        @foreach (var port in node.Ports)
                        {
                            if (node is { IsCollapsible: true, Collapsed: true } && port.Side is not (PortSide.Top or PortSide.Bottom))
                                continue;
                            var (absX, absY) = DiagramGeometryHelper.ComputePortPosition(node, port);
                            var px = absX - node.X;
                            var py = absY - node.Y;
                            <circle class="tm-diagram-port"
                                    data-port-id="@port.Id"
                                    cx="@F(px)"
                                    cy="@F(py)"
                                    r="5"
                                    @onmousedown:stopPropagation="true"
                                    @onmousedown="() => HandlePortMouseDown(node.Id, port.Id)"
                                    @onmouseenter="() => HandlePortMouseEnter(node.Id, port.Id)"
                                    @onmouseleave="() => HandlePortMouseLeave(node.Id, port.Id)">
                                <title>@port.Name</title>
                            </circle>
                        }

                        var _cpStencil = StencilRegistry.GetStencil(node.StencilId);
                        if (_cpStencil?.ConnectionPoints.Count > 0)
                        {
                            foreach (var cp in _cpStencil.ConnectionPoints)
                            {
                                var (cpx, cpy) = GetConnectionPointPosition(node, cp);
                                <circle class="tm-diagram-connection-point"
                                        data-cp-rx="@F(cp.RelativeX)"
                                        data-cp-ry="@F(cp.RelativeY)"
                                        data-cp-perimeter="@(cp.Perimeter.ToString().ToLowerInvariant())"
                                        cx="@F(cpx)"
                                        cy="@F(cpy)"
                                        r="4">
                                    <title>@cp.Name</title>
                                </circle>
                            }
                        }
                    }
                </g>
            }
        }

        @* Inline toolbar for the selected edge — still rendered in scene-pane; it
           will move into decorator-pane in F5 alongside the other handle visuals. *@
        @{
            var _toolbarEdge = Document?.Edges.FirstOrDefault(e => _currentSelectionIds.Contains(e.Id));
        }
        @if (_toolbarEdge is not null && _currentSelectionIds.Length == 1 && Document is not null)
        {
            var _toolbarPts = DiagramGeometryHelper.GetEdgePoints(Document, _toolbarEdge);
            var _toolbarMidX = (_toolbarPts[0].X + _toolbarPts[^1].X) / 2;
            var _toolbarMidY = (_toolbarPts[0].Y + _toolbarPts[^1].Y) / 2;
            <foreignObject x="@F(_toolbarMidX - 75)" y="@F(_toolbarMidY - 48)" width="150" height="36" style="pointer-events: none;">
                <div class="tm-diagram-edge-toolbar" xmlns="http://www.w3.org/1999/xhtml">
                    <button type="button" @onclick='() => OnEdgeToolbarAction(_toolbarEdge.Id, "flip")' @onclick:stopPropagation="true" @onmousedown:stopPropagation="true" data-action="flip" title="@Loc["TmDiagramCanvas_Flip"]">↔</button>
                    <button type="button" @onclick='() => OnEdgeToolbarAction(_toolbarEdge.Id, "clearWaypoints")' @onclick:stopPropagation="true" @onmousedown:stopPropagation="true" data-action="clearWaypoints" title="@Loc["TmDiagramCanvas_ClearWaypoints"]">⬡</button>
                    <button type="button" @onclick='() => OnEdgeToolbarAction(_toolbarEdge.Id, "straight")' @onclick:stopPropagation="true" @onmousedown:stopPropagation="true" data-action="straight" title="@Loc["TmDiagramCanvas_Straight"]">─</button>
                    <button type="button" @onclick='() => OnEdgeToolbarAction(_toolbarEdge.Id, "orthogonal")' @onclick:stopPropagation="true" @onmousedown:stopPropagation="true" data-action="orthogonal" title="@Loc["TmDiagramCanvas_Orthogonal"]">┐</button>
                    <button type="button" @onclick='() => OnEdgeToolbarAction(_toolbarEdge.Id, "elbow")' @onclick:stopPropagation="true" @onmousedown:stopPropagation="true" data-action="elbow" title="@Loc["TmDiagramCanvas_Elbow"]">└</button>
                    <button type="button" @onclick='() => OnEdgeToolbarAction(_toolbarEdge.Id, "curved")' @onclick:stopPropagation="true" @onmousedown:stopPropagation="true" data-action="curved" title="@Loc["TmDiagramCanvas_Curved"]">~</button>
                </div>
            </foreignObject>
        }

        </g>
        @* ── Pane 3 / overlayPane: selection outlines (JS SVG &lt;rect&gt;), future transient overlays ──── *@
        <g class="tm-diagram-overlay-pane"></g>

        @* ── Pane 4 / decoratorPane: resize/rotate handles, connect arrows, edge waypoint handles ──────── *@
        <g class="tm-diagram-decorator-pane">
            @* F5 — per-node handles group. Each selected, non-locked, non-readonly
               node gets a single <g class="tm-diagram-node-handles"> mirroring its
               translate()+rotate() SVG transform. Handles themselves are laid out
               in node-local coordinates (0..W, 0..H) so rotation follows the node.
               JS `_updateSelection{,Transforms}` keeps this <g>'s transform in
               sync during drags (see diagram-editor.js _updateNodeHandles). *@
            @if (Document is not null && !ReadOnly)
            {
                @foreach (var _sid in _currentSelectionIds)
                {
                    var _hNode = Document.Nodes.FirstOrDefault(n => n.Id == _sid);
                    if (_hNode is null || IsNodeLocked(_hNode)) continue;
                    var _hCx = F(_hNode.W / 2.0);
                    var _hCy = F(_hNode.H / 2.0);
                    var _hW = F(_hNode.W);
                    var _hH = F(_hNode.H);
                    var _hTx = $"translate({F(_hNode.X)},{F(_hNode.Y)}) rotate({F(_hNode.Rotation)} {_hCx} {_hCy})";

                    <g class="tm-diagram-node-handles" data-node-id="@_hNode.Id" transform="@_hTx">
                        @* Phase 6 (tablet and touch): each direction renders the visible 8x8
                           square PLUS an enlarged invisible hit rect centred on the same point.
                           The hit rect carries the gesture — Pointer Events, so a finger drives
                           it — and its size comes from --tm-diagram-handle-hit (44 on a coarse
                           pointer). Cursor hint per handle so the user sees the correct arrow
                           before pressing. *@
                        @foreach (var _h in _resizeHandles)
                        {
                            var (_cx, _cy, _cur) = _h switch
                            {
                                "nw" => (0.0, 0.0, "nw-resize"),
                                "n"  => (_hNode.W / 2.0, 0.0, "n-resize"),
                                "ne" => (_hNode.W, 0.0, "ne-resize"),
                                "e"  => (_hNode.W, _hNode.H / 2.0, "e-resize"),
                                "se" => (_hNode.W, _hNode.H, "se-resize"),
                                "s"  => (_hNode.W / 2.0, _hNode.H, "s-resize"),
                                "sw" => (0.0, _hNode.H, "sw-resize"),
                                "w"  => (0.0, _hNode.H / 2.0, "w-resize"),
                                _    => (0.0, 0.0, "default"),
                            };
                            <rect class="tm-diagram-resize-handle tm-diagram-resize-handle--@_h"
                                  x="@F(_cx - 4.0)" y="@F(_cy - 4.0)" width="8" height="8"
                                  style="cursor: @_cur; pointer-events: none;" />
                            <rect class="tm-diagram-resize-handle-hit"
                                  data-resize-handle="@_h"
                                  x="@F(_cx)" y="@F(_cy)"
                                  style="cursor: @_cur;"
                                  @onpointerdown:stopPropagation="true"
                                  @onpointerdown="e => OnResizeStart(e, _hNode.Id, _h)" />
                        }

                        @* Rotate handle — stem line + grab circle centered above top edge,
                           with the same enlarged invisible hit circle (phase 6). *@
                        <line class="tm-diagram-rotate-handle-stem"
                              x1="@_hCx" y1="-30" x2="@_hCx" y2="0" />
                        <circle class="tm-diagram-rotate-handle"
                                cx="@_hCx" cy="-38" r="7"
                                style="pointer-events: none;">
                            <title>@Loc["TmDiagramEditor_RotateHandleLabel"]</title>
                        </circle>
                        <circle class="tm-diagram-rotate-handle-hit"
                                cx="@_hCx" cy="-38"
                                style="cursor: grab;"
                                @onpointerdown:stopPropagation="true"
                                @onpointerdown="e => OnRotateStartPointer(e, _hNode.Id)">
                            <title>@Loc["TmDiagramEditor_RotateHandleLabel"]</title>
                        </circle>

                        @* Quick-connect arrows N/E/S/W (<foreignObject><button> for a11y). *@
                        @foreach (var _dir in _connectDirections)
                        {
                            var (_ax, _ay) = _dir.Css switch
                            {
                                "n" => (_hNode.W / 2.0 - 11.0, -24.0),
                                "e" => (_hNode.W + 2.0, _hNode.H / 2.0 - 11.0),
                                "s" => (_hNode.W / 2.0 - 11.0, _hNode.H + 2.0),
                                "w" => (-24.0, _hNode.H / 2.0 - 11.0),
                                _   => (0.0, 0.0),
                            };
                            <foreignObject class="tm-diagram-connect-arrow-wrap"
                                           x="@F(_ax)" y="@F(_ay)" width="22" height="22">
                                <button xmlns="http://www.w3.org/1999/xhtml"
                                        type="button"
                                        class="tm-diagram-connect-arrow tm-diagram-connect-arrow--@_dir.Css"
                                        aria-label="@Loc[$"TmDiagramEditor_ConnectArrow{_dir.Label}"]"
                                        title="@Loc[$"TmDiagramEditor_ConnectArrow{_dir.Label}"]"
                                        @onmousedown:stopPropagation="true"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => HandleConnectArrowClicked(_hNode.Id, _dir.Css)">
                                    <span class="tm-diagram-connect-arrow__icon">+</span>
                                </button>
                            </foreignObject>
                        }
                    </g>
                }
            }
        </g>

    </svg>

</div>
