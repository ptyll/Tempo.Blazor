@namespace Tempo.Blazor.Components.Diagram
@using Tempo.Blazor.Components.Diagram.Templates
@using Tempo.Blazor.Components.Icons
@using Microsoft.AspNetCore.Components.Web

@* Mockup: vertical cards — preview on top, then name, category and tags (category + tags clamped
   to two lines). role=button on a div is NOT natively activatable — Enter (keydown,
   repeat-guarded) and Space (keyup) are emulated here per docs/keyboard-activation-convention.md,
   exactly one activation per press. Enter is the keyboard twin of the mockup's double-click and
   creates the template right away; Space taps the card into the selected state. *@
<div class="tm-diagram-template-card @(_selected ? "tm-diagram-template-card--selected" : "")"
     @onclick="() => OnClick.InvokeAsync()"
     @ondblclick="OnCardActivate"
     @onkeydown="OnCardKeyDown"
     @onkeyup="OnCardKeyUp"
     role="button"
     tabindex="0"
     aria-label="@AccessibleName"
     aria-pressed="@(_selected ? "true" : "false")">
    <div class="tm-diagram-template-card__thumb">
        @if (!string.IsNullOrEmpty(Template.ThumbnailUrl))
        {
            <img src="@_thumbUrl" alt="" loading="lazy" />
        }
        else
        {
            @* Placeholder (X6): the notation/category icon — never a first letter, which crashed on
               an empty name and split emoji surrogate pairs. *@
            <div class="tm-diagram-template-card__placeholder" aria-hidden="true">
                <TmIcon Name="@PlaceholderIcon" Size="IconSize.Lg" />
            </div>
        }
    </div>
    <div class="tm-diagram-template-card__info">
        <span class="tm-diagram-template-card__name">@DisplayName</span>
        <div class="tm-diagram-template-card__meta">
            <span class="tm-diagram-template-card__category">@CategoryName</span>
            @foreach (var tag in DisplayTags)
            {
                <span class="tm-diagram-template-card__tag">@tag</span>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>Template previewed and activated by this card.</summary>
    [Parameter] public DiagramTemplate Template { get; set; } = default!;

    /// <summary>Whether the card is the currently selected template (mirrored to aria-pressed).</summary>
    [Parameter] public bool Selected { get; set; }

    /// <summary>Raised once per selection activation: mouse click or Space.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>
    /// Raised once per creation activation: double-click or Enter — the mockup's shortcut that
    /// creates the template without the detour through the footer button.
    /// </summary>
    [Parameter] public EventCallback OnActivateRequest { get; set; }

    /// <summary>Base URI used to resolve relative thumbnail URLs.</summary>
    [Parameter] public string BaseUri { get; set; } = "";

    private bool _selected => Selected;

    /// <summary>Accessible name: the display name, or the template id when the name is empty (never crashes).</summary>
    private string AccessibleName => string.IsNullOrWhiteSpace(DisplayName) ? Template.Id : DisplayName;

    /// <summary>Notation/category icon for cards without a thumbnail (X6) — never a letter.</summary>
    private string PlaceholderIcon => Template.Category?.ToLowerInvariant() switch
    {
        "flowchart" => IconNames.ListTree,
        "uml" => IconNames.Box,
        "database" => IconNames.Database,
        "network" => IconNames.Server,
        "archimate" => IconNames.Layers,
        "bpmn" => IconNames.Activity,
        "c4" => IconNames.Package,
        _ => IconNames.Layout
    };

    /// <summary>Tags minus those that merely repeat the category (raw or localized), case/diacritic-insensitive; max 3.</summary>
    private IEnumerable<string> DisplayTags => Template.Tags
        .Where(tag => !string.Equals(DiagramSearchText.Fold(tag), DiagramSearchText.Fold(Template.Category), StringComparison.OrdinalIgnoreCase)
                   && !string.Equals(DiagramSearchText.Fold(tag), DiagramSearchText.Fold(CategoryName), StringComparison.OrdinalIgnoreCase))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Take(3);

    /// <summary>Localized display name (resource key derived from the template Id, raw-name fallback).</summary>
    private string DisplayName => DiagramTemplateDisplayNames.GetTemplateName(Template, Loc);

    /// <summary>Localized category label (resource key derived from the category, raw-name fallback).</summary>
    private string CategoryName => DiagramTemplateDisplayNames.GetCategoryName(Template.Category, Loc);

    private string _thumbUrl => string.IsNullOrWhiteSpace(Template.ThumbnailUrl)
        ? ""
        : Template.ThumbnailUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase)
            || Template.ThumbnailUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? Template.ThumbnailUrl
            : string.IsNullOrWhiteSpace(BaseUri)
                ? Template.ThumbnailUrl
                : $"{BaseUri.TrimEnd('/')}/{Template.ThumbnailUrl.TrimStart('/')}";

    private Task OnCardActivate() => OnActivateRequest.InvokeAsync();

    private Task OnCardKeyDown(KeyboardEventArgs e) =>
        e.Key == "Enter" && !e.Repeat ? OnActivateRequest.InvokeAsync() : Task.CompletedTask;

    private Task OnCardKeyUp(KeyboardEventArgs e) =>
        e.Key == " " ? OnClick.InvokeAsync() : Task.CompletedTask;
}
