@namespace Tempo.Blazor.Components.Diagram
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Components.Inputs
@using Tempo.Blazor.Components.Diagram.Templates
@using Tempo.Blazor.Abstractions.Layout
@inject DiagramTemplateRegistry TemplateRegistry
@inject NavigationManager Navigation

<TmModal Show="@Show"
         OnClose="OnClose"
         Title="@Loc["TmDiagramTemplateGallery_Title"]"
         ShowDefaultFooterButtons="false"
         Size="ModalSize.XLarge"
         MobilePresentation="MobilePresentation.Auto"
         FooterLayout="FooterLayout.Inline"
         LayoutMode="@LayoutMode"
         CloseOnOverlayClick="true"
         CloseOnEscape="true"
         RestoreFocusTarget="@RestoreFocusTarget">
    <ChildContent>
        <div class="tm-diagram-template-gallery">
            @* Mockup: the search field and the category chips share ONE toolbar row; narrow
               viewports wrap the chips under the field without leaving the row container. *@
            <div class="tm-diagram-template-gallery__toolbar">
                <TmTextInput @bind-Value="_searchQuery"
                             Type="search"
                             LeftIcon="@IconNames.Search"
                             Placeholder="@Loc["TmDiagramTemplateGallery_SearchPlaceholder"]"
                             aria-label="@Loc["TmDiagramTemplateGallery_SearchAriaLabel"]"
                             Class="tm-diagram-template-gallery__search" />
                @if (_categories.Length > 0)
                {
                    <div class="tm-diagram-template-gallery__filters" role="group" aria-label="@Loc["TmDiagramTemplateGallery_FiltersAriaLabel"]">
                        <button type="button" class="tm-diagram-template-gallery__filter @(_selectedCategory == null ? "tm-diagram-template-gallery__filter--active" : "")"
                                aria-pressed="@(_selectedCategory == null ? "true" : "false")"
                                @onclick="() => _selectedCategory = null">
                            @Loc["TmDiagramTemplateGallery_All"]
                        </button>
                        @foreach (var cat in _categories.OrderBy(c => DiagramTemplateDisplayNames.GetCategoryName(c, Loc), DisplayComparer))
                        {
                            <button type="button" class="tm-diagram-template-gallery__filter @(_selectedCategory == cat ? "tm-diagram-template-gallery__filter--active" : "")"
                                    aria-pressed="@(_selectedCategory == cat ? "true" : "false")"
                                    @onclick="() => _selectedCategory = cat">
                                @DiagramTemplateDisplayNames.GetCategoryName(cat, Loc)
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="tm-diagram-template-gallery__body">
                @{ var visible = GetVisibleCategories().ToList(); }
                @* Flat grid (D15): one shared card grid across all categories — the category chips
                   and the per-card category label carry the grouping; no per-category sections. *@
                <div class="tm-diagram-template-gallery__grid">
                    @foreach (var template in visible.SelectMany(c => c.Templates))
                    {
                        <TmDiagramTemplateCard @key="template.Id"
                                               Template="template"
                                               Selected="_selectedTemplate?.Id == template.Id"
                                               OnClick="() => SelectTemplate(template)"
                                               OnActivateRequest="() => ActivateTemplate(template)"
                                               BaseUri="@Navigation.BaseUri" />
                    }
                </div>

                @* Live region (D12): always in the DOM so screen readers announce the empty state. *@
                <div class="tm-diagram-template-gallery__status" role="status" aria-live="polite" aria-atomic="true">
                    @if (visible.Count == 0)
                    {
                        <div class="tm-diagram-template-gallery__empty">@Loc["TmDiagramTemplateGallery_NoResults"]</div>
                    }
                </div>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <TmButton Variant="ButtonVariant.Ghost" OnClick="OnClose">
            @Loc["Tm_Cancel"]
        </TmButton>
        <TmButton Variant="ButtonVariant.Primary"
                  OnClick="OnApplyClick"
                  Disabled="_selectedTemplate == null">
            @Loc["TmDiagramTemplateGallery_CreateButton"]
        </TmButton>
    </Footer>
</TmModal>

@code {
    /// <summary>Whether the gallery is visible; hiding it resets the search, category filter and selection.</summary>
    [Parameter] public bool Show { get; set; }
    /// <summary>Raised when the user cancels or closes the gallery.</summary>
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Raised with the chosen template on Create, double-click or Enter on a card.</summary>
    [Parameter] public EventCallback<DiagramTemplate> OnSelect { get; set; }

    /// <summary>
    /// The layout the modal renders. <see cref="TmLayoutMode.Auto"/> follows the viewport scope; a
    /// forced value never measures, so a test can render the mobile sheet without a DOM.
    /// </summary>
    [Parameter] public TmLayoutMode LayoutMode { get; set; } = TmLayoutMode.Auto;

    /// <summary>The element (typically the canvas) focus returns to when the gallery closes.</summary>
    [Parameter] public ElementReference? RestoreFocusTarget { get; set; }

    private string _searchQuery = "";
    private string? _selectedCategory;
    private DiagramTemplate? _selectedTemplate;
    private string[] _categories = [];

    protected override async Task OnInitializedAsync()
    {
        await TemplateRegistry.InitializeAsync();
        _categories = TemplateRegistry.GetCategories();
    }

    protected override void OnParametersSet()
    {
        if (!Show)
        {
            _searchQuery = "";
            _selectedCategory = null;
            _selectedTemplate = null;
        }
    }

    /// <summary>Culture-aware comparer for the visible labels: Czech users get Czech alphabetical order (D7).
    /// Cached per culture — the property is read for every card during a render, and creating a
    /// comparer per call wasted an object each time.</summary>
    private StringComparer DisplayComparer
    {
        get
        {
            var culture = Loc.Culture ?? System.Globalization.CultureInfo.CurrentUICulture;
            if (_displayComparer is null || !Equals(_displayComparerCulture, culture))
            {
                _displayComparer = StringComparer.Create(culture, ignoreCase: true);
                _displayComparerCulture = culture;
            }
            return _displayComparer;
        }
    }

    private StringComparer? _displayComparer;
    private System.Globalization.CultureInfo? _displayComparerCulture;

    private IEnumerable<DiagramTemplateCategory> GetVisibleCategories()
    {
        var query = _searchQuery.Trim();
        var all = TemplateRegistry.GetAll().Where(t =>
            DiagramSearchText.MatchesAny(query,
                [DiagramTemplateDisplayNames.GetTemplateName(t, Loc), t.Name,
                 DiagramTemplateDisplayNames.GetCategoryName(t.Category, Loc), t.Category, .. t.Tags]));

        if (!string.IsNullOrEmpty(_selectedCategory))
            all = all.Where(t => t.Category == _selectedCategory);

        return all
            .GroupBy(t => t.Category)
            .Select(g => new DiagramTemplateCategory
            {
                Name = g.Key,
                Templates = g.OrderBy(t => DiagramTemplateDisplayNames.GetTemplateName(t, Loc), DisplayComparer).ToList()
            })
            .OrderBy(c => DiagramTemplateDisplayNames.GetCategoryName(c.Name, Loc), DisplayComparer);
    }

    private void SelectTemplate(DiagramTemplate template)
    {
        _selectedTemplate = template;
    }

    /// <summary>Double-click / Enter: select the card and create immediately.</summary>
    private async Task ActivateTemplate(DiagramTemplate template)
    {
        _selectedTemplate = template;
        await OnSelect.InvokeAsync(template);
    }

    private async Task OnApplyClick()
    {
        if (_selectedTemplate is not null)
            await OnSelect.InvokeAsync(_selectedTemplate);
    }
}
