@namespace Tempo.Blazor.Components.Diagram
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Inputs
@using Tempo.Blazor.Components.Diagram.Services
@using Tempo.Blazor.Models
@using Tempo.Blazor.Abstractions.Layout
@implements IDisposable

<TmModal Show="@Show"
         OnClose="OnClose"
         Title="@Loc["TmDiagramSqlImportDialog_Title"]"
         Subtitle="@Loc["TmDiagramSqlImportDialog_Subtitle"]"
         ShowDefaultFooterButtons="false"
         Size="ModalSize.Large"
         MobilePresentation="MobilePresentation.Auto"
         FooterLayout="FooterLayout.Inline"
         LayoutMode="@LayoutMode"
         CloseOnOverlayClick="true"
         CloseOnEscape="true"
         RestoreFocusTarget="@RestoreFocusTarget">
    <ChildContent>
        <div class="tm-diagram-sql-import">
            <div class="tm-diagram-sql-import__field">
                <label class="tm-diagram-sql-import__label" for="@_sqlFieldId">@Loc["TmDiagramSqlImportDialog_SqlLabel"]</label>
                <TmTextArea Id="@_sqlFieldId"
                            @bind-Value="_sql"
                            @bind-Value:after="OnSqlChanged"
                            Immediate="true"
                            Rows="10"
                            Placeholder="@Loc["TmDiagramSqlImportDialog_SqlPlaceholder"]"
                            Class="tm-diagram-sql-import__textarea"
                            aria-invalid="@(HasPreviewError ? "true" : null)"
                            aria-describedby="@(HasPreviewError ? _previewErrorId : null)" />
            </div>

            <div class="tm-diagram-sql-import__field">
                <label class="tm-diagram-sql-import__label" for="@_layoutFieldId">@Loc["TmDiagramSqlImportDialog_LayoutLabel"]</label>
                <TmSelect Id="@_layoutFieldId"
                          @bind-Value="_layout"
                          Options="LayoutOptions"
                          Class="tm-diagram-sql-import__select" />
            </div>

            @* Live region (D12): the wrapper is always in the DOM so screen readers announce the
               preview (and the debounced preview error — POLITE, never role=alert) when it appears.
               The debounced preview reports problems as you type; only the Import click promotes
               an error to the assertive TmAlert below. The textarea points aria-describedby here
               and carries aria-invalid while a preview error is shown. *@
            <div class="tm-diagram-sql-import__status" role="status" aria-live="polite" aria-atomic="true">
                @if (_previewTables >= 0)
                {
                    @* Mockup: the live parse result is a summary box with one icon stat per count. *@
                    <div class="tm-diagram-sql-import__preview">
                        <span class="tm-diagram-sql-import__stat">
                            <TmIcon Name="@IconNames.Table" Size="IconSize.Sm" />
                            @Loc["TmDiagramSqlImportDialog_PreviewTables", _previewTables]
                        </span>
                        <span class="tm-diagram-sql-import__stat">
                            <TmIcon Name="@IconNames.Link" Size="IconSize.Sm" />
                            @Loc["TmDiagramSqlImportDialog_PreviewRelations", _previewRelations]
                        </span>
                    </div>
                }
                @if (HasPreviewError)
                {
                    <p class="tm-diagram-sql-import__status-error" id="@_previewErrorId">@_previewError</p>
                }
            </div>

            @* Import-click failures only: role=alert, asserted. Typing-time problems stay polite
               in the status region above. *@
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <TmAlert Severity="AlertSeverity.Error" Dismissable="false" Class="tm-diagram-sql-import__error">
                    @_errorMessage
                </TmAlert>
            }
        </div>
    </ChildContent>
    <Footer>
        <TmButton Variant="ButtonVariant.Ghost" OnClick="OnClose">
            @Loc["Tm_Cancel"]
        </TmButton>
        <TmButton Variant="ButtonVariant.Primary"
                  OnClick="OnImportClick"
                  Disabled="string.IsNullOrWhiteSpace(_sql) || _previewTables <= 0">
            @Loc["TmDiagramSqlImportDialog_ImportButton"]
        </TmButton>
    </Footer>
</TmModal>

@code {
    /// <summary>Whether the dialog is visible; hidden resets the entered SQL and preview.</summary>
    [Parameter] public bool Show { get; set; }

    /// <summary>Raised when the user cancels or closes the dialog.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Raised on import with the generated ER document and chosen layout direction.</summary>
    [Parameter] public EventCallback<SqlImportResult> OnImport { get; set; }

    /// <summary>
    /// The layout the modal renders. <see cref="TmLayoutMode.Auto"/> follows the viewport scope; a
    /// forced value never measures, so a test can render the mobile sheet without a DOM.
    /// </summary>
    [Parameter] public TmLayoutMode LayoutMode { get; set; } = TmLayoutMode.Auto;

    /// <summary>The element (typically the canvas) focus returns to when the dialog closes.</summary>
    [Parameter] public ElementReference? RestoreFocusTarget { get; set; }

    private string _sql = string.Empty;
    private string _layout = "TB";
    private int _previewTables = -1;
    private int _previewRelations = -1;
    private string? _previewError;
    private string? _errorMessage;

    // Per-instance field ids: two dialogs can be rendered at once (bUnit tests,
    // split views) and the fixed "sql-ddl"/"layout-select" ids collided.
    private readonly string _uid = Guid.NewGuid().ToString("n")[..8];
    private string _sqlFieldId => $"sql-ddl-{_uid}";
    private string _layoutFieldId => $"layout-select-{_uid}";
    private string _previewErrorId => $"sql-preview-error-{_uid}";
    private bool HasPreviewError => !string.IsNullOrEmpty(_previewError);

    /// <summary>Layout direction choices, localized at render time (reuses the diagram layout keys).</summary>
    private List<SelectOption<string>> LayoutOptions => new()
    {
        new() { Value = "TB", Label = Loc["TmDiagram_LayoutHierarchicalTopDown"] },
        new() { Value = "LR", Label = Loc["TmDiagram_LayoutHierarchicalLeftRight"] }
    };

    protected override void OnParametersSet()
    {
        if (!Show)
        {
            _sql = string.Empty;
            _layout = "TB";
            _previewTables = -1;
            _previewRelations = -1;
            _previewError = null;
            _errorMessage = null;
            CancelPreviewTimer();
        }
    }

    /// <summary>Live-preview debounce. Internal so tests can reference it.</summary>
    internal const int PreviewDebounceMs = DiagramPreviewDebouncer.DebounceMs;

    [Inject] private IServiceProvider ServiceProvider { get; set; } = default!;
    private TimeProvider Clock => _clock ??= ServiceProvider.GetService(typeof(TimeProvider)) as TimeProvider ?? TimeProvider.System;
    private TimeProvider? _clock;

    /// <summary>Shared debounced-timer plumbing (see <see cref="DiagramPreviewDebouncer"/>).</summary>
    private DiagramPreviewDebouncer? _debouncer;
    private DiagramPreviewDebouncer Debouncer => _debouncer ??= new DiagramPreviewDebouncer(InvokeAsync, Clock);

    /// <summary>Live preview: each input re-arms a single-shot timer; the parse runs once typing pauses.</summary>
    private void OnSqlChanged() => SchedulePreview();

    private void SchedulePreview()
    {
        Debouncer.Cancel();
        if (string.IsNullOrWhiteSpace(_sql))
        {
            _previewTables = -1;
            _previewRelations = -1;
            _previewError = null;
            _errorMessage = null;
            return;
        }

        Debouncer.Schedule(() =>
        {
            UpdatePreview();
            StateHasChanged();
            return Task.CompletedTask;
        });
    }

    private void CancelPreviewTimer() => _debouncer?.Cancel();

    /// <summary>Localized text for an import failure. Never returns <see cref="Exception.Message"/>.</summary>
    private string GetErrorMessage(Exception ex) =>
        ex is DiagramImportException { Error: DiagramImportError.InputTooComplex }
            ? Loc["TmDiagramSqlImportDialog_ErrorTooComplex"]
            : Loc["TmDiagramSqlImportDialog_ErrorUnexpected"];

    /// <summary>Stops a pending preview timer.</summary>
    public void Dispose()
    {
        _debouncer?.Dispose();
    }

    private void UpdatePreview()
    {
        try
        {
            var tables = SqlParser.Parse(_sql);
            _previewTables = tables.Count;
            _previewRelations = tables.Sum(t => t.ForeignKeys.Count);
            _previewError = null;
        }
        catch (Exception ex)
        {
            _previewTables = -1;
            _previewRelations = -1;
            _previewError = GetErrorMessage(ex);
        }
    }

    private async Task OnImportClick()
    {
        CancelPreviewTimer();
        _previewError = null;
        if (string.IsNullOrWhiteSpace(_sql))
        {
            _errorMessage = Loc["TmDiagramSqlImportDialog_ErrorEmpty"];
            return;
        }

        try
        {
            var tables = SqlParser.Parse(_sql);
            if (tables.Count == 0)
            {
                _errorMessage = Loc["TmDiagramSqlImportDialog_ErrorNoTables"];
                return;
            }

            var doc = SqlToErDiagramGenerator.Generate(tables);
            await OnImport.InvokeAsync(new SqlImportResult(doc, _layout));
            _errorMessage = null;
        }
        catch (Exception ex)
        {
            _errorMessage = GetErrorMessage(ex);
        }
    }
}
