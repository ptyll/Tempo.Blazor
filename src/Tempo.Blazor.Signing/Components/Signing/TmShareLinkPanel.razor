@namespace Tempo.Blazor.Components.Signing
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Inputs

<section @attributes="AdditionalAttributes"
         class="@RootClass"
         aria-disabled="@BoolText(!Enabled)">
    <header class="tm-share-link-panel__header">
        <div>
            <h2 class="tm-share-link-panel__title">@Loc["TmShareLinkPanel_Title"]</h2>
            @if (ExpiresAt is not null)
            {
                <p class="tm-share-link-panel__expiration">@Loc["TmShareLinkPanel_Expires", SigningDateFormatter.Format(ExpiresAt.Value)]</p>
            }
        </div>
        <div class="tm-share-link-panel__toggle">
            @* The label is STATIC ("Link sharing" — the control's name never flips with its own
               state, so a screen reader does not re-read the switch while toggling it; phase 7
               review). *@
            <TmToggle Value="@Enabled"
                      ValueChanged="HandleEnabledChangedAsync"
                      Label="@Loc["TmShareLinkPanel_EnableSharing"]" />
        </div>
    </header>

    <div class="tm-share-link-panel__link">
        <label class="tm-share-link-panel__link-label" for="@_linkInputId">@Loc["TmShareLinkPanel_LinkLabel"]</label>
        <div class="tm-share-link-panel__link-row">
            <input class="tm-share-link-panel__input tm-input"
                   id="@_linkInputId"
                   value="@Link"
                   readonly
                   disabled="@(!Enabled)" />
            <TmCopyButton Text="@Link"
                          ShowLabel="true"
                          Disabled="@(!Enabled)"
                          data-testid="@TestId("share-link-copy")" />
        </div>
    </div>

    @if (ShowQrCode && !string.IsNullOrWhiteSpace(Link))
    {
        <div class="tm-share-link-panel__qr-frame">
            <div class="tm-share-link-panel__qr">
                @if (QrCodeComponentType is not null)
                {
                    <DynamicComponent Type="QrCodeComponentType" Parameters="QrCodeParameters" />
                }
            </div>
            <p class="tm-share-link-panel__qr-hint">@Loc["TmShareLinkPanel_QrHint"]</p>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(EmbedCode))
    {
        <div class="tm-share-link-panel__separator" role="presentation"></div>

        <div class="tm-share-link-panel__embed">
            <label class="tm-share-link-panel__embed-label" for="@_embedInputId">@Loc["TmShareLinkPanel_EmbedCode"]</label>
            <div class="tm-share-link-panel__embed-row">
                <textarea class="tm-share-link-panel__embed-code"
                          id="@_embedInputId"
                          readonly
                          disabled="@(!Enabled)">@EmbedCode</textarea>
                <TmCopyButton Text="@EmbedCode"
                              ShowLabel="true"
                              Disabled="@(!Enabled)"
                              data-testid="@TestId("share-link-embed-copy")" />
            </div>
        </div>
    }
</section>

@code {
    private readonly string _linkInputId = $"tm-share-link-{Guid.NewGuid():N}";
    private readonly string _embedInputId = $"tm-share-embed-{Guid.NewGuid():N}";

    /// <summary>Public signing link.</summary>
    [Parameter] public string Link { get; set; } = string.Empty;

    /// <summary>Optional embed code for publishing the signing link.</summary>
    [Parameter] public string? EmbedCode { get; set; }

    /// <summary>Whether sharing is enabled.</summary>
    [Parameter] public bool Enabled { get; set; } = true;

    /// <summary>Callback invoked when sharing is enabled or disabled.</summary>
    [Parameter] public EventCallback<bool> EnabledChanged { get; set; }

    /// <summary>Optional link expiration time.</summary>
    [Parameter] public DateTimeOffset? ExpiresAt { get; set; }

    /// <summary>Whether a QR code is rendered.</summary>
    [Parameter] public bool ShowQrCode { get; set; } = true;

    /// <summary>Additional CSS classes for the root element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Additional HTML attributes passed to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private static readonly Type? QrCodeComponentType = ResolveQrCodeComponentType();

    private Dictionary<string, object?> QrCodeParameters => new()
    {
        ["Value"] = Link,
        ["Size"] = 144
    };

    private string RootClass => string.Join(" ", new[]
    {
        "tm-share-link-panel",
        Enabled ? null : "tm-share-link-panel--disabled",
        Class
    }.Where(item => !string.IsNullOrWhiteSpace(item)));

    private Task HandleEnabledChangedAsync(bool enabled)
    {
        Enabled = enabled;
        return EnabledChanged.InvokeAsync(enabled);
    }

    private static string BoolText(bool value) => value ? "true" : "false";

    private static Type? ResolveQrCodeComponentType()
        => Type.GetType("Tempo.Blazor.Components.DataDisplay.TmQRCode, Tempo.Blazor.Codes")
           ?? AppDomain.CurrentDomain.GetAssemblies()
               .Select(assembly => assembly.GetType("Tempo.Blazor.Components.DataDisplay.TmQRCode", throwOnError: false))
               .FirstOrDefault(type => type is not null);
}
