@namespace Tempo.Blazor.Components.Signing
@using Tempo.Blazor.Abstractions.Models
@using Tempo.Blazor.Components.Buttons

<TmSigningStepShell Field="Field"
                    TitleId="@_titleId"
                    DescriptionId="@_descriptionId"
                    ValidationMessage="@EffectiveValidationMessage"
                    ValidationMessageId="@(HasValidationMessage ? _validationId : null)"
                    AppearsOn="@AppearsOn"
                    Culture="@Culture"
                    FallbackCulture="@FallbackCulture"
                    Class="@ShellClass"
                    @attributes="AdditionalAttributes">
    @* Native <input type="date"> stays (the SI1 exception — the mobile pickers keep working); it
        is styled with the core tm-input classes (phase 4). The shell title (this instance's stable
        id) is its accessible name, the validation alert (while one shows) its description. *@
    <div class="tm-signing-date-step__row">
        <input class="tm-input tm-signing-date-step__input"
               type="@InputType"
               value="@Value"
               min="@NormalizeDateToken(Field.Validation?.Min)"
               max="@NormalizeDateToken(Field.Validation?.Max)"
               disabled="@Disabled"
               placeholder="@PlaceholderText"
               aria-labelledby="@_titleId"
               aria-describedby="@DescribedBy"
               aria-invalid="@BoolText(HasValidationMessage)"
               @onchange="HandleValueChangedAsync" />
        @if (ShowTodayButton)
        {
            @* Tonal (secondary) TmButton (phase 4); on a narrow step container the row wraps and
                the button drops under the input (CSS). *@
            <TmButton Variant="ButtonVariant.Secondary"
                      Class="tm-signing-date-step__today"
                      Disabled="@Disabled"
                      OnClick="SetTodayAsync">
                @Loc["TmSigningStep_Today"]
            </TmButton>
        }
    </div>
</TmSigningStepShell>
