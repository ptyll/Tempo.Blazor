@namespace Tempo.Blazor.Components.Signing
@using Tempo.Blazor.Abstractions.Models

<TmSigningStepShell Field="Field"
                    TitleId="@_titleId"
                    DescriptionId="@_descriptionId"
                    ValidationMessage="@EffectiveValidationMessage"
                    ValidationMessageId="@(HasValidationMessage ? _validationId : null)"
                    AppearsOn="@AppearsOn"
                    Culture="@Culture"
                    FallbackCulture="@FallbackCulture"
                    Class="@ShellClass"
                    @attributes="AdditionalAttributes">
    @* Native <input type="date"> per SI1; the shell title (this instance's stable id) is its
       accessible name, the validation alert (while one shows) its description. *@
    <div class="tm-signing-date-step__row">
        <input class="tm-signing-date-step__input"
               type="@InputType"
               value="@Value"
               min="@NormalizeDateToken(Field.Validation?.Min)"
               max="@NormalizeDateToken(Field.Validation?.Max)"
               disabled="@Disabled"
               placeholder="@PlaceholderText"
               aria-labelledby="@_titleId"
               aria-describedby="@DescribedBy"
               aria-invalid="@BoolText(HasValidationMessage)"
               @onchange="HandleValueChangedAsync" />
        @if (ShowTodayButton)
        {
            <button type="button"
                    class="tm-signing-date-step__today"
                    disabled="@Disabled"
                    @onclick="SetTodayAsync">
                @Loc["TmSigningStep_Today"]
            </button>
        }
    </div>
</TmSigningStepShell>
