@namespace Tempo.Blazor.Components.Signing
@using Tempo.Blazor.Abstractions.Models

<aside @attributes="AdditionalAttributes"
       class="@RootClass"
       aria-readonly="@BoolText(ReadOnly)">
    @if (_field is null)
    {
        <div class="tm-signing-field-editor-panel__empty">
            <TmIcon Name="settings" Size="IconSize.Lg" />
            <p>@Loc["TmSigningFieldEditorPanel_Empty"]</p>
        </div>
    }
    else
    {
        <header class="tm-signing-field-editor-panel__header">
            <div>
                <p class="tm-signing-field-editor-panel__eyebrow">@Loc["TmSigning_FieldSettings"]</p>
                <h2 class="tm-signing-field-editor-panel__title">@GetPanelTitle()</h2>
            </div>
            <span class="tm-signing-field-editor-panel__type-badge">@GetFieldTypeLabel(_field.Type)</span>
        </header>

        <section class="tm-signing-field-editor-panel__section">
            <h3 class="tm-signing-field-editor-panel__section-title">@Loc["TmSigningFieldEditorPanel_Common"]</h3>

            <label class="tm-signing-field-editor-panel__field">
                <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_Type"]</span>
                <select class="tm-signing-field-editor-panel__type"
                        value="@_field.Type.ToString()"
                        disabled="@ReadOnly"
                        @onchange="HandleTypeChangedAsync">
                    @foreach (var type in Enum.GetValues<SigningFieldType>())
                    {
                        <option value="@type.ToString()">@GetFieldTypeLabel(type)</option>
                    }
                </select>
            </label>

            <label class="tm-signing-field-editor-panel__field">
                <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_Name"]</span>
                <input class="tm-signing-field-editor-panel__name"
                       type="text"
                       value="@_field.Name"
                       disabled="@ReadOnly"
                       @onchange="HandleNameChangedAsync" />
            </label>

            <label class="tm-signing-field-editor-panel__field">
                <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_TitleInput"]</span>
                <input class="tm-signing-field-editor-panel__field-title-input"
                       type="text"
                       value="@_field.Title"
                       disabled="@ReadOnly"
                       @onchange="args => HandleTextPropertyChangedAsync(args, (field, value) => field.Title = value)" />
            </label>

            <label class="tm-signing-field-editor-panel__field">
                <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_Description"]</span>
                <textarea class="tm-signing-field-editor-panel__description"
                          disabled="@ReadOnly"
                          @onchange="args => HandleTextPropertyChangedAsync(args, (field, value) => field.Description = value)">@_field.Description</textarea>
            </label>

            <label class="tm-signing-field-editor-panel__field">
                <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_SubmitterRole"]</span>
                <select class="tm-signing-field-editor-panel__submitter"
                        value="@(_field.SubmitterUuid ?? string.Empty)"
                        disabled="@ReadOnly"
                        @onchange="HandleSubmitterChangedAsync">
                    <option value="">@Loc["TmSigningFieldEditorPanel_NoRole"]</option>
                    @foreach (var role in SubmitterRoles)
                    {
                        <option value="@role.Uuid">@role.Name</option>
                    }
                </select>
            </label>

            <div class="tm-signing-field-editor-panel__toggles">
                <label class="tm-signing-field-editor-panel__check">
                    <input class="tm-signing-field-editor-panel__required"
                           type="checkbox"
                           checked="@_field.Required"
                           disabled="@ReadOnly"
                           @onchange="args => HandleBoolPropertyChangedAsync(args, (field, value) => field.Required = value)" />
                    <span>@Loc["TmSigning_Required"]</span>
                </label>
                <label class="tm-signing-field-editor-panel__check">
                    <input class="tm-signing-field-editor-panel__readonly"
                           type="checkbox"
                           checked="@_field.ReadOnly"
                           disabled="@ReadOnly"
                           @onchange="args => HandleBoolPropertyChangedAsync(args, (field, value) => field.ReadOnly = value)" />
                    <span>@Loc["TmSigningFieldEditorPanel_ReadOnly"]</span>
                </label>
                <label class="tm-signing-field-editor-panel__check">
                    <input class="tm-signing-field-editor-panel__prefillable"
                           type="checkbox"
                           checked="@_field.Prefillable"
                           disabled="@ReadOnly"
                           @onchange="args => HandleBoolPropertyChangedAsync(args, (field, value) => field.Prefillable = value)" />
                    <span>@Loc["TmSigningFieldEditorPanel_Prefillable"]</span>
                </label>
            </div>
        </section>

        @if (ShouldShowLocalizationEditor)
        {
            <section class="tm-signing-field-editor-panel__section tm-signing-field-editor-panel__localization">
                <div class="tm-signing-field-editor-panel__section-header">
                    <h3 class="tm-signing-field-editor-panel__section-title">@Loc["TmSigningFieldEditorPanel_Localization"]</h3>
                    <label class="tm-signing-field-editor-panel__field tm-signing-field-editor-panel__localization-language">
                        <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_LocalizationCulture"]</span>
                        <select class="tm-signing-field-editor-panel__localization-culture"
                                value="@ActiveLocalizationCulture"
                                disabled="@ReadOnly"
                                @onchange="HandleLocalizationCultureChangedAsync">
                            @foreach (var culture in LocalizationCultures)
                            {
                                <option value="@culture">@GetCultureLabel(culture)</option>
                            }
                        </select>
                    </label>
                </div>

                @if (!string.IsNullOrWhiteSpace(FallbackCulture))
                {
                    <p class="tm-signing-field-editor-panel__template-language">
                        @Loc["TmSigningFieldEditorPanel_TemplateLanguage"]: @GetCultureLabel(FallbackCulture!)
                    </p>
                }

                @if (MissingLocalizationCount > 0)
                {
                    <div class="tm-signing-field-editor-panel__missing-localization"
                         role="status"
                         aria-live="polite">
                        <TmIcon Name="alert-triangle" Size="IconSize.Xs" />
                        <span>@Loc["TmSigningFieldEditorPanel_MissingLocalizationWarning", MissingLocalizationCount, ActiveLocalizationCulture]</span>
                    </div>
                }

                <label class="tm-signing-field-editor-panel__field">
                    <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_LocalizedLabel"]</span>
                    <input class="tm-signing-field-editor-panel__localized-label"
                           type="text"
                           value="@GetLocalizedText(_field.Labels)"
                           disabled="@ReadOnly"
                           @onchange="args => HandleLocalizedTextChangedAsync(args, field => field.Labels)" />
                </label>

                <label class="tm-signing-field-editor-panel__field">
                    <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_LocalizedTitle"]</span>
                    <input class="tm-signing-field-editor-panel__localized-title"
                           type="text"
                           value="@GetLocalizedText(_field.Titles)"
                           disabled="@ReadOnly"
                           @onchange="args => HandleLocalizedTextChangedAsync(args, field => field.Titles)" />
                </label>

                <label class="tm-signing-field-editor-panel__field">
                    <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_LocalizedDescription"]</span>
                    <textarea class="tm-signing-field-editor-panel__localized-description"
                              disabled="@ReadOnly"
                              @onchange="args => HandleLocalizedTextChangedAsync(args, field => field.Descriptions)">@GetLocalizedText(_field.Descriptions)</textarea>
                </label>

                <label class="tm-signing-field-editor-panel__field">
                    <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_LocalizedPlaceholder"]</span>
                    <input class="tm-signing-field-editor-panel__localized-placeholder"
                           type="text"
                           value="@GetLocalizedText(_field.Placeholders)"
                           disabled="@ReadOnly"
                           @onchange="args => HandleLocalizedTextChangedAsync(args, field => field.Placeholders)" />
                </label>

                <label class="tm-signing-field-editor-panel__field">
                    <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_LocalizedValidationMessage"]</span>
                    <input class="tm-signing-field-editor-panel__localized-validation-message"
                           type="text"
                           value="@GetLocalizedText(_field.Validation?.Messages)"
                           disabled="@ReadOnly"
                           @onchange="HandleLocalizedValidationMessageChangedAsync" />
                </label>

                @if (IsChoiceField)
                {
                    <div class="tm-signing-field-editor-panel__localized-options">
                        <p class="tm-signing-field-editor-panel__localized-options-title">@Loc["TmSigningFieldEditorPanel_LocalizedOptionLabels"]</p>
                        @foreach (var option in _field.Options)
                        {
                            var optionUuid = option.Uuid;
                            <label class="tm-signing-field-editor-panel__field"
                                   data-localized-option-uuid="@option.Uuid">
                                <span class="tm-signing-field-editor-panel__label">@option.Value</span>
                                <input class="tm-signing-field-editor-panel__localized-option-label"
                                       type="text"
                                       value="@GetLocalizedText(option.Labels)"
                                       disabled="@ReadOnly"
                                       @onchange="args => HandleLocalizedOptionLabelChangedAsync(optionUuid, args)" />
                            </label>
                        }
                    </div>
                }
            </section>
        }

        @if (IsChoiceField)
        {
            <section class="tm-signing-field-editor-panel__section tm-signing-field-editor-panel__options">
                <div class="tm-signing-field-editor-panel__section-header">
                    <h3 class="tm-signing-field-editor-panel__section-title">@Loc["TmSigningFieldEditorPanel_Options"]</h3>
                    <button type="button"
                            class="tm-signing-field-editor-panel__add-option"
                            disabled="@ReadOnly"
                            @onclick="AddOptionAsync">
                        <TmIcon Name="plus" Size="IconSize.Xs" />
                        @Loc["TmSigningFieldEditorPanel_AddOption"]
                    </button>
                </div>

                @foreach (var option in _field.Options)
                {
                    var optionUuid = option.Uuid;
                    <div class="tm-signing-field-editor-panel__option-row" data-option-uuid="@option.Uuid">
                        <input class="tm-signing-field-editor-panel__option-value"
                               type="text"
                               value="@option.Value"
                               disabled="@ReadOnly"
                               @onchange="args => UpdateOptionValueAsync(optionUuid, args)" />
                        <button type="button"
                                class="tm-signing-field-editor-panel__move-option-up"
                                disabled="@ReadOnly"
                                aria-label="@Loc["TmSigningFieldEditorPanel_MoveOptionUp"]"
                                @onclick="() => MoveOptionAsync(optionUuid, -1)">
                            <TmIcon Name="chevron-up" Size="IconSize.Xs" />
                        </button>
                        <button type="button"
                                class="tm-signing-field-editor-panel__move-option-down"
                                disabled="@ReadOnly"
                                aria-label="@Loc["TmSigningFieldEditorPanel_MoveOptionDown"]"
                                @onclick="() => MoveOptionAsync(optionUuid, 1)">
                            <TmIcon Name="chevron-down" Size="IconSize.Xs" />
                        </button>
                        @if (_field.Type is SigningFieldType.Radio or SigningFieldType.Multiple)
                        {
                            <button type="button"
                                    class="tm-signing-field-editor-panel__map-option"
                                    disabled="@ReadOnly"
                                    @onclick="() => RequestOptionAreaMappingAsync(option)">
                                <TmIcon Name="map-pin" Size="IconSize.Xs" />
                                @Loc["TmSigningFieldEditorPanel_MapOption"]
                            </button>
                        }
                        <button type="button"
                                class="tm-signing-field-editor-panel__remove-option"
                                disabled="@ReadOnly"
                                aria-label="@Loc["TmSigningFieldEditorPanel_RemoveOption"]"
                                @onclick="() => RemoveOptionAsync(optionUuid)">
                            <TmIcon Name="trash-2" Size="IconSize.Xs" />
                        </button>
                    </div>
                }

                <label class="tm-signing-field-editor-panel__field">
                    <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_DefaultValue"]</span>
                    <select class="tm-signing-field-editor-panel__default-option"
                            value="@(_field.DefaultValue?.ToString() ?? string.Empty)"
                            disabled="@ReadOnly"
                            @onchange="HandleDefaultValueChangedAsync">
                        <option value="">@Loc["TmSigningFieldEditorPanel_NoDefault"]</option>
                        @foreach (var option in _field.Options)
                        {
                            <option value="@option.Uuid">@option.Value</option>
                        }
                    </select>
                </label>
            </section>
        }

        <section class="tm-signing-field-editor-panel__section">
            <h3 class="tm-signing-field-editor-panel__section-title">@Loc["TmSigningFieldEditorPanel_Validation"]</h3>

            @if (IsTextLikeField)
            {
                <label class="tm-signing-field-editor-panel__field">
                    <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_ValidationMode"]</span>
                    <select class="tm-signing-field-editor-panel__validation-mode"
                            value="@GetValidationMode()"
                            disabled="@ReadOnly"
                            @onchange="HandleValidationModeChangedAsync">
                        <option value="None">@Loc["TmSigningFieldEditorPanel_None"]</option>
                        <option value="Regex">@Loc["TmSigningFieldEditorPanel_Regex"]</option>
                    </select>
                </label>

                <label class="tm-signing-field-editor-panel__field">
                    <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_Pattern"]</span>
                    <input class="tm-signing-field-editor-panel__validation-pattern"
                           type="text"
                           value="@_field.Validation?.Pattern"
                           disabled="@ReadOnly"
                           @onchange="args => HandleValidationValueChangedAsync(args, (validation, value) => validation.Pattern = value)" />
                </label>
            }

            @if (IsTextLikeField || IsNumberField || IsDateField)
            {
                <div class="tm-signing-field-editor-panel__grid">
                    <label class="tm-signing-field-editor-panel__field">
                        <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_Min"]</span>
                        <input class="tm-signing-field-editor-panel__validation-min"
                               type="text"
                               value="@_field.Validation?.Min"
                               disabled="@ReadOnly"
                               @onchange="args => HandleValidationValueChangedAsync(args, (validation, value) => validation.Min = value)" />
                    </label>
                    <label class="tm-signing-field-editor-panel__field">
                        <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_Max"]</span>
                        <input class="tm-signing-field-editor-panel__validation-max"
                               type="text"
                               value="@_field.Validation?.Max"
                               disabled="@ReadOnly"
                               @onchange="args => HandleValidationValueChangedAsync(args, (validation, value) => validation.Max = value)" />
                    </label>
                </div>
            }

            @if (IsNumberField)
            {
                <label class="tm-signing-field-editor-panel__field">
                    <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_Step"]</span>
                    <input class="tm-signing-field-editor-panel__validation-step"
                           type="text"
                           value="@_field.Validation?.Step"
                           disabled="@ReadOnly"
                           @onchange="args => HandleValidationValueChangedAsync(args, (validation, value) => validation.Step = value)" />
                </label>
            }

            @if (IsDateField)
            {
                <label class="tm-signing-field-editor-panel__field">
                    <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_DateFormat"]</span>
                    <input class="tm-signing-field-editor-panel__date-format"
                           type="text"
                           value="@_field.Preferences.Format"
                           disabled="@ReadOnly"
                           @onchange="args => HandlePreferenceTextChangedAsync(args, (preferences, value) => preferences.Format = value)" />
                </label>
            }

            <label class="tm-signing-field-editor-panel__field">
                <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_ValidationMessage"]</span>
                <input class="tm-signing-field-editor-panel__validation-message"
                       type="text"
                       value="@_field.Validation?.Message"
                       disabled="@ReadOnly"
                       @onchange="args => HandleValidationValueChangedAsync(args, (validation, value) => validation.Message = value)" />
            </label>
        </section>

        <section class="tm-signing-field-editor-panel__section">
            <h3 class="tm-signing-field-editor-panel__section-title">@Loc["TmSigningFieldEditorPanel_Preferences"]</h3>

            @if (IsSignatureField)
            {
                <label class="tm-signing-field-editor-panel__field">
                    <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_SignatureFormat"]</span>
                    <select class="tm-signing-field-editor-panel__signature-format"
                            value="@(_field.Preferences.Format ?? string.Empty)"
                            disabled="@ReadOnly"
                            @onchange="args => HandlePreferenceTextChangedAsync(args, (preferences, value) => preferences.Format = value)">
                        <option value="">@Loc["TmSigning_Draw"]</option>
                        <option value="typed">@Loc["TmSigning_Type"]</option>
                        <option value="upload">@Loc["TmSigning_Upload"]</option>
                    </select>
                </label>
                <label class="tm-signing-field-editor-panel__check">
                    <input class="tm-signing-field-editor-panel__signature-id"
                           type="checkbox"
                           checked="@(_field.Preferences.WithSignatureId == true)"
                           disabled="@ReadOnly"
                           @onchange="args => HandlePreferenceBoolChangedAsync(args, (preferences, value) => preferences.WithSignatureId = value)" />
                    <span>@Loc["TmSigningFieldEditorPanel_WithSignatureId"]</span>
                </label>
            }

            @if (IsStampField)
            {
                <label class="tm-signing-field-editor-panel__check">
                    <input class="tm-signing-field-editor-panel__stamp-logo"
                           type="checkbox"
                           checked="@(_field.Preferences.WithLogo == true)"
                           disabled="@ReadOnly"
                           @onchange="args => HandlePreferenceBoolChangedAsync(args, (preferences, value) => preferences.WithLogo = value)" />
                    <span>@Loc["TmSigningFieldEditorPanel_WithLogo"]</span>
                </label>
            }

            <div class="tm-signing-field-editor-panel__grid">
                <label class="tm-signing-field-editor-panel__field">
                    <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_FontFamily"]</span>
                    <select class="tm-signing-field-editor-panel__font-family"
                            value="@(_field.Preferences.FontFamily ?? string.Empty)"
                            disabled="@ReadOnly"
                            @onchange="args => HandlePreferenceTextChangedAsync(args, (preferences, value) => preferences.FontFamily = value)">
                        <option value="">@Loc["TmSigningFieldEditorPanel_Default"]</option>
                        <option value="sans">@Loc["TmSigningFieldEditorPanel_FontSans"]</option>
                        <option value="serif">@Loc["TmSigningFieldEditorPanel_FontSerif"]</option>
                        <option value="mono">@Loc["TmSigningFieldEditorPanel_FontMono"]</option>
                    </select>
                </label>
                <label class="tm-signing-field-editor-panel__field">
                    <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_FontSize"]</span>
                    <input class="tm-signing-field-editor-panel__font-size"
                           type="number"
                           value="@_field.Preferences.FontSize"
                           disabled="@ReadOnly"
                           @onchange="HandleFontSizeChangedAsync" />
                </label>
            </div>

            <div class="tm-signing-field-editor-panel__grid">
                <label class="tm-signing-field-editor-panel__field">
                    <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_Align"]</span>
                    <select class="tm-signing-field-editor-panel__align"
                            value="@(_field.Preferences.Align ?? string.Empty)"
                            disabled="@ReadOnly"
                            @onchange="args => HandlePreferenceTextChangedAsync(args, (preferences, value) => preferences.Align = value)">
                        <option value="">@Loc["TmSigningFieldEditorPanel_Default"]</option>
                        <option value="left">@Loc["TmSigningFieldEditorPanel_Left"]</option>
                        <option value="center">@Loc["TmSigningFieldEditorPanel_Center"]</option>
                        <option value="right">@Loc["TmSigningFieldEditorPanel_Right"]</option>
                    </select>
                </label>
                <label class="tm-signing-field-editor-panel__field">
                    <span class="tm-signing-field-editor-panel__label">@Loc["TmSigningFieldEditorPanel_Color"]</span>
                    <input class="tm-signing-field-editor-panel__color"
                           type="color"
                           value="@ColorInputValue"
                           disabled="@ReadOnly"
                           @onchange="args => HandlePreferenceTextChangedAsync(args, (preferences, value) => preferences.Color = value)" />
                </label>
            </div>

            <button type="button"
                    class="tm-signing-field-editor-panel__copy-to-pages"
                    disabled="@ReadOnly"
                    @onclick="CopyToAllPagesAsync">
                <TmIcon Name="copy" Size="IconSize.Xs" />
                @Loc["TmSigningFieldEditorPanel_CopyToAllPages"]
            </button>
        </section>

        <section class="tm-signing-field-editor-panel__section">
            <h3 class="tm-signing-field-editor-panel__section-title">@Loc["TmSigningFieldEditorPanel_Rules"]</h3>
            <div class="tm-signing-field-editor-panel__actions">
                <button type="button"
                        class="tm-signing-field-editor-panel__open-conditions"
                        disabled="@ReadOnly"
                        @onclick="ToggleConditions">
                    <TmIcon Name="filter" Size="IconSize.Xs" />
                    @Loc["TmSigning_Condition"]
                </button>
                @if (CanEditFormula)
                {
                    <button type="button"
                            class="tm-signing-field-editor-panel__open-formula"
                            disabled="@ReadOnly"
                            @onclick="ToggleFormula">
                        <TmIcon Name="calculator" Size="IconSize.Xs" />
                        @Loc["TmSigning_Formula"]
                    </button>
                }
            </div>

            @if (_showConditions)
            {
                <div class="tm-signing-field-editor-panel__condition-builder">
                    <TmConditionBuilder Fields="Fields"
                                        CurrentFieldUuid="@_field.Uuid"
                                        Conditions="_field.Conditions"
                                        ConditionsChanged="HandleConditionsChangedAsync"
                                        Culture="@Culture"
                                        FallbackCulture="@FallbackCulture"
                                        Disabled="@ReadOnly" />
                </div>
            }

            @if (_showFormula && CanEditFormula)
            {
                <div class="tm-signing-field-editor-panel__formula-builder">
                    <TmFormulaBuilder Field="_field"
                                      Fields="Fields"
                                      Culture="@Culture"
                                      FallbackCulture="@FallbackCulture"
                                      Saved="HandleFormulaSavedAsync"
                                      Disabled="@ReadOnly" />
                </div>
            }
        </section>
    }
</aside>
