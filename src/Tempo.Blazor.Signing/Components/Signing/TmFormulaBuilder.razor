@namespace Tempo.Blazor.Components.Signing
@using Tempo.Blazor.Abstractions.Models
@using Tempo.Blazor.Components.Inputs
@inject Microsoft.JSInterop.IJSRuntime JS

<div @attributes="AdditionalAttributes"
     class="@RootClass"
     aria-invalid="@BoolText(_error is not null)">
    <div class="tm-formula-builder__editor">
        <label class="tm-formula-builder__label" for="@_textareaId">@Loc["TmFormulaBuilder_Formula"]</label>
        <div class="tm-formula-builder__textarea" @ref="_textareaHost">
            <TmTextArea Id="@_textareaId"
                        Value="@_formulaText"
                        Placeholder="@Loc["TmFormulaBuilder_Placeholder"]"
                        Disabled="@Disabled"
                        Rows="4"
                        Immediate="true"
                        Error="@_error"
                        ValueChanged="HandleInputAsync" />
        </div>
    </div>

    <section class="tm-formula-builder__group tm-formula-builder__group--operators" role="group" aria-labelledby="@_operatorsHeadingId">
        <h3 class="tm-formula-builder__section-title" id="@_operatorsHeadingId">@Loc["TmFormulaBuilder_Operators"]</h3>
        <div class="tm-formula-builder__toolbar">
            @foreach (var op in Operators)
            {
                var operatorText = GetOperatorText(op);
                @* The operator glyphs are ambiguous to a screen reader ("+", "*"); the button
                   carries the localized spoken name (phase 7 review). *@
                <button type="button"
                        class="tm-formula-builder__operator"
                        data-operator="@op"
                        aria-label="@GetOperatorAriaLabel(op)"
                        disabled="@Disabled"
                        @onclick="() => InsertTextAsync(operatorText)">
                    @op
                </button>
            }
        </div>
    </section>

    <section class="tm-formula-builder__group tm-formula-builder__group--functions" role="group" aria-labelledby="@_functionsHeadingId">
        <h3 class="tm-formula-builder__section-title" id="@_functionsHeadingId">@Loc["TmFormulaBuilder_Functions"]</h3>
        <div class="tm-formula-builder__functions">
            @foreach (var function in Functions)
            {
                <button type="button"
                        class="tm-formula-builder__function"
                        data-function="@function"
                        disabled="@Disabled"
                        @onclick="() => InsertTextAsync(function)">
                    @function
                </button>
            }
        </div>
    </section>

    <section class="tm-formula-builder__group tm-formula-builder__group--tokens" role="group" aria-labelledby="@_tokensHeadingId">
        <h3 class="tm-formula-builder__section-title" id="@_tokensHeadingId">@Loc["TmFormulaBuilder_Tokens"]</h3>
        <div class="tm-formula-builder__tokens">
            @foreach (var sourceField in FormulaSourceFields)
            {
                <button type="button"
                        class="tm-formula-builder__token"
                        data-field-uuid="@sourceField.Uuid"
                        disabled="@Disabled"
                        @onclick="() => InsertFieldTokenAsync(sourceField)">
                    <span class="tm-formula-builder__token-label">@GetLocalizedFieldLabel(sourceField)</span>
                    <span class="tm-formula-builder__token-type">@GetFieldTypeLabel(sourceField.Type)</span>
                </button>
            }
        </div>
    </section>

    <div class="tm-formula-builder__actions">
        <button type="button"
                class="tm-btn tm-btn-primary tm-btn-sm tm-formula-builder__save"
                disabled="@Disabled"
                @onclick="SaveAsync">
            <TmIcon Name="save" Size="IconSize.Xs" />
            @Loc["TmFormulaBuilder_Save"]
        </button>
    </div>
</div>
