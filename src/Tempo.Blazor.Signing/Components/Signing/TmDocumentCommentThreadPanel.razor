@namespace Tempo.Blazor.Components.Signing
@inherits Tempo.Blazor.Components.TmComponentBase
@implements Tempo.Blazor.Abstractions.Shared.ITmDraftGuard
@using Tempo.Blazor.Abstractions.Models
@using Tempo.Blazor.Abstractions.Shared

<aside class="@RootClass"
       aria-label="@Loc["TmDocumentComments_PanelLabel"]"
       data-testid="@TestId("document-comments-panel")"
       tabindex="0"
       @onkeydown="HandlePanelKeyDownAsync">
    <header class="tm-document-comments-panel__header">
        <div>
            <h3 class="tm-document-comments-panel__title">@Loc["TmDocumentComments_Title"]</h3>
            <p class="tm-document-comments-panel__summary">@SummaryText</p>
        </div>
        @if (!string.IsNullOrWhiteSpace(SelectedThreadId))
        {
            <button type="button"
                    class="tm-document-comments-panel__icon-button"
                    aria-label="@Loc["TmDocumentComments_CloseThread"]"
                    disabled="@Disabled"
                    @onclick="ClearSelectionAsync">
                <TmIcon Name="@IconNames.X" Size="IconSize.Sm" />
            </button>
        }
    </header>

    <div class="tm-document-comments-panel__filters" role="tablist" aria-label="@Loc["TmDocumentComments_FilterLabel"]">
        <button type="button" class="@FilterButtonClass(DocumentCommentThreadFilter.Open)" disabled="@Disabled" @onclick="() => SetFilter(DocumentCommentThreadFilter.Open)">
            @Loc["TmDocumentComments_FilterOpen"]
        </button>
        <button type="button" class="@FilterButtonClass(DocumentCommentThreadFilter.Mentions)" disabled="@Disabled" @onclick="() => SetFilter(DocumentCommentThreadFilter.Mentions)">
            @Loc["TmDocumentComments_FilterMentions"]
        </button>
        <button type="button" class="@FilterButtonClass(DocumentCommentThreadFilter.Resolved)" disabled="@Disabled" @onclick="() => SetFilter(DocumentCommentThreadFilter.Resolved)">
            @Loc["TmDocumentComments_FilterResolved"]
        </button>
    </div>

    @if (SelectedThread is not null)
    {
        <section class="tm-document-comments-panel__detail" data-thread-id="@SelectedThread.Id">
            <div class="tm-document-comments-panel__detail-header">
                <button type="button"
                        class="tm-document-comments-panel__back"
                        disabled="@Disabled"
                        @onclick="ClearSelectionAsync">
                    <TmIcon Name="chevron-left" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentComments_BackToList"]</span>
                </button>
                <span class="@StatusClass(SelectedThread)">@StatusText(SelectedThread)</span>
            </div>

            <div class="tm-document-comments-panel__thread-location">
                @DetailLocation(SelectedThread)
            </div>

            <div class="tm-document-comments-panel__items">
                @foreach (var comment in SelectedThread.Comments)
                {
                    <TmDocumentCommentItem ThreadId="@SelectedThread.Id"
                                           Comment="@comment"
                                           CurrentUserId="@CurrentUserId"
                                           Disabled="@Disabled"
                                           PickerOpen="@(_reactionPickerCommentId == comment.Id)"
                                           PickerOpenChanged="open => SetReactionPicker(comment.Id, open)"
                                           OnEditRequested="BeginEditAsync"
                                           OnDeleteRequested="DeleteCommentAsync"
                                           OnReactionToggled="ToggleReactionAsync" />
                }
            </div>

            @if (_editingComment is not null)
            {
                <TmCommentComposer @bind-Value="_editText"
                                   @bind-Value:after="NotifyDraftChangedAsync"
                                   Placeholder="@Loc["TmDocumentComments_EditPlaceholder"]"
                                   AriaLabel="@Loc["TmDocumentComments_EditLabel"]"
                                   SubmitText="@Loc["TmDocumentComments_Save"]"
                                   MentionUsers="@MentionUsers"
                                   Disabled="@Disabled"
                                   OnSubmit="SaveEditAsync"
                                   OnCancel="CancelEditAsync" />
            }
            else if (SelectedThread.Status == DocumentCommentThreadStatus.Open || AllowReplyToResolved)
            {
                <TmCommentComposer @bind-Value="_replyText"
                                   @bind-Value:after="NotifyDraftChangedAsync"
                                   Placeholder="@Loc["TmDocumentComments_ReplyPlaceholder"]"
                                   AriaLabel="@Loc["TmDocumentComments_ReplyLabel"]"
                                   SubmitText="@Loc["TmDocumentComments_Reply"]"
                                   MentionUsers="@MentionUsers"
                                   Disabled="@Disabled"
                                   OnSubmit="SubmitReplyAsync" />
            }

            <div class="tm-document-comments-panel__thread-actions">
                @if (SelectedThread.Status == DocumentCommentThreadStatus.Open)
                {
                    <button type="button" class="tm-document-comments-panel__resolve" disabled="@Disabled" @onclick="() => ResolveAsync(SelectedThread.Id)">
                        <TmIcon Name="@IconNames.CheckCircle" Size="IconSize.Sm" />
                        <span>@Loc["TmDocumentComments_Resolve"]</span>
                    </button>
                }
                else
                {
                    <button type="button" class="tm-document-comments-panel__resolve" disabled="@Disabled" @onclick="() => ReopenAsync(SelectedThread.Id)">
                        <TmIcon Name="@IconNames.RotateCcw" Size="IconSize.Sm" />
                        <span>@Loc["TmDocumentComments_Reopen"]</span>
                    </button>
                }
            </div>
        </section>
    }
    else if (FilteredThreads.Count == 0)
    {
        <div class="tm-document-comments-panel__empty">
            <TmIcon Name="@IconNames.MessageSquare" Size="IconSize.Md" />
            <span>@Loc["TmDocumentComments_Empty"]</span>
        </div>
    }
    else
    {
        <TmDocumentCommentThreadList Threads="@FilteredThreads"
                                     AllThreads="@Threads"
                                     SelectedThreadId="@SelectedThreadId"
                                     CurrentUserId="@CurrentUserId"
                                     Disabled="@Disabled"
                                     OnThreadSelected="SelectThreadAsync" />
    }
</aside>

@code {
    private DocumentCommentThreadFilter _filter = DocumentCommentThreadFilter.Open;
    private string? _reactionPickerCommentId;
    private DocumentComment? _editingComment;
    private string _editText = string.Empty;
    private string _replyText = string.Empty;

    /// <summary>Body of the comment as it was when its edit started — the differs-from-original baseline for the edit slot.</summary>
    private string _editOriginalBody = string.Empty;

    /// <summary>Thread id the composer state was last seeded for — a change resets the draft slots.</summary>
    private string? _lastSelectedThreadId;

    /// <summary>Last draft state handed to the parent — used to dedup <see cref="OnDraftChanged"/> notifications.</summary>
    private TmCommentDraftState _lastDraftState = new(false, null, false);

    /// <summary>Comment threads to render.</summary>
    [Parameter] public IReadOnlyList<DocumentCommentThread> Threads { get; set; } = [];

    /// <summary>Selected thread id.</summary>
    [Parameter] public string? SelectedThreadId { get; set; }

    /// <summary>Callback invoked when selected thread id changes.</summary>
    [Parameter] public EventCallback<string?> SelectedThreadIdChanged { get; set; }

    /// <summary>Current user id for mentions and active reactions.</summary>
    [Parameter] public string? CurrentUserId { get; set; }

    /// <summary>Users available for mention suggestions.</summary>
    [Parameter] public IReadOnlyList<DocumentCommentUser> MentionUsers { get; set; } = [];

    /// <summary>Whether replies are allowed on resolved threads.</summary>
    [Parameter] public bool AllowReplyToResolved { get; set; }

    /// <summary>Whether panel interaction is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Callback invoked when a reply is requested.</summary>
    [Parameter] public EventCallback<DocumentCommentReplyRequest> OnReplyRequested { get; set; }

    /// <summary>Callback invoked when resolving a thread is requested.</summary>
    [Parameter] public EventCallback<DocumentCommentThreadStatusRequest> OnResolveRequested { get; set; }

    /// <summary>Callback invoked when reopening a thread is requested.</summary>
    [Parameter] public EventCallback<DocumentCommentThreadStatusRequest> OnReopenRequested { get; set; }

    /// <summary>Callback invoked when editing a comment is requested.</summary>
    [Parameter] public EventCallback<DocumentCommentEditRequest> OnEditRequested { get; set; }

    /// <summary>Callback invoked when deleting a comment is requested.</summary>
    [Parameter] public EventCallback<DocumentCommentDeleteRequest> OnDeleteRequested { get; set; }

    /// <summary>Callback invoked when toggling a reaction is requested.</summary>
    [Parameter] public EventCallback<DocumentCommentReactionToggleRequest> OnReactionToggled { get; set; }

    /// <summary>Callback invoked when a thread asks the parent to navigate to its page.</summary>
    [Parameter] public EventCallback<DocumentCommentThreadNavigateRequest> OnThreadNavigateRequested { get; set; }

    /// <summary>Additional CSS class.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Notifies the parent that the panel's comment draft state changed. The reply and edit
    /// composers hold their text in private fields the host cannot observe through a parameter —
    /// this callback (together with <see cref="HasUnsavedDraft"/> and
    /// <see cref="DiscardDraftAsync"/>) is the draft-guard surface. Fires ONLY when the
    /// <see cref="TmCommentDraftState"/> value actually changes (value-equality dedup), never on
    /// every keystroke. <see cref="TmCommentDraftState.IsEditorOpen"/> is
    /// <see langword="true"/> while the reply composer is mounted (a thread is selected) or an
    /// edit is open; <see cref="TmCommentDraftState.EditingCommentId"/> carries the id of the
    /// comment under edit; <see cref="TmCommentDraftState.HasUnsavedContent"/> aggregates both —
    /// for an edit it means the text differs from the comment body as it was when the edit
    /// started, so opening an edit without changing anything is not an unsaved draft.
    /// </summary>
    [Parameter] public EventCallback<TmCommentDraftState> OnDraftChanged { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        // The reply composer is bound to the SELECTED thread: a selection change (or a thread
        // that stopped being reply-eligible) unmounts it parameter-driven — reset the draft
        // slots so the stale text cannot leak into the next thread's composer or into the state.
        if (!string.Equals(SelectedThreadId, _lastSelectedThreadId, StringComparison.Ordinal))
        {
            _lastSelectedThreadId = SelectedThreadId;
            _replyText = string.Empty;
            _editingComment = null;
            _editText = string.Empty;
            _editOriginalBody = string.Empty;
        }
        else if (!IsReplyComposerMounted)
        {
            _replyText = string.Empty;
        }
    }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        // Host-driven selection changes mount/unmount the reply composer — a transition the
        // consumer must see; the dedup keeps repeated parameter sets silent.
        await NotifyDraftChangedAsync();
    }

    /// <summary>
    /// Whether the panel currently holds an unsaved comment draft — text in the reply composer or
    /// an open edit whose text differs from the comment body as it was when the edit started. The
    /// SAME value carried by <see cref="TmCommentDraftState.HasUnsavedContent"/> that
    /// <see cref="OnDraftChanged"/> reports; read live from the composer state, so it can be
    /// polled at any time.
    /// <para>
    /// Read it on the component's dispatcher (e.g. from an event handler or via
    /// <c>InvokeAsync</c>) when called from a background thread.
    /// </para>
    /// </summary>
    public bool HasUnsavedDraft => BuildDraftState().HasUnsavedContent;

    /// <summary>
    /// Discards every draft in the panel: clears the reply composer text and closes the open edit
    /// (its text is cleared with it). Intended for the consumer AFTER the user confirmed the
    /// discard in the consumer's OWN confirmation dialog — the component never shows a
    /// confirmation itself; that is deliberately the consumer's responsibility.
    /// <para>
    /// A no-op (no notification) when no editor is open and no draft exists. Safe to
    /// call from outside the render cycle; the reset, re-render and notification are dispatched
    /// through <c>InvokeAsync</c>.
    /// </para>
    /// </summary>
    public Task DiscardDraftAsync()
        => InvokeAsync(async () =>
        {
            _replyText = string.Empty;
            _editingComment = null;
            _editText = string.Empty;
            _editOriginalBody = string.Empty;
            StateHasChanged();
            await NotifyDraftChangedAsync();
        });

    /// <summary>
    /// Whether the reply composer is currently mounted: a thread is selected, no edit is open and
    /// the thread accepts replies (open, or resolved with <see cref="AllowReplyToResolved"/>).
    /// </summary>
    private bool IsReplyComposerMounted => !IsEditOpen && SelectedThread is not null
        && (SelectedThread.Status == DocumentCommentThreadStatus.Open || AllowReplyToResolved);

    private bool IsEditOpen => _editingComment is not null;

    /// <summary>
    /// Builds the panel's draft snapshot: the reply composer is open while a thread is selected
    /// and no edit is running; the edit slot reports the edited comment id; the aggregate counts
    /// the reply text (only while the reply composer is mounted) plus an edit that moved beyond
    /// its original body.
    /// </summary>
    private TmCommentDraftState BuildDraftState()
    {
        var isEditOpen = IsEditOpen;
        var isReplyOpen = IsReplyComposerMounted;
        var hasEditDraft = isEditOpen
            && !string.Equals(_editText, _editOriginalBody, StringComparison.Ordinal);
        var hasReplyDraft = isReplyOpen && !string.IsNullOrWhiteSpace(_replyText);

        return new TmCommentDraftState(
            isReplyOpen || isEditOpen,
            _editingComment?.Id,
            hasReplyDraft || hasEditDraft);
    }

    /// <summary>
    /// Notifies <see cref="OnDraftChanged"/> only when the draft state actually changed — the
    /// composers report every keystroke into this path and the value-equality check keeps the
    /// parent from re-rendering without a real transition.
    /// </summary>
    private async Task NotifyDraftChangedAsync()
    {
        var state = BuildDraftState();
        if (state == _lastDraftState)
        {
            return;
        }

        _lastDraftState = state;
        await OnDraftChanged.InvokeAsync(state);
    }

    private string RootClass => string.Join(" ", new[] { "tm-document-comments-panel", Class }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private DocumentCommentThread? SelectedThread => Threads.FirstOrDefault(thread => thread.Id == SelectedThreadId);

    private IReadOnlyList<DocumentCommentThread> FilteredThreads => _filter switch
    {
        DocumentCommentThreadFilter.Resolved => Threads.Where(thread => thread.Status == DocumentCommentThreadStatus.Resolved).ToList(),
        DocumentCommentThreadFilter.Mentions => Threads.Where(thread => DocumentCommentHelper.MentionsUser(thread, CurrentUserId)).ToList(),
        _ => Threads.Where(thread => thread.Status == DocumentCommentThreadStatus.Open).ToList()
    };

    private string SummaryText => Loc["TmDocumentComments_Summary", DocumentCommentHelper.CountOpenThreads(Threads), Threads.Count];

    private string FilterButtonClass(DocumentCommentThreadFilter filter)
    {
        return filter == _filter
            ? "tm-document-comments-panel__filter tm-document-comments-panel__filter--active"
            : "tm-document-comments-panel__filter";
    }

    private void SetFilter(DocumentCommentThreadFilter filter)
    {
        _filter = filter;
    }

    private async Task SelectThreadAsync(DocumentCommentThread thread)
    {
        await SelectedThreadIdChanged.InvokeAsync(thread.Id);
        await OnThreadNavigateRequested.InvokeAsync(new DocumentCommentThreadNavigateRequest
        {
            ThreadId = thread.Id,
            PageNumber = thread.Anchor.PageNumber,
            Anchor = thread.Anchor
        });
    }

    private async Task ClearSelectionAsync()
    {
        // The reply composer unmounts with the selection — drop its draft (and any open edit)
        // here, so the immediate notification already reports the closed, empty state before the
        // host's parameter round-trip lands.
        _editingComment = null;
        _editText = string.Empty;
        _editOriginalBody = string.Empty;
        _replyText = string.Empty;
        _lastSelectedThreadId = null;
        StateHasChanged();
        await NotifyDraftChangedAsync();
        await SelectedThreadIdChanged.InvokeAsync(null);
    }

    private string DetailLocation(DocumentCommentThread thread)
    {
        if (thread.Anchor.Kind == DocumentCommentAnchorKind.Page)
        {
            return Loc["TmDocumentComments_PageThreadTitle", thread.Anchor.PageNumber];
        }

        return Loc["TmDocumentComments_PageLocation", thread.Anchor.PageNumber];
    }

    private string StatusClass(DocumentCommentThread thread)
    {
        return thread.Status == DocumentCommentThreadStatus.Resolved
            ? "tm-document-comments-panel__status tm-document-comments-panel__status--resolved"
            : "tm-document-comments-panel__status";
    }

    private string StatusText(DocumentCommentThread thread)
    {
        return thread.Status == DocumentCommentThreadStatus.Resolved
            ? Loc["TmDocumentComments_Resolved"]
            : Loc["TmDocumentComments_Open"];
    }

    private void SetReactionPicker(string commentId, bool open)
    {
        _reactionPickerCommentId = open ? commentId : null;
    }

    private Task HandlePanelKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && _reactionPickerCommentId is not null)
        {
            _reactionPickerCommentId = null;
        }

        return Task.CompletedTask;
    }

    private Task ToggleReactionAsync(DocumentCommentReactionToggleRequest request)
    {
        _reactionPickerCommentId = null;
        return OnReactionToggled.InvokeAsync(request);
    }

    private async Task SubmitReplyAsync(DocumentCommentComposerSubmitEventArgs args)
    {
        if (SelectedThread is null)
        {
            return;
        }

        await OnReplyRequested.InvokeAsync(new DocumentCommentReplyRequest
        {
            ThreadId = SelectedThread.Id,
            Body = args.Body,
            Mentions = args.Mentions.ToList()
        });
    }

    private Task ResolveAsync(string threadId)
    {
        return OnResolveRequested.InvokeAsync(new DocumentCommentThreadStatusRequest { ThreadId = threadId });
    }

    private Task ReopenAsync(string threadId)
    {
        return OnReopenRequested.InvokeAsync(new DocumentCommentThreadStatusRequest { ThreadId = threadId });
    }

    private async Task BeginEditAsync(DocumentComment comment)
    {
        // The edit composer replaces the reply composer — its draft would otherwise survive the
        // swap and reappear in the reply composer once the edit ends.
        _replyText = string.Empty;
        _editingComment = comment;
        _editText = comment.Body;
        _editOriginalBody = comment.Body;
        StateHasChanged();
        await NotifyDraftChangedAsync();
    }

    private async Task SaveEditAsync(DocumentCommentComposerSubmitEventArgs args)
    {
        if (SelectedThread is null || _editingComment is null)
        {
            return;
        }

        await OnEditRequested.InvokeAsync(new DocumentCommentEditRequest
        {
            ThreadId = SelectedThread.Id,
            CommentId = _editingComment.Id,
            Body = args.Body,
            Mentions = args.Mentions.ToList()
        });
        _editingComment = null;
        _editText = string.Empty;
        _editOriginalBody = string.Empty;
        // The edit closed (and the reply composer remounts) — report the cleared state.
        await NotifyDraftChangedAsync();
    }

    private async Task CancelEditAsync()
    {
        _editingComment = null;
        _editText = string.Empty;
        _editOriginalBody = string.Empty;
        StateHasChanged();
        await NotifyDraftChangedAsync();
    }

    private Task DeleteCommentAsync(DocumentCommentDeleteRequest request)
    {
        return OnDeleteRequested.InvokeAsync(request);
    }
}
