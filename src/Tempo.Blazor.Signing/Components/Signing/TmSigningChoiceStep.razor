@namespace Tempo.Blazor.Components.Signing
@using Tempo.Blazor.Abstractions.Models
@using Tempo.Blazor.Components.Inputs

<TmSigningStepShell Field="Field"
                    TitleId="@_titleId"
                    DescriptionId="@_descriptionId"
                    ValidationMessage="@EffectiveValidationMessage"
                    ValidationMessageId="@(HasValidationMessage ? _validationId : null)"
                    AppearsOn="@AppearsOn"
                    Culture="@Culture"
                    FallbackCulture="@FallbackCulture"
                    Class="@ShellClass"
                    @attributes="AdditionalAttributes">
    @if (IsCheckboxGroup)
    {
        @* The group is a real fieldset named by a visually hidden legend (phase 2 contract kept);
            the rows are the core TmCheckbox, each named by its own label and carrying the item
            field's description as help text (phase 4). The fieldset carries the hint /
            description / validation ids and the invalid state while the step shows a message. *@
        <fieldset class="tm-signing-choice-step__group"
                  aria-invalid="@InvalidText"
                  aria-describedby="@GroupDescribedBy">
            <legend class="tm-signing-choice-step__legend tm-sr-only">@GroupLegendText</legend>
            <div id="@_hintId" class="tm-signing-choice-step__hint">@Loc["TmSigningStep_CheckboxGroupHint"]</div>
            <div class="tm-signing-choice-step__options">
                @foreach (var checkboxField in CheckboxFields)
                {
                    <TmCheckbox Value="@IsGroupCheckboxChecked(checkboxField)"
                                ValueChanged="args => HandleGroupCheckboxChangedAsync(checkboxField, args)"
                                Label="@GetFieldLabel(checkboxField)"
                                HelpText="@GetFieldDescription(checkboxField)"
                                Disabled="@Disabled"
                                Class="tm-signing-choice-step__option tm-signing-choice-step__checkbox-row" />
                }
            </div>
        </fieldset>
    }
    else if (Field.Type == SigningFieldType.Select && !UseRadioCards)
    {
        @* TmSelect (phase 4, SI1). The step's accessibility plumbing rides the core
            SelectAttributes splat (phase 4 review): aria-invalid + the description / validation
            ids reach the NATIVE <select>, and the shell title is its labelledby (the visible
            field label stays the accessible name — see TmSelect.AriaLabel). Phase 5: a mobile
            layout with ≤ 5 options swaps this picker for the radio cards below (SI1). *@
        <TmSelect TValue="string"
                  Value="@SingleValue"
                  ValueChanged="HandleSingleValueChangedAsync"
                  AriaLabel="@DisplayFieldLabel"
                  Placeholder="@Loc["TmSigningStep_SelectPlaceholder"]"
                  PlaceholderSelectable="true"
                  Disabled="@Disabled"
                  Options="@SelectOptions"
                  Class="tm-signing-choice-step__select"
                  SelectAttributes="@(BuildSelectAttributes())" />
    }
    else if (Field.Type == SigningFieldType.Select || Field.Type == SigningFieldType.Radio)
    {
        @* The radio group keeps the fieldset/legend group name (phase 2 contract) and renders the
            core TmRadioGroup rows (phase 4); the name is unique per component instance so two
            rendered groups never merge into one browser-level group. The selected row lights with
            the primary-subtle state through _signing-steps.css (:has() on the package chain).
            Phase 5 (SI1): on a mobile layout the rows present as radio CARDS (≤ 5 options) — the
            same control, the same stable values, the card look rides the Signing CSS modifier.
            Phase 5 review: an OPTIONAL select's card set gains a localized "None" card first that
            sends the empty value (the system picker's selectable placeholder kept its contract). *@
        <fieldset class="tm-signing-choice-step__group"
                  aria-invalid="@InvalidText"
                  aria-describedby="@DescribedBy">
            <legend class="tm-signing-choice-step__legend tm-sr-only">@GroupLegendText</legend>
            <TmRadioGroup T="string"
                          Name="@_radioName"
                          Value="@SingleValue"
                          ValueChanged="HandleRadioValueChangedAsync"
                          Options="@RadioOptions"
                          Disabled="@Disabled"
                          Class="@RadioGroupClass" />
        </fieldset>
    }
    else if (Field.Type == SigningFieldType.Multiple)
    {
        <fieldset class="tm-signing-choice-step__group"
                  aria-invalid="@InvalidText"
                  aria-describedby="@DescribedBy">
            <legend class="tm-signing-choice-step__legend tm-sr-only">@GroupLegendText</legend>
            <div class="tm-signing-choice-step__options">
                @foreach (var option in Field.Options)
                {
                    <TmCheckbox Value="@SelectedValues.Contains(option.Uuid)"
                                ValueChanged="args => HandleMultipleValueChangedAsync(option.Uuid, args)"
                                Label="@GetOptionLabel(option)"
                                Disabled="@Disabled"
                                Class="tm-signing-choice-step__option tm-signing-choice-step__checkbox-row" />
                }
            </div>
        </fieldset>
    }
    else
    {
        @* The single checkbox (phase 4 review): aria-invalid reaches the NATIVE input through the
            core InputAttributes splat — together with the description / validation ids, exactly
            like the other single controls. *@
        <TmCheckbox Value="@BoolValue"
                    ValueChanged="HandleCheckboxChangedAsync"
                    Label="@(AnonymousCheckbox ? Loc["TmSigningStep_CheckboxInstruction"] : GetFieldLabel(Field))"
                    Disabled="@Disabled"
                    InputAttributes="@(BuildSingleCheckboxAttributes())"
                    Class="tm-signing-choice-step__option tm-signing-choice-step__option--single" />
    }
</TmSigningStepShell>
