@namespace Tempo.Blazor.Components.Signing
@using Tempo.Blazor.Abstractions.Models

<section @attributes="AdditionalAttributes"
         class="@RootClass">
    <header class="tm-signing-step-shell__header">
        <div class="tm-signing-step-shell__heading">
            @* The title is the step's focus target and the accessible name of the step's
               unlabelled inputs: stable id (also cascaded via TmSigningStepShellContext) and
               tabindex="-1" so FocusAsync can move to it after a step change. *@
            <h3 id="@TitleElementId" class="tm-signing-step-shell__title" tabindex="-1" @ref="_titleElement">@DisplayLabel</h3>
            @if (IsRequired)
            {
                <span class="tm-signing-step-shell__required">@Loc["TmSigning_Required"]</span>
            }
            else
            {
                <span class="tm-signing-step-shell__optional">@Loc["TmSigning_Optional"]</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(AppearsOn))
        {
            <span class="tm-signing-step-shell__appears-on">@AppearsOn</span>
        }
    </header>

    @if (HasDescription)
    {
        <div id="@DescriptionElementId" class="tm-signing-step-shell__description">@((MarkupString)FormatDescription(ResolvedDescription))</div>
    }

    <div class="tm-signing-step-shell__content">
        <CascadingValue Value="Context" IsFixed="false">
            @ChildContent
        </CascadingValue>
    </div>

    @if (HasValidationMessage)
    {
        <div id="@ValidationMessageElementId" class="tm-signing-step-shell__validation" role="alert">@EffectiveValidationMessage</div>
    }
</section>
