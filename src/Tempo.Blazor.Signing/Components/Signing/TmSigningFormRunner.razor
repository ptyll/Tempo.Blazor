@namespace Tempo.Blazor.Components.Signing
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Abstractions.Models
@using Tempo.Blazor.Components.Inputs

<div @attributes="AdditionalAttributes"
     class="@RootClass"
     aria-busy="@BoolText(IsLoading)">
    @* The runner root is the CSS size container (see _signing-form-runner.css); its grid lives on
       an inner element because a @container rule can never restyle the container itself. *@
    <div class="tm-signing-form-runner__layout">
    @if (Plan.Steps.Count == 0)
    {
        <div class="tm-signing-form-runner__empty" role="status">
            <TmEmptyState Icon="check-circle"
                          Title="@Loc["TmSigningFormRunner_EmptyTitle"]"
                          Description="@Loc["TmSigningFormRunner_EmptyDescription"]" />
        </div>
    }
    else
    {
        <div class="tm-signing-form-runner__documents" data-testid="@TestId("signing-runner-documents")">
            @foreach (var documentPage in Pages)
            {
                <div class="tm-signing-form-runner__document" data-attachment-uuid="@(documentPage.AttachmentUuid)" data-page-index="@(documentPage.PageIndex)">
                    <TmDocumentPageViewer Page="@documentPage">
                        @foreach (var overlay in GetPageOverlays(documentPage))
                        {
                            <TmSigningFieldOverlay Field="@overlay.Field"
                                                   Area="@overlay.Area"
                                                   Value="@GetOverlayValue(overlay.Field)"
                                                   RoleColor="@GetOverlayRoleColor(overlay.Field)"
                                                   Selected="@IsCurrentField(overlay.Field)"
                                                   Focused="@IsCurrentField(overlay.Field)"
                                                   Invalid="@IsInvalid(overlay.Field)"
                                                   Completed="@IsFieldComplete(overlay.Field)"
                                                   ReadOnly="true"
                                                   Culture="@CurrentCulture"
                                                   FallbackCulture="@FallbackCulture"
                                                   OnClick="HandleOverlayClickAsync" />
                        }
                    </TmDocumentPageViewer>
                </div>
            }
        </div>

        <aside class="tm-signing-form-runner__steps" data-testid="@TestId("signing-runner-steps")">
            @RenderStepPanel(false)
        </aside>

        <div class="@MobilePanelClass" data-complete-target="@MobileCompleteTargetSelector">
            @if (!_mobileExpanded)
            {
                <button type="button"
                        class="tm-signing-form-runner__mobile-expand"
                        @onclick="ExpandMobilePanel">
                    @Loc["TmSigningFormRunner_SignNow"]
                </button>
            }
            else
            {
                <button type="button"
                        class="tm-signing-form-runner__mobile-minimize"
                        @onclick="MinimizeMobilePanel"
                        aria-label="@Loc["TmSigningFormRunner_Minimize"]">
                    @Loc["TmSigningFormRunner_Minimize"]
                </button>
                @RenderStepPanel(true)
            }
        </div>
    }
    </div>
</div>

@code {
    private RenderFragment RenderStepPanel(bool mobile) => @<div class="tm-signing-form-runner__step-panel" data-mobile="@BoolText(mobile)">
        <div class="tm-signing-form-runner__progress"
             role="status"
             aria-label="@ProgressAriaLabel">
            @Loc["TmSigningFormRunner_Progress", CurrentStepIndex + 1, Plan.Steps.Count]
        </div>

        @if (ShowLanguagePicker)
        {
            <label class="tm-signing-form-runner__language">
                <span>@Loc["TmSigningFormRunner_Language"]</span>
                <select class="tm-signing-form-runner__language-select"
                        value="@CurrentCulture"
                        aria-label="@Loc["TmSigningFormRunner_LanguageAria"]"
                        @onchange="HandleCultureChangedAsync">
                    @foreach (var culture in SupportedCultures)
                    {
                        <option value="@culture">@GetCultureDisplayName(culture)</option>
                    }
                </select>
            </label>
        }

        <button type="button"
                class="tm-signing-form-runner__accessibility-entry"
                @onclick="ToggleAccessibilityMode">
            @Loc["TmSigningFormRunner_AccessibilityMode"]
        </button>

        @if (_accessibilityMode)
        {
            <div class="tm-signing-form-runner__accessibility-list">
                @foreach (var step in Plan.Steps.Select((value, index) => new { value, index }))
                {
                    <button type="button"
                            class="tm-signing-form-runner__accessibility-field"
                            aria-current="@BoolText(step.index == CurrentStepIndex)"
                            @onclick="() => SelectStep(step.index)">
                        @GetStepLabel(step.value)
                    </button>
                }
            </div>
        }

        @if (CurrentStep is not null)
        {
            <div class="tm-signing-form-runner__current-step">
                @switch (CurrentStep.Field.Type)
                {
                    case SigningFieldType.Text:
                    case SigningFieldType.Cells:
                        <TmSigningTextStep Field="CurrentStep.Field"
                                           Area="CurrentStep.Area"
                                           Value="@GetStringValue(CurrentStep.Field.Uuid)"
                                           ValueChanged="value => SetFieldValueAsync(CurrentStep.Field.Uuid, value)"
                                           AppearsOn="@CurrentStep.AppearsOn"
                                           Culture="@CurrentCulture"
                                           FallbackCulture="@FallbackCulture"
                                           Disabled="@IsLoading" />
                        break;
                    case SigningFieldType.Number:
                        <TmSigningNumberStep Field="CurrentStep.Field"
                                             Value="@GetDecimalValue(CurrentStep.Field.Uuid)"
                                             ValueChanged="value => SetFieldValueAsync(CurrentStep.Field.Uuid, value)"
                                             AppearsOn="@CurrentStep.AppearsOn"
                                             Culture="@CurrentCulture"
                                             FallbackCulture="@FallbackCulture"
                                             Disabled="@IsLoading" />
                        break;
                    case SigningFieldType.Date:
                    case SigningFieldType.DateNow:
                        <TmSigningDateStep Field="CurrentStep.Field"
                                           Value="@GetStringValue(CurrentStep.Field.Uuid)"
                                           ValueChanged="value => SetFieldValueAsync(CurrentStep.Field.Uuid, value)"
                                           AppearsOn="@CurrentStep.AppearsOn"
                                           Culture="@CurrentCulture"
                                           FallbackCulture="@FallbackCulture"
                                           Disabled="@IsLoading" />
                        break;
                    case SigningFieldType.Select:
                    case SigningFieldType.Radio:
                    case SigningFieldType.Multiple:
                    case SigningFieldType.Checkbox:
                        <TmSigningChoiceStep Field="CurrentStep.Field"
                                             Fields="CurrentStep.Fields"
                                             Value="@GetValue(CurrentStep.Field.Uuid)"
                                             ValueChanged="value => SetChoiceValueAsync(CurrentStep, value)"
                                             AppearsOn="@CurrentStep.AppearsOn"
                                             Culture="@CurrentCulture"
                                             FallbackCulture="@FallbackCulture"
                                             Disabled="@IsLoading" />
                        break;
                    case SigningFieldType.Image:
                    case SigningFieldType.File:
                    case SigningFieldType.Stamp:
                        <TmSigningAttachmentStep Field="CurrentStep.Field"
                                                 Attachments="@GetAttachments(CurrentStep.Field.Uuid)"
                                                 AttachmentsChanged="value => SetFieldValueAsync(CurrentStep.Field.Uuid, value)"
                                                 StampValue="@GetStringValue(CurrentStep.Field.Uuid)"
                                                 AppearsOn="@CurrentStep.AppearsOn"
                                                 AllowMultiple="@(CurrentStep.Field.Type == SigningFieldType.File)"
                                                 Accept="@(CurrentStep.Field.Type == SigningFieldType.Image ? "image/*" : null)"
                                                 Culture="@CurrentCulture"
                                                 FallbackCulture="@FallbackCulture"
                                                 Disabled="@IsLoading" />
                        break;
                    case SigningFieldType.Signature:
                    case SigningFieldType.Initials:
                        <TmSignatureCapture Value="@GetStringValue(CurrentStep.Field.Uuid)"
                                            ValueChanged="value => SetFieldValueAsync(CurrentStep.Field.Uuid, value)"
                                            Required="@CurrentStep.Field.Required"
                                            Initials="@(CurrentStep.Field.Type == SigningFieldType.Initials)"
                                            Mode="@GetSignatureCaptureMode(CurrentStep.Field)"
                                            ModeChanged="mode => SetSignatureCaptureModeAsync(CurrentStep.Field.Uuid, mode)"
                                            Disabled="@IsLoading" />
                        break;
                    case SigningFieldType.Phone:
                        <TmSigningPhoneStep Field="CurrentStep.Field"
                                            PhoneNumber="@GetStringValue(CurrentStep.Field.Uuid)"
                                            PhoneNumberChanged="value => SetFieldValueAsync(CurrentStep.Field.Uuid, value)"
                                            ValueChanged="value => SetFieldValueAsync(CurrentStep.Field.Uuid, value)"
                                            AppearsOn="@CurrentStep.AppearsOn"
                                            Culture="@CurrentCulture"
                                            FallbackCulture="@FallbackCulture"
                                            Disabled="@IsLoading" />
                        break;
                    case SigningFieldType.Verification:
                    case SigningFieldType.Kba:
                    case SigningFieldType.Payment:
                        <TmSigningExternalStep Field="CurrentStep.Field"
                                               AppearsOn="@CurrentStep.AppearsOn"
                                               Disabled="@IsLoading"
                                               Culture="@CurrentCulture"
                                               FallbackCulture="@FallbackCulture"
                                               OnStart="field => SetFieldValueAsync(field.Uuid, true)"
                                               OnCheckout="field => SetFieldValueAsync(field.Uuid, true)" />
                        break;
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_validationMessage))
        {
            <div class="tm-signing-form-runner__validation" role="alert">@_validationMessage</div>
        }

        <div class="tm-signing-form-runner__autosave" data-state="@_autoSaveState">
            @AutoSaveStatusText
        </div>

        <div class="tm-signing-form-runner__actions">
            <button type="button"
                    class="tm-signing-form-runner__previous"
                    disabled="@IsPreviousDisabled"
                    @onclick="GoPreviousAsync">
                @Loc["TmSigning_Previous"]
            </button>
            <button type="button"
                    class="tm-signing-form-runner__skip"
                    disabled="@IsSkipDisabled"
                    @onclick="SkipCurrentAsync">
                @Loc["TmSigningFormRunner_Skip"]
            </button>
            <button type="button"
                    class="tm-signing-form-runner__next"
                    disabled="@IsNextDisabled"
                    @onclick="GoNextAsync">
                @Loc["TmSigning_Next"]
            </button>
            <button type="button"
                    class="tm-signing-form-runner__complete"
                    disabled="@IsCompleteDisabled"
                    @onclick="CompleteAsync">
                @(IsCompleting ? Loc["TmSigningFormRunner_Completing"] : Loc["TmSigning_Complete"])
            </button>
        </div>
    </div>;
}
