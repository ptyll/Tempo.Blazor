@namespace Tempo.Blazor.Components.Signing
@using Tempo.Blazor.Abstractions.Layout
@using Tempo.Blazor.Abstractions.Models
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Inputs
@using Tempo.Blazor.Components.Layout
@using Tempo.Blazor.Components.Navigation
@using Tempo.Blazor.Components.Toolbar

<TmEditorShell @attributes="AdditionalAttributes"
               Class="@RootClass"
               style="@RootStyle"
               LayoutMode="ShellLayoutMode"
               Breakpoints="@(LayoutBreakpoints ?? DesignerBreakpoints)"
               ResolvedLayoutChanged="OnShellLayoutChanged"
               TabletPanelPresentation="TabletPanelPresentation.Overlay"
               LeftTitle="@Loc["TmPdfTemplateDesigner_Palette"]"
               RightTitle="@Loc["TmPdfTemplateDesigner_Inspector"]"
               LeftOpen="PaletteOpen"
               LeftOpenChanged="OnPaletteOpenChanged"
               RightOpen="InspectorOpen"
               RightOpenChanged="OnInspectorOpenChanged">
    <Toolbar>
        <TmPdfTemplateDesignerToolbar TwoRow="@(ResolvedLayout == TmLayoutMode.Tablet)"
                                      PageLabel="@PageLabel"
                                      ZoomLabel="@ZoomLabel"
                                      CanGoPrevious="CanGoPrevious"
                                      CanGoNext="CanGoNext"
                                      CanZoomOut="CanZoomOut"
                                      CanZoomIn="CanZoomIn"
                                      SinglePageActive="@(_viewMode == DocumentPageViewMode.SinglePage)"
                                      ContinuousActive="@(_viewMode == DocumentPageViewMode.Continuous)"
                                      ShowCulture="ShouldShowCulturePreview"
                                      Cultures="DesignerCultures"
                                      CurrentCulture="@CurrentCulture"
                                      CultureMenuItems="CultureMenuItems"
                                      CultureAttributes="CulturePreviewAttributes"
                                      CultureLabel="GetCultureLabel"
                                      ShowDetect="@(OnDetectFields is not null)"
                                      Detecting="_isDetecting"
                                      ShowDeleteSelected="@(SelectedFieldCount > 1)"
                                      OnPreviousPage="GoToPreviousPageAsync"
                                      OnNextPage="GoToNextPageAsync"
                                      OnSinglePage="() => SetViewModeAsync(DocumentPageViewMode.SinglePage)"
                                      OnContinuous="() => SetViewModeAsync(DocumentPageViewMode.Continuous)"
                                      OnCultureChanged="HandleCultureValueChangedAsync"
                                      OnZoomOut="ZoomOutAsync"
                                      OnZoomIn="ZoomInAsync"
                                      OnFitWidth="FitWidthAsync"
                                      OnFitPage="FitPageAsync"
                                      OnDetect="DetectFieldsAsync"
                                      OnDeleteSelected="DeleteSelectedAsync" />
        @* The shell's inspector sheet covers the canvas from its top edge, so the tablet rail lives
           above the canvas. One palette instance occupies this slot. *@
        @if (ShowCanvasPalette && !Disabled && Documents.Count > 0)
        {
            <TmPdfTemplateDesignerPalette Variant="PdfTemplatePaletteVariant.Rail"
                                          FieldTypes="AllowedTypes"
                                          ItemClass="GetPaletteItemClass"
                                          Label="GetFieldTypeLabel"
                                          Icon="GetIconName"
                                          OnPointerDown="StartPaletteDrag"
                                          OnPointerUp="FinishPalettePressAsync"
                                          OnClick="HandlePaletteClickAsync"
                                          OnCancel="EndPaletteDrag" />
        }
    </Toolbar>
    <Left>
        @if (ShowDockedPalette)
        {
            <TmPdfTemplateDesignerPalette Variant="@(ResolvedLayout == TmLayoutMode.Mobile ? PdfTemplatePaletteVariant.Compact : PdfTemplatePaletteVariant.Docked)"
                                          FieldTypes="AllowedTypes"
                                          ShowMobileDraw="@(ResolvedLayout == TmLayoutMode.Mobile)"
                                          ItemClass="GetPaletteItemClass"
                                          Label="GetFieldTypeLabel"
                                          Icon="GetIconName"
                                          OnPointerDown="StartPaletteDrag"
                                          OnPointerUp="FinishPalettePressAsync"
                                          OnClick="HandlePaletteClickAsync"
                                          OnCancel="EndPaletteDrag"
                                          OnMobileDraw="() => SelectFieldTypeAsync(AllowedTypes.FirstOrDefault())" />
        }
    </Left>
    <Canvas>
        <div class="tm-pdf-template-designer__workspace"
             tabindex="0"
             @ref="_workspaceRef"
             @onkeydown="HandleDesignerKeyDownAsync"
             @attributes="WorkspacePointerHandlers">
            @if (Documents.Count == 0)
            {
                <TmEmptyState Icon="file-text"
                              Title="@Loc["TmPdfTemplateDesigner_EmptyTitle"]"
                              Description="@Loc["TmPdfTemplateDesigner_EmptyDescription"]" />
            }
            else
            {
                <section class="tm-pdf-template-designer__canvas" aria-label="@Loc["TmPdfTemplateDesigner_CanvasLabel"]">
                    @if (!string.IsNullOrWhiteSpace(_detectionError))
                    {
                        <TmAlert Severity="AlertSeverity.Error" Class="tm-pdf-template-designer__detection-error">@_detectionError</TmAlert>
                    }
                    @if (!string.IsNullOrWhiteSpace(_clipboardStatus))
                    {
                        <div class="tm-pdf-template-designer__clipboard-status" role="status">
                            <TmIcon Name="clipboard-check" Size="IconSize.Xs" />
                            <span>@_clipboardStatus</span>
                        </div>
                    }
                    <div class="tm-pdf-template-designer__pages">
                        @foreach (var page in VisibleDocuments)
                        {
                            <section class="tm-pdf-template-designer__page-frame" data-page-key="@GetPageKey(page)">
                                <TmDocumentPageViewer Page="page"
                                                      Id="@GetPageElementId(page)"
                                                      Scale="_scale"
                                                      ZoomMode="_zoomMode"
                                                      OverlayTemplate="context => RenderPageOverlay(context)" />
                            </section>
                        }
                    </div>
                </section>
            }
        </div>
        @if (_contextMenu is not null)
        {
            <TmContextMenu @ref="_contextMenuRef"
                           Class="tm-pdf-template-designer__context-menu"
                           SheetTitle="@Loc["TmPdfTemplateDesigner_ContextMenu"]"
                           IsOpenChanged="OnContextMenuOpenChanged">
                <Trigger>
                    <span class="tm-pdf-template-designer__context-anchor" style="@ContextMenuStyle" tabindex="-1" aria-hidden="true"></span>
                </Trigger>
                <ChildContent>
                    @if (_contextMenu.Kind == ContextMenuKind.Field)
                    {
                        <TmContextMenuItem Class="tm-pdf-template-designer__copy-field"
                                           Icon="copy"
                                           Label="@Loc["TmPdfTemplateDesigner_CopyField"]"
                                           OnClick="@CopyMenuField(_contextMenu.FieldUuid)" />
                        <TmContextMenuItem Class="tm-pdf-template-designer__delete-field"
                                           Icon="trash-2"
                                           IsDangerous="true"
                                           Label="@Loc["TmPdfTemplateDesigner_DeleteField"]"
                                           OnClick="@DeleteMenuField(_contextMenu.FieldUuid)" />
                    }
                    else if (_contextMenu.Kind == ContextMenuKind.Selection)
                    {
                        <TmContextMenuItem Class="tm-pdf-template-designer__copy-selection"
                                           Icon="copy"
                                           Label="@Loc["TmPdfTemplateDesigner_CopySelection"]"
                                           OnClick="@CopyMenuSelection()" />
                        <TmContextMenuItem Class="tm-pdf-template-designer__delete-selection"
                                           Icon="trash-2"
                                           IsDangerous="true"
                                           Label="@Loc["TmPdfTemplateDesigner_DeleteSelection"]"
                                           OnClick="DeleteSelectedAsync" />
                    }
                    else
                    {
                        <TmContextMenuItem Class="tm-pdf-template-designer__paste-field"
                                           Icon="clipboard"
                                           Disabled="@(!HasClipboardFields)"
                                           Label="@Loc["TmPdfTemplateDesigner_PasteField"]"
                                           OnClick="@PasteMenuField(_contextMenu)" />
                        @if (OnDetectFields is not null)
                        {
                            <TmContextMenuItem Class="tm-pdf-template-designer__detect-menu"
                                               Icon="scan-line"
                                               Label="@Loc["TmPdfTemplateDesigner_Autodetect"]"
                                               OnClick="DetectFieldsAsync" />
                        }
                    }
                </ChildContent>
            </TmContextMenu>
        }
    </Canvas>
    <Right>
        <aside class="tm-pdf-template-designer__panel" @onkeydown:stopPropagation="true">
            <TmSigningFieldEditorPanel Field="SelectedField"
                                       FieldChanged="HandleEditorFieldChangedAsync"
                                       Fields="_fields"
                                       SubmitterRoles="SubmitterRoles"
                                       ReadOnly="Disabled"
                                       Culture="@Culture"
                                       FallbackCulture="@FallbackCulture"
                                       SupportedCultures="DesignerCultures"
                                       ShowLocalizationEditor="ShowCulturePreview"
                                       CopyToAllPagesRequested="CopyFieldToAllPagesAsync"
                                       OnCopyRequested="CopyContextFieldFromInspectorAsync"
                                       OnDeleteRequested="DeleteContextFieldFromInspectorAsync"
                                       OnCopySelectionRequested="CopySelectionAsync"
                                       OnPasteRequested="PasteFromInspectorAsync"
                                       OnDeleteSelectionRequested="DeleteSelectedAsync"
                                       PasteEnabled="HasClipboardFields"
                                       ShowGeometry="true"
                                       PageWidth="@(CurrentPage?.Width ?? 0)"
                                       PageHeight="@(CurrentPage?.Height ?? 0)" />
        </aside>
    </Right>
</TmEditorShell>
