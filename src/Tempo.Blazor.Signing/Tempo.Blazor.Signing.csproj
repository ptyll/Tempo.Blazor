<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Tempo.Blazor</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Tempo.Blazor.Signing</PackageId>
    <Version>2.10.0</Version>
    <Authors>ptyll</Authors>
    <Title>Tempo.Blazor.Signing</Title>
    <Description>Signing workflow components for Tempo.Blazor, including PDF template design, recipient roles, signing form runner, document comments, verification panels, and audit trail UI.</Description>
    <PackageTags>blazor;components;signing;signature;pdf-template;workflow;audit-trail</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ptyll/Tempo.Blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ptyll/Tempo.Blazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.12" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tempo.Blazor\Tempo.Blazor.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.Abstractions\Tempo.Blazor.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Tempo.Blazor.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The node:test files for the package's ES module live inside wwwroot (the root package.json
       is "type": "module", so they import the module directly) and are a test asset, not a
       published one: keeping them as Content would ship __tests__/*.test.mjs to every consumer's
       static web assets. -->
  <ItemGroup>
    <Content Remove="wwwroot\**\__tests__\**" />
    <None Include="wwwroot\**\__tests__\**" Pack="false" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
  </ItemGroup>

</Project>
