<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <PackageId>Tempo.Blazor.Reporting</PackageId>
    <Version>2.8.22</Version>
    <Authors>ptyll</Authors>
    <Title>Tempo.Blazor.Reporting</Title>
    <Description>Blazor reporting components for Tempo Reporting: report viewer, parameter panel, explorer, lightweight designer, embedded sources, and remote Report Server integration.</Description>
    <PackageTags>blazor;reporting;reports;viewer;designer;explorer;parameters;pdf</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ptyll/Tempo.Blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ptyll/Tempo.Blazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.12" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tempo.Blazor\Tempo.Blazor.csproj" />
    <ProjectReference Include="..\Tempo.Reporting.Abstractions\Tempo.Reporting.Abstractions.csproj" />
    <ProjectReference Include="..\Tempo.Reporting.Engine\Tempo.Reporting.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Tempo.Blazor.Reporting.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
