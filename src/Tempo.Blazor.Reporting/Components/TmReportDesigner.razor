@namespace Tempo.Blazor.Reporting.Components
@inherits Tempo.Blazor.Components.TmComponentBase
@using System.Globalization
@using Tempo.Blazor.Reporting.Models
@using Tempo.Reporting.Abstractions.Definitions

<div class="@CssClass" data-testid="@TestId("tm-report-designer")" @attributes="AdditionalAttributes">
    <header class="tm-report-designer__topbar">
        <div>
            <p class="tm-report-designer__eyebrow">@Loc["TmReportDesigner_Label"]</p>
            <h2>@_definition.Name</h2>
        </div>
        <div class="tm-report-designer__topbar-actions">
            <label class="tm-report-designer__select-field">
                <span>@Loc["TmReportDesigner_Zoom"]</span>
                <select data-testid="@TestId("tm-designer-zoom")" value="@_zoomPercent" @onchange="HandleZoomChanged">
                    <option value="75">75%</option>
                    <option value="100">100%</option>
                    <option value="125">125%</option>
                    <option value="150">150%</option>
                </select>
            </label>
            <TmButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Icon="@IconNames.Undo2" AriaLabel="@Loc["TmReportDesigner_Undo"]" Disabled="@(!_undoStack.Any())" data-testid="@TestId("tm-designer-undo")" OnClick="Undo" />
            <TmButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Icon="@IconNames.Redo2" AriaLabel="@Loc["TmReportDesigner_Redo"]" Disabled="@(!_redoStack.Any())" data-testid="@TestId("tm-designer-redo")" OnClick="Redo" />
            <TmButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Icon="@IconNames.Copy" AriaLabel="@Loc["TmReportDesigner_Copy"]" Disabled="@(_selectedElementIds.Count == 0)" data-testid="@TestId("tm-designer-copy")" OnClick="CopySelected" />
            <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" Icon="@IconNames.Settings" data-testid="@TestId("tm-designer-page-setup-toggle")" OnClick="TogglePageSetup">
                @Loc["TmReportDesigner_PageSetup"]
            </TmButton>
        </div>
    </header>

    <div class="tm-report-designer__tabs" role="tablist" aria-label="@Loc["TmReportDesigner_Tabs"]">
        @foreach (var tab in Tabs)
        {
            <button type="button"
                    role="tab"
                    aria-selected="@(tab == _activeTab)"
                    class="@TabCss(tab)"
                    data-testid="@TabTestId(tab)"
                    @onclick="() => SetTab(tab)">
                @TabLabel(tab)
            </button>
        }
    </div>

    @if (_pageSetupOpen)
    {
        <section class="tm-report-designer__page-setup" data-testid="@TestId("tm-designer-page-setup")">
            <label>
                <span>@Loc["TmReportDesigner_PageWidth"]</span>
                <input data-testid="@TestId("tm-designer-page-width")" type="number" value="@_definition.PageSetup.PageSize.Width.ToString(CultureInfo.InvariantCulture)" @onchange="HandlePageWidthChanged" />
            </label>
            <label>
                <span>@Loc["TmReportDesigner_PageHeight"]</span>
                <input data-testid="@TestId("tm-designer-page-height")" type="number" value="@_definition.PageSetup.PageSize.Height.ToString(CultureInfo.InvariantCulture)" @onchange="HandlePageHeightChanged" />
            </label>
            <label>
                <span>@Loc["TmReportDesigner_Margins"]</span>
                <input data-testid="@TestId("tm-designer-page-margin")" type="number" value="@_definition.PageSetup.Margins.Left.ToString(CultureInfo.InvariantCulture)" @onchange="HandleMarginChanged" />
            </label>
            <label>
                <span>@Loc["TmReportDesigner_Orientation"]</span>
                <select data-testid="@TestId("tm-designer-page-orientation")" value="@_definition.PageSetup.Orientation.ToString()" @onchange="HandleOrientationChanged">
                    <option value="Portrait">@Loc["TmReportDesigner_Portrait"]</option>
                    <option value="Landscape">@Loc["TmReportDesigner_Landscape"]</option>
                </select>
            </label>
        </section>
    }

    <div class="tm-report-designer__body">
        @if (_activeTab == "design")
        {
            <aside class="tm-report-designer__palette" data-testid="@TestId("tm-designer-palette")">
                <h3>@Loc["TmReportDesigner_Palette"]</h3>
                <button type="button" data-testid="@TestId("tm-designer-add-textbox")" @onclick="AddTextBox">
                    <TmIcon Name="@IconNames.FileText" Size="IconSize.Sm" />
                    <span>@Loc["TmReportDesigner_TextBox"]</span>
                </button>
                <button type="button" data-testid="@TestId("tm-designer-add-image")" @onclick="AddImage">
                    <TmIcon Name="@IconNames.Image" Size="IconSize.Sm" />
                    <span>@Loc["TmReportDesigner_Image"]</span>
                </button>
                <button type="button" data-testid="@TestId("tm-designer-add-shape")" @onclick="AddShape">
                    <TmIcon Name="@IconNames.Square" Size="IconSize.Sm" />
                    <span>@Loc["TmReportDesigner_Shape"]</span>
                </button>
                <button type="button" data-testid="@TestId("tm-designer-add-table")" @onclick="AddTable">
                    <TmIcon Name="@IconNames.Table" Size="IconSize.Sm" />
                    <span>@Loc["TmReportDesigner_Table"]</span>
                </button>
                <button type="button" data-testid="@TestId("tm-designer-add-chart")" @onclick="AddChart">
                    <TmIcon Name="@IconNames.BarChart2" Size="IconSize.Sm" />
                    <span>@Loc["TmReportDesigner_Chart"]</span>
                </button>
            </aside>

            @RenderCanvas()
            @RenderProperties()
        }
        else if (_activeTab == "data")
        {
            @RenderDataPanel()
        }
        else
        {
            @RenderPreviewPanel()
        }
    </div>
</div>

@code {
    private static readonly string[] Tabs = ["design", "data", "preview"];
    private static readonly string[] DefaultChartPalette = ["#2563eb", "#14b8a6", "#f59e0b", "#ef4444"];
    private readonly Stack<ReportDefinition> _undoStack = new();
    private readonly Stack<ReportDefinition> _redoStack = new();
    private ReportDefinition _definition = CreateDefaultDefinition();
    private readonly HashSet<string> _selectedElementIds = new(StringComparer.Ordinal);
    private string _activeTab = "design";
    private string _expressionDraft = string.Empty;
    private string? _expressionError;
    private bool _pageSetupOpen;
    private int _zoomPercent = 100;
    private int _idCounter;
    private int _createdElementCount;
    private int _revision = 1;

    /// <summary>Report definition edited by the designer.</summary>
    [Parameter] public ReportDefinition? Definition { get; set; }

    /// <summary>Raised when the edited definition changes.</summary>
    [Parameter] public EventCallback<ReportDefinition> DefinitionChanged { get; set; }

    /// <summary>Raised when users save a draft or publish a revision.</summary>
    [Parameter] public EventCallback<ReportDesignerSaveEventArgs> Saved { get; set; }

    /// <summary>Additional CSS classes.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Additional attributes applied to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => string.IsNullOrWhiteSpace(Class) ? "tm-report-designer" : $"tm-report-designer {Class}";

    private ReportElement? SelectedElement => AllElements().FirstOrDefault(element => _selectedElementIds.Contains(element.Id));

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (Definition is not null && !ReferenceEquals(Definition, _definition) && _undoStack.Count == 0)
        {
            _definition = CloneDefinition(Definition);
            _idCounter = Math.Max(_idCounter, AllElements().Count());
            _createdElementCount = 0;
        }
    }

    @* N190: the canvas shell is a labelled <section> region — the host layout owns the
       page's single <main> landmark; components never emit it (036ce5fd/a59cac9a rule). *@
    private RenderFragment RenderCanvas()
        => @<section class="tm-report-designer__canvas-shell"
                     aria-label="@Loc["TmReportDesigner_CanvasLabel"]">
            <div class="tm-report-designer__ruler tm-report-designer__ruler--top"></div>
            <div class="tm-report-designer__canvas-scroll" data-testid="@TestId("tm-designer-canvas-scroll")">
                <div class="tm-report-designer__page"
                     style="@PageStyle"
                     data-testid="@TestId("tm-designer-canvas")">
                    @foreach (var band in DesignerBands())
                    {
                        <section class="tm-report-designer__band"
                                 style="@BandStyle(band.Band.Height)"
                                 data-testid="@($"tm-designer-band-{band.Kind}")">
                            <header>
                                <span>@band.Label</span>
                                <label>
                                    <span>@Loc["TmReportDesigner_BandHeight"]</span>
                                    <input type="number"
                                           data-testid="@($"tm-designer-band-height-{band.Kind}")"
                                           value="@band.Band.Height.ToString(CultureInfo.InvariantCulture)"
                                           @onchange="args => HandleBandHeightChanged(band.Kind, args)" />
                                </label>
                            </header>
                            <div class="tm-report-designer__band-grid">
                                @foreach (var element in band.Band.Elements.OrderBy(element => element.Y))
                                {
                                    @RenderElement(element)
                                }
                            </div>
                        </section>
                    }
                </div>
            </div>
        </section>;

    private RenderFragment RenderElement(ReportElement element)
        => @<button type="button"
                    class="@ElementCss(element)"
                    style="@ElementStyle(element)"
                    data-testid="@($"tm-designer-element-{element.Id}")"
                    @onclick="args => SelectElement(element, args)">
            <span>@ElementLabel(element)</span>
            @if (_selectedElementIds.Contains(element.Id))
            {
                <span class="tm-report-designer__handle tm-report-designer__handle--nw"></span>
                <span class="tm-report-designer__handle tm-report-designer__handle--se"></span>
            }
        </button>;

    private RenderFragment RenderProperties()
        => @<aside class="tm-report-designer__properties" data-testid="@TestId("tm-designer-properties")">
            <h3>@Loc["TmReportDesigner_Properties"]</h3>
            @if (SelectedElement is null)
            {
                <p>@Loc["TmReportDesigner_NoSelection"]</p>
            }
            else
            {
                <p class="tm-report-designer__selection-id">@SelectedElement.Id</p>
                <label>
                    <span>@Loc["TmReportDesigner_X"]</span>
                    <input type="number" value="@SelectedElement.X.ToString(CultureInfo.InvariantCulture)" @onchange="HandleSelectedXChanged" />
                </label>
                <label>
                    <span>@Loc["TmReportDesigner_Y"]</span>
                    <input type="number" value="@SelectedElement.Y.ToString(CultureInfo.InvariantCulture)" @onchange="HandleSelectedYChanged" />
                </label>
                <label>
                    <span>@Loc["TmReportDesigner_Width"]</span>
                    <input type="number" value="@SelectedElement.Width.ToString(CultureInfo.InvariantCulture)" @onchange="HandleSelectedWidthChanged" />
                </label>
                <label>
                    <span>@Loc["TmReportDesigner_Height"]</span>
                    <input type="number" value="@SelectedElement.Height.ToString(CultureInfo.InvariantCulture)" @onchange="HandleSelectedHeightChanged" />
                </label>
                @if (SelectedElement is ReportTextBoxElement text)
                {
                    <label>
                        <span>@Loc["TmReportDesigner_Text"]</span>
                        <input data-testid="@TestId("tm-designer-property-text")" value="@(text.Text ?? text.Expression ?? string.Empty)" @onchange="HandleTextPropertyChanged" />
                    </label>
                }
                @if (SelectedElement is ReportChartElement chart)
                {
                    @RenderChartProperties(chart)
                }
                <div class="tm-report-designer__validation-note" data-testid="@TestId("tm-designer-property-validation")">
                    @ValidateElement(SelectedElement)
                </div>
            }
        </aside>;

    private RenderFragment RenderChartProperties(ReportChartElement chart)
        => @<div class="tm-report-designer__chart-properties" data-testid="@TestId("tm-designer-chart-properties")">
            <label>
                <span>@Loc["TmReportDesigner_ChartTitle"]</span>
                <input data-testid="@TestId("tm-designer-chart-title")" value="@(chart.Title ?? string.Empty)" @onchange="HandleChartTitleChanged" />
            </label>
            <label>
                <span>@Loc["TmReportDesigner_ChartType"]</span>
                <select data-testid="@TestId("tm-designer-chart-type")" value="@chart.ChartType.ToString()" @onchange="HandleChartTypeChanged">
                    @foreach (var type in Enum.GetValues<ReportChartType>())
                    {
                        <option value="@type.ToString()">@ChartTypeLabel(type)</option>
                    }
                </select>
            </label>
            <label>
                <span>@Loc["TmReportDesigner_ChartDataset"]</span>
                <select data-testid="@TestId("tm-designer-chart-dataset")" value="@chart.DataSetName" @onchange="HandleChartDataSetChanged">
                    @foreach (var dataSet in _definition.DataSets)
                    {
                        <option value="@dataSet.Name">@dataSet.Name</option>
                    }
                </select>
            </label>
            <label>
                <span>@Loc["TmReportDesigner_ChartSeries"]</span>
                <input data-testid="@TestId("tm-designer-chart-series-name")" value="@PrimarySeries(chart).Name" @onchange="HandleChartSeriesNameChanged" />
            </label>
            <label>
                <span>@Loc["TmReportDesigner_ChartCategoryExpression"]</span>
                <input data-testid="@TestId("tm-designer-chart-category-expression")" value="@PrimarySeries(chart).CategoryExpression" @onchange="HandleChartCategoryExpressionChanged" />
            </label>
            <label>
                <span>@Loc["TmReportDesigner_ChartValueExpression"]</span>
                <input data-testid="@TestId("tm-designer-chart-value-expression")" value="@PrimarySeries(chart).ValueExpression" @onchange="HandleChartValueExpressionChanged" />
            </label>
            <label>
                <span>@Loc["TmReportDesigner_ChartColor"]</span>
                <input data-testid="@TestId("tm-designer-chart-color")" type="color" value="@(PrimarySeries(chart).Color ?? DefaultChartPalette[0])" @onchange="HandleChartColorChanged" />
            </label>
            <label class="tm-report-designer__checkbox">
                <input data-testid="@TestId("tm-designer-chart-legend")" type="checkbox" checked="@chart.ShowLegend" @onchange="HandleChartLegendChanged" />
                <span>@Loc["TmReportDesigner_ChartLegend"]</span>
            </label>
            @RenderChartPreview(chart)
        </div>;

    private RenderFragment RenderChartPreview(ReportChartElement chart)
        => @<div class="tm-report-designer__chart-preview" data-testid="@TestId("tm-designer-chart-preview")">
            <svg viewBox="0 0 160 96" role="img" aria-label="@Loc["TmReportDesigner_ChartPreview"]">
                @if (chart.ChartType is ReportChartType.Pie or ReportChartType.Donut)
                {
                    <path d="M52 22 A28 28 0 0 1 78 61 L52 50 Z" fill="@PreviewColor(chart, 0)"></path>
                    <path d="M78 61 A28 28 0 1 1 52 22 L52 50 Z" fill="@PreviewColor(chart, 1)"></path>
                    @if (chart.ChartType == ReportChartType.Donut)
                    {
                        <circle cx="52" cy="50" r="14"></circle>
                    }
                }
                else if (chart.ChartType is ReportChartType.Line or ReportChartType.Area)
                {
                    @if (chart.ChartType == ReportChartType.Area)
                    {
                        <path d="M18 70 L48 46 L78 55 L108 28 L108 76 L18 76 Z" fill="@PreviewColor(chart, 0)" opacity="0.22"></path>
                    }
                    <path d="M18 70 L48 46 L78 55 L108 28" fill="none" stroke="@PreviewColor(chart, 0)" stroke-width="3"></path>
                    <circle cx="18" cy="70" r="3"></circle>
                    <circle cx="48" cy="46" r="3"></circle>
                    <circle cx="78" cy="55" r="3"></circle>
                    <circle cx="108" cy="28" r="3"></circle>
                }
                else
                {
                    <rect x="18" y="50" width="16" height="28" fill="@PreviewColor(chart, 0)"></rect>
                    <rect x="45" y="34" width="16" height="44" fill="@PreviewColor(chart, 0)"></rect>
                    <rect x="72" y="23" width="16" height="55" fill="@PreviewColor(chart, 0)"></rect>
                    <rect x="99" y="43" width="16" height="35" fill="@PreviewColor(chart, 0)"></rect>
                }
                @if (chart.ShowLegend)
                {
                    <rect x="124" y="26" width="8" height="8" fill="@PreviewColor(chart, 0)"></rect>
                }
            </svg>
            <span>@(chart.Title ?? Loc["TmReportDesigner_DefaultChartTitle"])</span>
        </div>;

    private RenderFragment RenderDataPanel()
        => @<section class="tm-report-designer__data" data-testid="@TestId("tm-designer-data-panel")">
            <div class="tm-report-designer__data-column">
                <h3>@Loc["TmReportDesigner_FieldList"]</h3>
                @foreach (var dataSet in _definition.DataSets)
                {
                    <article class="tm-report-designer__dataset">
                        <header>
                            <strong>@dataSet.Name</strong>
                            <span>@(dataSet.Source?.Name ?? Loc["TmReportDesigner_NoDataSource"])</span>
                        </header>
                        @foreach (var field in dataSet.Fields)
                        {
                            <button type="button"
                                    data-testid="@($"tm-designer-insert-field-{dataSet.Name}-{field.Name}")"
                                    @onclick="() => InsertField(dataSet.Name, field.Name)">
                                <TmIcon Name="@IconNames.Hash" Size="IconSize.Xs" />
                                <span>@field.Name</span>
                            </button>
                        }
                    </article>
                }
            </div>
            <div class="tm-report-designer__data-column">
                <h3>@Loc["TmReportDesigner_Datasets"]</h3>
                @foreach (var dataSet in _definition.DataSets)
                {
                    <label>
                        <span>@Loc["TmReportDesigner_Query"] - @dataSet.Name</span>
                        <textarea data-testid="@($"tm-designer-query-{dataSet.Name}")" @onchange="args => HandleQueryChanged(dataSet.Name, args)">@dataSet.Query</textarea>
                    </label>
                    <div class="tm-report-designer__preview-table" data-testid="@($"tm-designer-query-preview-{dataSet.Name}")">
                        <span>@Loc["TmReportDesigner_PreviewTop"]</span>
                        @foreach (var field in dataSet.Fields.Take(3))
                        {
                            <code>@field.Name</code>
                        }
                    </div>
                }
                <h3>@Loc["TmReportDesigner_Parameters"]</h3>
                @foreach (var parameter in _definition.Parameters)
                {
                    <label>
                        <span>@parameter.Name</span>
                        <input data-testid="@($"tm-designer-param-{parameter.Name}")" value="@parameter.DefaultExpression" @onchange="args => HandleParameterDefaultChanged(parameter.Name, args)" />
                    </label>
                }
            </div>
            <div class="tm-report-designer__data-column">
                <h3>@Loc["TmReportDesigner_ExpressionEditor"]</h3>
                <label>
                    <span>@Loc["TmReportDesigner_Expression"]</span>
                    <input data-testid="@TestId("tm-designer-expression-input")" value="@_expressionDraft" @onchange="HandleExpressionDraftChanged" />
                </label>
                <div class="tm-report-designer__completion-list" data-testid="@TestId("tm-designer-completions")">
                    @foreach (var completion in ExpressionCompletions())
                    {
                        <button type="button" @onclick="() => ApplyCompletion(completion)">@completion</button>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(_expressionError))
                {
                    <div class="tm-report-designer__expression-error" data-testid="@TestId("tm-designer-expression-error")">@_expressionError</div>
                }
            </div>
        </section>;

    private RenderFragment RenderPreviewPanel()
        => @<section class="tm-report-designer__preview-panel" data-testid="@TestId("tm-designer-preview-panel")">
            <div class="tm-report-designer__preview" data-testid="@TestId("tm-designer-preview")">
                <div class="tm-report-designer__preview-page">
                    <h3>@_definition.Name</h3>
                    @foreach (var band in DesignerBands())
                    {
                        <section>
                            <strong>@band.Label</strong>
                            @foreach (var element in band.Band.Elements)
                            {
                                <span>@ElementLabel(element)</span>
                            }
                        </section>
                    }
                </div>
            </div>
            <aside class="tm-report-designer__validation-panel" data-testid="@TestId("tm-designer-validation-panel")">
                <h3>@Loc["TmReportDesigner_Validation"]</h3>
                @foreach (var message in ValidateDefinition())
                {
                    <div>@message</div>
                }
            </aside>
            <aside class="tm-report-designer__save-panel">
                <h3>@Loc["TmReportDesigner_Revisions"]</h3>
                <p>@Loc["TmReportDesigner_CurrentRevision", _revision]</p>
                <TmButton Variant="ButtonVariant.Secondary" Icon="@IconNames.Save" data-testid="@TestId("tm-designer-save-draft")" OnClick="SaveDraft">
                    @Loc["TmReportDesigner_SaveDraft"]
                </TmButton>
                <TmButton Variant="ButtonVariant.Primary" Icon="@IconNames.Upload" data-testid="@TestId("tm-designer-publish")" OnClick="Publish">
                    @Loc["TmReportDesigner_Publish"]
                </TmButton>
            </aside>
        </section>;

    private string PageStyle
    {
        get
        {
            var scale = _zoomPercent / 100.0;
            var page = _definition.PageSetup.PageSize;
            return FormattableString.Invariant($"--tm-report-designer-zoom:{scale};--tm-report-designer-page-width:{page.Width}px");
        }
    }

    private string BandStyle(double height)
        => FormattableString.Invariant($"--tm-report-designer-band-height:{height}px");

    private static string ElementStyle(ReportElement element)
        => FormattableString.Invariant($"left:{element.X}px;top:{element.Y}px;width:{element.Width}px;height:{element.Height}px");

    private string ElementCss(ReportElement element)
        => _selectedElementIds.Contains(element.Id)
            ? "tm-report-designer__element tm-report-designer__element--selected"
            : "tm-report-designer__element";

    private string TabCss(string tab)
        => string.Equals(tab, _activeTab, StringComparison.Ordinal)
            ? "tm-report-designer__tab tm-report-designer__tab--active"
            : "tm-report-designer__tab";

    private static string TabTestId(string tab) => $"tm-designer-tab-{tab}";

    private string TabLabel(string tab)
        => tab switch
        {
            "data" => Loc["TmReportDesigner_Data"],
            "preview" => Loc["TmReportDesigner_Preview"],
            _ => Loc["TmReportDesigner_Design"],
        };

    private IEnumerable<(ReportBandKind Kind, string Label, ReportBand Band)> DesignerBands()
    {
        yield return (ReportBandKind.PageHeader, "PageHeader", _definition.Bands.PageHeader ?? new ReportBand { Kind = ReportBandKind.PageHeader, Height = 72 });
        if (_definition.Bands.ReportHeader is not null)
        {
            yield return (ReportBandKind.ReportHeader, "ReportHeader", _definition.Bands.ReportHeader);
        }

        yield return (ReportBandKind.Detail, "Detail", _definition.Bands.Detail ?? new ReportBand { Kind = ReportBandKind.Detail, Height = 120 });
        if (_definition.Bands.ReportFooter is not null)
        {
            yield return (ReportBandKind.ReportFooter, "ReportFooter", _definition.Bands.ReportFooter);
        }

        yield return (ReportBandKind.PageFooter, "PageFooter", _definition.Bands.PageFooter ?? new ReportBand { Kind = ReportBandKind.PageFooter, Height = 48 });
    }

    private IEnumerable<ReportElement> AllElements()
        => DesignerBands().SelectMany(band => band.Band.Elements);

    private void SetTab(string tab) => _activeTab = tab;

    private void TogglePageSetup() => _pageSetupOpen = !_pageSetupOpen;

    private async Task CommitAsync(ReportDefinition definition)
    {
        _definition = definition;
        await DefinitionChanged.InvokeAsync(_definition);
    }

    private void PushUndo()
    {
        _undoStack.Push(CloneDefinition(_definition));
        _redoStack.Clear();
    }

    private async Task Undo()
    {
        if (!_undoStack.Any())
        {
            return;
        }

        _redoStack.Push(CloneDefinition(_definition));
        _definition = _undoStack.Pop();
        _selectedElementIds.RemoveWhere(id => AllElements().All(element => !string.Equals(element.Id, id, StringComparison.Ordinal)));
        await DefinitionChanged.InvokeAsync(_definition);
    }

    private async Task Redo()
    {
        if (!_redoStack.Any())
        {
            return;
        }

        _undoStack.Push(CloneDefinition(_definition));
        _definition = _redoStack.Pop();
        await DefinitionChanged.InvokeAsync(_definition);
    }

    private async Task AddElement(string kind)
    {
        PushUndo();
        var id = kind.ToLowerInvariant() switch
        {
            "textbox" => $"textbox-{++_idCounter}",
            "image" => $"image-{++_idCounter}",
            "shape" => $"shape-{++_idCounter}",
            "table" => $"table-{++_idCounter}",
            _ => $"chart-{++_idCounter}",
        };
        var elementSlot = _createdElementCount++;
        var baseElement = CreateElement(kind, id);
        var element = WithBounds(
            baseElement,
            40 + (elementSlot % 3) * 170,
            42 + (elementSlot / 3) * 70,
            baseElement.Width,
            baseElement.Height);
        var detail = (_definition.Bands.Detail ?? new ReportBand { Kind = ReportBandKind.Detail, Height = 120 }) with
        {
            Elements = [.. (_definition.Bands.Detail?.Elements ?? []), element],
        };
        await CommitAsync(_definition with { Bands = _definition.Bands with { Detail = detail } });
        _selectedElementIds.Clear();
        _selectedElementIds.Add(id);
    }

    private Task AddTextBox() => AddElement("TextBox");

    private Task AddImage() => AddElement("Image");

    private Task AddShape() => AddElement("Shape");

    private Task AddTable() => AddElement("Table");

    private Task AddChart() => AddElement("Chart");

    private ReportElement CreateElement(string kind, string id)
        => kind switch
        {
            "Image" => new ReportImageElement { Id = id, X = 48, Y = 24, Width = 130, Height = 50, Source = "https://example.test/logo.png" },
            "Shape" => new ReportShapeElement { Id = id, X = 48, Y = 24, Width = 130, Height = 50, FillColor = "#dbeafe" },
