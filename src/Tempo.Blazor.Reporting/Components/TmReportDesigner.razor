    private void SelectElement(ReportElement element, MouseEventArgs args)
    {
        if (!args.CtrlKey && !args.MetaKey)
        {
            _selectedElementIds.Clear();
        }

        if (!_selectedElementIds.Add(element.Id))
        {
            _selectedElementIds.Remove(element.Id);
        }
    }

    private async Task CopySelected()
    {
        if (_selectedElementIds.Count == 0)
        {
            return;
        }

        PushUndo();
        var copies = AllElements()
            .Where(element => _selectedElementIds.Contains(element.Id))
            .Select(CloneOffsetElement)
            .ToArray();
        var detail = (_definition.Bands.Detail ?? new ReportBand { Kind = ReportBandKind.Detail, Height = 120 }) with
        {
            Elements = [.. (_definition.Bands.Detail?.Elements ?? []), .. copies],
        };
        await CommitAsync(_definition with { Bands = _definition.Bands with { Detail = detail } });
        _selectedElementIds.Clear();
        foreach (var copy in copies)
        {
            _selectedElementIds.Add(copy.Id);
        }
    }

    private ReportElement CloneOffsetElement(ReportElement element)
    {
        var id = $"{element.Id}-copy-{++_idCounter}";
        return WithBounds(element, element.X + 18, element.Y + 18, element.Width, element.Height, id);
    }

    private async Task HandleBandHeightChanged(ReportBandKind kind, ChangeEventArgs args)
    {
        if (!double.TryParse(args.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var height))
        {
            return;
        }

        PushUndo();
        var bands = _definition.Bands;
        var next = kind switch
        {
            ReportBandKind.PageHeader => bands with { PageHeader = (bands.PageHeader ?? new ReportBand { Kind = kind }) with { Height = Math.Max(24, height) } },
            ReportBandKind.ReportHeader => bands with { ReportHeader = (bands.ReportHeader ?? new ReportBand { Kind = kind }) with { Height = Math.Max(24, height) } },
            ReportBandKind.ReportFooter => bands with { ReportFooter = (bands.ReportFooter ?? new ReportBand { Kind = kind }) with { Height = Math.Max(24, height) } },
            ReportBandKind.PageFooter => bands with { PageFooter = (bands.PageFooter ?? new ReportBand { Kind = kind }) with { Height = Math.Max(24, height) } },
            _ => bands with { Detail = (bands.Detail ?? new ReportBand { Kind = kind }) with { Height = Math.Max(24, height) } },
        };
        await CommitAsync(_definition with { Bands = next });
    }

    private Task HandleSelectedXChanged(ChangeEventArgs args) => UpdateSelectedBounds(args, "x");

    private Task HandleSelectedYChanged(ChangeEventArgs args) => UpdateSelectedBounds(args, "y");

    private Task HandleSelectedWidthChanged(ChangeEventArgs args) => UpdateSelectedBounds(args, "width");

    private Task HandleSelectedHeightChanged(ChangeEventArgs args) => UpdateSelectedBounds(args, "height");

    private async Task UpdateSelectedBounds(ChangeEventArgs args, string property)
    {
        var selected = SelectedElement;
        if (selected is null || !double.TryParse(args.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var value))
        {
            return;
        }

        PushUndo();
        var next = property switch
        {
            "x" => WithBounds(selected, Snap(value), selected.Y, selected.Width, selected.Height),
            "y" => WithBounds(selected, selected.X, Snap(value), selected.Width, selected.Height),
            "width" => WithBounds(selected, selected.X, selected.Y, Math.Max(12, Snap(value)), selected.Height),
            _ => WithBounds(selected, selected.X, selected.Y, selected.Width, Math.Max(12, Snap(value))),
        };
        await ReplaceElement(next);
    }

    private async Task HandleTextPropertyChanged(ChangeEventArgs args)
    {
        if (SelectedElement is not ReportTextBoxElement text)
        {
            return;
        }

        PushUndo();
        await ReplaceElement(text with { Text = args.Value?.ToString() ?? string.Empty, Expression = null });
    }

    private Task HandleChartTitleChanged(ChangeEventArgs args)
        => UpdateSelectedChart(chart => chart with { Title = args.Value?.ToString() });

    private Task HandleChartTypeChanged(ChangeEventArgs args)
        => Enum.TryParse<ReportChartType>(args.Value?.ToString(), out var type)
            ? UpdateSelectedChart(chart => chart with { ChartType = type })
            : Task.CompletedTask;

    private Task HandleChartDataSetChanged(ChangeEventArgs args)
    {
        var dataSetName = args.Value?.ToString();
        return UpdateSelectedChart(chart => chart with
        {
            DataSetName = dataSetName,
            Series = [PrimarySeries(chart) with
            {
                CategoryExpression = DefaultCategoryExpression(dataSetName),
                ValueExpression = DefaultValueExpression(dataSetName),
            }, .. chart.Series.Skip(1)],
        });
    }

    private Task HandleChartSeriesNameChanged(ChangeEventArgs args)
        => UpdatePrimaryChartSeries(series => series with { Name = args.Value?.ToString() ?? string.Empty });

    private Task HandleChartCategoryExpressionChanged(ChangeEventArgs args)
        => UpdatePrimaryChartSeries(series => series with { CategoryExpression = args.Value?.ToString() ?? string.Empty });

    private Task HandleChartValueExpressionChanged(ChangeEventArgs args)
        => UpdatePrimaryChartSeries(series => series with { ValueExpression = args.Value?.ToString() ?? string.Empty });

    private Task HandleChartColorChanged(ChangeEventArgs args)
        => UpdatePrimaryChartSeries(series => series with { Color = args.Value?.ToString() });

    private Task HandleChartLegendChanged(ChangeEventArgs args)
        => UpdateSelectedChart(chart => chart with { ShowLegend = args.Value is bool value ? value : string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase) });

    private Task UpdatePrimaryChartSeries(Func<ReportChartSeries, ReportChartSeries> update)
        => UpdateSelectedChart(chart => chart with { Series = [update(PrimarySeries(chart)), .. chart.Series.Skip(1)] });

    private async Task UpdateSelectedChart(Func<ReportChartElement, ReportChartElement> update)
    {
        if (SelectedElement is not ReportChartElement chart)
        {
            return;
        }

        PushUndo();
        await ReplaceElement(update(chart));
    }

    private async Task InsertField(string dataSetName, string fieldName)
    {
        if (SelectedElement is null)
        {
            await AddElement("TextBox");
        }

        if (SelectedElement is ReportTextBoxElement text)
        {
            PushUndo();
            var expression = $"=Fields.{fieldName}";
            _expressionDraft = expression;
            await ReplaceElement(text with { Text = null, Expression = expression });
        }
    }

    private async Task HandleQueryChanged(string dataSetName, ChangeEventArgs args)
    {
        PushUndo();
        var dataSets = _definition.DataSets
            .Select(dataSet => string.Equals(dataSet.Name, dataSetName, StringComparison.Ordinal)
                ? dataSet with { Query = args.Value?.ToString() }
                : dataSet)
            .ToList();
        await CommitAsync(_definition with { DataSets = dataSets });
    }

    private async Task HandleParameterDefaultChanged(string name, ChangeEventArgs args)
    {
        PushUndo();
        var parameters = _definition.Parameters
            .Select(parameter => string.Equals(parameter.Name, name, StringComparison.Ordinal)
                ? parameter with { DefaultExpression = args.Value?.ToString() }
                : parameter)
            .ToList();
        await CommitAsync(_definition with { Parameters = parameters });
    }

    private async Task HandleExpressionDraftChanged(ChangeEventArgs args)
    {
        _expressionDraft = args.Value?.ToString() ?? string.Empty;
        _expressionError = ValidateExpression(_expressionDraft);
        if (_expressionError is null && SelectedElement is ReportTextBoxElement text)
        {
            PushUndo();
            await ReplaceElement(text with { Text = null, Expression = _expressionDraft });
        }
    }

    private void ApplyCompletion(string completion)
    {
        _expressionDraft = completion;
        _expressionError = ValidateExpression(_expressionDraft);
    }

    private IEnumerable<string> ExpressionCompletions()
    {
        foreach (var field in _definition.DataSets.SelectMany(dataSet => dataSet.Fields))
        {
            yield return $"=Fields.{field.Name}";
        }

        foreach (var parameter in _definition.Parameters)
        {
            yield return $"=Parameters.{parameter.Name}";
        }

        yield return "=Sum(Fields.Total)";
    }

    private string? ValidateExpression(string expression)
    {
        if (string.Equals(expression, "=Fields.", StringComparison.Ordinal) ||
            string.Equals(expression, "=Parameters.", StringComparison.Ordinal))
        {
            return Loc["TmReportDesigner_ExpressionSelectField"];
        }

        return expression.StartsWith("=", StringComparison.Ordinal) ? null : Loc["TmReportDesigner_ExpressionMustStart"];
    }

    private async Task ReplaceElement(ReportElement replacement)
    {
        ReportBand ReplaceBand(ReportBand band)
            => band with
            {
                Elements = band.Elements
                    .Select(element => string.Equals(element.Id, replacement.Id, StringComparison.Ordinal) ? replacement : element)
                    .ToList(),
            };

        var bands = _definition.Bands with
        {
            PageHeader = _definition.Bands.PageHeader is null ? null : ReplaceBand(_definition.Bands.PageHeader),
            ReportHeader = _definition.Bands.ReportHeader is null ? null : ReplaceBand(_definition.Bands.ReportHeader),
            Detail = _definition.Bands.Detail is null ? null : ReplaceBand(_definition.Bands.Detail),
            ReportFooter = _definition.Bands.ReportFooter is null ? null : ReplaceBand(_definition.Bands.ReportFooter),
            PageFooter = _definition.Bands.PageFooter is null ? null : ReplaceBand(_definition.Bands.PageFooter),
        };
        await CommitAsync(_definition with { Bands = bands });
    }

    private async Task HandleZoomChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var zoom))
        {
            _zoomPercent = zoom;
        }

        await Task.CompletedTask;
    }

    private async Task HandlePageWidthChanged(ChangeEventArgs args)
        => await UpdatePageSize(args, width: true);

    private async Task HandlePageHeightChanged(ChangeEventArgs args)
        => await UpdatePageSize(args, width: false);

    private async Task UpdatePageSize(ChangeEventArgs args, bool width)
    {
        if (!double.TryParse(args.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var value))
        {
            return;
        }

        PushUndo();
        var size = _definition.PageSetup.PageSize;
        var pageSize = width ? size with { Width = value } : size with { Height = value };
        await CommitAsync(_definition with { PageSetup = _definition.PageSetup with { PageSize = pageSize } });
    }

    private async Task HandleMarginChanged(ChangeEventArgs args)
    {
        if (!double.TryParse(args.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var value))
        {
            return;
        }

        PushUndo();
        await CommitAsync(_definition with { PageSetup = _definition.PageSetup with { Margins = new ReportThickness(value) } });
    }

    private async Task HandleOrientationChanged(ChangeEventArgs args)
    {
        PushUndo();
        var orientation = string.Equals(args.Value?.ToString(), "Landscape", StringComparison.Ordinal)
            ? ReportPageOrientation.Landscape
            : ReportPageOrientation.Portrait;
        await CommitAsync(_definition with { PageSetup = _definition.PageSetup with { Orientation = orientation } });
    }

    private async Task SaveDraft()
    {
        _revision++;
        await Saved.InvokeAsync(new ReportDesignerSaveEventArgs(CloneDefinition(_definition), ReportDesignerSaveKind.Draft, _revision));
    }

    private async Task Publish()
    {
        _revision++;
        await Saved.InvokeAsync(new ReportDesignerSaveEventArgs(CloneDefinition(_definition), ReportDesignerSaveKind.Publish, _revision));
    }

    private IEnumerable<string> ValidateDefinition()
    {
        if (string.IsNullOrWhiteSpace(_definition.Name))
        {
            yield return Loc["TmReportDesigner_ValidationName"];
        }

        if (_definition.DataSets.Count == 0)
        {
            yield return Loc["TmReportDesigner_ValidationDataset"];
        }

        if (!AllElements().Any())
        {
            yield return Loc["TmReportDesigner_ValidationElements"];
        }

        foreach (var element in AllElements())
        {
            if (element.Width <= 0 || element.Height <= 0)
            {
                yield return Loc["TmReportDesigner_ValidationElementSize", element.Id];
            }
        }
    }

    private string ValidateElement(ReportElement element)
    {
        if (element.Width <= 0 || element.Height <= 0)
        {
            return Loc["TmReportDesigner_InvalidSize"];
        }

        if (element is ReportChartElement chart &&
            (chart.Series.Count == 0 ||
             string.IsNullOrWhiteSpace(PrimarySeries(chart).CategoryExpression) ||
             string.IsNullOrWhiteSpace(PrimarySeries(chart).ValueExpression)))
        {
            return Loc["TmReportDesigner_ChartInvalidSeries"];
        }

        return Loc["TmReportDesigner_ValidElement"];
    }

    private static double Snap(double value)
        => Math.Round(value / 8, MidpointRounding.AwayFromZero) * 8;

    private string ElementLabel(ReportElement element)
        => element switch
        {
            ReportTextBoxElement text => text.Expression ?? text.Text ?? element.Id,
            ReportImageElement => Loc["TmReportDesigner_Image"],
            ReportShapeElement => Loc["TmReportDesigner_Shape"],
            ReportTableElement => Loc["TmReportDesigner_Table"],
            ReportChartElement chart => string.IsNullOrWhiteSpace(chart.Title) ? Loc["TmReportDesigner_Chart"] : chart.Title,
            _ => element.Id,
        };

    private string ChartTypeLabel(ReportChartType type)
        => type switch
        {
            ReportChartType.Bar => Loc["TmReportDesigner_ChartTypeBar"],
            ReportChartType.Line => Loc["TmReportDesigner_ChartTypeLine"],
            ReportChartType.Area => Loc["TmReportDesigner_ChartTypeArea"],
            ReportChartType.Pie => Loc["TmReportDesigner_ChartTypePie"],
            ReportChartType.Donut => Loc["TmReportDesigner_ChartTypeDonut"],
            ReportChartType.StackedColumn => Loc["TmReportDesigner_ChartTypeStackedColumn"],
            ReportChartType.StackedBar => Loc["TmReportDesigner_ChartTypeStackedBar"],
            ReportChartType.StackedArea => Loc["TmReportDesigner_ChartTypeStackedArea"],
            _ => Loc["TmReportDesigner_ChartTypeColumn"],
        };

    private string PreviewColor(ReportChartElement chart, int index)
        => index == 0
            ? PrimarySeries(chart).Color ?? DefaultChartPalette[0]
            : chart.ColorPalette.Count > index
                ? chart.ColorPalette[index]
                : DefaultChartPalette[index % DefaultChartPalette.Length];

    private ReportChartSeries PrimarySeries(ReportChartElement chart)
        => chart.Series.FirstOrDefault() ?? new ReportChartSeries
        {
            Name = Loc["TmReportDesigner_DefaultChartSeries"],
            CategoryExpression = DefaultCategoryExpression(chart.DataSetName),
            ValueExpression = DefaultValueExpression(chart.DataSetName),
            Color = DefaultChartPalette[0],
        };

    private string DefaultDataSetName()
        => _definition.DataSets.FirstOrDefault()?.Name ?? "Orders";

    private string DefaultCategoryExpression(string? dataSetName)
    {
        var field = ResolveDataSet(dataSetName)?.Fields.FirstOrDefault(field => field.DataType != Tempo.Reporting.Abstractions.Definitions.ReportDataFieldType.Number)?.Name ??
            ResolveDataSet(dataSetName)?.Fields.FirstOrDefault()?.Name ??
            "Customer";
        return $"=Fields.{field}";
    }

    private string DefaultValueExpression(string? dataSetName)
    {
        var field = ResolveDataSet(dataSetName)?.Fields.FirstOrDefault(field => field.DataType == Tempo.Reporting.Abstractions.Definitions.ReportDataFieldType.Number)?.Name ??
            ResolveDataSet(dataSetName)?.Fields.LastOrDefault()?.Name ??
            "Total";
        return $"=Fields.{field}";
    }

    private ReportDataSetDefinition? ResolveDataSet(string? name)
        => string.IsNullOrWhiteSpace(name)
            ? _definition.DataSets.FirstOrDefault()
            : _definition.DataSets.FirstOrDefault(dataSet => string.Equals(dataSet.Name, name, StringComparison.Ordinal)) ??
                _definition.DataSets.FirstOrDefault();

    private static ReportElement WithBounds(ReportElement element, double x, double y, double width, double height, string? id = null)
        => element switch
        {
            ReportTextBoxElement text => text with { Id = id ?? text.Id, X = x, Y = y, Width = width, Height = height },
            ReportImageElement image => image with { Id = id ?? image.Id, X = x, Y = y, Width = width, Height = height },
            ReportShapeElement shape => shape with { Id = id ?? shape.Id, X = x, Y = y, Width = width, Height = height },
            ReportTableElement table => table with { Id = id ?? table.Id, X = x, Y = y, Width = width, Height = height },
            ReportChartElement chart => chart with { Id = id ?? chart.Id, X = x, Y = y, Width = width, Height = height },
            _ => element,
        };

    private static ReportDefinition CloneDefinition(ReportDefinition definition)
        => new()
        {
            SchemaVersion = definition.SchemaVersion,
            Id = definition.Id,
            Name = definition.Name,
            Description = definition.Description,
            PageSetup = definition.PageSetup with
            {
                PageSize = definition.PageSetup.PageSize with { },
                Margins = definition.PageSetup.Margins with { },
            },
            Parameters = definition.Parameters.Select(parameter => parameter with { }).ToList(),
            DataSets = definition.DataSets.Select(dataSet => dataSet with
            {
                Source = dataSet.Source is null ? null : dataSet.Source with { },
                Fields = dataSet.Fields.Select(field => field with { }).ToList(),
                Parameters = dataSet.Parameters.Select(parameter => parameter with { }).ToList(),
            }).ToList(),
            Styles = definition.Styles.Select(style => style with { }).ToList(),
            Bands = new ReportBandCollection
            {
                PageHeader = CloneBand(definition.Bands.PageHeader),
                Detail = CloneBand(definition.Bands.Detail),
                PageFooter = CloneBand(definition.Bands.PageFooter),
                ReportHeader = CloneBand(definition.Bands.ReportHeader),
                ReportFooter = CloneBand(definition.Bands.ReportFooter),
                Groups = definition.Bands.Groups.Select(group => group with
                {
                    GroupHeader = CloneBand(group.GroupHeader),
                    GroupFooter = CloneBand(group.GroupFooter),
                }).ToList(),
            },
        };

    private static ReportBand? CloneBand(ReportBand? band)
        => band is null
            ? null
            : band with { Elements = band.Elements.Select(CloneElement).ToList() };

    private static ReportElement CloneElement(ReportElement element)
        => element switch
        {
            ReportTextBoxElement text => text with { },
            ReportImageElement image => image with { },
            ReportShapeElement shape => shape with { },
            ReportTableElement table => table with
            {
                Columns = table.Columns.Select(column => column with { }).ToList(),
                Groups = table.Groups.Select(group => group with { }).ToList(),
            },
            ReportChartElement chart => chart with
            {
                ColorPalette = chart.ColorPalette.ToList(),
                Series = chart.Series.Select(series => series with { }).ToList(),
            },
            _ => element,
        };

