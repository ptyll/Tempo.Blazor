@using System.Globalization
@implements IDisposable
@using Tempo.Blazor.AI.Models
@using Tempo.Blazor.Components.AI

@* The LIVE presence section: the cursors are fed by this component's OWN simulator, so a marker moves without
   repainting the page (or any other visualization). The section renders the document itself and its paragraphs carry
   the anchors the overlay measures; the roster is the text alternative the same snapshot offers.

   The run starts PAUSED, like the page's main simulator: a screenshot is reproducible and nothing ticks before the
   reader asks for it. Play starts a marker stream on the demo clock; the paint is gated by AgentRenderThrottle, so ten
   events per second cost one paint per window.

   The overlay does NOT announce: its markers change on every tick, and a live region reading a simulated cursor around
   would drown the page's one announcement channel. The roster carries the same presence as text. *@
<div class="mb-3 flex flex-wrap items-center gap-3">
    <TmButton Variant="ButtonVariant.Secondary"
              Class="min-h-11"
              Size="ButtonSize.Sm"
              data-testid="ai-viz-presence-view"
              OnClick="ToggleTextView">@TextViewLabel</TmButton>
    <TmButton Variant="ButtonVariant.Secondary"
              Class="min-h-11"
              Size="ButtonSize.Sm"
              data-testid="ai-viz-presence-play"
              OnClick="ToggleRun">@(IsRunning ? Loc["TmAiAgentVizDemo_PresencePause"] : Loc["TmAiAgentVizDemo_PresencePlay"])</TmButton>
</div>

@if (ShowTable)
{
    <div data-testid="ai-viz-presence-table">
        <p class="text-xs text-slate-500 dark:text-slate-400 mb-2">@Loc["TmAiAgentVizDemo_TableHelp"]</p>
        <table class="w-full text-left text-sm">
            <caption class="mb-2 text-left text-sm text-slate-600 dark:text-slate-400">@Loc["TmAiAgentVizDemo_PresenceTableCaption"]</caption>
            <thead>
                <tr>
                    <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColAgent"]</th>
                    <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColRole"]</th>
                    <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColActivity"]</th>
                    <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColAnchor"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var marker in Markers)
                {
                    <tr data-testid="ai-viz-presence-row" data-agent-id="@marker.Agent.Id">
                        <th scope="row" class="py-1 font-normal">@marker.Agent.Name</th>
                        <td class="py-1">@marker.Agent.Role</td>
                        <td class="py-1">@ActivityText(marker.Activity)</td>
                        <td class="py-1">@(marker.AnchorId ?? string.Empty)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <TmAgentPresenceOverlay Markers="Markers"
                            ShowRoster="true"
                            AnnounceChanges="false"
                            RosterLabel="@Loc["TmAgentPresenceOverlay_RosterTitle"]"
                            DataTestId="ai-viz-presence">
        <div class="rounded-lg border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
            <h3 class="mb-3 text-base font-semibold text-slate-900 dark:text-white">
                @Loc["TmAiAgentVizDemo_PresenceDocumentTitle"]
            </h3>
            <p class="mb-3 text-sm text-slate-700 dark:text-slate-300">
                @Loc["TmAiAgentVizDemo_PresenceDocumentLead"]<span data-presence-anchor="plan-lead"></span>
            </p>
            <p class="mb-3 text-sm text-slate-700 dark:text-slate-300">
                @Loc["TmAiAgentVizDemo_PresenceDocumentGoal"]<span data-presence-anchor="plan-goal"></span>
            </p>
            @* The risk paragraph's LAST line is justified, so its anchor sits at the content's inline end — the edge case
               the measured placement exists for (a label with no room beside its point must go UNDER the line instead of
               covering the words). Every other paragraph leaves room and keeps the label beside it, so one screenshot
               shows both placements. *@
            <p class="mb-3 text-sm text-slate-700 dark:text-slate-300" style="text-align-last: justify">
                @Loc["TmAiAgentVizDemo_PresenceDocumentRisk"]<span data-presence-anchor="plan-risk"></span>
            </p>
            <p class="text-sm text-slate-700 dark:text-slate-300">
                @Loc["TmAiAgentVizDemo_PresenceDocumentClose"]<span data-presence-anchor="plan-close"></span>
            </p>
        </div>
    </TmAgentPresenceOverlay>
}
