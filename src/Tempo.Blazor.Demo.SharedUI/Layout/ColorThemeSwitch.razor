@inject IJSRuntime JS
@inject ColorThemeState State
@implements IDisposable

<div role="group" aria-label="@Label" data-testid="color-theme-switch" class="inline-flex rounded-lg overflow-hidden border border-slate-200 dark:border-slate-700">
    <button @onclick="() => ApplyAsync(ColorThemeState.Default)"
            aria-pressed="@(_theme == ColorThemeState.Default)"
            class="px-2 py-1 text-xs font-medium transition-colors @(_theme == ColorThemeState.Default ? "bg-primary-600 text-white" : "text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800")">
        @BlueLabel
    </button>
    <button @onclick="() => ApplyAsync(ColorThemeState.Indigo)"
            aria-pressed="@(_theme == ColorThemeState.Indigo)"
            class="px-2 py-1 text-xs font-medium transition-colors @(_theme == ColorThemeState.Indigo ? "bg-primary-600 text-white" : "text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800")">
        @IndigoLabel
    </button>
</div>

@code {
    private string _theme = ColorThemeState.Default;

    private string Label => "Color theme";
    private string BlueLabel => "Blue";
    private string IndigoLabel => "Indigo";

    protected override void OnInitialized()
    {
        _theme = State.Current;
        State.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var stored = await JS.InvokeAsync<string?>("tmColorTheme.stored");
        if (stored is ColorThemeState.Indigo)
        {
            State.Set(ColorThemeState.Indigo);
        }
    }

    private void OnChanged()
    {
        _theme = State.Current;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ApplyAsync(string theme)
    {
        State.Set(theme);
        await JS.InvokeVoidAsync("tmColorTheme.apply", theme);
    }

    public void Dispose()
    {
        State.Changed -= OnChanged;
    }
}
