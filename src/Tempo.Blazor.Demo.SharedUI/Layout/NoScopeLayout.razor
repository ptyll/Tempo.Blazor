@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject Tempo.Blazor.Services.ThemeService ThemeService

@* The deliberate counterpart of MainLayout: no app-level `TmLayoutObserver IsViewportScope`.
    An overlay rendered under this layout must measure the viewport itself through the internal
    probe, which is the branch the no-scope E2E tests exercise — the viewport-scope host decision
    is "should", not "must", and the library still has to serve hosts that skip it. *@
<div class="demo-shell min-h-screen @(ThemeService.IsDark ? "dark bg-slate-950 text-slate-100" : "bg-slate-50 text-slate-900")" data-theme="@ThemeService.ThemeName">
    <main class="p-4 max-w-3xl mx-auto">
        @Body
    </main>
</div>

@code {
    private Microsoft.JSInterop.IJSObjectReference? _appReadyModule;

    protected override void OnInitialized()
    {
        ThemeService.OnChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // The same readiness marker MainLayout sets; WaitForAppReadyAsync waits on it.
            // CSP-safe: a module import (no eval) keeps the ?csp=1 demo variant working.
            try
            {
                _appReadyModule ??= await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>(
                    "import", "./_content/Tempo.Blazor.Demo.SharedUI/js/demo-app-ready.js");
                await _appReadyModule.InvokeVoidAsync("markBodyReady");
            }
            catch (Microsoft.JSInterop.JSException)
            {
                // Progressive enhancement only.
            }
            catch (Microsoft.JSInterop.JSDisconnectedException)
            {
                // The circuit is gone; there is nothing left to mark.
            }
        }
    }

    public void Dispose()
    {
        ThemeService.OnChanged -= StateHasChanged;
    }
}
