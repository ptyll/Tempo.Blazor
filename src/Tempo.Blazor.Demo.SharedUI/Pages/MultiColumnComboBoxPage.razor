@page "/multi-column-combo-box"
@using Tempo.Blazor.Abstractions.Models
@using Tempo.Blazor.Interfaces
@using Tempo.Blazor.Models
<PageTitle>Multi-Column Combo Box – Tempo.Blazor</PageTitle>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Multi-Column Combo Box</h1>
    <p class="text-slate-600 dark:text-slate-400">A rich combo box with a multi-column grid dropdown for selecting items with multiple visible fields.</p>
</div>

<!-- MultiColumnComboBox -->
<section class="showcase-card">
    <div class="mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">Product Selector</h2>
        <p class="text-sm text-slate-600 dark:text-slate-400">Click the trigger to open a dropdown with a grid showing Name, Category, and Price columns.</p>
    </div>

    <TmMultiColumnComboBox TItem="Product"
                           TValue="int"
                           Data="_products"
                           ValueField="p => p.Id"
                           TextField="p => p.Name"
                           Columns="_columns"
                           @bind-Value="_selectedProductId" />

    @if (_selectedProductId != 0)
    {
        <div class="mt-4 p-3 bg-slate-50 dark:bg-slate-800/50 rounded-lg">
            <p class="text-sm text-slate-600 dark:text-slate-400">
                <span class="font-medium">Selected:</span> Product ID @_selectedProductId
                – @_products.FirstOrDefault(p => p.Id == _selectedProductId)?.Name
            </p>
        </div>
    }
</section>

<!-- Multi-select -->
<section class="showcase-card mt-8" data-testid="mccb-multiselect-section">
    <div class="mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">Multi-select</h2>
        <p class="text-sm text-slate-600 dark:text-slate-400">Set <code>MultiSelect="true"</code> and bind <code>SelectedValues</code>. Chosen rows become removable chips; the dropdown stays open so you can toggle several.</p>
    </div>

    <TmMultiColumnComboBox TItem="Product"
                           TValue="int"
                           Data="_products"
                           ValueField="p => p.Id"
                           TextField="p => p.Name"
                           Columns="_columns"
                           MultiSelect="true"
                           SelectedValues="_selectedProductIds"
                           SelectedValuesChanged="v => _selectedProductIds = v" />

    @if (_selectedProductIds.Count > 0)
    {
        <div class="mt-4 p-3 bg-slate-50 dark:bg-slate-800/50 rounded-lg">
            <p class="text-sm text-slate-600 dark:text-slate-400">
                <span class="font-medium">Selected IDs:</span> @string.Join(", ", _selectedProductIds)
            </p>
        </div>
    }
</section>

<!-- Create-new + Recent -->
<section class="showcase-card mt-8">
    <div class="mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">Create-new &amp; Recent</h2>
        <p class="text-sm text-slate-600 dark:text-slate-400">Provide an <code>IDropdownDataProvider</code> and opt in with <code>AllowCreateNew</code> / <code>ShowRecent</code>. Type a new name and pick "Create …" to add it; recent items appear at the top when the dropdown opens.</p>
    </div>

    <TmMultiColumnComboBox TItem="Product"
                           TValue="int"
                           Data="_creatableProducts"
                           ValueField="p => p.Id"
                           TextField="p => p.Name"
                           Columns="_columns"
                           @bind-Value="_createdProductId"
                           AllowCreateNew="true"
                           ShowRecent="true"
                           DataProvider="_productProvider" />

    @if (_createdProductId != 0)
    {
        <div class="mt-4 p-3 bg-slate-50 dark:bg-slate-800/50 rounded-lg">
            <p class="text-sm text-slate-600 dark:text-slate-400">
                <span class="font-medium">Selected:</span> Product ID @_createdProductId
                – @_creatableProducts.FirstOrDefault(p => p.Id == _createdProductId)?.Name
            </p>
        </div>
    }
</section>

<!-- N324: narrow trigger at the right edge — the min-width:320px panel must stay in viewport -->
<section class="showcase-card mt-8">
    <div class="mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">Narrow trigger, right edge</h2>
        <p class="text-sm text-slate-600 dark:text-slate-400">
            A 240px trigger whose panel declares <code>min-width: 320px</code>:
            <code>MatchAnchorWidth</code> writes the anchor width but the rendered box is wider —
            the placement math must use the rendered width, or the panel overhangs the viewport.
        </p>
    </div>

    <div class="ml-auto" style="width: 240px;" data-testid="mccb-narrow-host">
        <TmMultiColumnComboBox TItem="Product"
                               TValue="int"
                               Data="_products"
                               ValueField="p => p.Id"
                               TextField="p => p.Name"
                               Columns="_columns"
                               @bind-Value="_selectedProductId" />
    </div>
</section>

@code {
    private int _selectedProductId;
    private IReadOnlyList<int> _selectedProductIds = [];
    private int _createdProductId;

    private readonly List<Product> _products = new()
    {
        new(1, "Laptop Pro", "Electronics", 1299m),
        new(2, "Wireless Mouse", "Electronics", 49m),
        new(3, "Mechanical Keyboard", "Electronics", 159m),
        new(4, "Office Desk", "Furniture", 450m),
        new(5, "Ergonomic Chair", "Furniture", 320m),
        new(6, "Bookshelf", "Furniture", 180m),
    };

    private readonly List<Product> _creatableProducts = new()
    {
        new(1, "Laptop Pro", "Electronics", 1299m),
        new(2, "Wireless Mouse", "Electronics", 49m),
        new(3, "Mechanical Keyboard", "Electronics", 159m),
    };

    private ProductDropdownProvider? _productProvider;

    protected override void OnInitialized() => _productProvider = new ProductDropdownProvider(_creatableProducts);

    private readonly List<MultiColumnComboBoxColumn<Product>> _columns = new()
    {
        new() { Title = "Product", Field = p => p.Name },
        new() { Title = "Category", Field = p => p.Category },
        new() { Title = "Price", Field = p => $"${p.Price:F0}", Width = "90px" },
    };

    private record Product(int Id, string Name, string Category, decimal Price);

    /// <summary>In-memory provider that supports inline create-new and recent items for the demo.</summary>
    private sealed class ProductDropdownProvider : IDropdownDataProvider<Product>
    {
        private readonly List<Product> _all;

        public ProductDropdownProvider(List<Product> all) => _all = all;

        public Task<DropdownDataResult<Product>> GetItemsAsync(DropdownSearchRequest request, CancellationToken ct = default)
            => Task.FromResult(DropdownDataResult<Product>.WithAllItems(_all));

        public Task<Product?> CreateAsync(string text, CancellationToken ct = default)
        {
            var created = new Product(_all.Count == 0 ? 1 : _all.Max(p => p.Id) + 1, text, "Custom", 0m);
            _all.Add(created);
            return Task.FromResult<Product?>(created);
        }

        public Task<IReadOnlyList<Product>> GetRecentAsync(CancellationToken ct = default)
            => Task.FromResult<IReadOnlyList<Product>>(_all.Take(2).ToList());
    }
}
