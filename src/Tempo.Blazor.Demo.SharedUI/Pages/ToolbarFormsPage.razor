@page "/toolbar-forms"
@using Tempo.Blazor.Components.Toolbar
@inject ITmLocalizer Loc
<PageTitle>Toolbar & Forms – Tempo.Blazor</PageTitle>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Toolbar & Forms</h1>
    <p class="text-slate-600 dark:text-slate-400">Toolbar components and form layout helpers for consistent page structures.</p>
</div>

<!-- Toolbars -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Toolbars</h2>
    </div>
    
    <div class="space-y-6">
        <!-- Basic Toolbar -->
        <div class="showcase-card p-0 overflow-hidden">
            <div class="p-4 border-b border-slate-200 dark:border-slate-700">
                <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300">Basic Toolbar with Actions</h3>
            </div>
            <div class="p-4">
                <TmToolbar Title="Documents">
                    <Actions>
                        <TmToolbarButton Text="New" Icon="@IconNames.Plus" OnClick="@(() => _log = "New clicked")" />
                        <TmToolbarButton Text="Import" Icon="@IconNames.Upload" />
                        <TmToolbarDivider />
                        <TmToolbarButton Icon="@IconNames.Trash" Tooltip="Delete selected" Variant="ButtonVariant.Danger"
                                         OnClick="@(() => _log = "Delete clicked")" />
                    </Actions>
                </TmToolbar>
                
                @if (_log is not null)
                {
                    <div class="mt-3 p-3 bg-slate-50 dark:bg-slate-800/50 rounded-lg">
                        <p class="text-sm text-slate-600 dark:text-slate-400">
                            Last action: <span class="font-medium text-primary-600 dark:text-primary-400">@_log</span>
                        </p>
                    </div>
                }
            </div>
        </div>
        
        <!-- Toolbar with Content -->
        <div class="showcase-card p-0 overflow-hidden">
            <div class="p-4 border-b border-slate-200 dark:border-slate-700">
                <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300">Toolbar with Custom Content</h3>
            </div>
            <div class="p-4">
                <TmToolbar>
                    <ChildContent>
                        <TmSearchInput Placeholder="Search items..." />
                    </ChildContent>
                    <Actions>
                        <TmToolbarButton Text="Filter" Icon="@IconNames.Filter" />
                        <TmToolbarButton Text="Export" Icon="@IconNames.Download" />
                    </Actions>
                </TmToolbar>
            </div>
        </div>
    </div>
</section>

<!-- Overflow toolbar (F4) -->
<section class="demo-section" data-testid="toolbar-overflow-demo">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">@Loc["TmToolbarDemo_OverflowTitle"]</h2>
    </div>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">@Loc["TmToolbarDemo_OverflowIntro"]</p>

    <div class="space-y-6">
        @foreach (var width in _toolbarWidths)
        {
            <div class="showcase-card p-0 overflow-hidden" data-testid="@($"toolbar-overflow-card-{width}")">
                <div class="p-4 border-b border-slate-200 dark:border-slate-700">
                    <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300">@string.Format(Loc["TmToolbarDemo_WidthLabel"], width)</h3>
                </div>
                <div class="p-4">
                    <div style="width: @(width)px; max-width: 100%;">
                        <TmToolbar Overflow="ToolbarOverflow.Menu"
                                   Labels="ToolbarLabels.IconsWithText"
                                   AriaLabel="@Loc["TmToolbarDemo_AriaLabel"]"
                                   data-testid="@($"toolbar-overflow-{width}")">
                            <ChildContent>
                                <TmToolbarButton Icon="@IconNames.Plus" Text="@Loc["TmToolbarDemo_New"]" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_New"])" />
                                <TmToolbarButton Icon="@IconNames.FolderOpen" Text="@Loc["TmToolbarDemo_Open"]" Priority="ToolbarButtonPriority.Secondary" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Open"])" />
                                <TmToolbarButton Icon="@IconNames.Check" Text="@Loc["TmToolbarDemo_Save"]" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Save"])" />
                                <TmToolbarDivider />
                                <TmToolbarButton Icon="@IconNames.Copy" Text="@Loc["TmToolbarDemo_Copy"]" Priority="ToolbarButtonPriority.Secondary" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Copy"])" />
                                <TmToolbarButton Icon="@IconNames.Clipboard" Text="@Loc["TmToolbarDemo_Paste"]" Priority="ToolbarButtonPriority.Secondary" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Paste"])" />
                                <TmToolbarButton Icon="@IconNames.Download" Text="@Loc["TmToolbarDemo_Export"]" Priority="ToolbarButtonPriority.OverflowOnly" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Export"])" />
                                <TmToolbarButton Icon="@IconNames.Trash" Text="@Loc["TmToolbarDemo_Delete"]" Variant="ButtonVariant.Danger" Priority="ToolbarButtonPriority.OverflowOnly" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Delete"])" />
                            </ChildContent>
                        </TmToolbar>
                    </div>
                </div>
            </div>
        }

        <div class="showcase-card p-0 overflow-hidden" data-testid="toolbar-ribbon-card">
            <div class="p-4 border-b border-slate-200 dark:border-slate-700">
                <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300">@Loc["TmToolbarDemo_RibbonTitle"]</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">@Loc["TmToolbarDemo_RibbonDescription"]</p>
            </div>
            <div class="p-4">
                <TmToolbar Overflow="ToolbarOverflow.Menu"
                           Labels="ToolbarLabels.IconsWithText"
                           AriaLabel="@Loc["TmToolbarDemo_RibbonTitle"]"
                           data-testid="toolbar-ribbon">
                    <ChildContent>
                        <TmToolbarButton Icon="@IconNames.MousePointer" Text="@Loc["TmToolbarDemo_Select"]" LabelPosition="ToolbarLabelPosition.Below" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Select"])" />
                        <TmToolbarButton Icon="@IconNames.Hand" Text="@Loc["TmToolbarDemo_Pan"]" LabelPosition="ToolbarLabelPosition.Below" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Pan"])" />
                        <TmToolbarDivider />
                        <TmToolbarButton Icon="@IconNames.Copy" Text="@Loc["TmToolbarDemo_Copy"]" LabelPosition="ToolbarLabelPosition.Below" Priority="ToolbarButtonPriority.Secondary" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Copy"])" />
                        <TmToolbarButton Icon="@IconNames.Clipboard" Text="@Loc["TmToolbarDemo_Paste"]" LabelPosition="ToolbarLabelPosition.Below" Priority="ToolbarButtonPriority.Secondary" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Paste"])" />
                        <TmToolbarDivider />
                        <TmToolbarButton Icon="@IconNames.Layout" Text="@Loc["TmToolbarDemo_Layout"]" LabelPosition="ToolbarLabelPosition.Below" Priority="ToolbarButtonPriority.Secondary" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Layout"])" />
                        <TmToolbarButton Icon="@IconNames.Search" Text="@Loc["TmToolbarDemo_Find"]" LabelPosition="ToolbarLabelPosition.Below" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Find"])" />
                    </ChildContent>
                    <Actions>
                        <TmToolbarButton Icon="@IconNames.Download" Text="@Loc["TmToolbarDemo_Export"]" Priority="ToolbarButtonPriority.Secondary" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Export"])" />
                        <TmToolbarButton Icon="@IconNames.Check" Text="@Loc["TmToolbarDemo_Save"]" Variant="ButtonVariant.Primary" Priority="ToolbarButtonPriority.Pinned" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Save"])" />
                    </Actions>
                </TmToolbar>
            </div>
        </div>

        <div class="showcase-card p-0 overflow-hidden" data-testid="toolbar-group-card">
            <div class="p-4 border-b border-slate-200 dark:border-slate-700">
                <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300">@Loc["TmToolbarDemo_GroupTitle"]</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">@Loc["TmToolbarDemo_GroupDescription"]</p>
            </div>
            <div class="p-4">
                <div style="width: 1100px; max-width: 100%;" data-testid="toolbar-group-host">
                    <TmToolbar Overflow="ToolbarOverflow.Menu"
                               Labels="ToolbarLabels.IconsWithText"
                               AriaLabel="@Loc["TmToolbarDemo_GroupTitle"]"
                               data-testid="toolbar-group">
                        <div role="group" aria-label="@Loc["TmToolbarDemo_GroupTitle"]" data-tm-toolbar-group>
                            <TmToolbarButton Icon="@IconNames.Plus" Text="@Loc["TmToolbarDemo_New"]" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_New"])" />
                            <TmToolbarButton Icon="@IconNames.FolderOpen" Text="@Loc["TmToolbarDemo_Open"]" Priority="ToolbarButtonPriority.Secondary" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Open"])" />
                            <TmToolbarButton Icon="@IconNames.Copy" Text="@Loc["TmToolbarDemo_Copy"]" Priority="ToolbarButtonPriority.Secondary" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Copy"])" />
                            <TmToolbarButton Icon="@IconNames.Clipboard" Text="@Loc["TmToolbarDemo_Paste"]" Priority="ToolbarButtonPriority.Secondary" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Paste"])" />
                        </div>
                        <TmToolbarButton Icon="@IconNames.Download" Text="@Loc["TmToolbarDemo_Export"]" Priority="ToolbarButtonPriority.Secondary" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Export"])" />
                        <TmToolbarButton Icon="@IconNames.Check" Text="@Loc["TmToolbarDemo_Save"]" Variant="ButtonVariant.Primary" Priority="ToolbarButtonPriority.Pinned" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Save"])" />
                    </TmToolbar>
                </div>
            </div>
        </div>

        <div class="showcase-card p-0 overflow-hidden" data-testid="toolbar-conditional-card">
            <div class="p-4 border-b border-slate-200 dark:border-slate-700">
                <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300">@Loc["TmToolbarDemo_ConditionalTitle"]</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">@Loc["TmToolbarDemo_ConditionalDescription"]</p>
            </div>
            <div class="p-4 space-y-3">
                <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" OnClick="@(() => _showConditional = !_showConditional)" data-testid="toolbar-conditional-toggle">@Loc["TmToolbarDemo_ConditionalToggle"]</TmButton>
                <div style="width: 380px; max-width: 100%;">
                    <TmToolbar Overflow="ToolbarOverflow.Menu"
                               Labels="ToolbarLabels.IconsWithText"
                               AriaLabel="@Loc["TmToolbarDemo_ConditionalTitle"]"
                               data-testid="toolbar-conditional">
                        <TmToolbarButton Icon="@IconNames.Plus" Text="@Loc["TmToolbarDemo_New"]" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_New"])" />
                        @if (_showConditional)
                        {
                            <TmToolbarButton @key="@("conditional-open")" Icon="@IconNames.FolderOpen" Text="@Loc["TmToolbarDemo_Open"]" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Open"])" />
                        }
                        <TmToolbarButton Icon="@IconNames.Copy" Text="@Loc["TmToolbarDemo_Copy"]" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Copy"])" />
                        <TmToolbarButton Icon="@IconNames.Clipboard" Text="@Loc["TmToolbarDemo_Paste"]" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Paste"])" />
                        <TmToolbarButton Icon="@IconNames.Download" Text="@Loc["TmToolbarDemo_Export"]" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Export"])" />
                    </TmToolbar>
                </div>
            </div>
        </div>

        <div class="showcase-card p-0 overflow-hidden" data-testid="toolbar-overflowonly-mid-card">
            <div class="p-4 border-b border-slate-200 dark:border-slate-700">
                <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300">@Loc["TmToolbarDemo_OverflowOnlyMidTitle"]</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">@Loc["TmToolbarDemo_OverflowOnlyMidDescription"]</p>
            </div>
            <div class="p-4">
                <div style="width: 1100px; max-width: 100%;">
                    <TmToolbar Overflow="ToolbarOverflow.Menu"
                               Labels="ToolbarLabels.IconsWithText"
                               AriaLabel="@Loc["TmToolbarDemo_OverflowOnlyMidTitle"]"
                               data-testid="toolbar-overflowonly-mid">
                        <TmToolbarButton Icon="@IconNames.Plus" Text="@Loc["TmToolbarDemo_New"]" Priority="ToolbarButtonPriority.Pinned" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_New"])" />
                        <TmToolbarButton Icon="@IconNames.Download" Text="@Loc["TmToolbarDemo_Export"]" Priority="ToolbarButtonPriority.OverflowOnly" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Export"])" />
                        <TmToolbarButton Icon="@IconNames.Copy" Text="@Loc["TmToolbarDemo_Copy"]" Priority="ToolbarButtonPriority.Secondary" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Copy"])" />
                        <TmToolbarButton Icon="@IconNames.Clipboard" Text="@Loc["TmToolbarDemo_Paste"]" Priority="ToolbarButtonPriority.Secondary" OnClick="@(() => _overflowLog = Loc["TmToolbarDemo_Paste"])" />
                    </TmToolbar>
                </div>
            </div>
        </div>

        <div class="showcase-card p-0 overflow-hidden" data-testid="toolbar-shrink-card">
            <div class="p-4 border-b border-slate-200 dark:border-slate-700">
                <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300">@Loc["TmToolbarDemo_ShrinkTitle"]</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">@Loc["TmToolbarDemo_ShrinkDescription"]</p>
            </div>
            <div class="p-4 space-y-3">
                <div style="display: flex; justify-content: space-between; gap: 1rem; width: 100%;">
                    <span class="text-sm">@Loc["TmToolbarDemo_ShrinkPlain"]</span>
                    <TmToolbar AriaLabel="@Loc["TmToolbarDemo_ShrinkPlain"]" data-testid="toolbar-shrink-plain">
                        <TmToolbarButton Icon="@IconNames.Plus" Text="@Loc["TmToolbarDemo_New"]" />
                    </TmToolbar>
                </div>
                <div style="display: flex; justify-content: space-between; gap: 1rem; width: 100%;">
                    <span class="text-sm">@Loc["TmToolbarDemo_ShrinkFixed"]</span>
                    <TmToolbar AriaLabel="@Loc["TmToolbarDemo_ShrinkFixed"]" style="flex: 1 1 auto; min-width: 0;" data-testid="toolbar-shrink-fixed">
                        <TmToolbarButton Icon="@IconNames.Plus" Text="@Loc["TmToolbarDemo_New"]" />
                    </TmToolbar>
                </div>
            </div>
        </div>

        <div class="showcase-card p-0 overflow-hidden" data-testid="toolbar-labels-card">
            <div class="p-4 border-b border-slate-200 dark:border-slate-700">
                <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300">@Loc["TmToolbarDemo_LabelsTitle"]</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">@Loc["TmToolbarDemo_LabelsDescription"]</p>
            </div>
            <div class="p-4 space-y-3">
                <div style="width: 360px; max-width: 100%;">
                    <TmToolbar AriaLabel="@Loc["TmToolbarDemo_LabelsAuto"]" data-testid="toolbar-labels-auto">
                        <TmToolbarButton Icon="@IconNames.Plus" Text="@Loc["TmToolbarDemo_New"]" />
                        <TmToolbarButton Icon="@IconNames.Copy" Text="@Loc["TmToolbarDemo_Copy"]" />
                    </TmToolbar>
                </div>
                <div style="width: 720px; max-width: 100%;">
                    <TmToolbar AriaLabel="@Loc["TmToolbarDemo_LabelsAuto"]" data-testid="toolbar-labels-auto-wide">
                        <TmToolbarButton Icon="@IconNames.Plus" Text="@Loc["TmToolbarDemo_New"]" />
                        <TmToolbarButton Icon="@IconNames.Copy" Text="@Loc["TmToolbarDemo_Copy"]" />
                    </TmToolbar>
                </div>
            </div>
        </div>

        @if (_overflowLog is not null)
        {
            <p class="text-sm text-slate-600 dark:text-slate-400" data-testid="toolbar-overflow-log">
                @Loc["TmToolbarDemo_LastAction"]: <span class="font-medium text-primary-600 dark:text-primary-400">@_overflowLog</span>
            </p>
        }
    </div>
</section>
<!-- Form Layout -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Form Layout</h2>
    </div>
    
    <div class="space-y-6">
        <!-- Form Section with Rows -->
        <div class="showcase-card">
            <TmFormSection Title="Personal Information" Description="Your basic profile details.">
                <TmFormRow Columns="2">
                    <TmFormField Label="First name" Required="true">
                        <TmTextInput Value="@_firstName" ValueChanged="v => _firstName = v" Placeholder="John" />
                    </TmFormField>
                    <TmFormField Label="Last name" Required="true">
                        <TmTextInput Value="@_lastName" ValueChanged="v => _lastName = v" Placeholder="Doe" />
                    </TmFormField>
                </TmFormRow>
                <TmFormRow Columns="2">
                    <TmFormField Label="Email" HelpText="We'll never share your email.">
                        <TmTextInput Value="@_email" ValueChanged="v => _email = v" Placeholder="john@example.com" />
                    </TmFormField>
                    <TmFormField Label="Phone">
                        <TmTextInput Value="@_phone" ValueChanged="v => _phone = v" Placeholder="+1 555 000 0000" />
                    </TmFormField>
                </TmFormRow>
            </TmFormSection>
        </div>
        
        <!-- Collapsible Section -->
        <div class="showcase-card">
            <TmFormSection Title="Advanced Settings" Description="Configuration options for power users." Collapsible="true" CollapsedByDefault="true">
                <TmFormRow Columns="1">
                    <TmFormField Label="API Key" HelpText="Read-only generated key.">
                        <TmTextInput Value="sk-demo-key-1234" ValueChanged="@(_ => {})" />
                    </TmFormField>
                </TmFormRow>
                <TmFormRow Columns="2">
                    <TmFormField Label="Timeout (ms)">
                        <TmTextInput Value="5000" ValueChanged="@(_ => {})" />
                    </TmFormField>
                    <TmFormField Label="Max retries">
                        <TmTextInput Value="3" ValueChanged="@(_ => {})" />
                    </TmFormField>
                </TmFormRow>
            </TmFormSection>
        </div>
        
        <!-- Validation Example -->
        <div class="showcase-card">
            <TmFormSection Title="Validation Example">
                <TmFormRow Columns="2">
                    <TmFormField Label="Username" Required="true"
                                 ErrorMessage="@(_username.Length < 3 && _username.Length > 0 ? "Min 3 characters" : null)">
                        <TmTextInput Value="@_username" ValueChanged="v => _username = v" Placeholder="Enter username" />
                    </TmFormField>
                    <TmFormField Label="Role" HelpText="Choose the user's role in the system.">
                        <TmSelect TValue="string"
                                  Value="@_role"
                                  ValueChanged="v => _role = v ?? string.Empty"
                                  Options="@_roleOptions"
                                  Placeholder="Select role..." />
                    </TmFormField>
                </TmFormRow>
            </TmFormSection>
        </div>
    </div>
</section>

<!-- Form Action Bar -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Form Action Bar</h2>
    </div>

    <div class="space-y-6">
        <div class="showcase-card">
            <div class="mb-4">
                <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300">Static — normal document flow</h3>
            </div>
            <TmFormActionBar AriaLabel="Form actions" Position="FormActionBarPosition.Static">
                <ChildContent>
                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Invoice #4821</span>
                </ChildContent>
                <SecondaryActions>
                    <TmButton Variant="ButtonVariant.Secondary">Cancel</TmButton>
                </SecondaryActions>
                <PrimaryActions>
                    <TmButton Variant="ButtonVariant.Primary">Save</TmButton>
                </PrimaryActions>
            </TmFormActionBar>
        </div>

        <div class="showcase-card">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                FloatingBottomFromMd — responsive mode
            </h3>
            <p class="text-sm text-slate-600 dark:text-slate-400">
                The bar at the bottom of this page uses
                <code class="text-xs">Position="FormActionBarPosition.FloatingBottomFromMd"</code>:
                below 768px it sits in normal document flow (try narrowing the window — it docks
                into the page instead of overlaying it), and from 768px up it floats at the
                viewport bottom. The page leaves room for it through
                <code class="text-xs">--tm-form-action-bar-reserve-block-size</code>, which the
                library collapses to zero below the same boundary, so no dead space remains on
                mobile.
            </p>
        </div>
    </div>
</section>

@* The bar floats above page content from md up, so the page keeps a reserve under it. Below
   md the token resolves to 0 (the bar is in flow and covers nothing), so this spacer costs
   no space on mobile — that is the library-owned coupling the gap register asked for. *@
<div class="toolbar-forms-fab-reserve" aria-hidden="true"></div>

<div class="toolbar-forms-fab-host">
    <TmFormActionBar TestId="demo-fab-responsive" AriaLabel="Page actions"
                     Position="FormActionBarPosition.FloatingBottomFromMd">
        <ChildContent>
            <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Invoice #4821</span>
        </ChildContent>
        <Status>
            <span class="text-xs">Draft</span>
        </Status>
        <SecondaryActions>
            <TmButton Variant="ButtonVariant.Secondary">Discard</TmButton>
        </SecondaryActions>
        <PrimaryActions>
            <TmButton Variant="ButtonVariant.Primary">Save invoice</TmButton>
        </PrimaryActions>
    </TmFormActionBar>
</div>

@code {
    private string? _log;
    private string? _overflowLog;
    private bool _showConditional;
    private static readonly int[] _toolbarWidths = [1100, 380, 300];

    // Form fields
    private string _firstName = string.Empty;
    private string _lastName = string.Empty;
    private string _email = string.Empty;
    private string _phone = string.Empty;
    private string _username = string.Empty;
    private string _role = string.Empty;

    private readonly IReadOnlyList<SelectOption<string>> _roleOptions = new[]
    {
        new SelectOption<string>("admin", "Administrator"),
        new SelectOption<string>("editor", "Editor"),
        new SelectOption<string>("viewer", "Viewer"),
        new SelectOption<string>("guest", "Guest"),
    };
}
