@page "/responsive-conventions"
@using Tempo.Blazor.Abstractions.Layout
@inject IJSRuntime JS
@implements IAsyncDisposable
@using Tempo.Blazor.Components.Dashboard
@using Tempo.Blazor.Interfaces
@using Tempo.Blazor.Models
@inject ITmLocalizer Loc
@inject IDashboardProvider Dashboards
@inject IWidgetRegistry Widgets

<PageTitle>@Loc["TmResponsiveDemo_Title"] – Tempo.Blazor</PageTitle>

<div class="rc-page">
    <header class="rc-header">
        <h1>@Loc["TmResponsiveDemo_Title"]</h1>
        <p>@Loc["TmResponsiveDemo_Intro"]</p>
    </header>

    <div class="rc-controls">
        <span class="rc-force-label">@Loc["TmResponsiveDemo_ForceLabel"]</span>
        <div role="group" aria-label="@Loc["TmResponsiveDemo_ForcedLayout"]">
            @foreach (var mode in _modes)
            {
                <button type="button"
                        class="tm-btn tm-btn-sm @(mode == _mode ? "tm-btn-primary" : "tm-btn-secondary")"
                        aria-pressed="@(_mode == mode ? "true" : "false")"
                        @onclick="() => _mode = mode">
                    @ModeName(mode)
                </button>
            }
        </div>
        <span class="rc-resolved" data-testid="rc-resolved">@Loc["TmResponsiveDemo_Resolved", ModeName(_resolved)]</span>
    </div>

    <div class="rc-stage">
        <section class="rc-host rc-host--wide" data-testid="rc-host-wide">
            <h2 data-testid="rc-host-wide-heading">@HostHeading("TmResponsiveDemo_WideHost", "rc-host-wide")</h2>
            <TmDashboard DashboardId="rc-wide" UserId="rc" LayoutMode="_mode" LayoutModeChanged="OnResolved" Class="rc-dashboard" />
        </section>

        <section class="rc-host rc-host--medium" data-testid="rc-host-medium">
            <h2 data-testid="rc-host-medium-heading">@HostHeading("TmResponsiveDemo_MediumHost", "rc-host-medium")</h2>
            <TmDashboard DashboardId="rc-medium" UserId="rc" Class="rc-dashboard" />
        </section>

        <section class="rc-host rc-host--compact" data-testid="rc-host-compact">
            <h2 data-testid="rc-host-compact-heading">@HostHeading("TmResponsiveDemo_CompactHost", "rc-host-compact")</h2>
            <TmDashboard DashboardId="rc-compact" UserId="rc" Class="rc-dashboard" />
        </section>

        <section class="rc-host rc-host--narrow" data-testid="rc-host-narrow">
            <h2 data-testid="rc-host-narrow-heading">@HostHeading("TmResponsiveDemo_NarrowHost", "rc-host-narrow")</h2>
            <TmDashboard DashboardId="rc-narrow" UserId="rc" Class="rc-dashboard" />
        </section>
    </div>

    <div class="rc-reveal tm-reveal-host">
        <span>@Loc["TmResponsiveDemo_RevealHint"]</span>
        <button type="button" class="tm-btn tm-btn-icon tm-btn-secondary tm-reveal-on-hover" data-testid="rc-reveal" aria-label="@Loc["TmResponsiveDemo_Details"]">
            @Loc["TmResponsiveDemo_Details"]
        </button>
    </div>
</div>

@code {
    private static readonly TmLayoutMode[] _modes =
        [TmLayoutMode.Auto, TmLayoutMode.Desktop, TmLayoutMode.Tablet, TmLayoutMode.Mobile];

    private TmLayoutMode _mode = TmLayoutMode.Auto;
    private TmLayoutMode _resolved = TmLayoutMode.Desktop;

    private bool _seeded;

    protected override async Task OnInitializedAsync()
    {
        if (_seeded) return;
        _seeded = true;
        foreach (var id in new[] { "rc-wide", "rc-medium", "rc-compact", "rc-narrow" })
            await Dashboards.SaveDashboardAsync(ResponsiveConventionsProvider.Create(id));
        foreach (var widget in ResponsiveConventionsProvider.Widgets)
            Widgets.RegisterWidget(widget);
    }

    private string ModeName(TmLayoutMode mode) => Loc[$"TmLayoutMode_{mode}"];

    private readonly Dictionary<string, int> _widths = new(StringComparer.Ordinal);

    private string HostHeading(string hostKey, string testId)
    {
        var mode = testId == "rc-host-wide" ? _resolved : ModeFor(_widths.GetValueOrDefault(testId));
        var width = _widths.TryGetValue(testId, out var measured) && measured > 0 ? $" · {measured} px" : "";
        return $"{Loc[hostKey]}{width} · {ModeName(mode)}";
    }

    private static TmLayoutMode ModeFor(int widthPx) =>
        widthPx <= 0 ? TmLayoutMode.Desktop : TmBreakpoints.Classify(widthPx);

    private bool _watching;
    private DotNetObjectReference<ResponsiveConventionsPage>? _self;

    protected override void OnAfterRender(bool firstRender)
    {
        if (_watching || JS is not IJSInProcessRuntime sync) return;
        _watching = true;
        _self = DotNetObjectReference.Create(this);
        sync.InvokeVoid("tmResponsiveConventions.watch", _self);
    }

    [JSInvokable]
    public void OnMeasured(Dictionary<string, int> measured)
    {
        foreach (var pair in measured) _widths[pair.Key] = pair.Value;
        StateHasChanged();
    }

    public ValueTask DisposeAsync()
    {
        _self?.Dispose();
        return ValueTask.CompletedTask;
    }

    private Task OnResolved(TmLayoutMode mode)
    {
        _resolved = mode;
        return Task.CompletedTask;
    }
}
