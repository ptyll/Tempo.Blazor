@page "/multi-view-list"
@using Tempo.Blazor.Components.DataDisplay
@inject ITmLocalizer Loc
@using Tempo.Blazor.Components.DataTable
@using Tempo.Blazor.Interfaces
@using Tempo.Blazor.Models
@using Tempo.Blazor.Demo.Shared
@using Tempo.Blazor.Demo.Services

<PageTitle>Multi View List – Tempo.Blazor</PageTitle>

<!-- Redesign opt-in playground -->
<section class="demo-section" data-testid="mvl-redesign-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">@Loc["TmMvlDemo_RedesignTitle"]</h2>
    </div>
    <div class="showcase-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            @Loc["TmMvlDemo_RedesignDescription"]
        </p>
        <div class="flex flex-wrap gap-3 mb-4">
            <div data-testid="mvl-redesign-switcher-labels">
                <TmSelect TValue="ViewSwitcherLabels" Label="@Loc["TmMvlDemo_SwitcherLabels"]"
                          Options="_switcherLabelOptions" @bind-Value="_redesignSwitcherLabels" />
            </div>
            <div data-testid="mvl-redesign-avatar-fallback">
                <TmSelect TValue="AvatarFallback" Label="@Loc["TmMvlDemo_AvatarFallback"]"
                          Options="_avatarFallbackOptions" @bind-Value="_redesignAvatarFallback" />
            </div>
            <div data-testid="mvl-redesign-cell-layout">
                <TmSelect TValue="TableCellLayout" Label="@Loc["TmMvlDemo_CellLayout"]"
                          Options="_cellLayoutOptions" @bind-Value="_redesignCellLayout" />
            </div>
            <div data-testid="mvl-redesign-card-activation">
                <TmSelect TValue="CardActivation" Label="@Loc["TmMvlDemo_CardActivation"]"
                          Options="_cardActivationOptions" @bind-Value="_redesignCardActivation" />
            </div>
            <div data-testid="mvl-redesign-item-count">
                <TmToggle Label="@Loc["TmMvlDemo_ItemCount"]" @bind-Value="_redesignItemCount" />
            </div>
            <div data-testid="mvl-redesign-responsive">
                <TmToggle Label="@Loc["TmMvlDemo_Responsive"]" @bind-Value="_redesignResponsive" />
            </div>
            <div data-testid="mvl-redesign-max-columns">
                <TmToggle Label="@Loc["TmMvlDemo_MaxColumns"]" @bind-Value="_redesignCapColumns" />
            </div>
            <div data-testid="mvl-redesign-item-href">
                <TmToggle Label="@Loc["TmMvlDemo_ItemHref"]" @bind-Value="_redesignItemHref" />
            </div>
            <div data-testid="mvl-redesign-status-variant">
                <TmToggle Label="@Loc["TmMvlDemo_StatusVariant"]" @bind-Value="_redesignStatusVariant" />
            </div>
            <div data-testid="mvl-redesign-group-header">
                <TmToggle Label="@Loc["TmMvlDemo_GroupHeader"]" @bind-Value="_redesignGroupHeader" />
            </div>
            <div data-testid="mvl-redesign-result-preview">
                <TmToggle Label="@Loc["TmMvlDemo_ResultPreview"]" @bind-Value="_redesignResultPreview" />
            </div>
        </div>
        <div data-testid="mvl-redesign-list">
            <TmMultiViewList TItem="TeamMember"
                             Items="_redesignMembers"
                             ViewContext="mvl-redesign-demo"
                             TitleField="m => m.Title"
                             SubTitleField="m => m.SubTitle"
                             AvatarUrlField="m => m.AvatarUrl"
                             StatusLabelField="m => m.StatusLabel"
                             StatusVariantField="@(_redesignStatusVariant ? RedesignStatusVariant : null)"
                             GroupableFields="_redesignGroupFields"
                             GroupHeaderTemplate="@(_redesignGroupHeader ? RedesignGroupHeader : null)"
                             ViewSwitcherLabels="_redesignSwitcherLabels"
                             AvatarFallback="_redesignAvatarFallback"
                             TableCellLayout="_redesignCellLayout"
                             CardActivation="_redesignCardActivation"
                             ShowItemCount="_redesignItemCount"
                             Responsive="_redesignResponsive"
                             MaxCardColumns="@(_redesignCapColumns ? 2 : null)"
                             ItemHref="@(_redesignItemHref ? RedesignHref : null)"
                             ShowFilterResultPreview="_redesignResultPreview"
                             ViewProvider="_redesignViews"
                             ExternalFilterDefinitions="_redesignFilterDefs"
                             ShowSearch="true"
                             ShowViewSwitcher="true" />
        </div>
        <div class="mt-4" data-testid="mvl-redesign-cards">
            <TmMultiViewList TItem="TeamMember"
                             Items="_redesignMembers"
                             ViewContext="mvl-redesign-cards"
                             ViewMode="ListViewMode.Card"
                             GroupsCollapsedByDefault="false"
                             TitleField="m => m.Title"
                             SubTitleField="m => m.SubTitle"
                             StatusLabelField="m => m.StatusLabel"
                             GroupableFields="_redesignGroupFields"
                             ShowSearch="false"
                             ShowViewSwitcher="false" />
        </div>
    </div>
</section>

<!-- Edge cases: an empty card list and cards with very long titles -->
<section class="demo-section" data-testid="mvl-edge-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">@Loc["TmMvlDemo_EdgeTitle"]</h2>
    </div>
    <div class="showcase-card">
        <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">@Loc["TmMvlDemo_EdgeEmptyHeading"]</h3>
        <div data-testid="mvl-edge-empty">
            <TmMultiViewList TItem="TeamMember"
                             Items="_edgeEmptyMembers"
                             ViewContext="mvl-edge-empty"
                             ViewMode="ListViewMode.Card"
                             EmptyTitle="@Loc["TmMvlDemo_EdgeEmptyTitle"]"
                             TitleField="m => m.Title"
                             ShowSearch="false"
                             ShowViewSwitcher="false" />
        </div>
        <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300 mt-6 mb-2">@Loc["TmMvlDemo_EdgeLongHeading"]</h3>
        <div data-testid="mvl-edge-long" style="max-inline-size: 24rem">
            <TmMultiViewList TItem="TeamMember"
                             Items="_edgeLongMembers"
                             ViewContext="mvl-edge-long"
                             ViewMode="ListViewMode.Card"
                             AvatarFallback="AvatarFallback.Initials"
                             TitleField="m => m.Title"
                             SubTitleField="m => m.SubTitle"
                             StatusLabelField="m => m.StatusLabel"
                             ShowSearch="false"
                             ShowViewSwitcher="false" />
        </div>
    </div>
</section>
<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Multi View List</h1>
    <p class="text-slate-600 dark:text-slate-400">Flexible list component with table, card, and list views. Supports saved views, filtering, and search.</p>
</div>

<!-- Info Alert -->
<div class="p-4 mb-6 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-xl">
    <div class="flex items-center space-x-3">
        <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
            <p class="text-sm text-blue-800 dark:text-blue-200">
                MultiViewList with <strong>View Manager</strong> - Save and load custom views with filters.
            </p>
            <p class="text-xs text-blue-600 dark:text-blue-400 mt-1">
                Uses <code>ViewHttpProvider</code> for persistence. Requires Demo.Api.
            </p>
        </div>
    </div>
</div>

<!-- Multi View List with Views -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Team Members</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full">With Views</span>
    </div>
    
    <TmMultiViewList TItem="TeamMember"
                     Items="_teamMembers"
                     ViewContext="team-members"
                     ViewProvider="_viewProvider"
                     ViewFilterDefinitions="_filterDefs"
                     ExternalFilterDefinitions="_filterDefs"
                     ShowExternalFilterBuilder="true"
                     TableCellLayout="TableCellLayout.Stacked"
                     ViewCanCreateTenantViews="true"
                     CurrentUserId="CurrentUserId"
                     CurrentTenantId="CurrentTenantId"
                     DisplayResolver="ResolveDisplay"
                     ShowSearch="true"
                     ShowViewSwitcher="true"
                     EmptyTitle="No team members found"
                     OnItemClick="OnTeamMemberClick" />
</section>

<!-- Simple Multi View List (without views) -->
<section class="demo-section mt-8">
    <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Projects</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-full">Simple</span>
    </div>
    
    <TmMultiViewList TItem="Project"
                     Items="_projects"
                     ViewContext="demo-projects"
                     ShowSearch="true"
                     ShowViewSwitcher="true"
                     EmptyTitle="No projects found"
                     OnItemClick="OnProjectClick" />
</section>

<!-- Page-Owned Filters + Content-Only List -->
<section class="demo-section mt-8">
    <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Projects with Page-Owned Filters</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-300 rounded-full">Content-Only</span>
    </div>

    <div class="p-4 mb-4 bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-800 rounded-xl">
        <p class="text-sm text-orange-800 dark:text-orange-200">
            The page owns the filter UI. The list uses <code>ToolbarMode="ContentOnly"</code> so it renders only the data surface.
        </p>
    </div>

    <div class="flex flex-wrap gap-3 mb-4">
        <TmSelect TValue="string"
                  Options="_projectStatusOptions"
                  @bind-Value="_selectedProjectStatus"
                  Placeholder="Filter by status" />
        <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="ClearProjectFilter">
            Clear
        </TmButton>
    </div>

    <TmMultiViewList TItem="Project"
                     Items="_filteredProjects"
                     ViewContext="demo-projects-filtered"
                     ToolbarMode="DataToolbarMode.ContentOnly"
                     EmptyTitle="No projects found"
                     OnItemClick="OnProjectClick" />
</section>

<!-- Saved Views Without External Filter Builder -->
<section class="demo-section mt-8">
    <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Team Members — Saved Views Only</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full">Views Only</span>
    </div>

    <div class="p-4 mb-4 bg-purple-50 dark:bg-purple-900/20 border border-purple-200 dark:border-purple-800 rounded-xl">
        <p class="text-sm text-purple-800 dark:text-purple-200">
            Saved views are available, but the inline external filter builder is hidden to avoid duplicate UI.
        </p>
    </div>

    <TmMultiViewList TItem="TeamMember"
                     Items="_teamMembers"
                     ViewContext="team-members-views-only"
                     ViewProvider="_viewProvider"
                     ViewFilterDefinitions="_filterDefs"
                     ShowExternalFilterBuilder="false"
                     ShowSearch="false"
                     ViewCanCreateTenantViews="true"
                     CurrentUserId="CurrentUserId"
                     CurrentTenantId="CurrentTenantId"
                     DisplayResolver="ResolveDisplay"
                     EmptyTitle="No team members found"
                     OnItemClick="OnTeamMemberClick" />
</section>

<!-- Server-Side MultiViewList with Grouping -->
<section class="demo-section mt-8">
    <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Persons (Server-Side with Grouping)</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-full">Server-Side</span>
    </div>

    <div class="p-4 mb-4 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-xl">
        <p class="text-sm text-green-800 dark:text-green-200">
            Uses <code>PersonHttpDataProvider</code> with <strong>server-side grouping</strong> and <strong>per-group pagination</strong>.
        </p>
        <p class="text-xs text-green-600 dark:text-green-400 mt-1">
            Requires Demo.Api running on port 5100. Group by Role to see per-group mini-pager.
        </p>
    </div>

    <TmMultiViewList TItem="PersonDto"
                     DataProvider="_personProvider"
                     ViewContext="persons-mvl"
                     TitleField="@(p => p.FullName)"
                     SubTitleField="@(p => p.Email)"
                     StatusLabelField="@(p => p.IsActive ? "Active" : "Inactive")"
                     StatusColorField="@(p => p.IsActive ? "#15803d" : "#b91c1c")"
                     DateField="@(p => new DateTimeOffset(p.HiredAt, TimeOnly.MinValue, TimeSpan.Zero))"
                     GroupableFields="_personGroupFields"
                     ShowSearch="true"
                     ShowViewSwitcher="true"
                     DefaultPageSize="10"
                     EmptyTitle="No persons found"
                     OnItemClick="OnPersonClick" />
</section>

@code {
    [Inject] private PersonHttpDataProvider PersonProvider { get; set; } = default!;
    [Inject] private ViewHttpProvider ViewProvider { get; set; } = default!;

    private IDataTableViewProvider _viewProvider = default!;
    private IDataTableDataProvider<PersonDto> _personProvider = default!;
    private string CurrentUserId => "CurrentUserId";
    private string CurrentTenantId => "CurrentTenantId";

    private readonly IReadOnlyList<GroupFieldDefinition<PersonDto>> _personGroupFields =
    [
        new GroupFieldDefinition<PersonDto>
        {
            FieldName = "Role",
            Label = "Role",
            FieldAccessor = p => p.Role
        },
        new GroupFieldDefinition<PersonDto>
        {
            FieldName = "Department",
            Label = "Department",
            FieldAccessor = p => p.Department
        },
        new GroupFieldDefinition<PersonDto>
        {
            FieldName = "IsActive",
            Label = "Active",
            FieldAccessor = p => p.IsActive,
            DisplayFormatter = v => v is true ? "Active" : "Inactive"
        }
    ];

    // Page-owned filter state for content-only list demo
    private string _selectedProjectStatus = string.Empty;

    private IReadOnlyList<SelectOption<string>> _projectStatusOptions =>
    [
        new() { Value = "", Label = "All" },
        new() { Value = "In Progress", Label = "In Progress" },
        new() { Value = "Planning", Label = "Planning" },
        new() { Value = "Completed", Label = "Completed" },
        new() { Value = "On Hold", Label = "On Hold" }
    ];

    private IReadOnlyList<Project> _filteredProjects =>
        (string.IsNullOrEmpty(_selectedProjectStatus)
            ? _projects
            : _projects.Where(p => p.StatusLabel == _selectedProjectStatus)).ToList();

    // Filter definitions for View Manager
    private List<FilterDefinition> _filterDefs = 
