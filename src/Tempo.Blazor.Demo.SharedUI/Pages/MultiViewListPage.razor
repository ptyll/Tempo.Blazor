        new() { Title = "Ada Lovelace", SubTitle = "Senior Developer", Role = "Developer", StatusLabel = "Active" },
        new() { Title = "Grace Hopper", SubTitle = "Compiler Lead", Role = "Developer", StatusLabel = "Active" },
        new() { Title = "Alan Turing", SubTitle = "Account Lead", Role = "Analyst", StatusLabel = "Inactive" }
    ];

    // ── Edge-case playground (fixed data) ──
    private readonly List<TeamMember> _edgeEmptyMembers = [];
    private List<TeamMember> _edgeLongMembers = [];
    private IReadOnlyList<GroupFieldDefinition<TeamMember>> _redesignGroupFields = [];

    private readonly InMemoryViewProvider _redesignViews = new([]);

    private List<FilterDefinition> _redesignFilterDefs = [];

    private static BadgeVariant RedesignStatusVariant(TeamMember member)
        => member.StatusLabel == "Active" ? BadgeVariant.Success : BadgeVariant.Danger;

    private static string? RedesignHref(TeamMember member) => $"/team/{member.Id}";

    private RenderFragment<DataGroup<TeamMember>> RedesignGroupHeader => group => @<text>
        <strong>@Loc["TmMvlDemo_GroupHeaderText", group.DisplayValue, group.Count]</strong>
    </text>;

    protected override void OnInitialized()
    {
        _viewProvider = ViewProvider;
        _personProvider = PersonProvider;
        _switcherLabelOptions = EnumOptions<ViewSwitcherLabels>();
        _avatarFallbackOptions = EnumOptions<AvatarFallback>();
        _cellLayoutOptions = EnumOptions<TableCellLayout>();
        _cardActivationOptions = EnumOptions<CardActivation>();
        _edgeLongMembers =
        [
            new() { Title = Loc["TmMvlDemo_EdgeLongTitle"], SubTitle = Loc["TmMvlDemo_EdgeLongSubtitle"], Role = "Developer", StatusLabel = "Active" },
            new() { Title = "Grace Hopper", SubTitle = Loc["TmMvlDemo_EdgeLongSubtitle"], Role = "Developer", StatusLabel = "Inactive" }
        ];
        _redesignGroupFields =
        [
            new GroupFieldDefinition<TeamMember> { FieldName = "Role", Label = Loc["TmMvlDemo_RedesignRole"], FieldAccessor = m => m.Role }
        ];
        _redesignFilterDefs =
        [
            new() { FieldName = "Role", FieldLabel = Loc["TmMvlDemo_RedesignRole"], FieldType = FilterFieldType.Text }
        ];
    }

    private void OnTeamMemberClick(TeamMember item)
    {
        Console.WriteLine($"Clicked: {item.Title}");
    }

    private void OnProjectClick(Project item)
    {
        Console.WriteLine($"Clicked: {item.Title}");
    }

    private void ClearProjectFilter()
    {
        _selectedProjectStatus = string.Empty;
    }

    private void OnPersonClick(PersonDto item)
    {
        Console.WriteLine($"Clicked: {item.FullName}");
    }

    /// <summary>
    /// DisplayResolver demo: localizes field labels and enum filter values.
    /// In a real app, this would use IStringLocalizer or a resource file.
    /// </summary>
    private string? ResolveDisplay(string fieldName, string? rawValue)
    {
        // Field labels (rawValue == null)
        if (rawValue is null)
        {
            return fieldName switch
            {
                "Title" => "Název",
                "Status" => "Stav",
                "Role" => "Pozice",
                _ => null
            };
        }

        // Enum value labels (rawValue != null)
        return (fieldName, rawValue) switch
        {
            ("Status", "Active") => "Aktivní",
            ("Status", "Inactive") => "Neaktivní",
            ("Status", "Pending") => "Čekající",
            ("Status", "Completed") => "Dokončeno",
            ("Role", "Developer") => "Vývojář",
            ("Role", "Designer") => "Designér",
            ("Role", "Manager") => "Manažer",
            ("Role", "Analyst") => "Analytik",
            _ => null
        };
    }

    // Implementation classes
    private class TeamMember : IMultiViewListItem
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Title { get; set; } = "";
        public string? SubTitle { get; set; }
        public string? StatusLabel { get; set; }
        public string? StatusColor { get; set; }
        public DateTimeOffset? Date { get; set; }
        public string? AvatarUrl { get; set; }
        public IReadOnlyList<ITag> Tags { get; set; } = Array.Empty<ITag>();
        public string? Status { get; set; }
        public string? Role { get; set; }
    }

    private class Project : IMultiViewListItem
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Title { get; set; } = "";
        public string? SubTitle { get; set; }
        public string? StatusLabel { get; set; }
        public string? StatusColor { get; set; }
        public DateTimeOffset? Date { get; set; }
        public string? AvatarUrl { get; set; }
        public IReadOnlyList<ITag> Tags { get; set; } = Array.Empty<ITag>();
    }

    private class SimpleTag : ITag
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Color { get; set; } = "";
    }
}
