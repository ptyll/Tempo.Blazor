@page "/editor-shell"
@using Tempo.Blazor.Abstractions.Layout
@using Tempo.Blazor.Components.Actions
@using Tempo.Blazor.Components.Layout
@inject ITmLocalizer Loc

<PageTitle>@Loc["TmEditorShellDemo_Title"] – Tempo.Blazor</PageTitle>

<div class="es-page">
    <header class="es-header">
        <h1 tabindex="-1" @ref="_title">@Loc["TmEditorShellDemo_Title"]</h1>
        <p>@Loc["TmEditorShellDemo_Intro"]</p>
    </header>

    <div class="es-shell-host" data-testid="editor-shell-host">
        <TmEditorShell @ref="_shell"
                       LeftTitle="@Loc["TmEditorShellDemo_Blocks"]"
                       RightTitle="@Loc["TmEditorShellDemo_Properties"]"
                       @bind-LeftOpen="_leftOpen"
                       @bind-RightOpen="_rightOpen"
                       @bind-CollapsedPanels="_collapsed"
                       MobilePanelPresentation="_presentation"
                       @bind-ActiveMobilePanel="_activePanel"
                       @bind-MobileSheetSnapIndex="_snap"
                       MobileActions="_mobileActions"
                       PersistWidthsKey="editor-shell-demo"
                       data-testid="editor-shell">
            <Header>
                <div class="es-editor-header">
                    <h2>@Loc["TmEditorShellDemo_EditorTitle"]</h2>
                    <span class="es-editor-header__state">@Loc["TmEditorShellDemo_SavedState"]</span>
                </div>
            </Header>
            <Toolbar>
                <div class="es-editor-toolbar" role="group" aria-label="@Loc["TmEditorShellDemo_ToolbarLabel"]">
                    <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" OnClick="RecordUndo">@Loc["TmEditorShellDemo_ActionUndo"]</TmButton>
                    <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" OnClick="RecordRedo">@Loc["TmEditorShellDemo_ActionRedo"]</TmButton>
                    <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" OnClick="RecordPreview">@Loc["TmEditorShellDemo_ActionPreview"]</TmButton>
                    <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" OnClick="RecordValidate">@Loc["TmEditorShellDemo_ActionValidate"]</TmButton>
                </div>
            </Toolbar>
            <Left>@Toolbox("")</Left>
            <LeftRail>@ToolboxRail("")</LeftRail>
            <Canvas>@EmailCanvas("")</Canvas>
            <Right>@Properties("")</Right>
            <StatusBar>
                <span data-testid="es-status">@Loc["TmEditorShellDemo_StatusBar"]</span>
            </StatusBar>
        </TmEditorShell>
    </div>

    <div class="es-host-controls" role="group" aria-label="@Loc["TmEditorShellDemo_HostControls"]">
        <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" OnClick="TogglePanelsFromHost" data-testid="es-host-toggle-panels">@Loc["TmEditorShellDemo_HostTogglePanels"]</TmButton>
        <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" OnClick="TogglePresentation" data-testid="es-presentation-toggle">@(_presentation == MobilePanelPresentation.Tabs ? Loc["TmEditorShellDemo_PresentationSheet"] : Loc["TmEditorShellDemo_PresentationTabs"])</TmButton>
    </div>

    <section class="es-thresholds-section" data-testid="thresholds-section">
        <h2>@Loc["TmEditorShellDemo_ThresholdsTitle"]</h2>
        <p>@Loc["TmEditorShellDemo_ThresholdsIntro"]</p>
        <div class="es-shell-host es-shell-host--short" data-testid="editor-shell-thresholds-host">
            <TmEditorShell Breakpoints="_emailBreakpoints"
                           MobileActions="_mobileActions"
                           LeftTitle="@Loc["TmEditorShellDemo_Blocks"]"
                           RightTitle="@Loc["TmEditorShellDemo_Properties"]"
                           data-testid="editor-shell-thresholds">
                <Header>
                    <h2>@Loc["TmEditorShellDemo_EditorTitle"]</h2>
                </Header>
                <Toolbar>
                    <div class="es-editor-toolbar" role="group" aria-label="@Loc["TmEditorShellDemo_ToolbarLabel"]" data-testid="es-toolbar-thresholds">
                        <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" OnClick="RecordUndo">@Loc["TmEditorShellDemo_ActionUndo"]</TmButton>
                    </div>
                </Toolbar>
                <Left>@Toolbox("-thresholds")</Left>
                <LeftRail>@ToolboxRail("-thresholds")</LeftRail>
                <Canvas>@EmailCanvas("-thresholds")</Canvas>
                <Right>@Properties("-thresholds")</Right>
            </TmEditorShell>
        </div>
    </section>
    <section class="es-side-panel-section" data-testid="side-panel-section">
        <h2>@Loc["TmSidePanelDemo_Title"]</h2>
        <p>@Loc["TmSidePanelDemo_Intro"]</p>
        <div class="es-side-panel-host">
            <TmSidePanel Open="_inspectorOpen"
                         OpenChanged="OnInspectorOpenChanged"
                         Title="@Loc["TmSidePanelDemo_InspectorTitle"]"
                         Width="320px"
                         RestoreFocusTargetId="side-panel-toggle"
                         data-testid="side-panel">
                <HeaderActions>
                    <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" OnClick="RecordInspect">@Loc["TmSidePanelDemo_ActionInspect"]</TmButton>
                </HeaderActions>
                <ChildContent>
                    <p>@Loc["TmSidePanelDemo_InspectorBody"]</p>
                </ChildContent>
            </TmSidePanel>
            <div class="es-side-panel-host__content">
                <TmButton OnClick="ToggleInspector" aria-pressed="@InspectorPressed" id="side-panel-toggle" data-testid="side-panel-toggle">
                    @(_inspectorOpen ? Loc["TmSidePanelDemo_HideInspector"] : Loc["TmSidePanelDemo_ShowInspector"])
                </TmButton>
                <p class="es-last-action" data-testid="es-last-action">@Loc["TmEditorShellDemo_LastAction"]: @_lastAction</p>
            </div>
        </div>
    </section>
</div>

@code {
    private TmEditorShell? _shell;
    private ElementReference _title;

    /// <summary>The app-level viewport scope (MainLayout) — gates the forced-tablet preview off
    /// phone-sized viewports, where its modal side sheet would cover the mobile demos.</summary>
    [CascadingParameter(Name = TmLayoutScopes.Viewport)] public TmLayoutContext? Viewport { get; set; }

    private bool _leftOpen = true;
    private bool _rightOpen = true;
    private EditorShellPanel _collapsed;
    private EditorShellPanel _activePanel;
    private MobilePanelPresentation _presentation = MobilePanelPresentation.Sheet;
    private int _snap;
    private bool _inspectorOpen;
    private bool _inspectorTouched;
    private readonly TmLayoutBreakpoints _emailBreakpoints = new(768, 1200);
    private string _lastAction = "—";
    private string _buttonText = "Start now";
    private string _alignment = "center";

    private readonly (string Id, string Icon, string LabelKey)[] _blocks =
    [
        ("text", "type", "TmEditorShellDemo_BlockText"),
        ("image", "image", "TmEditorShellDemo_BlockImage"),
        ("button", "mouse-pointer", "TmEditorShellDemo_BlockButton"),
        ("divider", "minus", "TmEditorShellDemo_BlockDivider"),
        ("heading", "type", "TmEditorShellDemo_BlockHeading"),
        ("spacer", "minus", "TmEditorShellDemo_BlockSpacer"),
    ];

    private IReadOnlyList<SelectOption<string>> _alignOptions = [];

    private IReadOnlyList<TmActionItem> _mobileActions = [];

    private RenderFragment Toolbox(string scope) => @<div class="es-toolbox">
        <TmSearchInput Placeholder="@Loc["TmEditorShellDemo_SearchBlocks"]" data-testid="@($"es-block-search{scope}")" />
        <div class="es-toolbox__grid" data-testid="@($"es-block-grid{scope}")">
            @foreach (var block in _blocks)
            {
                <button type="button" class="es-block" data-block-id="@block.Id" @onclick="() => SelectBlock(block.Id)">
                    <TmIcon Name="@block.Icon" />
                    <span>@Loc[block.LabelKey]</span>
                </button>
            }
        </div>
    </div>;

    private RenderFragment ToolboxRail(string scope) => @<div class="es-rail-icons" data-testid="@($"es-rail-icons{scope}")">
        @foreach (var block in _blocks)
        {
            <button type="button" class="es-rail-icon tm-touch-target" data-block-id="@block.Id" aria-label="@Loc[block.LabelKey]" @onclick="() => SelectBlock(block.Id)">
                <TmIcon Name="@block.Icon" />
            </button>
        }
    </div>;

    private RenderFragment EmailCanvas(string scope) => @<div class="es-canvas" data-testid="@($"es-canvas{scope}")">
        <div class="es-canvas__card">
            <div class="es-canvas__logo">
                <TmIcon Name="zap" Size="IconSize.Lg" />
                <strong>@Loc["TmEditorShellDemo_Brand"]</strong>
            </div>
            <button type="button" class="es-canvas__hero es-canvas__hero--block" data-testid="@($"es-canvas-block{scope}")" @onclick="SelectCanvasBlock">
                <h3>@Loc["TmEditorShellDemo_CanvasHeading"]</h3>
                <p>@Loc["TmEditorShellDemo_CanvasBody"]</p>
                <span class="es-canvas__button">@Loc["TmEditorShellDemo_CanvasAction"]</span>
            </button>
            <p class="es-canvas__footer">@Loc["TmEditorShellDemo_CanvasFooter"]</p>
        </div>
    </div>;

    private RenderFragment Properties(string scope) => @<div class="es-props" data-testid="@($"es-properties{scope}")">
        <h3 class="es-props__heading">@Loc["TmEditorShellDemo_Properties"]</h3>
        <TmFormField Label="@Loc["TmEditorShellDemo_PropButtonText"]">
            <TmTextInput Value="@_buttonText" ValueChanged="OnButtonTextChanged" data-testid="@($"es-prop-input{scope}")" />
        </TmFormField>
        <TmFormField Label="@Loc["TmEditorShellDemo_PropAlignment"]">
            <TmSelect TValue="string" Value="@_alignment" ValueChanged="OnAlignmentChanged" Options="@_alignOptions" data-testid="@($"es-prop-align{scope}")" />
        </TmFormField>
    </div>;

    private string InspectorPressed => _inspectorOpen ? "true" : "false";

    // X14/X18: built per parameter set so a culture switch re-renders the labels; the
    // EventCallback receiver is this page, so its own markup re-renders when an action runs.
    protected override void OnParametersSet()
    {
        // The standalone inspector opens by itself only where it docks (a desktop viewport): below
        // desktop it would be a modal sheet that covers the demo, so it starts closed there.
        if (!_inspectorTouched) _inspectorOpen = Viewport is { IsDesktop: true };

        _alignOptions =
        [
            new SelectOption<string>("left", Loc["TmEditorShellDemo_AlignLeft"]),
            new SelectOption<string>("center", Loc["TmEditorShellDemo_AlignCenter"]),
            new SelectOption<string>("right", Loc["TmEditorShellDemo_AlignRight"]),
        ];
        _mobileActions =
        [
            new TmActionItem
            {
                Id = "undo",
                Label = Loc["TmEditorShellDemo_ActionUndo"],
                Icon = "rotate-ccw",
                Priority = 100,
                OnClick = EventCallback.Factory.Create(this, () => Record("TmEditorShellDemo_ActionUndo")),
            },
            new TmActionItem
            {
                Id = "redo",
                Label = Loc["TmEditorShellDemo_ActionRedo"],
                Icon = "rotate-cw",
                Priority = 90,
                OnClick = EventCallback.Factory.Create(this, () => Record("TmEditorShellDemo_ActionRedo")),
            },
            new TmActionItem
            {
                Id = "preview",
                Label = Loc["TmEditorShellDemo_ActionPreview"],
                Icon = "eye",
                Priority = 80,
                OnClick = EventCallback.Factory.Create(this, () => Record("TmEditorShellDemo_ActionPreview")),
            },
            new TmActionItem
            {
                Id = "validate",
                Label = Loc["TmEditorShellDemo_ActionValidate"],
                Icon = "check-circle",
                Priority = 70,
                OnClick = EventCallback.Factory.Create(this, () => Record("TmEditorShellDemo_ActionValidate")),
            },
            new TmActionItem
            {
                Id = "save",
                Label = Loc["TmEditorShellDemo_ActionSave"],
                Icon = "save",
                Priority = 60,
                OnClick = EventCallback.Factory.Create(this, SaveAsync),
            },
        ];
    }

    private Task RecordUndo() => Record("TmEditorShellDemo_ActionUndo");
    private Task RecordRedo() => Record("TmEditorShellDemo_ActionRedo");
    private Task RecordPreview() => Record("TmEditorShellDemo_ActionPreview");
    private Task RecordValidate() => Record("TmEditorShellDemo_ActionValidate");
    private Task RecordInspect() => Record("TmSidePanelDemo_ActionInspect");

    private Task Record(string key)
    {
        _lastAction = Loc[key];
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        _lastAction = Loc["TmEditorShellDemo_ActionSave"];
        // A focus-moving action: wins deterministically over any pending focus restore.
        try
        {
            await _title.FocusAsync(preventScroll: true);
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException)
        {
            // Best-effort only (the title may be off-screen on mobile).
        }
    }

    private void SelectBlock(string id)
    {
        // "Add block": on a phone the sheet drops to its half snap so the new block is visible.
        _lastAction = id;
        _snap = 0;
    }

    private void SelectCanvasBlock()
    {
        // A block selected on the canvas shows its properties: the sheet switches to the right tab.
        _lastAction = "button";
        _activePanel = EditorShellPanel.Right;
    }

    private void OnButtonTextChanged(string value)
    {
        _buttonText = value;
    }

    private void OnAlignmentChanged(string value)
    {
        _alignment = value;
    }

    // A host that opens/closes the panels itself (no gesture): the shell must not steal the focus
    // the host button keeps.
    private void TogglePanelsFromHost()
    {
        var open = _leftOpen || _rightOpen;
        _leftOpen = !open;
        _rightOpen = !open;
    }

    private void TogglePresentation()
    {
        _presentation = _presentation == MobilePanelPresentation.Tabs ? MobilePanelPresentation.Sheet : MobilePanelPresentation.Tabs;
        _activePanel = EditorShellPanel.None;
    }

    private void ToggleInspector()
    {
        _inspectorTouched = true;
        _inspectorOpen = !_inspectorOpen;
    }

    private void OnInspectorOpenChanged(bool open)
    {
        _inspectorTouched = true;
        _inspectorOpen = open;
    }
}
