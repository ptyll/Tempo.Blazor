@inject ITmLocalizer Loc
@inject Microsoft.JSInterop.IJSRuntime JS
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject DemoNotionDataProvider DataProvider
@inject DemoNotionAggregateProvider AggregateProvider
@inject MockNotionCommentProvider CommentProvider
@inject DemoNotionHistoryProvider HistoryProvider
@inject MockNotionMentionProvider MentionProvider
@inject MockNotionSearchProvider SearchProvider
@inject SignalRCollaborationProvider CollaborationProvider
@inject DemoNotionDatabaseProvider DatabaseProvider
@inject ApiWireframeDocumentProvider WireframeDocumentProvider
@inject ApiDiagramDocumentProvider DiagramDocumentProvider
@inject ApiSpreadsheetDocumentProvider SpreadsheetDocumentProvider
@inject Tempo.Blazor.DocumentLibrary.ITempoDocumentLibraryProvider LibraryProvider
@inject Tempo.Blazor.DocumentLibrary.ITempoDocumentChangeNotifier ChangeNotifier
@inject DemoNotionImportExportProvider ImportExportProvider
@inject DemoNotionMediaLibraryProvider MediaLibraryProvider
@inject DemoNotionFileProvider FileProvider
@inject DemoNotionTokenProvider TokenProvider
@inject DemoNotionAIProvider AIProvider
@inject DemoNotionTaskProvider TaskProvider
@inject DemoNotionReactionProvider ReactionProvider
@inject DemoNotionAnalyticsProvider AnalyticsProvider
@inject DemoNotionPagePropertiesProvider PagePropertiesProvider
@inject DemoNotionTemplateProvider TemplateProvider
@inject DemoNotionSpaceProvider SpaceProvider
@inject DemoNotionBlogProvider BlogProvider
@inject DemoNotionWatchProvider WatchProvider
@inject DemoNotionPermissionProvider PermissionProvider
@inject DemoNotionPublicShareProvider PublicShareProvider
@inject DemoNotionAuditProvider AuditProvider
@inject DemoSmartLinkProvider SmartLinkProvider
@inject Tempo.Blazor.Abstractions.WorkItems.TmWorkItemProviderRegistry WorkItemProviders

<PageTitle>Notion Editor – Tempo.Blazor</PageTitle>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Notion Editor</h1>
    <p class="text-slate-600 dark:text-slate-400">
        Block-based editor inspired by Notion with full keyboard support, collaborative features, and extensible block types.
    </p>
</div>

<!-- ═══ Interactive editor ═══════════════════════════════════════════════════ -->
<section class="demo-section mb-6">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
        <div>
            <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200">Interactive Editor</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                Block-based document editor with keyboard shortcuts, drag & drop, and formatting toolbar.
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <button class="px-3 py-1.5 text-sm rounded border border-slate-300 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300"
                    @onclick="RefreshData">
                Refresh
            </button>
            <span class="px-3 py-1.5 text-sm text-slate-500 dark:text-slate-400">
                Page: <strong>@(_currentPage?.Title ?? "Loading...")</strong>
            </span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="mb-3 px-4 py-2 rounded text-sm @(_statusIsError ? "bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-200" : "bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-200")">
            @_statusMessage
        </div>
    }

    @if (_isLoading)
    {
        <div class="flex items-center justify-center h-64 text-slate-500 dark:text-slate-400">
            <p>Loading editor...</p>
        </div>
    }
    else if (_currentPage != null)
    {
        <div style="height: 600px; border: 1px solid var(--tm-color-border); border-radius: var(--tm-radius-lg); overflow: hidden; background: var(--tm-bg-surface);">
            <TmNotionEditor @key="_editorRefreshKey"
                            DataProvider="@DataProvider"
                            AggregateProvider="@AggregateProvider"
                            CommentProvider="@(IsProviderDisabled("disableCommentProvider") ? null : CommentProvider)"
                            HistoryProvider="@HistoryProvider"
                            MentionProvider="@(IsProviderDisabled("disableMentionProvider") ? null : MentionProvider)"
                            SearchProvider="@SearchProvider"
                            CollaborationProvider="@CollaborationProvider"
                            DatabaseProvider="@(IsProviderDisabled("disableDatabaseProvider") ? null : DatabaseProvider)"
                            WireframeDocumentProvider="@WireframeDocumentProvider"
                            DiagramDocumentProvider="@DiagramDocumentProvider"
                            SpreadsheetDocumentProvider="@SpreadsheetDocumentProvider"
                            DocumentLibraryProvider="@LibraryProvider"
                            DocumentChangeNotifier="@ChangeNotifier"
                            ImportExportProvider="@(IsProviderDisabled("disableImportExportProvider") ? null : ImportExportProvider)"
                            MediaLibraryProvider="@MediaLibraryProvider"
                            FileProvider="@(IsProviderDisabled("disableFileProvider") ? null : FileProvider)"
                            TokenProvider="@TokenProvider"
                            AIProvider="@(IsProviderDisabled("disableAIProvider") ? null : AIProvider)"
                            WorkItemSource="@(IsProviderDisabled("disableTaskProvider") ? null : TaskProvider)"
                            WorkItemProviders="@(IsProviderDisabled("disableWorkItemProvider") ? null : WorkItemProviders)"
                            ReactionProvider="@(IsProviderDisabled("disableReactionProvider") ? null : ReactionProvider)"
                            AnalyticsProvider="@(IsProviderDisabled("disableAnalyticsProvider") ? null : AnalyticsProvider)"
                            BlogProvider="@(IsProviderDisabled("disableBlogProvider") ? null : BlogProvider)"
                            WatchProvider="@(IsProviderDisabled("disableWatchProvider") ? null : WatchProvider)"
                            AuthorizationProvider="@(IsProviderDisabled("disablePermissionProvider") ? null : PermissionProvider)"
                            PermissionProvider="@(IsProviderDisabled("disablePermissionProvider") ? null : PermissionProvider)"
                            PublicShareProvider="@(IsProviderDisabled("disablePublicShareProvider") ? null : PublicShareProvider)"
                            AuditProvider="@(IsProviderDisabled("disableAuditProvider") ? null : AuditProvider)"
                            SmartLinkProvider="@(IsProviderDisabled("disableSmartLinkProvider") ? null : SmartLinkProvider)"
                            SpaceProvider="@(IsProviderDisabled("disableSpaceProvider") ? null : SpaceProvider)"
                            PagePropertiesProvider="@PagePropertiesProvider"
                            TemplateProvider="@(IsProviderDisabled("disableTemplateProvider") ? null : TemplateProvider)"
                            CurrentUserId="@CurrentUserId"
                            CurrentUserGroupIds="@CurrentUserGroupIds"
                            ReadOnly="@IsQueryFlagEnabled("readonly")"
                            InitialPageId="@_currentPage.Id.ToString()"
                            ShowSidebar="true"
                            OnCreateTokenRequested="@CreateTokenAsync"
                            Class="h-full" />
        </div>

        <div class="mt-3 flex gap-4 text-sm text-slate-500 dark:text-slate-400">
            <span>Page ID: <strong class="text-slate-700 dark:text-slate-300">@_currentPage.Id</strong></span>
            <span>Title: <strong class="text-slate-700 dark:text-slate-300">@_currentPage.Title</strong></span>
            <span>Last Updated: <strong class="text-slate-700 dark:text-slate-300">@_currentPage.LastEditedAt:g</strong></span>
        </div>
    }
</section>

<!-- ═══ Single page (work item description) ═══════════════════════════════════ -->
<section class="demo-section mb-6" data-testid="notion-single-page-demo">
    <div class="mb-3">
        <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200">Single page (work item description)</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
            <code>SinglePageMode="true"</code> turns the editor into a self-contained field: no sidebar, no navigation,
            no tasks/blog/analytics panels. Combined with an <code>AllowedBlockTypes</code> whitelist it becomes a rich-text
            description surface — multi-page blocks (child pages, linked pages/databases, breadcrumbs) are removed from the
            slash menu. Following a link raises <code>OnPageNavigationRequested</code> so the host decides where it opens.
        </p>
    </div>

    @if (_singlePageNavMessage is not null)
    {
        <div class="mb-3 px-4 py-2 rounded text-sm bg-amber-100 text-amber-900 dark:bg-amber-900/30 dark:text-amber-200"
             data-testid="notion-single-page-nav-message">
            @_singlePageNavMessage
        </div>
    }

    @if (_currentPage != null)
    {
        <div style="height: 420px; border: 1px solid var(--tm-color-border); border-radius: var(--tm-radius-lg); overflow: hidden; background: var(--tm-bg-surface);">
            @if (_singlePageEditorLoaded)
            {
                <TmNotionEditor DataProvider="@DataProvider"
                                AggregateProvider="@AggregateProvider"
                                MentionProvider="@MentionProvider"
                                FileProvider="@FileProvider"
                                TokenProvider="@TokenProvider"
                                AllowedBlockTypes="@_singlePageAllowedBlocks"
                                SinglePageMode="true"
                                InitialPageId="@_currentPage.Id.ToString()"
                                OnPageNavigationRequested="@HandleSinglePageNavigationRequested"
                                Class="h-full" />
            }
            else
            {
                @* Mounted on demand: a second live editor on the same page shares block ids and global
                   notion-editor.js handlers (document.querySelector + capture-phase keydown) with the
                   full editor above, so eager-mounting it breaks every page-wide locator on this page. *@
                <div class="h-full flex flex-col items-center justify-center gap-3 text-slate-500 dark:text-slate-400">
                    <p class="text-sm">The single-page editor is mounted on demand.</p>
                    <button type="button"
                            class="px-4 py-2 rounded-lg text-sm font-medium bg-primary-600 hover:bg-primary-700 text-white transition-colors"
                            data-testid="notion-single-page-load"
                            @onclick="() => _singlePageEditorLoaded = true">
                        Load single-page editor
                    </button>
                </div>
            }
        </div>
        <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
            Allowed blocks: paragraph, headings, lists, to-dos, quote, callout, code, divider, image, table.
        </p>
    }
</section>

