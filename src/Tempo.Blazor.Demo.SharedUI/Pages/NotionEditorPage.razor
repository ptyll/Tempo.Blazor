@code {
    // ── Undo / redo cheatsheet ───────────────────────────────────────────────

    private static readonly (string Keys, string Result)[] UndoBehaviours =
    [
        ("Ctrl+Z",       "Undo the last structural edit"),
        ("Ctrl+Y",       "Redo it"),
        ("Ctrl+Shift+Z", "Redo it"),
        ("Ctrl+Z while typing", "The browser undoes the last characters instead")
    ];

    // ── Structured paste cheatsheet ──────────────────────────────────────────

    private static readonly (string Clipboard, string Result)[] PasteBehaviours =
    [
        ("<h1>…</h1><p>…</p>",     "Heading block + paragraph block"),
        ("<ul><li>…</li>…</ul>",   "One bulleted-list block per item"),
        ("<table>…</table>",       "Table block with child TableRow blocks"),
        ("<pre><code>…</code></pre>", "Code block"),
        ("<strong>…</strong>",     "Pasted inline into the current block"),
        ("<p>one sentence</p>",    "Pasted inline into the current block")
    ];

    // ── Live markdown shortcut cheatsheet ────────────────────────────────────

    private static readonly (string Trigger, string Result)[] MarkdownShortcuts =
    [
        ("# ",      "Heading 1"),
        ("## ",     "Heading 2"),
        ("### ",    "Heading 3"),
        ("- ",      "Bulleted list (also * and +)"),
        ("1. ",     "Numbered list (any number works)"),
        ("[ ] ",    "To-do (also - [ ] )"),
        ("[x] ",    "Checked to-do (also - [x] )"),
        ("> ",      "Quote"),
        ("**bold**", "Bold"),
        ("~~text~~", "Strikethrough"),
        ("`code`",  "Inline code")
    ];

    // ── Markdown table demo ──────────────────────────────────────────────────

    private const string DefaultTableMarkdown = """
        Plain | Left | Center | Right
        --- | :--- | :---: | ---:
        a | b | c | d
        e | f | g | h
        """;

    private string _tableMarkdownField = DefaultTableMarkdown;

    private string _tableMarkdown
    {
        get => _tableMarkdownField;
        set
        {
            if (_tableMarkdownField == value) return;
            _tableMarkdownField = value;
            RefreshTableDemo();
        }
    }

    private int _tableBlockCount;
    private int _tableRowCount;
    private int _tableColumnCount;
    private string _tableAlignments = "";
    private MarkupString _tablePreviewHtml;
    private string _tableRoundTripMarkdown = "";

    private void RefreshTableDemo()
    {
        var blocks = NotionMarkdownImporter.Import(_tableMarkdownField, Guid.Empty);

        var table = blocks.FirstOrDefault(block => block.Type == BlockType.Table);
        var content = table?.Content as ITableBlockContent;

        _tableBlockCount = blocks.Count(block => block.Type == BlockType.Table);
        _tableRowCount = blocks.Count(block => block.Type == BlockType.TableRow && block.ParentBlockId is not null);
        _tableColumnCount = content?.ColumnCount ?? 0;
        _tableAlignments = content is null || content.ColumnAlignments.Count == 0
            ? "—"
            : string.Join(", ", content.ColumnAlignments);

        _tablePreviewHtml = new MarkupString(NotionHtmlExporter.Export(blocks));
        _tableRoundTripMarkdown = NotionMarkdownExporter.Export(blocks).TrimEnd();
    }

    private INotionPage? _currentPage;
    private string _statusMessage = "";
    private bool _statusIsError = false;
    private bool _isLoading = true;
    private int _editorRefreshKey;

    // ── Single-page mode demo ────────────────────────────────────────────────

    private string? _singlePageNavMessage;
    private bool _singlePageEditorLoaded;

    private static readonly IReadOnlySet<BlockType> _singlePageAllowedBlocks = new HashSet<BlockType>
    {
        BlockType.Paragraph,
        BlockType.Heading1,
        BlockType.Heading2,
        BlockType.Heading3,
        BlockType.BulletList,
        BlockType.NumberedList,
        BlockType.TodoItem,
        BlockType.Quote,
        BlockType.Callout,
        BlockType.Code,
        BlockType.Divider,
        BlockType.Image,
        BlockType.Table
    };

    private void HandleSinglePageNavigationRequested(string pageId)
        => _singlePageNavMessage = $"Host asked to open page '{pageId}' elsewhere (single-page editor stays put).";

    private static readonly string[] E2ESeedMethods =
    [
        "seedActionItemsPage",
        "seedAtomicTablePage",
        "seedAnalyticsPage",
        "seedAuditPage",
        "seedBlogPage",
        "seedBulkPages",
        "seedChildrenDisplayPage",
        "seedCollaborationPage",
        "seedCommentlessPage",
        "seedCommentsPage",
        "seedContentByLabelPage",
        "seedDragDropPage",
        "seedEmptyAnalyticsPage",
        "seedEmptyAuditPage",
        "seedEmptyBlogPage",
        "seedEmptyPage",
        "seedEmptyPageInfoPage",
        "seedEmptyTasksPage",
        "seedEmptyTocPage",
        "seedExcerptPage",
        "seedExpiredPublicSharePage",
        "seedExportPage",
        "seedHistoryDiffPage",
        "seedHistoryEmptyPage",
        "seedHistoryManyPage",
        "seedIncludePagePage",
        "seedInlineToolbarPage",
        "seedKrFidelityPage",
        "seedLabelsPage",
        "seedLayoutPage",
        "seedListTodoPage",
        "seedManyAuditEntriesPage",
        "seedManyBlogPostsPage",
        "seedManySpacesPage",
        "seedManyTasksPage",
        "seedMediaPage",
        "seedMentionTokenPage",
        "seedPageInfoPage",
        "seedPagePropertiesPage",
        "seedPageReactionsEmptyPage",
        "seedPageReactionsManyPage",
        "seedPageSettingsPage",
        "seedPublicSharePage",
        "seedRestrictionsPage",
        "seedRichPage",
        "seedSearchPage",
        "seedSidebarDeepPage",
        "seedSidebarEmptyPage",
        "seedSidebarTrashPage",
        "seedSmartLinksPage",
        "seedSpacesPage",
        "seedSpecialBlocksPage",
        "seedTablePage",
        "seedTasksPage",
        "seedTextFormattingPage",
        "seedWatchPage",
        "seedWorkItemsPage",
        "showCollaborationLongNames",
        "showCollaborationManyCursors",
        "showCollaborationNoUsers",
        "showCollaborationOneCursor",
        "showCollaborationOverlappingCursors"
    ];

    protected override async Task OnInitializedAsync()
    {
        ConfigureAIProvider();
        RefreshTableDemo();
        await LoadEditorDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var apiBase = HttpClientFactory.CreateClient("DemoApi").BaseAddress?.ToString().TrimEnd('/');
        if (string.IsNullOrWhiteSpace(apiBase))
        {
            return;
        }

        var apiBaseJson = System.Text.Json.JsonSerializer.Serialize(apiBase);
        var methodsJson = System.Text.Json.JsonSerializer.Serialize(E2ESeedMethods);
        var script = $$"""
            (() => {
                const apiBase = {{apiBaseJson}};
                const methods = {{methodsJson}};
                const seed = async (scenario) => {
                    const response = await fetch(`${apiBase}/api/notion/e2e/seed/${encodeURIComponent(scenario)}`, {
                        method: 'POST'
                    });
                    if (!response.ok) {
                        throw new Error(`Notion E2E seed '${scenario}' failed with ${response.status}`);
                    }
                    window.setTimeout(() => window.location.reload(), 0);
                    return true;
                };
                window.tmNotionDemo = window.tmNotionDemo || {};
                for (const method of methods) {
                    window.tmNotionDemo[method] = () => seed(method);
                }
            })();
            """;

        await JS.InvokeVoidAsync("eval", script);
    }

    private async Task LoadEditorDataAsync()
    {
        try
        {
            ConfigureAIProvider();
            _isLoading     = true;
            _statusMessage = "";
            _currentPage   = await DataProvider.GetPageAsync("11111111-1111-1111-1111-111111111111");
            _editorRefreshKey++;
            _statusMessage = "Editor loaded successfully";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error: {ex.Message}";
            _statusIsError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshData() => await LoadEditorDataAsync();

    private void ConfigureAIProvider()
    {
        AIProvider.SlowResponses = IsProviderDisabled("slowAIProvider");
        AIProvider.FailRequests = IsProviderDisabled("failAIProvider");
    }

    private bool IsProviderDisabled(string key)
    {
        var query = new Uri(Navigation.Uri).Query;
        if (string.IsNullOrWhiteSpace(query))
        {
            return false;
        }

        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var pieces = part.Split('=', 2);
            var name = Uri.UnescapeDataString(pieces[0]);
            if (!string.Equals(name, key, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            if (pieces.Length == 1)
            {
                return true;
            }

            var value = Uri.UnescapeDataString(pieces[1]);
            return string.IsNullOrWhiteSpace(value) || bool.TryParse(value, out var parsed) && parsed;
        }

        return false;
    }

    private bool IsQueryFlagEnabled(string key)
        => GetQueryValue(key) is { } value &&
           (string.IsNullOrWhiteSpace(value) || bool.TryParse(value, out var parsed) && parsed);

    private string CurrentUserId => GetQueryValue("user") switch
    {
        { Length: > 0 } user => user,
        _ => "demo"
    };

    private IReadOnlyList<string> CurrentUserGroupIds => GetQueryValue("groups") switch
    {
        { Length: > 0 } groups => groups.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
        _ => []
    };

    private string? GetQueryValue(string key)
    {
        var query = new Uri(Navigation.Uri).Query;
        if (string.IsNullOrWhiteSpace(query))
        {
            return null;
        }

        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var pieces = part.Split('=', 2);
            var name = Uri.UnescapeDataString(pieces[0]);
            if (!string.Equals(name, key, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            return pieces.Length == 1 ? string.Empty : Uri.UnescapeDataString(pieces[1]);
        }

        return null;
    }

    private async Task<(string Key, string DisplayName, string? ColorClass)?> CreateTokenAsync(string query)
    {
        var name = await JS.InvokeAsync<string?>("prompt", "New token name:", query);
        if (string.IsNullOrWhiteSpace(name)) return null;
        var key = TokenProvider.AddToken(name.Trim());
        return (key, name.Trim(), null);
    }
}
