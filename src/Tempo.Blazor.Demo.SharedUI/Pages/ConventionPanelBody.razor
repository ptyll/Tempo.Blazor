@using Tempo.Blazor.Abstractions.Layout
@inject ITmLocalizer Loc

<div class="rc-panel" data-layout="@Layout?.CssModifier">
    <div class="rc-tiles">
        <article class="rc-tile rc-tile--wide">
            <h3>@Loc["TmResponsiveDemo_Revenue"]</h3>
            <p class="rc-value">128 400</p>
            <p class="rc-hint">@Loc["TmResponsiveDemo_WideHint"]</p>
        </article>
        <article class="rc-tile">
            <h3>@Loc["TmResponsiveDemo_Orders"]</h3>
            <p class="rc-value">1 024</p>
        </article>
        <article class="rc-tile">
            <h3>@Loc["TmResponsiveDemo_Returns"]</h3>
            <p class="rc-value">18</p>
        </article>
    </div>

    <div class="rc-actions">
        <button type="button" class="tm-btn tm-btn-primary tm-btn-icon" aria-label="@Loc["TmResponsiveDemo_Add"]">
            <span aria-hidden="true">+</span>
        </button>
        <span class="tm-reveal-on-hover rc-hover-action">
            <button type="button" class="tm-btn tm-btn-secondary tm-btn-sm">@Loc["TmResponsiveDemo_Details"]</button>
        </span>
        <span class="rc-mode" data-testid="rc-mode">@Layout?.CssModifier</span>
    </div>
</div>

@code {
    [CascadingParameter] private TmLayoutContext? Layout { get; set; }
}
