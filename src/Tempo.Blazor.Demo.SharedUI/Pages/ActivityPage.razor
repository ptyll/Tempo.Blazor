@page "/activity"
@using Tempo.Blazor.Abstractions.Shared
@inject ITmLocalizer Loc
<PageTitle>Activity – Tempo.Blazor</PageTitle>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Activity Components</h1>
    <p class="text-slate-600 dark:text-slate-400">
        Complete activity tracking system with timeline, comments, and attachments.
        Data loaded from Demo.Api (<code>task-1</code>).
    </p>
</div>

<!-- API Error -->
@if (_loadError is not null)
{
    <div class="mb-6 p-4 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-xl">
        <div class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-amber-600 dark:text-amber-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <div>
                <p class="text-sm font-medium text-amber-800 dark:text-amber-200">Connection Error</p>
                <p class="text-sm text-amber-600 dark:text-amber-400 mt-1">@_loadError</p>
            </div>
        </div>
    </div>
}

<!-- Activity Log -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Activity Log</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">Full Panel</span>
    </div>
    
    <div class="max-w-3xl">
        <TmActivityLog EntityId="task-1"
                       TimelineEntries="@_timelineEntries"
                       Comments="@_comments"
                       Attachments="@_attachments"
                       AttachmentProvider="@_attachmentProvider"
                       FileProvider="@_fileProvider"
                       OnCommentAdded="@AddComment"
                       OnCommentDeleted="@DeleteComment" />
    </div>
</section>

<!-- Activity Comments (standalone + draft guard) -->
<section id="activity-comments" class="demo-section" data-testid="activity-comments-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Activity Comments</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-rose-100 dark:bg-rose-900/30 text-rose-700 dark:text-rose-300 rounded-full">Standalone · Draft guard</span>
    </div>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        Standalone comment thread with live draft tracking (local data, no API needed).
        The panel below mirrors what a host page sees through <code>OnDraftChanged</code> —
        the flags a dirty-guard needs before a refresh or retry throws an in-progress comment away.
        "Discard draft" demonstrates the consumer path once the user confirmed the discard
        (<code>DiscardDraftAsync</code> via <code>@@ref</code>; the component itself never asks).
        Each comment also carries a host action (Unlock when internal, Lock when public, with a
        short visible label) that asks in a dialog before flipping internal / public — the
        component only paints the result. Making a comment public is the dangerous confirm.
        The composer offers mentions (<code>@@</code> opens people from a local provider) and an
        Internal switch. Posting with the switch on marks the new comment internal; the component
        still shows it.
    </p>

    <div class="max-w-3xl">
        <div id="activity-comments-draft-state-panel"
             class="mb-4 p-3 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm text-slate-700 dark:text-slate-300"
             data-testid="activity-comments-draft-state"
             role="status" aria-live="polite">
            <span class="font-medium">Draft state:</span>
            <span class="sr-only">@DraftStateSummary</span>
            <span class="ml-2 font-mono" aria-hidden="true">editor-open=<span data-testid="activity-comments-draft-open">@FormatDraftFlag(_draftState.IsEditorOpen)</span></span>
            <span class="ml-3 font-mono" aria-hidden="true">editing=<span data-testid="activity-comments-draft-editing">@(_draftState.EditingCommentId ?? "none")</span></span>
            <span class="ml-3 font-mono" aria-hidden="true">unsaved=<span data-testid="activity-comments-draft-unsaved">@FormatDraftFlag(_draftState.HasUnsavedContent)</span></span>
            <span class="ml-3 font-mono" aria-hidden="true">internal=<span data-testid="activity-comments-draft-internal">@FormatDraftFlag(_draftState.IsInternal)</span></span>
        </div>

        <div class="mb-4">
            <TmButton Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Sm"
                      Disabled="@(!_draftState.IsEditorOpen)"
                      OnClick="DiscardStandaloneDraft"
                      aria-describedby="activity-comments-draft-state-panel"
                      data-testid="activity-comments-discard-draft">
                Discard draft
            </TmButton>
        </div>

        <div class="showcase-card">
            <TmActivityComments @ref="_commentsComponent"
                                Comments="@_standaloneComments"
                                SupportsMentions="true"
                                MentionProvider="@_mentionProvider"
                                ShowInternalToggle="true"
                                OnCommentAdded="@AddStandaloneComment"
                                OnCommentSubmitted="@AddStandaloneSubmission"
                                OnCommentEdited="@EditStandaloneComment"
                                OnCommentDeleted="@DeleteStandaloneComment"
                                OnDraftChanged="@HandleDraftChanged"
                                CommentActions="@CommentVisibilityAction" />
        </div>
    </div>
</section>

<!-- Activity Timeline -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Activity Timeline</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full">Standalone</span>
    </div>
    
    <div class="max-w-2xl showcase-card">
        <TmActivityTimeline Entries="@_timelineEntries" />
    </div>
</section>

<!-- Filtering & Pagination (audit-scale) -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Timeline Filtering &amp; Pagination</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-full">K10 · Audit-scale</span>
    </div>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        @_auditEntries.Count synthetic audit entries. The built-in search + type filter narrows the list;
        "Load more" reveals another page. Additive params only — existing consumers pass none of these and behave unchanged.
    </p>

    <div class="grid gap-6 lg:grid-cols-2">
        <!-- Activity Log timeline tab: client-side filter + pagination -->
        <div>
            <p class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-2">TmActivityLog (client-side)</p>
            <div class="showcase-card">
                <TmActivityLog EntityId="audit-1"
                               ShowComments="false"
                               ShowAttachments="false"
                               TimelineEntries="@_auditEntries"
                               ShowTimelineFilterBar="true"
                               TimelinePageSize="10" />
            </div>
        </div>

        <!-- Standalone TmTimeline driven by an async data provider -->
        <div>
            <p class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-2">TmTimeline + ITimelineDataProvider</p>
            <div class="showcase-card">
                <TmTimeline DataProvider="@_auditProvider"
                            ShowInternal="true"
                            ShowFilterBar="true"
                            EntryTypeFilterOptions="@_auditTypes"
                            PageSize="8" />
            </div>
        </div>
    </div>
</section>

<!-- Rich Text Editor Simple -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Rich Text Editor Simple</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full">Basic</span>
    </div>
    
    <div class="max-w-2xl">
        <div class="showcase-card">
            <TmRichEditorSimple Value="@_simpleEditorValue"
                                ValueChanged="@(v => _simpleEditorValue = v)"
                                Placeholder="Type something with **bold**, _italic_, or lists..."
                                MaxLength="500"
                                OnSubmit="@HandleSimpleSubmit" />
            
            @if (!string.IsNullOrEmpty(_simpleEditorValue))
            {
                <div class="mt-4 pt-4 border-t border-slate-200 dark:border-slate-700">
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-2">Raw HTML Output</p>
                    <pre class="text-xs bg-slate-50 dark:bg-slate-900 p-3 rounded-lg overflow-x-auto"><code>@_simpleEditorValue</code></pre>
                </div>
            }
        </div>
    </div>
</section>

<!-- Rich Text Editor Full -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Rich Text Editor Full</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full">Advanced</span>
    </div>
    
    <div class="max-w-3xl">
        <div class="showcase-card">
            <TmRichEditorFull Value="@_fullEditorValue"
                              ValueChanged="@(v => _fullEditorValue = v)"
                              Placeholder="Create rich content with headings, lists, and links..."
                              Height="300px"
                              MaxLength="2000"
                              SupportsMentions="true"
                              MentionProvider="@_mentionProvider" />
            
            @if (!string.IsNullOrEmpty(_fullEditorValue))
            {
                <div class="mt-4 pt-4 border-t border-slate-200 dark:border-slate-700">
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-2">Raw HTML Output</p>
                    <pre class="text-xs bg-slate-50 dark:bg-slate-900 p-3 rounded-lg overflow-x-auto"><code>@_fullEditorValue</code></pre>
                </div>
            }
        </div>
    </div>
</section>

<!-- Legacy Rich Text Editor (for comparison) -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Rich Text Editor (Full)</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-full">New</span>
    </div>
    
    <div class="max-w-2xl">
        <div class="showcase-card">
            <TmRichEditorFull @bind-Value="_editorValue"
                              Placeholder="Type something with formatting, tables, colors..." />
            
            @if (!string.IsNullOrEmpty(_editorValue))
            {
                <div class="mt-4 pt-4 border-t border-slate-200 dark:border-slate-700">
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-2">Raw HTML Output</p>
                    <pre class="text-xs bg-slate-50 dark:bg-slate-900 p-3 rounded-lg overflow-x-auto"><code>@_editorValue</code></pre>
                </div>
            }
        </div>
    </div>
</section>

<TmDialog Show="_showVisibilityDialog"
          Type="DialogType.Confirm"
          Variant="DialogVariant.Warning"
          IsDangerous="@VisibilityIsDangerous"
          Title="@VisibilityDialogTitle"
          Message="@VisibilityDialogMessage"
          OkButtonText="@Loc["TmDemo_ActivityComments_ToggleConfirm"]"
          OnResult="HandleVisibilityResult"
          data-testid="activity-comments-visibility-dialog" />

@code {
    [Inject] private ActivityHttpService ActivityService { get; set; } = default!;
    [Inject] private AttachmentHttpProvider AttachmentProvider { get; set; } = default!;

    private const string EntityId = "task-1";
    private string _editorValue = string.Empty;
    private string _simpleEditorValue = string.Empty;
    private string _fullEditorValue = string.Empty;
    private string? _loadError;
    private ITmPeopleProvider? _mentionProvider;

    private IReadOnlyList<ITimelineEntry> _timelineEntries = [];
    private IReadOnlyList<TmCommentEntry> _comments = [];
    private IReadOnlyList<TmAttachment> _attachments = [];
    private ITmAttachmentProvider _attachmentProvider = default!;
    private ITmFileProvider _fileProvider = default!;

    // K10 – synthetic audit-scale data for the filtering + pagination demo.
    private static readonly string[] _auditTypes = ["comment", "status_change", "assignment", "attachment", "system"];
    private static readonly IReadOnlyList<ITimelineEntry> _auditEntries = BuildAuditEntries(120);
    private readonly ITimelineDataProvider _auditProvider = new InMemoryTimelineDataProvider(_auditEntries);

    private static IReadOnlyList<ITimelineEntry> BuildAuditEntries(int count)
    {
        string[] authors = ["Alice Nguyen", "Bob Carter", "Carol Diaz", "Dan Ellis", "Erin Frost"];
        string[] verbs = ["updated the status", "assigned the task", "left a comment", "uploaded a file", "closed the item", "reopened the item"];
        var now = DateTimeOffset.Now;
        var list = new List<ITimelineEntry>(count);
        for (var i = 0; i < count; i++)
        {
            list.Add(new DemoAuditEntry(
                Id: $"audit-{i}",
                EntryType: _auditTypes[i % _auditTypes.Length],
                AuthorName: authors[i % authors.Length],
                AuthorAvatarUrl: null,
                CreatedAt: now.AddMinutes(-i * 7),
                HtmlContent: null,
                PlainContent: $"{authors[i % authors.Length]} {verbs[i % verbs.Length]} (#{count - i}).",
                IsInternal: i % 9 == 0));
        }
        return list;
    }

    private sealed record DemoAuditEntry(
        string Id,
        string EntryType,
        string AuthorName,
        string? AuthorAvatarUrl,
        DateTimeOffset CreatedAt,
        string? HtmlContent,
        string? PlainContent,
        bool IsInternal,
        IReadOnlyDictionary<string, string>? Metadata = null) : ITimelineEntry;

    // Activity Comments standalone demo — local data on purpose, so the draft-guard
    // demonstration works even when Demo.Api is not running.
    private List<TmCommentEntry> _standaloneComments = BuildStandaloneComments();
    private TmCommentDraftState _draftState = new(false, null, false);
    private TmActivityComments? _commentsComponent;
    private int _standaloneCommentSeq = 4;
    private const string DemoCurrentUserId = "demo-user-you";

    private static List<TmCommentEntry> BuildStandaloneComments() =>
    [
        new TmCommentEntry
        {
            Id = "demo-c1",
            ThreadId = "demo-comments",
            Author = new TmUserRef { Id = "alice", DisplayName = "Alice Nguyen" },
            Body = "Confirmed the outage window with the provider — <strong>22:00–23:30 UTC</strong>.",
            BodyFormat = TmCommentBodyFormat.Html,
            CreatedAt = DateTimeOffset.Now.AddHours(-3),
            EditedAt = DateTimeOffset.Now.AddHours(-2),
            IsInternal = true,
            Badges =
            [
                new TmCommentBadge { Text = "Admin only", Tone = TmCommentBadgeTone.Info, Icon = IconNames.Info, Title = "Visible to administrators" }
            ],
            CanEdit = true,
            CanDelete = true
        },
        new TmCommentEntry
        {
            Id = "demo-c2",
            ThreadId = "demo-comments",
            Author = new TmUserRef { Id = "bob", DisplayName = "Bob Carter" },
            Body = "Status page updated and subscribers notified at 21:45.",
            CreatedAt = DateTimeOffset.Now.AddMinutes(-90),
            Badges =
            [
                new TmCommentBadge
                {
                    Text = "Waiting on the external vendor's change-advisory board before the maintenance window can be confirmed",
                    Tone = TmCommentBadgeTone.Info,
                    Title = "Long badge text wraps instead of overflowing the thread"
                },
                new TmCommentBadge { Text = "Status", Tone = TmCommentBadgeTone.Success },
                new TmCommentBadge { Text = "Pinned", Tone = TmCommentBadgeTone.Accent },
                new TmCommentBadge { Text = "Note", Tone = TmCommentBadgeTone.Neutral },
                new TmCommentBadge { Text = "Review", Tone = TmCommentBadgeTone.Warning },
                new TmCommentBadge { Text = "Blocked", Tone = TmCommentBadgeTone.Danger }
            ],
            CanEdit = false,
            CanDelete = true
        },
        new TmCommentEntry
        {
            Id = "demo-c3",
            ThreadId = "demo-comments",
            Author = new TmUserRef { Id = "carol", DisplayName = "Carol Diaz" },
            Body = "Read-only viewer — this comment exposes no edit or delete action and no badges.",
            CreatedAt = DateTimeOffset.Now.AddMinutes(-30)
        }
    ];

    /// <summary>Plain-language summary for screen readers; mirrors the machine flags hidden next to it.</summary>
    private string DraftStateSummary => _draftState switch
    {
        { HasUnsavedContent: true } => "Unsaved comment draft present.",
        { IsEditorOpen: true } => "Comment editor open, no unsaved changes.",
        _ => "No comment draft."
    };

    private static string FormatDraftFlag(bool value) => value ? "yes" : "no";

    private Task HandleDraftChanged(TmCommentDraftState state)
    {
        _draftState = state;
        return Task.CompletedTask;
    }

    private Task DiscardStandaloneDraft()
    {
        // Consumer flow after the user confirmed the discard in the host's own dialog:
        // the demo skips the dialog and discards straight away (no-op when nothing is open).
        return _commentsComponent?.DiscardDraftAsync() ?? Task.CompletedTask;
    }

    private bool? _pendingSubmissionInternal;

    /// <summary>
    /// Fires before <see cref="AddStandaloneComment"/> (document order). Remembers the internal
    /// flag so the HTML callback can stamp the new entry; the component does not hide it.
    /// </summary>
    private Task AddStandaloneSubmission(TmCommentSubmission submission)
    {
        _pendingSubmissionInternal = submission.IsInternal;
        return Task.CompletedTask;
    }

    private Task AddStandaloneComment(string html)
    {
        _standaloneComments.Add(new TmCommentEntry
        {
            Id = $"demo-c{_standaloneCommentSeq++}",
            ThreadId = "demo-comments",
            Author = new TmUserRef { Id = DemoCurrentUserId, DisplayName = "You (demo viewer)" },
            Body = html,
            BodyFormat = TmCommentBodyFormat.Html,
            CreatedAt = DateTimeOffset.Now,
            IsInternal = _pendingSubmissionInternal == true,
            CanEdit = true,
            CanDelete = true
        });
        _pendingSubmissionInternal = null;
        return Task.CompletedTask;
    }

    private Task EditStandaloneComment((string Id, string Html) edited)
    {
        var comment = _standaloneComments.FirstOrDefault(c => c.Id == edited.Id);
        if (comment is not null)
        {
            comment.Body = edited.Html;
            comment.BodyFormat = TmCommentBodyFormat.Html;
            comment.EditedAt = DateTimeOffset.Now;
        }
        return Task.CompletedTask;
    }

    private string? _pendingVisibilityCommentId;
    private bool _showVisibilityDialog;

    private string VisibilityDialogTitle
        => PendingComment()?.IsInternal == true
            ? Loc["TmDemo_ActivityComments_ToggleTitleInternal"]
            : Loc["TmDemo_ActivityComments_ToggleTitlePublic"];

    private string VisibilityDialogMessage
        => PendingComment()?.IsInternal == true
            ? Loc["TmDemo_ActivityComments_ToggleMessageInternal"]
            : Loc["TmDemo_ActivityComments_ToggleMessagePublic"];

    // Making a comment public is the irreversible step (notifications already sent cannot be
    // recalled, and everyone who opens the thread will see it). Marking one internal is not.
    private bool VisibilityIsDangerous => PendingComment()?.IsInternal == true;

    private TmCommentEntry? PendingComment()
        => _pendingVisibilityCommentId is null
            ? null
            : _standaloneComments.FirstOrDefault(c => c.Id == _pendingVisibilityCommentId);

    /// <summary>
    /// Host-owned action. The component renders the fragment and does not know what it does;
    /// the dialog and the visibility flip live here.
    /// </summary>
    private RenderFragment<TmCommentEntry> CommentVisibilityAction => comment => __builder =>
    {
        var label = comment.IsInternal
            ? Loc["TmDemo_ActivityComments_MakePublic"]
            : Loc["TmDemo_ActivityComments_MakeInternal"];
        // Unlock = the comment is internal and the action makes it public; Lock = it is public
        // and the action makes it internal. Same link style as Edit/Delete, with a short visible label.
        <button type="button"
                class="tm-link-button"
                title="@label"
                aria-label="@label"
                data-testid="@($"activity-comments-toggle-{comment.Id}")"
                @onclick="@(() => AskToggleVisibility(comment))">
            <TmIcon Name="@(comment.IsInternal ? IconNames.Unlock : IconNames.Lock)" Size="IconSize.Xs" />
            <span>@label</span>
        </button>
    };

    private void AskToggleVisibility(TmCommentEntry comment)
    {
        _pendingVisibilityCommentId = comment.Id;
        _showVisibilityDialog = true;
    }

    private Task HandleVisibilityResult(bool? confirmed)
    {
        if (confirmed == true)
        {
            // No-op when the comment was deleted while the dialog was open: the id no longer
            // resolves, so nothing is flipped and the dialog just closes.
            var comment = PendingComment();
            if (comment is not null)
            {
                comment.IsInternal = !comment.IsInternal;
            }
        }

        _showVisibilityDialog = false;
        _pendingVisibilityCommentId = null;
        return Task.CompletedTask;
    }

    private Task DeleteStandaloneComment(string id)
    {
        var comment = _standaloneComments.FirstOrDefault(c => c.Id == id);
        if (comment is not null)
        {
            _standaloneComments.Remove(comment);
        }
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        _attachmentProvider = AttachmentProvider;
        _fileProvider = AttachmentProvider;
        _mentionProvider = new DemoMentionProvider();
        try
        {
            _timelineEntries = await ActivityService.GetTimelineAsync(EntityId);
            _comments = await ActivityService.GetCommentsAsync(EntityId);
            _attachments = await _attachmentProvider.GetForEntityAsync(
                TmEntityRef.Create("activity-entity", EntityId));
        }
        catch (HttpRequestException)
        {
            _loadError = "Could not connect to Demo.Api. Start it on port 5100 to see live data.";
        }
    }

    private async Task HandleSimpleSubmit()
    {
        // Demo: just clear the editor after submit
        _simpleEditorValue = string.Empty;
        await Task.CompletedTask;
    }

    private async Task AddComment(string html)
    {
        try
        {
            await ActivityService.AddCommentAsync(EntityId, html);
            _comments = await ActivityService.GetCommentsAsync(EntityId);
            _timelineEntries = await ActivityService.GetTimelineAsync(EntityId);
        }
        catch (HttpRequestException)
        {
            _loadError = "Failed to add comment. Is the API running?";
        }
    }

    private async Task DeleteComment(string id)
    {
        try
        {
            await ActivityService.DeleteCommentAsync(EntityId, id);
            _comments = await ActivityService.GetCommentsAsync(EntityId);
        }
        catch (HttpRequestException)
        {
            _loadError = "Failed to delete comment. Is the API running?";
        }
    }
}
