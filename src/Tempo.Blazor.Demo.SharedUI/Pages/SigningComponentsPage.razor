    private static SigningLocalizedText Localized(string defaultText, params (string Culture, string Value)[] translations)
    {
        var text = new SigningLocalizedText { Default = defaultText };
        foreach (var (culture, value) in translations)
        {
            text.Translations[culture] = value;
        }

        return text;
    }

    private static SigningSubmissionLocalizationSnapshot CreateLocalizationSnapshot(
        IReadOnlyList<SigningField> fields,
        string? culture,
        string? fallbackCulture)
    {
        return new SigningSubmissionLocalizationSnapshot
        {
            Culture = culture,
            FallbackCulture = fallbackCulture,
            PdfContentTranslated = false,
            Fields = fields
                .Select(field => new SigningSubmissionFieldLocalizationSnapshot
                {
                    FieldUuid = field.Uuid,
                    Label = SigningLocalizationResolver.ResolveFieldLabel(field, culture, fallbackCulture, field.Name),
                    Title = SigningLocalizationResolver.ResolveFieldTitle(field, culture, fallbackCulture, field.Name),
                    Description = SigningLocalizationResolver.ResolveFieldDescription(field, culture, fallbackCulture),
                    ValidationMessage = SigningLocalizationResolver.ResolveValidationMessage(field.Validation, culture, fallbackCulture),
                    Options = field.Options
                        .Select(option => new SigningSubmissionOptionLocalizationSnapshot
                        {
                            OptionUuid = option.Uuid,
                            Value = option.Value,
                            Label = SigningLocalizationResolver.ResolveOptionLabel(option, culture, fallbackCulture, option.Value)
                        })
                        .ToList()
                })
                .ToList()
        };
    }

