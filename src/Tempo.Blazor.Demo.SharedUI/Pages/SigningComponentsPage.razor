    private Task HandleCommentThreadCreateRequested(DocumentCommentThreadCreateRequest request)
    {
        var threadId = $"comment-e2e-{_commentThreads.Count + 1}";
        var comment = CreateDocumentComment(
            $"comment-entry-{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}",
            request.Body,
            "comment-user-alice",
            "Alice Johnson",
            request.Mentions);

        var next = _commentThreads.ToList();
        next.Add(new DocumentCommentThread
        {
            Id = threadId,
            Anchor = request.Anchor,
            Comments = [comment]
        });

        _commentThreads = next;
        _selectedCommentThreadId = threadId;
        _commentMode = DocumentCommentMode.Browse;
        _commentLastEvent = request.Mentions.Count > 0
            ? $"Created comment for {string.Join(", ", request.Mentions.Select(mention => mention.DisplayName))}: {request.Body}"
            : $"Created comment: {request.Body}";
        return Task.CompletedTask;
    }

    private Task HandleCommentReplyRequested(DocumentCommentReplyRequest request)
    {
        var next = _commentThreads.ToList();
        var thread = next.FirstOrDefault(item => item.Id == request.ThreadId);
        if (thread is not null)
        {
            thread.Comments.Add(CreateDocumentComment(
                $"comment-reply-{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}",
                request.Body,
                "comment-user-alice",
                "Alice Johnson",
                request.Mentions));
            _commentThreads = next;
            _selectedCommentThreadId = request.ThreadId;
            _commentLastEvent = $"Reply added: {request.Body}";
        }

        return Task.CompletedTask;
    }

