    private void UpdateCommentThreadStatus(string threadId, DocumentCommentThreadStatus status)
    {
        var thread = _commentThreads.FirstOrDefault(item => item.Id == threadId);
        if (thread is null)
        {
            return;
        }

        thread.Status = status;
        if (status == DocumentCommentThreadStatus.Resolved)
        {
            thread.ResolvedByUserId = "comment-user-alice";
            thread.ResolvedByName = "Alice Johnson";
            thread.ResolvedAt = DateTimeOffset.UtcNow;
        }
        else
        {
            thread.ResolvedByUserId = null;
            thread.ResolvedByName = null;
            thread.ResolvedAt = null;
        }

        _commentThreads = _commentThreads.ToList();
        _selectedCommentThreadId = threadId;
    }

