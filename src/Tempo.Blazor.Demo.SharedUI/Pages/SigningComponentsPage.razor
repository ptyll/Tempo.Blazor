@page "/signing-components"
@using System.Net.Http.Json
@using Tempo.Blazor.DocumentEditor.Services
@using DocumentRenditionAnchor = Tempo.Blazor.DocumentEditor.Models.DocumentRenditionAnchor
@using DocumentRenditionAnchorType = Tempo.Blazor.DocumentEditor.Models.DocumentRenditionAnchorType
@using DocumentRenditionPage = Tempo.Blazor.DocumentEditor.Models.DocumentRenditionPage
@inject ITmLocalizer Loc
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>Signing Components - Tempo.Blazor</PageTitle>

<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Signing Components</h1>
    <p class="text-slate-600 dark:text-slate-400">
        Document page rendering and overlay primitives for signing workflows.
    </p>
</div>

<section class="demo-section">
    <div class="flex items-center justify-between gap-4 mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Document Page Viewer</h2>
            <p class="text-sm text-slate-600 dark:text-slate-400">Template page with normalized signing fields.</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-full">Phase 1</span>
    </div>

    <div class="showcase-card">
        <div class="max-w-3xl mx-auto">
            <TmDocumentPageViewer Page="_demoPage"
                                  Id="demo-signing-page-1"
                                  Class="signing-components-page__viewer"
                                  ShowToolbar="true"
                                  data-testid="signing-document-viewer"
                                  OnPageClick="HandlePageClick"
                                  OnPageContextMenu="HandlePageContextMenu">
                <TmSigningFieldOverlay Field="_dateField"
                                       Area="_dateArea"
                                       Value="_dateValue"
                                       Completed="true"
                                       OnClick="HandleFieldClick"
                                       OnContextMenu="HandleFieldContextMenu" />
                <TmSigningFieldOverlay Field="_signatureField"
                                       Area="_signatureArea"
                                       Selected="@(_selectedFieldUuid == _signatureField.Uuid)"
                                       Draggable="true"
                                       Editable="true"
                                       OnClick="HandleFieldClick"
                                       OnContextMenu="HandleFieldContextMenu"
                                       data-testid="signature-overlay" />
            </TmDocumentPageViewer>
        </div>

        <div class="mt-4 text-sm text-slate-600 dark:text-slate-400" data-testid="signing-page-event">
            @_lastInteraction
        </div>
    </div>
</section>

<section class="demo-section">
    <div class="flex items-center justify-between gap-4 mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Document comments</h2>
            <p class="text-sm text-slate-600 dark:text-slate-400">Anchored review threads, mentions, reactions, and resolved comment history.</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-cyan-100 dark:bg-cyan-900/30 text-cyan-700 dark:text-cyan-300 rounded-full">Phase 15</span>
    </div>

    <div class="showcase-card">
        <div class="mb-4 flex flex-wrap items-center gap-3 text-sm text-slate-700 dark:text-slate-300">
            <label class="inline-flex items-center gap-2">
                <input type="checkbox" class="rounded border-slate-300" @bind="_showResolvedComments" />
                <span>Show resolved comments</span>
            </label>
            <span class="text-slate-500 dark:text-slate-400" data-testid="document-comments-last-event">@_commentLastEvent</span>
        </div>

        <TmDocumentPageViewer Page="_commentPage"
                              Id="demo-document-comments-page"
                              Class="signing-components-page__viewer signing-components-page__comments-viewer"
                              ShowToolbar="true"
                              ShowPaginationControls="true"
                              PageNumber="@(_commentPageIndex + 1)"
                              TotalPages="@_commentPages.Count"
                              PreviousPageRequested="HandleCommentPreviousPageRequested"
                              NextPageRequested="HandleCommentNextPageRequested"
                              CommentsEnabled="true"
                              CommentMode="_commentMode"
                              CommentModeChanged="HandleCommentModeChanged"
                              CommentThreads="_commentThreads"
                              SelectedCommentThreadId="@_selectedCommentThreadId"
                              SelectedCommentThreadIdChanged="HandleSelectedCommentThreadChanged"
                              ShowResolvedComments="_showResolvedComments"
                              CurrentUserId="comment-user-alice"
                              MentionUsers="_commentMentionUsers"
                              AllowReplyToResolved="true"
                              OnCommentThreadCreateRequested="HandleCommentThreadCreateRequested"
                              OnCommentReplyRequested="HandleCommentReplyRequested"
                              OnCommentResolveRequested="HandleCommentResolveRequested"
                              OnCommentReopenRequested="HandleCommentReopenRequested"
                              OnCommentEditRequested="HandleCommentEditRequested"
                              OnCommentDeleteRequested="HandleCommentDeleteRequested"
                              OnCommentReactionToggled="HandleCommentReactionToggled"
                              OnCommentMentionedUsersChanged="HandleCommentMentionsChanged"
                              OnCommentThreadNavigateRequested="HandleCommentThreadNavigateRequested"
                              data-testid="document-comments-viewer" />
    </div>
</section>

<section class="demo-section">
    <div class="flex items-center justify-between gap-4 mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Field Overlay</h2>
            <p class="text-sm text-slate-600 dark:text-slate-400">All signing field types rendered through the overlay component.</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-sky-100 dark:bg-sky-900/30 text-sky-700 dark:text-sky-300 rounded-full">Phase 2</span>
    </div>

    <div class="showcase-card">
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4" data-testid="signing-field-overlay-gallery">
            @foreach (var sample in _fieldSamples)
            {
                <div class="relative h-24 rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-950 overflow-hidden">
                    <TmSigningFieldOverlay Field="sample.Field"
                                           Area="sample.Area"
                                           Value="sample.Value"
                                           Completed="sample.Completed"
                                           Invalid="sample.Invalid"
                                           Class="signing-components-page__sample-field" />
                </div>
            }
        </div>
    </div>
</section>

<section class="demo-section">
    <div class="flex items-center justify-between gap-4 mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Signature Capture</h2>
            <p class="text-sm text-slate-600 dark:text-slate-400">Draw, typed, upload, reason, reuse, and mobile signing flows.</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-violet-100 dark:bg-violet-900/30 text-violet-700 dark:text-violet-300 rounded-full">Phase 3</span>
    </div>

    <div class="showcase-card">
        <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
            <div>
                <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-3">Draw</h3>
                <TmSignatureCapture Value="_drawSignatureValue"
                                    ValueChanged="HandleDrawSignatureChanged"
                                    Confirmed="HandleDrawSignatureConfirmed"
                                    ShowConfirmButton="true"
                                    ExportFormat="TmSignatureCaptureExportFormat.Svg"
                                    data-testid="signature-draw-capture" />
                <div class="mt-6" data-testid="signature-overlay-clear-demo">
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-3">Overlay clear</h3>
                    <TmSignatureCapture ClearButtonPlacement="TmSignatureClearButtonPlacement.Overlay"
                                        data-testid="signature-overlay-clear" />
                </div>
                <div class="mt-3 text-sm text-slate-600 dark:text-slate-400" data-testid="signature-draw-value">
                    @_drawSignatureStatus
                </div>
            </div>

            <div>
                <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-3">Typed</h3>
                <TmSignatureCapture Mode="TmSignatureCaptureMode.Typed"
                                    Modes="_typedSignatureModes"
                                    Value="_typedSignatureValue"
                                    ValueChanged="HandleTypedSignatureChanged"
                                    Confirmed="HandleTypedSignatureConfirmed"
                                    ShowConfirmButton="true"
                                    data-testid="signature-typed-capture" />
                <div class="mt-3 text-sm text-slate-600 dark:text-slate-400" data-testid="signature-typed-value">
                    @_typedSignatureStatus
                </div>
            </div>

            <div>
                <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-3">Upload</h3>
                <TmSignatureCapture Mode="TmSignatureCaptureMode.Upload"
                                    Modes="_uploadSignatureModes"
                                    Value="_uploadSignatureValue"
                                    ValueChanged="value => _uploadSignatureValue = value"
                                    Confirmed="HandleUploadSignatureConfirmed"
                                    ShowConfirmButton="true"
                                    OnUploadRequested="HandleUploadRequested"
                                    data-testid="signature-upload-capture" />
                <div class="mt-3 text-sm text-slate-600 dark:text-slate-400" data-testid="signature-upload-value">
                    @_uploadSignatureStatus
                </div>
            </div>

            <div>
                <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-3">Reason and QR</h3>
                <TmSignatureCapture Value="_advancedSignatureValue"
                                    ValueChanged="value => _advancedSignatureValue = value"
                                    Changed="HandleAdvancedSignatureChanged"
                                    Confirmed="HandleAdvancedSignatureConfirmed"
                                    RequireReason="true"
                                    ShowRememberSignature="true"
                                    ShowQrSigningButton="true"
                                    ShowConfirmButton="true"
                                    PreviousValue="SignatureImage"
                                    OnQrSigningRequested="HandleQrSigningRequested"
                                    data-testid="signature-advanced-capture" />
                <div class="mt-3 text-sm text-slate-600 dark:text-slate-400" data-testid="signature-advanced-value">
                    @_advancedSignatureStatus
                </div>
            </div>
        </div>
    </div>
</section>

<section class="demo-section">
    <div class="flex items-center justify-between gap-4 mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Condition Builder</h2>
            <p class="text-sm text-slate-600 dark:text-slate-400">Field-dependent visibility rules with value validation and cycle protection.</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 rounded-full">Phase 4</span>
    </div>

    <div class="showcase-card">
        <label class="inline-flex items-center gap-2 mb-3 text-sm text-slate-600 dark:text-slate-400">
            <span>Preview language</span>
            <select class="tm-input condition-builder-culture"
                    @bind="_conditionCulture">
                @foreach (var culture in _signingCultures)
                {
                    <option value="@culture">@culture</option>
                }
            </select>
        </label>
        <TmConditionBuilder Fields="_conditionFields"
                            CurrentFieldUuid="conditional-signature"
                            Conditions="_conditionRules"
                            ConditionsChanged="HandleConditionRulesChanged"
                            Culture="@_conditionCulture"
                            FallbackCulture="en-US"
                            data-testid="condition-builder" />
        <div class="mt-3 text-sm text-slate-600 dark:text-slate-400" data-testid="condition-builder-status">
            @_conditionStatus
        </div>
    </div>
</section>

<section class="demo-section">
    <div class="flex items-center justify-between gap-4 mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Formula Builder</h2>
            <p class="text-sm text-slate-600 dark:text-slate-400">Computed signing fields with numeric tokens, operators, and cycle validation.</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-cyan-100 dark:bg-cyan-900/30 text-cyan-700 dark:text-cyan-300 rounded-full">Phase 5</span>
    </div>

    <div class="showcase-card">
        <TmFormulaBuilder Field="_formulaTotalField"
                          Fields="_formulaFields"
                          Value="@_formulaValue"
                          ValueChanged="value => _formulaValue = value"
                          Saved="HandleFormulaSaved"
                          data-testid="formula-builder" />
        <div class="mt-3 text-sm text-slate-600 dark:text-slate-400" data-testid="formula-builder-status">
            @_formulaStatus
        </div>
    </div>
</section>

<section class="demo-section">
    <div class="flex items-center justify-between gap-4 mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Template Roles</h2>
            <p class="text-sm text-slate-600 dark:text-slate-400">Role names, colors, signing order, and invite rules for reusable templates.</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-rose-100 dark:bg-rose-900/30 text-rose-700 dark:text-rose-300 rounded-full">Phase 6</span>
    </div>

    <div class="showcase-card">
        <TmRecipientRoleEditor Roles="_templateRoles"
                               RolesChanged="HandleTemplateRolesChanged"
                               Fields="_recipientInviteFields"
                               data-testid="recipient-role-editor-template" />
        <div class="mt-3 text-sm text-slate-600 dark:text-slate-400" data-testid="recipient-role-editor-template-status">
            @_templateRoleStatus
        </div>
    </div>
</section>

<section class="demo-section">
    <div class="flex items-center justify-between gap-4 mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Submission Recipients</h2>
            <p class="text-sm text-slate-600 dark:text-slate-400">Recipient contact details with required email validation.</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-rose-100 dark:bg-rose-900/30 text-rose-700 dark:text-rose-300 rounded-full">Phase 6</span>
    </div>

    <div class="showcase-card">
        <TmRecipientRoleEditor Roles="_submissionRecipients"
                               RolesChanged="HandleSubmissionRecipientsChanged"
                               Fields="_recipientInviteFields"
                               Mode="TmRecipientRoleEditorMode.SubmissionRecipients"
                               data-testid="recipient-role-editor-submission" />
        <div class="mt-3 text-sm text-slate-600 dark:text-slate-400" data-testid="recipient-role-editor-submission-status">
            @_submissionRecipientStatus
        </div>
    </div>
</section>

<section class="demo-section">
    <div class="flex items-center justify-between gap-4 mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Field Editor Panel</h2>
            <p class="text-sm text-slate-600 dark:text-slate-400">Edit field metadata, role assignment, options, validation, preferences, and conditional rules.</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-teal-100 dark:bg-teal-900/30 text-teal-700 dark:text-teal-300 rounded-full">Phase 7</span>
    </div>

    <div class="showcase-card">
        <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_minmax(22rem,28rem)] gap-6">
            <div>
                <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-3">Live preview</h3>
                <div class="relative h-36 rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-950 overflow-hidden"
                     data-testid="field-editor-preview">
                    <TmSigningFieldOverlay Field="_editorField"
                                           Area="_editorArea"
                                           Value="GetEditorPreviewValue()"
                                           Completed="_editorField.Required"
                                           Culture="@_fieldEditorCulture"
                                           FallbackCulture="cs-CZ"
                                           Class="signing-components-page__sample-field" />
                </div>
                <div class="mt-3 text-sm text-slate-600 dark:text-slate-400" data-testid="field-editor-status">
                    @_fieldEditorStatus
                </div>
            </div>

            <TmSigningFieldEditorPanel Field="_editorField"
                                       FieldChanged="HandleEditorFieldChanged"
                                       Fields="_editorFields"
                                       SubmitterRoles="_templateRoles"
                                       Culture="@_fieldEditorCulture"
                                       FallbackCulture="cs-CZ"
                                       SupportedCultures="_signingCultures"
                                       ShowLocalizationEditor="true"
                                       CopyToAllPagesRequested="HandleCopyToAllPagesRequested"
                                       OptionAreaMappingRequested="HandleOptionAreaMappingRequested"
                                       data-testid="field-editor-panel" />
        </div>
    </div>
</section>

<section class="demo-section">
    <div class="flex items-center justify-between gap-4 mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">PDF Template Designer</h2>
            <p class="text-sm text-slate-600 dark:text-slate-400">Two-page template design with drawing, selection, resizing, context actions, and field settings.</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-indigo-100 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 rounded-full">Phase 8</span>
    </div>

    <div class="showcase-card">
        <TmPdfTemplateDesigner Documents="_designerPages"
                               Fields="_designerFields"
                               FieldsChanged="HandleDesignerFieldsChanged"
                               SubmitterRoles="_templateRoles"
                               SelectedSubmitterUuid="template-signer"
                               Culture="@_designerCulture"
                               CultureChanged="HandleDesignerCultureChanged"
                               FallbackCulture="cs-CZ"
                               SupportedCultures="_signingCultures"
                               ShowCulturePreview="true"
                               OnDetectFields="DetectDesignerFieldsAsync"
                               data-testid="pdf-template-designer" />
        <div class="mt-3 text-sm text-slate-600 dark:text-slate-400" data-testid="pdf-template-designer-status">
            @_designerStatus
        </div>
    </div>
</section>

<section class="demo-section">
    <div class="flex items-center justify-between gap-4 mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Signing Steps</h2>
            <p class="text-sm text-slate-600 dark:text-slate-400">Linear signer inputs for text, choices, uploads, phone verification, and external provider steps.</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-fuchsia-100 dark:bg-fuchsia-900/30 text-fuchsia-700 dark:text-fuchsia-300 rounded-full">Phase 9</span>
    </div>

    <div class="showcase-card">
        <div class="grid grid-cols-1 xl:grid-cols-2 gap-4" data-testid="signing-steps-demo">
            <TmSigningTextStep Field="@_stepTextField"
                               Value="@_stepTextValue"
                               ValueChanged="value => _stepTextValue = value"
                               data-testid="signing-step-text" />
            <TmSigningNumberStep Field="@_stepNumberField"
                                 Value="@_stepNumberValue"
                                 ValueChanged="value => _stepNumberValue = value"
                                 data-testid="signing-step-number" />
            <TmSigningDateStep Field="@_stepDateField"
                               Value="@_stepDateValue"
                               ValueChanged="value => _stepDateValue = value"
                               data-testid="signing-step-date" />
            <TmSigningChoiceStep Field="@_stepSelectField"
                                 Value="@_stepSelectValue"
                                 ValueChanged="HandleStepSelectChanged"
                                 data-testid="signing-step-select" />
            <TmSigningChoiceStep Field="@_stepRadioField"
                                 Value="@_stepRadioValue"
                                 ValueChanged="HandleStepRadioChanged"
                                 data-testid="signing-step-radio" />
            <TmSigningChoiceStep Field="@_stepMultipleField"
                                 Value="@_stepMultipleValue"
                                 ValueChanged="HandleStepMultipleChanged"
                                 data-testid="signing-step-multiple" />
            <TmSigningAttachmentStep Field="@_stepImageField"
                                     Attachments="@_stepImageAttachments"
                                     AttachmentsChanged="HandleStepImageAttachmentsChanged"
                                     data-testid="signing-step-image" />
            <TmSigningPhoneStep Field="@_stepPhoneField"
                                CountryCode="+420"
                                PhoneNumber="@_stepPhoneNumber"
                                PhoneNumberChanged="value => _stepPhoneNumber = value"
                                ValueChanged="value => _stepPhoneValue = value"
                                OnSendCode="HandleStepPhoneCodeSent"
                                data-testid="signing-step-phone" />
            <TmSigningExternalStep Field="@_stepPaymentField"
                                   OnCheckout="HandleStepCheckout"
                                   data-testid="signing-step-payment" />
        </div>

        <div class="mt-3 text-sm text-slate-600 dark:text-slate-400" data-testid="signing-steps-status">
            @_stepStatus
        </div>
    </div>
</section>

<section class="demo-section">
    <div class="flex items-center justify-between gap-4 mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Signing Form Runner</h2>
            <p class="text-sm text-slate-600 dark:text-slate-400">Full signing ceremony with ordered steps, overlays, autosave, conditional fields, formulas, and mobile controls.</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-lime-100 dark:bg-lime-900/30 text-lime-700 dark:text-lime-300 rounded-full">Phase 10</span>
    </div>

    <div class="showcase-card">
        <TmSigningFormRunner Pages="@_runnerPages"
                             Fields="@_runnerFields"
                             Values="@_runnerValues"
                             ValuesChanged="HandleRunnerValuesChanged"
                             OnAutoSave="HandleRunnerAutoSave"
                             OnComplete="HandleRunnerComplete"
                             Culture="@_runnerCulture"
                             CultureChanged="HandleRunnerCultureChanged"
                             FallbackCulture="cs-CZ"
                             SupportedCultures="_signingCultures"
                             ShowLanguageSelector="true"
                             OnLocalizationSnapshotChanged="HandleRunnerLocalizationSnapshotChanged"
                             AutoSaveDelay="@TimeSpan.FromMilliseconds(80)"
                             data-testid="signing-runner-demo" />
        <div class="mt-3 text-sm text-slate-600 dark:text-slate-400" data-testid="signing-runner-status">
            @_runnerStatus
        </div>
    </div>
</section>

<section class="demo-section">
    <div class="flex items-center justify-between gap-4 mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Completion Panel</h2>
            <p class="text-sm text-slate-600 dark:text-slate-400">Final signer confirmation with document download, copy sending, and custom next action.</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-full">Phase 11</span>
    </div>

    <div class="showcase-card">
        <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
            <TmSigningCompletionPanel DownloadUrl="/sample-signed.pdf"
                                      CustomActionText="Back to documents"
                                      CustomActionIcon="folder-open"
                                      OnSendCopy="HandleCompletionSendCopy"
                                      OnCustomAction="HandleCompletionCustomAction"
                                      data-testid="signing-completion-panel" />
            <TmSigningCompletionPanel IsWaitingForOthers="true"
                                      DownloadUrl="/sample-draft.pdf"
                                      data-testid="signing-completion-waiting" />
        </div>
        <div class="mt-3 text-sm text-slate-600 dark:text-slate-400" data-testid="signing-completion-status">
            @_completionStatus
        </div>
    </div>
</section>

<section class="demo-section">
    <div class="flex items-center justify-between gap-4 mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Submission Status Timeline</h2>
            <p class="text-sm text-slate-600 dark:text-slate-400">Recipient lifecycle events including email delivery, verification, and KBA signals.</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-full">Phase 11</span>
    </div>

    <div class="showcase-card">
        <TmSubmissionStatusTimeline Events="@_submissionStatusEvents"
                                    data-testid="submission-status-timeline" />
    </div>
</section>

<section class="demo-section">
    <div class="flex items-center justify-between gap-4 mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Share Link Panel</h2>
            <p class="text-sm text-slate-600 dark:text-slate-400">Public signing link with copy actions, QR code, embed code, expiration, and enable toggle.</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-full">Phase 11</span>
    </div>

    <div class="showcase-card">
        <TmShareLinkPanel Link="https://sign.example.test/s/demo-token"
                          EmbedCode="@DemoEmbedCode"
                          Enabled="@_shareLinkEnabled"
                          EnabledChanged="HandleShareLinkEnabledChanged"
                          ExpiresAt="@_shareLinkExpiresAt"
                          data-testid="share-link-panel" />
        <div class="mt-3 text-sm text-slate-600 dark:text-slate-400" data-testid="share-link-status">
            @_shareLinkStatus
        </div>
    </div>
</section>

<section class="demo-section">
    <div class="flex items-center justify-between gap-4 mb-4">
        <div>
