    private static DocumentComment CreateDocumentComment(
        string id,
        string body,
        string authorId,
        string authorName,
        IEnumerable<DocumentCommentMention>? mentions = null,
        IEnumerable<DocumentCommentReaction>? reactions = null)
    {
        return new DocumentComment
        {
            Id = id,
            AuthorId = authorId,
            AuthorName = authorName,
            Body = body,
            CreatedAt = DateTimeOffset.UtcNow,
            Mentions = mentions?.ToList() ?? [],
            Reactions = reactions?.ToList() ?? [],
            CanEdit = authorId == "comment-user-alice",
            CanDelete = authorId == "comment-user-alice"
        };
    }

    private static SigningField CreateField(
        SigningFieldType type,
        string name,
        string? title = null,
        bool required = false)
    {
        return new SigningField
        {
            Uuid = $"{type}-{name}".Replace(' ', '-').ToLowerInvariant(),
            Name = name,
            Title = title,
            Type = type,
            Required = required
        };
    }

    private static SigningField CreateChoiceField(SigningFieldType type, string name)
    {
        var field = CreateField(type, name);
        field.Options =
        [
            new SigningFieldOption { Uuid = "option-1", Value = "One" },
            new SigningFieldOption { Uuid = "option-2", Value = "Two" },
            new SigningFieldOption { Uuid = "option-3", Value = "Three" }
        ];

        return field;
    }

