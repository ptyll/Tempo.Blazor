    {
        UpdateCommentThreadStatus(request.ThreadId, DocumentCommentThreadStatus.Resolved);
        _commentLastEvent = $"Resolved {request.ThreadId}";
        return Task.CompletedTask;
    }

    private Task HandleCommentReopenRequested(DocumentCommentThreadStatusRequest request)
    {
        UpdateCommentThreadStatus(request.ThreadId, DocumentCommentThreadStatus.Open);
        _showResolvedComments = true;
        _commentLastEvent = $"Reopened {request.ThreadId}";
        return Task.CompletedTask;
    }

    private Task HandleCommentEditRequested(DocumentCommentEditRequest request)
    {
        var thread = _commentThreads.FirstOrDefault(item => item.Id == request.ThreadId);
        var comment = thread?.Comments.FirstOrDefault(item => item.Id == request.CommentId);
        if (comment is not null)
        {
            comment.Body = request.Body;
            comment.Mentions = request.Mentions.ToList();
            comment.EditedAt = DateTimeOffset.UtcNow;
            _commentThreads = _commentThreads.ToList();
            _commentLastEvent = $"Edited comment: {request.Body}";
        }

        return Task.CompletedTask;
    }

    private Task HandleCommentDeleteRequested(DocumentCommentDeleteRequest request)
    {
        var next = _commentThreads.ToList();
        var thread = next.FirstOrDefault(item => item.Id == request.ThreadId);
        var comment = thread?.Comments.FirstOrDefault(item => item.Id == request.CommentId);
        if (thread is not null && comment is not null)
        {
            thread.Comments.Remove(comment);
            if (thread.Comments.Count == 0)
            {
                next.Remove(thread);
            }

            _commentThreads = next;
            _selectedCommentThreadId = _commentThreads.FirstOrDefault()?.Id;
            _commentLastEvent = $"Deleted {request.CommentId}";
        }

        return Task.CompletedTask;
    }

    private Task HandleCommentReactionToggled(DocumentCommentReactionToggleRequest request)
    {
        var thread = _commentThreads.FirstOrDefault(item => item.Id == request.ThreadId);
        var comment = thread?.Comments.FirstOrDefault(item => item.Id == request.CommentId);
        if (comment is not null)
        {
            var reaction = comment.Reactions.FirstOrDefault(item => item.Value == request.Value);
            if (reaction is null)
            {
                comment.Reactions.Add(new DocumentCommentReaction
                {
                    Value = request.Value,
                    UserIds = ["comment-user-alice"]
                });
            }
            else if (reaction.UserIds.Contains("comment-user-alice", StringComparer.Ordinal))
            {
                reaction.UserIds.Remove("comment-user-alice");
                if (reaction.UserIds.Count == 0)
                {
                    comment.Reactions.Remove(reaction);
                }
            }
            else
            {
                reaction.UserIds.Add("comment-user-alice");
            }

            _commentThreads = _commentThreads.ToList();
            _commentLastEvent = $"Reaction {request.Value} toggled";
        }

        return Task.CompletedTask;
    }

