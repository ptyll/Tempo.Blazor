    private string? GetRunnerValue(string fieldUuid)
    {
        if (fieldUuid == "runner-total"
            && _runnerValues.TryGetValue("runner-amount", out var amountValue)
            && decimal.TryParse(amountValue?.ToString(), out var amount))
        {
            return (amount * 1.21m).ToString("0.##");
        }

        return _runnerValues.TryGetValue(fieldUuid, out var value)
            ? value?.ToString()
            : null;
    }

