@page "/wireframe-editor"
@using Tempo.Blazor.Components.Files
@using Tempo.Blazor.Components.Wireframe
@using Tempo.Blazor.Components.Wireframe.Models

@inject IHttpClientFactory HttpFactory
@inject Tempo.Blazor.DocumentLibrary.ITempoDocumentLibraryProvider LibraryProvider
@inject Tempo.Blazor.Demo.Services.ApiWireframeDocumentProvider WireframeDocuments
@inject Tempo.Blazor.Services.ThemeService ThemeService
@inject Tempo.Blazor.Demo.SharedUI.Layout.ColorThemeState ColorTheme
@implements IDisposable

<PageTitle>Wireframe Editor – Tempo.Blazor</PageTitle>

@* Demo only: the wireframe editor resolves its layout from its own container width (desktop from 1200). With the 296px demo
   sidebar a 1440 viewport leaves it ~1080px, so from 1400px up this page collapses the sidebar AND lifts the layout's max-w-7xl
   (1280px) cap, giving the editor the full width of the viewport (a link back to the demo index stays in the header). The library
   breakpoints are untouched. *@
<style>
    @@media (min-width: 1400px) {
        .demo-shell:has(.wd-demo-page) aside.fixed.inset-y-0.left-0.z-30 { display: none !important; }
        .demo-shell:has(.wd-demo-page) main { margin-left: 0 !important; width: 100vw !important; max-width: 100vw !important; }
        .demo-shell:has(.wd-demo-page) main .max-w-7xl { max-width: none !important; }
    }
    .wd-demo-page__index-link { display: none; }
    @@media (min-width: 1400px) {
        /* A real top margin and scroll-margin so a sticky/fixed header never covers the link, and a colour with enough contrast on the page background (light and dark). */
        .wd-demo-page__index-link { display: inline-block; margin-top: 1rem; scroll-margin-top: 5rem; color: var(--tm-color-primary-700, #1d4ed8); text-decoration: underline; }
        .dark .wd-demo-page__index-link, [data-theme="dark"] .wd-demo-page__index-link { color: var(--tm-color-primary-300, #93c5fd); }
    }
</style>

<div class="wd-demo-page">

<!-- Page Header -->
<div class="mb-8">
    <a href="./" class="wd-demo-page__index-link text-sm mb-2" data-testid="wf-demo-index-link">← All demos</a>
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Wireframe Editor</h1>
    <p class="text-slate-600 dark:text-slate-400">
        SVG-based wireframe design tool for quickly sketching UI layouts with Tempo.Blazor components.
        Drag components from the toolbox, resize, rearrange, and export as JSON or SVG.
    </p>
</div>

<!-- ═══ Section 1: Interactive editor ═══════════════════════════════════════ -->
<section class="demo-section mb-10">
    <div class="flex items-center justify-between mb-3">
        <div>
            <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200">Interactive Editor</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                Drag components from the left toolbox onto the canvas. Select to edit properties on the right.
                Ctrl+Z / Ctrl+Y for undo/redo. Delete key removes selected elements.
                On a tablet: tap to select, drag to move, two fingers to pinch-zoom and pan, hold for the context menu, tap a toolbox tile to add it.
                On a phone (editor narrower than 768 px) the editor is for viewing and light edits: tap "Add" for the palette, select an element to peek its properties
                (Duplicate / Lock / Delete), swipe the sheet up for every property, and use "Pages &amp; layers", "Export" and "More" in the bar below.
            </p>
        </div>
        <div class="flex gap-2">
            <button class="px-3 py-1.5 text-sm rounded border border-slate-300 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300"
                    @onclick="LoadLoginSample">
                Load Login page
            </button>
            <button class="px-3 py-1.5 text-sm rounded border border-slate-300 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300"
                    @onclick="LoadDashboardSample">
                Load Dashboard
            </button>
            <button class="px-3 py-1.5 text-sm rounded border border-slate-300 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300"
                    @onclick="NewDocument">
                New document
            </button>
        </div>
    </div>

    <div style="height: 600px;">
        @* The editor has no built-in Open/Save: the host supplies its own actions through the header slots (G9). *@
        <TmWireframeEditor Document="@_document"
                           DocumentChanged="@(doc => { _document = doc; _jsonPreview = WireframeSerializer.Serialize(doc); })"
                           ShowGrid="true"
                           GridSize="8"
                           PageNavigation="WireframePageNavigation.Panel"
                           ExportHttpClientName="DemoApi"
                           StencilTheme="@StencilTheme"
                           Class="h-full">
            <HeaderActions>
                <button class="px-3 py-1.5 text-sm rounded border border-indigo-300 dark:border-indigo-600 bg-indigo-50 dark:bg-indigo-900/30 hover:bg-indigo-100 dark:hover:bg-indigo-900 text-indigo-700 dark:text-indigo-300"
                        data-testid="wf-open-btn"
                        @onclick="() => _openDialog = true">
                    Open…
                </button>
            </HeaderActions>
        </TmWireframeEditor>
    </div>

    <div class="mt-3 flex gap-4 text-sm text-slate-500 dark:text-slate-400">
        <span>Elements: <strong class="text-slate-700 dark:text-slate-300">@(_document?.Elements.Count ?? 0)</strong></span>
        <span>Title: <strong class="text-slate-700 dark:text-slate-300">@(_document?.Title ?? "—")</strong></span>
        <span>Canvas: <strong class="text-slate-700 dark:text-slate-300">@((int?)_document?.Width ?? 0)×@((int?)_document?.Height ?? 0)</strong></span>
    </div>
</section>

<!-- ═══ Section 2: Read-only preview ════════════════════════════════════════ -->
<section class="demo-section mb-10">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-1">Read-Only Preview</h2>
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">
        The same document rendered with <code class="px-1 py-0.5 bg-slate-100 dark:bg-slate-800 rounded text-xs font-mono">ReadOnly="true"</code>.
        No editing interactions — useful for embedding wireframe previews in documentation or approval flows.
    </p>

    <div style="height: 360px;">
        <TmWireframeEditor Document="@_document"
                           ReadOnly="true"
                           ShowToolbar="false"
                           ShowToolbox="false"
                           ShowPropertiesPanel="false"
                           ShowMinimap="false"
                           Class="h-full" />
    </div>
</section>

<!-- ═══ Section 3: JSON import/export ═══════════════════════════════════════ -->
<section class="demo-section mb-10">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-1">JSON Import / Export</h2>
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">
        Wireframe documents are plain JSON — AI-friendly, version-control friendly.
        Paste any valid wireframe JSON below and click "Load into editor".
    </p>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <!-- JSON input -->
        <div>
            <div class="flex items-center justify-between mb-2">
                <label class="text-sm font-medium text-slate-700 dark:text-slate-300">Wireframe JSON</label>
                <div class="flex gap-2">
                    <button class="px-2 py-1 text-xs rounded border border-slate-300 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-400"
                            @onclick="CopyJsonToClipboard">
                        Copy
                    </button>
                    <button class="px-2 py-1 text-xs rounded bg-blue-600 hover:bg-blue-700 text-white"
                            @onclick="LoadFromJson">
                        Load into editor
                    </button>
                </div>
            </div>
            <textarea class="w-full h-64 p-3 text-xs font-mono border border-slate-300 dark:border-slate-600 rounded bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 resize-none"
                      @bind="_jsonPreview"
                      placeholder="Paste wireframe JSON here…"></textarea>
            @if (_jsonError is not null)
            {
                <p class="mt-1 text-xs text-red-600 dark:text-red-400">@_jsonError</p>
            }
        </div>

        <!-- Cheat sheet -->
        <div class="bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg p-4">
            <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300 mb-3">Document structure</h3>
            <pre class="text-xs font-mono text-slate-600 dark:text-slate-400 whitespace-pre-wrap leading-relaxed">@_schemaHint</pre>
        </div>
    </div>
</section>

<!-- ═══ Section 4: Custom provider demo ═════════════════════════════════════ -->
<section class="demo-section mb-10">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-1">Custom Component Provider</h2>
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">
        Extend the toolbox by registering a custom <code class="px-1 py-0.5 bg-slate-100 dark:bg-slate-800 rounded text-xs font-mono">IWireframeComponentProvider</code>.
        The editor below uses a demo provider that adds three marketing components
        (<em>HeroSection</em>, <em>FeatureCard</em>, <em>CtaBanner</em>) alongside the built-in Tempo.Blazor set.
        Load the sample document to see them on the canvas.
    </p>

    <div class="mb-3">
        <button class="px-3 py-1.5 text-sm rounded border border-slate-300 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300"
                @onclick="LoadCustomSample">
            Load custom-components sample
        </button>
    </div>

    <div style="height: 560px;">
        <TmWireframeEditor Document="@_customDocument"
                           DocumentChanged="@(doc => _customDocument = doc)"
                           ExportHttpClientName="DemoApi"
                           StencilTheme="@StencilTheme"
                           Class="h-full" />
    </div>

    <details class="mt-4">
        <summary class="cursor-pointer text-sm font-medium text-slate-700 dark:text-slate-300 select-none">
            Show provider source code
        </summary>
        <pre class="mt-3 p-4 text-xs font-mono bg-slate-900 text-green-300 rounded-lg overflow-x-auto leading-relaxed whitespace-pre-wrap">@_providerCode</pre>
    </details>
</section>

<!-- ═══ Section 5: Narrow container ════════════════════════════════════════ -->
<section class="demo-section mb-10" data-testid="wf-demo-narrow">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-1">Narrow Container</h2>
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">
        The editor picks its layout from the width of its <em>own container</em>, not from the viewport: in a 390 px box it is the
        phone layout (viewing and light edits, action bar, bottom sheets) even on a desktop screen.
    </p>
    <div class="mb-3">
        <button class="px-3 py-1.5 text-sm rounded border border-slate-300 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300"
                data-testid="wf-demo-narrow-toggle"
                aria-expanded="@(_showNarrow ? "true" : "false")"
                @onclick="ToggleNarrow">
            @(_showNarrow ? "Hide narrow editor" : "Show narrow editor")
        </button>
    </div>
    @if (_showNarrow && _narrowDocument is not null)
    {
        @* Its own document (a clone of the main one when it was opened) and its own test id namespace: the main editor keeps the plain wd- ids. *@
        <div style="width: 390px; max-width: 100%; height: 640px;" data-testid="wf-demo-narrow-host">
            <TmWireframeEditor Document="@_narrowDocument"
                               DocumentChanged="@(doc => _narrowDocument = doc)"
                               TestIdPrefix="narrow"
                               ExportHttpClientName="DemoApi"
                               StencilTheme="@StencilTheme"
                               Class="h-full" />
        </div>
    }
</section>

<!-- ═══ Section 6: Standalone layers panel ══════════════════════════════════ -->
<section class="demo-section mb-10" data-testid="wf-demo-layers">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-1">Standalone Layers Panel</h2>
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">
        <code class="px-1 py-0.5 bg-slate-100 dark:bg-slate-800 rounded text-xs font-mono">TmWireframeLayersPanel</code> is a public component of its own.
        The editor hosts it as the Layers tab with <code class="px-1 py-0.5 bg-slate-100 dark:bg-slate-800 rounded text-xs font-mono">ShowCollapseToggle="false"</code>
        (the tab owns the collapse); on its own the default keeps the header with its collapse toggle.
    </p>
    <div class="grid gap-4 sm:grid-cols-2">
        <div class="max-w-sm border border-slate-200 dark:border-slate-700 rounded-lg overflow-hidden" data-testid="wf-demo-layers-standalone">
            <TmWireframeLayersPanel Document="@_document" DocumentChanged="@(doc => _document = doc)" />
        </div>
        <div class="max-w-sm border border-slate-200 dark:border-slate-700 rounded-lg overflow-hidden" data-testid="wf-demo-layers-embedded">
            <TmWireframeLayersPanel Document="@_document" DocumentChanged="@(doc => _document = doc)" ShowCollapseToggle="false" />
        </div>
    </div>
</section>

</div>

<TmDocumentOpenDialog Provider="LibraryProvider"
                      Kind="Tempo.Blazor.DocumentLibrary.TempoDocumentKind.Wireframe"
                      ShowModeToggle="false"
                      @bind-Open="_openDialog"
                      OnSelected="HandleOpenSelectedAsync" />

@code {
    // ── State ──────────────────────────────────────────────────────────────────

    private WireframeDocument _document = CreateDefault();
    private WireframeDocument _customDocument = CreateDefault();
    private WireframeDocument? _narrowDocument;
    private bool _showNarrow;
    private bool _openDialog;

    private string _jsonPreview  = "";
    private string? _jsonError;

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        _jsonPreview = WireframeSerializer.Serialize(_document);
        // The stencils follow the demo's colour theme (default / indigo) and light / dark: the editors, the toolbox previews and the PNG / PDF
        // export all take this name (decision WIREFRAME-STENCIL-THEME).
        ThemeService.OnChanged += OnThemeChanged;
        ColorTheme.Changed += OnThemeChanged;
    }

    /// <summary>The stencil theme of the active demo theme: <c>indigo</c> / <c>indigo-dark</c>, <c>dark</c>, or <c>null</c> (default tokens).</summary>
    private string? StencilTheme => (ColorTheme.Current == Tempo.Blazor.Demo.SharedUI.Layout.ColorThemeState.Indigo, ThemeService.IsDark) switch
    {
        (true, true) => "indigo-dark",
        (true, false) => "indigo",
        (false, true) => "dark",
        _ => null,
    };

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ThemeService.OnChanged -= OnThemeChanged;
        ColorTheme.Changed -= OnThemeChanged;
    }

    private async Task HandleOpenSelectedAsync(Tempo.Blazor.Components.Files.DocumentOpenResult result)
    {
        var doc = await WireframeDocuments.GetWireframeDocumentAsync(result.DocumentId);
        if (doc is not null)
        {
            _document = doc;
            _jsonPreview = WireframeSerializer.Serialize(doc);
            StateHasChanged();
        }
    }

    // The narrow demo editor is rendered on demand only, on its own copy of the main document (never shared state or test ids).
    private void ToggleNarrow()
    {
        _showNarrow = !_showNarrow;
        _narrowDocument = _showNarrow && WireframeSerializer.TryDeserialize(WireframeSerializer.Serialize(_document), out var clone) ? clone : null;
        if (_narrowDocument is null) _showNarrow = false;
    }

    // ── Sample loading ─────────────────────────────────────────────────────────

    private async Task LoadLoginSample()
    {
        var doc = await FetchSample("login-page");
        if (doc is not null)
        {
            _document    = doc;
            _jsonPreview = WireframeSerializer.Serialize(doc);
        }
    }

    private async Task LoadDashboardSample()
    {
        var doc = await FetchSample("dashboard");
        if (doc is not null)
        {
            _document    = doc;
            _jsonPreview = WireframeSerializer.Serialize(doc);
        }
    }

    private async Task LoadCustomSample()
    {
        var doc = await FetchSample("custom-components");
        if (doc is not null)
            _customDocument = doc;
    }

    private async Task<WireframeDocument?> FetchSample(string slug)
    {
        try
        {
            var http = HttpFactory.CreateClient("DemoApi");
            var json = await http.GetStringAsync($"api/wireframes/{slug}");
            if (WireframeSerializer.TryDeserialize(json, out var doc))
                return doc;
        }
        catch { /* ignore network errors in demo */ }
        return null;
    }

    private void NewDocument()
    {
        _document    = CreateDefault();
        _jsonPreview = WireframeSerializer.Serialize(_document);
    }

    // ── JSON panel ─────────────────────────────────────────────────────────────

    private void LoadFromJson()
    {
        _jsonError = null;
        if (WireframeSerializer.TryDeserialize(_jsonPreview, out var doc) && doc is not null)
        {
            _document = doc;
        }
        else
        {
            _jsonError = "Invalid wireframe JSON. Check the structure and try again.";
        }
    }

    private async Task CopyJsonToClipboard()
    {
        // Best-effort clipboard write — not available in all browsers without HTTPS
        try
        {
            await Task.CompletedTask; // placeholder; real impl needs JSInterop
        }
        catch { }
    }

    // ── Helpers ────────────────────────────────────────────────────────────────

    private static WireframeDocument CreateDefault() => new()
    {
        Title  = "My wireframe",
        Width  = 1280,
        Height = 800
    };

    // _schemaHint and _providerCode are in WireframeEditorPage.cs (raw strings with < > cause Razor parse errors)
}
