@page "/pdf-viewer"
@using Tempo.Blazor.Components.Files
@using Tempo.Blazor.Abstractions.Models
<PageTitle>PDF Viewer – Tempo.Blazor</PageTitle>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">PDF Viewer</h1>
    <p class="text-slate-600 dark:text-slate-400">
        A reusable PDF viewer powered by PDF.js v5. Supports page navigation, zoom, rotation, thumbnails, search with highlight and next/previous navigation, a selectable text layer, text-range annotations with comment threads, and continuous scroll.
    </p>
</div>

<!-- Basic Usage -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Basic Usage</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">Core</span>
    </div>

    <div class="showcase-card" data-testid="pdf-basic-usage-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Standard single-page viewer with toolbar, page navigation, and zoom controls.
            Append <code>?url=…</code> to open a different document — e.g. a PDF exported from the
            document editor demo (<code>/api/document-editor/&lt;id&gt;/export/pdf/last</code>).
        </p>
        <TmPdfViewer Url="@EffectiveBasicPdfUrl"
                     ShowToolbar="true"
                     AllowDownload="true"
                     Height="500px" />
    </div>
</section>

<!-- Thumbnails -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Thumbnails Sidebar</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full">Navigation</span>
    </div>

    <div class="showcase-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Visual thumbnail overview for quick page navigation.
        </p>
        <TmPdfViewer Url="@_demoPdfUrl"
                     ShowToolbar="true"
                     ShowThumbnails="true"
                     AllowDownload="true"
                     Height="500px" />
    </div>
</section>

<!-- Search -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Document Search</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-full">Search</span>
    </div>

    <div class="showcase-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Full-text search across all pages. Every occurrence is highlighted, the active match is emphasized and scrolled into view, and the up/down buttons (or Enter / Shift+Enter) step through matches with a live counter.
        </p>
        <TmPdfViewer Url="@_demoPdfUrl"
                     ShowToolbar="true"
                     ShowSearch="true"
                     AllowDownload="true"
                     Height="500px" />
    </div>
</section>

<!-- Annotations -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Annotations &amp; Comments</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-indigo-100 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 rounded-full">Collaboration</span>
    </div>

    <div class="showcase-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Select text in the document to highlight it and start a comment thread. Threads appear as margin markers and in the side panel, where you can reply, resolve, reopen, and delete. Comments persist through the pluggable <code>IPdfAnnotationProvider</code> — this demo uses an in-memory provider seeded with one thread.
        </p>
        @if (_lastSelection is not null)
        {
            <p class="text-xs text-indigo-600 dark:text-indigo-300 mb-2" data-testid="pdf-demo-selection">
                Last selection on page @_lastSelection.Page: &ldquo;@_lastSelection.Text&rdquo;
            </p>
        }
        <TmPdfViewer Url="@_demoPdfUrl"
                     DocumentId="demo-annotated-pdf"
                     ShowToolbar="true"
                     EnableAnnotations="true"
                     AnnotationProvider="_annotationProvider"
                     CurrentUser="_currentUser"
                     OnTextSelected="OnDemoTextSelected"
                     AllowDownload="true"
                     Height="600px" />
    </div>
</section>

<!-- Text Layer -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Selectable Text Layer</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full">Accessibility</span>
    </div>

    <div class="showcase-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Transparent text layer rendered over the canvas enables text selection and screen-reader compatibility.
        </p>
        <TmPdfViewer Url="@_demoPdfUrl"
                     ShowToolbar="true"
                     ShowTextLayer="true"
                     AllowDownload="true"
                     Height="500px" />
    </div>
</section>

<!-- Continuous Scroll -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Continuous Scroll</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 rounded-full">View Mode</span>
    </div>

    <div class="showcase-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Scroll through all pages seamlessly instead of navigating page by page. Pages are painted
            lazily as they enter the viewport, canvases far outside the view are released, scrolling
            keeps the page indicator (and the two-way <code>Page</code> binding) in sync, and search
            scrolls to the match's page. This section loads a local 120-page document.
        </p>
        <TmPdfViewer Url="@_demoPdfUrl"
                     ShowToolbar="true"
                     ShowViewModeToggle="true"
                     ShowSearch="true"
                     ViewMode="PdfViewMode.Continuous"
                     AllowDownload="true"
                     Height="600px" />
    </div>
</section>

<!-- Rotation -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Page Rotation</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-rose-100 dark:bg-rose-900/30 text-rose-700 dark:text-rose-300 rounded-full">Transform</span>
    </div>

    <div class="showcase-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Rotate the document in 90° increments (0° → 90° → 180° → 270°).
        </p>
        <TmPdfViewer Url="@_demoPdfUrl"
                     ShowToolbar="true"
                     AllowRotation="true"
                     AllowDownload="true"
                     Height="500px" />
    </div>
</section>

<!-- Document Header -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Document Header</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-sky-100 dark:bg-sky-900/30 text-sky-700 dark:text-sky-300 rounded-full">Chrome</span>
    </div>

    <div class="showcase-card" data-testid="pdf-header-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Optional document header (<code>ShowHeader</code>) with a title and the Open/Download
            actions moved out of the toolbar. The subtitle defaults to a neutral page count once
            the document is loaded; <code>HeaderStart</code> / <code>HeaderActions</code> slots
            let hosts compose their own chrome.
        </p>
        <TmPdfViewer Url="@_demoPdfUrl"
                     ShowToolbar="true"
                     ShowHeader="true"
                     Title="Quarterly Report 2026"
                     AllowDownload="true"
                     Height="500px" />
    </div>
</section>

<!-- All Features Combined -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">All Features Combined</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">Full</span>
    </div>

    <div class="showcase-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Thumbnails, search, text layer, annotations, rotation, and view mode toggle enabled simultaneously.
        </p>
        <TmPdfViewer Url="@_demoPdfUrl"
                     DocumentId="demo-full-pdf"
                     ShowToolbar="true"
                     ShowThumbnails="true"
                     ShowSearch="true"
                     ShowTextLayer="true"
                     ShowViewModeToggle="true"
                     EnableAnnotations="true"
                     AnnotationProvider="_annotationProvider"
                     CurrentUser="_currentUser"
                     AllowRotation="true"
                     AllowDownload="true"
                     Height="600px" />
    </div>
</section>

@code {
    /// <summary>
    /// Local 120-page fixture (Demo.SharedUI static web assets,
    /// <c>_content/Tempo.Blazor.Demo.SharedUI/sample-data/tempo-pdf-viewer-120p.pdf</c>) so the
    /// demos and the E2E lane never depend on an external URL: 100+ pages keep the
    /// continuous scroll, lazy rendering and search lanes honest.
    /// </summary>
    private const string _demoPdfUrl = "_content/Tempo.Blazor.Demo.SharedUI/sample-data/tempo-pdf-viewer-120p.pdf";

    /// <summary>Optional PDF URL override for the Basic Usage viewer (e.g. a document-editor export).</summary>
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "url")]
    public string? UrlOverride { get; set; }

    private string EffectiveBasicPdfUrl
        => string.IsNullOrWhiteSpace(UrlOverride) ? _demoPdfUrl : UrlOverride;

    private readonly DocumentCommentUser _currentUser = new()
    {
        UserId = "demo-user",
        DisplayName = "Demo User"
    };

    private readonly InMemoryPdfAnnotationProvider _annotationProvider = new(
        new Dictionary<string, IReadOnlyList<DocumentCommentThread>>
        {
            // Seed for the Continuous→SinglePage handoff (PD1): a thread on page 3 lets
            // the E2E lane select it while the "All Features Combined" viewer is in
            // continuous mode and assert the switch back to the thread's page.
            ["demo-full-pdf"] =
            [
                new DocumentCommentThread
                {
                    Id = "full-seed-thread",
                    Anchor = DocumentCommentAnchor.TextRange(3,
                        [DocumentCommentRect.Create(0.20, 0.35, 0.25, 0.015)],
                        "content point"),
                    Comments =
                    [
                        new DocumentComment
                        {
                            Id = "full-seed-comment",
                            AuthorId = "reviewer",
                            AuthorName = "Reviewer",
                            Body = "Selecting this thread returns the viewer to single-page mode on page 3.",
                            CanEdit = false,
                            CanDelete = false
                        }
                    ]
                }
            ],
            ["demo-annotated-pdf"] =
            [
                new DocumentCommentThread
                {
                    Id = "seed-thread",
                    Anchor = DocumentCommentAnchor.TextRange(1,
                        [DocumentCommentRect.Create(0.18, 0.30, 0.30, 0.018)],
                        "trace-based just-in-time"),
                    Comments =
                    [
                        new DocumentComment
                        {
                            Id = "seed-comment",
                            AuthorId = "reviewer",
                            AuthorName = "Reviewer",
                            Body = "Great summary of the tracing approach — worth expanding here.",
                            CanEdit = false,
                            CanDelete = false
                        }
                    ]
                }
            ]
        });

    private PdfTextSelection? _lastSelection;

    private void OnDemoTextSelected(PdfTextSelection selection)
    {
        _lastSelection = selection;
    }
}
