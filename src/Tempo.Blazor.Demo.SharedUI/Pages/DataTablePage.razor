        return (fieldName.ToLowerInvariant(), rawValue) switch
        {
            ("role", "Admin") => "Administrator",
            ("role", "User") => "Regular User",
            ("role", "Manager") => "Team Manager",
            ("dept", "Engineering") => "Engineering Dept.",
            ("dept", "Marketing") => "Marketing Dept.",
            ("dept", "Sales") => "Sales Dept.",
