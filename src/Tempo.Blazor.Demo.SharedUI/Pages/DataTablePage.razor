    // Page-owned filter state for content-only table demo
    private string _pageOwnedDeptFilter = string.Empty;

    private IEnumerable<Employee> _pageOwnedFilteredEmployees =>
        string.IsNullOrEmpty(_pageOwnedDeptFilter)
            ? _employees
            : _employees.Where(e => e.Dept == _pageOwnedDeptFilter);

