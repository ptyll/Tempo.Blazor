@page "/data-table"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Tempo.Blazor.Components.DataTable
@using Tempo.Blazor.Export
@using Tempo.Blazor.Interfaces
@using Tempo.Blazor.Models
@inject ITmLocalizer Loc
<PageTitle>Data Table – Tempo.Blazor</PageTitle>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Data Table</h1>
    <p class="text-slate-600 dark:text-slate-400">Advanced data tables with sorting, filtering, pagination, and selection capabilities.</p>
</div>

<!-- Advanced ergonomics: pin, resize, multi-sort, master-detail -->
<section class="demo-section" data-testid="dt-ergonomics-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Card mode</h2>
    </div>
    <div class="showcase-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Forced card layout: each row becomes a card with its column title as a label, for narrow screens.
        </p>
        <TmDataTable TItem="Employee" Items="_employees" CardMode="true" DefaultPageSize="4">
            <ChildContent>
                <TmDataTableColumn TItem="Employee" Title="Name" PropertyName="Name" Field="e => e.Name" />
                <TmDataTableColumn TItem="Employee" Title="Role" PropertyName="Role" Field="e => e.Role" />
                <TmDataTableColumn TItem="Employee" Title="Dept" PropertyName="Dept" Field="e => e.Dept" />
            </ChildContent>
        </TmDataTable>
    </div>

    <div class="flex items-center gap-3 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Ergonomics — Pin, Resize, Multi-sort</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-indigo-100 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 rounded-full">K2</span>
    </div>
    <div class="showcase-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Drag the column edges to resize, use the header pin toggle to freeze columns left/right (persisted via a layout store),
            Shift+click headers to sort by multiple columns, and expand a row for detail.
        </p>
        <TmDataTable TItem="Employee"
                     Items="_employees"
                     ViewContext="ergonomics-demo"
                     LayoutStore="_layoutStore"
                     OnLoadDetail="LoadEmployeeDetailAsync"
                     DefaultPageSize="8">
            <ChildContent>
                <TmDataTableColumn TItem="Employee" Title="Name" PropertyName="Name" Field="e => e.Name"
                                   Sortable="true" Resizable="true" Pinned="ColumnPin.Left" Width="180px" />
                <TmDataTableColumn TItem="Employee" Title="Role" PropertyName="Role" Field="e => e.Role" Sortable="true" Resizable="true" />
                <TmDataTableColumn TItem="Employee" Title="Dept" PropertyName="Dept" Field="e => e.Dept" Sortable="true" Resizable="true" />
                <TmDataTableColumn TItem="Employee" Title="Score" PropertyName="Score" Field="e => e.Score" Sortable="true" Resizable="true" />
                <TmDataTableColumn TItem="Employee" Title="Email" PropertyName="Email" Field="e => e.Email" Resizable="true" Pinned="ColumnPin.Right" Width="220px" />
            </ChildContent>
            <DetailTemplate Context="emp">
                <div class="text-sm text-slate-600 dark:text-slate-300">
                    <strong>@emp.Name</strong> — @emp.Role in @emp.Dept · score @emp.Score · @emp.Email
                </div>
            </DetailTemplate>
        </TmDataTable>
    </div>
</section>

<!-- Inline editing -->
<section class="demo-section" data-testid="dt-inline-edit-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">@Loc["TmDataTableDemo_InlineEditTitle"]</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-full">Validated</span>
    </div>
    <div class="showcase-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            @Loc["TmDataTableDemo_InlineEditDescription"]
        </p>
        <div data-testid="transaction-table">
            <TmDataTable TItem="TransactionDemo"
                         Items="_transactions"
                         ViewContext="transaction-inline-edit-demo"
                         Editable="true"
                         OnRowSave="HandleTransactionSaved">
                <RowEditValidator>
                    <DataAnnotationsValidator />
                </RowEditValidator>
                <ChildContent>
                    <TmDataTableColumn TItem="TransactionDemo" Title="@Loc["TmDataTableDemo_Date"]" PropertyName="Date" Field="transaction => transaction.Date">
                        <CellTemplate Context="transaction">@transaction.Date.ToString("d")</CellTemplate>
                    </TmDataTableColumn>
                    <TmDataTableColumn TItem="TransactionDemo" Title="@Loc["TmDataTableDemo_Amount"]" PropertyName="Amount" Field="transaction => transaction.Amount" Editable="true">
                        <EditTemplate Context="transaction">
                            <input class="tm-input" data-testid="transaction-amount-input" type="number" step="0.01"
                                   aria-label="@Loc["TmDataTableDemo_Amount"]"
                                   @bind="transaction.Amount" @bind:event="oninput" />
                            <ValidationMessage For="@(() => transaction.Amount)" />
                        </EditTemplate>
                    </TmDataTableColumn>
                    <TmDataTableColumn TItem="TransactionDemo" Title="@Loc["TmDataTableDemo_Category"]" PropertyName="Category" Field="transaction => transaction.Category" Editable="true">
                        <EditTemplate Context="transaction">
                            <select class="tm-input" data-testid="transaction-category-input"
                                    aria-label="@Loc["TmDataTableDemo_Category"]" @bind="transaction.Category">
                                <option value="">@Loc["TmDataTableDemo_SelectCategory"]</option>
                                @foreach (var category in TransactionCategories)
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                            <ValidationMessage For="@(() => transaction.Category)" />
                        </EditTemplate>
                    </TmDataTableColumn>
                    <TmDataTableColumn TItem="TransactionDemo" Title="@Loc["TmDataTableDemo_Note"]" PropertyName="Note" Field="transaction => transaction.Note" Editable="true">
                        <EditTemplate Context="transaction">
                            <input class="tm-input" data-testid="transaction-note-input"
                                   aria-label="@Loc["TmDataTableDemo_Note"]"
                                   @bind="transaction.Note" @bind:event="oninput" />
                            <ValidationMessage For="@(() => transaction.Note)" />
                        </EditTemplate>
                    </TmDataTableColumn>
                </ChildContent>
            </TmDataTable>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-3" data-testid="dt-inline-save-result" aria-live="polite">
            @(_lastSavedTransaction is null
                ? Loc["TmDataTableDemo_SavePlaceholder"]
                : Loc["TmDataTableDemo_SaveResult", _lastSavedTransaction.Value.Category, _lastSavedTransaction.Value.Amount])
        </p>
    </div>
</section>

<!-- Export -->
<section class="demo-section" data-testid="dt-export-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">@Loc["TmDataTableDemo_ExportTitle"]</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full">CSV + XLSX</span>
    </div>
    <div class="showcase-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            @Loc["TmDataTableDemo_ExportDescription"]
        </p>
        <div data-testid="export-table">
            <TmDataTable TItem="TransactionDemo"
                         Items="_transactions"
                         ViewContext="transaction-export-demo"
                         ShowExport="true"
                         CsvDelimiter=";"
                         DefaultPageSize="5">
                <ChildContent>
                    <TmDataTableColumn TItem="TransactionDemo" Title="@Loc["TmDataTableDemo_Date"]" PropertyName="Date" Field="transaction => transaction.Date">
                        <CellTemplate Context="transaction">@transaction.Date.ToString("d")</CellTemplate>
                    </TmDataTableColumn>
                    <TmDataTableColumn TItem="TransactionDemo" Title="@Loc["TmDataTableDemo_Amount"]" PropertyName="Amount" Field="transaction => transaction.Amount" />
                    <TmDataTableColumn TItem="TransactionDemo" Title="@Loc["TmDataTableDemo_Category"]" PropertyName="Category" Field="transaction => transaction.Category" />
                    <TmDataTableColumn TItem="TransactionDemo" Title="@Loc["TmDataTableDemo_Note"]" PropertyName="Note" Field="transaction => transaction.Note" />
                </ChildContent>
            </TmDataTable>
        </div>
    </div>
</section>

<!-- Basic Table -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div class="flex items-center space-x-2">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Basic Client-Side Table</h2>
            <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">Sortable & Filterable</span>
        </div>
        <div class="flex items-center space-x-2">
            <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="@(() => _loading = !_loading)">
                <span class="flex items-center space-x-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    <span>Toggle Loading</span>
                </span>
            </TmButton>
            <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="@(() => _showEmpty = !_showEmpty)">
                <span class="flex items-center space-x-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                    </svg>
                    <span>Toggle Empty</span>
                </span>
            </TmButton>
        </div>
    </div>
    
    <div class="showcase-card p-0 overflow-hidden">
        <TmDataTable TItem="Employee"
                     ViewContext="demo-basic"
                     Items="@(_showEmpty ? [] : _employees)"
                     IsLoading="@_loading"
                     EmptyTitle="No employees found"
                     DefaultPageSize="5"
                     OnRowClick="@OnRowClick">
            <TmDataTableColumn TItem="Employee" Title="Name" PropertyName="Name" Sortable="true" Filterable="true" Field="e => e.Name" />
            <TmDataTableColumn TItem="Employee" Title="Role" PropertyName="Role" Sortable="true" Filterable="true" FilterType="FilterType.Select" FilterOptions="_roleOptions" Field="e => e.Role" />
            <TmDataTableColumn TItem="Employee" Title="Dept" PropertyName="Dept" Sortable="true" Filterable="true" Field="e => e.Dept" />
            <TmDataTableColumn TItem="Employee" Title="Score" PropertyName="Score" Sortable="true" Align="ColumnAlign.Right" Field="e => e.Score" />
            <TmDataTableColumn TItem="Employee" Title="Email" PropertyName="Email" HiddenByDefault="true" Field="e => e.Email" />
        </TmDataTable>
    </div>
    
    @if (_lastClicked is not null)
    {
        <div class="mt-3 p-3 bg-primary-50 dark:bg-primary-900/20 border border-primary-200 dark:border-primary-800 rounded-lg animate-fade-in">
            <p class="text-sm text-slate-700 dark:text-slate-300">
                Last clicked: <span class="font-semibold text-primary-600 dark:text-primary-400">@_lastClicked.Name</span> (@_lastClicked.Role)
            </p>
        </div>
    }
</section>

<!-- Row Attributes -->
<section class="demo-section" data-testid="datatable-row-attributes-demo">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Row Attributes</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-cyan-100 dark:bg-cyan-900/30 text-cyan-700 dark:text-cyan-300 rounded-full">Attributes</span>
    </div>

    <div class="demo-grid demo-grid-3">
        <div class="showcase-card p-0 overflow-hidden" data-testid="datatable-rowattrs-flat">
            <TmDataTable TItem="Employee"
                         ViewContext="demo-rowattrs-flat"
                         Items="_rowAttributeEmployees"
                         ToolbarMode="DataToolbarMode.ContentOnly"
                         ShowPagination="false"
                         RowAttributes='@(employee => GetDemoRowAttributes(employee, "flat"))'>
                <TmDataTableColumn TItem="Employee" Title="Name" Field="e => e.Name" />
                <TmDataTableColumn TItem="Employee" Title="Dept" Field="e => e.Dept" />
            </TmDataTable>
        </div>

        <div class="showcase-card p-0 overflow-hidden" data-testid="datatable-rowattrs-virtual">
            <TmDataTable TItem="Employee"
                         ViewContext="demo-rowattrs-virtual"
                         Items="_rowAttributeEmployees"
                         ToolbarMode="DataToolbarMode.ContentOnly"
                         ScrollMode="DataTableScrollMode.Virtualized"
                         VirtualScrollHeight="220px"
                         RowAttributes='@(employee => GetDemoRowAttributes(employee, "virtual"))'>
                <TmDataTableColumn TItem="Employee" Title="Name" Field="e => e.Name" />
                <TmDataTableColumn TItem="Employee" Title="Dept" Field="e => e.Dept" />
            </TmDataTable>
        </div>

        <div class="showcase-card p-0 overflow-hidden" data-testid="datatable-rowattrs-grouped">
            <TmDataTable @ref="_rowAttributesGroupedTable"
                         TItem="Employee"
                         ViewContext="demo-rowattrs-grouped"
                         Items="_rowAttributeEmployees"
                         ToolbarMode="DataToolbarMode.ContentOnly"
                         ShowGrouping="true"
                         GroupsCollapsedByDefault="false"
                         ShowPagination="false"
                         RowAttributes='@(employee => GetDemoRowAttributes(employee, "grouped"))'>
                <TmDataTableColumn TItem="Employee" Title="Name" PropertyName="Name" Field="e => e.Name" />
                <TmDataTableColumn TItem="Employee" Title="Dept" PropertyName="Dept" Field="e => e.Dept" Groupable="true" />
            </TmDataTable>
        </div>
    </div>
</section>

<!-- Multi-Select Table -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Multi-Select Table</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-full">Selection</span>
    </div>
    
    <div class="showcase-card p-0 overflow-hidden">
        <TmDataTable TItem="Employee"
                     ViewContext="demo-selection"
                     Items="_employees"
                     Selectable="true"
                     ShowPagination="false"
                     OnSelectionChanged="OnSelectionChanged">
            <TmDataTableColumn TItem="Employee" Title="Name" Field="e => e.Name" />
            <TmDataTableColumn TItem="Employee" Title="Role" Field="e => e.Role" />
            <TmDataTableColumn TItem="Employee" Title="Dept" Field="e => e.Dept" />
            <TmDataTableColumn TItem="Employee" Title="Score" Align="ColumnAlign.Right" Field="e => e.Score" />
        </TmDataTable>
    </div>
    
    @if (_selectedEmployees.Count > 0)
    {
        <div class="mt-3 p-3 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-lg animate-fade-in">
            <p class="text-sm text-slate-700 dark:text-slate-300">
                Selected: <span class="font-medium">@string.Join(", ", _selectedEmployees.Select(e => e.Name))</span>
            </p>
        </div>
    }
</section>

<!-- Toolbar Mode Presets -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div class="flex items-center space-x-2">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Toolbar Mode Presets</h2>
            <span class="px-2 py-0.5 text-xs font-medium bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full">Chrome</span>
        </div>
        <TmSelect TValue="DataToolbarMode"
                  Options="_toolbarModeOptions"
                  @bind-Value="_dataTableToolbarMode"
                  Placeholder="Select toolbar mode" />
    </div>

    <div class="showcase-card p-0 overflow-hidden">
        <TmDataTable TItem="Employee"
                     ViewContext="demo-toolbar-mode"
                     Items="_employees"
                     ToolbarMode="_dataTableToolbarMode">
            <TmDataTableColumn TItem="Employee" Title="Name" Field="e => e.Name" />
            <TmDataTableColumn TItem="Employee" Title="Role" Field="e => e.Role" />
            <TmDataTableColumn TItem="Employee" Title="Dept" Field="e => e.Dept" />
            <TmDataTableColumn TItem="Employee" Title="Score" Align="ColumnAlign.Right" Field="e => e.Score" />
        </TmDataTable>
    </div>
</section>

<!-- Page-Owned Filters + Content-Only Table -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div class="flex items-center space-x-2">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Page-Owned Filters + Content-Only Table</h2>
            <span class="px-2 py-0.5 text-xs font-medium bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-300 rounded-full">Composition</span>
        </div>
    </div>

    <div class="p-4 bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-800 rounded-xl mb-4">
        <p class="text-sm text-orange-800 dark:text-orange-200">
            The page owns the filter UI; the table renders only the data surface via <code>ToolbarMode="ContentOnly"</code>.
            This avoids duplicate filtering UI when the surrounding page already provides filters.
        </p>
    </div>

    <div class="flex flex-wrap gap-3 mb-4">
        <TmSelect TValue="string"
                  Options="_deptOptions"
                  @bind-Value="_pageOwnedDeptFilter"
                  Placeholder="Filter by department" />
        <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="ClearPageOwnedFilter">
            Clear
        </TmButton>
    </div>

    <div class="showcase-card p-0 overflow-hidden">
        <TmDataTable TItem="Employee"
                     ViewContext="demo-page-owned"
                     Items="_pageOwnedFilteredEmployees"
                     ToolbarMode="DataToolbarMode.ContentOnly"
                     EmptyTitle="No employees match the filter"
                     DefaultPageSize="5">
            <TmDataTableColumn TItem="Employee" Title="Name" PropertyName="Name" Sortable="true" Field="e => e.Name" />
            <TmDataTableColumn TItem="Employee" Title="Role" PropertyName="Role" Sortable="true" Field="e => e.Role" />
            <TmDataTableColumn TItem="Employee" Title="Dept" PropertyName="Dept" Sortable="true" Field="e => e.Dept" />
            <TmDataTableColumn TItem="Employee" Title="Score" PropertyName="Score" Sortable="true" Align="ColumnAlign.Right" Field="e => e.Score" />
        </TmDataTable>
    </div>
</section>

<!-- Saved Views Without External Filter Builder -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div class="flex items-center space-x-2">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Saved Views Without External Filter Builder</h2>
            <span class="px-2 py-0.5 text-xs font-medium bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full">Views Only</span>
        </div>
    </div>

    <div class="p-4 bg-purple-50 dark:bg-purple-900/20 border border-purple-200 dark:border-purple-800 rounded-xl mb-4">
        <p class="text-sm text-purple-800 dark:text-purple-200">
            Saved views are available through the ViewManager, but the inline external filter builder is hidden.
            Use <code>ShowExternalFilterBuilder="false"</code> to avoid duplicate filter UI.
        </p>
    </div>

    <div class="showcase-card p-0 overflow-hidden">
        <TmDataTable TItem="Employee"
                     ViewContext="demo-views-only"
                     Items="_employees"
                     ViewProvider="_viewProvider"
                     ViewFilterDefinitions="_employeeViewFilterDefs"
                     ShowExternalFilterBuilder="false"
                     ShowSearch="false"
                     ViewCanCreateTenantViews="true"
                     CurrentUserId="@CurrentUserId"
                     CurrentTenantId="@CurrentTenantId"
                     DisplayResolver="ResolveDisplay"
                     DefaultPageSize="5">
            <TmDataTableColumn TItem="Employee" Title="Name" PropertyName="Name" Sortable="true" Field="e => e.Name" />
            <TmDataTableColumn TItem="Employee" Title="Role" PropertyName="Role" Sortable="true" Field="e => e.Role" />
            <TmDataTableColumn TItem="Employee" Title="Dept" PropertyName="Dept" Sortable="true" Field="e => e.Dept" />
            <TmDataTableColumn TItem="Employee" Title="Score" PropertyName="Score" Sortable="true" Align="ColumnAlign.Right" Field="e => e.Score" />
        </TmDataTable>
    </div>
</section>

<!-- Table with External Filter Builder -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div class="flex items-center space-x-2">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">External Filter Builder</h2>
            <span class="px-2 py-0.5 text-xs font-medium bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-300 rounded-full">Advanced</span>
        </div>
    </div>
    
    <div class="p-4 bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-800 rounded-xl mb-4">
        <p class="text-sm text-orange-800 dark:text-orange-200">
            External filters built with <code>TmFilterBuilder</code> applied to DataTable. 
            Filters are sent to server via DataProvider.
        </p>
    </div>

    <!-- Filter Builder Panel -->
    <div class="showcase-card mb-4">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300">Filters</h3>
            <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="ClearFilterBuilder">
                <span class="flex items-center space-x-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                    <span>Clear All</span>
                </span>
            </TmButton>
        </div>
        <TmFilterBuilder FilterDefinitions="@_employeeFilterDefs"
                         ActiveFilters="@_activeEmployeeFilters"
                         OnFiltersChanged="OnEmployeeFiltersChanged"
                         DisplayResolver="ResolveDisplay"
                         ShowClearAll="false" />
    </div>
    
    <div class="showcase-card p-0 overflow-hidden">
        <TmDataTable TItem="Employee"
                     ViewContext="demo-filter-builder"
                     Items="@_filteredEmployees"
                     EmptyTitle="No employees match the filters"
                     DefaultPageSize="5">
            <TmDataTableColumn TItem="Employee" Title="Name" PropertyName="Name" Sortable="true" Field="e => e.Name" />
            <TmDataTableColumn TItem="Employee" Title="Role" PropertyName="Role" Sortable="true" Field="e => e.Role" />
            <TmDataTableColumn TItem="Employee" Title="Dept" PropertyName="Dept" Sortable="true" Field="e => e.Dept" />
            <TmDataTableColumn TItem="Employee" Title="Score" PropertyName="Score" Sortable="true" Align="ColumnAlign.Right" Field="e => e.Score" />
        </TmDataTable>
    </div>
</section>

<!-- Server-Side Table -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Server-Side DataProvider</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full">API</span>
    </div>
    
    <div class="p-4 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-xl mb-4">
        <div class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-blue-600 dark:text-blue-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
                <p class="text-sm text-blue-800 dark:text-blue-200">
                    Uses <code>PersonHttpDataProvider</code> calling <code>/api/persons</code>.
                </p>
