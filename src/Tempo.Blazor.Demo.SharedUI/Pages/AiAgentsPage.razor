</section>

@* ---------------------------------------------------------------------------------------------------------
   The same run in the live monitor. When the run reaches its last step it PAUSES and asks for a decision: the
   host's own TmApprovalCard sits in the monitor's PendingApproval slot. Approving resumes the run; rejecting
   skips the step and finishes the run. *@
<section class="demo-section mb-8" data-testid="ai-agents-monitor-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_MonitorTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">@Loc["TmAiAgentsDemo_MonitorHint"]</p>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <TmAgentMonitor Steps="@MonitorSteps"
                        Status="_runStatus"
                        StartedAt="@_runStartedAt"
                        CompletedAt="@_runCompletedAt"
                        CostMicroUnits="@(_cost > 0 ? _cost : null)"
                        Model="@SelectedModelName"
                        Title="@Loc["TmAiAgentsDemo_MonitorRunTitle"]"
                        Culture="@CultureInfo.CurrentCulture"
                        CostFormatter="FormatCost"
                        PendingApproval="@(_approvalPending ? ApprovalFragment : null)"
                        DataTestId="ai-agents-monitor" />

        <aside class="flex flex-col gap-3" data-testid="ai-agents-monitor-side">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white">@Loc["TmAiAgentsDemo_MonitorSideTitle"]</h3>
            <p class="text-sm text-slate-700 dark:text-slate-300" data-testid="ai-agents-monitor-decision">@ApprovalText</p>
            <p class="text-xs text-slate-500 dark:text-slate-400" data-testid="ai-agents-monitor-hint-note">
                @Loc["TmAiAgentsDemo_MonitorHintNote", Loc["TmApprovalCard_Approve"], Loc["TmApprovalCard_Reject"]]
            </p>
        </aside>
    </div>
</section>

@* ---------------------------------------------------------------------------------------------------------
   The model catalogue — six FICTIONAL models with invented prices, marked as demo data above the picker. The
   page reads the whole AiModelSelection and the monitor's Model metric follows it. *@
<section class="demo-section mb-8" data-testid="ai-agents-models-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_ModelsTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-1">@Loc["TmAiAgentsDemo_ModelsHint"]</p>
    <p class="text-xs text-slate-500 dark:text-slate-400 mb-4" data-testid="ai-agents-models-notice">
        @Loc["TmAiAgentsDemo_ModelsFictional"]
    </p>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <TmModelPicker Models="_models"
                       Selection="_selection"
                       SelectionChanged="OnSelectionChanged"
                       EstimatedPromptTokens="100000"
                       Title="@Loc["TmAiAgentsDemo_ModelsPopupTitle"]"
                       PriceFormatter="FormatPrice"
                       DataTestId="ai-agents-model-picker" />

        <aside class="flex flex-col gap-3" data-testid="ai-agents-models-side">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white">@Loc["TmModelPickerDemo_SelectionTitle"]</h3>
            <p class="text-sm text-slate-700 dark:text-slate-300"
               data-testid="ai-agents-model-selection">@SelectionReadout</p>
            <p class="text-xs text-slate-500 dark:text-slate-400">@Loc["TmAiAgentsDemo_ModelsKeyboardHint"]</p>
        </aside>
    </div>
</section>

@* ---------------------------------------------------------------------------------------------------------
   The context window in ALL THREE presentations over ONE snapshot. Every variant binds the same handlers, so a
   removal or a compaction is offered everywhere and the page applies what the panel reports. *@
<section class="demo-section mb-8" data-testid="ai-agents-context-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_ContextTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">@Loc["TmAiAgentsDemo_ContextHint"]</p>

    <p class="text-sm text-slate-700 dark:text-slate-300 mb-1" data-testid="ai-agents-context-readout">@ContextReadout</p>
    <p class="text-xs text-slate-500 dark:text-slate-400 mb-4" data-testid="ai-agents-context-log">@ContextLogText</p>

    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        <div>
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmContextUsageDemo_BasicTitle"]</h3>
            <TmContextUsage Snapshot="_context"
                            Title="@Loc["TmContextUsageDemo_PanelTitle"]"
                            OnRemoveItem="RemoveAsync"
                            OnCompact="CompactAsync"
                            DataTestId="ai-agents-context-bar" />
        </div>
        <div>
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmContextUsageDemo_GridTitle"]</h3>
            <TmContextUsage Snapshot="_context"
                            Variant="ContextUsageVariant.Grid"
                            Title="@Loc["TmContextUsageDemo_PanelTitle"]"
                            OnRemoveItem="RemoveAsync"
                            OnCompact="CompactAsync"
                            DataTestId="ai-agents-context-grid" />
        </div>
        <div>
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmContextUsageDemo_TreemapTitle"]</h3>
            <TmContextUsage Snapshot="_context"
                            Variant="ContextUsageVariant.Treemap"
                            Title="@Loc["TmContextUsageDemo_PanelTitle"]"
                            OnRemoveItem="RemoveAsync"
                            OnCompact="CompactAsync"
                            DataTestId="ai-agents-context-treemap" />
        </div>
    </div>
    <div class="mt-4">
        <TmButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                  data-testid="ai-agents-context-reset" OnClick="ResetContext">@Loc["TmAiAgentsDemo_ContextReset"]</TmButton>
    </div>
</section>

@* ---------------------------------------------------------------------------------------------------------
   The prompt library: five templates, the selected template's generated form and the live preview. "Use" hands
   the assembled prompt to the page, which shows the exact text a host would send. *@
<section class="demo-section mb-8" data-testid="ai-agents-prompts-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_PromptsTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4" data-testid="ai-agents-prompts-hint">
        @Loc["TmAiAgentsDemo_PromptsHint", Loc["TmPromptLibrary_Use"]]
    </p>

    <div class="grid gap-6 2xl:grid-cols-[minmax(0,1fr)_22rem]">
        <TmPromptLibrary Templates="_templates"
                         SelectedTemplateId="_templateId"
                         SelectedTemplateIdChanged="OnTemplateSelected"
                         Values="_values"
                         ValuesChanged="OnValuesChanged"
                         OnUse="OnUse"
                         Title="@Loc["TmAiAgentsDemo_PromptsLibraryTitle"]"
                         DataTestId="ai-agents-prompts" />

        <aside class="flex flex-col gap-3" data-testid="ai-agents-prompts-side">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white">@Loc["TmAiAgentsDemo_UsedTitle"]</h3>
            @if (_usedPrompt is null)
            {
                <p class="text-sm text-slate-500 dark:text-slate-400" data-testid="ai-agents-used-empty">@Loc["TmAiAgentsDemo_UsedEmpty"]</p>
            }
            else
            {
                <p class="text-sm text-slate-700 dark:text-slate-300" data-testid="ai-agents-used-template">
                    @Loc["TmAiAgentsDemo_UsedLine", _usedTemplateTitle]
                </p>
                <pre class="whitespace-pre-wrap break-words rounded-lg bg-slate-100 p-3 text-sm text-slate-800 dark:bg-slate-800 dark:text-slate-100"
                     data-testid="ai-agents-used-prompt">@_usedPrompt</pre>
            }
            <p class="text-xs text-slate-500 dark:text-slate-400">@Loc["TmAiAgentsDemo_UsedHint"]</p>
        </aside>
    </div>
</section>

@code {
    private TimeProvider _clock = TimeProvider.System;
    private ITimer? _timer;

    private IReadOnlyList<AiModelInfo> _models = [];
    private IReadOnlyList<PromptTemplate> _templates = [];
    private IReadOnlyList<AgentRunNode> _runNodes = [];
    private AgentLanesSnapshot _lanes = new();
    private string? _laneBlockId;
    private AgentGraphSnapshot _graph = new();
    private IReadOnlyList<AgentGraphCall> _graphCalls = [];
    private long _graphSequence;
    private string? _graphNodeId;
    private IReadOnlyList<FanOutTask> _fanOutTasks = [];
    private FanOutFilter _fanOutFilter = FanOutFilter.All;
    private string? _fanOutRetriedId;
    private IReadOnlyList<ParallelAttempt> _attempts = [];
    private IReadOnlyList<HandoffStep> _handoffSteps = [];
    private HandoffOrientation _handoffOrientation = HandoffOrientation.Vertical;
    private IReadOnlyList<AutonomyLevel> _autonomyLevels = [];
    private IReadOnlyList<AutonomyLock> _autonomyLocks = [];
    private AutonomyDialPresentation _autonomyPresentation = AutonomyDialPresentation.Dial;
    private int _autonomyValue = 1;
    private string? _autonomyLoggedLabel;
    private IReadOnlyList<MemoryItem> _memories = [];
    private bool _memoryEnabled = true;
    private string _memoryFilter = string.Empty;
    private string? _memoryLogKey;
    private string? _memoryLogValue;
    private IReadOnlyList<DelegateTask> _delegateTasks = [];
    private IReadOnlyList<DelegateAgent> _delegateAgents = [];
    private bool _delegateAuto;
    private string? _delegateLogKey;
    private string? _delegateLogValue;
    private string? _delegateLogSecond;
    private IReadOnlyList<RunWindow> _runWindows = [];
    private IReadOnlyList<ScheduledRun> _scheduledRuns = [];
    private RunViewMode _runsView = RunViewMode.Week;
    private string? _runsLogKey;
    private string? _runsLogValue;
    private string? _runsLogSecond;
    private IReadOnlyList<AgentBranchChanges> _branchChanges = [];
    private IReadOnlyList<ConflictResolution> _radarResolutions = [];
    private ConflictMergeRequest? _radarMerge;
    private IReadOnlyList<PresenceMarker> _presenceMarkers = [];
    private IReadOnlyList<FallbackAttempt> _fallbackAttempts = [];
    private IReadOnlyList<FallbackChainEntry>? _fallbackChain;
    private FallbackResolutionPolicy _fallbackPolicy = FallbackResolutionPolicy.Fallback;
    private FallbackChainMode _fallbackMode = FallbackChainMode.View;
    private string? _bestAttemptId;
    private string? _attemptWinnerId;
    private string? _attemptChosenId;
    private IReadOnlyList<AgentPlanStep> _reviewSteps = [];
    private IReadOnlyList<AgentPlanStep> _runSteps = [];
    private ContextUsageSnapshot _context = new();
    private IReadOnlyDictionary<string, string?>? _values;

    private AiModelSelection? _selection;
    private AgentPlanEdit? _lastEdit;
    private string? _planDecision;
    private string? _runStateKey = "TmAiAgentsDemo_StateReview";
    private string? _selectedNodeId;
    private string? _templateId;
    private string? _usedPrompt;
    private string? _usedTemplateTitle;
    private string? _contextLogKey;
    private string? _approvalDecision;

    private bool _showReview = true;
    private bool _failureInjected;
    private bool _approvalPending;
    private ApprovalState _approvalState = ApprovalState.Pending;
    private DateTimeOffset? _approvalExpiresAt;
    private AgentStepStatus _runStatus = AgentStepStatus.Pending;
    private DateTimeOffset? _runStartedAt;
    private DateTimeOffset? _runCompletedAt;
    private long _cost;

    /// <summary>The page's copy of the localizer, in the shape the sample-data builders take.</summary>
    private string Key(string key) => Loc[key];

    protected override void OnInitialized()
    {
        // Every demo host registers the clock (AddTempoDemoClock), and the page drives its simulated run
        // from it: a test replaces it with a FakeTimeProvider and the whole walk becomes deterministic.
        _clock = Clock;

        ResetScenario();
        ResetContext();

        _models = AiAgentsPageSamples.Models(Key);
        _lanes = AiAgentsPageSamples.LanesSnapshot(Key, _clock.GetUtcNow());
        _graph = AiAgentsPageSamples.GraphSnapshot(Key, _clock.GetUtcNow());
        _graphSequence = _graph.Sequence;
        _fanOutTasks = AiAgentsPageSamples.FanOutTasks(_clock.GetUtcNow());
        _attempts = AiAgentsPageSamples.Attempts();
        _handoffSteps = AiAgentsPageSamples.HandoffSteps(_clock.GetUtcNow());
        _fallbackAttempts = AiAgentsPageSamples.FallbackAttempts(_clock.GetUtcNow());
        _autonomyLevels = AiAgentsPageSamples.AutonomyLevels();
        _autonomyLocks = AiAgentsPageSamples.AutonomyLocks();
        _memories = AiAgentsPageSamples.Memories(_clock.GetUtcNow());
        _delegateAgents = AiAgentsPageSamples.DelegateAgents(_clock.GetUtcNow());
        _delegateTasks = AiAgentsPageSamples.DelegateTasks();
        _runWindows = AiAgentsPageSamples.RunWindows(_clock.GetUtcNow());
        _scheduledRuns = AiAgentsPageSamples.ScheduledRuns();
        _branchChanges = AiAgentsPageSamples.BranchChanges();
        _presenceMarkers =
        [
            .. PresenceMarkerAdapter.ToMarkers(AiAgentsPageSamples.CollaboratorCursors())
                .Select((marker, index) => index == 2
                    ? marker with { Activity = PresenceActivity.Commenting }
                    : marker),
        ];
        _bestAttemptId = "draft-b";
        _selection = new AiModelSelection("aurora-pro");
        _templates = AiAgentsPageSamples.Templates(Key);
        _templateId = "release-notes";
        _values = AiAgentsPageSamples.InitialValues(Key);
    }

    /// <summary>
    /// The simulated run's state sentence. It is derived from the state KEYS rather than stored as literal text,
    /// so switching the demo's language re-localizes the page instead of freezing the old language in a field.
    /// </summary>
    private string RunStateText => _runStateKey switch
    {
        "TmAiAgentsDemo_StateRunning" => Loc[_runStateKey,
            DoneCount.ToString(CultureInfo.CurrentCulture),
            _runSteps.Count.ToString(CultureInfo.CurrentCulture)],
        "TmAiAgentsDemo_StateFailed" => Loc[_runStateKey,
            FailedStepTitle ?? string.Empty,
            _runSteps.FirstOrDefault(step => step.Status == AgentStepStatus.Failed)?.Error ?? string.Empty],
        "TmAiAgentsDemo_StateDone" => Loc[_runStateKey,
            _runSteps.Count.ToString(CultureInfo.CurrentCulture)],
        _ => Loc[_runStateKey ?? "TmAiAgentsDemo_StateReview"],
    };

    private string LastEditText => _lastEdit switch
    {
        null => Loc["TmAiAgentsDemo_NoEdit"],
        { Kind: AgentPlanEditKind.Rename } edit when edit.Title is not null
            => Loc["TmAiAgentsDemo_EditRename", Position(edit.Index), edit.Title],
        { Kind: AgentPlanEditKind.Add } edit => Loc["TmAiAgentsDemo_EditAdd", Position(edit.Index)],
        { Kind: AgentPlanEditKind.Remove } edit => Loc["TmAiAgentsDemo_EditRemove", Position(edit.Index)],
        { Kind: AgentPlanEditKind.Reorder } edit
            => Loc["TmAiAgentsDemo_EditReorder", Position(edit.FromIndex ?? 0), Position(edit.ToIndex ?? 0)],
        _ => Loc["TmAiAgentsDemo_NoEdit"],
    };

    private string DecisionText => _planDecision switch
    {
        "approved" => Loc["TmAiAgentsDemo_PlanApproved", Loc["TmAgentPlan_Approve"]],
        null => Loc["TmAiAgentsDemo_NoDecision"],
        _ => Loc["TmAiAgentsDemo_NoDecision"],
    };

    private int DoneCount => _runSteps.Count(step => step.Status == AgentStepStatus.Done);

    private string? FailedStepTitle =>
        _runSteps.FirstOrDefault(step => step.Status == AgentStepStatus.Failed)?.Title;

    private string SelectedReadout => _selectedNodeId is { } id
        ? _runNodes.FirstOrDefault(node => string.Equals(node.Id, id, StringComparison.Ordinal)) is { } node
            ? Loc["TmAgentRunDemo_Selected", node.Title]
            : Loc["TmAgentRunDemo_NoSelection"]
        : Loc["TmAgentRunDemo_NoSelection"];

    /// <summary>The live monitor's steps, mapped from the SAME plan the run drives.</summary>
    private IReadOnlyList<AgentMonitorStep> MonitorSteps => _runSteps
        .Select((step, index) => new AgentMonitorStep(step.Title, step.Id)
        {
            Kind = index switch
            {
                0 => AgentStepKind.Thinking,
                1 => AgentStepKind.ToolCall,
                2 => AgentStepKind.Result,
                _ => AgentStepKind.Approval,
            },
            Status = step.Status,
            StartedAt = step.StartedAt,
            CompletedAt = step.CompletedAt,
            Detail = index switch
            {
                0 => "invoices.read",
                1 => "ledger.match",
                2 => "ledger.reconcile",
                _ => "report.publish",
            },
        })
        .ToList();

    private string SelectedModelName => _selection is { } selection
        ? _models.FirstOrDefault(model => model.Id == selection.ModelId)?.Name ?? selection.ModelId
        : Loc["TmModelPickerDemo_NotSet"];

    private string SelectionReadout => _selection is { } selection
        ? Loc["TmModelPickerDemo_Readout", SelectedModelName, OnOff(selection.ExtendedThinking), EffortOf(selection)]
        : Loc["TmModelPickerDemo_SelectionEmpty"];

    private string ApprovalText => _approvalDecision switch
    {
        "approved" => Loc["TmAiAgentsDemo_ApprovalApproved", Loc["TmApprovalCard_Approve"]],
        "rejected" => Loc["TmAiAgentsDemo_ApprovalRejected", Loc["TmApprovalCard_Reject"]],
        _ when _approvalPending => Loc["TmAiAgentsDemo_ApprovalPending"],
        _ => Loc["TmAiAgentsDemo_ApprovalWaiting"],
    };

    /// <summary>The selection read-out: the block's own label, or the localized "nothing selected" sentence.</summary>
    private string LanesSelectedText => _laneBlockId is { } id
        ? _lanes.Blocks.FirstOrDefault(block => string.Equals(block.Id, id, StringComparison.Ordinal)) is { } block
            ? Loc["TmAiAgentsDemo_LanesSelected", block.Label]
            : Loc["TmAiAgentsDemo_LanesNoSelection"]
        : Loc["TmAiAgentsDemo_LanesNoSelection"];

    /// <summary>The selection read-out of the graph: the node's name, or the localized "nothing selected" sentence.</summary>
    /// <summary>
    /// The fan-out's log line: the page's reaction to the retry the reader asked for, or an empty line before one.
    /// It is derived from the task list rather than stored as text, so switching language re-localizes it.
    /// </summary>
    private string FanOutLogText => _fanOutRetriedId is { } id && FindFanOutTask(id) is { } task
        ? Loc["TmAiAgentsDemo_FanOutRetried", FanOutLabel(task)]
        : string.Empty;

    /// <summary>The attempts' log line: which draft the page recorded as the result.</summary>
    private string AttemptLogText => _attemptChosenId is { } id
        ? Loc["TmAiAgentsDemo_ParallelChosen", AttemptLabel(id)]
        : Loc["TmAiAgentsDemo_ParallelNothingChosen"];

    /// <summary>A unit of work's label, or the localized fallback when the host left it empty.</summary>
    private string FanOutLabel(FanOutTask task)
        => task.HasLabel ? task.Label : Loc["TmFanOutGrid_TileFallback"];

    private FanOutTask? FindFanOutTask(string id)
        => _fanOutTasks.FirstOrDefault(task => string.Equals(task.Id, id, StringComparison.Ordinal));

    /// <summary>An attempt's label, or the localized numbered fallback.</summary>
    private string AttemptLabel(string id)
    {
        var index = _attempts
            .Select((attempt, position) => (attempt, position))
            .FirstOrDefault(entry => string.Equals(entry.attempt.Id, id, StringComparison.Ordinal));

        if (index.attempt is null)
        {
            return id;
        }

        return index.attempt.HasLabel
            ? index.attempt.Label
            : Loc["TmParallelAttempts_AttemptFallback", (index.position + 1).ToString(CultureInfo.CurrentCulture)];
    }

    /// <summary>
    /// The page's retry handler: the unit of work goes back to the queue with one more attempt, so the tile the
    /// reader acted on really changes state (the component never mutates a task).
    /// </summary>
    private void RetryFanOutTask(FanOutTask task)
    {
        _fanOutRetriedId = task.Id;
        _fanOutTasks =
        [
            .. _fanOutTasks.Select(current => string.Equals(current.Id, task.Id, StringComparison.Ordinal)
                ? current with
                {
                    Status = AgentActivityStatus.Queued,
                    Attempt = current.EffectiveAttempt + 1,
                    Error = null,
                    StartedAt = null,
                    EstimatedEndAt = _clock.GetUtcNow().AddMinutes(1),
                }
                : current),
        ];
    }

    /// <summary>The page's winner handler: it only records what the component reports after the confirmation.</summary>
    private void AcceptAttempt(string attemptId) => _attemptChosenId = attemptId;

    // ── Handoff and fallback ─────────────────────────────────────────────────

    /// <summary>The two directions the handoff chain can be laid out in.</summary>
    private IReadOnlyList<SegmentedOption<HandoffOrientation>> HandoffOrientationOptions => _handoffOrientationOptions
        ??= [
            new() { Label = Loc["TmAiAgentsDemo_HandoffVertical"], Value = HandoffOrientation.Vertical },
            new() { Label = Loc["TmAiAgentsDemo_HandoffHorizontal"], Value = HandoffOrientation.Horizontal },
        ];

    /// <summary>The two presentations of the fallback surface: the recorded run, or the editor over the chain.</summary>
    private IReadOnlyList<SegmentedOption<FallbackChainMode>> FallbackModeOptions => _fallbackModeOptions
        ??= [
            new() { Label = Loc["TmAiAgentsDemo_FallbackRun"], Value = FallbackChainMode.View },
            new() { Label = Loc["TmAiAgentsDemo_FallbackEdit"], Value = FallbackChainMode.Edit },
        ];

    private IReadOnlyList<SegmentedOption<HandoffOrientation>>? _handoffOrientationOptions;
    private IReadOnlyList<SegmentedOption<FallbackChainMode>>? _fallbackModeOptions;

    /// <summary>The page owns the direction; the component only reports it.</summary>
    private void OnHandoffOrientationChanged(HandoffOrientation orientation) => _handoffOrientation = orientation;

    /// <summary>The page owns whether the fallback surface reports the run or edits the chain.</summary>
    private void OnFallbackModeChanged(FallbackChainMode mode) => _fallbackMode = mode;

    /// <summary>The page owns the policy; a pick in the editor comes back here.</summary>
    private void OnFallbackPolicyChanged(FallbackResolutionPolicy policy) => _fallbackPolicy = policy;

    /// <summary>
    /// The page RECORDS the chain the editor reports — it never reorders a list the component handed back. Until the
    /// reader edits anything the page has no chain of its own and the component derives one from the run.
    /// </summary>
    private Task OnFallbackChainChanged(IReadOnlyList<FallbackChainEntry> chain)
    {
        _fallbackChain = chain;
        return Task.CompletedTask;
    }

    /// <summary>The chain as the page reads it: the edited one, or the one the run implies.</summary>
    private IReadOnlyList<FallbackChainEntry> FallbackChain => _fallbackChain
        ?? [.. _fallbackAttempts.Select(attempt => new FallbackChainEntry(attempt.ModelId, attempt.Label))];

    /// <summary>The chain the page would fall back through, as one line: the edit the reader made is visible here.</summary>
    /// <summary>The two presentations of the autonomy dial: the slider, or one segment per grade.</summary>
    private IReadOnlyList<SegmentedOption<AutonomyDialPresentation>> AutonomyPresentationOptions =>
        _autonomyPresentationOptions ??=
        [
            new() { Label = Loc["TmAiAgentsDemo_AutonomyDial"], Value = AutonomyDialPresentation.Dial },
            new() { Label = Loc["TmAiAgentsDemo_AutonomySegmented"], Value = AutonomyDialPresentation.Segmented },
        ];

    private IReadOnlyList<SegmentedOption<AutonomyDialPresentation>>? _autonomyPresentationOptions;

    /// <summary>The grade the page's dial currently reports, by its label.</summary>
    private string AutonomyLevelLabel
        => _autonomyLevels.FirstOrDefault(level => level.Value == _autonomyValue)?.Label ?? string.Empty;

    /// <summary>The last autonomy change the page received, or an honest "nothing yet".</summary>
    private string AutonomyText => _autonomyLoggedLabel is null
        ? Loc["TmAiAgentsDemo_NoEvent"]
        : Loc["TmAiAgentsDemo_Received", Loc["TmAutonomyDial_Announce", _autonomyLoggedLabel]];

    /// <summary>The last delegate-board change the page received, or an honest "nothing yet".</summary>
    private string DelegateText => _delegateLogKey is null
        ? Loc["TmAiAgentsDemo_NoEvent"]
        : Loc["TmAiAgentsDemo_Received", LogSentence(_delegateLogKey, _delegateLogValue, _delegateLogSecond)];

    /// <summary>The last scheduled-runs change the page received, or an honest "nothing yet".</summary>
    private string RunsText => _runsLogKey is null
        ? Loc["TmAiAgentsDemo_NoEvent"]
        : Loc["TmAiAgentsDemo_Received", LogSentence(_runsLogKey, _runsLogValue, _runsLogSecond)];

    /// <summary>
    /// One localized sentence from a key and up to two host values. A key that takes no placeholders ignores the extra
    /// arguments (string.Format does), so the page never prints a raw <c>{0}</c>.
    /// </summary>
    private string LogSentence(string key, string? first, string? second)
        => Loc[key, first ?? string.Empty, second ?? string.Empty];

    private Task OnDelegateAutoChanged(bool auto)
