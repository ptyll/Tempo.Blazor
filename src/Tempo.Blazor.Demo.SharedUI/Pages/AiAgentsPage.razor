    /// <summary>Applies a removal the panel reported: the section, or one of its entries.</summary>
    private Task RemoveAsync(ContextUsageRemoval removal)
    {
        var sections = _context.Sections ?? [];

        if (removal.Item is null)
        {
            _context = _context with
            {
                Sections = sections.Where(section => section.Key != removal.SectionKey).ToList(),
            };
            _contextLogKey = Loc["TmContextUsageDemo_LogRemovedSection", removal.SectionLabel];
        }
        else
        {
            var item = removal.Item;
            _context = _context with
            {
                Sections = sections.Select(section => section.Key != removal.SectionKey
                    ? section
                    : section with
                    {
                        Items = (section.Items ?? []).Where(entry => entry.Id != item.Id).ToList(),
                        Tokens = Math.Max(0, section.Tokens - item.Tokens),
                    }).ToList(),
            };
            _contextLogKey = Loc["TmContextUsageDemo_LogRemovedItem", item.Label, removal.SectionLabel];
        }

        return Task.CompletedTask;
    }

    /// <summary>Applies a compaction: every optional section is summarised down to a fifth of its tokens.</summary>
    private Task CompactAsync()
    {
        var sections = _context.Sections ?? [];
        _context = _context with
        {
            Sections = sections.Select(section => ContextUsageMath.IsCompactable(section)
                ? section with
                {
                    IsSummarized = true,
                    Items = null,
                    Tokens = (int)Math.Ceiling(ContextUsageMath.TokensOf(section) * 0.2),
                }
                : section).ToList(),
        };
        _contextLogKey = Loc["TmContextUsageDemo_LogCompacted"];
        return Task.CompletedTask;
    }

