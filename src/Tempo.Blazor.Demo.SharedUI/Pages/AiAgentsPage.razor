    /// <summary>
    /// The demo's own cost presentation: the browser keeps the invariant culture, whose currency symbol is the
    /// generic "¤", so the symbol AND its side come from two localized keys and the amount from the current
    /// culture.
    /// </summary>
    private string FormatCost(long microUnits)
    {
        var units = microUnits / 1_000_000m;
        var decimals = units != 0m && Math.Abs(units) < 0.01m ? 6 : 2;
        var amount = units.ToString("N" + decimals.ToString(CultureInfo.InvariantCulture), CultureInfo.CurrentCulture);

        return Loc["TmAgentRunDemo_CurrencyPrefix"] + amount + Loc["TmAgentRunDemo_CurrencySuffix"];
    }

