    private void SimulateGraphCall()
    {
        var edges = new[] { "g-search", "g-leger", "g-code" };
        var edgeId = edges[_graphCalls.Count % edges.Length];

        _graphCalls = [.. _graphCalls, new AgentGraphCall(++_graphSequence) { EdgeId = edgeId, At = _clock.GetUtcNow() }];
    }

