@page "/ai-agents"
@implements IDisposable
@using System.Globalization
@using Tempo.Blazor.Abstractions.Models.Approvals
@using Tempo.Blazor.AI.Models
@using Tempo.Blazor.Components.AI
@using Tempo.Blazor.Components.Approvals
@inject TimeProvider Clock
@inject ITmLocalizer Loc

@* ONE demo page for the whole AI package: the plan is reviewed (and edited) and then RUN as a controlled
   simulation, the same run is watched in the tree and in the monitor (which asks for a real approval through
   the core TmApprovalCard), the model is picked from a FICTIONAL catalogue, the context window is measured in
   all three presentations and the prompt library assembles a prompt from a template. The page owns every piece
   of state: the components only report intent. *@
<PageTitle>@Loc["TmAiAgentsDemo_PageTitle"] – Tempo.Blazor</PageTitle>

<div class="mb-8" data-testid="ai-agents-page-header">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_PageTitle"]</h1>
    <p class="text-slate-600 dark:text-slate-400">@Loc["TmAiAgentsDemo_PageDescription"]</p>
    <div role="note"
         class="mt-3 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-700 dark:bg-amber-950/40 dark:text-amber-100"
         data-testid="ai-agents-demo-notice">
        @Loc["TmAiAgentsDemo_DemoNotice"]
    </div>
</div>

@* ---------------------------------------------------------------------------------------------------------
   The plan: reviewed and edited first, then watched while it runs. The page applies every edit the component
   proposes (the component never mutates the list) and drives the simulated run from the injected clock, so the
   whole walk is reproducible with a fake TimeProvider in tests. One step fails on purpose and offers Retry. *@
<section class="demo-section mb-8" data-testid="ai-agents-plan-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_PlanTitle"]</h2>
    @* The hint NAMES the two buttons the reader is told to press, so it formats their real labels
       (TmAgentPlan_Run / TmAgentPlan_RetryFrom): a translated sentence that keeps an English button name
       describes a control the user cannot find. *@
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4" data-testid="ai-agents-plan-hint">
        @Loc["TmAiAgentsDemo_PlanHint", Loc["TmAgentPlan_Run"], Loc["TmAgentPlan_RetryFrom"]]
    </p>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <div>
            @if (_showReview)
            {
                <TmAgentPlan Steps="_reviewSteps"
                             OnPlanChanged="OnPlanChanged"
                             OnApprove="ApprovePlan"
                             OnRun="StartRun"
                             Title="@Loc["TmAiAgentsDemo_PlanComponentTitle"]"
                             DataTestId="ai-agents-plan" />
            }
            else
            {
                <TmAgentPlan Steps="_runSteps"
                             Mode="AgentPlanMode.Running"
                             OnRetryFrom="RetryFrom"
                             Title="@Loc["TmAiAgentsDemo_PlanComponentTitle"]"
                             DataTestId="ai-agents-plan-run" />
            }
        </div>

        <aside class="flex flex-col gap-3" data-testid="ai-agents-plan-side">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white">@Loc["TmAiAgentsDemo_PlanSideTitle"]</h3>
            @* The run state changes with no user action (a step fails, an approval is requested, the run
               finishes), so it is a polite status region. The monitor already announces its own steps; the
               page's "failed → Retry" instruction had no announcement path at all. The decision line below
               stays plain: the same change announced twice is noise. *@
            <p class="text-sm text-slate-700 dark:text-slate-300"
               role="status"
               aria-live="polite"
               data-testid="ai-agents-run-state">@RunStateText</p>
            <p class="text-sm text-slate-700 dark:text-slate-300" data-testid="ai-agents-plan-last-edit">@LastEditText</p>
            <p class="text-sm text-slate-700 dark:text-slate-300" data-testid="ai-agents-plan-decision">@DecisionText</p>
            <p class="text-xs text-slate-500 dark:text-slate-400" data-testid="ai-agents-plan-keyboard-hint">
                @Loc["TmAiAgentsDemo_PlanKeyboardHint", Loc["TmAgentPlan_RetryFrom"]]
            </p>
            <TmButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                      data-testid="ai-agents-reset" OnClick="ResetScenario">@Loc["TmAiAgentsDemo_Reset"]</TmButton>
        </aside>
    </div>
</section>

@* ---------------------------------------------------------------------------------------------------------
   The run as a tree: a root, THREE sub-agents and their tool calls. The root rolls its whole subtree up, the
   failed matcher keeps its ancestors visible under the filter, and selecting a row fills the page's detail. *@
<section class="demo-section mb-8" data-testid="ai-agents-tree-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_TreeTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">@Loc["TmAiAgentsDemo_TreeHint"]</p>

    @* The treegrid gets the FULL content width: its six metric columns are wider than a 20 rem side
       column would leave, and a clipped Tokens column is a number a reader cannot see. The selection
       read-out and the keyboard hint sit above the grid instead. *@
    <p class="text-sm text-slate-700 dark:text-slate-300" data-testid="ai-agents-tree-selected">@SelectedReadout</p>
    <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">@Loc["TmAgentRunDemo_KeyboardHint"]</p>

    <TmAgentRunTree Nodes="_runNodes"
                    SelectedNodeId="_selectedNodeId"
                    SelectedNodeIdChanged="OnNodeSelected"
                    Title="@Loc["TmAiAgentsDemo_TreeRunTitle"]"
                    Culture="@CultureInfo.CurrentCulture"
                    CostFormatter="FormatCost"
                    DataTestId="ai-agents-tree">
        <DetailTemplate Context="node">
            <div data-testid="ai-agents-tree-detail" data-node-id="@node.Id">
                <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-2">@node.Title</h3>
                <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
                    <dt class="text-slate-500 dark:text-slate-400">@Loc["TmAgentRunDemo_DetailKind"]</dt>
                    <dd class="text-slate-800 dark:text-slate-200" data-testid="ai-agents-tree-detail-kind">@KindText(node.Kind)</dd>
                    <dt class="text-slate-500 dark:text-slate-400">@Loc["TmAgentRunDemo_DetailStatus"]</dt>
                    <dd class="text-slate-800 dark:text-slate-200" data-testid="ai-agents-tree-detail-status">@StatusText(node.Status)</dd>
                    <dt class="text-slate-500 dark:text-slate-400">@Loc["TmAgentRunDemo_DetailCost"]</dt>
                    <dd class="text-slate-800 dark:text-slate-200">@Cost(node.CostMicroUnits)</dd>
                    <dt class="text-slate-500 dark:text-slate-400">@Loc["TmAgentRunDemo_DetailTotal"]</dt>
                    <dd class="text-slate-800 dark:text-slate-200" data-testid="ai-agents-tree-detail-total">@SubtreeTotal(node)</dd>
                </dl>
                @if (!string.IsNullOrWhiteSpace(node.Error))
                {
                    <p class="mt-2 text-sm text-red-600 dark:text-red-400">@node.Error</p>
                }
            </div>
        </DetailTemplate>
    </TmAgentRunTree>
</section>

@* ---------------------------------------------------------------------------------------------------------
   The same run on a shared time axis: one lane per agent, a block per activity, handoff arrows, the approval verdict
   on the block that carries it and the current moment as a live line. The page owns the snapshot and the selection;
   the table view is the text alternative and carries exactly the same blocks and handoffs. *@
<section class="demo-section mb-8" data-testid="ai-agents-lanes-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_LanesTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">@Loc["TmAiAgentsDemo_LanesHint"]</p>
    <p class="text-sm text-slate-700 dark:text-slate-300 mb-4" data-testid="ai-agents-lanes-selected">@LanesSelectedText</p>

    <TmAgentLanes Snapshot="_lanes"
                  @bind-SelectedBlockId="_laneBlockId"
                  Title="@Loc["TmAiAgentsDemo_LanesRunTitle"]"
                  Culture="@CultureInfo.CurrentCulture"
                  DataTestId="ai-agents-lanes">
        <DetailTemplate Context="block">
            <div data-testid="ai-agents-lanes-detail" data-block-id="@block.Id">
                <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-2">@block.Label</h3>
                <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
                    <dt class="text-slate-500 dark:text-slate-400">@Loc["TmAgentRunDemo_DetailKind"]</dt>
                    <dd class="text-slate-800 dark:text-slate-200" data-testid="ai-agents-lanes-detail-kind">@block.Kind</dd>
                    <dt class="text-slate-500 dark:text-slate-400">@Loc["TmAgentRunDemo_DetailStatus"]</dt>
                    <dd class="text-slate-800 dark:text-slate-200" data-testid="ai-agents-lanes-detail-status">@block.Status</dd>
                    <dt class="text-slate-500 dark:text-slate-400">@Loc["TmAgentLanes_TimeAxisLabel"]</dt>
                    <dd class="text-slate-800 dark:text-slate-200">@LanesBlockSpan(block)</dd>
                </dl>
            </div>
        </DetailTemplate>
    </TmAgentLanes>
</section>

@* ---------------------------------------------------------------------------------------------------------
   The same run as a NETWORK: the human who asked, the agents, the ledger and the two tools, with the call counts of
   the lane view above. The page owns the snapshot, the selection and the calls it pushes, so the pulse a reader sees
   is the component applying a real AgentGraphCall event — not a decoration. *@
<section class="demo-section mb-8" data-testid="ai-agents-graph-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_GraphTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">@Loc["TmAiAgentsDemo_GraphHint"]</p>
    <div class="flex flex-wrap items-center gap-3 mb-3">
        <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm"
                  data-testid="ai-agents-graph-call" OnClick="SimulateGraphCall">@Loc["TmAiAgentsDemo_GraphCall"]</TmButton>
        <p class="text-sm text-slate-700 dark:text-slate-300" data-testid="ai-agents-graph-call-log">@GraphCallText</p>
        <p class="text-sm text-slate-700 dark:text-slate-300" data-testid="ai-agents-graph-selected">@GraphSelectedText</p>
    </div>

    <TmAgentGraph Snapshot="_graph"
                  Events="_graphCalls"
                  @bind-SelectedNodeId="_graphNodeId"
                  Title="@Loc["TmAiAgentsDemo_GraphRunTitle"]"
                  TimeProvider="_clock"
                  Culture="@CultureInfo.CurrentCulture"
                  DataTestId="ai-agents-graph">
        <DetailTemplate Context="node">
            <div data-testid="ai-agents-graph-detail" data-node-id="@node.Id">
                <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-2">@GraphNodeName(node)</h3>
                <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
                    <dt class="text-slate-500 dark:text-slate-400">@Loc["TmAgentRunDemo_DetailKind"]</dt>
                    <dd class="text-slate-800 dark:text-slate-200" data-testid="ai-agents-graph-detail-kind">@node.Kind</dd>
                    <dt class="text-slate-500 dark:text-slate-400">@Loc["TmAgentRunDemo_DetailStatus"]</dt>
                    <dd class="text-slate-800 dark:text-slate-200" data-testid="ai-agents-graph-detail-status">@node.Status</dd>
                    <dt class="text-slate-500 dark:text-slate-400">@Loc["TmAiAgentsDemo_GraphDetailCalls"]</dt>
                    <dd class="text-slate-800 dark:text-slate-200" data-testid="ai-agents-graph-detail-calls">@GraphCallsOf(node.Id)</dd>
                </dl>
            </div>
        </DetailTemplate>
    </TmAgentGraph>
</section>

@* ---------------------------------------------------------------------------------------------------------
   The same run SPLIT: eighteen units of work across four workers. The page owns the task list, so the Retry a
   reader asks for in a tile's detail is the page's own handler re-queuing the unit — not a decoration. *@
<section class="demo-section mb-8" data-testid="ai-agents-fan-out-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_FanOutTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">@Loc["TmAiAgentsDemo_FanOutHint"]</p>
    <p class="text-sm text-slate-700 dark:text-slate-300 mb-3"
       data-testid="ai-agents-fan-out-log">@FanOutLogText</p>

    <TmFanOutGrid Tasks="_fanOutTasks"
                  @bind-Filter="_fanOutFilter"
                  Title="@Loc["TmAiAgentsDemo_FanOutTitle"]"
                  TimeProvider="_clock"
                  Culture="@CultureInfo.CurrentCulture"
                  CostFormatter="FormatCost"
                  OnRetry="RetryFanOutTask"
                  DataTestId="ai-agents-fan-out" />
</section>

@* ---------------------------------------------------------------------------------------------------------
   The same task attempted three ways. The page owns the attempts and only RECORDS the winner the component
   reports after the reader confirmed it. *@
<section class="demo-section mb-8" data-testid="ai-agents-attempts-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_ParallelTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">@Loc["TmAiAgentsDemo_ParallelHint"]</p>
    <p class="text-sm text-slate-700 dark:text-slate-300 mb-3"
       data-testid="ai-agents-attempts-log">@AttemptLogText</p>

    <TmParallelAttempts Attempts="_attempts"
                        BestAttemptId="_bestAttemptId"
                        @bind-SelectedAttemptId="_attemptWinnerId"
                        OnSelect="AcceptAttempt"
                        Title="@Loc["TmAiAgentsDemo_ParallelTitle"]"
                        Culture="@CultureInfo.CurrentCulture"
                        DataTestId="ai-agents-attempts">
        <ContentTemplate Context="attempt">
            @* The attempt's SUBMITTED body is host data, exactly like the votes' rationales: the component never
               localizes it and only places it inside the attempt's own column. *@
            @* The demo's global `pre` rule paints a dark block, so the SUBMITTED body keeps the light ink that
               block expects (a slate-700 body on slate-800 was unreadable and failed the contrast scan). *@
            <pre class="text-xs text-slate-100 whitespace-pre-wrap mb-0"
                 data-testid="ai-agents-attempt-body"
                 data-attempt-id="@attempt.Id">@AiAgentsPageSamples.AttemptBody(attempt.Id)</pre>
        </ContentTemplate>
    </TmParallelAttempts>
</section>

@* ---------------------------------------------------------------------------------------------------------
   The same work passed from agent to agent. The page owns the direction switch, so the component's Orientation
   parameter is driven by a host rather than shown once, and the two lists inside every step are the reason the
   surface exists: what the next agent actually received, and what never made it. *@
<section class="demo-section mb-8" data-testid="ai-agents-handoff-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_HandoffTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">@Loc["TmAiAgentsDemo_HandoffHint"]</p>

    <div class="mb-3 flex flex-wrap items-center gap-3" data-testid="ai-agents-handoff-orientation">
        <TmSegmentedControl TValue="HandoffOrientation"
                            Size="SegmentedControlSize.Sm"
                            Label="@Loc["TmAiAgentsDemo_HandoffOrientationLabel"]"
                            Options="HandoffOrientationOptions"
                            Value="_handoffOrientation"
                            ValueChanged="OnHandoffOrientationChanged" />
    </div>

    <TmAgentHandoff Steps="_handoffSteps"
                    Orientation="_handoffOrientation"
                    Title="@Loc["TmAiAgentsDemo_HandoffTitle"]"
                    Culture="@CultureInfo.CurrentCulture"
                    DataTestId="ai-agents-handoff" />
</section>

@* ---------------------------------------------------------------------------------------------------------
   The models tried for ONE request, in order, and the chain this page would fall back through. The page owns
   the mode (run versus editor), the policy and the chain, so an edit in the component is the page's own data
   change — not a decoration. *@
<section class="demo-section mb-8" data-testid="ai-agents-fallback-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_FallbackTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">@Loc["TmAiAgentsDemo_FallbackHint"]</p>

    <div class="mb-3 flex flex-wrap items-center gap-3">
        <div data-testid="ai-agents-fallback-mode">
            <TmSegmentedControl TValue="FallbackChainMode"
                                Size="SegmentedControlSize.Sm"
                                Label="@Loc["TmAiAgentsDemo_FallbackModeLabel"]"
                                Options="FallbackModeOptions"
                                Value="_fallbackMode"
                                ValueChanged="OnFallbackModeChanged" />
        </div>
        <p class="text-sm text-slate-700 dark:text-slate-300 mb-0"
           data-testid="ai-agents-fallback-log">@FallbackChainText</p>
    </div>

    <TmFallbackChain Attempts="_fallbackAttempts"
                     Mode="_fallbackMode"
                     Chain="_fallbackChain"
                     ChainChanged="OnFallbackChainChanged"
                     AvailableModels="_models"
                     Policy="_fallbackPolicy"
                     PolicyChanged="OnFallbackPolicyChanged"
                     Title="@Loc["TmAiAgentsDemo_FallbackTitle"]"
                     Culture="@CultureInfo.CurrentCulture"
                     DataTestId="ai-agents-fallback" />
</section>

@* ---------------------------------------------------------------------------------------------------------
   How much the agent may do on its own. The page owns the presentation and the grade; the ceiling and the
   tenant's locks are host data, so a change above "Assist" really asks for confirmation and "Autopilot" is
   offered but unavailable. *@
<section class="demo-section mb-8" data-testid="ai-agents-autonomy-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_AutonomyTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">@Loc["TmAiAgentsDemo_AutonomyHint"]</p>

    <div class="mb-3 flex flex-wrap items-center gap-3">
        <div data-testid="ai-agents-autonomy-presentation">
            <TmSegmentedControl TValue="AutonomyDialPresentation"
                                Size="SegmentedControlSize.Sm"
                                Label="@Loc["TmAiAgentsDemo_AutonomyPresentationLabel"]"
                                Options="AutonomyPresentationOptions"
                                Value="_autonomyPresentation"
                                ValueChanged="OnAutonomyPresentationChanged" />
        </div>
        <p class="text-sm text-slate-700 dark:text-slate-300 mb-0"
           data-testid="ai-agents-autonomy-log">@AutonomyText</p>
    </div>

    <TmAutonomyDial Levels="_autonomyLevels"
                    Value="_autonomyValue"
                    ValueChanged="OnAutonomyChanged"
                    Presentation="_autonomyPresentation"
                    Locks="_autonomyLocks"
                    MaxAllowed="2"
                    ConfirmAbove="2"
                    Title="@Loc["TmAiAgentsDemo_AutonomyTitle"]"
                    DataTestId="ai-agents-autonomy" />
</section>

@* ---------------------------------------------------------------------------------------------------------
   What the agent remembers. The page is the STORE: every callback is applied to the page's own list, so an
   edit, a pause, a review decision and a removal are real data changes — and the removal only becomes one when
   the component's undo window closes. *@
<section class="demo-section mb-8" data-testid="ai-agents-memory-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_MemoryTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">@Loc["TmAiAgentsDemo_MemoryHint"]</p>

    <p class="text-sm text-slate-700 dark:text-slate-300 mb-3" data-testid="ai-agents-memory-log">@MemoryText</p>

    <TmMemoryPanel Items="_memories"
                   Enabled="_memoryEnabled"
                   EnabledChanged="OnMemoryEnabledChanged"
                   FilterText="@_memoryFilter"
                   FilterTextChanged="OnMemoryFilterChanged"
                   OnEdit="OnMemoryEdited"
                   OnPause="OnMemoryPaused"
                   OnResume="OnMemoryResumed"
                   OnForget="OnMemoryForgotten"
                   OnReview="OnMemoryReviewed"
                   OnBulkAction="OnMemoryBulk"
                   UndoWindow="TimeSpan.FromSeconds(10)"
                   Title="@Loc["TmAiAgentsDemo_MemoryTitle"]"
                   Culture="@CultureInfo.CurrentCulture"
                   DataTestId="ai-agents-memory" />
</section>

@* ---------------------------------------------------------------------------------------------------------
   Handing work out. The page is the STORE: every reported move is applied to its own task list, so the backlog, the
   columns and the automatic pass all work on real data — and the board's own copy of the reader's move is replaced by
   the page's next snapshot. *@
<section class="demo-section mb-8" data-testid="ai-agents-delegate-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_DelegateTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">@Loc["TmAiAgentsDemo_DelegateHint"]</p>

    <p class="text-sm text-slate-700 dark:text-slate-300 mb-3" data-testid="ai-agents-delegate-log">@DelegateText</p>

    <TmDelegateBoard Tasks="_delegateTasks"
                      Agents="_delegateAgents"
                      AutoAssign="_delegateAuto"
                      AutoAssignChanged="OnDelegateAutoChanged"
                      OnAssign="OnDelegateAssigned"
                      OnUnassign="OnDelegateUnassigned"
                      Title="@Loc["TmAiAgentsDemo_DelegateTitle"]"
                      DataTestId="ai-agents-delegate" />
</section>

@* ---------------------------------------------------------------------------------------------------------
   Runs placed into the scheduler's windows. The page owns the supply and the runs; the surface's planner decides
   where each run sits, and a reported move is applied to the page's own run (its preferred start window). *@
<section class="demo-section mb-8" data-testid="ai-agents-runs-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_RunsTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">@Loc["TmAiAgentsDemo_RunsHint"]</p>

    <p class="text-sm text-slate-700 dark:text-slate-300 mb-3" data-testid="ai-agents-runs-log">@RunsText</p>

    <TmScheduledRuns Windows="_runWindows"
                     Runs="_scheduledRuns"
                     ViewMode="_runsView"
                     ViewModeChanged="OnRunsViewChanged"
                     OnMove="OnRunMoved"
                     Title="@Loc["TmAiAgentsDemo_RunsTitle"]"
                     DataTestId="ai-agents-runs" />
</section>

@* ---------------------------------------------------------------------------------------------------------
   Two agents, one file: the conflict radar. The page owns the branches and the decisions; a merge is reported back as
   one request carrying every file and the accepted side per conflict, and the page applies nothing itself (the demo
   has no repository) — it logs what it received. *@
<section class="demo-section mb-8" data-testid="ai-agents-conflict-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_ConflictTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">@Loc["TmAiAgentsDemo_ConflictHint"]</p>

    <p class="text-sm text-slate-700 dark:text-slate-300 mb-3" data-testid="ai-agents-conflict-log">@ConflictText</p>

    <TmConflictRadar Agents="_branchChanges"
                     Resolutions="_radarResolutions"
                     ResolutionsChanged="OnRadarResolutionsChanged"
                     OnMerge="OnRadarMerge"
                     Title="@Loc["TmAiAgentsDemo_ConflictTitle"]"
                     DataTestId="ai-agents-conflict" />
</section>

@* ---------------------------------------------------------------------------------------------------------
   Collaborators' cursors over a document the page renders itself. The page's content carries the anchors; the demo
   adapter turns the collaboration feed's CollaboratorCursor list into the overlay's generic markers, so the AI package
   stays free of any editor dependency. *@
<section class="demo-section mb-8" data-testid="ai-agents-presence-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_PresenceTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">@Loc["TmAiAgentsDemo_PresenceHint"]</p>

    <TmAgentPresenceOverlay Markers="_presenceMarkers"
                            ShowRoster="true"
                            RosterLabel="@Loc["TmAiAgentsDemo_PresenceRoster"]"
                            DataTestId="ai-agents-presence">
        <div class="rounded-lg border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
            <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-3">
                @Loc["TmAiAgentsDemo_PresenceDocumentTitle"]
            </h3>
            <p class="text-sm text-slate-700 dark:text-slate-300 mb-3">
                @Loc["TmAiAgentsDemo_PresenceDocumentLead"]<span
                    data-presence-anchor="@PresenceMarkerAdapter.AnchorOf(AiAgentsPageSamples.PresenceBlocks()[0])"></span>
            </p>
            <p class="text-sm text-slate-700 dark:text-slate-300 mb-3">
                @Loc["TmAiAgentsDemo_PresenceDocumentBody"]<span
                    data-presence-anchor="@PresenceMarkerAdapter.AnchorOf(AiAgentsPageSamples.PresenceBlocks()[1])"></span>
            </p>
            <p class="text-sm text-slate-700 dark:text-slate-300">
                @Loc["TmAiAgentsDemo_PresenceDocumentClose"]<span
                    data-presence-anchor="@PresenceMarkerAdapter.AnchorOf(AiAgentsPageSamples.PresenceBlocks()[2])"></span>
            </p>
        </div>
