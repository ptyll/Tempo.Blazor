    private void StartRun()
    {
        var now = _clock.GetUtcNow();

        _showReview = false;
        _failureInjected = false;
        _approvalPending = false;
        _approvalState = ApprovalState.Pending;
        _approvalDecision = null;
        _cost = 0;
        _runStartedAt = now;
        _runCompletedAt = null;
        _runStatus = AgentStepStatus.Running;
        _runStateKey = "TmAiAgentsDemo_StateRunning";
        _runSteps = _reviewSteps
            .Select(step => step with
            {
                Status = AgentStepStatus.Pending,
                StartedAt = (DateTimeOffset?)null,
                CompletedAt = (DateTimeOffset?)null,
                Error = null,
            })
            .ToList();

        var first = _runSteps[0] with { Status = AgentStepStatus.Running, StartedAt = now };
        _runSteps = Replace(_runSteps, 0, first);
        StartTimer();
    }

    private void StartTimer()
    {
        StopTimer();
        _timer = _clock.CreateTimer(
            _ => _ = InvokeAsync(TickAsync),
            null,
            TimeSpan.FromSeconds(1.2),
            TimeSpan.FromSeconds(1.2));
    }

    private void StopTimer()
    {
        _timer?.Dispose();
        _timer = null;
    }

    /// <summary>
    /// One tick of the simulated run: the running step completes and the next one starts. The MATCHER (the second
    /// step) fails the first time it runs, so the reader is offered Retry; the LAST step is gated by the approval
    /// card, so the run pauses until a human decides.
    /// </summary>
    private async Task TickAsync()
    {
        if (_showReview)
        {
            StopTimer();
            return;
        }

        var list = _runSteps.ToList();
        var running = list.FindIndex(step => step.Status == AgentStepStatus.Running);
        if (running < 0)
        {
            StopTimer();
            return;
        }

        var now = _clock.GetUtcNow();

        if (running == 1 && !_failureInjected)
        {
            _failureInjected = true;
            list[running] = list[running] with
            {
                Status = AgentStepStatus.Failed,
                CompletedAt = now,
                Error = Loc["TmAiAgentsDemo_StepError"],
            };
            _runSteps = list;
            _runStatus = AgentStepStatus.Failed;
            _runCompletedAt = now;
            _runStateKey = "TmAiAgentsDemo_StateFailed";
            StopTimer();
            await InvokeAsync(StateHasChanged);
            return;
        }

        list[running] = list[running] with { Status = AgentStepStatus.Done, CompletedAt = now };
        _cost += 250_000;

        var next = list.FindIndex(step => step.Status == AgentStepStatus.Pending);
        if (next < 0)
        {
            _runStatus = AgentStepStatus.Done;
            _runCompletedAt = now;
            _runStateKey = "TmAiAgentsDemo_StateDone";
            StopTimer();
        }
        else if (next == list.Count - 1)
        {
            // The last step needs a human decision: pause here and hand the decision to the approval card.
            _approvalPending = true;
            _approvalState = ApprovalState.Pending;
            _approvalExpiresAt = now.AddMinutes(30);
            _approvalDetails = BuildApprovalDetails();
            _runStateKey = "TmAiAgentsDemo_StateApproval";
            StopTimer();
        }
        else
        {
            list[next] = list[next] with { Status = AgentStepStatus.Running, StartedAt = now };
            _runStateKey = "TmAiAgentsDemo_StateRunning";
        }

        _runSteps = list;
        await InvokeAsync(StateHasChanged);
    }

    private static List<AgentPlanStep> Replace(IReadOnlyList<AgentPlanStep> steps, int index, AgentPlanStep step)
    {
        var list = steps.ToList();
        list[index] = step;
        return list;
    }

    /// <summary>Retry from the failed step: it runs again and the timer resumes.</summary>
    private void RetryFrom(AgentPlanStep step)
    {
        var list = _runSteps.ToList();
        var index = list.FindIndex(candidate => candidate.Id == step.Id);
        if (index < 0)
        {
            return;
        }

        list[index] = list[index] with
        {
            Status = AgentStepStatus.Running,
            StartedAt = _clock.GetUtcNow(),
            CompletedAt = null,
            Error = null,
        };

        _runSteps = list;
        _runStatus = AgentStepStatus.Running;
        _runCompletedAt = null;
        _runStateKey = "TmAiAgentsDemo_StateRunning";
        StartTimer();
    }

    private Task DecideAsync(ApprovalDecision decision)
    {
        _approvalState = decision.State;
        _approvalPending = false;
        _approvalDecision = decision.IsApproved ? "approved" : "rejected";

        var list = _runSteps.ToList();
        var last = list.Count - 1;

        if (decision.IsApproved)
        {
            list[last] = list[last] with { Status = AgentStepStatus.Running, StartedAt = _clock.GetUtcNow() };
            _runSteps = list;
            _runStatus = AgentStepStatus.Running;
            _runCompletedAt = null;
            _runStateKey = "TmAiAgentsDemo_StateRunning";
            StartTimer();
        }
        else
        {
            var now = _clock.GetUtcNow();
            list[last] = list[last] with { Status = AgentStepStatus.Skipped, CompletedAt = now };
            _runSteps = list;
            _runStatus = AgentStepStatus.Skipped;
            _runCompletedAt = now;
            _runStateKey = "TmAiAgentsDemo_StateRejected";
            StopTimer();
        }

        return InvokeAsync(StateHasChanged);
    }

