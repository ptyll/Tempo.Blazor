@page "/email-templates/send/{Id:guid}"
@using System.Text.Json
@inject IEmailTemplateApiClient Api
@inject ITmLocalizer Loc
@inject NavigationManager Nav

<PageTitle>@Loc["TmDemo_EmailTemplates_Send_PageTitle"]</PageTitle>

@* Fáze 11 demo: the send page as the reference draws it — a back affordance, the template's name and a one-line
   explanation, then TWO named sections (Recipients / Variable values) beside the message preview. The preview is
   the plain message preview (no sample-data editor, no HTML/Text toggle: this page IS the sample data). On a
   phone the form comes first and "Send e-mail" sticks to the bottom edge.
   Every string comes from the demo's DemoResources tables (TmDemo_EmailTemplates_Send_*) — the page shipped
   hardcoded English copy in the first pass, including the reason under a disabled Send. *@
<div class="tm-demo-email-send" data-tm-email-send-page>
    <div class="tm-demo-email-send__bar">
        <TmButton Variant="ButtonVariant.Ghost" Icon="arrow-left" OnClick="Back" data-tm-back>@Loc["TmDemo_EmailTemplates_Send_Back"]</TmButton>
        <div class="tm-demo-email-send__heading">
            <h1>@(_detail?.Name ?? Loc["TmDemo_EmailTemplates_Send_TitleFallback"])</h1>
            <p>@Loc["TmDemo_EmailTemplates_Send_Subtitle"]</p>
        </div>
    </div>

    @if (_loading)
    {
        <TmSpinner />
    }
    else if (_document is null)
    {
        <TmEmptyState Icon="alert-triangle" Title="@Loc["TmDemo_EmailTemplates_Send_NotFound"]" />
    }
    else
    {
        <div class="tm-demo-email-send__layout">
            <div class="tm-demo-email-send__form" data-tm-send-form>
                @* TmFormSection owns its own root element and does not splat attributes, so the test hook
                   lives on a wrapper of OURS (a parameter name it does not declare is a compile error). *@
                <div data-tm-send-section="recipients">
                    <TmFormSection Title="@Loc["TmDemo_EmailTemplates_Send_Recipients"]">
                        <TmTextInput Label="@Loc["TmDemo_EmailTemplates_Send_To"]" Value="@_to" ValueChanged="v => { _to = v; }" data-tm-to />
                        <TmTextInput Label="@Loc["TmDemo_EmailTemplates_Send_Cc"]" Value="@_cc" ValueChanged="v => { _cc = v; }" data-tm-cc />
                    </TmFormSection>
                </div>

                <div data-tm-send-section="variables">
                <TmFormSection Title="@Loc["TmDemo_EmailTemplates_Send_VariableValues"]">
                    @foreach (var variable in _scalars)
                    {
                        var path = variable;
                        @* The field LABEL is the host's description of what the value means (the token path
                           is only the fallback); data-tm-var-label carries it for the tests, so no second
                           copy of the same sentence is painted under the input. *@
                        <div class="tm-demo-email-send__field" data-tm-var-field="@path"
                             data-tm-var-label="@Describe(path)">
                            <TmTextInput Label="@Describe(path)" Value="@GetScalar(path)"
                                         ValueChanged="v => SetScalar(path, v)" data-tm-var="@path" />
                        </div>
                    }
                    @foreach (var variable in _collections)
                    {
                        var path = variable;
                        <TmTextArea Label="@Loc["TmDemo_EmailTemplates_Send_CollectionFormat", Describe(path)]" Rows="4" Value="@GetCollection(path)"
                                    ValueChanged="v => SetCollection(path, v)" data-tm-var-collection="@path" />
                    }
                </TmFormSection>
                </div>

                <div class="tm-demo-email-send__actions" data-tm-send-actions>
                    <div class="tm-demo-email-send__submit">
                        <TmButton Variant="ButtonVariant.Primary" Icon="send" OnClick="SendAsync"
                                  Class="tm-demo-email-send__submit-button"
                                  Disabled="@(_sending || !HasRecipients)" data-tm-send-submit>@Loc["TmDemo_EmailTemplates_Send_Submit"]</TmButton>
                        @* A disabled primary action says WHY it is disabled, right where the user looks. *@
                        @if (!_sending && !HasRecipients)
                        {
                            <span class="tm-demo-email-send__hint" data-tm-send-hint>
                                @Loc["TmDemo_EmailTemplates_Send_RecipientRequired"]
                            </span>
                        }
                    </div>
                </div>

                @if (_result is { Success: true })
                {
                    <TmAlert Severity="AlertSeverity.Success" data-tm-send-success>
                        @Loc["TmDemo_EmailTemplates_Send_Sent"]
                        <a href="http://localhost:5000" target="_blank">@Loc["TmDemo_EmailTemplates_Send_SentLink"]</a>
                    </TmAlert>
                }
                else if (_result is { Success: false })
                {
                    <TmAlert Severity="AlertSeverity.Error" data-tm-send-errors>
                        <ul>@foreach (var e in _result.Errors) { <li>@e</li> }</ul>
                    </TmAlert>
                }
            </div>

            <div class="tm-demo-email-send__preview" data-tm-send-preview>
                <h2 class="tm-demo-email-send__preview-title">@Loc["TmDemo_EmailTemplates_Send_PreviewTitle"]</h2>
                <TmEmailTemplatePreview Document="_document" VariablesJson="@BuildVariablesJson()"
                                       ShowSampleDataEditor="false" ShowViewToggle="false" />
            </div>
        </div>
    }
</div>

@code {
    /// <summary>The template id from the route.</summary>
    [Parameter] public Guid Id { get; set; }

    /// <summary>
    /// The host's catalogue of human descriptions (Fáze 7A/11): the same metadata the editor's variable picker
    /// shows. A path that is not in the catalogue keeps its token as the label — never a missing string.
    /// </summary>
    private static readonly IReadOnlyDictionary<string, string> Descriptions = new Dictionary<string, string>(StringComparer.Ordinal)
    {
        ["first_name"] = "Recipient's first name",
        ["newsletter_title"] = "Newsletter title",
        ["articles"] = "Articles",
        ["order_id"] = "Order number",
        ["is_paid"] = "Order is paid",
        ["customer_name"] = "Customer name",
    };

    private EmailTemplateDetailDto? _detail;
    private EmailTemplateDocument? _document;
    private bool _loading = true;
    private bool _sending;
    private SendEmailResult? _result;
    private string _to = string.Empty;
    private string _cc = string.Empty;

    private List<string> _scalars = new();
    private List<string> _collections = new();
    private readonly Dictionary<string, string> _scalarValues = new();
    private readonly Dictionary<string, string> _collectionValues = new();

    private bool HasRecipients => SplitAddresses(_to).Count > 0;

    /// <summary>The label a user reads: the host's description, or the token path when the host has none.</summary>
    private static string Describe(string path)
        => Descriptions.TryGetValue(path, out var description) ? description : path;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _detail = await Api.GetAsync(Id);
        _document = _detail is null ? null : EmailTemplateSerializer.Deserialize(_detail.ContentJson);
        if (_document is not null)
        {
            var variables = EmailDocumentVariableExtractor.Extract(_document);
            _scalars = variables.Where(v => v.Kind == VariableKind.Scalar).Select(v => v.Path).Distinct().ToList();
            _collections = variables.Where(v => v.Kind == VariableKind.Collection).Select(v => v.Path).Distinct().ToList();
            Prefill(_detail!.SampleDataJson);
        }
        _loading = false;
    }

    private void Prefill(string? sampleDataJson)
    {
        if (string.IsNullOrWhiteSpace(sampleDataJson)) return;
        try
        {
            using var doc = JsonDocument.Parse(sampleDataJson);
            foreach (var path in _scalars)
                if (TryGetByPath(doc.RootElement, path, out var element) && element.ValueKind is not JsonValueKind.Object and not JsonValueKind.Array)
                    _scalarValues[path] = element.ToString();
            foreach (var path in _collections)
                if (TryGetByPath(doc.RootElement, path, out var element))
                    _collectionValues[path] = element.GetRawText();
        }
        catch (JsonException) { /* leave fields empty */ }
    }

    private string GetScalar(string path) => _scalarValues.GetValueOrDefault(path, string.Empty);
    private void SetScalar(string path, string value) => _scalarValues[path] = value;
    private string GetCollection(string path) => _collectionValues.GetValueOrDefault(path, "[]");
    private void SetCollection(string path, string value) => _collectionValues[path] = value;

    private string BuildVariablesJson()
    {
        var root = new Dictionary<string, object?>();
        foreach (var (path, value) in _scalarValues)
            SetPath(root, path.Split('.'), value);
        foreach (var (path, json) in _collectionValues)
        {
            try { SetPath(root, path.Split('.'), JsonSerializer.Deserialize<JsonElement>(json)); }
            catch (JsonException) { /* invalid array ignored */ }
        }
        return JsonSerializer.Serialize(root);
    }

    private async Task SendAsync()
    {
        if (_document is null) return;
        _sending = true;
        _result = null;
        StateHasChanged();

        _result = await Api.SendAsync(Id, new SendEmailRequest
        {
            To = SplitAddresses(_to),
            Cc = SplitAddresses(_cc),
            VariablesJson = BuildVariablesJson(),
        });
        _sending = false;
    }

    private void Back() => Nav.NavigateTo("/email-templates");

    private static List<string> SplitAddresses(string value)
        => value.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private static void SetPath(Dictionary<string, object?> root, string[] segments, object? value)
    {
        var current = root;
        for (var i = 0; i < segments.Length - 1; i++)
        {
            if (current.TryGetValue(segments[i], out var existing) && existing is Dictionary<string, object?> dict)
                current = dict;
            else
            {
                var created = new Dictionary<string, object?>();
                current[segments[i]] = created;
                current = created;
            }
        }
        current[segments[^1]] = value;
    }

    private static bool TryGetByPath(JsonElement root, string path, out JsonElement element)
    {
        element = root;
        foreach (var segment in path.Split('.'))
        {
            if (element.ValueKind != JsonValueKind.Object || !element.TryGetProperty(segment, out element))
                return false;
        }
        return true;
    }
}
