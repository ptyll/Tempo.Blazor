            model.Relationships.Clear();
            model.Views.Clear();
            model.Issues.Clear();

            for (var index = 0; index < 128; index++)
            {
                model.Elements.Add(CreateScenarioElement(
                    $"preview-task-{index:000}",
                    "userTask",
                    $"Preview task {index:000}",
                    $"/Demo/Preview/{index:000}"));

                if (index > 0)
                {
                    model.Relationships.Add(new ModelingRelationshipDto
                    {
                        Id = $"preview-flow-{index - 1:000}-{index:000}",
                        SourceId = $"preview/flow/{index - 1:000}/{index:000}",
                        SourceType = "bpmn-sequence-flow",
                        SourceElementId = $"preview-task-{index - 1:000}",
                        TargetElementId = $"preview-task-{index:000}",
                        RelationshipType = "sequenceFlow",
                        Name = $"Preview flow {index:000}",
                        Tags = ["scenario", "preview"],
                        Properties = new Dictionary<string, JsonElement>()
                    });
                }
            }
        }

        if (string.Equals(Scenario, "regression-empty-canvas", StringComparison.OrdinalIgnoreCase))
        {
            model.Id = "demo-regression-empty-canvas-model";
            model.Title = "Regression empty canvas model";
            foreach (var view in model.Views)
            {
                view.Nodes.Clear();
                view.Connections.Clear();
            }

            model.Relationships.Clear();
            model.Issues.Clear();
        }
    }

    private static ModelingModelDto CreatePerformanceLargeScenarioModel()
    {
        var elements = new List<ModelingElementDto>(capacity: 200);
        var relationships = new List<ModelingRelationshipDto>(capacity: 150);
        var nodes = new List<ModelingViewNodeDto>(capacity: 200);
        var connections = new List<ModelingViewConnectionDto>(capacity: 150);

        for (var index = 0; index < 200; index++)
        {
            var semanticType = index switch
            {
                0 => "startEvent",
                199 => "endEvent",
                _ when index % 5 == 0 => "serviceTask",
                _ => "userTask"
            };
            var elementId = $"perf-element-{index:000}";
            elements.Add(CreateScenarioElement(
                elementId,
                semanticType,
                $"Performance element {index:000}",
                $"/Demo/Performance/{index:000}"));

            nodes.Add(new ModelingViewNodeDto
            {
                ElementId = elementId,
                X = 80 + (index % 20) * 190,
                Y = 80 + (index / 20) * 130,
                Width = semanticType is "startEvent" or "endEvent" ? 72 : 160,
                Height = semanticType is "startEvent" or "endEvent" ? 72 : 88
            });
        }

        for (var index = 0; index < 150; index++)
        {
            var relationshipId = $"perf-flow-{index:000}";
            var sourceId = $"perf-element-{index:000}";
            var targetId = $"perf-element-{index + 1:000}";
            relationships.Add(new ModelingRelationshipDto
            {
                Id = relationshipId,
                SourceId = $"performance/flow/{index:000}",
                SourceType = "bpmn-sequence-flow",
                SourceElementId = sourceId,
                TargetElementId = targetId,
                RelationshipType = "sequenceFlow",
                Name = $"Performance flow {index:000}",
                Tags = ["performance", "m26"],
                Properties = new Dictionary<string, JsonElement>()
            });
            connections.Add(new ModelingViewConnectionDto
            {
                RelationshipId = relationshipId,
                SourceNodeId = sourceId,
                TargetNodeId = targetId
            });
        }

        var issues = Enumerable.Range(0, 100)
            .Select(index => new ModelingIssueDto
            {
                Id = $"perf-issue-{index:000}",
                Category = index % 2 == 0 ? "Validation" : "Generator",
                Severity = index % 3 == 0
                    ? ModelingIssueSeverity.Error
                    : index % 3 == 1
                        ? ModelingIssueSeverity.Warning
                        : ModelingIssueSeverity.Info,
                SourceElementId = $"perf-element-{index % 200:000}",
                Message = $"Performance issue {index:000} keeps the issue panel scrollable with realistic diagnostic text.",
                SuggestedFix = index % 5 == 0 ? "Review the generated model mapping and regenerate the diagram." : string.Empty
            })
            .ToList();

        return new ModelingModelDto
        {
            Id = "demo-performance-large-model",
            Title = "Performance large modeling model",
            Notation = "bpmn",
            SupportedNotations = ["bpmn"],
            Metadata = new ModelingMetadataDto
            {
                SourceSystem = "Tempo.Blazor Demo",
                SourceVersion = "2026.06-performance-large",
                LoadedAt = new DateTimeOffset(2026, 6, 6, 9, 0, 0, TimeSpan.Zero),
                IsFresh = true
            },
            Elements = elements,
            Relationships = relationships,
            Issues = issues,
            Views =
            [
                new ModelingViewDto
                {
                    Id = "performance-large-overview",
                    Name = "Performance large overview",
                    Notation = "bpmn",
                    ViewpointKey = "overview",
                    Nodes = nodes,
                    Connections = connections
                }
            ]
        };
    }

    private void ApplyModelingTreeScenario(ModelingModelDto model)
    {
        if (string.Equals(Scenario, "diacritics", StringComparison.OrdinalIgnoreCase))
        {
            model.Elements.Add(CreateScenarioElement("demo-zakaznik", "businessActor", "Zákazník", "/Demo/Obchod/Zákazník"));
            return;
        }

        if (string.Equals(Scenario, "long-name", StringComparison.OrdinalIgnoreCase))
        {
            model.Elements.Add(CreateScenarioElement(
                "demo-long-name",
                "generatedTask",
                "Very long generated modeling element name that should stay on a single line and end with an ellipsis inside the model tree node",
                "/Demo/Generated/Long name"));
            return;
        }

        if (string.Equals(Scenario, "large-tree", StringComparison.OrdinalIgnoreCase))
        {
            for (var index = 0; index < 520; index++)
            {
                var type = index % 2 == 0 ? "generatedTask" : "generatedActor";
                model.Elements.Add(CreateScenarioElement(
                    $"generated-element-{index:000}",
                    type,
                    $"Generated element {index:000}",
                    $"/Demo/Generated/{index:000}"));
            }
        }
    }

    private static ModelingElementDto CreateBpmnElement(
        string id,
        string semanticType,
        string name,
        string sourceId,
        string? poolId = null)
    {
        var element = new ModelingElementDto
        {
            Id = id,
            SourceId = sourceId,
            SourceType = $"bpmn2-{semanticType}",
            SourcePath = $"/BPMN 2.0/{name}",
            Notation = "bpmn2",
            SemanticType = semanticType,
            Name = name,
            Description = $"BPMN 2.0 {semanticType} element.",
            Tags = ["bpmn2", semanticType],
            Properties = new Dictionary<string, JsonElement>(),
            Governance = new ModelingGovernanceDto
            {
                TrustLevel = "demo",
                ReviewState = "generated",
                SyncState = "fresh",
                DataSource = "Tempo.Blazor Demo"
            }
        };

        if (!string.IsNullOrWhiteSpace(poolId))
            element.Properties["poolId"] = JsonSerializer.SerializeToElement(poolId);

        return element;
    }

