    private void ApplyInspectorScenario(ModelingModelDto model)
    {
        var validateOrder = model.Elements.FirstOrDefault(element => string.Equals(element.Id, "bpmn-validate-order", StringComparison.Ordinal));
        if (validateOrder is null)
        {
            return;
        }

        if (string.Equals(Scenario, "inspector-many-properties", StringComparison.OrdinalIgnoreCase))
        {
            validateOrder.Properties.Clear();
            for (var index = 0; index < 50; index++)
            {
                validateOrder.Properties[$"property-{index:00}"] = JsonSerializer.SerializeToElement($"Value {index:00}");
            }

            validateOrder.Properties["html-sample"] = JsonSerializer.SerializeToElement("<b>test</b>");
            return;
        }

        if (string.Equals(Scenario, "inspector-empty-description", StringComparison.OrdinalIgnoreCase))
        {
            validateOrder.Description = string.Empty;
            return;
        }

        if (string.Equals(Scenario, "inspector-low-trust", StringComparison.OrdinalIgnoreCase))
        {
            validateOrder.Governance.TrustLevel = "Low";
            validateOrder.Governance.ReviewState = "needs-review";
            validateOrder.Governance.SyncState = "stale";
        }
    }

    private void ApplyIssueScenario(ModelingModelDto model)
    {
        if (string.Equals(Scenario, "issues-empty", StringComparison.OrdinalIgnoreCase))
        {
            model.Issues.Clear();
            return;
        }

        if (string.Equals(Scenario, "issues-mixed", StringComparison.OrdinalIgnoreCase))
        {
            model.Issues.Clear();
            model.Issues.Add(new ModelingIssueDto
            {
                Id = "issue-info-demo",
                Category = "Governance",
                Severity = ModelingIssueSeverity.Info,
                SourceElementId = "bpmn-validate-order",
                Message = "Element metadata is complete enough for preview generation."
            });
            model.Issues.Add(new ModelingIssueDto
            {
                Id = "issue-warning-demo",
                Category = "Validation",
                Severity = ModelingIssueSeverity.Warning,
                SourceElementId = "bpmn-validate-order",
                Message = "Validate Order should confirm the target lane before publishing.",
                SuggestedFix = "Assign an owner lane and regenerate the diagram."
            });
            model.Issues.Add(new ModelingIssueDto
            {
                Id = "issue-error-demo",
                Category = "Generator",
                Severity = ModelingIssueSeverity.Error,
                SourceElementId = "bpmn-ship-order",
                Message = "Ship Order is missing a required outbound path."
            });
            // Modeling redesign phase 1: one issue WITHOUT a source element/relationship — it must
            // render as a non-interactive list item (no <button>, no pointer cursor).
            model.Issues.Add(new ModelingIssueDto
            {
                Id = "issue-orphan-demo",
                Category = "Source",
                Severity = ModelingIssueSeverity.Info,
                Message = "The source model carries a note that does not map to any element or relationship."
            });
            return;
        }

        if (string.Equals(Scenario, "issues-many", StringComparison.OrdinalIgnoreCase))
        {
            model.Issues.Clear();
            for (var index = 0; index < 64; index++)
            {
                model.Issues.Add(new ModelingIssueDto
                {
                    Id = $"issue-many-{index:000}",
                    Category = index % 2 == 0 ? "Validation" : "Generator",
                    Severity = index % 3 == 0
                        ? ModelingIssueSeverity.Error
                        : index % 3 == 1
                            ? ModelingIssueSeverity.Warning
                            : ModelingIssueSeverity.Info,
                    SourceElementId = index % 2 == 0 ? "bpmn-validate-order" : "bpmn-ship-order",
                    Message = $"Scenario issue {index:000} keeps the issue list scrollable without changing the surrounding panels.",
                    SuggestedFix = index % 5 == 0 ? "Review the generated mapping and apply the suggested model correction." : string.Empty
                });
            }

            return;
        }

        // Phase 5 (MO1) edge case: 500 issues must scroll INSIDE the dock (the canvas body owns
        // the height) without overlapping the preview above it.
        if (string.Equals(Scenario, "issues-500", StringComparison.OrdinalIgnoreCase))
        {
            model.Issues.Clear();
            for (var index = 0; index < 500; index++)
            {
                model.Issues.Add(new ModelingIssueDto
                {
                    Id = $"issue-500-{index:000}",
                    Category = index % 2 == 0 ? "Validation" : "Generator",
                    Severity = index % 3 == 0
                        ? ModelingIssueSeverity.Error
                        : index % 3 == 1
                            ? ModelingIssueSeverity.Warning
                            : ModelingIssueSeverity.Info,
                    SourceElementId = index % 2 == 0 ? "bpmn-validate-order" : "bpmn-ship-order",
                    Message = $"Stress issue {index:000}: the dock row height caps the panel and the list scrolls internally.",
                    SuggestedFix = index % 7 == 0 ? "Apply the suggested model correction." : string.Empty
                });
            }

            return;
        }

        if (string.Equals(Scenario, "invalid-relationship", StringComparison.OrdinalIgnoreCase))
        {
            model.Issues.Clear();
            const string relationshipId = "scenario-invalid-relationship";
            model.Relationships.Add(new ModelingRelationshipDto
            {
                Id = relationshipId,
                SourceId = "scenario/invalid-relationship",
                SourceType = "bpmn-sequence-flow",
                SourceElementId = "bpmn-validate-order",
                TargetElementId = "missing-generated-target",
                RelationshipType = "sequenceFlow",
                Name = "Invalid scenario flow",
                Tags = ["scenario", "invalid"],
                Properties = new Dictionary<string, JsonElement>()
            });

            var view = model.Views.FirstOrDefault();
            if (view is not null)
            {
                view.Connections.Add(new ModelingViewConnectionDto
                {
                    RelationshipId = relationshipId,
                    SourceNodeId = "bpmn-validate-order",
                    TargetNodeId = "missing-generated-target"
                });
            }
        }
    }

    private void ApplyDiagramPreviewScenario(ModelingModelDto model)
