@page "/modeling-editor"
@using Microsoft.AspNetCore.Components
@using System.Text.Json
@using Tempo.Blazor.Components.Diagram.Models
@using Tempo.Blazor.Demo.SharedUI.Services
@inject ITmLocalizer Loc
@inject IEnumerable<IModelingModelProvider> ModelProviders

<PageTitle>@Loc["TmModelingEditor_Title"] - Tempo.Blazor</PageTitle>

@* Demo only: the modeling editor resolves its layout from its own container width (desktop from
   1200, the DiagramEditor pair; the tablet band is 768-1199 — phase 6). With the 296px demo
   sidebar a 1440 viewport leaves it ~1080px, so from 1264px up (the 1200px desktop floor + the
   layout's 2rem side padding) this page collapses the sidebar AND lifts the layout's max-w-7xl
   (1280px) cap, giving the editor the full width of the viewport as soon as it can afford the
   desktop dock (a link back to the demo index stays in the header) — the 1280x800 and 1440x900
   baselines show the full docked desktop workspace. From 1024px up (the tablet band's floor plus
   the same padding) the sidebar hides too, so a 1024/1180 touch viewport lands the editor in the
   768-1199 tablet band (960/1116px of container) instead of the compact workspace — the tablet
   E2E and the tablet baselines need that band reachable. The library breakpoints are untouched. *@
<style>
    @@media (min-width: 1024px) {
        .demo-shell:has(.modeling-demo-page) aside.fixed.inset-y-0.left-0.z-30 { display: none !important; }
        .demo-shell:has(.modeling-demo-page) main { margin-left: 0 !important; width: 100vw !important; max-width: 100vw !important; }
        .demo-shell:has(.modeling-demo-page) main .max-w-7xl { max-width: none !important; }
    }
    .modeling-demo-page__index-link { display: none; }
    @@media (min-width: 1024px) {
        .modeling-demo-page__index-link { display: inline-block; margin-top: 1rem; scroll-margin-top: 5rem; color: var(--tm-color-primary-700, #1d4ed8); text-decoration: underline; }
        .dark .modeling-demo-page__index-link, [data-theme="dark"] .modeling-demo-page__index-link { color: var(--tm-color-primary-300, #93c5fd); }
    }
    /* Fáze 7 review (above the fold): the editor's default height contract (min(768px, 100vh - 32px))
       plus the demo chrome (fixed 4rem mobile header + ~4.5rem top bar + the 2rem page padding)
       pushed the in-flow F5 action bar below the fold at 390/320, so first paint needed a page
       scroll. On narrow viewports the page gives the editor the exact remaining viewport height
       instead — the action bar (and the tab strip) are inside the first paint at 390x844 and
       320x640. Desktop/tablet keep the library contract.
       DEMO-ONLY sizing: this 100dvh override is a demo-page accommodation for the demo chrome.
       A host owns the editor's height through the TmModelingEditor Height parameter (or its own
       layout container) — the library default remains min(768px, 100vh - 32px) and this rule is
       scoped to .modeling-demo-page only. */
    @@media (max-width: 1023.98px) {
        .modeling-demo-page .tm-modeling-editor {
            height: calc(100dvh - 11.5rem) !important;
            min-height: 0 !important;
        }
    }
</style>

<div class="modeling-demo-page">
    <a href="./" class="modeling-demo-page__index-link text-sm mb-2" data-testid="modeling-demo-index-link">← All demos</a>

    <TmModelingEditor ProviderKey="@ResolvedProviderKey"
                      ShowProviderSelector="true"
                      ProviderKeyChanged="HandleProviderChanged"
                      ProviderDisplayName="ResolveDemoProviderDisplayName"
                      NotationKey="@Notation"
                      ViewpointKey="@Viewpoint"
                      AllowNodeDrop="@AllowNodeDrop"
                      ModelLoaderOverride="@ModelLoaderOverride"
                      OnDiagramGenerated="HandleDiagramGenerated" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "provider")]
    public string? Provider { get; set; }

    [SupplyParameterFromQuery(Name = "notation")]
    public string? Notation { get; set; }

    [SupplyParameterFromQuery(Name = "viewpoint")]
    public string? Viewpoint { get; set; }

    [SupplyParameterFromQuery(Name = "scenario")]
    public string? Scenario { get; set; }

    [SupplyParameterFromQuery(Name = "delay")]
    public int? Delay { get; set; }

    [SupplyParameterFromQuery(Name = "fresh")]
    public bool? Fresh { get; set; }

    private DiagramDocument? _lastGeneratedDocument;
    private string? _selectedProvider;
    private string? _lastProviderQuery;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        // Review fix (phase 3): a changed ?provider= deep link must win over a stale in-editor
        // selection — the session override is dropped whenever the query value changes.
        if (!string.Equals(_lastProviderQuery, Provider, StringComparison.Ordinal))
        {
            _lastProviderQuery = Provider;
            _selectedProvider = null;
        }
    }

    private bool AllowNodeDrop => !string.Equals(Scenario, "drag-readonly", StringComparison.OrdinalIgnoreCase);

    // The ?provider= query stays the deep-link source; an in-editor selector change takes
    // precedence for the session (the editor keeps its own override until the param changes).
    private string? ResolvedProviderKey => _selectedProvider
        ?? (string.IsNullOrWhiteSpace(Provider)
            ? DemoModelingModelProvider.ProviderKeyValue
            : Provider);

    private Task HandleProviderChanged(string? providerKey)
    {
        _selectedProvider = string.IsNullOrWhiteSpace(providerKey) ? null : providerKey;
        return Task.CompletedTask;
    }

    // Review fix (phase 3): the header select and chip show localized display names instead of
    // raw provider keys. Demo strings follow the demo resource tables (DemoResources*.json).
    private string ResolveDemoProviderDisplayName(string providerKey) => providerKey switch
    {
        DemoModelingModelProvider.ProviderKeyValue => Loc["TmDemo_Modeling_ProviderDefault"],
        DemoUmlModelingModelProvider.ProviderKeyValue => Loc["TmDemo_Modeling_ProviderUml"],
        _ => providerKey
    };

    private Func<ModelingModelRequest, CancellationToken, Task<ModelingModelDto>>? ModelLoaderOverride =>
        string.Equals(Scenario, "error", StringComparison.OrdinalIgnoreCase)
            ? ThrowingModelLoaderAsync
            : Delay.GetValueOrDefault() > 0 || Fresh == false || HasModelingTreeScenario
                || HasDiagramPreviewScenario
                || HasIssueScenario
                || HasInspectorScenario
                || HasBpmnProfileScenario
                || HasUmlProfileScenario
                || HasArchimate32ProfileScenario
                || HasErdProfileScenario
                || HasPerformanceScenario
                ? CustomModelLoaderAsync
            : null;

    private bool HasPerformanceScenario =>
        string.Equals(Scenario, "performance-large", StringComparison.OrdinalIgnoreCase);

    private bool HasBpmnProfileScenario =>
        string.Equals(Scenario, "bpmn2-generated", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Scenario, "bpmn2-cross-pool", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Scenario, "bpmn2-ai-task", StringComparison.OrdinalIgnoreCase);

    private bool HasUmlProfileScenario =>
        string.Equals(Scenario, "uml25-class", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Scenario, "uml25-usecase", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Scenario, "uml25-include-invalid", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Scenario, "uml25-class-empty", StringComparison.OrdinalIgnoreCase);

    private bool HasArchimate32ProfileScenario =>
        string.Equals(Scenario, "archimate32-business-app", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Scenario, "archimate32-missing-stencil", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Scenario, "archimate32-motivation", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Scenario, "archimate32-relationships", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Scenario, "archimate32-invalid-relationship", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Scenario, "archimate32-large-relationships", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Scenario, "archimate32-viewpoints", StringComparison.OrdinalIgnoreCase);

    private bool HasErdProfileScenario =>
        string.Equals(Scenario, "erd-no-stencils", StringComparison.OrdinalIgnoreCase);

    private bool HasModelingTreeScenario =>
        string.Equals(Scenario, "diacritics", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Scenario, "large-tree", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Scenario, "long-name", StringComparison.OrdinalIgnoreCase);

    private bool HasDiagramPreviewScenario =>
        string.Equals(Scenario, "empty-preview", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Scenario, "large-preview", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Scenario, "regression-empty-canvas", StringComparison.OrdinalIgnoreCase);

    private bool HasIssueScenario =>
        string.Equals(Scenario, "issues-mixed", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Scenario, "issues-empty", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Scenario, "issues-many", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Scenario, "issues-500", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Scenario, "invalid-relationship", StringComparison.OrdinalIgnoreCase);

    private bool HasInspectorScenario =>
        string.Equals(Scenario, "inspector-many-properties", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Scenario, "inspector-empty-description", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Scenario, "inspector-low-trust", StringComparison.OrdinalIgnoreCase);

    private Task<ModelingModelDto> ThrowingModelLoaderAsync(ModelingModelRequest request, CancellationToken cancellationToken) =>
        Task.FromException<ModelingModelDto>(new InvalidOperationException(Loc["TmModelingEditor_DemoError"]));

    private async Task<ModelingModelDto> CustomModelLoaderAsync(ModelingModelRequest request, CancellationToken cancellationToken)
    {
        if (Delay.GetValueOrDefault() > 0)
        {
            var delay = Math.Clamp(Delay.GetValueOrDefault(), 1, 7_000);
            await Task.Delay(delay, cancellationToken);
        }

        var provider = ModelProviders.FirstOrDefault(modelProvider => string.Equals(modelProvider.ProviderKey, ResolvedProviderKey, StringComparison.Ordinal));
        if (provider is null)
        {
            throw new InvalidOperationException(Loc["TmModelingEditor_DemoError"]);
        }

        var model = await provider.GetModelAsync(request, cancellationToken);
        if (HasBpmnProfileScenario)
        {
            return CreateBpmnProfileScenarioModel();
        }

        if (HasUmlProfileScenario)
        {
            return CreateUmlProfileScenarioModel();
        }

        if (HasArchimate32ProfileScenario)
        {
            return CreateArchimate32ProfileScenarioModel();
        }

        if (HasErdProfileScenario)
        {
            return CreateErdNoStencilsScenarioModel();
        }

        if (HasPerformanceScenario)
        {
            return CreatePerformanceLargeScenarioModel();
        }

        if (Fresh == false)
        {
            model.Metadata.IsFresh = false;
            model.Metadata.SourceVersion = string.IsNullOrWhiteSpace(model.Metadata.SourceVersion)
                ? "stale"
                : $"{model.Metadata.SourceVersion}-stale";
        }

        ApplyModelingTreeScenario(model);
        ApplyDiagramPreviewScenario(model);
        ApplyIssueScenario(model);
        ApplyInspectorScenario(model);

        return model;
    }

    private ModelingModelDto CreateUmlProfileScenarioModel()
    {
        if (string.Equals(Scenario, "uml25-usecase", StringComparison.OrdinalIgnoreCase))
            return CreateUmlUseCaseScenarioModel();

        if (string.Equals(Scenario, "uml25-include-invalid", StringComparison.OrdinalIgnoreCase))
            return CreateUmlInvalidIncludeScenarioModel();

        return CreateUmlClassScenarioModel(emptyClassOnly: string.Equals(Scenario, "uml25-class-empty", StringComparison.OrdinalIgnoreCase));
    }

    private static ModelingModelDto CreateUmlClassScenarioModel(bool emptyClassOnly)
    {
        var orderClass = CreateUmlElement("uml-order", "Class", "Order", "demo/uml25/order", new()
        {
            ["attributes"] = JsonSerializer.SerializeToElement(emptyClassOnly ? Array.Empty<string>() : ["- id: Guid", "- number: string", "- total: decimal"]),
            ["operations"] = JsonSerializer.SerializeToElement(emptyClassOnly ? Array.Empty<string>() : ["+ Submit(): void", "+ Cancel(reason: string): void"])
        });
        var aggregate = CreateUmlElement("uml-aggregate", "AbstractClass", "AggregateRoot", "demo/uml25/aggregate", new()
        {
            ["attributes"] = JsonSerializer.SerializeToElement(new[] { "- version: long" }),
            ["operations"] = JsonSerializer.SerializeToElement(new[] { "+ Raise(event): void" })
        });
        var repository = CreateUmlElement("uml-repository", "Interface", "IOrderRepository", "demo/uml25/repository", new()
        {
            ["operations"] = JsonSerializer.SerializeToElement(new[] { "+ Get(id: Guid): Order", "+ Save(order: Order): Task" }),
            ["attributes"] = JsonSerializer.SerializeToElement(Array.Empty<string>())
        });
        var status = CreateUmlElement("uml-status", "Enumeration", "OrderStatus", "demo/uml25/status", new()
        {
            ["literals"] = JsonSerializer.SerializeToElement(new[] { "Draft", "Submitted", "Cancelled" })
        });

        return new ModelingModelDto
        {
            Id = emptyClassOnly ? "demo-uml25-class-empty" : "demo-uml25-class",
            Title = emptyClassOnly ? "UML 2.5 empty class" : "UML 2.5 class diagram",
            Notation = "uml25",
            SupportedNotations = ["uml25"],
            Metadata = CreateUmlMetadata("2026.06-uml25-class"),
            Elements = emptyClassOnly
                ? [orderClass]
                : [aggregate, orderClass, repository, status],
            Relationships = emptyClassOnly
                ? []
                :
                [
                    CreateUmlRelationship("uml-generalization-order-aggregate", "uml-order", "uml-aggregate", "Generalization", string.Empty),
                    CreateUmlRelationship("uml-realization-order-repository", "uml-order", "uml-repository", "Realization", string.Empty),
                    CreateUmlRelationship("uml-association-order-status", "uml-order", "uml-status", "Association", "status")
                ],
            Views =
            [
                new ModelingViewDto
                {
                    Id = "uml25-class-view",
                    Name = emptyClassOnly ? "Empty class" : "Order class diagram",
                    Notation = "uml25",
                    ViewpointKey = "ClassDiagram",
                    Nodes = emptyClassOnly
                        ? [new() { ElementId = "uml-order", X = 320, Y = 160, Width = 210, Height = 72 }]
                        :
                        [
                            new() { ElementId = "uml-aggregate", X = 350, Y = 70, Width = 230, Height = 160 },
                            new() { ElementId = "uml-order", X = 160, Y = 300, Width = 240, Height = 185 },
                            new() { ElementId = "uml-repository", X = 540, Y = 300, Width = 250, Height = 165 },
                            new() { ElementId = "uml-status", X = 830, Y = 315, Width = 190, Height = 150 }
                        ],
                    Connections = emptyClassOnly
                        ? []
                        :
                        [
                            new() { RelationshipId = "uml-generalization-order-aggregate", SourceNodeId = "uml-order", TargetNodeId = "uml-aggregate" },
                            new() { RelationshipId = "uml-realization-order-repository", SourceNodeId = "uml-order", TargetNodeId = "uml-repository" },
                            new() { RelationshipId = "uml-association-order-status", SourceNodeId = "uml-order", TargetNodeId = "uml-status" }
                        ]
                }
            ]
        };
    }

