    private ModelingModelDto CreateArchimate32ProfileScenarioModel()
    {
        if (string.Equals(Scenario, "archimate32-missing-stencil", StringComparison.OrdinalIgnoreCase))
            return CreateArchimate32MissingStencilScenarioModel();

        if (string.Equals(Scenario, "archimate32-motivation", StringComparison.OrdinalIgnoreCase))
            return CreateArchimate32MotivationScenarioModel();

        if (string.Equals(Scenario, "archimate32-relationships", StringComparison.OrdinalIgnoreCase))
            return CreateArchimate32RelationshipsScenarioModel();

        if (string.Equals(Scenario, "archimate32-invalid-relationship", StringComparison.OrdinalIgnoreCase))
            return CreateArchimate32InvalidRelationshipScenarioModel();

        if (string.Equals(Scenario, "archimate32-large-relationships", StringComparison.OrdinalIgnoreCase))
            return CreateArchimate32LargeRelationshipsScenarioModel();

        if (string.Equals(Scenario, "archimate32-viewpoints", StringComparison.OrdinalIgnoreCase))
            return CreateArchimate32ViewpointsScenarioModel();

        return CreateArchimate32BusinessAppScenarioModel();
    }

