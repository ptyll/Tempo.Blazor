@page "/data-display"
@using Tempo.Blazor.Models
@using Tempo.Blazor.Components.DataTable
@using Tempo.Blazor.Interfaces
@inject ToastService Toast
@inject ITmLocalizer Loc
<PageTitle>Data Display – Tempo.Blazor</PageTitle>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Data Display</h1>
    <p class="text-slate-600 dark:text-slate-400">Components for presenting data in various formats including badges, cards, stats, and lists.</p>
</div>

<!-- Badges -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Badges</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">Status indicators</span>
    </div>
    <div class="showcase-card" data-testid="badges-card">
        <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">Variants</h3>
        <div class="flex flex-wrap gap-3 mb-6">
            <TmBadge Variant="BadgeVariant.Primary">Primary</TmBadge>
            <TmBadge Variant="BadgeVariant.Success">Success</TmBadge>
            <TmBadge Variant="BadgeVariant.Warning">Warning</TmBadge>
            <TmBadge Variant="BadgeVariant.Danger">Danger</TmBadge>
            <TmBadge Variant="BadgeVariant.Info">Info</TmBadge>
        </div>
        
        <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">Styles</h3>
        <div class="flex flex-wrap gap-3 mb-6">
            <TmBadge Variant="BadgeVariant.Primary">Filled (Default)</TmBadge>
            <TmBadge Variant="BadgeVariant.Primary" Style="BadgeStyle.Outlined">Outlined</TmBadge>
            <TmBadge Variant="BadgeVariant.Success" Style="BadgeStyle.Subtle">Subtle</TmBadge>
        </div>
        
        <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">Features</h3>
        <div class="flex flex-wrap gap-3">
            <TmBadge Variant="BadgeVariant.Primary" IsPill="true">Pill Shape</TmBadge>
            <TmBadge Variant="BadgeVariant.Success" HasDot="true">With Dot</TmBadge>
            <TmBadge Variant="BadgeVariant.Warning" IsPill="true" HasDot="true">Pill + Dot</TmBadge>
        </div>
    </div>
</section>

<!-- Stat Cards -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Stat Cards</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">Metrics display</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <TmStatCard Value="12,345" Label="Total Users" />
        <TmStatCard Value="98.5%" Label="Uptime" SubValue="+0.3% vs last month" SubValueColor="var(--tm-color-success-text)" />
        <TmStatCard Value="42" Label="Open Issues" />
        <TmStatCard Value="$124.5K" Label="Revenue" SubValue="↑ 18% MoM" SubValueColor="var(--tm-color-success-text)" />
    </div>
</section>

<!-- KPI stat cards: the 2.10.0 additive surface. Delta + trend direction + comparison label,
     decorative icon, sparkline, animated numeric value, loading skeleton. -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">@Loc["TmDataDisplayDemo_KpiCards"]</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">@Loc["TmDataDisplayDemo_KpiBadge"]</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" data-testid="stat-cards-kpi">
        <TmStatCard Title="Revenue" NumericValue="@_revenue" AnimateValue="@_animateRevenue" Delta="12.5"
                    ComparisonLabel="vs. last month" Icon="trending-up" Sparkline="@_revenueTrend" />
        <TmStatCard Title="Churn" NumericValue="2.1" ValueFormat="N1" ValueSuffix=" %" Delta="-3"
                    PositiveIsGood="false" ComparisonLabel="vs. last month" Icon="user-minus" />
        <TmStatCard Title="Open tickets" Value="42" Delta="0" ComparisonLabel="vs. last week" Icon="activity" />
        <TmStatCard Title="Uptime" Value="99.9%" IsLoading="true" />
    </div>
</section>

<!-- Whole-card targets: Href renders an <a>, OnClick a <button> — one native focus stop. -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">@Loc["TmDataDisplayDemo_InteractiveCards"]</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">@Loc["TmDataDisplayDemo_InteractiveBadge"]</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" data-testid="stat-cards-interactive">
        <TmStatCard Title="Active users" NumericValue="12345" Href="data-display" Icon="users" />
        <TmStatCard Title="Sessions" Value="48,200" OnClick="@OnSessionsClicked" Icon="activity" />
    </div>
</section>

<!-- Animated numbers: one accessible value, a ticker that retargets when the value changes. -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">@Loc["TmDataDisplayDemo_AnimatedNumbers"]</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">@Loc["TmDataDisplayDemo_AnimatedBadge"]</span>
    </div>
    <div class="showcase-card" data-testid="animated-numbers">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">@Loc["TmDataDisplayDemo_AnimatedHint"]</p>
        <div class="flex flex-wrap items-baseline gap-8 mb-4">
            <TmAnimatedNumber Value="@_revenue" Format="N0" Class="text-3xl font-bold text-slate-900 dark:text-white" />
            <TmAnimatedNumber Value="@_ratio" Format="P1" Class="text-2xl font-semibold text-primary-600 dark:text-primary-300" />
            <TmAnimatedNumber Value="@_revenue" Format="N0" Prefix="$" Class="text-2xl font-semibold text-slate-700 dark:text-slate-200" />
        </div>
        <div class="flex flex-wrap gap-2">
            <TmButton Variant="ButtonVariant.Primary" Size="ButtonSize.Sm" data-testid="animated-bump" OnClick="@BumpRevenue">@Loc["TmDataDisplayDemo_AnimatedBump"]</TmButton>
            <TmButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" OnClick="@ResetRevenue">@Loc["TmDataDisplayDemo_AnimatedReset"]</TmButton>
        </div>
    </div>
</section>

<!-- Trend list: compact metric rows with a culture-formatted delta (arrow + tone + hidden word),
     an optional sparkline, a table layout and a loading state. -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">@Loc["TmDataDisplayDemo_TrendList"]</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">@Loc["TmDataDisplayDemo_TrendListBadge"]</span>
    </div>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">@Loc["TmDataDisplayDemo_TrendListHint"]</p>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4" data-testid="trend-list-section">
        <div class="showcase-card">
            <TmTrendList Title="@Loc["TmDataDisplayDemo_TrendListTitle"]" Items="@_trendItems" />
        </div>
        <div class="showcase-card">
            <TmTrendList Title="@Loc["TmDataDisplayDemo_TrendListTableTitle"]"
                         Layout="TrendListLayout.Table"
                         Items="@_trendItems" />
        </div>
        <div class="showcase-card">
            <TmTrendList Title="@Loc["TmDataDisplayDemo_TrendListLoadingTitle"]"
                         Items="@_trendItems"
                         IsLoading="true" />
        </div>
    </div>
</section>

<!-- Breakdown card: the period switch drives the host data, so the rows re-order and the FLIP
     transition runs; the declared-total card shows the explicit remainder row. -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">@Loc["TmDataDisplayDemo_BreakdownCard"]</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">@Loc["TmDataDisplayDemo_BreakdownBadge"]</span>
    </div>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">@Loc["TmDataDisplayDemo_BreakdownHint"]</p>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4" data-testid="breakdown-card-section">
        <TmBreakdownCard Title="@Loc["TmDataDisplayDemo_BreakdownTitle"]"
                         Parts="@BreakdownParts"
                         PeriodOptions="@_periodOptions"
                         @bind-Period="_breakdownPeriod" />
        <TmBreakdownCard Title="@Loc["TmDataDisplayDemo_BreakdownTotalTitle"]"
                         Parts="@BreakdownParts"
                         Total="12000" />
    </div>
</section>


<!-- Facet filter: grouped options with result counts, a search box inside the long group, a
     truncation with "Show more", active filters as removable chips and a clear-all action. The
     left card is the popover presentation (a bottom sheet on a phone), the right one is inline. -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">@Loc["TmDataDisplayDemo_FacetFilter"]</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">@Loc["TmDataDisplayDemo_FacetFilterBadge"]</span>
    </div>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">@Loc["TmDataDisplayDemo_FacetFilterHint"]</p>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4" data-testid="facet-filter-section">
        <div class="showcase-card">
            <TmFacetFilter Groups="@_facetGroups"
                           @bind-Selected="_facetSelection"
                           ResultCount="@FacetResultCount"
                           OnApply="ApplyFacetFilters" />
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-400" data-testid="facet-filter-applied">
                @Loc["TmDataDisplayDemo_FacetFilterApplied", _facetAppliedCount, FacetSelectionSummary]
            </p>
        </div>
        <div class="showcase-card">
            <TmFacetFilter Presentation="FacetFilterPresentation.Inline"
                           Title="@Loc["TmDataDisplayDemo_FacetFilterInlineTitle"]"
                           Groups="@_facetGroups"
                           @bind-Selected="_facetInlineSelection"
                           ResultCount="@FacetResultCount" />
        </div>
    </div>
</section>


<!-- Trace waterfall: a generated agent run with LLM, tool, HTTP and DB spans, one failed HTTP call
     and a live mode that grows the running span through the injectable TimeProvider. Selecting a row
     opens its detail (right of the grid on a wide container, below it on a narrow one). -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">@Loc["TmDataDisplayDemo_TraceWaterfall"]</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">@Loc["TmDataDisplayDemo_TraceWaterfallBadge"]</span>
    </div>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">@Loc["TmDataDisplayDemo_TraceWaterfallHint"]</p>
    @* No extra card wrapper: the waterfall paints its own surface, and the extra padding of a
       showcase card would push the component's own container below the 1024 px detail breakpoint. *@
    <div data-testid="trace-waterfall-section">
        <div class="flex flex-wrap gap-2 mb-3">
            <TmButton Variant="ButtonVariant.Primary" Size="ButtonSize.Sm"
                      data-testid="trace-live-toggle"
                      OnClick="ToggleTraceLive">@(_traceLive ? Loc["TmDataDisplayDemo_TraceLiveStop"] : Loc["TmDataDisplayDemo_TraceLiveStart"])</TmButton>
        </div>
        <TmTraceWaterfall Spans="_traceSpans"
                          Title="@Loc["TmDataDisplayDemo_TraceWaterfallTitle"]"
                          MetricColumns="_traceColumns"
                          LiveMode="_traceLive"
                          LiveTickInterval="TimeSpan.FromMilliseconds(500)"
                          @bind-SelectedSpanId="_traceSelectedId">
            <DetailTemplate Context="span">
                <h4 class="font-semibold text-sm">@span.Name</h4>
                <dl class="text-xs mt-2 space-y-1" data-testid="trace-detail-content">
                    <div class="flex gap-2">
                        <dt class="text-slate-500 dark:text-slate-400">@Loc["TmDataDisplayDemo_TraceKind"]</dt>
                        <dd>@span.Kind</dd>
                    </div>
                    <div class="flex gap-2">
                        <dt class="text-slate-500 dark:text-slate-400">@Loc["TmDataDisplayDemo_TraceStatus"]</dt>
                        <dd>@span.Status</dd>
                    </div>
                    <div class="flex gap-2">
                        <dt class="text-slate-500 dark:text-slate-400">@Loc["TmDataDisplayDemo_TraceTokens"]</dt>
                        <dd>@TraceTokens(span)</dd>
                    </div>
                </dl>
            </DetailTemplate>
        </TmTraceWaterfall>
    </div>
</section>

<!-- Usage meter: how much of a monthly credit quota is gone. The buttons walk the meter through
     the warning state (the NearLimitContent call to action appears), the critical state and the
     over-limit reading, and back to a normal month. The compact meter beside it is the same data in
     a card-corner presentation. -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">@Loc["TmDataDisplayDemo_UsageMeter"]</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">@Loc["TmDataDisplayDemo_UsageMeterBadge"]</span>
    </div>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">@Loc["TmDataDisplayDemo_UsageMeterHint"]</p>
    <div data-testid="usage-meter-section" class="demo-grid demo-grid-2">
        <div class="flex flex-col gap-3">
            <TmUsageMeter Title="@Loc["TmDataDisplayDemo_UsageMeterTitle"]"
                          Used="_usageUsed"
                          Limit="_usageLimit"
                          Unit="@Loc["TmDataDisplayDemo_UsageMeterUnit"]"
                          ResetsAt="_usageResetsAt"
                          Categories="_usageCategories"
                          DailyUsage="_usageDaily">
                <NearLimitContent>
                    <TmButton Variant="ButtonVariant.Primary" Size="ButtonSize.Sm"
                              data-testid="usage-meter-upgrade"
                              OnClick="BuyMoreCredits">@Loc["TmDataDisplayDemo_UsageMeterUpgrade"]</TmButton>
                </NearLimitContent>
            </TmUsageMeter>
            <div class="flex flex-wrap gap-2">
                <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm"
                          data-testid="usage-meter-add"
                          OnClick="AddDemoUsage">@Loc["TmDataDisplayDemo_UsageMeterAdd"]</TmButton>
                <TmButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          data-testid="usage-meter-reset"
                          OnClick="ResetDemoUsage">@Loc["TmDataDisplayDemo_UsageMeterReset"]</TmButton>
            </div>
        </div>
        @* items-start keeps the compact copy its own height instead of stretching it over the whole
           grid row (the full meter on the left is much taller). The compact presentation keeps a
           VISIBLE title (a sighted reader needs the label too), so the meter is named by it instead
           of by an aria-label only. *@
        <div class="flex items-start">
            <TmUsageMeter Compact="true"
                          Title="@Loc["TmDataDisplayDemo_UsageMeterTitle"]"
                          Used="_usageUsed"
                          Limit="_usageLimit"
                          Unit="@Loc["TmDataDisplayDemo_UsageMeterUnit"]" />
        </div>
    </div>
</section>

<!-- Cards -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Cards</h2>
    </div>
    <div class="demo-grid demo-grid-3">
        <TmCard Header="Default Card">
            <p class="text-slate-600 dark:text-slate-400 text-sm">
                This is a basic card with a header and content area. Perfect for displaying grouped information.
            </p>
        </TmCard>
        
        <TmCard Header="With Footer" Variant="CardVariant.Elevated">
            <ChildContent>
                <p class="text-slate-600 dark:text-slate-400 text-sm">
                    Cards can include footer content for actions or additional information.
                </p>
            </ChildContent>
            <FooterContent>
                <div class="flex items-center justify-between">
                    <span class="text-sm text-slate-500">Last updated: Today</span>
                    <TmButton Variant="ButtonVariant.Primary" Size="ButtonSize.Sm">Action</TmButton>
                </div>
            </FooterContent>
        </TmCard>
        
        <TmCard Header="With Icon" HeaderIcon="@IconNames.Star" Variant="CardVariant.Outlined">
            <p class="text-slate-600 dark:text-slate-400 text-sm">
                Add icons to card headers for better visual hierarchy and recognition.
            </p>
        </TmCard>
    </div>
</section>

<!-- Avatars -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Avatars</h2>
    </div>
    <div class="demo-grid demo-grid-2">
        <div class="showcase-card">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">Image Avatars</h3>
            <div class="flex items-center gap-4">
                <div class="flex flex-col items-center space-y-2">
                    <TmAvatar Src="https://i.pravatar.cc/150?img=1" Size="AvatarSize.Sm" />
                    <span class="text-xs text-slate-500">Small</span>
                </div>
                <div class="flex flex-col items-center space-y-2">
                    <TmAvatar Src="https://i.pravatar.cc/150?img=2" Size="AvatarSize.Md" />
                    <span class="text-xs text-slate-500">Medium</span>
                </div>
                <div class="flex flex-col items-center space-y-2">
                    <TmAvatar Src="https://i.pravatar.cc/150?img=3" Size="AvatarSize.Lg" />
                    <span class="text-xs text-slate-500">Large</span>
                </div>
                <div class="flex flex-col items-center space-y-2">
                    <TmAvatar Src="https://i.pravatar.cc/150?img=4" Size="AvatarSize.Xl" />
                    <span class="text-xs text-slate-500">Extra Large</span>
                </div>
            </div>
        </div>
        
        <div class="showcase-card">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">Initials Avatars</h3>
            <div class="flex items-center gap-4">
                <TmAvatar Name="Alice Smith" Size="AvatarSize.Md" />
                <TmAvatar Name="Bob Jones" Size="AvatarSize.Md" Color="AvatarColor.Blue" />
                <TmAvatar Name="Carol White" Size="AvatarSize.Md" Color="AvatarColor.Green" />
                <TmAvatar Name="David Brown" Size="AvatarSize.Md" Color="AvatarColor.Purple" />
                <TmAvatar Name="Emma Davis" Size="AvatarSize.Md" Color="AvatarColor.Pink" />
            </div>
        </div>
        
        <div class="showcase-card sm:col-span-2">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">Avatar Group</h3>
            <div class="flex items-center gap-6">
                <TmAvatarGroup Max="3" Size="AvatarSize.Md">
                    <TmAvatar Src="https://i.pravatar.cc/150?img=5" />
                    <TmAvatar Src="https://i.pravatar.cc/150?img=6" />
                    <TmAvatar Src="https://i.pravatar.cc/150?img=7" />
                    <TmAvatar Name="D E" />
                    <TmAvatar Name="F G" />
                </TmAvatarGroup>
                
                <TmAvatarGroup Max="4" Size="AvatarSize.Sm">
                    <TmAvatar Src="https://i.pravatar.cc/150?img=8" />
                    <TmAvatar Src="https://i.pravatar.cc/150?img=9" />
                    <TmAvatar Src="https://i.pravatar.cc/150?img=10" />
                    <TmAvatar Src="https://i.pravatar.cc/150?img=11" />
                    <TmAvatar Src="https://i.pravatar.cc/150?img=12" />
                    <TmAvatar Name="X Y" />
                </TmAvatarGroup>
            </div>
        </div>
    </div>
</section>

<!-- Empty State -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Empty State</h2>
    </div>
    <div class="showcase-card">
        <TmEmptyState Title="No results found"
                      Description="Try adjusting your search or filters to find what you're looking for."
                      Icon="@IconNames.Search"
                      ActionText="Clear filters"
                      OnAction="@(() => { })" />
    </div>
</section>

<!-- Multi-View List -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Multi-View List</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">List / Card / Table</span>
    </div>
    <div class="showcase-card">
        <TmMultiViewList TItem="DemoMvlItem"
                         Items="@_mvlItems"
                         ViewContext="demo-mvl"
                         ViewMode="@_mvlView"
                         ViewModeChanged="@(m => _mvlView = m)"
                         ShowViewSwitcher="true"
                         OnItemClick="@(item => _mvlClicked = item.Title)" />
        @if (_mvlClicked is not null)
        {
            <div class="mt-4 p-3 bg-primary-50 dark:bg-primary-900/20 border border-primary-200 dark:border-primary-800 rounded-lg animate-fade-in">
                <p class="text-sm text-slate-700 dark:text-slate-300">
                    Clicked: <span class="font-semibold text-primary-600 dark:text-primary-400">@_mvlClicked</span>
                </p>
            </div>
        }
    </div>
</section>

<!-- Stretched-link cards: the title is the only tab stop; one key press raises OnItemClick once. -->
<section class="demo-section" data-testid="mvl-stretched-link">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-4">Stretched-link cards</h2>
    <div class="showcase-card">
        <TmMultiViewList TItem="DemoMvlItem"
                         Items="@_mvlItems"
                         ViewContext="demo-mvl-stretched"
                         ViewMode="ListViewMode.Card"
                         ShowViewSwitcher="false"
                         CardActivation="CardActivation.StretchedLink"
                         OnItemClick="@(item => _stretchedClicks++)" />
        <p data-testid="mvl-stretched-clicks">@_stretchedClicks</p>
    </div>
    <div class="showcase-card mt-4">
        <TmMultiViewList TItem="DemoMvlItem"
                         Items="@_mvlItems"
                         ViewContext="demo-mvl-stretched-href"
                         ViewMode="ListViewMode.Card"
                         ShowViewSwitcher="false"
                         CardActivation="CardActivation.StretchedLink"
                         ItemHref="@(item => $"/data-display#person-{item.Id}")"
                         OnItemClick="@(item => _stretchedHrefClicks++)" />
        <p data-testid="mvl-stretched-href-clicks">@_stretchedHrefClicks</p>
    </div>
</section>

<!-- Multi-View List with Grouping -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Multi-View List with Grouping</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">Groupable</span>
    </div>
    <div class="showcase-card">
        <TmMultiViewList TItem="DemoMvlItem"
                         Items="@_mvlItems"
                         ViewContext="demo-mvl-grouped"
                         TitleField="@(x => x.Title)"
                         SubTitleField="@(x => x.SubTitle)"
                         StatusLabelField="@(x => x.StatusLabel)"
                         StatusColorField="@(x => x.StatusColor)"
                         DateField="@(x => x.Date)"
                         GroupableFields="@_mvlGroupFields"
                         GroupsCollapsedByDefault="false"
                         ShowViewSwitcher="true" />
    </div>
</section>

<!-- Change Diff -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Change Diff</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Display property changes with old and new values</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 rounded-full">Audit</span>
    </div>
    
    <div class="showcase-card space-y-6">
        <div>
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">Simple Changes</h3>
            <TmChangeDiff Changes="_simpleChanges" />
        </div>
        
        <div>
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">User Profile Changes</h3>
            <TmChangeDiff Changes="_userChanges" />
        </div>
        
        <div>
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">Empty / Null Values</h3>
            <TmChangeDiff Changes="_nullChanges" />
        </div>
        
        <div>
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">Interactive Demo</h3>
            <p class="text-sm text-slate-500 mb-3">Click to simulate a change:</p>
            <div class="flex gap-2 mb-4">
                <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" OnClick="AddRandomChange">
                    Add Random Change
                </TmButton>
                <TmButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" OnClick="ClearChanges">
                    Clear
                </TmButton>
            </div>
            <TmChangeDiff Changes="_interactiveChanges" />
        </div>
    </div>
</section>

@code {
    // Facet filter (2.10.0): the counts belong to the HOST's data — the component only renders them.
    // The result count is host-computed too, which is what turns the confirmation action into
    // "Show {n} results" and what the polite live region announces when it changes.
    private IReadOnlyDictionary<string, IReadOnlySet<string>>? _facetSelection;
    private IReadOnlyDictionary<string, IReadOnlySet<string>>? _facetInlineSelection;
    private int _facetAppliedCount;

    /// <summary>What the popover's confirmation last reported — the demo's visible feedback.</summary>
    private int FacetResultCount
        => 1840 - (FacetSelectedCount(_facetSelection) * 210) - (FacetSelectedCount(_facetInlineSelection) * 90);

    private string FacetSelectionSummary
    {
        get
        {
            var values = (_facetSelection ?? new Dictionary<string, IReadOnlySet<string>>())
                .SelectMany(pair => pair.Value)
                .ToList();
            return values.Count == 0 ? Loc["TmDataDisplayDemo_FacetFilterNone"] : string.Join(", ", values);
        }
    }

    private static int FacetSelectedCount(IReadOnlyDictionary<string, IReadOnlySet<string>>? selection)
        => selection?.Sum(pair => pair.Value.Count) ?? 0;

    private void ApplyFacetFilters() => _facetAppliedCount = FacetResultCount;

    private readonly IReadOnlyList<FacetGroup> _facetGroups =
    [
        new()
        {
            Key = "status",
            Label = "Status",
            SearchThreshold = 0, // two options never need a search box
            Options =
            [
                new() { Value = "active", Label = "Active", Count = 1_240, Icon = IconNames.Check },
                new() { Value = "archived", Label = "Archived", Count = 420 },
                new() { Value = "draft", Label = "Draft", Count = 96, IsDisabled = true }
            ]
        },
        new()
        {
            Key = "category",
            Label = "Category",
            MaxVisible = 4,
            SearchThreshold = 5, // the demo shows the in-group search without needing 8 options
            IsCollapsed = false,
            Options =
            [
                new() { Value = "electronics", Label = "Electronics", Count = 512 },
                new() { Value = "books", Label = "Books", Count = 301 },
                new() { Value = "garden", Label = "Garden", Count = 188 },
                new() { Value = "toys", Label = "Toys", Count = 143 },
                new() { Value = "clothing", Label = "Clothing", Count = 87 },
                new() { Value = "music", Label = "Music", Count = 54 },
                new() { Value = "sports", Label = "Sports", Count = 31 }
            ]
        },
        new()
        {
            Key = "availability",
            Label = "Availability",
            IsCollapsed = true,
            Options =
            [
                new() { Value = "in-stock", Label = "In stock", Count = 402 },
                new() { Value = "preorder", Label = "Pre-order", Count = 118 }
            ]
        }
    ];

    private ListViewMode _mvlView = ListViewMode.Card;
    private string? _mvlClicked;

    // KPI / animated number demo (2.10.0). The metric values are host data, not UI chrome.
    private double _revenue = 12450;
    private double _ratio = 0.125;
    private bool _animateRevenue = true;
    private readonly double[] _revenueTrend = [8, 12, 10, 16, 14, 20, 24];

    private void BumpRevenue()
    {
        _revenue += 1000;
        _ratio += 0.01;
    }

    private void ResetRevenue()
    {
        _revenue = 12450;
        _ratio = 0.125;
    }

    private void OnSessionsClicked() => Toast.ShowInfo(Loc["TmDataDisplayDemo_SessionsToast"]);

    // Trend list (2.10.0): the labels and values are host data; the delta format comes from the culture.
    private readonly IReadOnlyList<TrendItem> _trendItems =
    [
        new() { Id = "revenue", Label = "Revenue", NumericValue = 12450, Delta = 12.5, Sparkline = [8, 12, 10, 16, 14, 20, 24] },
        new() { Id = "churn", Label = "Churn", Value = "2.1 %", Delta = -3, PositiveIsGood = false },
        new() { Id = "tickets", Label = "Open tickets", Value = "42", Delta = 0 },
        new() { Id = "nps", Label = "NPS", Value = "61", Delta = 4.2, Href = "data-display" }
    ];

    // Breakdown card (2.10.0): the period switch changes the values, which re-sorts the rows — the
    // visible proof that the FLIP reorder runs only when the ORDER changes.
    private string _breakdownPeriod = "month";

    private IReadOnlyList<SelectOption<string>> _periodOptions = [];

    private IReadOnlyList<BreakdownPart> BreakdownParts => _breakdownPeriod == "week" ? WeekParts : MonthParts;

    private static readonly IReadOnlyList<BreakdownPart> MonthParts =
    [
        new() { Id = "direct", Label = "Direct", Value = 4200 },
        new() { Id = "search", Label = "Search", Value = 3100 },
        new() { Id = "social", Label = "Social", Value = 1800 },
        new() { Id = "email", Label = "E-mail", Value = 900 }
    ];

    private static readonly IReadOnlyList<BreakdownPart> WeekParts =
    [
        new() { Id = "direct", Label = "Direct", Value = 640 },
        new() { Id = "search", Label = "Search", Value = 980 },
        new() { Id = "social", Label = "Social", Value = 210 },
        new() { Id = "email", Label = "E-mail", Value = 320 }
    ];


    // Trace waterfall (2.10.0): a generated agent run — the root span, its LLM and tool calls, the
    // HTTP and DB leaves and one failed request. The list is FLAT; the component builds the tree from
    // ParentId. The live mode re-supplies the running spans through the component's own ticker.
    private IReadOnlyList<TraceSpan> _traceSpans = [];
    private IReadOnlyList<TraceMetricColumn> _traceColumns = [];
    private string? _traceSelectedId;
    private bool _traceLive;


    // Usage meter (2.10.0): a monthly credit quota. 8 200 of 10 000 starts in the warning state (the
    // warning threshold is 80 %), so the call to action is visible on load; each click of
    // "Use 1 500 credits" pushes the meter through critical and over the limit (which also grows the
    // "Other" category row, because the categories no longer explain the extra usage). The daily
    // array feeds the sparkline.
    private const double DemoUsageLimit = 10_000;
    private const double DemoUsageStart = 8_200;
    private const double DemoUsageStep = 1_500;

    private double _usageUsed = DemoUsageStart;
    private double _usageLimit = DemoUsageLimit;
    private readonly DateTimeOffset _usageResetsAt = new(2026, 7, 1, 0, 0, 0, TimeSpan.Zero);
    private readonly double[] _usageDaily = [180, 420, 260, 640, 310, 880, 520];

    private readonly IReadOnlyList<UsageCategory> _usageCategories =
    [
        new() { Key = "llm", Label = "LLM", Used = 5_500 },
        new() { Key = "tools", Label = "Tools", Used = 1_400, Color = "var(--tm-color-info)" },
        new() { Key = "storage", Label = "Storage", Used = 1_300 }
    ];

    private void AddDemoUsage()
    {
        _usageUsed = Math.Min(_usageUsed + DemoUsageStep, _usageLimit * 1.5);
        Toast.ShowInfo(Loc["TmDataDisplayDemo_UsageMeterAdded"]);
    }

    private void ResetDemoUsage()
    {
        _usageUsed = DemoUsageStart;
        Toast.ShowInfo(Loc["TmDataDisplayDemo_UsageMeterResetDone"]);
    }

    private void BuyMoreCredits() => Toast.ShowInfo(Loc["TmDataDisplayDemo_UsageMeterAdded"]);

    private void ToggleTraceLive()
    {
        _traceLive = !_traceLive;
        _traceSpans = BuildTrace(DateTimeOffset.UtcNow, _traceLive);
    }

    private string TraceTokens(TraceSpan span)
    {
        var tokensIn = span.Metrics.TryGetValue("tokens_in", out var input) ? input : 0;
        var tokensOut = span.Metrics.TryGetValue("tokens_out", out var output) ? output : 0;
        return $"{tokensIn:N0} / {tokensOut:N0}";
    }

    /// <summary>
    /// Builds the demo trace anchored at <paramref name="now"/>. With <paramref name="running"/> the
    /// root and the last LLM call have no end, so the component's live ticker grows them.
    /// </summary>
    private static IReadOnlyList<TraceSpan> BuildTrace(DateTimeOffset now, bool running)
    {
        var start = now.AddMilliseconds(-1_240);
        DateTimeOffset At(int offsetMs) => start.AddMilliseconds(offsetMs);

        return
        [
            new()
            {
                Id = "run", Name = "agent run", Kind = TraceSpanKind.Agent, StartedAt = start,
                EndedAt = running ? null : At(1_240),
                Status = running ? TraceSpanStatus.Running : TraceSpanStatus.Ok,
                Metrics = new Dictionary<string, double> { ["tokens_in"] = 1_820, ["tokens_out"] = 640, ["cost"] = 0.42 }
            },
            new()
            {
                Id = "plan", ParentId = "run", Name = "plan the task", Kind = TraceSpanKind.Llm,
                StartedAt = At(0), EndedAt = At(260),
                Metrics = new Dictionary<string, double> { ["tokens_in"] = 620, ["tokens_out"] = 180, ["cost"] = 0.11 }
            },
            new()
            {
                Id = "search", ParentId = "run", Name = "search_web", Kind = TraceSpanKind.Tool,
                StartedAt = At(260), EndedAt = At(720),
                Metrics = new Dictionary<string, double> { ["tokens_in"] = 240, ["tokens_out"] = 40 }
            },
            new()
            {
                Id = "search-http", ParentId = "search", Name = "GET /search", Kind = TraceSpanKind.Http,
                StartedAt = At(280), EndedAt = At(640)
            },
            new()
            {
                Id = "lookup", ParentId = "run", Name = "lookup_customer", Kind = TraceSpanKind.Tool,
                StartedAt = At(720), EndedAt = At(900)
            },
            new()
            {
                Id = "lookup-db", ParentId = "lookup", Name = "SELECT customers", Kind = TraceSpanKind.Db,
                StartedAt = At(740), EndedAt = At(860)
            },
            new()
            {
                Id = "notify", ParentId = "run", Name = "POST /notify", Kind = TraceSpanKind.Http,
                StartedAt = At(900), EndedAt = At(980), Status = TraceSpanStatus.Error,
                Attributes = new Dictionary<string, string> { ["http.status"] = "503" }
            },
            new()
            {
                Id = "answer", ParentId = "run", Name = "compose answer", Kind = TraceSpanKind.Llm,
                StartedAt = At(980), EndedAt = running ? null : At(1_240),
                Status = running ? TraceSpanStatus.Running : TraceSpanStatus.Ok,
                Metrics = new Dictionary<string, double> { ["tokens_in"] = 960, ["tokens_out"] = 420, ["cost"] = 0.31 }
            }
        ];
    }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _periodOptions =
        [
            new SelectOption<string>("month", Loc["TmDataDisplayDemo_PeriodMonth"]),
            new SelectOption<string>("week", Loc["TmDataDisplayDemo_PeriodWeek"])
        ];

        // The facet demo opens with one value picked in each surface, so the chips and the counts
        // are visible on first paint instead of behind a click.
        _facetSelection = new Dictionary<string, IReadOnlySet<string>>(StringComparer.Ordinal)
        {
            ["status"] = new HashSet<string>(StringComparer.Ordinal) { "active" }
        };
        _facetInlineSelection = new Dictionary<string, IReadOnlySet<string>>(StringComparer.Ordinal)
        {
            ["category"] = new HashSet<string>(StringComparer.Ordinal) { "books" }
        };
        _facetAppliedCount = FacetResultCount;

        // The metric column labels are UI chrome, so they come from the localizer, not from literals.
        _traceColumns =
        [
            new TraceMetricColumn("tokens_in", Loc["TmDataDisplayDemo_TraceTokensIn"], "N0"),
            new TraceMetricColumn("tokens_out", Loc["TmDataDisplayDemo_TraceTokensOut"], "N0"),
            new TraceMetricColumn("cost", Loc["TmDataDisplayDemo_TraceCost"], "C2")
        ];
        _traceSpans = BuildTrace(DateTimeOffset.UtcNow, running: false);
        _traceSelectedId = "answer";
    }

    // Change Diff
    private List<TmChangeInfo> _simpleChanges = new()
    {
        new("Status", "Draft", "Published"),
        new("Title", "Old Title", "New Title"),
    };

    private List<TmChangeInfo> _userChanges = new()
    {
        new("Name", "John Smith", "John Doe"),
        new("Email", "john.smith@example.com", "john.doe@example.com"),
        new("Department", "Sales", "Engineering"),
        new("Role", "User", "Admin"),
        new("Active", "false", "true"),
    };

    private List<TmChangeInfo> _nullChanges = new()
    {
        new("Description", null, "Added description text"),
        new("Deleted Field", "Previous value", null),
        new("Both Empty", null, null),
    };

    private List<TmChangeInfo> _interactiveChanges = new();
    private int _changeCounter = 0;

    private void AddRandomChange()
    {
        _changeCounter++;
        var properties = new[] { "Name", "Email", "Status", "Priority", "Assignee" };
        var values = new[] { "Value A", "Value B", "Value C", "Updated", "New" };
        
        var prop = properties[Random.Shared.Next(properties.Length)];
        var oldVal = values[Random.Shared.Next(values.Length)];
        var newVal = values[Random.Shared.Next(values.Length)];
        
        _interactiveChanges.Add(new($"{prop} #{_changeCounter}", oldVal, newVal));
        Toast.ShowInfo($"Added change: {prop}");
    }

    private void ClearChanges()
    {
        _interactiveChanges.Clear();
        _changeCounter = 0;
        Toast.ShowInfo("Changes cleared");
    }

    private int _stretchedClicks;
    private int _stretchedHrefClicks;

    private readonly IReadOnlyList<DemoMvlItem> _mvlItems = new[]
    {
        new DemoMvlItem("1", "Alice Smith", "Engineering", "Active", "#22c55e", DateTimeOffset.Now.AddDays(-1)),
        new DemoMvlItem("2", "Bob Jones", "Marketing", "On leave", "#f59e0b", DateTimeOffset.Now.AddDays(-3)),
        new DemoMvlItem("3", "Carol White", "Design", "Active", "#22c55e", DateTimeOffset.Now.AddDays(-2)),
        new DemoMvlItem("4", "Dave Black", "Product", "Inactive", "#ef4444", DateTimeOffset.Now.AddDays(-7)),
        new DemoMvlItem("5", "Eve Green", "Engineering", "Active", "#22c55e", DateTimeOffset.Now.AddDays(-0)),
    };

    private record DemoMvlItem(string Id, string Title, string? SubTitle,
        string? StatusLabel, string? StatusColor, DateTimeOffset? Date) : IMultiViewListItem
    {
        public string? AvatarUrl => null;
        public IReadOnlyList<ITag>? Tags => null;
    }

    private readonly IReadOnlyList<GroupFieldDefinition<DemoMvlItem>> _mvlGroupFields = new[]
    {
        new GroupFieldDefinition<DemoMvlItem>
        {
            FieldName = "SubTitle",
            Label = "Department",
            FieldAccessor = x => x.SubTitle ?? ""
        },
        new GroupFieldDefinition<DemoMvlItem>
        {
            FieldName = "StatusLabel",
            Label = "Status",
            FieldAccessor = x => x.StatusLabel ?? ""
        }
    };
}
