<!-- Form Validation Message -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Form Validation Message</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Field-level validation messages for EditForm</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-rose-100 dark:bg-rose-900/30 text-rose-700 dark:text-rose-300 rounded-full">Validation</span>
    </div>
    
    <div class="showcase-card">
        <EditForm Model="_validationMessageModel" OnValidSubmit="HandleValidationSubmit">
            <DataAnnotationsValidator />
            
            <div class="space-y-4 max-w-md">
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">
                        Username <span class="text-red-500">*</span>
                    </label>
                    <InputText @bind-Value="_validationMessageModel.Username" class="tm-input w-full" placeholder="Enter username" />
                    <TmFormValidationMessage For="@(() => _validationMessageModel.Username)" class="mt-1" />
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">
                        Email <span class="text-red-500">*</span>
                    </label>
                    <InputText @bind-Value="_validationMessageModel.Email" class="tm-input w-full" placeholder="user@example.com" />
                    <TmFormValidationMessage For="@(() => _validationMessageModel.Email)" class="mt-1" />
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">
                        Age <span class="text-red-500">*</span>
                    </label>
                    <InputNumber @bind-Value="_validationMessageModel.Age" class="tm-input w-full" />
                    <TmFormValidationMessage For="@(() => _validationMessageModel.Age)" class="mt-1" />
                </div>
                
                <div class="pt-2">
                    <TmButton Type="ButtonType.Submit" Variant="ButtonVariant.Primary">Validate</TmButton>
                </div>
            </div>
        </EditForm>
    </div>
</section>

<!-- Decimal Input -->
<section class="demo-section" data-testid="decimal-input-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Decimal Input</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Culture-aware decimal entry with steppers, percent mode and EditForm validation</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-full">New</span>
    </div>

    <div class="demo-grid demo-grid-2">
        <div class="showcase-card" data-testid="decimal-input-basic-card">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">Basic Usage</h3>
            <div class="space-y-4">
                <div data-testid="decimal-input-basic">
                    <TmDecimalInput @bind-Value="_decimalBasic"
                                    Label="Amount"
                                    Placeholder="0.00"
                                    HelpText="Type 1234,56 or 1234.56 — both are understood." />
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Bound value:
                    <span class="font-mono" data-testid="decimal-input-basic-value">@FormatBound(_decimalBasic)</span>
                </p>
            </div>
        </div>

        <div class="showcase-card" data-testid="decimal-input-culture-card">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">Culture Formatting</h3>
            <div class="space-y-4">
                <div data-testid="decimal-input-czech">
                    <TmDecimalInput @bind-Value="_decimalCulture"
                                    Label="Czech (cs-CZ)"
                                    Culture="@CzechCulture"
                                    Prefix="Kč"
                                    ShowButtons="false" />
                </div>
                <div data-testid="decimal-input-english">
                    <TmDecimalInput @bind-Value="_decimalCulture"
                                    Label="English (en-US)"
                                    Culture="@EnglishCulture"
                                    Prefix="$"
                                    ShowButtons="false" />
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Both fields share one value:
                    <span class="font-mono" data-testid="decimal-input-culture-value">@FormatBound(_decimalCulture)</span>
                </p>
            </div>
        </div>

        <div class="showcase-card" data-testid="decimal-input-range-card">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">Min / Max / Step</h3>
            <div class="space-y-4">
                <div data-testid="decimal-input-range">
                    <TmDecimalInput @bind-Value="_decimalRange"
                                    Label="Rating (0–10, step 0.5)"
                                    Min="0"
                                    Max="10"
                                    Step="0.5m"
                                    DecimalPlaces="1"
                                    HelpText="Steppers and the ↑/↓ keys move by 0.5; out-of-range input is clamped." />
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Bound value:
                    <span class="font-mono" data-testid="decimal-input-range-value">@FormatBound(_decimalRange)</span>
                </p>
            </div>
        </div>

        <div class="showcase-card" data-testid="decimal-input-percent-card">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">Percent Mode</h3>
            <div class="space-y-4">
                <div data-testid="decimal-input-percent">
                    <TmDecimalInput @bind-Value="_decimalPercent"
                                    Label="VAT rate"
                                    Percent="true"
                                    Min="0"
                                    Max="100"
                                    Step="1"
                                    HelpText="The field shows percent, the model keeps the fraction." />
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Stored fraction:
                    <span class="font-mono" data-testid="decimal-input-percent-value">@FormatBound(_decimalPercent)</span>
                </p>
            </div>
        </div>

        <div class="showcase-card" data-testid="decimal-input-validation-card">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">EditForm Validation</h3>
            <EditForm Model="_priceModel" OnValidSubmit="HandlePriceSubmit">
                <DataAnnotationsValidator />
                <div class="space-y-4">
                    <div data-testid="decimal-input-validated">
                        <TmDecimalInput @bind-Value="_priceModel.UnitPrice"
                                        Label="Unit price"
                                        Prefix="Kč"
                                        Culture="@CzechCulture"
                                        HelpText="Must be between 10 and 1000." />
                    </div>
                    <TmButton Type="ButtonType.Submit" Variant="ButtonVariant.Primary" data-testid="decimal-input-submit">Submit</TmButton>
                </div>
            </EditForm>
        </div>

        <div class="showcase-card" data-testid="decimal-input-states-card">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">Disabled &amp; Read-only</h3>
            <div class="space-y-4">
                <div data-testid="decimal-input-disabled">
                    <TmDecimalInput Value="1234.5m" Label="Disabled" Disabled="true" Culture="@CzechCulture" />
                </div>
                <div data-testid="decimal-input-readonly">
                    <TmDecimalInput Value="1234.5m" Label="Read-only" ReadOnly="true" Culture="@CzechCulture" Suffix="Kč" />
                </div>
                <div data-testid="decimal-input-error">
                    <TmDecimalInput Value="5m" Label="With error" Error="Amount is too low." Culture="@CzechCulture" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Signature Pad -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Signature Pad</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Freehand signature capture with SVG rendering</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-full">New</span>
    </div>
    
    <div class="demo-grid demo-grid-2">
        <div class="showcase-card">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">Basic Signature</h3>
            <TmSignature @bind-Value="_signatureValue" />
            @if (!string.IsNullOrEmpty(_signatureValue))
            {
                <p class="text-xs text-slate-500 mt-2">Signature captured (@_signatureValue.Length chars)</p>
            }
        </div>
        
        <div class="showcase-card">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">Custom Style</h3>
            <TmSignature @bind-Value="_signatureValue2"
                         StrokeColor="#3b82f6"
                         StrokeWidth="3"
                         BackgroundColor="#eff6ff"
                         Width="350"
                         Height="150" />
        </div>
    </div>
</section>

@code {
    // Decimal Input
    private static readonly System.Globalization.CultureInfo CzechCulture = System.Globalization.CultureInfo.GetCultureInfo("cs-CZ");
    private static readonly System.Globalization.CultureInfo EnglishCulture = System.Globalization.CultureInfo.GetCultureInfo("en-US");

    private decimal? _decimalBasic = 1234.5m;
    private decimal? _decimalCulture = 1234.5m;
    private decimal? _decimalRange = 7.5m;
    private decimal? _decimalPercent = 0.21m;
    private readonly PriceModel _priceModel = new() { UnitPrice = 250m };

    private sealed class PriceModel
    {
        [System.ComponentModel.DataAnnotations.Range(10, 1000, ErrorMessage = "Unit price must be between 10 and 1000.")]
        public decimal? UnitPrice { get; set; }
    }

    /// <summary>Renders the bound decimal invariantly so the demo shows what the model really holds.</summary>
    private static string FormatBound(decimal? value) =>
        value?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null";

    private void HandlePriceSubmit()
    {
        Toast.ShowSuccess($"Unit price accepted: {FormatBound(_priceModel.UnitPrice)}");
    }

    // Expression Editor
    private string _exprValue = "Dear {{sender.name}}, your message ";
    
    // Inline Edit
    private string _inlineValue1 = "Click me to edit this text";
    private string _inlineValue2 = "Valid text";
    private string _tableName = "John Doe";
    private string _tableEmail = "john@example.com";
    private string _tableDept = "Engineering";
    
    private string? ValidateInline(string? value)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
            return "Must be at least 3 characters";
        return null;
    }

    private void OnInlineSave1(string value)
    {
        _inlineValue1 = value;
        Toast.ShowSuccess("Saved: " + value);
    }

    private void OnInlineSave2(string value)
    {
        _inlineValue2 = value;
        Toast.ShowSuccess("Saved: " + value);
    }
    
    // Form Validation Message
    private ValidationMessageModel _validationMessageModel = new();
    
    private void HandleValidationSubmit()
    {
        Toast.ShowSuccess("Form is valid!");
    }
    
    public class ValidationMessageModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Username is required")]
        [System.ComponentModel.DataAnnotations.MinLength(3, ErrorMessage = "Username must be at least 3 characters")]
        public string Username { get; set; } = "";
        
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Please enter a valid email address")]
        public string Email { get; set; } = "";
        
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Age is required")]
        [System.ComponentModel.DataAnnotations.Range(18, 120, ErrorMessage = "Age must be between 18 and 120")]
        public int Age { get; set; }
    }
    
    private static readonly IReadOnlyList<ExpressionVariable> _exprVars =
    [
        new() { Name = "sender.name", Description = "Full name of the sender", Type = "string" },
        new() { Name = "sender.email", Description = "Email address of the sender", Type = "string" },
        new() { Name = "message.subject", Description = "Subject line of the message", Type = "string" },
        new() { Name = "message.date", Description = "Date the message was received", Type = "DateTime" },
        new() { Name = "message.id", Description = "Unique message identifier", Type = "string" },
    ];

    // Multi Select
    private IReadOnlyList<string> _selectedFruits = [];
    private IReadOnlyList<string> _selectedTech = [];
    private IReadOnlyList<string> _selectedDelimiter = [];
    private IReadOnlyList<string> _selectedMax = [];

    private static readonly List<SelectOption<string>> _fruitOptions =
    [
        new("apple", "Apple"),
        new("banana", "Banana"),
        new("cherry", "Cherry"),
        new("date", "Date"),
        new("elderberry", "Elderberry"),
        new("fig", "Fig")
    ];

    private static readonly List<SelectOption<string>> _techOptions =
    [
        new("blazor", "Blazor"),
        new("react", "React"),
        new("angular", "Angular"),
        new("vue", "Vue"),
        new("svelte", "Svelte")
    ];

    private string _name = string.Empty;
    private string _email = string.Empty;
    private string _help = string.Empty;
    private string _description = string.Empty;
    private string _limited = string.Empty;
    private string? _selectedRole;
    private bool _accepted;
    private bool _subscribed;
    private bool _notifications = true;
    private bool _emailNotifications;
    private bool _darkMode;
    private bool _disabledToggle;
    private string? _selectedPlan = "starter";
    private string _search = string.Empty;
    private string _password = string.Empty;

    // Real-time validation
    private ValidationModel _validationModel = new();

    private bool? IsUsernameValid => string.IsNullOrEmpty(_validationModel.Username) 
        ? null 
        : _validationModel.Username.Length >= 3;
    
    private bool? IsEmailValid => string.IsNullOrEmpty(_validationModel.Email) 
        ? null 
        : System.Text.RegularExpressions.Regex.IsMatch(_validationModel.Email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$");
    
    private bool? IsPhoneValid => string.IsNullOrEmpty(_validationModel.Phone) 
        ? null 
        : _validationModel.Phone.Length >= 10 && _validationModel.Phone.All(c => char.IsDigit(c) || c == ' ' || c == '+' || c == '-' || c == '(' || c == ')');

    private string? UsernameError => IsUsernameValid == false ? "Username must be at least 3 characters" : null;
    private string? EmailError => IsEmailValid == false ? "Please enter a valid email address" : null;
    private string? PhoneError => IsPhoneValid == false ? "Please enter a valid phone number (at least 10 digits)" : null;

    public class ValidationModel
    {
        public string Username { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
    }

    // CascadingSelect demo
    private static readonly IReadOnlyList<SelectOption<string>> _cascadeRegions = new List<SelectOption<string>>
    {
        new("bohemia", "Bohemia"),
        new("moravia", "Moravia"),
        new("silesia", "Silesia"),
    };

    private static readonly Dictionary<string, List<SelectOption<string>>> _cascadeCities = new()
    {
        ["bohemia"] = [new("prague", "Prague"), new("pilsen", "Pilsen"), new("ceske-budejovice", "České Budějovice")],
        ["moravia"] = [new("brno", "Brno"), new("olomouc", "Olomouc"), new("zlin", "Zlín")],
        ["silesia"] = [new("ostrava", "Ostrava"), new("opava", "Opava"), new("karvina", "Karviná")],
    };

    private string? _cascadeRegion;
    private string? _cascadeCity;

    private async Task<IReadOnlyList<SelectOption<string>>> LoadCitiesAsync(string? region)
    {
        await Task.Delay(300); // simulate network
        if (region is null || !_cascadeCities.TryGetValue(region, out var cities)) return [];
        return cities;
    }

    // CurrencyInput demo
    private static readonly IReadOnlyList<SelectOption<string>> _demoCurrencies = new List<SelectOption<string>>
    {
        new("USD", "USD – US Dollar"),
        new("EUR", "EUR – Euro"),
        new("GBP", "GBP – British Pound"),
        new("CZK", "CZK – Czech Koruna"),
        new("CHF", "CHF – Swiss Franc"),
    };

    private decimal? _currAmount;
    private string? _currCurrency;

    private decimal? _currAmount2;
    private string? _currCurrency2;
    private decimal? _currConverted2;

    private decimal? _currAmount3;
    private string? _currCurrency3;
    private decimal? _currConverted3;
    private decimal? _currManualRate3;

    private decimal? _currAmount4;
    private string? _currCurrency4;
    private decimal? _currConverted4;

    private static readonly Dictionary<string, decimal> _demoRates = new()
    {
        { "USD", 23.10m }, { "EUR", 25.40m }, { "GBP", 29.80m }, { "CZK", 1m }, { "CHF", 25.90m },
    };

    // Provider-driven conversion: a small in-memory (currency → CZK) rate table.
    private static readonly IExchangeRateProvider _rateProvider = new InMemoryExchangeRateProvider(
        _demoRates.ToDictionary(kvp => (kvp.Key, "CZK"), kvp => kvp.Value));

    private async Task<decimal?> SimulateConvertAsync(decimal amount, string currency)
    {
        await Task.Delay(400); // simulate network
        return _demoRates.TryGetValue(currency, out var rate)
            ? Math.Round(amount * rate, 2)
            : null;
    }

    // ToggleSection demo
    private bool? _toggleVat;
    private bool? _toggleVatExpand;
    private string? _vatNumber;
    private bool? _toggleFrequency;

    private List<SelectOption<string>> _roleOptions = new()
    {
        new("admin", "Admin"),
        new("editor", "Editor"),
        new("viewer", "Viewer"),
    };

    private string? _selectedDevice = "desktop";

    private List<RadioOption<string>> _deviceOptions = new()
    {
        new("Desktop", "desktop"),
        new("Tablet", "tablet"),
        new("Mobile", "mobile"),
    };

    private List<RadioOption<string>> _planOptions = new()
    {
        new("Free plan", "free"),
        new("Starter plan", "starter"),
        new("Pro plan", "pro"),
    };

    private string GetPlanName(string? value) => value switch
    {
        "free" => "Free Plan",
        "starter" => "Starter Plan",
        "pro" => "Pro Plan",
        _ => value ?? "Unknown"
    };

    // FluentValidation form
    private PersonFormModel _personModel = new();
    private bool _submitSuccess;
    private bool _isSubmitting;

    private async Task HandleValidSubmit()
    {
        _isSubmitting = true;
        await Task.Delay(800); // Simulate API call
        _isSubmitting = false;
        _submitSuccess = true;
    }

    private void HandleInvalidSubmit()
    {
        _submitSuccess = false;
    }

    private void ResetForm()
    {
        _personModel = new PersonFormModel();
        _submitSuccess = false;
    }

    // Signature Pad
    private string? _signatureValue;
    private string? _signatureValue2;
}
