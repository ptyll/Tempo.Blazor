@page "/chat"
@using Tempo.Blazor.Components.Chat
@using Tempo.Blazor.Models
<PageTitle>Chat – Tempo.Blazor</PageTitle>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Chat</h1>
    <p class="text-slate-600 dark:text-slate-400">
        A conversation component with message bubbles, typing indicators, attachments, and send input.
    </p>
</div>

<!-- Basic Conversation -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Basic Conversation</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">Core</span>
    </div>

    <div class="showcase-card" style="height: 500px;">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Standard chat with incoming and outgoing messages, timestamps, and avatars.
        </p>
        <TmChat CurrentUser="_currentUser"
                Messages="_basicMessages"
                OnSendMessage="HandleBasicSend"
                TypingUsers="_basicTyping" />
    </div>
</section>

<!-- Threads, reactions & receipts (two users) -->
<section class="demo-section" data-testid="chat-collab-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Threads, Reactions &amp; Receipts</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-full">Collaboration</span>
    </div>

    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        One shared conversation seen by two users. Reply in a thread, react with emoji, edit or delete your
        own messages, and watch per-user read receipts appear as the other side sees each message.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div data-testid="chat-pane-alice">
            <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">Alice's view</p>
            <div class="showcase-card" style="height: 520px;">
                <TmChat CurrentUser="_alice"
                        Messages="_sharedMessages"
                        OnSend="@(r => HandleCollabSend(_alice, r))"
                        OnEditMessage="HandleCollabEdit"
                        OnDeleteMessage="HandleCollabDelete"
                        OnToggleReaction="@(t => HandleCollabReaction(_alice, t))"
                        OnMessageRead="@(id => HandleCollabRead(_alice, id))" />
            </div>
        </div>
        <div data-testid="chat-pane-bob">
            <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">Bob's view</p>
            <div class="showcase-card" style="height: 520px;">
                <TmChat CurrentUser="_bob"
                        Messages="_sharedMessages"
                        OnSend="@(r => HandleCollabSend(_bob, r))"
                        OnEditMessage="HandleCollabEdit"
                        OnDeleteMessage="HandleCollabDelete"
                        OnToggleReaction="@(t => HandleCollabReaction(_bob, t))"
                        OnMessageRead="@(id => HandleCollabRead(_bob, id))" />
            </div>
        </div>
    </div>
</section>

<!-- Typing Indicator -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Typing Indicator</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full">UX</span>
    </div>

    <div class="showcase-card" style="height: 400px;">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Animated dots and user names when someone is typing.
        </p>
        <TmChat CurrentUser="_currentUser"
                Messages="_typingMessages"
                TypingUsers="_typingUsers" />
    </div>

    <div class="showcase-card mt-6">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Custom TypingLabel (left; also hides the indicator from screen readers via TypingAriaHidden, for hosts that announce typing in their own live region), and a host TypingTemplate with a 6-second TypingTimeout (right). The expiring list starts EMPTY, so the right indicator stays hidden until you press <em>Send typing refresh</em>, which opens a fresh 6-second window — the window restarts whenever the host re-assigns the list.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <TmChat CurrentUser="_currentUser"
                        Messages="_typingMessages"
                        TypingUsers="_customTypingUsers"
                        TypingLabel="@(users => $"{users[0].Name} is composing…")"
                        TypingAriaHidden="true" />
            </div>
            <div class="flex flex-col">
                <TmChat CurrentUser="_currentUser"
                        Messages="_typingMessages"
                        TypingUsers="_expiringTypingUsers"
                        TypingTimeout="TimeSpan.FromSeconds(6)">
                    <TypingTemplate Context="users">
                        <div class="flex items-center gap-2 self-start px-3 py-2 rounded-lg bg-slate-100 dark:bg-slate-700 text-sm text-slate-600 dark:text-slate-300">
                            <TmIcon Name="edit" Size="IconSize.Sm" />
                            <span>@(users.Count == 1 ? $"{users[0].Name} is typing (host template)" : $"{users.Count} people are typing (host template)")</span>
                        </div>
                    </TypingTemplate>
                </TmChat>
                <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" OnClick="RefreshExpiringTyping" Class="mt-2 self-start">Send typing refresh</TmButton>
            </div>
        </div>
    </div>
</section>

<!-- With Attachments -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">With Attachments</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full">Files</span>
    </div>

    <div class="showcase-card" style="height: 400px;">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Messages can include file attachments. Click an attachment to trigger the callback.
        </p>
        <TmChat CurrentUser="_currentUser"
                Messages="_attachmentMessages"
                OnAttachmentClick="HandleAttachmentClick" />
    </div>

    @if (!string.IsNullOrEmpty(_lastAttachment))
    {
        <div class="mt-3 p-3 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700">
            <p class="text-sm text-slate-600 dark:text-slate-400">Clicked: <strong>@_lastAttachment</strong></p>
        </div>
    }
</section>

<!-- System Messages -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">System Messages</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 rounded-full">Info</span>
    </div>

    <div class="showcase-card" style="height: 400px;">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            System messages for events like user joins, leaves, or channel updates.
        </p>
        <TmChat CurrentUser="_currentUser"
                Messages="_systemMessages" />
    </div>
</section>

<!-- Composer Behavior (FZE-5) -->
<section class="demo-section" data-testid="chat-composer-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Composer Behavior</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-indigo-100 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 rounded-full">UX</span>
    </div>

    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        Enter submits (with the IME composition guard in chat.js), Shift+Enter inserts a new line
        and the textarea grows with its content up to the row cap; the composer is focused again
        after each successful send (RefocusAfterSend).
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="showcase-card" style="height: 440px;">
            <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
                <strong>EnterToSend="false"</strong>: Enter is a native new line in the composer,
                the thread reply and an open edit — Ctrl/⌘+Enter and the Send button send. This
                demo chat keeps its own message list.
            </p>
            <TmChat CurrentUser="_currentUser"
                    Messages="_enterToSendMessages"
                    OnSendMessage="HandleEnterToSendDemo"
                    EnterToSend="false" />
        </div>

        <div class="showcase-card" style="height: 440px;">
            <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
                <strong>A custom composer</strong> (subscribe gate, owner note, …) keeps the same
                behavior: the host registers its own input with
                <code>composer.AttachAsync(input)</code> once mounted, and Enter/IME + refocus
                work on it exactly as on the built-in composer. The demo's host handler throws for
                texts ending with an exclamation mark. On the Enter path the exception surfaces
                through the renderer and is caught by the <code>ErrorBoundary</code> around this
                chat — press Recover to restore the composer. On the Send-button path the handler
                is awaited by the card, the draft is kept and the error notice below shows up.
                This demo chat keeps its own message list.
            </p>
            <ErrorBoundary @ref="_customBoundary">
                <ChildContent>
                    <TmChat CurrentUser="_currentUser"
                            Messages="_customComposerMessages"
                            OnSendMessage="HandleCustomSend"
                            ComposerTemplate="CustomComposer" />
                </ChildContent>
                <ErrorContent>
                    <div role="alert" class="mt-2 p-2 text-sm text-rose-700 dark:text-rose-300 bg-rose-50 dark:bg-rose-900/30 rounded-lg border border-rose-200 dark:border-rose-800 flex items-center justify-between gap-2">
                        <span>The composer handler threw on the Enter path — the exception surfaced through the renderer and this ErrorBoundary caught it.</span>
                        <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm"
                                  OnClick="@(() => _customBoundary?.Recover())">Recover</TmButton>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
            @if (_customSendFailed)
            {
                <div role="alert" class="mt-2 p-2 text-sm text-rose-700 dark:text-rose-300 bg-rose-50 dark:bg-rose-900/30 rounded-lg border border-rose-200 dark:border-rose-800">
                    The handler threw — the text was kept so the draft is not lost. Press Send again.
                </div>
            }
        </div>
    </div>
</section>

<!-- Interactive Demo -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Interactive Demo</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-full">Live</span>
    </div>

    <div class="showcase-card" style="height: 500px;">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Type a message and hit send. Simulate an AI or bot response with typing delay.
        </p>
        <TmChat CurrentUser="_currentUser"
                Messages="_liveMessages"
                OnSendMessage="HandleLiveSend"
                TypingUsers="_liveTyping" />
    </div>
</section>

<!-- Scroll behavior -->
<section class="demo-section" data-testid="chat-scroll-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Scroll Behavior</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-full">Live</span>
    </div>

    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        The default <code>AutoScroll="ChatAutoScroll.WhenAtBottom"</code>: the conversation opens at the
        bottom and new messages scroll it only while you keep up. Scroll up, then press
        <em>Inject incoming message</em> — the reading position stays and a floating button counts what
        you missed (your own messages always scroll). Press <em>Load older</em> (or scroll to the top) to
        prepend a page of history without losing your place.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="md:col-span-2">
            <div class="showcase-card" style="height: 520px;">
                <TmChat @ref="_scrollChat"
                        CurrentUser="_currentUser"
                        Messages="_scrollMessages"
                        OnSend="@(r => HandleScrollOwnSend(r))"
                        OnLoadOlder="HandleScrollLoadOlderAsync"
                        HasMoreBefore="_scrollHasMore"
                        IsLoadingOlder="_scrollLoadingOlder" />
            </div>
        </div>
        <div class="flex flex-col gap-2 self-start">
            <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" OnClick="HandleScrollInjectAsync">
                Inject incoming message
            </TmButton>
            <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" OnClick="HandleScrollOwnAsync">
                Send a message as Alice
            </TmButton>
            <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" OnClick="HandleScrollLoadOlderAsync"
                      Disabled="@( _scrollLoadingOlder || !_scrollHasMore )">
                @(_scrollLoadingOlder ? "Loading older…" : "Load older")
            </TmButton>
            <p class="text-xs text-slate-500 dark:text-slate-400">
                IsAtBottom: <strong>@(_scrollChat?.IsAtBottom)</strong> — the jump button hides itself
                once you are back at the bottom, and the count resets with it.
            </p>
        </div>
    </div>
</section>

<section class="demo-section" data-testid="chat-a11y-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Accessibility</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-violet-100 dark:bg-violet-900/30 text-violet-700 dark:text-violet-300 rounded-full">Live region</span>
    </div>

    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        Exactly ONE polite live region per chat: new incoming messages are announced with the host's
        text (<code>MessageAnnouncement</code>), a burst inside the 1-second window is summarized
        (<code>BatchAnnouncement</code>) and host actions go through <code>AnnounceAsync</code>.
        The messages container is a labelled keyboard-scrollable <code>role="region"</code>; the
        typing indicator is never announced.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="md:col-span-2">
            <div class="showcase-card" style="height: 420px;">
                <TmChat @ref="_a11yChat"
                        CurrentUser="_currentUser"
                        Messages="_a11yMessages"
                        MessagesAriaLabel="Accessibility demo messages"
                        MessageAnnouncement="DescribeAnnouncement"
                        BatchAnnouncement="@(batch => $"{batch.Count} new messages arrived")" />
            </div>
        </div>
        <div class="flex flex-col gap-2 self-start">
            <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" OnClick="HandleA11yInjectAsync">
                Deliver incoming message
            </TmButton>
            <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" OnClick="HandleA11yBurstAsync">
                Deliver a burst of 3
            </TmButton>
            <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" OnClick="HandleA11yHostActionAsync">
                Approve a draft (host action)
            </TmButton>
            <p class="text-xs text-slate-500 dark:text-slate-400">
                A screen reader announces the injected messages through the chat's single polite
                region; the burst collapses into one summary and the host action is announced on
                its own. Turn on your screen reader (or the NVDA speech viewer) and try it.
            </p>
        </div>
    </div>
</section>

<!-- Layout & mobile (FZE-8) -->
<section class="demo-section" data-testid="chat-mobile-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Layout &amp; Mobile</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 rounded-full">FZE-8</span>
    </div>

    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        The chat as a flex child (<code>FillParent</code>), the host-owned minimum height
        (<code>--tm-chat-min-height</code>), the sticky composer above a bottom navigation
        (<code>--tm-chat-composer-offset</code> + safe area) and the full-width thread overlay on a
        narrow chat. All three panes branch on the CHAT's own width, so the narrow behaviors are
        visible on a desktop window too.
    </p>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 items-start">
        <div data-testid="chat-fill-pane" class="lg:col-span-3">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-2">FillParent</h3>
            <div class="chat-demo-split">
                <TmChat Class="chat-demo-fill"
                        FillParent="true"
                        CurrentUser="_currentUser"
                        Messages="_mobileMessages"
                        OnSendMessage="HandleMobileSend" />
                <aside class="chat-demo-side">
                    <p class="text-xs text-slate-500 dark:text-slate-400">
                        The chat is a flex child here: it grows and shrinks with the pane while the
                        side panel keeps its width. FillParent releases the floor — the modifier
                        reads <code>min-height: var(--tm-chat-min-height, 0)</code>, so the parent
                        owns the height unless the host declares a floor of its own.
                    </p>
                </aside>
            </div>
        </div>

        <div data-testid="chat-thread-overlay-pane">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-2">Narrow chat — full-width thread overlay</h3>
            <div class="chat-demo-narrow">
                <TmChat CurrentUser="_alice"
                        Messages="_mobileMessages"
                        OnSendMessage="HandleMobileSend" />
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">
                This chat is ~340px wide, i.e. below the 640px container breakpoint: open the
                thread of the first message and the panel overlays the whole chat instead of
                squeezing the composer.
            </p>
        </div>

        <div data-testid="chat-mobile-phone">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-2">Sticky composer above a bottom navigation</h3>
            <div class="chat-demo-phone">
                <div class="chat-demo-phone__page">
                    <div class="chat-demo-phone__content">
                        <p class="chat-demo-phone__filler">
                            Scroll the phone — the composer stays above the fake bottom navigation
                            while the chat's box extends past the fold, and rests in its natural
                            place once the end is reached.
                        </p>
                        <TmChat FillParent="true"
                                CurrentUser="_alice"
                                Messages="_mobileMessages"
                                OnSendMessage="HandleMobileSend" />
                        <p class="chat-demo-phone__filler">
                            The host sets <code>--tm-chat-composer-offset</code> to the height of
                            its bottom navigation; the composer also clears the home indicator via
                            <code>env(safe-area-inset-bottom)</code> — set
                            <code>--tm-chat-safe-area-bottom: 0</code> when your bottom navigation
                            already pads the safe area. Keeping it above the iOS virtual keyboard
                            (visualViewport) is a recorded carry-forward.
                        </p>
                    </div>
                </div>
                <nav class="chat-demo-phone__nav" aria-label="Fake bottom navigation (demo)">
                    <span class="chat-demo-phone__nav-item"><TmIcon Name="home" Size="IconSize.Sm" /> Home</span>
                    <span class="chat-demo-phone__nav-item"><TmIcon Name="message-circle" Size="IconSize.Sm" /> Chats</span>
                    <span class="chat-demo-phone__nav-item"><TmIcon Name="settings" Size="IconSize.Sm" /> Settings</span>
                </nav>
            </div>
        </div>
    </div>
</section>

@code {
    private ChatUser _currentUser = default!;
    private ChatUser _alice = default!;
    private ChatUser _bob = default!;
    private ChatUser _carol = default!;

    private string? _lastAttachment;

    // ── Collaboration demo (shared conversation, two users) ──────────────
    private List<ChatMessage> _sharedMessages = default!;

    // ── Basic demo ────────────────────────────────────────────────────────
    private List<ChatMessage> _basicMessages = default!;
    private List<ChatUser> _basicTyping = default!;

    // ── Composer behavior demo (FZE-5) — own lists, not _basicMessages ────
    private List<ChatMessage> _enterToSendMessages = default!;
    private List<ChatMessage> _customComposerMessages = default!;

    // ── Typing demo ───────────────────────────────────────────────────────
    private List<ChatMessage> _typingMessages = default!;
    private List<ChatUser> _typingUsers = default!;

    // ── Typing label / template / expiry demo (FZE-4) ─────────────────────
    private List<ChatUser> _customTypingUsers = default!;
    private List<ChatUser> _expiringTypingUsers = default!;

    // ── Attachment demo ───────────────────────────────────────────────────
    private List<ChatMessage> _attachmentMessages = default!;

    // ── System messages demo ──────────────────────────────────────────────
    private List<ChatMessage> _systemMessages = default!;

    // ── Live interactive demo ─────────────────────────────────────────────
    private List<ChatMessage> _liveMessages = default!;

    // ── Layout & mobile demo (FZE-8) ──
    private List<ChatMessage> _mobileMessages = default!;
    private List<ChatUser> _liveTyping = default!;

    // ── Accessibility demo (FZE-7) ────────────────────────────────────────
    private TmChat _a11yChat = default!;

    protected override void OnInitialized()
    {
        _currentUser = new("u1", "Alice", avatar: "A", isOnline: true);
        _alice = _currentUser;
        _bob = new("u2", "Bob", avatar: "B", isOnline: true);
        _carol = new("u3", "Carol", avatar: "C", isOnline: true);

        // Layout & mobile (FZE-8): a thread on the first message so the narrow-chat overlay pane
        // has a badge to open.
        _mobileMessages = new()
        {
            new ChatMessage { Id = "mob1", Text = "The mobile layout phase is up — sticky composer, 44px targets and the full-width thread overlay.", Author = _bob, Timestamp = new DateTimeOffset(2026, 7, 12, 9, 10, 0, TimeSpan.Zero) },
            new ChatMessage { Id = "mob2", Text = "Does the thread panel still squeeze the composer on a phone?", Author = _carol, Timestamp = new DateTimeOffset(2026, 7, 12, 9, 11, 0, TimeSpan.Zero) },
            new ChatMessage { Id = "mob3", Text = "No — below the 640px container breakpoint it overlays the whole chat instead.", Author = _alice, Timestamp = new DateTimeOffset(2026, 7, 12, 9, 12, 0, TimeSpan.Zero) },
            new ChatMessage { Id = "mob4", Text = "It overlays full width; its own reply input stays at the bottom.", Author = _bob, ThreadRootId = "mob1", Timestamp = new DateTimeOffset(2026, 7, 12, 9, 13, 0, TimeSpan.Zero) },
        };

        // Enough history that the card overflows: the scroll behavior is only observable when
        // the list can actually scroll (and clear the 40px at-bottom threshold).
        _scrollMessages = new()
        {
            new("s1", "Morning! The scroll phase of the chat plan is ready.", _bob, ChatMessageType.Incoming, new DateTimeOffset(2026, 7, 12, 8, 50, 0, TimeSpan.Zero)),
            new("s2", "Nice — does it keep my place when older history loads?", _alice, ChatMessageType.Outgoing, new DateTimeOffset(2026, 7, 12, 8, 51, 0, TimeSpan.Zero)),
            new("s3", "Yes: a prepend shifts scrollTop by the grown height.", _bob, ChatMessageType.Incoming, new DateTimeOffset(2026, 7, 12, 8, 52, 0, TimeSpan.Zero)),
            new("s4", "And messages arriving while I read up top?", _alice, ChatMessageType.Outgoing, new DateTimeOffset(2026, 7, 12, 8, 53, 0, TimeSpan.Zero)),
            new("s5", "Counted behind the jump button — nothing moves until you ask for it.", _bob, ChatMessageType.Incoming, new DateTimeOffset(2026, 7, 12, 8, 54, 0, TimeSpan.Zero)),
            new("s6", "And your own messages?", _carol, ChatMessageType.Incoming, new DateTimeOffset(2026, 7, 12, 8, 55, 0, TimeSpan.Zero)),
            new("s7", "Always scroll to the bottom, even from the middle of the history.", _bob, ChatMessageType.Incoming, new DateTimeOffset(2026, 7, 12, 8, 56, 0, TimeSpan.Zero)),
            new("s8", "What about the browser's own scroll anchoring?", _alice, ChatMessageType.Outgoing, new DateTimeOffset(2026, 7, 12, 8, 57, 0, TimeSpan.Zero)),
            new("s9", "Disabled on the list — it would fight the component's own compensation.", _bob, ChatMessageType.Incoming, new DateTimeOffset(2026, 7, 12, 8, 58, 0, TimeSpan.Zero)),
            new("s10", "Try it: scroll up, inject a message, then load older.", _carol, ChatMessageType.Incoming, new DateTimeOffset(2026, 7, 12, 8, 59, 0, TimeSpan.Zero)),
        };

        _sharedMessages = new()
        {
