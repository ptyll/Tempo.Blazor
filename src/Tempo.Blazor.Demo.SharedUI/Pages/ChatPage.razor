    private void InitializeAutoAttachDemo(ChatUser fan)
    {
        _autoAttachFan = fan;
        _autoAttachSeq = 0;
        _autoAttachCount = 0;
        _autoAttachMessages = new()
        {
            new ChatMessage("aa1", "This composer is attached by id — no AttachAsync in the host.", _autoAttachFan, ChatMessageType.Incoming, _customBase.AddMinutes(-2)),
