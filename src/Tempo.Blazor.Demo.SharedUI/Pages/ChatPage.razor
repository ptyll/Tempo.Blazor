@page "/chat"
@using Tempo.Blazor.Components.Chat
@using Tempo.Blazor.Models
<PageTitle>Chat – Tempo.Blazor</PageTitle>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Chat</h1>
    <p class="text-slate-600 dark:text-slate-400">
        A conversation component with message bubbles, typing indicators, attachments, and send input.
    </p>
</div>

<!-- Basic Conversation -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Basic Conversation</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">Core</span>
    </div>

    <div class="showcase-card" style="height: 500px;">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Standard chat with incoming and outgoing messages, timestamps, and avatars.
        </p>
        <TmChat CurrentUser="_currentUser"
                Messages="_basicMessages"
                OnSendMessage="HandleBasicSend"
                TypingUsers="_basicTyping" />
    </div>
</section>

<!-- Threads, reactions & receipts (two users) -->
<section class="demo-section" data-testid="chat-collab-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Threads, Reactions &amp; Receipts</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-full">Collaboration</span>
    </div>

    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        One shared conversation seen by two users. Reply in a thread, react with emoji, edit or delete your
        own messages, and watch per-user read receipts appear as the other side sees each message.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div data-testid="chat-pane-alice">
            <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">Alice's view</p>
            <div class="showcase-card" style="height: 520px;">
                <TmChat CurrentUser="_alice"
                        Messages="_sharedMessages"
                        OnSend="@(r => HandleCollabSend(_alice, r))"
                        OnEditMessage="HandleCollabEdit"
                        OnDeleteMessage="HandleCollabDelete"
                        OnToggleReaction="@(t => HandleCollabReaction(_alice, t))"
                        OnMessageRead="@(id => HandleCollabRead(_alice, id))" />
            </div>
        </div>
        <div data-testid="chat-pane-bob">
            <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">Bob's view</p>
            <div class="showcase-card" style="height: 520px;">
                <TmChat CurrentUser="_bob"
                        Messages="_sharedMessages"
                        OnSend="@(r => HandleCollabSend(_bob, r))"
                        OnEditMessage="HandleCollabEdit"
                        OnDeleteMessage="HandleCollabDelete"
                        OnToggleReaction="@(t => HandleCollabReaction(_bob, t))"
                        OnMessageRead="@(id => HandleCollabRead(_bob, id))" />
            </div>
        </div>
    </div>
</section>

<!-- Typing Indicator -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Typing Indicator</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full">UX</span>
    </div>

    <div class="showcase-card" style="height: 400px;">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Animated dots and user names when someone is typing.
        </p>
        <TmChat CurrentUser="_currentUser"
                Messages="_typingMessages"
                TypingUsers="_typingUsers" />
    </div>

    <div class="showcase-card mt-6">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Custom TypingLabel (left; also hides the indicator from screen readers via TypingAriaHidden, for hosts that announce typing in their own live region), and a host TypingTemplate with a 6-second TypingTimeout (right). The expiring list starts EMPTY, so the right indicator stays hidden until you press <em>Send typing refresh</em>, which opens a fresh 6-second window — the window restarts whenever the host re-assigns the list.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <TmChat CurrentUser="_currentUser"
                        Messages="_typingMessages"
                        TypingUsers="_customTypingUsers"
                        TypingLabel="@(users => $"{users[0].Name} is composing…")"
                        TypingAriaHidden="true" />
            </div>
            <div class="flex flex-col">
                <TmChat CurrentUser="_currentUser"
                        Messages="_typingMessages"
                        TypingUsers="_expiringTypingUsers"
                        TypingTimeout="TimeSpan.FromSeconds(6)">
                    <TypingTemplate Context="users">
                        <div class="flex items-center gap-2 self-start px-3 py-2 rounded-lg bg-slate-100 dark:bg-slate-700 text-sm text-slate-600 dark:text-slate-300">
                            <TmIcon Name="edit" Size="IconSize.Sm" />
                            <span>@(users.Count == 1 ? $"{users[0].Name} is typing (host template)" : $"{users.Count} people are typing (host template)")</span>
                        </div>
                    </TypingTemplate>
                </TmChat>
                <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" OnClick="RefreshExpiringTyping" Class="mt-2 self-start">Send typing refresh</TmButton>
            </div>
        </div>
    </div>
</section>

<!-- With Attachments -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">With Attachments</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full">Files</span>
    </div>

    <div class="showcase-card" style="height: 400px;">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Messages can include file attachments. Click an attachment to trigger the callback.
        </p>
        <TmChat CurrentUser="_currentUser"
                Messages="_attachmentMessages"
                OnAttachmentClick="HandleAttachmentClick" />
    </div>

    @if (!string.IsNullOrEmpty(_lastAttachment))
    {
        <div class="mt-3 p-3 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700">
            <p class="text-sm text-slate-600 dark:text-slate-400">Clicked: <strong>@_lastAttachment</strong></p>
        </div>
    }
</section>

<!-- System Messages -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">System Messages</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 rounded-full">Info</span>
    </div>

    <div class="showcase-card" style="height: 400px;">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            System messages for events like user joins, leaves, or channel updates.
        </p>
        <TmChat CurrentUser="_currentUser"
                Messages="_systemMessages" />
    </div>
</section>

<!-- Composer Behavior (FZE-5) -->
<section class="demo-section" data-testid="chat-composer-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Composer Behavior</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-indigo-100 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 rounded-full">UX</span>
    </div>

    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        Enter submits (with the IME composition guard in chat.js), Shift+Enter inserts a new line
        and the textarea grows with its content up to the row cap; the composer is focused again
        after each successful send (RefocusAfterSend).
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="showcase-card" style="height: 440px;">
            <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
                <strong>EnterToSend="false"</strong>: Enter is a native new line in the composer,
                the thread reply and an open edit — Ctrl/⌘+Enter and the Send button send. This
                demo chat keeps its own message list.
            </p>
            <TmChat CurrentUser="_currentUser"
                    Messages="_enterToSendMessages"
                    OnSendMessage="HandleEnterToSendDemo"
                    EnterToSend="false" />
        </div>

        <div class="showcase-card" style="height: 440px;">
            <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
                <strong>A custom composer</strong> (subscribe gate, owner note, …) keeps the same
                behavior: the host registers its own input with
                <code>composer.AttachAsync(input)</code> once mounted, and Enter/IME + refocus
                work on it exactly as on the built-in composer. The demo's host handler throws for
                texts ending with an exclamation mark. On the Enter path the exception surfaces
                through the renderer and is caught by the <code>ErrorBoundary</code> around this
                chat — press Recover to restore the composer. On the Send-button path the handler
                is awaited by the card, the draft is kept and the error notice below shows up.
                This demo chat keeps its own message list.
            </p>
            <ErrorBoundary @ref="_customBoundary">
                <ChildContent>
                    <TmChat CurrentUser="_currentUser"
                            Messages="_customComposerMessages"
                            OnSendMessage="HandleCustomSend"
                            ComposerTemplate="CustomComposer" />
                </ChildContent>
                <ErrorContent>
                    <div role="alert" class="mt-2 p-2 text-sm text-rose-700 dark:text-rose-300 bg-rose-50 dark:bg-rose-900/30 rounded-lg border border-rose-200 dark:border-rose-800 flex items-center justify-between gap-2">
                        <span>The composer handler threw on the Enter path — the exception surfaced through the renderer and this ErrorBoundary caught it.</span>
                        <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm"
                                  OnClick="@(() => _customBoundary?.Recover())">Recover</TmButton>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
            @if (_customSendFailed)
            {
                <div role="alert" class="mt-2 p-2 text-sm text-rose-700 dark:text-rose-300 bg-rose-50 dark:bg-rose-900/30 rounded-lg border border-rose-200 dark:border-rose-800">
                    The handler threw — the text was kept so the draft is not lost. Press Send again.
                </div>
            }
        </div>
    </div>
</section>

<!-- Interactive Demo -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Interactive Demo</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-full">Live</span>
    </div>

    <div class="showcase-card" style="height: 500px;">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Type a message and hit send. Simulate an AI or bot response with typing delay.
        </p>
        <TmChat CurrentUser="_currentUser"
                Messages="_liveMessages"
                OnSendMessage="HandleLiveSend"
                TypingUsers="_liveTyping" />
    </div>
</section>

@code {
    private ChatUser _currentUser = default!;
    private ChatUser _alice = default!;
    private ChatUser _bob = default!;
    private ChatUser _carol = default!;

    private string? _lastAttachment;

    // ── Collaboration demo (shared conversation, two users) ──────────────
    private List<ChatMessage> _sharedMessages = default!;

    // ── Basic demo ────────────────────────────────────────────────────────
    private List<ChatMessage> _basicMessages = default!;
    private List<ChatUser> _basicTyping = default!;

    // ── Composer behavior demo (FZE-5) — own lists, not _basicMessages ────
    private List<ChatMessage> _enterToSendMessages = default!;
    private List<ChatMessage> _customComposerMessages = default!;

    // ── Typing demo ───────────────────────────────────────────────────────
    private List<ChatMessage> _typingMessages = default!;
    private List<ChatUser> _typingUsers = default!;

    // ── Typing label / template / expiry demo (FZE-4) ─────────────────────
    private List<ChatUser> _customTypingUsers = default!;
    private List<ChatUser> _expiringTypingUsers = default!;

    // ── Attachment demo ───────────────────────────────────────────────────
    private List<ChatMessage> _attachmentMessages = default!;

    // ── System messages demo ──────────────────────────────────────────────
    private List<ChatMessage> _systemMessages = default!;

    // ── Live interactive demo ─────────────────────────────────────────────
    private List<ChatMessage> _liveMessages = default!;
    private List<ChatUser> _liveTyping = default!;

    protected override void OnInitialized()
    {
        _currentUser = new("u1", "Alice", avatar: "A", isOnline: true);
        _alice = _currentUser;
        _bob = new("u2", "Bob", avatar: "B", isOnline: true);
        _carol = new("u3", "Carol", avatar: "C", isOnline: true);

        _sharedMessages = new()
        {
            new ChatMessage { Id = "c1", Text = "Can we ship the K6 chat update today?", Author = _bob, Timestamp = new DateTimeOffset(2026, 7, 12, 8, 10, 0, TimeSpan.Zero) },
            new ChatMessage { Id = "c2", Text = "Yes — threads, reactions and receipts are all in.", Author = _alice, Timestamp = new DateTimeOffset(2026, 7, 12, 8, 11, 0, TimeSpan.Zero) },
        };

        _basicMessages = new()
        {
            new("m1", "Hey Alice, how is the new component coming along?", new ChatUser("u2", "Bob", "B"), ChatMessageType.Incoming, new DateTimeOffset(2026, 5, 2, 9, 15, 0, TimeSpan.Zero)),
            new("m2", "Pretty good! Just finished the message rendering and styling.", new ChatUser("u1", "Alice", "A"), ChatMessageType.Outgoing, new DateTimeOffset(2026, 5, 2, 9, 16, 0, TimeSpan.Zero)),
            new("m3", "Nice! Does it support attachments too?", new ChatUser("u2", "Bob", "B"), ChatMessageType.Incoming, new DateTimeOffset(2026, 5, 2, 9, 17, 0, TimeSpan.Zero)),
            new("m4", "Yes — file cards with name, size, and click handler.", new ChatUser("u1", "Alice", "A"), ChatMessageType.Outgoing, new DateTimeOffset(2026, 5, 2, 9, 18, 0, TimeSpan.Zero)),
        };
        _basicTyping = new() { new ChatUser("u2", "Bob", "B") };

        // ── Composer behavior demo (FZE-5): each demo chat owns its list ─────
        _enterToSendMessages = new()
        {
            new("e1", "Enter is a new line here — press Ctrl+Enter or use the button.", _bob, ChatMessageType.Incoming, new DateTimeOffset(2026, 5, 2, 9, 20, 0, TimeSpan.Zero)),
        };
        _customComposerMessages = new()
        {
            new("k1", "The custom composer behaves like the built-in one.", _bob, ChatMessageType.Incoming, new DateTimeOffset(2026, 5, 2, 9, 21, 0, TimeSpan.Zero)),
        };

        _typingMessages = new()
        {
            new("t1", "Can you review my PR?", _bob, ChatMessageType.Incoming),
            new("t2", "Sure, give me 5 minutes.", _currentUser, ChatMessageType.Outgoing),
        };
        _typingUsers = new() { _bob, _carol };

        _customTypingUsers = new() { _bob };
        // Starts EMPTY: the 6-second window opens only when the button below assigns a list —
        // the same signal a real host sends when a "still typing" event arrives over the wire.
        _expiringTypingUsers = new();

        _attachmentMessages = new()
        {
            new("a1", "Here is the design mockup", _bob, ChatMessageType.Incoming)
            {
                Attachments = new[]
                {
                    new ChatAttachment("f1", "dashboard-mockup.figma", "/files/dashboard.fig", "application/figma", 2_450_000),
                    new ChatAttachment("f2", "requirements.docx", "/files/req.docx", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", 45_000),
                }
            },
            new("a2", "Thanks, I'll take a look", _currentUser, ChatMessageType.Outgoing),
        };

        _systemMessages = new()
        {
            new("s1", "Bob joined the conversation", type: ChatMessageType.System),
            new("s2", "Hi everyone!", _bob, ChatMessageType.Incoming),
            new("s3", "Hey Bob 👋", _currentUser, ChatMessageType.Outgoing),
            new("s4", "Carol joined the conversation", type: ChatMessageType.System),
            new("s5", "Hello!", _carol, ChatMessageType.Incoming),
        };

        _liveMessages = new()
        {
            new("l1", "Welcome! Type a message and I will echo it back with a delay.", _bob, ChatMessageType.Incoming),
        };
        _liveTyping = new();
    }

    private void HandleBasicSend(string text)
    {
        _basicMessages.Add(new ChatMessage(Guid.NewGuid().ToString(), text, _currentUser, ChatMessageType.Outgoing));
    }

    // ── Composer behavior demo (FZE-5) ────────────────────────────────────
    private ElementReference _customComposerInput;
    private ChatComposerContext? _customComposerContext;
    private string? _customComposerAttachedId;
    private bool _customSendFailed;
    private ErrorBoundary? _customBoundary;

    private RenderFragment<ChatComposerContext> CustomComposer => context =>
    {
        _customComposerContext = context;
        return @<div class="flex items-end gap-2">
            <textarea class="w-full min-h-10 max-h-32 resize-none rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 text-sm px-3 py-2"
                      rows="1"
                      aria-label="Message"
                      placeholder="Type a message…"
                      value="@context.Text"
                      @oninput="@(e => context.SetTextAsync(e.Value?.ToString() ?? string.Empty))"
                      @ref="_customComposerInput"></textarea>
            <TmButton Variant="ButtonVariant.Primary" Size="ButtonSize.Sm"
                      Disabled="@(!context.CanSend)"
                      OnClick="@(async () => {
                          _customSendFailed = false;
                          try
                          {
                              await context.SendAsync();
                          }
                          catch (InvalidOperationException)
                          {
                              _customSendFailed = true; // the demo's failing host — the text stays
                          }
                      })">Send</TmButton>
        </div>;
    };

    private async Task HandleCustomSend(string text)
    {
        if (text.EndsWith("!"))
        {
            // The demo's "failing host": a throw keeps the composer text (FZE-5). The render
            // first so the card's own role="alert" error notice is visible, then the exception
            // propagates — through the renderer (and the ErrorBoundary) on the Enter path, or
            // back to the button handler's catch on the Send-button path.
            _customSendFailed = true;
            StateHasChanged();
            throw new InvalidOperationException("demo host failure");
        }

        _customSendFailed = false;
        _customComposerMessages.Add(new ChatMessage(Guid.NewGuid().ToString(), text, _currentUser, ChatMessageType.Outgoing));
    }

    private void HandleEnterToSendDemo(string text)
    {
        _enterToSendMessages.Add(new ChatMessage(Guid.NewGuid().ToString(), text, _currentUser, ChatMessageType.Outgoing));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_customComposerContext is not null && !string.IsNullOrEmpty(_customComposerInput.Id)
            && _customComposerInput.Id != _customComposerAttachedId)
        {
            _customComposerAttachedId = _customComposerInput.Id;
            await _customComposerContext.AttachAsync(_customComposerInput);
        }
    }

    // A fresh list instance opens a fresh TypingTimeout window — the same signal a real host
    // sends when a "still typing" event arrives over the wire.
    private void RefreshExpiringTyping()
    {
        _expiringTypingUsers = new List<ChatUser> { _bob, _carol };
    }

    // ── Collaboration handlers (shared store, mutated by either user) ─────
    private void HandleCollabSend(ChatUser from, ChatSendRequest r)
    {
        _sharedMessages.Add(new ChatMessage
        {
            Id = Guid.NewGuid().ToString("N"),
            Text = r.Text,
            Author = from,
            Timestamp = DateTimeOffset.Now,
            ReplyToId = r.ReplyToId,
            ThreadRootId = r.ThreadRootId
        });
        StateHasChanged();
    }

    private void HandleCollabEdit(ChatMessageEdit e)
        => Replace(e.MessageId, m => m with { Text = e.NewText, EditedAt = DateTimeOffset.Now });

    private void HandleCollabDelete(string id)
        => Replace(id, m => m with { IsDeleted = true, Reactions = [] });

    private void HandleCollabReaction(ChatUser from, ChatReactionToggle t)
        => Replace(t.MessageId, m => m with { Reactions = ToggleReaction(m.Reactions, t.Emoji, from) });

    private void HandleCollabRead(ChatUser reader, string id)
        => Replace(id, m => m.ReadBy.Any(x => x.User?.Id == reader.Id)
            ? m
            : m with { ReadBy = [.. m.ReadBy, new ChatReadReceipt(reader, DateTimeOffset.Now)] });

    private void Replace(string id, Func<ChatMessage, ChatMessage> update)
    {
        var i = _sharedMessages.FindIndex(m => m.Id == id);
        if (i < 0) return;
        var updated = update(_sharedMessages[i]);
        if (ReferenceEquals(updated, _sharedMessages[i])) return;
        _sharedMessages[i] = updated;
        StateHasChanged();
    }

    private static IReadOnlyList<ChatReaction> ToggleReaction(IReadOnlyList<ChatReaction> reactions, string emoji, ChatUser user)
    {
        var list = reactions.ToList();
        var idx = list.FindIndex(r => r.Emoji == emoji);
        if (idx < 0)
        {
            list.Add(new ChatReaction(emoji, [user]));
            return list;
        }
        var users = list[idx].Users.ToList();
        if (users.RemoveAll(u => u.Id == user.Id) == 0) users.Add(user);
        if (users.Count == 0) list.RemoveAt(idx);
        else list[idx] = list[idx] with { Users = users };
        return list;
    }

    private void HandleAttachmentClick(ChatAttachment attachment)
    {
        _lastAttachment = attachment.Name;
    }

    private async Task HandleLiveSend(string text)
    {
        _liveMessages.Add(new ChatMessage(Guid.NewGuid().ToString(), text, _currentUser, ChatMessageType.Outgoing));

        _liveTyping = new List<ChatUser> { _bob };
        StateHasChanged();
        await Task.Delay(1200);

        _liveTyping = new List<ChatUser>();
        _liveMessages.Add(new ChatMessage(Guid.NewGuid().ToString(), $"Echo: {text}", _bob, ChatMessageType.Incoming));
        StateHasChanged();
    }
}
