            CustomMessage("ct6", "Perfect. Can I pay on site?", fan, ChatMessageType.Incoming, 5),
            CustomMessage("ct7", "Card or cash, both work.", owner, ChatMessageType.Outgoing, 6),
            CustomMessage("ct8", "Great, see you then!", fan, ChatMessageType.Incoming, 7),
            CustomMessage("ct9", "See you 👋", owner, ChatMessageType.Outgoing, 8),
