    private async Task HandleScrollLoadOlderAsync()
    {
        if (_scrollLoadingOlder || !_scrollHasMore) return;
        _scrollLoadingOlder = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(600);
        var page = new List<ChatMessage>();
        for (var i = 0; i < 8; i++)
        {
            _scrollSeq++;
            page.Add(new($"scroll-old-{_scrollSeq}", $"Older message #{_scrollSeq}",
                _carol, ChatMessageType.Incoming, DateTimeOffset.Now.AddMinutes(-_scrollSeq)));
        }
        page.Reverse();
        _scrollMessages.InsertRange(0, page);
        if (_scrollMessages.Count > 60) _scrollHasMore = false; // a finite demo history
        _scrollLoadingOlder = false;
        await InvokeAsync(StateHasChanged);
    }

