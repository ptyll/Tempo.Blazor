            <p class="text-xs text-slate-500 dark:text-slate-400">
                This composer is plain host markup — the demo calls no AttachAsync anywhere: the
                <code>id="@("@composer.InputId")"</code> attribute is the whole registration.
                The counter is plain host state proving the sends flow through the shared
                pipeline (the draft guard covers the host input too).
            </p>
            <p class="text-sm text-slate-700 dark:text-slate-200">
                Sends through the auto-attached composer: <strong data-testid="chat-autoattach-count">@_autoAttachCount</strong>
            </p>
            <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" OnClick="HandleAutoAttachDeliverAsync">
