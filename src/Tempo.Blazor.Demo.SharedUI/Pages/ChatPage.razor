    // ── Composer behavior demo (FZE-5) ────────────────────────────────────
    private ElementReference _customComposerInput;
    private ChatComposerContext? _customComposerContext;
    private string? _customComposerAttachedId;
    private bool _customSendFailed;
    private ErrorBoundary? _customBoundary;

    private RenderFragment<ChatComposerContext> CustomComposer => context =>
    {
        _customComposerContext = context;
        return @<div class="flex items-end gap-2">
            <textarea class="w-full min-h-10 max-h-32 resize-none rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 text-sm px-3 py-2"
                      rows="1"
                      aria-label="Message"
                      placeholder="Type a message…"
                      value="@context.Text"
                      @oninput="@(e => context.SetTextAsync(e.Value?.ToString() ?? string.Empty))"
                      @ref="_customComposerInput"></textarea>
            <TmButton Variant="ButtonVariant.Primary" Size="ButtonSize.Sm"
                      Disabled="@(!context.CanSend)"
                      OnClick="@(async () => {
                          _customSendFailed = false;
                          try
                          {
                              await context.SendAsync();
                          }
                          catch (InvalidOperationException)
                          {
                              _customSendFailed = true; // the demo's failing host — the text stays
                          }
                      })">Send</TmButton>
        </div>;
    };

    private async Task HandleCustomSend(string text)
    {
        if (text.EndsWith("!"))
        {
            // The demo's "failing host": a throw keeps the composer text (FZE-5). The render
            // first so the card's own role="alert" error notice is visible, then the exception
            // propagates — through the renderer (and the ErrorBoundary) on the Enter path, or
            // back to the button handler's catch on the Send-button path.
            _customSendFailed = true;
            StateHasChanged();
            throw new InvalidOperationException("demo host failure");
        }

        _customSendFailed = false;
        _customComposerMessages.Add(new ChatMessage(Guid.NewGuid().ToString(), text, _currentUser, ChatMessageType.Outgoing));
    }

