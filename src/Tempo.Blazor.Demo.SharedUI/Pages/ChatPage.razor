        StateHasChanged();
        await Task.Delay(1200);

        _liveTyping = new List<ChatUser>();
        _liveMessages.Add(new ChatMessage(Guid.NewGuid().ToString(), $"Echo: {text}", _bob, ChatMessageType.Incoming));
        StateHasChanged();
    }

    // ── Scroll behavior demo (FZE-6) — AutoScroll=WhenAtBottom is the default ──
    private TmChat? _scrollChat;
    private List<ChatMessage> _scrollMessages = default!;
    private bool _scrollHasMore = true;
    private bool _scrollLoadingOlder;
    private int _scrollSeq;

    private async Task HandleScrollInjectAsync()
    {
        _scrollSeq++;
        _scrollMessages.Add(new($"scroll-in-{_scrollSeq}", $"Incoming message #{_scrollSeq}",
            _carol, ChatMessageType.Incoming, DateTimeOffset.Now));
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleScrollOwnAsync()
    {
        _scrollSeq++;
        _scrollMessages.Add(new($"scroll-own-{_scrollSeq}", $"Alice's message #{_scrollSeq}",
            _currentUser, ChatMessageType.Outgoing, DateTimeOffset.Now));
        await InvokeAsync(StateHasChanged);
    }

    private Task HandleScrollOwnSend(ChatSendRequest request)
    {
        _scrollSeq++;
        _scrollMessages.Add(new($"scroll-sent-{_scrollSeq}", request.Text,
            _currentUser, ChatMessageType.Outgoing, DateTimeOffset.Now));
        return Task.CompletedTask;
    }

    private async Task HandleScrollLoadOlderAsync()
    {
        if (_scrollLoadingOlder || !_scrollHasMore) return;
        _scrollLoadingOlder = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(600);
        var page = new List<ChatMessage>();
        for (var i = 0; i < 8; i++)
        {
            _scrollSeq++;
            page.Add(new($"scroll-old-{_scrollSeq}", $"Older message #{_scrollSeq}",
                _carol, ChatMessageType.Incoming, DateTimeOffset.Now.AddMinutes(-_scrollSeq)));
        }
        page.Reverse();
        _scrollMessages.InsertRange(0, page);
        if (_scrollMessages.Count > 60) _scrollHasMore = false; // a finite demo history
        _scrollLoadingOlder = false;
        await InvokeAsync(StateHasChanged);
    }

