    {
        _gateFan = fan;
        _gateSubscribed = false;
        _gateSeq = 0;
        _gateMessages = new()
        {
            new ChatMessage("gt1", "Welcome to my studio channel! 💜", _customOwner, ChatMessageType.Incoming, _customBase.AddMinutes(-4)),
            new ChatMessage("gt2", "Subscribers get weekly voice notes with booking tips.", _customOwner, ChatMessageType.Incoming, _customBase.AddMinutes(-3)),
