    // ── MessageTemplate: route every host-owned Kind to its bubble ────────
    private RenderFragment RenderCustomMessage(ChatMessageContext context) => context.Message.Kind switch
    {
        "ai-draft" => RenderCustomDraft(context),
        "queued" => RenderCustomQueued(context),
        "discarded" => RenderCustomDiscarded(context),
        "tip" => RenderCustomTip(context),
        "locked" => RenderCustomLocked(context),
        _ => context.DefaultContent,
    };

    private RenderFragment RenderCustomDraft(ChatMessageContext context)
    {
        if (context.Message.Id == _customEditingDraftId)
        {
            return RenderDraftEditor();
        }

        var reason = context.PayloadAs<CustomInboxDraft>()?.Reason ?? "review";
        return @<TmChatBubble Variant="ChatBubbleVariant.Pending"
                              data-testid="chat-custom-draft"
                              ActorLabel="AI assistant"
                              Timestamp="context.Message.Timestamp"
                              StatusLabel="AI draft — pending review">
            <Badge><span class="chat-demo-badge chat-demo-badge--pending">AI draft · @reason</span></Badge>
            <ChildContent><span>@context.Message.Text</span></ChildContent>
            <Actions>
                <div class="chat-demo-bubble-actions">
                    <button type="button" class="chat-demo-bubble-action chat-demo-bubble-action--primary" data-testid="chat-custom-approve"
                            aria-label="Approve AI draft"
                            @onclick="@(() => ApproveDraftAsync(context.Message))">Approve</button>
                    <button type="button" class="chat-demo-bubble-action" data-testid="chat-custom-edit"
                            aria-label="Edit AI draft"
                            @onclick="@(() => EditDraft(context.Message))">Edit</button>
                    <button type="button" class="chat-demo-bubble-action chat-demo-bubble-action--danger" data-testid="chat-custom-discard"
                            aria-label="Discard AI draft"
                            @onclick="@(() => DiscardDraftAsync(context.Message))">Discard</button>
                </div>
            </Actions>
        </TmChatBubble>;
    }

    private RenderFragment RenderDraftEditor() => @<div class="chat-demo-draft-editor" data-testid="chat-custom-draft-editor">
        <textarea class="chat-demo-draft-editor__input" rows="2" aria-label="Edit draft reply"
                  @ref="_draftEditorInput" @bind="_customDraftEditText"></textarea>
        <div class="chat-demo-bubble-actions">
            <button type="button" class="chat-demo-bubble-action" data-testid="chat-custom-draft-save"
                    @onclick="SaveDraftEditAsync">Save</button>
            <button type="button" class="chat-demo-bubble-action" data-testid="chat-custom-draft-cancel"
                    @onclick="CancelDraftEditAsync">Cancel</button>
        </div>
    </div>;

    // The queued countdown is the ChatDemoQueuedCountdown child: it owns the per-second timer,
    // and on expiry the HOST sends the message (a plain outgoing row).
    private RenderFragment QueuedCountdownFragment(ChatMessageContext context) => @<ChatDemoQueuedCountdown
                              Until="@(context.GetMetadata<DateTimeOffset>("queuedUntil"))"
                              OnExpired="@(() => SendExpiredQueuedAsync(context.Message))" />;

    private RenderFragment RenderCustomQueued(ChatMessageContext context) => @<TmChatBubble Variant="ChatBubbleVariant.Queued"
                              data-testid="chat-custom-queued"
                              ActorLabel="@(context.Message.Author?.Name)"
                              Timestamp="context.Message.Timestamp"
                              StatusLabel="Queued — not sent yet"
                              Meta="@QueuedCountdownFragment(context)">
        <Badge><span class="chat-demo-badge chat-demo-badge--queued">Queued</span></Badge>
        <ChildContent><span>@context.Message.Text</span></ChildContent>
        <Actions>
            <div class="chat-demo-bubble-actions">
                <button type="button" class="chat-demo-bubble-action chat-demo-bubble-action--danger" data-testid="chat-custom-stop"
                        aria-label="Stop sending queued reply"
                        @onclick="@(() => StopQueuedAsync(context.Message))">Stop sending</button>
            </div>
        </Actions>
    </TmChatBubble>;

    private RenderFragment RenderCustomDiscarded(ChatMessageContext context) => @<TmChatBubble Variant="ChatBubbleVariant.Discarded"
                              data-testid="chat-custom-discarded"
                              ActorLabel="@(context.Message.Author?.Name)"
                              Timestamp="context.Message.Timestamp"
                              StatusLabel="Discarded — not sent">
        <ChildContent><span>@context.Message.Text</span></ChildContent>
        <Note><span class="chat-demo-note">@(context.GetMetadata<string>("discardNote", "Withdrawn"))</span></Note>
    </TmChatBubble>;

    private RenderFragment RenderCustomTip(ChatMessageContext context) => @<TmChatBubble Variant="ChatBubbleVariant.Pill"
                              data-testid="chat-custom-tip">
        <ChildContent><span>@context.Message.Text</span></ChildContent>
    </TmChatBubble>;

    private RenderFragment RenderCustomLocked(ChatMessageContext context) => @<TmChatBubble Variant="ChatBubbleVariant.Locked"
                              data-testid="chat-custom-locked"
                              ActorLabel="@(context.Message.Author?.Name)"
                              Timestamp="context.Message.Timestamp"
                              StatusLabel="Paid voice note · Mia hasn't unlocked yet">
        @* The body is passed to demonstrate the guard: the Locked variant never renders it, so
           the paid content cannot leak into the DOM. The owner has no Unlock button here — Mia
           unlocks from her own view (the Subscribe Gate below). The price shows once. *@
        <ChildContent><span>@context.Message.Text</span></ChildContent>
        <Badge><span class="chat-demo-badge chat-demo-badge--price">$9.99</span></Badge>
    </TmChatBubble>;

    // ── Host actions over the template kinds ──────────────────────────────
    private async Task ApproveDraftAsync(ChatMessage draft)
    {
        _customMessages.Remove(draft);
        _customMessages.Add(new ChatMessage($"ct-own-{Guid.NewGuid():N}", draft.Text, _customOwner,
            ChatMessageType.Outgoing, DateTimeOffset.Now));
        await InvokeAsync(StateHasChanged);
        if (_customChat is not null)
        {
            await _customChat.FocusComposerAsync();
            await _customChat.AnnounceAsync("Draft approved — reply posted.");
        }
    }

    private void EditDraft(ChatMessage draft)
    {
        _customDraftEditText = draft.Text;
        _customEditingDraftId = draft.Id;
        _draftEditorInput = default;
        _shouldFocusDraftEditor = true;
        StateHasChanged();
    }

    private async Task SaveDraftEditAsync()
    {
        // Blank edits keep the editor open — the draft is not lost to a mistyped Save.
        if (string.IsNullOrWhiteSpace(_customDraftEditText)) return;

        var draft = _customMessages.FirstOrDefault(m => m.Id == _customEditingDraftId);
        _customEditingDraftId = null;
        _draftEditorInput = default;
        if (draft is null) return;

        _customMessages.Remove(draft);
        _customMessages.Add(new ChatMessage($"ct-own-{Guid.NewGuid():N}", _customDraftEditText, _customOwner,
            ChatMessageType.Outgoing, DateTimeOffset.Now));
        await InvokeAsync(StateHasChanged);
        if (_customChat is not null)
        {
            await _customChat.FocusComposerAsync();
        }
    }

    private async Task CancelDraftEditAsync()
    {
        var draftId = _customEditingDraftId;
        _customEditingDraftId = null;
        _shouldFocusDraftEditor = false;
        _draftEditorInput = default;
        await InvokeAsync(StateHasChanged);
        if (draftId is not null && _customChat is not null)
        {
            await _customChat.FocusMessageAsync(draftId);
        }
    }

    private async Task DiscardDraftAsync(ChatMessage draft)
    {
        ReplaceCustom(draft.Id, m => m with
        {
            Kind = "discarded",
            Metadata = new Dictionary<string, object?> { ["discardNote"] = "Discarded by the owner before sending" },
        });
        await InvokeAsync(StateHasChanged);
        if (_customChat is not null)
        {
            await _customChat.FocusMessageAsync(draft.Id);
            await _customChat.AnnounceAsync("Draft discarded.");
        }
    }

    private async Task StopQueuedAsync(ChatMessage queued)
    {
        ReplaceCustom(queued.Id, m => m with
        {
            Kind = "discarded",
            Metadata = new Dictionary<string, object?> { ["discardNote"] = "Stopped before it was sent" },
        });
        await InvokeAsync(StateHasChanged);
        if (_customChat is not null)
        {
            await _customChat.FocusMessageAsync(queued.Id);
            await _customChat.AnnounceAsync("Queued reply stopped.");
        }
    }

    // The queued countdown expired: the host sends the message — the same row falls back to the
    // built-in rendering once the kind is cleared.
    private async Task SendExpiredQueuedAsync(ChatMessage queued)
    {
        ReplaceCustom(queued.Id, m => m with { Kind = null, Metadata = new Dictionary<string, object?>() });
        await InvokeAsync(StateHasChanged);
    }

    private void ReplaceCustom(string id, Func<ChatMessage, ChatMessage> update)
    {
        var index = _customMessages.FindIndex(m => m.Id == id);
        if (index >= 0) _customMessages[index] = update(_customMessages[index]);
    }

    // ── Demo-side inputs of the custom chat ───────────────────────────────
    private void HandleOfflineChanged(bool offline)
    {
        _customOffline = offline;
        StateHasChanged();
    }

    private void HandleCustomInboxSend(string text)
    {
        // Offline sends queue like any host would: a queued row whose own ChatDemoQueuedCountdown
        // counts down and sends it (the composer itself stays usable while offline).
        var message = new ChatMessage($"ct-own-{Guid.NewGuid():N}", text, _customOwner, ChatMessageType.Outgoing, DateTimeOffset.Now);
        if (_customOffline)
        {
            message = message with
            {
                Kind = "queued",
                Metadata = new Dictionary<string, object?> { ["queuedUntil"] = DateTimeOffset.Now.AddSeconds(30) },
            };
        }
        _customMessages.Add(message);
    }

    private async Task HandleCustomDeliverAsync()
    {
        _customSeq++;
        _customMessages.Add(new ChatMessage($"ct-in-{_customSeq}", $"Incoming message #{_customSeq}",
            _customFan, ChatMessageType.Incoming, DateTimeOffset.Now));
        await InvokeAsync(StateHasChanged);
    }

    private Task HandleCustomTypingRefreshAsync()
    {
        // A fresh list instance opens a fresh TypingTimeout window.
        _customTyping = new List<ChatUser> { _customFan };
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task HandleCustomLoadOlderAsync()
    {
        if (_customLoadingOlder || !_customHasMore) return;
        _customLoadingOlder = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await Task.Delay(500, _cts.Token);
        }
        catch (OperationCanceledException)
        {
            return; // the demo page is gone — nothing to load into
        }

        var page = new List<ChatMessage>();
        for (var i = 0; i < 8; i++)
        {
            _customSeq++;
            page.Add(CustomMessage($"ct-old-{_customSeq}", $"Archived message #{_customSeq}",
                _customFan, ChatMessageType.Incoming, -_customSeq));
        }
        page.Reverse();
        _customMessages.InsertRange(0, page);
        if (_customMessages.Count > 80) _customHasMore = false; // a finite demo archive
        _customLoadingOlder = false;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>The host owns the announced sentence — the library never invents one.</summary>
    private string? DescribeCustomAnnouncement(ChatMessage message)
        => message.Type == ChatMessageType.System
            ? message.Text
            : $"New message from {message.Author?.Name}: {message.Text}";

    // ── Subscribe Gate: ComposerTemplate with a gate ──────────────────────
    private RenderFragment<ChatComposerContext> SubscribeGateComposer => context =>
    {
        _gateComposerContext = context;
        return _gateSubscribed
            ? @<div class="chat-demo-gate-composer">
                <textarea class="chat-demo-gate-composer__input" rows="1" aria-label="Reply to Dana"
                          placeholder="Reply to Dana…"
                          value="@context.Text"
                          @oninput="@(e => context.SetTextAsync(e.Value?.ToString() ?? string.Empty))"
                          @ref="_gateInput"></textarea>
                <TmButton Variant="ButtonVariant.Primary" Size="ButtonSize.Sm"
                          Disabled="@(!context.CanSend)"
                          OnClick="@(async () => await context.SendAsync())">Send</TmButton>
            </div>
            : @<div class="chat-demo-gate" data-testid="chat-gate-composer">
                <p class="chat-demo-gate__title">Only subscribers can reply to Dana</p>
                <p class="chat-demo-gate__text">Subscribe to unlock replies, voice notes and the weekly booking tips.</p>
                <TmButton Variant="ButtonVariant.Primary" Size="ButtonSize.Sm"
                          data-testid="chat-gate-subscribe"
                          OnClick="HandleGateSubscribe">Subscribe for $4.99/mo</TmButton>
            </div>;
    };

    private void HandleGateSubscribe()
    {
        _gateSubscribed = true;
        StateHasChanged();
    }

    private void HandleGateReset()
    {
        InitializeGateDemo(_gateFan);
        StateHasChanged();
    }

    // ── Auto-Attach demo (FZE-12): id=InputId is the whole registration ───
    private RenderFragment<ChatComposerContext> AutoAttachComposer => context =>
        @<div class="chat-demo-gate-composer">
            <textarea class="chat-demo-gate-composer__input" rows="1" aria-label="Reply to Noah"
                      placeholder="Reply to Noah…"
                      id="@context.InputId"
                      value="@context.Text"
                      @oninput="@(e => context.SetTextAsync(e.Value?.ToString() ?? string.Empty))"></textarea>
            <TmButton Variant="ButtonVariant.Primary" Size="ButtonSize.Sm"
                      Disabled="@(!context.CanSend)"
                      OnClick="@(async () => await context.SendAsync())">Send</TmButton>
        </div>;

    private void HandleAutoAttachSend(string text)
    {
        _autoAttachSeq++;
        _autoAttachCount++;
        _autoAttachMessages.Add(new ChatMessage(
            $"aa-own-{_autoAttachSeq}", text, _autoAttachFan, ChatMessageType.Outgoing, DateTimeOffset.Now));
        StateHasChanged();
        _ = AutoAttachAutoReplyAsync(text);
    }

    private async Task AutoAttachAutoReplyAsync(string text)
    {
        try
        {
            await Task.Delay(800, _cts.Token);
            _autoAttachSeq++;
            _autoAttachMessages.Add(new ChatMessage(
                $"aa-in-{_autoAttachSeq}", $"Auto-attached composer heard: “{text}”", _autoAttachFan,
                ChatMessageType.Incoming, DateTimeOffset.Now));
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // The demo page went away during the simulated delay — nothing to answer anymore.
        }
    }

    private async Task HandleAutoAttachDeliverAsync()
    {
        _autoAttachSeq++;
        _autoAttachMessages.Add(new ChatMessage(
            $"aa-in-{_autoAttachSeq}", "Delivered while you were reading — scroll contract intact.",
            _autoAttachFan, ChatMessageType.Incoming, DateTimeOffset.Now));
        await InvokeAsync(StateHasChanged);
    }

    private void HandleGateSend(string text)
    {
        _gateSeq++;
        _gateMessages.Add(new ChatMessage($"gt-own-{_gateSeq}", text, _gateFan, ChatMessageType.Outgoing, DateTimeOffset.Now));
        StateHasChanged();
        _ = GateAutoReplyAsync(text);
    }

    private async Task GateAutoReplyAsync(string text)
    {
        try
        {
            await Task.Delay(800, _cts.Token);
            _gateSeq++;
            _gateMessages.Add(new ChatMessage($"gt-in-{_gateSeq}", $"Thanks for subscribing! Re: “{text}”", _customOwner,
                ChatMessageType.Incoming, DateTimeOffset.Now));
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // The demo page went away during the simulated delay — nothing to answer anymore.
        }
    }

    // ── Subscribe Gate: MessageTemplate for the locked voice note ─────────
    private RenderFragment RenderGateMessage(ChatMessageContext context) => context.Message.Kind switch
    {
        "locked" => RenderGateLocked(context),
        _ => context.DefaultContent,
    };

    private RenderFragment RenderGateLocked(ChatMessageContext context) => @<TmChatBubble Variant="ChatBubbleVariant.Locked"
                              data-testid="chat-gate-locked"
                              ActorLabel="@(context.Message.Author?.Name)"
                              Timestamp="context.Message.Timestamp"
                              StatusLabel="Locked — subscribe to read">
        @* The guard in action: the body is passed but the Locked variant never renders it, so
           the paid content cannot leak into the DOM before the fan pays. The price shows once
           (badge only — the Unlock button does not repeat it). *@
        <ChildContent><span>@context.Message.Text</span></ChildContent>
        <Badge><span class="chat-demo-badge chat-demo-badge--price">$9.99</span></Badge>
        <Actions>
            <div class="chat-demo-bubble-actions">
                <button type="button" class="chat-demo-bubble-action chat-demo-bubble-action--primary" data-testid="chat-gate-unlock"
                        aria-label="Unlock voice note"
                        @onclick="@(() => UnlockGateNoteAsync(context.Message))">Unlock</button>
            </div>
        </Actions>
    </TmChatBubble>;

    private async Task UnlockGateNoteAsync(ChatMessage locked)
    {
        // Reveal: the same message falls back to the built-in row once the host clears the kind.
        ReplaceGate(locked.Id, m => m with { Kind = null, Metadata = new Dictionary<string, object?>() });
        await InvokeAsync(StateHasChanged);
        if (_gateChat is not null)
        {
            await _gateChat.FocusMessageAsync(locked.Id);
            await _gateChat.AnnounceAsync("Voice note unlocked.");
        }
    }

    private void ReplaceGate(string id, Func<ChatMessage, ChatMessage> update)
    {
        var index = _gateMessages.FindIndex(m => m.Id == id);
        if (index >= 0) _gateMessages[index] = update(_gateMessages[index]);
    }

    public void Dispose()
    {
        // Cancel the demo's own simulated delays (gate auto-reply, load-older) — without this a
        // pending Task.Delay would keep the circuit alive after the page is gone.
        _cts.Cancel();
        _cts.Dispose();
    }
}
