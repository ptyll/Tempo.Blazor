    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_customComposerContext is not null && !string.IsNullOrEmpty(_customComposerInput.Id)
            && _customComposerInput.Id != _customComposerAttachedId)
        {
            _customComposerAttachedId = _customComposerInput.Id;
            await _customComposerContext.AttachAsync(_customComposerInput);
        }
    }

