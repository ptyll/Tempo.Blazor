    private bool _customHasMore = true;
    private bool _customLoadingOlder;
    private int _customSeq;

    // Inline draft editing: the template renders the editor while this id is set. The ref + flag
    // move the focus into the textarea right after the editor mounts.
    private string? _customEditingDraftId;
    private string _customDraftEditText = string.Empty;
    private ElementReference _draftEditorInput;
    private bool _shouldFocusDraftEditor;

    // ── Subscribe Gate demo (FZE-9) — host composer with a gate ───────────
    private TmChat? _gateChat;
    private ChatUser _gateFan = default!;
    private List<ChatMessage> _gateMessages = default!;
    private bool _gateSubscribed;
    private ElementReference _gateInput;
    private ChatComposerContext? _gateComposerContext;
    private string? _gateAttachedInputId;
    private int _gateSeq;

    // ── Auto-attach demo (FZE-12) — id=InputId registration, NO AttachAsync ──
    private ChatUser _autoAttachFan = default!;
    private List<ChatMessage> _autoAttachMessages = default!;
    private int _autoAttachCount;
    private int _autoAttachSeq;

    // Seeded timestamps are relative to NOW so the demo conversation always looks fresh: the
    // seeds sit a quarter of an hour in the past, delivered messages get DateTimeOffset.Now.
    private DateTimeOffset _customBase;

    // Cancellation for the demo's own simulated delays — cancelled in Dispose (IDisposable).
    private readonly CancellationTokenSource _cts = new();

    private ChatMessage CustomMessage(string id, string text, ChatUser author, ChatMessageType type, int minute) =>
        new(id, text, author, type, _customBase.AddMinutes(minute));

