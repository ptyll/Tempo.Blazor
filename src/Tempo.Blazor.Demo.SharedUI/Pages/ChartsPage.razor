    private static IReadOnlyDictionary<DateOnly, decimal> CreateCalendarHeatmapExpenses()
    {
        var random = new Random(CalendarHeatmapDemoYear);
        var start = new DateOnly(CalendarHeatmapDemoYear, 1, 1);
        var end = new DateOnly(CalendarHeatmapDemoYear, 12, 31);
        var values = new Dictionary<DateOnly, decimal>();

        for (var date = start; date <= end; date = date.AddDays(1))
        {
            if (date != start && random.NextDouble() < 0.18)
            {
                continue;
            }

            values[date] = random.Next(5, 501);
        }

        return values;
    }

