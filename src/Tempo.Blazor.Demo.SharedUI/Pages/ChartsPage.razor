@page "/charts"
@using Tempo.Blazor.Components.Charts
@using Tempo.Blazor.Models
@using System.Globalization
@inject ITmLocalizer Loc

<PageTitle>Charts – Tempo.Blazor</PageTitle>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Charts</h1>
    <p class="text-slate-600 dark:text-slate-400">@Loc["TmChartDemo_PageDescription"]</p>
</div>

<!-- Calendar Heatmap -->
<section class="demo-section mb-8" data-testid="calendar-heatmap">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-2">
        @Loc["TmCalendarHeatmapDemo_Title"]
    </h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        @Loc["TmCalendarHeatmapDemo_Description"]
    </p>
    <div class="grid grid-cols-1 gap-6">
        <div class="showcase-card" data-testid="calendar-heatmap-annual">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">
                @Loc["TmCalendarHeatmapDemo_AnnualTitle"]
            </h3>
            <TmCalendarHeatmap Values="_calendarHeatmapExpenses"
                               Year="CalendarHeatmapDemoYear"
                               ColorScheme="CalendarHeatmapColorScheme.Primary"
                               ValueFormatter="FormatCalendarHeatmapCurrency"
                               OnDayClick="HandleCalendarHeatmapClick" />
        </div>
        <div class="showcase-card" data-testid="calendar-heatmap-range">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">
                @Loc["TmCalendarHeatmapDemo_RangeTitle"]
            </h3>
            <TmCalendarHeatmap Values="_calendarHeatmapExpenses"
                               From="_calendarHeatmapRangeStart"
                               To="_calendarHeatmapRangeEnd"
                               ColorScheme="CalendarHeatmapColorScheme.Danger"
                               ValueFormatter="FormatCalendarHeatmapCurrency"
                               OnDayClick="HandleCalendarHeatmapClick" />
        </div>
    </div>
    <p class="mt-3 text-sm text-slate-600 dark:text-slate-400"
       data-testid="calendar-heatmap-clicked"
       aria-live="polite">
        @if (_clickedCalendarHeatmapDay is null)
        {
            @Loc["TmCalendarHeatmapDemo_ClickPrompt"]
        }
        else
        {
            @Loc[
                "TmCalendarHeatmapDemo_Clicked",
                _clickedCalendarHeatmapDay.Date.ToString("d", CultureInfo.CurrentUICulture),
                _clickedCalendarHeatmapDay.Value.HasValue
                    ? FormatCalendarHeatmapCurrency(_clickedCalendarHeatmapDay.Value.Value)
                    : Loc["TmCalendarHeatmap_NoData"]]
        }
    </p>
</section>

<!-- Sankey -->
<section class="demo-section mb-8" data-testid="sankey-chart">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-2">
        @Loc["TmSankeyChartDemo_Title"]
    </h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        @Loc["TmSankeyChartDemo_Description"]
    </p>
    <div class="grid grid-cols-1 gap-6">
        <div class="showcase-card" data-testid="sankey-cashflow">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">
                @Loc["TmSankeyChartDemo_StandardTitle"]
            </h3>
            <TmSankeyChart Data="_sankeyCashFlowData"
                           Height="400px"
                           ValueFormatter="FormatSankeyCurrency"
                           OnNodeClick="HandleSankeyNodeClick"
                           OnLinkClick="HandleSankeyLinkClick" />
        </div>
        <div class="showcase-card" data-testid="sankey-custom-colors">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">
                @Loc["TmSankeyChartDemo_CustomColorsTitle"]
            </h3>
            <TmSankeyChart Data="_sankeyCustomColorsData"
                           Height="400px"
                           ValueFormatter="FormatSankeyCurrency"
                           OnNodeClick="HandleSankeyNodeClick"
                           OnLinkClick="HandleSankeyLinkClick" />
        </div>
    </div>
    <p class="mt-3 text-sm text-slate-600 dark:text-slate-400"
       data-testid="sankey-clicked"
       aria-live="polite"
       aria-atomic="true">
        @(_sankeySelection ?? Loc["TmSankeyChartDemo_ClickPrompt"])
    </p>
</section>

<!-- Per-value color charts -->
<section class="demo-section mb-8">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200">Per-value Colors</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">BackgroundColors</span>
    </div>
    <div class="demo-grid demo-grid-2">
        <div class="showcase-card" data-testid="chart-donut-custom">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">Donut - custom colors</h3>
            <TmChart Type="ChartType.Donut"
                     Data="_donutCustomColorsData"
                     Height="260px"
                     ShowValues="true"
                     Animated="false" />
        </div>
        <div class="showcase-card" data-testid="chart-horizontal-bar-custom">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">HorizontalBar - custom colors</h3>
            <TmChart Type="ChartType.HorizontalBar"
                     Data="_horizontalBarCustomColorsData"
                     Height="260px"
                     ShowValues="true"
                     Animated="false" />
        </div>
        <div class="showcase-card" data-testid="chart-bar-custom">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">Bar - custom colors</h3>
            <TmChart Type="ChartType.Bar"
                     Data="_barCustomColorsData"
                     Height="260px"
                     ShowValues="true"
                     Animated="false" />
        </div>
        <div class="showcase-card" data-testid="chart-donut-default">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">Donut - default palette</h3>
            <TmChart Type="ChartType.Donut"
                     Data="_donutDefaultPaletteData"
                     Height="260px"
                     ShowValues="true"
                     Animated="false" />
        </div>
    </div>
</section>

<!-- Bar Chart -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Bar Chart</h2>
    <TmChart Type="ChartType.Bar"
             Data="_barData"
             Height="350px"
             OnSegmentClick="HandleSegmentClick" />
    @if (_clickedSegment is not null)
    {
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
            Clicked: <strong>@_clickedSegment.Label</strong> = @_clickedSegment.Value (Dataset @_clickedSegment.DatasetIndex)
        </p>
    }
</section>

<!-- Grouped Bar Chart -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Grouped Bar Chart</h2>
    <TmChart Type="ChartType.Bar"
             Data="_groupedBarData"
             Height="350px"
             ShowValues="true" />
</section>

<!-- Interactive legend & tooltips (K10) -->
<section class="demo-section mb-8" data-testid="charts-interactive-section">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Interactive Legend &amp; Tooltips</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        Click a legend entry to toggle its series (multi-dataset) or single slice (per-value); hover any
        bar, point or slice for a rich tooltip. The component owns the hidden state and reports each
        change through <code>OnSeriesToggle</code>.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
            <TmChart Type="ChartType.Bar"
                     Data="_groupedBarData"
                     Height="320px"
                     InteractiveLegend="true"
                     TestIdPrefix="k10-bar"
                     OnSeriesToggle="HandleSeriesToggle" />
        </div>
        <div>
            <TmChart Type="ChartType.Donut"
                     Data="_donutCustomColorsData"
                     Height="320px"
                     InteractiveLegend="true"
                     TestIdPrefix="k10-donut"
                     OnSeriesToggle="HandleSeriesToggle" />
        </div>
    </div>
    @if (_lastToggle is not null)
    {
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-400" data-testid="charts-toggle-status">
            Toggled <strong>@_lastToggle.Label</strong> → @(_lastToggle.Hidden ? "hidden" : "shown")
        </p>
    }
</section>

<!-- Line Chart -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Line Chart</h2>
    <TmChart Type="ChartType.Line"
             Data="_lineData"
             Height="350px" />
</section>

<!-- Area Chart -->
<section class="demo-section mb-8" data-testid="charts-area-section">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">@Loc["TmChartDemo_AreaTitle"]</h2>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div data-testid="chart-area-balance">
            <h3 class="text-sm font-medium text-slate-600 dark:text-slate-400 mb-2">@Loc["TmChartDemo_AreaBalance"]</h3>
            <TmChart Type="ChartType.Area"
                     Data="BalanceAreaData"
                     AreaOpacity="0.4"
                     Height="320px"
                     OnSegmentClick="HandleSegmentClick" />
        </div>
        <div>
            <h3 class="text-sm font-medium text-slate-600 dark:text-slate-400 mb-2">@Loc["TmChartDemo_AreaEdge"]</h3>
            <TmChart Type="ChartType.Area"
                     Data="_areaEdgeData"
                     AreaGradient="true"
                     Height="320px" />
        </div>
    </div>
</section>

<!-- Waterfall Chart -->
<section class="demo-section mb-8" data-testid="charts-waterfall-section">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">@Loc["TmChartDemo_WaterfallTitle"]</h2>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div data-testid="chart-waterfall">
            <h3 class="text-sm font-medium text-slate-600 dark:text-slate-400 mb-2">@Loc["TmChartDemo_WaterfallStandard"]</h3>
            <TmChart Type="ChartType.Waterfall"
                     Data="WaterfallData"
                     WaterfallShowTotal="true"
                     WaterfallShowConnectors="true"
                     ShowValues="true"
                     Height="320px"
                     OnSegmentClick="HandleSegmentClick" />
        </div>
        <div>
            <h3 class="text-sm font-medium text-slate-600 dark:text-slate-400 mb-2">@Loc["TmChartDemo_WaterfallNegative"]</h3>
            <TmChart Type="ChartType.Waterfall"
                     Data="_waterfallNegativeData"
                     WaterfallShowTotal="true"
                     WaterfallShowConnectors="true"
                     ShowValues="true"
                     Height="320px" />
        </div>
    </div>
    @if (_clickedSegment is not null)
    {
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-400" data-testid="charts-waterfall-clicked">
            @Loc["TmChartDemo_WaterfallClicked"]: <strong>@_clickedSegment.Label</strong> = @_clickedSegment.Value
        </p>
    }
</section>

<!-- DateTime Axis -->
<section class="demo-section mb-8" data-testid="charts-time-axis-section">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">DateTime Axis (Time Series)</h2>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div>
            <h3 class="text-sm font-medium text-slate-600 dark:text-slate-400 mb-2">Monthly rent trend — auto interval, unevenly spaced &amp; unsorted input</h3>
            <TmChart Type="ChartType.Area"
                     Data="_rentTrendData"
                     AreaGradient="true"
                     Height="320px" />
        </div>
        <div>
            <h3 class="text-sm font-medium text-slate-600 dark:text-slate-400 mb-2">Custom label format (yyyy-MM), explicit axis range</h3>
            <TmChart Type="ChartType.Line"
                     Data="_rentTrendData"
                     TimeLabelFormat="yyyy-MM"
                     TimeAxisMin="@(new DateTime(2024, 1, 1))"
                     TimeAxisMax="@(new DateTime(2025, 12, 31))"
                     Height="320px" />
        </div>
    </div>
</section>

<!-- Pie Chart -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Pie Chart</h2>
    <div style="max-width: 500px;">
        <TmChart Type="ChartType.Pie"
                 Data="_pieData"
                 Height="400px" />
    </div>
</section>

<!-- Donut Chart -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Donut Chart</h2>
    <div style="max-width: 500px;">
        <TmChart Type="ChartType.Donut"
                 Data="_donutData"
                 Height="400px" />
    </div>
</section>

<!-- Horizontal Bar Chart -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Horizontal Bar Chart</h2>
    <TmChart Type="ChartType.HorizontalBar"
             Data="_horizontalData"
             Height="300px"
             ShowValues="true" />
</section>

<!-- No Animation / No Legend -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Minimal (No Animation, No Legend, No Grid)</h2>
    <TmChart Type="ChartType.Bar"
             Data="_barData"
             Height="250px"
             Animated="false"
             ShowLegend="false"
             ShowGrid="false" />
</section>

<!-- Stock Chart -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Stock Chart (Candlestick)</h2>
    <TmStockChart Data="_stockData"
                  Type="StockChartType.Candlestick"
                  ShowVolume="true"
                  Animated="true"
                  Height="400px" />
</section>

<!-- Stock Chart OHLC -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Stock Chart (OHLC)</h2>
    <TmStockChart Data="_stockData"
                  Type="StockChartType.OHLC"
                  ShowVolume="false"
                  Height="350px" />
</section>

<!-- Stock Chart Line -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Stock Chart (Line — Closing Prices)</h2>
    <TmStockChart Data="_stockData"
                  Type="StockChartType.Line"
                  ShowVolume="false"
                  Height="350px" />
</section>

<!-- Sparklines -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Sparklines</h2>
    <div class="flex flex-wrap items-center gap-6">
        <div class="flex items-center gap-3">
            <span class="text-sm text-slate-600 dark:text-slate-400">Line</span>
            <TmSparkline Data="_sparkData" Type="SparklineType.Line" Height="40px" Width="120px" />
        </div>
        <div class="flex items-center gap-3">
            <span class="text-sm text-slate-600 dark:text-slate-400">Bar</span>
            <TmSparkline Data="_sparkData" Type="SparklineType.Bar" Height="40px" Width="120px" />
        </div>
        <div class="flex items-center gap-3">
            <span class="text-sm text-slate-600 dark:text-slate-400">Area</span>
            <TmSparkline Data="_sparkData" Type="SparklineType.Area" Height="40px" Width="120px" />
        </div>
        <div class="flex items-center gap-3">
            <span class="text-sm text-slate-600 dark:text-slate-400">Pie</span>
            <TmSparkline Data="_sparkData" Type="SparklineType.Pie" Height="40px" Width="40px" />
        </div>
    </div>
</section>

<!-- Gauges -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Gauges</h2>
    <div class="flex flex-wrap items-center gap-8">
        <div class="text-center">
            <TmGauge Type="GaugeType.Arc" Value="65" Min="0" Max="100" ShowValue="true" LabelFormat="{0}%" Animated="true" />
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Arc</p>
        </div>
        <div class="text-center">
            <TmGauge Type="GaugeType.Circular" Value="78" Min="0" Max="100" ShowValue="true" LabelFormat="{0}%" Animated="true" />
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Circular</p>
        </div>
        <div class="text-center">
            <TmGauge Type="GaugeType.Linear" Value="45" Min="0" Max="100" ShowValue="true" LabelFormat="{0}%" Width="250px" Height="80px" />
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Linear</p>
        </div>
        <div class="text-center">
            <TmGauge Type="GaugeType.Arc" Value="82" Min="0" Max="100"
                     Ranges="_gaugeRanges" ShowValue="true" LabelFormat="{0}%" Animated="true" />
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Arc with Ranges</p>
        </div>
    </div>
</section>

<!-- Funnel / Heatmap / Treemap -->
<section class="demo-section mb-8" data-testid="charts-demo-funnel">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Funnel — Case Intake Conversion</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        A conversion funnel over the client-intake pipeline. Hover a stage for the tooltip,
        click it to select, and read the per-stage conversion against the first stage.
    </p>
    <div class="max-w-2xl">
        <TmChart Type="ChartType.Funnel" Data="_funnelData" Height="320px"
                 ShowValues="true" InteractiveLegend="true" OnSegmentClick="HandleSegmentClick" />
    </div>
</section>

<section class="demo-section mb-8" data-testid="charts-demo-funnel-labels">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Funnel — Label Placement and Zero Stages</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        The same funnel with every stage label in a gutter beside the shape
        (<code>FunnelLabelPlacement="Outside"</code>), and an intake pipeline whose last two stages have
        not converted yet — a zero stage keeps a thin, labelled band instead of disappearing from the chart
        (<code>FunnelMinSegmentWidth</code>).
    </p>
    <div class="grid gap-6 lg:grid-cols-2">
        <div class="max-w-md" data-testid="charts-demo-funnel-outside">
            <TmChart Type="ChartType.Funnel" Data="_funnelData" Height="320px"
                     ShowValues="true" FunnelLabelPlacement="FunnelLabelPlacement.Outside"
                     OnSegmentClick="HandleSegmentClick" />
        </div>
        <div class="max-w-md" data-testid="charts-demo-funnel-zero">
            <TmChart Type="ChartType.Funnel" Data="_funnelZeroStageData" Height="320px"
                     ShowValues="true" FunnelMinSegmentWidth="6" FunnelLabelPlacement="FunnelLabelPlacement.Outside"
                     OnSegmentClick="HandleSegmentClick" />
        </div>
    </div>
</section>

<section class="demo-section mb-8" data-testid="charts-demo-heatmap">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Heatmap — Filings by Day × Hour</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        Court filings received per weekday and daypart — the intensity scales with the count.
        Toggle a day in the legend to exclude it from the scale.
    </p>
    <div class="max-w-3xl">
        <TmChart Type="ChartType.Heatmap" Data="_heatmapData" Height="320px"
                 ShowValues="true" InteractiveLegend="true" OnSegmentClick="HandleSegmentClick" />
    </div>
</section>

<section class="demo-section mb-8" data-testid="charts-demo-treemap">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Treemap — Billing by Practice Area and Client</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        Hierarchical shares: practice areas as groups, clients as tiles sized by billed amount.
        Toggle an area in the legend to drop its whole subtree.
    </p>
    <div class="max-w-3xl">
        <TmChart Type="ChartType.Treemap" Data="_emptyChartData" TreeNodes="_treemapNodes" Height="360px"
                 ShowValues="true" InteractiveLegend="true" OnSegmentClick="HandleSegmentClick" />
    </div>
    @if (_clickedSegment is not null)
    {
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-400" data-testid="charts-demo-clicked">
            Clicked: <strong>@_clickedSegment.Label</strong> = @_clickedSegment.Value
        </p>
    }
</section>

<!-- Stacked expenses -->
<section class="demo-section mb-8" data-testid="charts-demo-stacked">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">@Loc["TmChartDemo_StackedTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        @Loc["TmChartDemo_StackedDescription"]
    </p>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div data-testid="chart-stacked-bar">
            <h3 class="text-sm font-medium text-slate-600 dark:text-slate-400 mb-2">@Loc["TmChartDemo_StackedVertical"]</h3>
            <TmChart Type="ChartType.StackedBar" Data="StackedExpenseData" Height="320px"
                     ShowValues="true" InteractiveLegend="true" OnSegmentClick="HandleSegmentClick" />
        </div>
        <div data-testid="chart-stacked-horizontal-bar">
            <h3 class="text-sm font-medium text-slate-600 dark:text-slate-400 mb-2">@Loc["TmChartDemo_StackedHorizontal"]</h3>
            <TmChart Type="ChartType.StackedHorizontalBar" Data="StackedExpenseData" Height="320px"
                     ShowValues="true" InteractiveLegend="true" OnSegmentClick="HandleSegmentClick" />
        </div>
    </div>
</section>

<!-- Index tooltip (plan ff043b2e, phase 3) -->
<section class="demo-section mb-8" data-testid="charts-demo-index-tooltip">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-2">@Loc["TmChartDemo_IndexTooltipTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        @Loc["TmChartDemo_IndexTooltipDescription"]
    </p>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="showcase-card" data-testid="charts-demo-index-default">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">@Loc["TmChartDemo_IndexTooltipDefault"]</h3>
            <TmChart Type="ChartType.Line" Data="IndexTooltipData" Height="320px"
                     TooltipMode="ChartTooltipMode.Index" InteractiveLegend="true" />
        </div>
        <div class="showcase-card" data-testid="charts-demo-index-custom">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">@Loc["TmChartDemo_IndexTooltipCustom"]</h3>
            <TmChart Type="ChartType.StackedBar" Data="IndexTooltipData" Height="320px"
                     TooltipMode="ChartTooltipMode.Index">
                <TooltipIndexTemplate Context="ctx">
                    <span class="tm-chart__tooltip-label">@ctx.Label</span>
                    @foreach (var series in ctx.Series)
                    {
                        <span class="tm-chart__tooltip-value">@series.Label: @series.Value.ToString("N0", CultureInfo.CurrentCulture)</span>
                    }
                    <span class="tm-chart__tooltip-value" data-testid="charts-demo-index-total">
                        @Loc["TmChartDemo_IndexTooltipTotal", ctx.Total.ToString("N0", CultureInfo.CurrentCulture)]
                    </span>
                </TooltipIndexTemplate>
            </TmChart>
        </div>
        @* Plan 7ba95ed6, Fáze 17 — SEVEN series. The two cards above never reach the path the review found
           broken: with more series than the two the demo used to carry, the index overlay's dot band could
           collide with the hover-zone group and Blazor then REPLACED the zone the pointer was resting on, so
           the browser never delivered the mouseout that clears the card. A browser guard can only prove the
           zone survives when the page really renders a chart this wide — and the chart names itself, because
           seven series in one plot are no longer a generic "Line chart". *@
        <div class="showcase-card lg:col-span-2" data-testid="charts-demo-index-many">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">@Loc["TmChartDemo_IndexManyTitle"]</h3>
            <TmChart Type="ChartType.Line" Data="IndexTooltipManyData" Height="320px"
                     TooltipMode="ChartTooltipMode.Index" InteractiveLegend="true"
                     AriaLabel="@Loc["TmChartDemo_IndexManyAriaLabel"]" />
        </div>
    </div>
</section>

<!-- Sparkline extras (plan ff043b2e, phase 3) -->
<section class="demo-section mb-8" data-testid="charts-demo-sparkline-extras">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-2">@Loc["TmChartDemo_SparklineExtrasTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        @Loc["TmChartDemo_SparklineExtrasDescription"]
    </p>
    @* A grid, not a wrapping flex row: four labels of different lengths wrapped into a ragged
       second row with one lonely item. Two columns keep the pairs even at every width. *@
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-10 gap-y-4">
        <div class="flex items-center gap-4" data-testid="charts-demo-sparkline-plain">
            <span class="w-52 shrink-0 text-sm text-slate-600 dark:text-slate-400">@Loc["TmChartDemo_SparklinePlain"]</span>
            <TmSparkline Data="_sparkData" Type="SparklineType.Line" Height="40px" Width="120px" />
        </div>
        <div class="flex items-center gap-4" data-testid="charts-demo-sparkline-minmax">
            <span class="w-52 shrink-0 text-sm text-slate-600 dark:text-slate-400">@Loc["TmChartDemo_SparklineMinMax"]</span>
            <TmSparkline Data="_sparkData" Type="SparklineType.Bar" Height="56px" Width="140px"
                         ShowMinMax="true" />
        </div>
        <div class="flex items-center gap-4" data-testid="charts-demo-sparkline-last-point">
            <span class="w-52 shrink-0 text-sm text-slate-600 dark:text-slate-400">@Loc["TmChartDemo_SparklineLastPoint"]</span>
            <TmSparkline Data="_sparkData" Type="SparklineType.Area" Height="48px" Width="140px"
                         Color="var(--tm-color-success)" ShowLastPoint="true" />
        </div>
        <div class="flex items-center gap-4" data-testid="charts-demo-sparkline-tooltip">
            <span class="w-52 shrink-0 text-sm text-slate-600 dark:text-slate-400">@Loc["TmChartDemo_SparklineTooltip"]</span>
            @* Both opt-ins at once: the min/max caption and the value card share the top edge, so the
               caption hides while the card is up (the narrow-cell overlap the CSS rule prevents). *@
            <TmSparkline Data="_sparkData" Type="SparklineType.Line" Height="44px" Width="160px"
                         ShowMinMax="true" ShowTooltip="true" />
        </div>
    </div>
</section>

