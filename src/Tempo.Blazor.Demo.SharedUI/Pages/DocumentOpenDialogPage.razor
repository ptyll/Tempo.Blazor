@page "/document-open-dialog"
@using Tempo.Blazor.Abstractions.Layout
@using Tempo.Blazor.Components.Files
@using Tempo.Blazor.DocumentLibrary
@inject ITempoDocumentLibraryProvider LibraryProvider

<PageTitle>Document Open Dialog – Tempo.Blazor</PageTitle>

<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Document Open Dialog</h1>
    <p class="text-slate-600 dark:text-slate-400">
        A Word-like open dialog over the document library. Browse the collapsible folder tree, search, switch between
        list and grid, sort, manage folders/documents, and pick a document to link or copy. "Show Recent" adds the
        opt-in Recent node: it and the search browse the whole library (<code>Scope = Library</code>), newest first. In a container narrower than 640 px (or with Layout = Mobile) the dialog is a fullscreen panel: drill-down folder rows, two-line document rows with a preview, a row menu and a sticky action bar.
    </p>
</div>

<section class="demo-section mb-10">
    <div class="flex flex-wrap items-center gap-3 mb-4">
        <label class="text-sm text-slate-600 dark:text-slate-300">Document kind:</label>
        <select class="px-3 py-1.5 text-sm rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800"
                @bind="_kind" data-testid="kind-select">
            <option value="@TempoDocumentKind.Wireframe">Wireframe</option>
            <option value="@TempoDocumentKind.Diagram">Diagram</option>
            <option value="@TempoDocumentKind.Spreadsheet">Spreadsheet</option>
        </select>

        <label class="inline-flex items-center gap-1.5 text-sm text-slate-600 dark:text-slate-300">
            <input type="checkbox" @bind="_showRecent" data-testid="show-recent" />
            Show Recent
        </label>

        <label class="text-sm text-slate-600 dark:text-slate-300">Layout:</label>
        <select class="px-3 py-1.5 text-sm rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800"
                @bind="_layout" data-testid="layout-select">
            <option value="@TmLayoutMode.Auto">Auto (measured)</option>
            <option value="@TmLayoutMode.Desktop">Desktop</option>
            <option value="@TmLayoutMode.Tablet">Tablet</option>
            <option value="@TmLayoutMode.Mobile">Mobile</option>
        </select>

        <button class="px-4 py-1.5 text-sm rounded bg-indigo-600 text-white hover:bg-indigo-700"
                data-testid="open-dialog-btn"
                @onclick="() => _open = true">
            Open…
        </button>
    </div>

    @if (_result is not null)
    {
        <div class="rounded border border-slate-200 dark:border-slate-700 p-4 text-sm" data-testid="open-result">
            <div><span class="font-semibold">Picked:</span> <span data-testid="result-name">@_result.Name</span></div>
            <div><span class="font-semibold">Kind:</span> @_result.Kind</div>
            <div><span class="font-semibold">Mode:</span> <span data-testid="result-mode">@_result.Mode</span></div>
            <div><span class="font-semibold">Id:</span> <code>@_result.DocumentId</code></div>
        </div>
    }
    else
    {
        <p class="text-sm text-slate-500 dark:text-slate-400" data-testid="open-empty">
            No document picked yet.
        </p>
    }
</section>

<TmDocumentOpenDialog Provider="LibraryProvider"
                      Kind="_kind"
                      @bind-Open="_open"
                      ShowRecent="_showRecent"
                      LayoutMode="_layout"
                      OnSelected="HandleSelected" />

@code {
    private bool _open;
    private bool _showRecent;
    private TmLayoutMode _layout = TmLayoutMode.Auto;
    private TempoDocumentKind _kind = TempoDocumentKind.Wireframe;
    private DocumentOpenResult? _result;

    private void HandleSelected(DocumentOpenResult result) => _result = result;
}
