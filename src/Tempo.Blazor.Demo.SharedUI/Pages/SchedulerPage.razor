@page "/scheduler"
@using Tempo.Blazor.Abstractions.Layout
@using Tempo.Blazor.Components.Scheduler
@using Tempo.Blazor.Models
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Icons
@inject ToastService Toast
@inject HttpClient Http
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>Scheduler – Tempo.Blazor</PageTitle>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Scheduler</h1>
    <p class="text-slate-600 dark:text-slate-400">Full-featured calendar component with multiple views, drag & drop, and event management.</p>
</div>

<!-- Timezone, ICS export & Print -->
<section class="demo-section" data-testid="scheduler-tz-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Timezone, ICS Export &amp; Print</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">
                Events carry a timezone offset and are shown in the display timezone (DST-aware). A daily standup
                recurs via RRULE. Export the calendar to a valid .ics file, and use the toolbar Print button.
            </p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-indigo-100 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 rounded-full">K3</span>
    </div>

    <div class="showcase-card">
        <div class="flex items-center gap-2 mb-3">
            <label class="text-sm text-slate-600 dark:text-slate-300">Display timezone:</label>
            <select class="tm-input" style="max-width: 240px" @bind="_displayTz" data-testid="scheduler-tz-select">
                <option value="Europe/Prague">Europe/Prague</option>
                <option value="America/New_York">America/New_York (UTC−5/−4)</option>
                <option value="Asia/Tokyo">Asia/Tokyo</option>
                <option value="UTC">UTC</option>
            </select>
            <button class="tm-btn tm-btn-primary" data-testid="scheduler-export-ics" @onclick="ExportIcsAsync">Export .ics</button>
        </div>
        <div class="showcase-card" style="min-height: 480px; position: relative; overflow: hidden;">
            <TmScheduler @bind-View="_tzView"
                         @bind-CurrentDate="_tzDate"
                         TimeZoneId="@_displayTz"
                         Events="_tzEvents" />
        </div>
    </div>
</section>

<section class="demo-section" data-testid="scheduler-tablet-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Tablet layout</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Forced tablet layout: one toolbar row, at any viewport</p>
        </div>
    </div>
    <div class="showcase-card" style="width: 1100px; max-width: 100%; min-height: 420px; position: relative;">
        <TmScheduler @bind-View="_tabletView"
                     @bind-CurrentDate="_tabletDate"
                     Events="_sampleEvents"
                     LayoutMode="TmLayoutMode.Tablet" />
    </div>
    @* Auto, so a viewport in the 640-1023 band resolves to tablet from the container itself. *@
    <div class="showcase-card" data-testid="scheduler-tablet-auto" style="width: 100%; min-height: 240px; position: relative;">
        <TmScheduler Events="_sampleEvents" View="TmScheduleViewType.Week" />
    </div>
</section>

<section class="demo-section" data-testid="scheduler-mobile-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Mobile layout</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Forced mobile layout with the action bar, at any viewport</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full">Phone</span>
    </div>
    <div class="showcase-card" data-testid="scheduler-mobile-agenda" style="max-width: 390px; height: 640px; position: relative;">
        <TmScheduler @bind-View="_mobileAgendaView"
                     @bind-CurrentDate="_mobileDate"
                     Events="_sampleEvents"
                     LayoutMode="TmLayoutMode.Mobile"
                     ScrollToTime="@_scrollToEight" />
    </div>
    <div class="showcase-card" data-testid="scheduler-mobile-plain" style="max-width: 390px; height: 640px; position: relative;">
        <TmScheduler @bind-View="_plainMobileView"
                     @bind-CurrentDate="_plainMobileDate"
                     Events="_sampleEvents"
                     LayoutMode="TmLayoutMode.Mobile"
                     ScrollToTime="@_scrollToEight" />
    </div>
    <div class="showcase-card" style="max-width: 390px; height: 640px; position: relative;">
        <TmScheduler @bind-View="_mobileView"
                     @bind-CurrentDate="_mobileDate"
                     Events="_sampleEvents"
                     LayoutMode="TmLayoutMode.Mobile"
                     MobileActionBar="TmSchedulerMobileActionBar.Auto"
                     ScrollToTime="@_scrollToEight"
                     OnAddClick="HandleAddClick"
                     OnEventClick="HandleEventClick" />
    </div>
    @* No height of its own: the 70dvh cap on the grid is what keeps the action bar in view. *@
    <div class="showcase-card" data-testid="scheduler-mobile-unbounded" style="max-width: 390px; position: relative;">
        <TmScheduler Events="_sampleEvents"
                     View="TmScheduleViewType.Week"
                     LayoutMode="TmLayoutMode.Mobile"
                     ScrollToTime="@_scrollToEight"
                     MobileActionBar="TmSchedulerMobileActionBar.Auto" />
    </div>
</section>

<!-- Basic Scheduler -->
<section class="demo-section" data-testid="scheduler-month-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Month View</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Default month view with event display</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full">Calendar</span>
    </div>
    
    <div class="showcase-card" style="min-height: 500px; position: relative; overflow: hidden;">
        <TmScheduler @bind-View="_monthView"
                     @bind-CurrentDate="_currentDate"
                     @bind-SelectedEvent="_monthSelected"
                     Events="_sampleEvents"
                     LayoutMode="TmLayoutMode.Desktop"
                     OnEventClick="HandleEventClick"
                     OnSlotClick="HandleSlotClick" />
    </div>
</section>

<!-- Month Event Template -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Month Event Template</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Custom month view event content with status badges</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-full">Template</span>
    </div>

    <div class="showcase-card" data-testid="scheduler-month-template" style="min-height: 500px; position: relative; overflow: hidden;">
        <TmScheduler @bind-View="_templateView"
                     CurrentDate="_templateDate"
                     Events="_templateEvents"
                     ReadOnly="true"
                     OnEventClick="HandleEventClick">
            <EventTemplate Context="evt">
                @if (_templateView != TmScheduleViewType.Month)
                {
                    <span data-testid="scheduler-month-template-event">@evt.Title</span>
                }
                else
                {
                <div class="tm-demo-month-event-template" data-testid="scheduler-month-template-event"
                     style="display: grid; gap: 2px; min-width: 0; margin: -2px; border-radius: 6px; padding: 4px 6px; background: @evt.Color; color: white; box-shadow: 0 1px 2px rgba(15,23,42,.18);">
                    <strong style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@evt.Title</strong>
                    <span style="display: inline-flex; align-items: center; width: max-content; max-width: 100%; border-radius: 999px; padding: 1px 6px; background: rgba(255,255,255,.88); color: #334155; font-size: 10px; font-weight: 700; line-height: 1.35;">
                        @evt.Description
                    </span>
                </div>
                }
            </EventTemplate>
        </TmScheduler>
    </div>
</section>

<!-- Ranges: Timeline day, Agenda range, +N more -->
<section class="demo-section" data-testid="scheduler-ranges-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Ranges, templates and overflow</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">
                Timeline is one day, the agenda title shows its 30-day range, and "+N more" opens that day.
            </p>
            <label class="text-sm text-slate-600 dark:text-slate-400 mt-2 inline-flex items-center gap-2">
                <input type="checkbox" data-testid="scheduler-ranges-sunday"
                       @bind="_rangesSunday" />
                Week starts on Sunday
            </label>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 rounded-full">B14/B24</span>
    </div>

    <div class="showcase-card" data-testid="scheduler-ranges" style="min-height: 500px; position: relative; overflow: hidden;">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-3" data-testid="scheduler-ranges-result">@_rangesResult</p>
        <TmScheduler @bind-View="_rangesView"
                     @bind-CurrentDate="_rangesDate"
                     Events="_rangesEvents"
                     FirstDayOfWeek="@(_rangesSunday ? 0 : 1)"
                     MaxVisibleEvents="3"
                     ReadOnly="true"
                     OnEventClick="HandleRangesEventClick">
            <EventTemplate Context="evt">
                <span data-testid="scheduler-ranges-event">@evt.Title</span>
            </EventTemplate>
        </TmScheduler>
    </div>
</section>

<!-- Week View -->
<section class="demo-section" data-testid="scheduler-week-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Week View</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Time-based week view with hourly slots</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-full">Time Grid</span>
    </div>
    
    <div class="showcase-card" style="height: 600px; position: relative; overflow: hidden;">
        <TmScheduler View="TmScheduleViewType.Week"
                     LayoutMode="TmLayoutMode.Desktop"
                     @bind-CurrentDate="_weekDate"
                     @bind-SelectedEvent="_weekSelected"
                     Events="_weekEvents"
                     ScrollToTime="@_scrollToEight"
                     SlotDuration="30"
                     OnEventClick="HandleEventClick"
                     OnSlotClick="HandleSlotClick" />
    </div>
</section>

<!-- Day View -->
<section class="demo-section" data-testid="scheduler-day-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Day View</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Single day detailed view</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full">Detailed</span>
    </div>
    
    <div class="showcase-card" style="height: 600px; position: relative; overflow: hidden;">
        <TmScheduler View="TmScheduleViewType.Day"
                     LayoutMode="TmLayoutMode.Desktop"
                     @bind-CurrentDate="_dayDate"
                     Events="_dayEvents"
                     ScrollToTime="@_scrollToEight"
                     SlotDuration="15"
                     OnEventClick="HandleEventClick"
                     OnSlotClick="HandleSlotClick" />
    </div>
</section>

<!-- Agenda View -->
<section class="demo-section" data-testid="scheduler-agenda-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Agenda View</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">List view of upcoming events</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-300 rounded-full">List</span>
    </div>
    
    <div class="showcase-card" style="min-height: 400px; position: relative; overflow: hidden;">
        <TmScheduler View="TmScheduleViewType.Agenda"
                     @bind-CurrentDate="_agendaDate"
                     @bind-SelectedEvent="_agendaSelected"
                     Events="_agendaEvents"
                     LayoutMode="TmLayoutMode.Desktop"
                     OnEventClick="HandleEventClick" />
    </div>
</section>

<!-- Working hours, work week and the current-time indicator -->
<section class="demo-section" data-testid="scheduler-range-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Working hours and the current time</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">A work week clipped to 08:00-17:00, with the current-time indicator</p>
            <p class="text-sm text-slate-600 dark:text-slate-300" data-testid="scheduler-range-end">Morning Standup ends @_weekEvents.First(e => e.Id == "w1").End.ToString("HH:mm")</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-sky-100 dark:bg-sky-900/30 text-sky-700 dark:text-sky-300 rounded-full">Range</span>
    </div>

    <div class="showcase-card" style="height: 600px; position: relative; overflow: hidden;">
        <TmScheduler View="TmScheduleViewType.Week"
                     @bind-CurrentDate="_weekDate"
                     Events="_weekEvents"
                     WeekDays="TmSchedulerWeekDays.WorkWeek"
                     ShowFullDay="false"
                     WorkDayStart="@(new TimeOnly(8, 0))"
                     WorkDayEnd="@(new TimeOnly(17, 0))"
                     ShowNowIndicator="true"
                     HighlightOffHours="true"
                     ScrollToTime="@_rangeScrollTo"
                     OnEventChanged="HandleRangeEventChanged"
                     SlotDuration="60" />
    </div>
</section>

<!-- A pinned instant shown in two zones, so the now line's place is a known number. -->
<section class="demo-section" data-testid="scheduler-now-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Current time in two zones</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">The same instant drawn for Prague and New York</p>
        </div>
    </div>

    <div class="showcase-card" style="height: 600px; position: relative; overflow: hidden;" data-testid="scheduler-now-prague">
        <TmScheduler View="TmScheduleViewType.Day"
                     CurrentDate="@_nowDay"
                     Events="_nowEvents"
                     TimeZoneId="Europe/Prague"
                     ShowNowIndicator="true"
                     ScrollToTime="@_scrollToEight"
                     SlotDuration="60" />
    </div>
    <div class="showcase-card mt-4" style="height: 600px; position: relative; overflow: hidden;" data-testid="scheduler-now-newyork">
        <TmScheduler View="TmScheduleViewType.Day"
                     CurrentDate="@_nowDay"
                     Events="_nowEvents"
                     TimeZoneId="America/New_York"
                     ShowNowIndicator="true"
                     ScrollToTime="@_scrollToFour"
                     SlotDuration="60" />
    </div>
</section>

<!-- Day view with a resource column, so the header shows the avatar. -->
<section class="demo-section" data-testid="scheduler-resource-day-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Day view with resources</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Each room heads its own column</p>
        </div>
    </div>

    <div class="showcase-card" style="height: 600px; position: relative; overflow: hidden;">
        <TmScheduler View="TmScheduleViewType.Day"
                     @bind-CurrentDate="_dayDate"
                     Events="_resourceDayEvents"
                     Resources="_resources"
                     ShowEventResource="true"
                     ScrollToTime="@_scrollToEight"
                     SlotDuration="60" />
    </div>
</section>

<!-- June 2026 fits in five weeks, so Auto drops the empty sixth row. -->
<section class="demo-section" data-testid="scheduler-month-auto-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Month, five weeks</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">June 2026 with the empty trailing week dropped</p>
        </div>
    </div>

    <div class="showcase-card" style="min-height: 500px; position: relative; overflow: hidden;">
        <TmScheduler View="TmScheduleViewType.Month"
                     CurrentDate="@(new DateTime(2026, 6, 15))"
                     MonthWeeks="TmSchedulerMonthWeeks.Auto"
                     Events="_sampleEvents" />
    </div>
</section>

<!-- Timeline View -->
<section class="demo-section" data-testid="scheduler-timeline-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Timeline View</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Horizontal timeline with resources</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-pink-100 dark:bg-pink-900/30 text-pink-700 dark:text-pink-300 rounded-full">Resources</span>
    </div>
    
    <div class="showcase-card" style="height: 500px; position: relative;">
        <TmScheduler View="TmScheduleViewType.Timeline"
                     LayoutMode="TmLayoutMode.Desktop"
                     @bind-CurrentDate="_timelineDate"
                     Events="_timelineEvents"
                     Resources="_resources"
                     ScrollToTime="@_scrollToEight"
                     SlotDuration="60"
                     OnEventClick="HandleEventClick"
                     OnSlotClick="HandleSlotClick" />
    </div>
</section>

<!-- Highlighted weekends and tinted all-day events -->
<section class="demo-section" data-testid="scheduler-highlight-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Weekends and all-day style</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Opt-in weekend wash and the tinted all-day card</p>
        </div>
    </div>

    <div class="showcase-card" style="min-height: 500px; position: relative; overflow: hidden;">
        <div class="mb-4 flex items-center gap-4">
            <TmToggle @bind-Value="_highlightWeekends" Label="Highlight weekends" />
            <TmToggle Value="@(_allDayStyle == TmAllDayEventStyle.Tinted)"
                      ValueChanged="OnAllDayStyleChanged"
                      Label="Tinted all-day events" />
        </div>
        <TmScheduler View="TmScheduleViewType.Month"
                     CurrentDate="_highlightDate"
                     Events="_highlightEvents"
                     HighlightWeekends="_highlightWeekends"
                     AllDayEventStyle="_allDayStyle" />
    </div>
</section>

<!-- Toolbar 2.0: a view subset, host slots, the add button and two-way selection -->
<section class="demo-section" data-testid="scheduler-toolbar-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Toolbar</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">A view subset, host slots, the add button and two-way selection</p>
        </div>
    </div>

    <div class="showcase-card" style="min-height: 500px; position: relative; overflow: hidden;">
        <div class="mb-4 flex items-center gap-4">
            <TmToggle @bind-Value="_toolbarAllowPrint" Label="Allow print" />
            <TmToggle @bind-Value="_toolbarShowHeader" Label="Show header" />
        </div>
        <TmScheduler @bind-View="_toolbarView"
                     @bind-CurrentDate="_toolbarDate"
                     @bind-SelectedDate="_toolbarSelectedDate"
                     @bind-SelectedEvent="_toolbarSelectedEvent"
                     Views="_toolbarViews"
                     Events="_toolbarEvents"
                     AllowPrint="_toolbarAllowPrint"
                     ShowHeader="_toolbarShowHeader"
                     OnAddClick="HandleToolbarAdd">
            <HeaderStart><span data-testid="toolbar-host-start">Rooms</span></HeaderStart>
            <HeaderActions><span data-testid="toolbar-host-actions">Filter</span></HeaderActions>
        </TmScheduler>
        <div class="mt-4" data-testid="scheduler-toolbar-one-view">
            <TmScheduler View="TmScheduleViewType.Week" CurrentDate="_toolbarDate" Views="_oneView" />
        </div>
        <div class="mt-4" data-testid="scheduler-toolbar-inserted-view">
            <TmScheduler View="TmScheduleViewType.Week" CurrentDate="_toolbarDate" Views="_insertedViews" />
        </div>
    </div>
</section>

<!-- An agenda range with nothing in it -->
<section class="demo-section" data-testid="scheduler-empty-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Empty agenda</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">A range with no events</p>
        </div>
    </div>

    <div class="showcase-card" style="min-height: 240px; position: relative; overflow: hidden;">
        <TmScheduler View="TmScheduleViewType.Agenda" CurrentDate="_highlightDate" Events="_emptyEvents" />
    </div>
</section>

<!-- Interactive Demo -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Interactive Demo</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Click on events or empty slots</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300 rounded-full">Interactive</span>
    </div>
    
    <div class="showcase-card" style="height: 640px; position: relative; overflow: hidden;" data-testid="scheduler-interactive">
        <div class="mb-4 p-4 bg-slate-50 dark:bg-slate-800 rounded-lg">
            <p class="text-sm text-slate-600 dark:text-slate-400" data-testid="scheduler-last-action">
                <strong>Last Action:</strong> @_lastAction
            </p>
        </div>
        
        <TmScheduler @bind-View="_interactiveView"
                     @bind-CurrentDate="_interactiveDate"
                     Events="_interactiveEvents"
                     LayoutMode="TmLayoutMode.Desktop"
                     OnEventClick="HandleEventClick"
                     OnSlotClick="HandleSlotClick"
                     OnEventChanged="HandleEventChanged"
                     OnSlotContextMenu="HandleSlotContextMenu"
                     OnEventContextMenu="HandleEventContextMenu" />
    </div>
</section>

<!-- Context Menu for Slots -->
@if (_showSlotContextMenu)
{
    <div class="tm-scheduler-context-menu"
         style="left: @_contextMenuXpx; top: @_contextMenuYpx;"
         @onmouseleave="() => _showSlotContextMenu = false">
        <button class="tm-scheduler-context-menu-item" @onclick="CreateEventFromSlot">
            <svg class="tm-scheduler-context-menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Create Event
        </button>
        <button class="tm-scheduler-context-menu-item" @onclick="GoToDate">
            <svg class="tm-scheduler-context-menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Go to Date
        </button>
    </div>
}

<!-- Context Menu for Events -->
@if (_showEventContextMenu)
{
    <div class="tm-scheduler-context-menu"
         style="left: @_contextMenuXpx; top: @_contextMenuYpx;"
         @onmouseleave="() => _showEventContextMenu = false">
        <button class="tm-scheduler-context-menu-item" @onclick="EditEvent">
            <svg class="tm-scheduler-context-menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
