    private void HandleEventClick(TmScheduleEvent evt)
    {
        _lastAction = $"Clicked event: '{evt.Title}' at {evt.Start:g}";
        Toast.ShowInfo($"Event: {evt.Title}");
        _detail = evt;
        _detailOpen = true;
    }

    private void HandleSlotClick((DateTime Start, DateTime End) slot)
    {
        _lastAction = $"Clicked slot: {slot.Start:g} - {slot.End:g}";
        Toast.ShowInfo($"Slot: {slot.Start:g} - {slot.End:g}");
    }

    private void HandleEventChanged(TmScheduleEvent evt)
    {
        // The scheduler hands the grid normalized copies: write the change back to the demo's own list,
        // otherwise the next render restores the old times (a resize would visibly snap back).
        var index = _interactiveEvents.FindIndex(e => e.Id == evt.Id);
        if (index >= 0)
        {
            _interactiveEvents[index].Start = evt.Start;
            _interactiveEvents[index].End = evt.End;
        }

        _lastAction = $"Event moved: '{evt.Title}' to {evt.Start:g} - {evt.End:t}";
        Toast.ShowSuccess($"Event '{evt.Title}' moved to {evt.Start:g}");
    }

    // Context Menu Handlers
    private void HandleSlotContextMenu(SchedulerSlotContext ctx)
    {
        _showEventContextMenu = false;
        _showSlotContextMenu = true;
        _contextMenuXpx = $"{ctx.ClientX}px";
        _contextMenuYpx = $"{ctx.ClientY}px";
        _selectedSlot = (ctx.Start, ctx.End);
        _lastAction = $"Right-clicked slot: {ctx.Start:g} - {ctx.End:g}";
    }

    private void HandleEventContextMenu(SchedulerEventContext ctx)
    {
        _showSlotContextMenu = false;
        _showEventContextMenu = true;
        _contextMenuXpx = $"{ctx.ClientX}px";
        _contextMenuYpx = $"{ctx.ClientY}px";
        _selectedEvent = ctx.Event;
        _lastAction = $"Right-clicked event: '{ctx.Event.Title}'";
    }

    private void CreateEventFromSlot()
    {
        _showSlotContextMenu = false;
        var newEvent = new TmScheduleEvent
        {
            Id = Guid.NewGuid().ToString(),
            Title = "New Event",
            Start = _selectedSlot.Start,
            End = _selectedSlot.End,
            Color = "#3b82f6"
        };
        _interactiveEvents.Add(newEvent);
        Toast.ShowSuccess("New event created!");
        _lastAction = $"Created event at: {_selectedSlot.Start:g}";
    }

    private void GoToDate()
    {
        _showSlotContextMenu = false;
        _interactiveDate = _selectedSlot.Start;
        Toast.ShowInfo($"Navigated to {_selectedSlot.Start:d}");
    }

    private void EditEvent()
    {
        _showEventContextMenu = false;
        if (_selectedEvent is not null)
        {
            Toast.ShowInfo($"Editing: {_selectedEvent.Title}");
            _lastAction = $"Edit dialog opened for: {_selectedEvent.Title}";
        }
    }

    private void CopyEvent()
    {
        _showEventContextMenu = false;
        if (_selectedEvent is not null)
        {
            var copy = new TmScheduleEvent
            {
                Id = Guid.NewGuid().ToString(),
                Title = $"{_selectedEvent.Title} (Copy)",
                Start = _selectedEvent.Start.AddHours(1),
                End = _selectedEvent.End.AddHours(1),
                Color = _selectedEvent.Color,
                Description = _selectedEvent.Description
            };
            _interactiveEvents.Add(copy);
            Toast.ShowSuccess("Event copied!");
            _lastAction = $"Copied event: {_selectedEvent.Title}";
        }
    }

    private void DeleteEvent()
    {
        _showEventContextMenu = false;
        if (_selectedEvent is not null)
        {
            _interactiveEvents.Remove(_selectedEvent);
            Toast.ShowSuccess("Event deleted!");
            _lastAction = $"Deleted event: {_selectedEvent.Title}";
            _selectedEvent = null;
        }
    }
