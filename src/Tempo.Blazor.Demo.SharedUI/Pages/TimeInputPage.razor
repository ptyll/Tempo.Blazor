@page "/time-input"
<PageTitle>Time selector – Tempo.Blazor</PageTitle>

<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Time selector</h1>
    <p class="text-slate-600 dark:text-slate-400">
        <code class="px-1.5 py-0.5 bg-slate-100 dark:bg-slate-800 rounded text-xs font-mono">&lt;TmTimeSelector /&gt;</code>
        is the inline APG spinbutton readout: hours/minutes with +/−, optional AM/PM, an hour/minute
        grid, host-owned presets and a JS module for keys, typeahead, auto-repeat, fit and opt-in swipe.
        <code class="px-1.5 py-0.5 bg-slate-100 dark:bg-slate-800 rounded text-xs font-mono">&lt;TmTimePicker /&gt;</code>
        default <code>Presentation=Segments</code> keeps today's DOM; Popup/Auto compose the selector
        into a dialog overlay (sheet on a mobile viewport).
        <code class="px-1.5 py-0.5 bg-slate-100 dark:bg-slate-800 rounded text-xs font-mono">&lt;TmTimeRangePicker /&gt;</code>
        default Segments keeps two <code>TmTimeInput</code>s; Popup/Auto adopt the picker, and
        additive <code>AllowOvernightRange</code> treats 22:00–06:00 as a night shift.
        A host <code class="px-1.5 py-0.5 bg-slate-100 dark:bg-slate-800 rounded text-xs font-mono">&lt;input&gt;</code>
        sits beside the selector so E2E can open the software keyboard.
    </p>
</div>

<section class="demo-section" data-testid="time-selector-inline">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Inline 24-hour selector</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full">HourCycle=H23</span>
    </div>

    <div class="showcase-card" data-testid="time-selector-inline-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Tap +/− or use the arrow keys on a spinbutton. Minutes wrap inside the hour and never carry.
        </p>
        <div class="flex flex-wrap items-end gap-4">
            <TmTimeSelector @bind-Value="_inline"
                            HourCycle="TimeHourCycle.H23"
                            ShowNowPreset="true"
                            Presets="_presets"
                            RecentTimes="_recents"
                            Id="time-selector-inline" />
            <label class="text-sm text-slate-600 dark:text-slate-400">
                Host field
                <input type="text"
                       class="mt-1 block w-40 rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-2 py-1"
                       data-testid="time-selector-host-input"
                       autocomplete="off"
                       @bind="_hostNote"
                       @bind:event="oninput" />
            </label>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-3" data-testid="time-selector-inline-echo">
            Value: @(_inline?.ToString("HH:mm") ?? "—")
        </p>
    </div>
</section>

<section class="demo-section" data-testid="time-selector-12h">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">12-hour clock</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-full">HourCycle=H12</span>
    </div>

    <div class="showcase-card" data-testid="time-selector-12h-card">
        <TmTimeSelector @bind-Value="_twelve"
                        HourCycle="TimeHourCycle.H12"
                        Culture="@_enUs"
                        Id="time-selector-12h" />
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-3">
            Value: @(_twelve?.ToString("HH:mm") ?? "—")
        </p>
    </div>
</section>

<section class="demo-section" data-testid="time-selector-range">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Min / max</h2>
    </div>

    <div class="showcase-card" data-testid="time-selector-range-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            08:00 is below 09:00–17:00, so the value stays on screen and is marked invalid.
        </p>
        <TmTimeSelector @bind-Value="_ranged"
                        HourCycle="TimeHourCycle.H23"
                        MinTime="@(new TimeOnly(9, 0))"
                        MaxTime="@(new TimeOnly(17, 0))"
                        Id="time-selector-range" />
    </div>
</section>

<section class="demo-section" data-testid="time-selector-seconds">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">With seconds</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-violet-100 dark:bg-violet-900/30 text-violet-700 dark:text-violet-300 rounded-full">ShowSeconds</span>
    </div>

    <div class="showcase-card" data-testid="time-selector-seconds-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Square fit collapses the hour/minute grid when seconds would overflow the 260 px sheet.
        </p>
        <TmTimeSelector @bind-Value="_seconds"
                        HourCycle="TimeHourCycle.H23"
                        ShowSeconds="true"
                        Id="time-selector-seconds" />
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-3" data-testid="time-selector-seconds-echo">
            Value: @(_seconds?.ToString("HH:mm:ss") ?? "—")
        </p>
    </div>
</section>

<section class="demo-section" data-testid="time-selector-readonly">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Read-only</h2>
    </div>

    <div class="showcase-card" data-testid="time-selector-readonly-card">
        <TmTimeSelector Value="@(new TimeOnly(10, 0))"
                        ReadOnly="true"
                        HourCycle="TimeHourCycle.H23"
                        Id="time-selector-readonly" />
    </div>
</section>

<section class="demo-section" data-testid="time-selector-swipe">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Swipe</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 rounded-full">EnableSwipe</span>
    </div>

    <div class="showcase-card" data-testid="time-selector-swipe-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Opt-in vertical swipe on a spinbutton (24 px = 1 step, swipe up = +). +/− remain the tap alternative.
        </p>
        <TmTimeSelector @bind-Value="_swipe"
                        HourCycle="TimeHourCycle.H23"
                        EnableSwipe="true"
                        Id="time-selector-swipe" />
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-3" data-testid="time-selector-swipe-echo">
            Value: @(_swipe?.ToString("HH:mm") ?? "—")
        </p>
    </div>
</section>

<section class="demo-section" data-testid="time-selector-form">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Inside TmFormField</h2>
    </div>

    <div class="showcase-card" data-testid="time-selector-form-card">
        <TmFormField Label="Opening time" HelpText="Weekday opening hours." Id="time-selector-form">
            <TmTimeSelector @bind-Value="_form"
                            HourCycle="TimeHourCycle.H23" />
        </TmFormField>
    </div>
</section>

<section class="demo-section" data-testid="time-picker-popup">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Picker popup</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full">Presentation=Popup</span>
    </div>

    <div class="showcase-card" data-testid="time-picker-popup-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Segments stay on screen; the clock trigger opens <code>TmTimeSelector</code> in a dialog.
        </p>
        <TmTimePicker @bind-Value="_popup"
                      Label="Meeting"
                      Presentation="TimePickerPresentation.Popup"
                      HourCycle="TimeHourCycle.H23"
                      Id="time-picker-popup" />
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-3">
            Value: @(_popup?.ToString("HH:mm") ?? "—")
        </p>
    </div>
</section>

<section class="demo-section" data-testid="time-picker-auto">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Picker Auto</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-full">Presentation=Auto</span>
    </div>

    <div class="showcase-card" data-testid="time-picker-auto-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            On a mobile viewport this is a trigger that opens a sheet; on desktop it matches Popup.
        </p>
        <TmTimePicker @bind-Value="_auto"
                      Label="Start"
                      Presentation="TimePickerPresentation.Auto"
                      HourCycle="TimeHourCycle.H23"
                      Id="time-picker-auto" />
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-3">
            Value: @(_auto?.ToString("HH:mm") ?? "—")
        </p>
    </div>

    <div class="showcase-card mt-4" data-testid="time-picker-readonly-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            <code>ReadOnly="true"</code> — on a desktop the read-only segments carry the value and
            the lock, so no dead trigger is rendered; on a phone the trigger stays as the value's
            carrier — it announces the lock (<code class="whitespace-nowrap">aria-disabled</code>),
            shows no opening icon and keeps its tab stop. The lock reason is linked through
            <code>AriaDescribedBy</code>.
        </p>
        <TmTimePicker Value="@_autoReadOnly"
                      ValueChanged="@(_ => {})"
                      Label="Shift start"
                      Presentation="TimePickerPresentation.Auto"
                      ReadOnly="true"
                      HourCycle="TimeHourCycle.H23"
                      AriaDescribedBy="time-picker-readonly-reason"
                      Id="time-picker-readonly" />
        <p id="time-picker-readonly-reason" class="text-xs text-slate-500 dark:text-slate-400 mt-3">
            Locked after the shift plan was published.
        </p>
    </div>
</section>

<section class="demo-section" data-testid="time-range-overnight">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Overnight range</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-violet-100 dark:bg-violet-900/30 text-violet-700 dark:text-violet-300 rounded-full">AllowOvernightRange</span>
    </div>

    <div class="showcase-card" data-testid="time-range-overnight-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            A night shift 22:00–06:00 is a valid range when <code>AllowOvernightRange</code> is set. Duration includes +1 day.
        </p>
        <TmTimeRangePicker @bind-Value="_overnightRange"
                           AllowOvernightRange="true"
                           Presentation="TimePickerPresentation.Auto"
                           MinuteStep="15"
                           ShowDuration="true"
                           ShowSwapButton="true"
                           HourCycle="TimeHourCycle.H23"
                           Label="Night shift" />
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-3" data-testid="time-range-overnight-echo">
            Value: @(_overnightRange.Start?.ToString("HH:mm") ?? "—") – @(_overnightRange.End?.ToString("HH:mm") ?? "—")
        </p>
    </div>
</section>

<section class="demo-section" data-testid="time-picker-overnight">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Overnight picker bounds</h2>
    </div>

    <div class="showcase-card" data-testid="time-picker-overnight-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Min 22:00 / Max 06:00 with <code>AllowOvernightRange</code>: 23:30 is in range, noon is not.
        </p>
        <TmTimePicker @bind-Value="_overnightPicker"
                      Label="Shift start"
                      Presentation="TimePickerPresentation.Popup"
                      MinTime="@(new TimeOnly(22, 0))"
                      MaxTime="@(new TimeOnly(6, 0))"
                      AllowOvernightRange="true"
                      HourCycle="TimeHourCycle.H23"
                      Id="time-picker-overnight" />
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-3">
            Value: @(_overnightPicker?.ToString("HH:mm") ?? "—")
        </p>
    </div>
</section>

<section class="demo-section" data-testid="time-picker-dst">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">DST gap and ambiguous</h2>
    </div>

    <div class="showcase-card" data-testid="time-picker-dst-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Europe/Prague 2026-03-29 skips 02:00; 2026-10-25 02:30 occurs twice (summer then winter offset).
        </p>
        <TmTimeSelector @bind-Value="_dstGap"
                        HourCycle="TimeHourCycle.H23"
                        ReferenceDate="@(new DateOnly(2026, 3, 29))"
                        TimeZone="@_prague"
                        Id="time-selector-dst-gap" />
        <TmTimeSelector @bind-Value="_dstAmbiguous"
                        HourCycle="TimeHourCycle.H23"
                        ReferenceDate="@(new DateOnly(2026, 10, 25))"
                        TimeZone="@_prague"
                        Id="time-selector-dst-ambiguous"
                        Class="mt-4" />
    </div>
</section>

@code {
    private static readonly System.Globalization.CultureInfo _enUs =
        System.Globalization.CultureInfo.GetCultureInfo("en-US");

    private TimeOnly? _inline = new TimeOnly(14, 30);
    private TimeOnly? _twelve = new TimeOnly(14, 30);
    private TimeOnly? _ranged = new TimeOnly(8, 0);
    private TimeOnly? _form = new TimeOnly(9, 0);
    private TimeOnly? _swipe = new TimeOnly(14, 30);
    private TimeOnly? _seconds = new TimeOnly(14, 30, 15);
    private TimeOnly? _popup = new TimeOnly(14, 30);
    private TimeOnly? _auto = new TimeOnly(9, 0);
    private TimeOnly? _autoReadOnly = new TimeOnly(9, 15);
    private (TimeOnly? Start, TimeOnly? End) _overnightRange = (new TimeOnly(22, 0), new TimeOnly(6, 0));
    private TimeOnly? _overnightPicker = new TimeOnly(23, 30);
    private TimeOnly? _dstGap = new TimeOnly(2, 30);
    private TimeOnly? _dstAmbiguous = new TimeOnly(2, 30);
    private string _hostNote = "";

    private static readonly TimeZoneInfo _prague = ResolvePrague();

    private static TimeZoneInfo ResolvePrague()
    {
        foreach (var id in new[] { "Europe/Prague", "Central Europe Standard Time" })
        {
            try
            {
                return TimeZoneInfo.FindSystemTimeZoneById(id);
            }
            catch (TimeZoneNotFoundException)
            {
            }
            catch (InvalidTimeZoneException)
            {
            }
        }

        return TimeZoneInfo.Utc;
    }

    private readonly TimePreset[] _presets =
    [
        new("Noon", new TimeOnly(12, 0)),
        new("Evening", new TimeOnly(18, 0)),
    ];

    private readonly TimeOnly[] _recents =
    [
        new TimeOnly(8, 15),
        new TimeOnly(9, 45),
        new TimeOnly(11, 0),
    ];
}
