@page "/layout"
@using Tempo.Blazor.Components.Layout
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.DataDisplay
@using Tempo.Blazor.Components.Forms
@using Tempo.Blazor.Models
@using Tempo.Blazor.Interfaces
@inject ToastService Toast
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Layout Components – Tempo.Blazor</PageTitle>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Layout Components</h1>
    <p class="text-slate-600 dark:text-slate-400">Navigation, sidebar, breadcrumbs, and command palette for application layout.</p>
</div>

<!-- Breadcrumbs Section -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Breadcrumbs</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Navigation path indicator with clickable segments</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full">Navigation</span>
    </div>
    
    <div class="showcase-card space-y-4">
        <div>
            <p class="text-sm text-slate-500 mb-2">Simple breadcrumbs</p>
            <TmBreadcrumbs Items="_simpleBreadcrumbs" />
        </div>
        
        <div>
            <p class="text-sm text-slate-500 mb-2">With icons and home</p>
            <TmBreadcrumbs Items="_fullBreadcrumbs" />
        </div>
        
        <div>
            <p class="text-sm text-slate-500 mb-2">Custom separator</p>
            <TmBreadcrumbs Items="_simpleBreadcrumbs" Separator="→" />
        </div>
        
        <div>
            <p class="text-sm text-slate-500 mb-2">With click action (no navigation)</p>
            <TmBreadcrumbs Items="_clickableBreadcrumbs" OnItemClick="OnBreadcrumbClick" />
            @if (_clickedBreadcrumb is not null)
            {
                <p class="mt-2 text-sm text-green-600 dark:text-green-400">
                    Clicked: <strong>@_clickedBreadcrumb</strong>
                </p>
            }
        </div>
    </div>
</section>

<!-- Sidebar Section -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Sidebar</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Collapsible navigation sidebar with nested menu items</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full">Layout</span>
    </div>
    
    <div class="showcase-card">
        <div class="flex gap-4">
            <TmButton Variant="ButtonVariant.Primary" OnClick="() => _sidebarCollapsed = false">
                Expand Sidebar
            </TmButton>
            <TmButton Variant="ButtonVariant.Secondary" OnClick="() => _sidebarCollapsed = true">
                Collapse Sidebar
            </TmButton>
        </div>
        
        <div class="mt-4 p-4 bg-slate-50 dark:bg-slate-800 rounded-lg">
            <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">
                Current state: <code class="px-1.5 py-0.5 bg-slate-200 dark:bg-slate-700 rounded">@(_sidebarCollapsed ? "Collapsed" : "Expanded")</code>
            </p>
        </div>
        
        <!-- Demo Sidebar -->
        <div class="mt-4 border border-slate-200 dark:border-slate-700 rounded-lg overflow-hidden" style="height: 300px;"
             data-testid="sidebar-basic-demo">
            <TmSidebar Items="_sidebarItems"
                      NavLabel="Component navigation"
                      Collapsed="_sidebarCollapsed"
                      OnToggle="() => _sidebarCollapsed = !_sidebarCollapsed"
                      Class="h-full">
                <Header>
                    <div class="flex items-center gap-2 px-4 py-3 border-b border-slate-200 dark:border-slate-700">
                        <TmIcon Name="layers" />
                        @if (!_sidebarCollapsed)
                        {
                            <span class="font-semibold">Tempo.Blazor</span>
                        }
                    </div>
                </Header>
            </TmSidebar>
        </div>

        <div class="mt-6">
            <p class="text-sm text-slate-500 mb-2">
                Sectioned rail with <code class="px-1.5 py-0.5 bg-slate-200 dark:bg-slate-700 rounded">Sections</code>
                (each group is named by its heading) and
                <code class="px-1.5 py-0.5 bg-slate-200 dark:bg-slate-700 rounded">AutoActive</code>
                — the entry matching the current page reports aria-current automatically.
            </p>
            <div class="flex gap-4 mb-3">
                <TmButton Variant="ButtonVariant.Primary" OnClick="() => _sectionedSidebarCollapsed = false">
                    Expand
                </TmButton>
                <TmButton Variant="ButtonVariant.Secondary" OnClick="() => _sectionedSidebarCollapsed = true">
                    Collapse (icon rail + tooltips)
                </TmButton>
            </div>
            <div class="border border-slate-200 dark:border-slate-700 rounded-lg overflow-hidden" style="height: 300px;"
                 data-testid="sidebar-sectioned-demo">
                <TmSidebar Sections="_sidebarSections"
                          TestIdPrefix="sectioned"
                          NavLabel="Sectioned navigation"
                          AutoActive="true"
                          AutoActiveMatchMode="SidebarNavMatchMode.Prefix"
                          Collapsed="_sectionedSidebarCollapsed"
                          OnToggle="() => _sectionedSidebarCollapsed = !_sectionedSidebarCollapsed"
                          Class="h-full">
                    <Header>
                        <div class="flex items-center gap-2 px-4 py-3 border-b border-slate-200 dark:border-slate-700">
                            <TmIcon Name="layout" />
                            @if (!_sectionedSidebarCollapsed)
                            {
                                <span class="font-semibold">Sectioned rail</span>
                            }
                        </div>
                    </Header>
                    <Footer>
                        @if (!_sectionedSidebarCollapsed)
                        {
                            <p class="text-xs text-slate-500">Footer slot</p>
                        }
                    </Footer>
                </TmSidebar>
            </div>
        </div>
    </div>
</section>

<!-- TopBar Section -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">TopBar</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Application header with search, notifications, and user menu</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-full">Layout</span>
    </div>
    
    @* No overflow-hidden here: the account menu is an absolutely positioned dropdown and a
       clipping card would cut its lower half off (the shell renders overlays outside clipping
       containers for the same reason). *@
    <div class="showcase-card p-0">
        <div data-testid="topbar-demo">
            <TmTopBar BrandTitle="Tempo.Blazor Demo"
                      ShowMenuButton="true"
                      MenuExpanded="_topBarMenuExpanded"
                      MenuControlsId="layout-topbar-menu-target"
                      OnMenuToggle="() => _topBarMenuExpanded = !_topBarMenuExpanded"
                      CommandPaletteShortcut="Ctrl+K"
                      User="_topBarUser"
                      UserMenuItems="_userMenuItems"
                      OnCommandPalette="() => _commandPaletteOpen = true"
                      OnLogout="OnTopBarLogout">
                <ActionsContent>
                    <TmButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Icon="@IconNames.Bell" OnClick='() => Toast.ShowInfo("Notifications clicked")' />
                </ActionsContent>
            </TmTopBar>
        </div>

        <div class="p-4" id="layout-topbar-menu-target">
            <p class="text-sm text-slate-600 dark:text-slate-400">
                Click the search button (Ctrl+K), the navigation disclosure button or the account avatar.
                The user has a long name on purpose: below 480&nbsp;px of the bar's own width the name
                gives way and the search trigger collapses to its icon (resize the window to watch it).
            </p>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400" data-testid="topbar-last-action">
                Last account action: <strong>@(_lastAccountAction ?? "none")</strong>
            </p>
        </div>
    </div>
</section>

<!-- TopBar narrow-width Section -->
<section class="demo-section" data-testid="topbar-narrow-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">TopBar — narrow width</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">
                Below 480&nbsp;px of the bar's own box (a container query, not the viewport) the Auto user name
                hides — the avatar stays — and the command palette trigger narrows to a square icon button.
                <code class="px-1 bg-slate-100 dark:bg-slate-800 rounded">UserNameDisplay</code> pins the name when a host needs it.
            </p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-full">Layout</span>
    </div>

    @* No overflow-hidden on the wrappers: the account menu is an absolutely positioned dropdown. *@
    <div class="showcase-card p-4 space-y-5">
        <div>
            <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-2">UserNameDisplay="Auto" (default) — the name gives way under 480&nbsp;px</p>
            <div class="border border-slate-200 dark:border-slate-700 rounded-lg" style="max-width: 24rem;" data-testid="topbar-narrow-auto">
                <TmTopBar BrandTitle="Tempo"
                          TestIdPrefix="topbar-narrow-auto"
                          ShowMenuButton="true"
                          CommandPaletteShortcut="Ctrl+K"
                          User="_narrowUser"
                          OnCommandPalette="() => _commandPaletteOpen = true" />
            </div>
        </div>

        <div>
            <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-2">UserNameDisplay="Always" — the name stays and ellipsises</p>
            <div class="border border-slate-200 dark:border-slate-700 rounded-lg" style="max-width: 24rem;" data-testid="topbar-narrow-always">
                <TmTopBar BrandTitle="Tempo"
                          TestIdPrefix="topbar-narrow-always"
                          ShowMenuButton="true"
                          CommandPaletteShortcut="Ctrl+K"
                          User="_narrowUser"
                          UserNameDisplay="TopBarUserNameDisplay.Always"
                          OnCommandPalette="() => _commandPaletteOpen = true" />
            </div>
        </div>

        <div>
            <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-2">UserNameDisplay="Never" — the avatar alone, at every width</p>
            <div class="border border-slate-200 dark:border-slate-700 rounded-lg" style="max-width: 24rem;" data-testid="topbar-narrow-never">
                <TmTopBar BrandTitle="Tempo"
                          TestIdPrefix="topbar-narrow-never"
                          ShowMenuButton="true"
                          CommandPaletteShortcut="Ctrl+K"
                          User="_narrowUser"
                          UserNameDisplay="TopBarUserNameDisplay.Never"
                          OnCommandPalette="() => _commandPaletteOpen = true" />
            </div>
        </div>
    </div>
</section>

<!-- Command Palette Section -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Command Palette</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Quick command search with keyboard shortcut (Ctrl+K)</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-300 rounded-full">Navigation</span>
    </div>
    
    <div class="showcase-card">
        <div class="flex items-center gap-4">
            <TmButton Variant="ButtonVariant.Primary" OnClick="() => _commandPaletteOpen = true" data-testid="open-command-palette">
                <TmIcon Name="search" class="mr-2" />
                Open Command Palette
            </TmButton>
            <span class="text-sm text-slate-500">or press <kbd class="px-2 py-1 bg-slate-100 dark:bg-slate-800 rounded border border-slate-300 dark:border-slate-600 font-mono text-xs">Ctrl+K</kbd></span>
        </div>
        
        <div class="mt-4 p-4 bg-slate-50 dark:bg-slate-800 rounded-lg">
            <p class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Available Commands:</p>
            <div class="flex flex-wrap gap-2">
                @foreach (var cmd in _availableActions.Take(6))
                {
                    <TmBadge Variant="BadgeVariant.Default">@cmd.Title</TmBadge>
                }
                @if (_availableActions.Count > 6)
                {
                    <TmBadge Variant="BadgeVariant.Info">+@(_availableActions.Count - 6) more</TmBadge>
                }
            </div>
        </div>
        
        @if (!string.IsNullOrEmpty(_lastCommand))
        {
            <div class="mt-4 p-3 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg">
                <p class="text-sm text-green-800 dark:text-green-200">
                    Last executed: <strong>@_lastCommand</strong>
                </p>
            </div>
        }
    </div>
    
    <TmCommandPalette @bind-IsOpen="_commandPaletteOpen"
                      Actions="_availableActions" />

    @* Opt-in F8 surfaces: categories with a separator between them, one kbd per key. *@
    <div class="showcase-card mt-4" data-testid="command-palette-grouped-demo">
        <TmButton Variant="ButtonVariant.Secondary" OnClick="() => _groupedPaletteOpen = true"
                  data-testid="command-palette-grouped-open">
            Open grouped palette
        </TmButton>
        <TmCommandPalette @bind-IsOpen="_groupedPaletteOpen"
                          Actions="_groupedActions"
                          GroupByCategory="true"
                          SplitShortcuts="true" />
    </div>

    @* TG-010: entity search over a simulated server — an asynchronous SearchProvider with debounce
       and cancellation, a transient-failure toggle, sections by entity type (Category), badge +
       code chips and the keyboard-hint footer. Local commands render first; server results follow. *@
    <div class="showcase-card mt-4" data-testid="command-palette-entity-demo">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
            <div>
                <h3 class="text-base font-semibold text-slate-900 dark:text-white">Entity search</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400">
                    Server-side search with debounce, cancellation, transient failures and sections — the PromptHelper
                    "search entities by type + commands" scenario built directly on TmCommandPalette.
                </p>
            </div>
            <label class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-300"
                   data-testid="entity-fail-toggle">
                <input type="checkbox" @bind="_entityRandomFailures" />
                Simulate random failures
            </label>
            <label class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-300"
                   data-testid="entity-bulk-toggle">
                <input type="checkbox" @bind="_entityIncludeBulk" />
                Include 200 bulk rows
            </label>
        </div>
        <TmButton Variant="ButtonVariant.Secondary" OnClick="() => _entityPaletteOpen = true"
                  data-testid="command-palette-entity-open">
            Open entity search
        </TmButton>
    </div>

    <TmCommandPalette @bind-IsOpen="_entityPaletteOpen"
                      Actions="_entityLocalActions"
                      SearchProvider="SearchEntitiesAsync"
                      GroupByCategory="true"
                      ShowFooter="true"
                      HighlightMatches="true"
                      MinChars="0"
                      EmptyTemplate="EntityEmptyTemplate"
                      data-testid="command-palette-entity" />
</section>

<!-- Combined Layout Demo -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Combined Layout</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">All layout components working together</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300 rounded-full">Demo</span>
    </div>
    
    <div class="showcase-card p-0 overflow-hidden" style="height: 400px;">
        <div class="h-full flex">
            <!-- Mini Sidebar -->
            <div class="w-16 bg-slate-900 dark:bg-slate-950 flex flex-col items-center py-4 gap-4 border-r border-slate-800">
                <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center text-white font-bold">T</div>
                <div class="w-10 h-10 rounded-lg bg-blue-600/20 flex items-center justify-center text-blue-400 cursor-pointer">
                    <TmIcon Name="home" />
                </div>
                <div class="w-10 h-10 rounded-lg hover:bg-slate-800 flex items-center justify-center text-slate-400 cursor-pointer">
                    <TmIcon Name="users" />
                </div>
                <div class="w-10 h-10 rounded-lg hover:bg-slate-800 flex items-center justify-center text-slate-400 cursor-pointer">
                    <TmIcon Name="settings" />
                </div>
            </div>
            
            <!-- Content Area -->
            <div class="flex-1 flex flex-col bg-slate-50 dark:bg-slate-900">
                <!-- Mini TopBar -->
                <div class="h-14 bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between px-4">
                    <div class="flex items-center gap-4">
                        <TmBreadcrumbs Items="_demoBreadcrumbs" />
                    </div>
                    <div class="flex items-center gap-2">
                        <TmButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Icon="search" OnClick="() => _commandPaletteOpen = true" />
                        <TmButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Icon="bell" />
                        <TmAvatar Name="John Doe" Size="AvatarSize.Sm" />
                    </div>
                </div>
                
                <!-- Page Content -->
                <div class="flex-1 p-6">
                    <div class="grid grid-cols-3 gap-4">
                        <TmCard Header="Card 1" class="h-32">
                            <p class="text-sm text-slate-500">Sample content</p>
                        </TmCard>
                        <TmCard Header="Card 2" class="h-32">
                            <p class="text-sm text-slate-500">Sample content</p>
                        </TmCard>
                        <TmCard Header="Card 3" class="h-32">
                            <p class="text-sm text-slate-500">Sample content</p>
                        </TmCard>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- TmSection Demo -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Section</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Collapsible content sections with header actions</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-indigo-100 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 rounded-full">Layout</span>
    </div>
    
    <div class="showcase-card space-y-4">
        <TmSection Title="Basic Section" Icon="info">
            <p class="text-slate-600 dark:text-slate-400 text-sm">
                This is a basic section with a title and icon. Sections help organize content into logical groups.
            </p>
        </TmSection>
        
        <TmSection Title="Collapsible Section" Icon="folder" Collapsible="true" @bind-Collapsed="_sectionCollapsed">
            <p class="text-slate-600 dark:text-slate-400 text-sm">
                This section can be collapsed by clicking the header. The collapsed state is two-way bound.
            </p>
            <div class="mt-4 p-3 bg-slate-50 dark:bg-slate-800 rounded">
                <p class="text-xs text-slate-500">State: @(_sectionCollapsed ? "Collapsed" : "Expanded")</p>
            </div>
        </TmSection>
        
        <TmSection Title="With Header Actions" Icon="settings" Collapsible="true">
            <HeaderActions>
                <TmButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Icon="edit" OnClick="OnEditClick" />
                <TmButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Icon="trash-2" OnClick="OnDeleteClick" />
            </HeaderActions>
            <ChildContent>
                <p class="text-slate-600 dark:text-slate-400 text-sm">
                    Sections can include action buttons in the header for quick access to common operations.
                </p>
            </ChildContent>
        </TmSection>
        
        <TmSection Title="Nested Sections" Icon="layers">
            <div class="space-y-3">
                <TmSection Title="Inner Section 1" Collapsible="true" Class="border border-slate-200 dark:border-slate-700 rounded">
                    <p class="text-sm text-slate-600 dark:text-slate-400">Nested content here...</p>
                </TmSection>
                <TmSection Title="Inner Section 2" Collapsible="true" Class="border border-slate-200 dark:border-slate-700 rounded">
                    <p class="text-sm text-slate-600 dark:text-slate-400">More nested content...</p>
                </TmSection>
            </div>
        </TmSection>
    </div>
</section>

<!-- Keyboard Shortcuts Help Demo -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Keyboard Shortcuts Help</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Overlay displaying available keyboard shortcuts</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-teal-100 dark:bg-teal-900/30 text-teal-700 dark:text-teal-300 rounded-full">Accessibility</span>
    </div>
    
    <div class="showcase-card">
        <div class="flex items-center gap-4">
            <TmButton Variant="ButtonVariant.Primary" OnClick="() => _shortcutsVisible = true">
                <TmIcon Name="keyboard" class="mr-2" />
                Show Keyboard Shortcuts
            </TmButton>
            <span class="text-sm text-slate-500">or press <kbd class="px-2 py-1 bg-slate-100 dark:bg-slate-800 rounded border border-slate-300 dark:border-slate-600 font-mono text-xs">?</kbd></span>
        </div>
        
        <div class="mt-4 p-4 bg-slate-50 dark:bg-slate-800 rounded-lg">
            <p class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Demo Shortcuts Available:</p>
            <div class="flex flex-wrap gap-2">
                <TmBadge Variant="BadgeVariant.Default">Ctrl+S (Save)</TmBadge>
                <TmBadge Variant="BadgeVariant.Default">Ctrl+K (Command)</TmBadge>
                <TmBadge Variant="BadgeVariant.Default">Ctrl+F (Find)</TmBadge>
                <TmBadge Variant="BadgeVariant.Default">Esc (Close)</TmBadge>
            </div>
        </div>
    </div>
    
    <TmKeyboardShortcutsHelp 
        IsVisible="_shortcutsVisible"
        OnClose="() => _shortcutsVisible = false"
        Categories="_shortcutCategories" />

    @* Opt-in F8 surface: a subtitle and a key pair that is not a chord. *@
    <div class="showcase-card mt-4" data-testid="shortcuts-described-demo">
        <TmButton Variant="ButtonVariant.Secondary" OnClick="() => _describedShortcutsVisible = true"
                  data-testid="shortcuts-described-open">
            Open described shortcuts
        </TmButton>
        <TmKeyboardShortcutsHelp IsVisible="_describedShortcutsVisible"
                                 OnClose="() => _describedShortcutsVisible = false"
                                 Description="Shortcuts work with an external keyboard"
                                 Categories="_describedShortcutCategories" />
    </div>
</section>

@code {
    private bool _sidebarCollapsed = false;
    private bool _sectionedSidebarCollapsed = false;
    private bool _topBarMenuExpanded = false;
    private string? _lastAccountAction;
    private readonly IUserInfo _topBarUser = new DemoUser("Markéta Dvořáková", "marketa@example.com");
    private readonly IUserInfo _narrowUser = new DemoUser("Ing. Markéta Dvořáková-Křivánková, Ph.D.", "marketa.dvorakova-krivankova@example.com");

    private List<UserMenuItem> _userMenuItems = new();

    private List<SidebarNavSection> _sidebarSections = new()
    {
        new("Workspace", new List<ISidebarNavItem>
        {
            new SidebarNavItem("nav-layout", "Layout", "layout", "/layout"),
            new SidebarNavItem("nav-tables", "Data tables", "table", "/datatable"),
