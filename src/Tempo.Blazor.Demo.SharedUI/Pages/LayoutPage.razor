    private RenderFragment<string> EntityEmptyTemplate => query => builder =>
        builder.AddContent(0, $"No entities match \"{query}\". Try UC-042, decision or invoice.");

    /// <summary>The simulated entity server: a fixed delay (the component cancels it when the query
    /// changes), an optional transient failure (random, and always for a query containing "fail"), and a title/description/code filter.</summary>
    private async Task<CommandPaletteSearchResult> SearchEntitiesAsync(string query, CancellationToken cancellationToken)
    {
        await Task.Delay(600, cancellationToken);

        if (_entityRandomFailures && (query.Contains("fail", StringComparison.OrdinalIgnoreCase) || Random.Shared.NextDouble() < 0.35))
        {
            return CommandPaletteSearchResult.Failed;
        }

        var matches = _entityCatalog.Where(a =>
            a.Title.Contains(query, StringComparison.OrdinalIgnoreCase)
            || (a.Description?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
            || (a.Code?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false));

        var items = matches.ToList();
        if (_entityIncludeBulk)
        {
            items.AddRange(_entityBulk.Where(a =>
                a.Title.Contains(query, StringComparison.OrdinalIgnoreCase)
                || (a.Code?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)));
        }

        return items.Count == 0 ? CommandPaletteSearchResult.NoResults : CommandPaletteSearchResult.Found(items);
    }

