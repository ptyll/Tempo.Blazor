@page "/ai-conversation"
@using System.Runtime.CompilerServices
@using Tempo.Blazor.AI.Models
@using Tempo.Blazor.AI.Services
@using Tempo.Blazor.Components.AI
@inject ITmLocalizer Loc
@inject TimeProvider Clock

<PageTitle>@Loc["TmDemo_AiConversation_Title"] - Tempo.Blazor</PageTitle>

@* Demo-only chrome of this page. The conversation surface itself is styled by the package; these rules
   only frame it (the card, the state list, the hostile-markdown caption) with the library's own tokens, so
   the frame follows the light/dark theme without a second palette. *@
<style>
    .ai-demo-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--tm-space-3);
    }

    .ai-demo-button {
        padding: var(--tm-space-2) var(--tm-space-4);
        min-block-size: 2.75rem;
        border: var(--tm-border-width) solid var(--tm-border-color);
        border-radius: var(--tm-radius-md);
        background: var(--tm-bg-surface);
        color: var(--tm-text-primary);
        font-size: var(--tm-font-size-sm);
        font-weight: var(--tm-font-weight-medium);
        cursor: pointer;
    }

    .ai-demo-button:hover {
        border-color: var(--tm-color-primary);
        color: var(--tm-color-primary);
    }

    /* The pressed state must be visible, but its pair is contrast-gated: --tm-color-primary ink over
       --tm-color-primary-subtle is 4.75:1 in light, only 4.40:1 in dark (the subtle tint is a 15%
       wash), so the tint stays out. The pressed read is the 2px primary border plus the primary ink
       over the untouched surface — 5.17:1 light and 5.75:1 dark. */
    .ai-demo-button[aria-pressed="true"] {
        border: 2px solid var(--tm-color-primary);
        background: var(--tm-bg-surface);
        color: var(--tm-color-primary);
    }

    .ai-demo-button:focus-visible {
        /* The box shadow is the visible ring, the transparent outline is its fallback: Windows High Contrast
           strips box shadows, so without an outline the reset button has no focus indicator there at all
           (WCAG 2.4.7). The forced-colors block below repaints the outline in the system's colour. */
        outline: 2px solid transparent;
        outline-offset: 2px;
        box-shadow: var(--tm-focus-ring);
    }

    .ai-demo-hint,
    .ai-demo-submission,
    .ai-demo-note {
        margin: 0;
        color: var(--tm-text-secondary);
        font-size: var(--tm-font-size-sm);
    }

    .ai-demo-submission,
    .ai-demo-note {
        margin-block-start: var(--tm-space-3);
        overflow-wrap: anywhere;
    }

    .ai-demo-conversation {
        border: var(--tm-border-width) solid var(--tm-border-color);
        border-radius: var(--tm-radius-lg);
        background: var(--tm-bg-surface);
        /* Visible on purpose: overflow:hidden would make this host the sticky containing
           block, so the narrow composer could not pin to the viewport (Fáze 10 G). */
        overflow: visible;
    }

    .ai-demo-status {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
        gap: var(--tm-space-3);
        margin: var(--tm-space-3) 0 0;
        padding: var(--tm-space-3);
        border: var(--tm-border-width) dashed var(--tm-border-color);
        border-radius: var(--tm-radius-md);
        font-size: var(--tm-font-size-sm);
    }

    .ai-demo-status__item dt {
        color: var(--tm-text-secondary);
    }

    .ai-demo-status__item dd {
        margin: 0;
        font-weight: var(--tm-font-weight-semibold);
    }

    /* The demo layout keeps a sticky header; without a scroll margin an element screenshot (or an in-page
       anchor) parks the section heading underneath it. */
    .ai-demo-anchor {
        scroll-margin-block-start: 5.5rem;
    }

    .ai-demo-subheading {
        margin: 0 0 var(--tm-space-1);
        font-size: var(--tm-font-size-base);
        font-weight: var(--tm-font-weight-semibold);
        color: var(--tm-text-primary);
    }

    /* High Contrast forces every colour to a system value, and a transparent outline is not exempt: without
       this rule the ring above stays invisible where it is the ONLY focus indicator. */
    @@media (forced-colors: active) {
        .ai-demo-button:focus-visible {
            outline-color: Highlight;
        }

        /* The pressed read is the system Highlight colour (Chrome's forced colors keep a 2px author
           border width, so the border stays the stronger of the two signals). */
        .ai-demo-button[aria-pressed="true"] {
            border-color: Highlight;
            color: Highlight;
        }

        /* A disabled demo button asks for the system disabled ink explicitly: GrayText on both the ink
           and the border, at full opacity — a dim over a system colour would only lower the contrast the
           mode itself guarantees (the same rule the AI package carries for its own disabled controls). */
        .ai-demo-button:disabled {
            color: GrayText;
            border-color: GrayText;
            opacity: 1;
        }
    }
</style>

<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">
        @Loc["TmDemo_AiConversation_Title"]
    </h1>
    <p class="text-slate-600 dark:text-slate-400">
        @Loc["TmDemo_AiConversation_Intro"]
    </p>
</div>

@* ── The conversation itself ─────────────────────────────────────────────────────────────── *@
<section class="demo-section ai-demo-anchor" data-testid="ai-conversation-demo">
    <div class="flex flex-wrap items-center gap-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">
            @Loc["TmDemo_AiConversation_ConversationHeading"]
        </h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">
            @Loc["TmDemo_AiConversation_StreamingBadge"]
        </span>
    </div>

    <div class="showcase-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            @Loc["TmDemo_AiConversation_ConversationIntro"]
        </p>

        <div class="ai-demo-actions mb-3">
            <button type="button"
                    class="ai-demo-button"
                    data-testid="ai-demo-reset"
                    @onclick="ResetAsync">
                @Loc["TmDemo_AiConversation_NewConversation"]
            </button>
            <span class="ai-demo-hint">@Loc["TmDemo_AiConversation_KeyboardHint"]</span>
        </div>

        @* The host-driven controls live ON the conversation's card (above the transcript): a host-driven
           window is a property of THIS conversation, not a separate surface. aria-disabled instead of the
           native attribute keeps the button reachable while the window is open — the handler guards a
           second start anyway. *@
        <h3 class="ai-demo-subheading">@Loc["TmDemo_AiConversation_HostDrivenHeading"]</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">
            @Loc["TmDemo_AiConversation_HostDrivenIntro"]
        </p>
        <div class="ai-demo-actions mb-3">
            <button type="button"
                    class="ai-demo-button"
                    data-testid="ai-demo-simulate-busy"
                    aria-disabled="@(_isGenerating ? "true" : "false")"
                    @onclick="SimulateHostDrivenAnswerAsync">
                @Loc["TmDemo_AiConversation_SimulateBusy"]
            </button>
            @* The host channel of the transcript: a note spoken through AnnounceAsync — useful outside
               a window (an idle note) and inside the simulated one (the note the window edge clears
               when the next window opens). *@
            <button type="button"
                    class="ai-demo-button"
                    data-testid="ai-demo-announce"
                    @onclick="AnnounceHostNoteAsync">
                @Loc["TmDemo_AiConversation_Announce"]
            </button>
            @if (_messages.Count > 0)
            {
                <button type="button"
                        class="ai-demo-button"
                        data-testid="ai-demo-scroll-first"
                        @onclick="ScrollToFirstTurnAsync">
                    @Loc["TmDemo_AiConversation_ScrollToFirst"]
                </button>
            }
        </div>

        <div class="ai-demo-conversation" data-testid="ai-demo-conversation-host">
            @* The page owns the per-turn template, so the pending placeholder rides the template's
               PendingText — a host with its own MessageTemplate passes PendingText itself; the
               conversation-level MessagePendingText pass-through is for hosts WITHOUT a template (the
               placeholder shows while a turn is Pending with no parts). Generating binds the page's own
               busy flag: the streamed answers announce their completion inside StreamAsync, so the
               Generating edge stays silent (never two announcements for one answer). OnStop is the
               host-driven stop path: the built-in pill raises it ONCE per window, and the page cancels
               the window's own delay, marks the answer Stopped and closes the flag. *@
            <TmAiConversation @ref="_conversation"
                              Messages="_messages"
                              Generating="_isGenerating"
                              Suggestions="_suggestions"
                              SuggestionsLayout="AiSuggestionsLayout.Auto"
                              OnSuggestion="SendPromptAsync"
                              OnStop="StopHostDrivenGenerationAsync"
                              Height="34rem">
                <MessageTemplate Context="message">
                    @* The host owns the per-turn actions: the built-in TmAiMessage renders the content and the
                       page attaches regenerate (with versions), feedback, answer retry and tool-call retry to an
                       ASSISTANT turn. A user turn gets only the shared behaviours — regenerating or rating the
                       reader's own prompt is not an action that exists. *@
                    @if (message.Role == AiMessageRole.Assistant)
                    {
                        <TmAiMessage Message="message"
                                     PendingText="@Loc["TmDemo_AiConversation_PendingText"]"
                                     OnRegenerate="() => RegenerateAsync(message)"
                                     OnFeedback="feedback => HandleFeedbackAsync(message, feedback)"
                                     OnRetry="() => RetryAnswerAsync(message)"
                                     OnToolCallRetry="call => RetryToolCallAsync(message, call)"
                                     OnCitationClick="HandleCitationClickAsync"
                                     OnFollowUp="SendPromptAsync"
                                     ActiveVersionIndexChanged="index => SetActiveVersion(message, index)" />
                    }
                    else
                    {
                        <TmAiMessage Message="message"
                                     PendingText="@Loc["TmDemo_AiConversation_PendingText"]"
                                     OnCitationClick="HandleCitationClickAsync" />
                    }
                </MessageTemplate>
            </TmAiConversation>

            <TmAiComposer @bind-Text="_draft"
                          IsGenerating="_isGenerating"
                          OnSubmit="SubmitAsync"
                          OnStop="StopGenerationAsync"
                          Commands="_commands.Items"
                          MentionProvider="_mentions"
                          Models="_models"
                          @bind-SelectedModel="_model"
                          MaxAttachments="3"
                          MaxFileSize="@(2 * 1024 * 1024)"
                          Placeholder="@Loc["TmDemo_AiConversation_ComposerPlaceholder"]" />
        </div>

        <p class="ai-demo-submission" data-testid="ai-demo-submission">
            @string.Format(
                Loc["TmDemo_AiConversation_Submission"],
                _lastSubmission.Text,
                _lastSubmission.Model ?? Loc["TmDemo_AiConversation_None"],
                _lastSubmission.Attachments,
                _lastSubmission.Mentions,
                _lastSubmission.Command ?? Loc["TmDemo_AiConversation_None"])
        </p>

        <dl class="ai-demo-status" data-testid="ai-demo-status" aria-label="@Loc["TmDemo_AiConversation_StatusHeading"]">
            <div class="ai-demo-status__item">
                <dt>@Loc["TmDemo_AiConversation_MessageCount"]</dt>
                <dd data-testid="ai-demo-message-count">@_messages.Count</dd>
            </div>
            <div class="ai-demo-status__item">
                <dt>@Loc["TmDemo_AiConversation_VersionCount"]</dt>
                <dd data-testid="ai-demo-version-count">@VersionCount</dd>
            </div>
            <div class="ai-demo-status__item">
                <dt>@Loc["TmDemo_AiConversation_FeedbackLabel"]</dt>
                <dd data-testid="ai-demo-feedback">@FeedbackText</dd>
            </div>
            <div class="ai-demo-status__item">
                <dt>@Loc["TmDemo_AiConversation_ToolRetries"]</dt>
                <dd data-testid="ai-demo-tool-retries">@_toolCallRetries</dd>
            </div>
            <div class="ai-demo-status__item">
                <dt>@Loc["TmDemo_AiConversation_CitationLabel"]</dt>
                <dd data-testid="ai-demo-citation">@(_lastCitation ?? Loc["TmDemo_AiConversation_None"])</dd>
            </div>
            <div class="ai-demo-status__item">
                <dt>@Loc["TmDemo_AiConversation_LastRetry"]</dt>
                <dd data-testid="ai-demo-last-retry">@(_lastRetry ?? Loc["TmDemo_AiConversation_None"])</dd>
            </div>
            <div class="ai-demo-status__item">
                <dt>@Loc["TmDemo_AiConversation_BusyWindow"]</dt>
                <dd data-testid="ai-demo-busy-window">@(_isGenerating ? Loc["TmDemo_AiConversation_Busy"] : Loc["TmDemo_AiConversation_Idle"])</dd>
            </div>
            <div class="ai-demo-status__item">
                <dt>@Loc["TmDemo_AiConversation_HostNotes"]</dt>
                <dd data-testid="ai-demo-host-notes">@_hostNotesInTranscript</dd>
            </div>
        </dl>
    </div>
</section>

@* ── The agent's permission request ─────────────────────────────────────────────────────── *@
<PermissionRequestDemoSection />

@* ── The standalone components ──────────────────────────────────────────────────────────── *@
<section class="demo-section ai-demo-anchor" data-testid="ai-standalone-components">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-4">
        @Loc["TmDemo_AiConversation_StandaloneHeading"]
    </h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        @Loc["TmDemo_AiConversation_StandaloneIntro"]
    </p>

    <div class="showcase-card" data-testid="ai-tool-call-states">
        <h3 class="ai-demo-subheading">@Loc["TmDemo_AiConversation_ToolCallStatesHeading"]</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">
            @Loc["TmDemo_AiConversation_ToolCallStatesIntro"]
        </p>
        @foreach (var call in AiConversationPageSamples.ToolCallStates)
        {
            <TmToolCallCard @key="call.Id"
                            ToolCall="call"
                            OnRetry="() => RetrySampleCallAsync(call)" />
        }
        <TmToolCallGroup ToolCalls="AiConversationPageSamples.ToolCallRun"
                         OnRetry="RetrySampleCallAsync" />
    </div>

    <div class="showcase-card mt-4" data-testid="ai-thinking-demo">
        <h3 class="ai-demo-subheading">@Loc["TmDemo_AiConversation_ThinkingHeading"]</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">
            @Loc["TmDemo_AiConversation_ThinkingIntro"]
        </p>
        <div class="flex flex-wrap items-center gap-3">
            <TmThinkingIndicator Phase="@Loc["TmDemo_AiConversation_ThinkingPhaseRunning"]" />
            <TmThinkingIndicator Phase="@Loc["TmDemo_AiConversation_ThinkingPhaseDone"]" Completed="true" />
        </div>
    </div>

    <div class="showcase-card mt-4" data-testid="ai-pending-demo">
        <h3 class="ai-demo-subheading">@Loc["TmDemo_AiConversation_PendingHeading"]</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">
            @Loc["TmDemo_AiConversation_PendingIntro"]
        </p>
        @* Its own test id: the transcript selectors ([data-testid='ai-message'], usually scoped to
           .tm-ai-conversation, but the bUnit page tests also count them page-wide) must not see this
           standalone sample as a transcript turn. *@
        <TmAiMessage Message="_pendingSample"
                    PendingText="@Loc["TmDemo_AiConversation_PendingText"]"
                    DataTestId="ai-message-pending-sample" />
    </div>

    <div class="showcase-card mt-4" data-testid="ai-follow-ups-demo">
        <h3 class="ai-demo-subheading">@Loc["TmDemo_AiConversation_FollowUpsHeading"]</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">
            @Loc["TmDemo_AiConversation_FollowUpsIntro"]
        </p>
        <div class="ai-demo-actions mb-3">
            <button type="button"
                    class="ai-demo-button"
                    data-testid="ai-demo-follow-ups-toggle"
                    aria-pressed="@(_followUpsDisabled ? "true" : "false")"
                    @onclick="() => _followUpsDisabled = !_followUpsDisabled">
                @Loc["TmDemo_AiConversation_FollowUpsToggle"]
            </button>
        </div>
        @* Its own test id, like the pending sample: the transcript selectors must not see this standalone
           sample as a conversation turn. *@
        <TmAiMessage Message="_followUpsSample"
                     FollowUpsDisabled="_followUpsDisabled"
                     DataTestId="ai-message-follow-ups-sample" />
    </div>

    <div class="showcase-card mt-4" data-testid="ai-disabled-states-demo">
        <h3 class="ai-demo-subheading">@Loc["TmDemo_AiConversation_DisabledStatesHeading"]</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">
            @Loc["TmDemo_AiConversation_DisabledStatesIntro"]
        </p>
        <div class="ai-demo-actions mb-3">
            @* Nothing to reset while the sample is still failed (an in-flight retry included — the status
               flips only when the re-run completes) — the disabled state is honest. *@
            <button type="button"
                    class="ai-demo-button"
                    data-testid="ai-demo-retry-reset"
                    disabled="@(_retrySampleCall.Status == AiToolCallStatus.Failed)"
                    @onclick="ResetRetrySample">
                @Loc["TmDemo_AiConversation_DisabledStatesRetryReset"]
            </button>
            @* The count the E2E reads: a double activation during the in-flight window must leave it at
               one — the card's refusal guard is the single re-entry fuse. The label is ONE format key
               (translators own the word order); the number sits in its own span so a test can assert the
               exact value without parsing the sentence around it. *@
            <span class="ai-demo-note" data-testid="ai-demo-slow-retry-count">
                @RetryCountLabelPrefix<span data-testid="ai-demo-slow-retry-count-value">@_slowRetryCount</span>@RetryCountLabelSuffix
            </span>
        </div>
        @* The retry of this failed call stays in flight for a few seconds (the page's slow handler), so the
           disabled retry can be seen — and screenshotted — before the re-run turns the call succeeded. *@
        <TmToolCallCard ToolCall="_retrySampleCall" OnRetry="SlowRetrySampleCallAsync" />
        @* Its own test id, like the other standalone samples: the transcript selectors must not see this
           two-version turn as a conversation turn. Version 1 of 2 is on screen, so Previous is disabled. *@
        <TmAiMessage Message="_versionsSample"
                     DataTestId="ai-message-versions-sample" />
    </div>

    <div class="showcase-card mt-4" data-testid="ai-reasoning-demo">
        <h3 class="ai-demo-subheading">@Loc["TmDemo_AiConversation_ReasoningHeading"]</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">
            @Loc["TmDemo_AiConversation_ReasoningIntro"]
        </p>
        <TmReasoningPanel Reasoning="AiConversationPageSamples.Reasoning" />
        <TmReasoningPanel Reasoning="AiConversationPageSamples.Reasoning" DefaultExpanded="true" />
    </div>

    <div class="showcase-card mt-4" data-testid="ai-markdown-xss">
        <h3 class="ai-demo-subheading">@Loc["TmDemo_AiConversation_MarkdownHeading"]</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">
            @Loc["TmDemo_AiConversation_MarkdownIntro"]
        </p>
        <TmMarkdownView Markdown="@AiConversationPageSamples.HostileMarkdown"
                        OnCitationClick="HandleCitationClickAsync" />
        <p class="ai-demo-note" data-testid="ai-markdown-xss-note">
            @Loc["TmDemo_AiConversation_MarkdownSafeNote"]
        </p>
    </div>
</section>

@code {
    /// <summary>How long one simulated token chunk takes, so the stream is watchable and stoppable.</summary>
    private const int ChunkDelayMs = 40;

    private const int ChunkWordCount = 5;

    /// <summary>The blank line that separates two markdown blocks streamed into the same text part.</summary>
    private const string BlockSeparator = "\n\n";

    /// <summary>How long the host-driven simulation keeps the Generating window open. Long enough for a
    /// browser lane to catch the wait line after the click's first WASM render.</summary>
    private const int HostDrivenBusyMs = 2500;

    /// <summary>How long the disabled-states card keeps its retry in flight, so the disabled look can be
    /// seen (and screenshotted) before the re-run completes. Five seconds, not three: the fáze-4d focus
    /// spec reads the computed paint, re-activates the button three times and reads the focus back inside
    /// the SAME window, and a window that expires mid-sequence removes the button (focus falls to body)
    /// for reasons that have nothing to do with the component.</summary>
    private const int SlowRetryMs = 5000;

    /// <summary>
    /// Sample CONTENT of the simulated host-driven prompt — English on purpose, like every other sample
    /// answer of this page (the LABELS are the localized half). Tall on purpose: the answer has to
    /// overflow the 34rem transcript, or "scroll to the first turn" has nothing to climb back through.
    /// </summary>
    private const string HostDrivenPrompt = "What changed since the last run?";

    private const string HostDrivenAnswer =
        "The stream stayed green and two things changed: the retry budget moved from three attempts to "
        + "five, and the warm-up stage now runs before the first real request.\n\n"
        + "The rest of this answer is padding with a purpose: the transcript has to overflow, so the "
        + "scroll-to-first control demonstrates a real climb and the stick-to-bottom has a real bottom to "
        + "hold while the window is open.\n\n"
        + "| Area | Before | Now |\n"
        + "| --- | --- | --- |\n"
        + "| Retry budget | 3 attempts | 5 attempts |\n"
        + "| Warm-up stage | off | before the first request |\n"
        + "| Deploy windows | nightly | nightly (unchanged) |\n\n"
        + "The warm-up call the agent now issues before its first request:\n\n"
        + "```text\nGET /warmup?tenant=current\nAuthorization: Bearer <token>\n```\n\n"
        + "Nothing else moved — the API keys and the tenant quotas are the same as yesterday, and the "
        + "on-call rota kept its shape, so no further review is needed before the next release.";

    private readonly List<AiMessage> _messages = [];
    private readonly DemoMentionProvider _mentions = new();
    private readonly string[] _models = ["gpt-4o", "o3-mini", "tempo-local"];

    /// <summary>The static Pending turn of the standalone placeholder card (never streams).</summary>
    private readonly AiMessage _pendingSample = new()
    {
        Id = "pending-sample",
        Role = AiMessageRole.Assistant,
        Status = AiMessageStatus.Pending,
    };

    /// <summary>The static completed turn of the follow-up chips card (never streams). Built in
    /// <see cref="OnInitialized"/> because its text and chips resolve through the localizer.</summary>
    private AiMessage _followUpsSample = null!;

    /// <summary>Whether the follow-up chips card renders its chips disabled (the card's own toggle).</summary>
    private bool _followUpsDisabled;

    /// <summary>The failed call of the disabled-states card; its reset button recreates it from the samples.
    /// Built in <see cref="OnInitialized"/> because its timestamps come from the injected
    /// <see cref="TimeProvider"/> (property-injected after the constructor).</summary>
    private AiToolCall _retrySampleCall = null!;

    /// <summary>How many times the disabled-states card's slow retry actually fired. The E2E activates
    /// the in-flight retry a second time and asserts the count stays at one (the refusal guard).</summary>
    private int _slowRetryCount;

    /// <summary>The retry-count label is ONE localized format string with a <c>{0}</c> placeholder, so a
    /// translator owns the word order; the page splits it around the placeholder and renders the number
    /// into its own span (a test asserts the exact value, not the sentence).</summary>
    private (string Prefix, string Suffix) RetryCountLabel
    {
        get
        {
            var format = Loc["TmDemo_AiConversation_DisabledStatesRetryCount"];
            var placeholder = format.IndexOf("{0}", StringComparison.Ordinal);
            return placeholder < 0
                ? (format, string.Empty)
                : (format[..placeholder], format[(placeholder + 3)..]);
        }
    }

    private string RetryCountLabelPrefix => RetryCountLabel.Prefix;

    private string RetryCountLabelSuffix => RetryCountLabel.Suffix;

    /// <summary>The static two-version turn of the disabled-states card (version 1 of 2 on screen). Built in
    /// <see cref="OnInitialized"/> because its texts resolve through the localizer.</summary>
    private AiMessage _versionsSample = null!;

    private DemoSlashCommands _commands = null!;
    private IReadOnlyList<string> _suggestions = [];

    private TmAiConversation? _conversation;
    private string? _draft;
    private string? _model = "gpt-4o";
    private bool _isGenerating;
    private int _generation;
    private int _toolCallRetries;
    private string? _lastCitation;
    private string? _lastRetry;
    private AiFeedback? _feedback;
    private LastSubmission _lastSubmission = LastSubmission.Empty;

    /// <summary>The cancellation of the host-driven window's own delay — what the stop path flips.</summary>
    private CancellationTokenSource? _hostDrivenCts;

    /// <summary>
    /// How many host notes the transcript holds right now — the page's mirror of the
    /// <c>[data-kind='host']</c> count a reader can compare with the visible transcript. It follows
    /// the component's own bookkeeping: every <see cref="TmAiConversation.AnnounceAsync"/> call adds
    /// one, and the next generation re-owning the live region (a stream start or the
    /// <c>Generating</c> false→true edge) resets it to zero.
    /// </summary>
    private int _hostNotesInTranscript;

    /// <summary>The Pending answer of the open host-driven window; it is what a stop marks Stopped.</summary>
    private AiMessage? _hostDrivenAnswer;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        // The localizer is property-injected AFTER the constructor, so the localized demo data is built here.
        _suggestions =
        [
            Loc["TmDemo_AiConversation_Suggestion1"],
            Loc["TmDemo_AiConversation_Suggestion2"],
            Loc["TmDemo_AiConversation_Suggestion3"],
        ];

        _commands = new DemoSlashCommands(Loc);

        // The follow-up card's static sample localizes its answer text and its chips, so it is built
        // here with the rest of the localized demo data — not at field initialization.
        _followUpsSample = AiConversationPageSamples.FollowUpsSample(Loc);

        // The disabled-states card's two-version sample localizes its version texts the same way.
        _versionsSample = AiConversationPageSamples.VersionsSample(Loc);

        // The retry sample's timestamps come from the injected clock — the same one the slow handler
        // measures the re-run with — so a fake clock reads an honest elapsed time.
        _retrySampleCall = AiConversationPageSamples.RetryInFlightSample(Clock);
    }

    private int VersionCount => _messages.LastOrDefault(message => message.Role == AiMessageRole.Assistant)?.VersionCount ?? 0;

    private string FeedbackText => _feedback?.Rating switch
    {
        AiFeedbackRating.Positive => Loc["TmDemo_AiConversation_FeedbackPositive"],
        AiFeedbackRating.Negative => Loc["TmDemo_AiConversation_FeedbackNegative"],
        _ => Loc["TmDemo_AiConversation_FeedbackNone"],
    };

    // ── Prompt handling ────────────────────────────────────────────────────────────────────

    private async Task SendPromptAsync(string prompt)
    {
        if (_isGenerating || string.IsNullOrWhiteSpace(prompt))
        {
            return;
        }

        _messages.Add(new AiMessage(AiMessageRole.User, prompt.Trim()) { Status = AiMessageStatus.Completed });
        await StreamAnswerAsync();
    }

    private async Task SubmitAsync(AiComposerSubmit submit)
    {
        _lastSubmission = new LastSubmission(
            submit.Text,
            submit.Model,
            submit.Attachments.Count,
            submit.Mentions.Count,
            submit.Command?.Title);

        await SendPromptAsync(submit.Text);
    }

    private async Task StreamAnswerAsync()
    {
        var answer = new AiMessage
        {
            Role = AiMessageRole.Assistant,
            Status = AiMessageStatus.Pending,
            Model = _model,
        };

        _messages.Add(answer);
        _generation++;
        _isGenerating = true;
        // The stream start re-owns the host channel — the transcript's [data-kind='host'] notes are
        // gone with it, so the mirror counter restarts at zero.
        _hostNotesInTranscript = 0;
        _lastRetry = null;
        StateHasChanged();

        try
        {
            if (_conversation is not null)
            {
                await _conversation.StreamAsync(answer, GenerateDeltasAsync(_generation, answer));
            }
        }
        finally
        {
            _isGenerating = false;
            CompleteAnswer(answer);
            StateHasChanged();
        }
    }

    private async Task StopGenerationAsync()
    {
        if (_conversation is not null)
        {
            await _conversation.StopAsync();
        }
    }

    /// <summary>
    /// A host-driven generation the way EmusCz used to fake it with its own busy bookkeeping: the page
    /// opens NO stream — it appends a Pending turn, flips the <c>Generating</c> window on, produces the
    /// answer itself and flips the window off. The conversation owns the busy state, the wait line, the
    /// Stop notification and the one completion announcement. The wait runs on the INJECTED
    /// <see cref="TimeProvider"/> (so tests drive it with a fake clock) and carries a token the stop path
    /// cancels: the built-in pill raises <c>OnStop</c> once per window and this page honours it.
    /// </summary>
    private async Task SimulateHostDrivenAnswerAsync()
    {
        if (_isGenerating)
        {
            // aria-disabled keeps the control reachable while the window is open — the guard is the
            // actual "one window at a time" rule.
            return;
        }

        var answer = new AiMessage
        {
            Role = AiMessageRole.Assistant,
            Status = AiMessageStatus.Pending,
        };

        _messages.Add(new AiMessage(AiMessageRole.User, HostDrivenPrompt) { Status = AiMessageStatus.Completed });
        _messages.Add(answer);
        _isGenerating = true;
        // The window edge re-owns the host channel (the previous window's notes are cleared), so the
        // mirror counter restarts at zero with the window.
        _hostNotesInTranscript = 0;
        _hostDrivenAnswer = answer;

        var cts = new CancellationTokenSource();
        _hostDrivenCts = cts;
        StateHasChanged();

        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(HostDrivenBusyMs), Clock, cts.Token);
        }
        catch (OperationCanceledException)
        {
            // The stop path already flipped the state (the answer is Stopped, the window closed) and
            // rendered; this continuation only cleans up.
            return;
        }
        finally
        {
            if (ReferenceEquals(_hostDrivenCts, cts))
            {
                _hostDrivenCts = null;
            }

            cts.Dispose();
        }

        answer.Parts.Add(new AiTextPart(HostDrivenAnswer));
        answer.Status = AiMessageStatus.Completed;
        _hostDrivenAnswer = null;
        _isGenerating = false;
        StateHasChanged();
    }

    /// <summary>
    /// The <c>OnStop</c> handler of the conversation — the ONE stop of the host-driven window, raised by
    /// the built-in pill (or a host calling <see cref="TmAiConversation.StopAsync"/>). It cancels the
    /// window's delay, marks the answer <see cref="AiMessageStatus.Stopped"/> and closes the busy flag,
    /// exactly what a real host does to its own HTTP call.
    /// </summary>
    private Task StopHostDrivenGenerationAsync()
    {
        var cts = _hostDrivenCts;
        if (cts is null)
        {
            // A stop raised while a STREAM runs belongs to the stream (StopGenerationAsync's path); the
            // host-driven window has nothing to cancel.
            return Task.CompletedTask;
        }

        _hostDrivenCts = null;
        cts.Cancel();
        cts.Dispose();

        if (_hostDrivenAnswer is { Status: AiMessageStatus.Pending } answer)
        {
            answer.Status = AiMessageStatus.Stopped;
        }

        _hostDrivenAnswer = null;
        _isGenerating = false;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>The public scroll API: brings the transcript's first turn into view (no page scroll).</summary>
    private async Task ScrollToFirstTurnAsync()
    {
        if (_conversation is not null && _messages.Count > 0)
        {
            await _conversation.ScrollToMessageAsync(_messages[0].Id);
        }
    }

    /// <summary>
    /// The host channel of the transcript: speaks a note through <see cref="TmAiConversation.AnnounceAsync"/>
    /// — outside any window (an idle note that survives until the next generation) or inside the open
    /// host-driven window (a note the window edge clears when the next window opens).
    /// </summary>
    private async Task AnnounceHostNoteAsync()
    {
        if (_conversation is not null)
        {
            await _conversation.AnnounceAsync(Loc["TmDemo_AiConversation_HostAnnouncement"]);
            _hostNotesInTranscript++;
        }
    }

    private async Task RegenerateAsync(AiMessage message)
    {
        if (_isGenerating || message.Role != AiMessageRole.Assistant)
        {
            return;
        }

        // Archive the displayed generation, clear the live parts and stream the next one — the contract the
        // version switcher relies on (the live parts are ALWAYS the last version).
        message.Versions.Add(new AiMessageVersion(message.Parts));
        message.Parts.Clear();
        message.FollowUps.Clear();
        message.Error = null;
        message.Status = AiMessageStatus.Pending;
        message.Feedback = null;
        message.ActiveVersionIndex = message.VersionCount - 1;

        _isGenerating = true;
        _generation++;
        // The stream start re-owns the host channel — the transcript's [data-kind='host'] notes are
        // gone with it, so the mirror counter restarts at zero.
        _hostNotesInTranscript = 0;
        StateHasChanged();

        try
        {
            if (_conversation is not null)
            {
                await _conversation.StreamAsync(message, GenerateDeltasAsync(_generation, message));
            }
        }
        finally
        {
            _isGenerating = false;
            CompleteAnswer(message);
            StateHasChanged();
        }
    }

    /// <summary>What a host does once the answer finished: offer the follow-up questions of a completed turn.</summary>
    private void CompleteAnswer(AiMessage answer)
    {
        if (answer.Status != AiMessageStatus.Completed)
        {
            return;
        }

        foreach (var followUp in AiConversationPageSamples.FollowUps(Loc))
        {
            if (!answer.FollowUps.Contains(followUp))
            {
                answer.FollowUps.Add(followUp);
            }
        }
    }

    /// <summary>
    /// Retry of a FAILED answer. The demo's generator never fails an answer, so this exists to bind
    /// <c>TmAiMessage.OnRetry</c> (which renders the Retry control next to a failed turn) and routes it through
    /// the same archive-and-stream path as Regenerate.
    /// </summary>
    private Task RetryAnswerAsync(AiMessage message) => RegenerateAsync(message);

    private Task SetActiveVersion(AiMessage message, int index)
    {
        message.ActiveVersionIndex = index;
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleFeedbackAsync(AiMessage message, AiFeedback feedback)
    {
        message.Feedback = feedback;
        _feedback = feedback;
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleCitationClickAsync(string sourceId)
    {
        _lastCitation = AiConversationPageSamples.Sources
            .FirstOrDefault(source => string.Equals(source.Id, sourceId, StringComparison.Ordinal))?.Title
            ?? sourceId;
        return InvokeAsync(StateHasChanged);
    }

    private Task RetryToolCallAsync(AiMessage message, AiToolCall call)
    {
        call.Status = AiToolCallStatus.Succeeded;
        call.Error = null;
        call.ResultJson = """{"rows":3,"source":"usage-api"}""";
        call.CompletedAt = DateTimeOffset.UtcNow;
        _toolCallRetries++;
        _lastRetry = call.Name;
        return InvokeAsync(StateHasChanged);
    }

    private Task RetrySampleCallAsync(AiToolCall call)
    {
        call.Status = AiToolCallStatus.Succeeded;
        call.Error = null;
        call.ResultJson = """{"retried":true}""";
        call.CompletedAt ??= DateTimeOffset.UtcNow;
        _lastRetry = call.Name;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The disabled-states card's slow retry: the re-run takes a few seconds on the INJECTED
    /// <see cref="TimeProvider"/> (so tests drive it with a fake clock), which is exactly the window the
    /// card's Retry button spends disabled — the unified disabled look the card demonstrates.
    /// </summary>
    private async Task SlowRetrySampleCallAsync()
    {
        // Captured: a reset during the wait swaps the sample, and the in-flight re-run belongs to the
        // call that was clicked, not to its replacement.
        var call = _retrySampleCall;
        // Counted at the START of the handler: the E2E activates the retry twice during the in-flight
        // window and reads the count afterwards — a second fire would move it to two.
        _slowRetryCount++;
        // The re-run measures ITSELF on the injected clock: the start is the click, the end is the fake
        // clock running the delay out — a wall-clock timestamp would read as noise next to a fake clock.
        var started = Clock.GetUtcNow();
        await Task.Delay(TimeSpan.FromMilliseconds(SlowRetryMs), Clock);
        call.Status = AiToolCallStatus.Succeeded;
        call.Error = null;
        call.ResultJson = """{"retried":true}""";
        call.StartedAt = started;
        call.CompletedAt = Clock.GetUtcNow();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Restores the disabled-states card's failed sample, so the in-flight retry can be replayed.</summary>
    private Task ResetRetrySample()
    {
        _retrySampleCall = AiConversationPageSamples.RetryInFlightSample(Clock);
        _slowRetryCount = 0;
        return InvokeAsync(StateHasChanged);
    }

    private Task ResetAsync()
    {
        if (_hostDrivenCts is { } windowCts)
        {
            // A reset during an open host-driven window cancels the window without marking anything —
            // the list it would describe is being emptied.
            _hostDrivenCts = null;
            windowCts.Cancel();
            windowCts.Dispose();
        }

        _hostDrivenAnswer = null;
        _messages.Clear();
        _generation = 0;
        _toolCallRetries = 0;
        _lastCitation = null;
        _lastRetry = null;
        _feedback = null;
        _draft = null;
        _lastSubmission = LastSubmission.Empty;
        _hostNotesInTranscript = 0;
        return InvokeAsync(StateHasChanged);
    }

    // ── The simulated stream ──────────────────────────────────────────────────────────────

    /// <summary>
    /// A local stand-in for a model call: reasoning steps, one successful and one failing tool call, the
    /// answer blocks and the two cited sources, all delivered one delta at a time. The component applies each
    /// delta through <c>AiMessageStreamApplier</c>, so the demo exercises the real streaming path.
    /// </summary>
    private async IAsyncEnumerable<AiStreamDelta> GenerateDeltasAsync(
        int generation,
        AiMessage answer,
        [EnumeratorCancellation] CancellationToken cancellationToken = default)
    {
        var reasoningStartedAt = DateTimeOffset.UtcNow;
        foreach (var step in AiConversationPageSamples.ReasoningSteps)
        {
            await TickAsync(cancellationToken);
            yield return new AiReasoningDelta { Text = step, NewStep = true };
        }

        // The host reports how long the model reasoned — the panel then swaps its live "Thinking" summary for
        // what the thinking COST while the rest of the answer keeps streaming (the contract is the host's
        // number, never a guess by the component).
        if (answer.Parts.OfType<AiReasoningPart>().FirstOrDefault() is { DurationMs: null } reasoning)
        {
            reasoning.DurationMs = (DateTimeOffset.UtcNow - reasoningStartedAt).TotalMilliseconds;
        }

        // Call 1 — it succeeds, so its arguments and result sit behind the disclosure.
        var searchId = $"search-{generation}";
        await TickAsync(cancellationToken);
        yield return new AiToolCallStartedDelta
        {
            // A tool display name is the label of the card, so the host localizes it like every other label.
            ToolCall = new AiToolCall
            {
                Id = searchId,
                Name = "search_docs",
                DisplayName = Loc["TmDemo_AiConversation_Tool_SearchDocs"],
            },
        };
        await TickAsync(cancellationToken);
        yield return new AiToolCallUpdatedDelta
        {
            ToolCallId = searchId,
            ArgumentsJson = """{"query":"tempo.blazor ai conversation","top":3}""",
        };
        await TickAsync(cancellationToken);
        yield return new AiToolCallCompletedDelta
        {
            ToolCallId = searchId,
            Status = AiToolCallStatus.Succeeded,
            ResultJson = """{"hits":3,"took_ms":128}""",
        };

        foreach (var chunk in Chunk(AiConversationPageSamples.Intro(generation)))
        {
            await TickAsync(cancellationToken);
            yield return new AiTextDelta { Text = chunk };
        }

        // Blocks of ONE text part must stay separated by a blank line: a table glued to the list above it (or a
        // fence glued to the paragraph below it) stops being markdown.
        yield return new AiTextDelta { Text = BlockSeparator };

        foreach (var chunk in Chunk(AiConversationPageSamples.Table))
        {
            await TickAsync(cancellationToken);
            yield return new AiTextDelta { Text = chunk };
        }

        // Call 2 — it fails; the page's OnToolCallRetry turns it into a success without restarting the answer.
        var usageId = $"usage-{generation}";
        await TickAsync(cancellationToken);
        yield return new AiToolCallStartedDelta
        {
            ToolCall = new AiToolCall
            {
                Id = usageId,
                Name = "fetch_usage",
                DisplayName = Loc["TmDemo_AiConversation_Tool_FetchUsage"],
            },
        };
        await TickAsync(cancellationToken);
        yield return new AiToolCallUpdatedDelta
        {
            ToolCallId = usageId,
            ArgumentsJson = """{"url":"https://usage.example.com"}""",
            Status = AiToolCallStatus.Running,
        };
        await TickAsync(cancellationToken);
        yield return new AiToolCallCompletedDelta
        {
            ToolCallId = usageId,
            Status = AiToolCallStatus.Failed,
            Error = "HTTP 503 from usage.example.com",
        };

        foreach (var chunk in Chunk(AiConversationPageSamples.Code))
        {
            await TickAsync(cancellationToken);
            yield return new AiTextDelta { Text = chunk };
        }

        yield return new AiTextDelta { Text = BlockSeparator };

        foreach (var chunk in Chunk(AiConversationPageSamples.Closing))
        {
            await TickAsync(cancellationToken);
            yield return new AiTextDelta { Text = chunk };
        }

        // The sources arrive last, so their cards render under the answer and every chip resolves.
        foreach (var source in AiConversationPageSamples.Sources)
        {
            await TickAsync(cancellationToken);
            yield return new AiCitationAddedDelta { Source = source };
        }

        yield return new AiCompletedDelta();
    }

    private static Task TickAsync(CancellationToken cancellationToken)
        => Task.Delay(ChunkDelayMs, cancellationToken);

    /// <summary>
    /// Splits an answer block into small text deltas so the transcript visibly streams. The split is
    /// LOSSLESS: the separators between words are re-emitted at chunk boundaries too, otherwise two chunks
    /// concatenate into "awaitconversation" and the markdown stops parsing (a fence would never close).
    /// </summary>
    private static IEnumerable<string> Chunk(string text)
    {
        var words = text.Split(' ');
        var builder = new System.Text.StringBuilder();
        var inChunk = 0;
        for (var index = 0; index < words.Length; index++)
        {
            if (index > 0)
            {
                builder.Append(' ');
            }

            builder.Append(words[index]);
            inChunk++;

            if (inChunk >= ChunkWordCount && index < words.Length - 1)
            {
                yield return builder.ToString();
                builder.Clear();
                inChunk = 0;
            }
        }

        if (builder.Length > 0)
        {
            yield return builder.ToString();
        }
    }

    private sealed record LastSubmission(string Text, string? Model, int Attachments, int Mentions, string? Command)
    {
        internal static LastSubmission Empty { get; } = new(string.Empty, null, 0, 0, null);
    }

    /// <summary>The page's tiny mention index — three entities, searched in memory.</summary>
    private sealed class DemoMentionProvider : IAiMentionProvider
    {
        private static readonly AiMentionItem[] Items =
        [
            new() { Id = "doc-conversation", Label = "ai-conversation.md", Kind = "document", Icon = "file-text", Description = "docs/ai-conversation.md" },
            new() { Id = "doc-composer", Label = "ai-composer.md", Kind = "document", Icon = "file-text", Description = "docs/ai-composer.md" },
            new() { Id = "person-ada", Label = "Ada Lovelace", Kind = "user", Icon = "user", Description = "Maintainer" },
        ];

        public Task<IReadOnlyList<AiMentionItem>> SearchAsync(string query, CancellationToken cancellationToken = default)
        {
            var matches = string.IsNullOrWhiteSpace(query)
                ? Items
                : Items.Where(item => item.Label.Contains(query, StringComparison.OrdinalIgnoreCase)).ToArray();
            return Task.FromResult<IReadOnlyList<AiMentionItem>>(matches);
        }
    }

    /// <summary>The page's slash commands: three templates the composer offers after a "/".</summary>
    private sealed class DemoSlashCommands
    {
        internal DemoSlashCommands(ITmLocalizer loc)
        {
            // The ID is the stable token a host routes on. The TITLE is the label the "/" list shows (it is
            // also what the composer filters on), so it is localized with the description. The PROMPT is the
            // text that becomes the reader's draft — sample CONTENT of this demo, like the answer it produces,
            // so it stays in English.
            Items =
            [
                new AiSlashCommand
                {
                    Id = "summarise",
                    Title = loc["TmDemo_AiConversation_Cmd_Summarise"],
                    Description = loc["TmDemo_AiConversation_CommandSummarise"],
                    Prompt = "Summarise this conversation in five bullets:\n",
                },
                new AiSlashCommand
                {
                    Id = "translate",
                    Title = loc["TmDemo_AiConversation_Cmd_Translate"],
                    Description = loc["TmDemo_AiConversation_CommandTranslate"],
                    Prompt = "Translate the last answer into Czech:\n",
                },
                new AiSlashCommand
                {
                    Id = "metrics",
                    Title = loc["TmDemo_AiConversation_Cmd_Metrics"],
                    Description = loc["TmDemo_AiConversation_CommandMetrics"],
                    Prompt = "Show the latency metrics as a table:\n",
                },
            ];
        }

        internal IReadOnlyList<AiSlashCommand> Items { get; }
    }
