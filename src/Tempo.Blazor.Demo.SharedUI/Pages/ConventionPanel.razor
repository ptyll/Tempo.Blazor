@using Tempo.Blazor.Abstractions.Layout
@using Tempo.Blazor.Components.Layout

@* One component, two hosts. The tiles restack by the container's width; the note changes by the
   resolved layout mode, which is what a component branches its render on. *@
<TmLayoutObserver LayoutMode="LayoutMode"
                  LayoutModeChanged="LayoutModeChanged"
                  data-testid="rc-panel">
    <ConventionPanelBody />
</TmLayoutObserver>

@code {
    /// <summary>The layout to render. <see cref="TmLayoutMode.Auto"/> measures the container.</summary>
    [Parameter] public TmLayoutMode LayoutMode { get; set; } = TmLayoutMode.Auto;

    /// <summary>Raised when the measured layout changes.</summary>
    [Parameter] public EventCallback<TmLayoutMode> LayoutModeChanged { get; set; }
}
