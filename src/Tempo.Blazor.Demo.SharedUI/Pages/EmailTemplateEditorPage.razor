@page "/email-templates/edit/{Id:guid}"
@using Tempo.Blazor.Abstractions.Layout
@using Tempo.Blazor.EmailTemplates.Abstractions.Import
@inject IEmailTemplateApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Edit template</PageTitle>

<div class="tm-demo-email-editor-page" data-tm-email-editor-page
     data-tm-demo-resolved="@_resolvedLayout">
    @* Review fix (fáze 8, item 9): on a phone the demo's own switch bar ate ~300 px of the stage, so the
       sheet's default snap showed the tabs and the search box and the first block tile sat below the fold.
       The controls move into a collapsed disclosure there and the editor takes the rest of the viewport
       (`.tm-demo-email-editor-page[data-tm-demo-resolved="Mobile"]`); the docked layouts keep the full bar. *@
    @if (IsPhoneLayout)
    {
        <details class="tm-demo-email-editor-page__controls" data-tm-demo-controls>
            <summary>Demo controls</summary>
            <div class="tm-demo-email-editor-page__bar" data-tm-demo-bar>@DemoControls</div>
        </details>
    }
    else
    {
        <div class="tm-demo-email-editor-page__bar" data-tm-demo-bar>@DemoControls</div>
    }

    @if (_loading)
    {
        <TmSpinner />
    }
    else if (_document is null)
    {
        <TmEmptyState Icon="alert-triangle" Title="Template not found" />
    }
    else
    {
        <div class="tm-demo-email-editor-page__editor">
            <TmEmailTemplateEditor @ref="_editor"
                                   Document="_document"
                                   DocumentChanged="OnDocumentChangedAsync"
                                   OnSave="SaveAsync"
                                   IsDirtyChanged="OnIsDirtyChanged"
                                   ReadOnly="_readOnly"
                                   AutoSave="_autoSave"
                                   ImageUpload="_imageUpload"
                                   Variables="_variables"
                                   LayoutMode="_layoutMode"
                                   ItemEditingMode="_itemEditingMode"
                                   ImportOptions="_importOptions"
                                   CanvasImageLoading="_canvasImageLoading"
                                   MobilePanelPresentation="_presentation"
                                   ResolvedLayoutChanged="OnResolvedLayoutChanged" />
        </div>
    }
</div>

@code {
    /// <summary>The demo's own switches: the host save result, the forced layout, the mobile presentation.</summary>
    private RenderFragment DemoControls => @<text>
        <TmButton Variant="ButtonVariant.Ghost" Icon="arrow-left" OnClick="Back" data-tm-back>Back</TmButton>

        @* Fáze 7 demo: the editor owns the dirty flag and the save outcome, the host only reports results.
           These two controls exercise the paths a host has to handle — a read-only editor, and a save the
           host rejects (failed) or refuses as stale (conflict). *@
        <TmToggle Label="Read-only" Value="_readOnly" ValueChanged="OnReadOnlyChanged" data-tm-demo-readonly />
        <label class="tm-demo-email-editor-page__simulate">
            <span>Host save result</span>
            <select data-tm-demo-simulate @onchange="OnSimulationChanged">
                <option value="real">Call the API</option>
                <option value="failed">Simulate failure</option>
                <option value="failed-long">Simulate a long failure message</option>
                <option value="conflict">Simulate conflict</option>
            </select>
        </label>
        @* Fáze 9 demo: how the items of a social / navbar / carousel / accordion block are edited. Inline
           keeps every field in the inspector; Dialog edits one item at a time in a modal over a copy, which
           is the mode a touch host wants (the modal is a sheet on a phone). *@
        <label class="tm-demo-email-editor-page__simulate">
            <span>Item editing</span>
            <select data-tm-demo-item-mode @onchange="OnItemModeChanged">
                <option value="Inline">Inline</option>
                <option value="Dialog">Dialog</option>
            </select>
        </label>
        @* Fáze 9A demo: whether the WYSIWYG canvas may request the template's remote images from THIS
           browser. Load (default) is the faithful preview; Placeholder issues no request at all, which is
           what a host wants for an imported template that may carry a tracking pixel. *@
        <label class="tm-demo-email-editor-page__simulate">
            <span>Canvas images</span>
            <select data-tm-demo-canvas-images @onchange="OnCanvasImageLoadingChanged">
                <option value="Load">Load</option>
                <option value="Placeholder">Placeholder</option>
            </select>
        </label>
        @* Fáze 8 demo: force the editor's layout instead of resizing the browser. Auto lets the shell
           measure its own container (the production path); the other three pin a mode so the desktop /
           tablet / phone chrome can be reviewed side by side. *@
        <label class="tm-demo-email-editor-page__simulate">
            <span>Layout</span>
            <select data-tm-demo-layout @onchange="OnLayoutChanged">
                <option value="Auto">Auto (container)</option>
                <option value="Desktop">Desktop</option>
                <option value="Tablet">Tablet</option>
                <option value="Mobile">Mobile</option>
            </select>
        </label>
        @* EM3: Sheet is the mobile default (canvas + bottom sheet with Bloky | Vlastnosti), Tabs is the
           shell's alternative full-region Left | Canvas | Right tablist. *@
        <label class="tm-demo-email-editor-page__simulate">
            <span>Mobile panels</span>
            <select data-tm-demo-presentation @onchange="OnPresentationChanged">
                <option value="Sheet">Sheet</option>
                <option value="Tabs">Tabs</option>
            </select>
        </label>
        @* Fáze 10 demo: the import limits belong to the HOST (EmailImportOptions). Default is the contract
           5 MB; "1 kB" exists so the too-large-input path can be exercised without a 6 MB file. *@
        <label class="tm-demo-email-editor-page__simulate">
            <span>Import limit</span>
            <select data-tm-demo-import-limit @onchange="OnImportLimitChanged">
                <option value="default">5 MB (default)</option>
                <option value="1024">1 kB</option>
                <option value="0">Unlimited</option>
            </select>
        </label>
        @* The editor's own badge already reports the save state; this is the HOST's view of the same thing,
           i.e. what arrived through IsDirtyChanged — the guard/leave flow keys off exactly this flag. The
           wording stays plain ("unsaved changes yes/no") instead of naming the internal flag. *@
        <span class="tm-demo-email-editor-page__status" data-tm-demo-dirty="@(_isDirty ? "true" : "false")">
            Host: unsaved changes @(_isDirty ? "yes" : "no")
        </span>
        <span class="tm-demo-email-editor-page__status" data-tm-demo-resolved-layout="@_resolvedLayout">
            Layout: @_resolvedLayout
        </span>
    </text>;

    /// <summary>True while the editor resolved the PHONE layout: the demo folds its own chrome away there.</summary>
    private bool IsPhoneLayout => _resolvedLayout == TmLayoutMode.Mobile;

    /// <summary>The template id from the route.</summary>
    [Parameter] public Guid Id { get; set; }

    private TmEmailTemplateEditor? _editor;
    private EmailTemplateDocument? _document;
    private EmailTemplateDetailDto? _detail;
    private bool _loading = true;
    private bool _readOnly;
    private bool _isDirty;
    private string _simulation = "real";
    private bool _preferencesLoaded;
    private TmLayoutMode _layoutMode = TmLayoutMode.Auto;
    private EmailItemEditingMode _itemEditingMode = EmailItemEditingMode.Inline;
    private CanvasImageLoading _canvasImageLoading = CanvasImageLoading.Load;
    private MobilePanelPresentation _presentation = MobilePanelPresentation.Sheet;
    private TmLayoutMode _resolvedLayout = TmLayoutMode.Desktop;
    private readonly AutoSaveOptions _autoSave = new() { Enabled = true, Interval = TimeSpan.FromSeconds(3) };

    /// <summary>
    /// The host's variable catalogue (Fáze 7A): descriptions and groups are HOST metadata — the document only
    /// knows paths. The picker searches both and shows them next to the token, which is what makes the feature
    /// usable for someone who does not know the token by heart.
    /// </summary>
    private static readonly IReadOnlyList<TemplateVariableInfo> _variables =
    [
        new("user.first_name", VariableKind.Scalar) { Description = "First name of the user", Group = "User" },
        new("user.last_name", VariableKind.Scalar) { Description = "Last name of the user", Group = "User" },
        new("user.email", VariableKind.Scalar) { Description = "E-mail address of the user", Group = "User" },
        new("user.company", VariableKind.Scalar) { Description = "Company of the user", Group = "User" },
        new("user.roles", VariableKind.Collection) { Description = "Roles of the user", Group = "User" },
        new("order.number", VariableKind.Scalar) { Description = "Order number", Group = "Order" },
        new("order.total", VariableKind.Scalar) { Description = "Order total with currency", Group = "Order" },
        new("order.items", VariableKind.Collection) { Description = "Items of the order", Group = "Order" },
        new("order.due_date", VariableKind.Scalar) { Description = "Date the order is due", Group = "Order" },
        new("project.name", VariableKind.Scalar) { Description = "Name of the project", Group = "Project" },
        new("project.url", VariableKind.Scalar) { Description = "Link to the project", Group = "Project" },
        new("company.support_email", VariableKind.Scalar) { Description = "Support e-mail of the company", Group = "Company" },
    ];
    private readonly ImageUploadOptions _imageUpload = new() { Accept = "image/*", MaxBytes = 2 * 1024 * 1024 };

    /// <summary>
    /// The host's import limits (Fáze 10): null = the contract defaults (5 MB, 200 sections, 2000 blocks,
    /// nesting 8). The demo's switch can tighten <c>MaxInputBytes</c> so the limit path is reviewable.
    /// </summary>
    private EmailImportOptions? _importOptions;

    /// <summary>
    /// The demo remembers the reviewer's layout / presentation choice (localStorage), so an E2E that pins a
    /// mode keeps it across the re-navigations the flow performs (a language switch, a fresh seed template).
    /// </summary>
    protected override async Task OnInitializedAsync() => await LoadPreferencesAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A prerendered host cannot touch storage before the first interactive render: retry ONCE there.
        if (firstRender) await LoadPreferencesAsync();
    }

    private async Task LoadPreferencesAsync()
    {
        if (_preferencesLoaded) return;
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "tm-demo-editor-layout");
            if (Enum.TryParse<TmLayoutMode>(stored, out var layout) && layout != _layoutMode)
            {
                _layoutMode = layout;
                StateHasChanged();
            }

            var presentation = await JS.InvokeAsync<string?>("localStorage.getItem", "tm-demo-editor-presentation");
            if (Enum.TryParse<MobilePanelPresentation>(presentation, out var panels) && panels != _presentation)
            {
                _presentation = panels;
                StateHasChanged();
            }

            _preferencesLoaded = true;
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            // No storage yet (prerender) or none at all (private mode): retried after the first render, then
            // the switches simply start at their defaults.
        }
    }

    private async Task RememberAsync(string key, string value)
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", key, value);
        }
        catch (JSException)
        {
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _detail = await Api.GetAsync(Id);
        _document = _detail is null ? null : EmailTemplateSerializer.Deserialize(_detail.ContentJson);
        _loading = false;
    }

    /// <summary>
    /// The host side of the save contract (§3.2): answer with a real <see cref="EmailSaveResult"/> — never
    /// "saved" unless the API confirmed the write. The editor shows the dirty state and the outcome; the host
    /// owns the persistence and the revision/ETag. Wire <c>SaveAsync()</c> into
    /// <c>TmNavigationGuard.OnSaveAndLeave</c> for a leave-guard:
    /// <c>OnSaveAndLeave="@(async () => (await _editor!.SaveAsync()).IsSaved)"</c>.
    /// </summary>
    private async Task<EmailSaveResult> SaveAsync(EmailSaveRequest request)
    {
        if (_detail is null) return EmailSaveResult.Failed("The template is not loaded.");

        switch (_simulation)
        {
            case "failed":
                return EmailSaveResult.Failed("Simulated failure: the demo host did NOT save the template.");
            case "failed-long":
                // A realistic server reason (about 200 characters): the narrow-layout E2E proves the alert
                // wraps it and the Save button stays beside the badge.
                return EmailSaveResult.Failed(
                    "Simulated failure: the server rejected the template because the preheader is longer than "
                    + "the configured limit, the footer contains an unreachable image host, and the stored "
                    + "sample data no longer matches the current variable schema.");
            case "conflict":
                return EmailSaveResult.Conflict("Simulated conflict: someone else saved a newer revision.");
        }

        try
        {
            await Api.UpdateAsync(Id, new UpdateEmailTemplateRequest
            {
                Name = string.IsNullOrWhiteSpace(request.Document.Name) ? _detail.Name : request.Document.Name,
                Subject = request.Document.Subject,
                Preheader = request.Document.Preheader,
                Language = request.Document.Language,
                IsActive = _detail.IsActive,
                ContentJson = EmailTemplateSerializer.Serialize(request.Document),
                SampleDataJson = _detail.SampleDataJson,
            }, request.CancellationToken);

            return EmailSaveResult.Saved();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            return EmailSaveResult.Conflict(ex.Message);
        }
        catch (HttpRequestException ex)
        {
            return EmailSaveResult.Failed(ex.Message);
        }
    }

    private void OnReadOnlyChanged(bool value) => _readOnly = value;

    private void OnSimulationChanged(ChangeEventArgs e) => _simulation = e.Value?.ToString() ?? "real";

    private async Task OnPresentationChanged(ChangeEventArgs e)
    {
        _presentation = Enum.TryParse<MobilePanelPresentation>(e.Value?.ToString(), out var presentation)
            ? presentation
            : MobilePanelPresentation.Sheet;
        await RememberAsync("tm-demo-editor-presentation", _presentation.ToString());
    }

    /// <summary>Applies the demo's import limit; “Unlimited” raises the contract default rather than removing it.</summary>
    private void OnImportLimitChanged(ChangeEventArgs e)
        => _importOptions = e.Value?.ToString() switch
        {
            "1024" => new EmailImportOptions { MaxInputBytes = 1024 },
            "0" => new EmailImportOptions { MaxInputBytes = long.MaxValue },
            _ => null,
        };

    private void OnCanvasImageLoadingChanged(ChangeEventArgs e)
        => _canvasImageLoading = Enum.TryParse<CanvasImageLoading>(e.Value?.ToString(), out var mode)
            ? mode
            : CanvasImageLoading.Load;

    private void OnItemModeChanged(ChangeEventArgs e)
        => _itemEditingMode = Enum.TryParse<EmailItemEditingMode>(e.Value?.ToString(), out var mode)
            ? mode
            : EmailItemEditingMode.Inline;

    private async Task OnLayoutChanged(ChangeEventArgs e)
    {
        _layoutMode = Enum.TryParse<TmLayoutMode>(e.Value?.ToString(), out var mode) ? mode : TmLayoutMode.Auto;
        await RememberAsync("tm-demo-editor-layout", _layoutMode.ToString());
    }

    /// <summary>The layout the shell actually resolved — the demo shows it so a reviewer can see the decision.</summary>
    private void OnResolvedLayoutChanged(TmLayoutMode mode) => _resolvedLayout = mode;

    private void OnIsDirtyChanged(bool isDirty) => _isDirty = isDirty;

    private Task OnDocumentChangedAsync(EmailTemplateDocument document)
    {
        _document = document;
        return Task.CompletedTask;
    }

    private void Back() => Nav.NavigateTo("/email-templates");
}
