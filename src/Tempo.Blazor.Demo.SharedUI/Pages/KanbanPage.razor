@page "/kanban"
@using Tempo.Blazor.Components.DataDisplay

<PageTitle>Kanban Board – Tempo.Blazor</PageTitle>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Kanban Board</h1>
    <p class="text-slate-600 dark:text-slate-400">Drag-and-drop Kanban board with WIP limits, cross-column moves and in-column reordering.</p>
</div>

<section class="demo-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-1">Reorderable board</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        Drag a card onto another card to drop it above or below, or into a different column. A drop indicator shows
        the exact insertion point, and the new order is persisted into the sample data. The collapse button in each
        column header narrows the column to a strip that still shows its title, count and WIP badge — and still catches
        a card dropped on it (appended to the end), so a wide board stays readable. Click anywhere on a collapsed
        column to expand it again.
    </p>

    <TmKanbanBoard TItem="TaskItem"
                   Columns="_columns"
                   Items="_tasks"
                   ColumnSelector="t => t.Status"
                   CardTemplate="RenderCard"
                   ColumnsCollapsible="true"
                   OnCardClick="HandleCardClick"
                   OnItemMoved="HandleItemMoved"
                   OnItemReordered="HandleItemReordered" />

    @if (_clickedTask is not null)
    {
        <p class="mt-4 text-sm text-slate-600 dark:text-slate-400">
            Clicked: <strong>@_clickedTask.Title</strong> (Priority: @_clickedTask.Priority)
        </p>
    }
    @if (_lastMove is not null)
    {
        <p class="text-sm text-slate-600 dark:text-slate-400">
            Last change: <strong>@_lastMove</strong>
        </p>
    }
</section>

<section class="demo-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-1">Persisted order</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        This list reflects the live ordering of the underlying sample collection. Reorder cards above and watch the
        order below update — the board reports the target index and the item to insert before, so hosts can persist rank.
    </p>

    <div class="grid gap-4" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
        @foreach (var col in _columns)
        {
            <div class="rounded-lg border border-slate-200 dark:border-slate-700 p-3">
                <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-2">@col.Title</div>
                <ol class="list-decimal list-inside text-sm text-slate-700 dark:text-slate-300 space-y-1">
                    @foreach (var task in _tasks.Where(t => t.Status == col.Id))
                    {
                        <li>@task.Title</li>
                    }
                </ol>
            </div>
        }
    </div>
</section>

<section class="demo-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-1">Swimlanes (grouped by assignee)</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        The same board grouped into horizontal swimlanes by assignee. Column counts and WIP limits are board-level,
        each lane shows its own count, and lanes can be collapsed. Columns can be collapsed here too — the header cell
        and every lane cell of that column narrow together, so the grid stays aligned and the narrowed cell still accepts
        a drop. Drag a card into another lane to reassign it; unassigned cards fall into the trailing "No value" lane.
        A collapsed column keeps the same vertical strip in the shared header row, and clicking that header expands it.
    </p>

    <TmKanbanBoard TItem="TaskItem"
                   Columns="_columns"
                   Items="_swimTasks"
                   ColumnSelector="t => t.Status"
                   SwimlaneSelector="t => string.IsNullOrEmpty(t.Assignee) ? null : t.Assignee"
                   CardTemplate="RenderCard"
                   ColumnsCollapsible="true"
                   OnItemMoved="HandleSwimMove"
                   OnItemReordered="HandleSwimReorder" />

    @if (_lastSwimChange is not null)
    {
        <p class="mt-4 text-sm text-slate-600 dark:text-slate-400">
            Last change: <strong>@_lastSwimChange</strong>
        </p>
    }
</section>

<section class="demo-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-1">Virtualized columns (large card count)</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        With <code>VirtualizeCards="true"</code> each column body becomes a fixed-height scroll container that renders
        only the cards in view via Blazor's built-in <code>&lt;Virtualize&gt;</code>. This board holds
        <strong>@_manyTasks.Count</strong> cards spread across the columns, yet each column only materializes its
        visible window as you scroll. <code>CardItemSize</code> sets the estimated card row height.
    </p>

    <TmKanbanBoard TItem="TaskItem"
                   Columns="_virtualColumns"
                   Items="_manyTasks"
                   ColumnSelector="t => t.Status"
                   CardTemplate="RenderCard"
                   VirtualizeCards="true"
                   CardItemSize="92" />
</section>

@code {
    private record TaskItem(int Id, string Title, string Status, string Priority, string Assignee);

    private TaskItem? _clickedTask;
    private string? _lastMove;

    private static readonly RenderFragment<TaskItem> RenderCard = task => __builder =>
    {
        <div>
            <div class="font-medium text-sm">@task.Title</div>
            <div class="flex items-center gap-2 mt-1">
                <span class="text-xs px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300">@task.Priority</span>
                <span class="text-xs text-slate-500">@task.Assignee</span>
            </div>
        </div>
    };

    private static readonly IReadOnlyList<KanbanColumn> _columns =
    [
        new("backlog", "Backlog", "#6b7280"),
        new("todo", "To Do", "#3b82f6", MaxItems: 5),
        new("doing", "In Progress", "#f59e0b", MaxItems: 3),
        new("review", "Review", "#8b5cf6", MaxItems: 2),
        new("done", "Done", "#10b981"),
    ];

    private List<TaskItem> _tasks =
    [
        new(1, "Design login page", "backlog", "Medium", "Alice"),
        new(2, "Setup CI/CD pipeline", "backlog", "High", "Bob"),
        new(3, "Write API docs", "todo", "Low", "Charlie"),
        new(4, "Implement auth module", "todo", "High", "Alice"),
        new(5, "Code review PR #42", "doing", "High", "Bob"),
        new(6, "Fix navigation bug", "doing", "Critical", "Charlie"),
        new(7, "Update dependencies", "review", "Low", "Alice"),
        new(8, "Deploy v1.0", "done", "High", "Bob"),
        new(9, "User testing", "done", "Medium", "Charlie"),
    ];

    // ── Virtualized board demo (large card count) ──

    private static readonly IReadOnlyList<KanbanColumn> _virtualColumns =
    [
        new("backlog", "Backlog", "#6b7280"),
        new("todo", "To Do", "#3b82f6"),
        new("doing", "In Progress", "#f59e0b"),
        new("review", "Review", "#8b5cf6"),
        new("done", "Done", "#10b981"),
    ];

    private static readonly List<TaskItem> _manyTasks = BuildManyTasks();

    private static List<TaskItem> BuildManyTasks()
    {
        string[] statuses = ["backlog", "todo", "doing", "review", "done"];
        string[] priorities = ["Low", "Medium", "High", "Critical"];
        string[] assignees = ["Alice", "Bob", "Charlie", "Dana"];

        var list = new List<TaskItem>(800);
        for (var i = 1; i <= 800; i++)
        {
            list.Add(new TaskItem(
                10_000 + i,
                $"Card #{i}",
                statuses[i % statuses.Length],
                priorities[i % priorities.Length],
                assignees[i % assignees.Length]));
        }
        return list;
    }

    private void HandleCardClick(TaskItem task) => _clickedTask = task;

    private void HandleItemMoved(KanbanMoveEvent<TaskItem> move)
    {
        _lastMove = $"'{move.Item.Title}' moved from {move.FromColumn} to {move.ToColumn} at index {move.TargetIndex}";
        ApplyMove(move);
    }

    private void HandleItemReordered(KanbanMoveEvent<TaskItem> move)
    {
        _lastMove = $"'{move.Item.Title}' reordered within {move.ToColumn} to index {move.TargetIndex}";
        ApplyMove(move);
    }

    // Persist both the target column and the position, using TargetBeforeItem as the stable anchor.
    private void ApplyMove(KanbanMoveEvent<TaskItem> move)
    {
        var moved = move.Item with { Status = move.ToColumn };
        _tasks.RemoveAll(t => t.Id == move.Item.Id);

        int insertAt;
        if (move.TargetBeforeItem is not null)
        {
            insertAt = _tasks.FindIndex(t => t.Id == move.TargetBeforeItem.Id);
            if (insertAt < 0) insertAt = _tasks.Count;
        }
        else
        {
            // Dropped at the end of the target column: place after that column's last card.
            var lastInColumn = _tasks.FindLastIndex(t => t.Status == move.ToColumn);
            insertAt = lastInColumn >= 0 ? lastInColumn + 1 : _tasks.Count;
        }

        _tasks.Insert(insertAt, moved);
    }

    // ── Swimlanes demo (grouped by assignee) ──

    private string? _lastSwimChange;

    private List<TaskItem> _swimTasks =
    [
        new(1, "Design login page", "todo", "Medium", "Alice"),
        new(2, "Setup CI/CD pipeline", "doing", "High", "Bob"),
        new(3, "Write API docs", "todo", "Low", "Alice"),
        new(4, "Implement auth module", "doing", "High", "Bob"),
        new(5, "Triage inbox", "todo", "Low", ""),          // unassigned → "No value" lane
        new(6, "Deploy v1.0", "done", "High", "Alice"),
        new(7, "User testing", "done", "Medium", "Bob"),
    ];

    private void HandleSwimMove(KanbanMoveEvent<TaskItem> move)
    {
        var assignee = move.ToSwimlane ?? "";
        _lastSwimChange = $"'{move.Item.Title}' → column {move.ToColumn}, lane '{(string.IsNullOrEmpty(assignee) ? "No value" : assignee)}' (ToSwimlane={DescribeSwimlane(move.ToSwimlane)}, TargetIndex={move.TargetIndex})";
        ApplySwimMove(move, move.Item with { Status = move.ToColumn, Assignee = assignee });
    }

    private void HandleSwimReorder(KanbanMoveEvent<TaskItem> move)
    {
        _lastSwimChange = $"'{move.Item.Title}' reordered within {move.ToColumn}/{move.ToSwimlane ?? "No value"} (ToSwimlane={DescribeSwimlane(move.ToSwimlane)}, TargetIndex={move.TargetIndex})";
        ApplySwimMove(move, move.Item);
    }

    // The "Last change" line reports ToSwimlane too; the trailing "no value" lane arrives as null.
    private static string DescribeSwimlane(string? swimlane) => swimlane is null ? "null" : $"\"{swimlane}\"";

    private void ApplySwimMove(KanbanMoveEvent<TaskItem> move, TaskItem moved)
    {
        _swimTasks.RemoveAll(t => t.Id == move.Item.Id);

        int insertAt;
        if (move.TargetBeforeItem is not null)
        {
            insertAt = _swimTasks.FindIndex(t => t.Id == move.TargetBeforeItem.Id);
            if (insertAt < 0) insertAt = _swimTasks.Count;
        }
        else
        {
            insertAt = _swimTasks.Count;
        }

        _swimTasks.Insert(insertAt, moved);
    }
}
