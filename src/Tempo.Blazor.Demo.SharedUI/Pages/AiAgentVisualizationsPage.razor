@page "/ai-agent-visualizations"
@using System.Globalization
@using Tempo.Blazor.AI.Models
@using Tempo.Blazor.Components.AI

@* ONE simulated multi-agent run, rendered by every agent surface of Tempo.Blazor.AI at the same time. The page is
   the HOST: AiAgentRunLiveSurfaces owns the TimeProvider-driven simulator and repaints the three surfaces its data
   changes, while the ten decision surfaces below are the page's own store and stay untouched by a tick. *@
<PageTitle>@Loc["TmAiAgentVizDemo_PageTitle"] – Tempo.Blazor</PageTitle>

<div class="mb-8" data-testid="ai-viz-page-header">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentVizDemo_PageTitle"]</h1>
    <p class="text-slate-600 dark:text-slate-400">@Loc["TmAiAgentVizDemo_PageDescription"]</p>
    <div role="note"
         class="mt-3 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-700 dark:bg-amber-950/40 dark:text-amber-100"
         data-testid="ai-viz-demo-notice">
        @Loc["TmAiAgentVizDemo_DemoNotice"]
    </div>
</div>

<AiAgentRunLiveSurfaces />

@* ---------------------------------------------------------------------------------------------------------
   One task attempted three ways. The page's table presentation is the text alternative; the surface keeps the
   scored comparison and the confirmation. *@
<section class="demo-section mb-8" data-testid="ai-viz-attempts-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_ParallelTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">@Loc["TmAiAgentVizDemo_AttemptsHint"]</p>
    <div class="mb-3">
        <TmButton Variant="ButtonVariant.Secondary"
                  Class="min-h-11"
                  Size="ButtonSize.Sm"
                  data-testid="ai-viz-attempts-view"
                  OnClick="@(() => ToggleTextView("attempts"))">@TextViewLabel("attempts")</TmButton>
    </div>

    @if (IsTextView("attempts"))
    {
        <div data-testid="ai-viz-attempts-table">
            <p class="text-xs text-slate-500 dark:text-slate-400 mb-2">@Loc["TmAiAgentVizDemo_TableHelp"]</p>
            <table class="w-full text-left text-sm">
                <caption class="mb-2 text-left text-sm text-slate-600 dark:text-slate-400">@Loc["TmAiAgentVizDemo_AttemptsTableCaption"]</caption>
                <thead>
                    <tr>
                        <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColDraft"]</th>
                        <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColState"]</th>
                        <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColScore"]</th>
                        <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColVotes"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var attempt in Attempts)
                    {
                        <tr data-testid="ai-viz-attempts-row" data-attempt-id="@attempt.Id">
                            <th scope="row" class="py-1 font-normal">@attempt.Label</th>
                            <td class="py-1">@StatusText(attempt.Status)</td>
                            <td class="py-1">@attempt.Score?.ToString("0.00", CultureInfo.CurrentCulture)</td>
                            <td class="py-1">@attempt.VoteCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <TmParallelAttempts Attempts="Attempts"
                            BestAttemptId="_bestAttemptId"
                            @bind-SelectedAttemptId="_attemptWinnerId"
                            OnSelect="AcceptAttempt"
                            Title="@Loc["TmAiAgentsDemo_ParallelTitle"]"
                            Culture="@CultureInfo.CurrentCulture"
                            DataTestId="ai-viz-attempts">
            <ContentTemplate Context="attempt">
                @* The submitted body is host DATA, exactly like the votes' rationales. Its own ink and wash are
                   set in BOTH themes, so the block never depends on a global `pre` rule a host may not ship. *@
                <pre class="mb-0 whitespace-pre-wrap rounded border border-slate-200 bg-slate-50 p-2 text-xs text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
                     data-testid="ai-viz-attempt-body"
                     data-attempt-id="@attempt.Id">@AttemptBody(attempt.Id)</pre>
            </ContentTemplate>
        </TmParallelAttempts>
    }
</section>

@* ---------------------------------------------------------------------------------------------------------
   The same work passed from agent to agent. The chain owns its Chain/Table switch and the page owns the direction. *@
<section class="demo-section mb-8" data-testid="ai-viz-handoff-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_HandoffTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">@Loc["TmAiAgentVizDemo_HandoffHint"]</p>

    <div class="mb-3 flex flex-wrap items-center gap-3" data-testid="ai-viz-handoff-orientation">
        <TmSegmentedControl TValue="HandoffOrientation"
                            Size="SegmentedControlSize.Sm"
                            Label="@Loc["TmAiAgentsDemo_HandoffOrientationLabel"]"
                            Options="HandoffOrientationOptions"
                            Value="_handoffOrientation"
                            ValueChanged="OnHandoffOrientationChanged" />
    </div>

    <TmAgentHandoff Steps="HandoffSteps"
                    Orientation="_handoffOrientation"
                    Title="@Loc["TmAiAgentsDemo_HandoffTitle"]"
                    Culture="@CultureInfo.CurrentCulture"
                    DataTestId="ai-viz-handoff" />
</section>

@* ---------------------------------------------------------------------------------------------------------
   The models tried for one request and the chain the page would fall back through. The chain owns its Flow/Table
   switch; the page owns the mode, the policy and the chain. *@
<section class="demo-section mb-8" data-testid="ai-viz-fallback-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_FallbackTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">@Loc["TmAiAgentVizDemo_FallbackHint"]</p>

    <div class="mb-3 flex flex-wrap items-center gap-3">
        <div data-testid="ai-viz-fallback-mode">
            <TmSegmentedControl TValue="FallbackChainMode"
                                Size="SegmentedControlSize.Sm"
                                Label="@Loc["TmAiAgentsDemo_FallbackModeLabel"]"
                                Options="FallbackModeOptions"
                                Value="_fallbackMode"
                                ValueChanged="OnFallbackModeChanged" />
        </div>
        <p class="mb-0 text-sm text-slate-700 dark:text-slate-300" data-testid="ai-viz-fallback-log">@FallbackLog</p>
    </div>

    <TmFallbackChain Attempts="FallbackAttempts"
                     Mode="_fallbackMode"
                     @bind-ViewMode="_fallbackView"
                     Chain="FallbackChainEntries"
                     ChainChanged="OnFallbackChainChanged"
                     AvailableModels="Models"
                     Policy="_fallbackPolicy"
                     PolicyChanged="OnFallbackPolicyChanged"
                     Title="@Loc["TmAiAgentsDemo_FallbackTitle"]"
                     Culture="@CultureInfo.CurrentCulture"
                     DataTestId="ai-viz-fallback" />
</section>

@* ---------------------------------------------------------------------------------------------------------
   How much the agent may do on its own. The ceiling and the tenant's locks are host data: a change above the last
   grade asks first, and the dial's own keys (arrows, Home, End) are the keyboard path. *@
<section class="demo-section mb-8" data-testid="ai-viz-autonomy-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_AutonomyTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">@Loc["TmAiAgentVizDemo_AutonomyHint"]</p>

    <div class="mb-3 flex flex-wrap items-center gap-3">
        <div data-testid="ai-viz-autonomy-presentation">
            <TmSegmentedControl TValue="AutonomyDialPresentation"
                                Size="SegmentedControlSize.Sm"
                                Label="@Loc["TmAiAgentsDemo_AutonomyPresentationLabel"]"
                                Options="AutonomyPresentationOptions"
                                Value="_autonomyPresentation"
                                ValueChanged="OnAutonomyPresentationChanged" />
        </div>
        <p class="mb-0 text-sm text-slate-700 dark:text-slate-300" data-testid="ai-viz-autonomy-log">@AutonomyLog</p>
    </div>

    <TmAutonomyDial Levels="AutonomyLevels"
                    Value="_autonomyValue"
                    ValueChanged="OnAutonomyChanged"
                    Presentation="_autonomyPresentation"
                    Locks="AutonomyLocks"
                    MaxAllowed="2"
                    ConfirmAbove="2"
                    Title="@Loc["TmAiAgentsDemo_AutonomyTitle"]"
                    DataTestId="ai-viz-autonomy" />
</section>

@* ---------------------------------------------------------------------------------------------------------
   What the agent remembers: twenty facts over four categories. The page is the STORE, and the panel's undo window
   restores a row it never reported, so a forgotten fact is only gone when the window closes. *@
<section class="demo-section mb-8" data-testid="ai-viz-memory-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_MemoryTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">@Loc["TmAiAgentVizDemo_MemoryHint"]</p>
    <p class="text-sm text-slate-700 dark:text-slate-300 mb-3" data-testid="ai-viz-memory-log">@MemoryLog</p>

    <div class="mb-3">
        <TmButton Variant="ButtonVariant.Secondary"
                  Class="min-h-11"
                  Size="ButtonSize.Sm"
                  data-testid="ai-viz-memory-view"
                  OnClick="@(() => ToggleTextView("memory"))">@TextViewLabel("memory")</TmButton>
    </div>

    @if (IsTextView("memory"))
    {
        <div data-testid="ai-viz-memory-table">
            <p class="text-xs text-slate-500 dark:text-slate-400 mb-2">@Loc["TmAiAgentVizDemo_TableHelp"]</p>
            <table class="w-full text-left text-sm">
                <caption class="mb-2 text-left text-sm text-slate-600 dark:text-slate-400">@Loc["TmAiAgentVizDemo_MemoryTableCaption"]</caption>
                <thead>
                    <tr>
                        <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColCategory"]</th>
                        <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColMemory"]</th>
                        <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColState"]</th>
                        <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColConfidence"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var memory in _memories)
                    {
                        <tr data-testid="ai-viz-memory-row" data-item-id="@memory.Id">
                            <td class="py-1">@memory.Category</td>
                            <th scope="row" class="py-1 font-normal">@memory.Text</th>
                            <td class="py-1">@MemoryStatusText(memory.Status)</td>
                            <td class="py-1">@ConfidenceText(memory.Confidence)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <TmMemoryPanel Items="_memories"
                       Enabled="_memoryEnabled"
                       EnabledChanged="OnMemoryEnabledChanged"
                       FilterText="@_memoryFilter"
                       FilterTextChanged="OnMemoryFilterChanged"
                       StatusFilter="_memoryStatus"
                       StatusFilterChanged="OnMemoryStatusChanged"
                       CollapsedCategories="_collapsedCategories"
                       CollapsedCategoriesChanged="OnMemoryCollapsedChanged"
                       OnEdit="OnMemoryEdited"
                       OnPause="OnMemoryPaused"
                       OnResume="OnMemoryResumed"
                       OnForget="OnMemoryForgotten"
                       OnReview="OnMemoryReviewed"
                       OnBulkAction="OnMemoryBulk"
                       UndoWindow="TimeSpan.FromSeconds(10)"
                       Title="@Loc["TmAiAgentsDemo_MemoryTitle"]"
                       Culture="@CultureInfo.CurrentCulture"
                       DataTestId="ai-viz-memory" />
    }
</section>

@* ---------------------------------------------------------------------------------------------------------
   Handing work out: the board's drag has its Assign menu and the automatic pass as the tap and keyboard
   alternatives (WCAG 2.5.7). The page owns the tasks, so every reported move lands in its own list. *@
<section class="demo-section mb-8" data-testid="ai-viz-delegate-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_DelegateTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">@Loc["TmAiAgentVizDemo_DelegateHint"]</p>
    <p class="text-sm text-slate-700 dark:text-slate-300 mb-3" data-testid="ai-viz-delegate-log">@DelegateLog</p>

    <div class="mb-3">
        <TmButton Variant="ButtonVariant.Secondary"
                  Class="min-h-11"
                  Size="ButtonSize.Sm"
                  data-testid="ai-viz-delegate-view"
                  OnClick="@(() => ToggleTextView("delegate"))">@TextViewLabel("delegate")</TmButton>
    </div>

    @if (IsTextView("delegate"))
    {
        <div data-testid="ai-viz-delegate-table">
            <p class="text-xs text-slate-500 dark:text-slate-400 mb-2">@Loc["TmAiAgentVizDemo_TableHelp"]</p>
            <table class="w-full text-left text-sm">
                <caption class="mb-2 text-left text-sm text-slate-600 dark:text-slate-400">@Loc["TmAiAgentVizDemo_DelegateTableCaption"]</caption>
                <thead>
                    <tr>
                        <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColTask"]</th>
                        <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColPriority"]</th>
                        <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColEstimate"]</th>
                        <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColAgent"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in _delegateTasks)
                    {
                        <tr data-testid="ai-viz-delegate-row" data-task-id="@task.Id">
                            <th scope="row" class="py-1 font-normal">@task.Title</th>
                            <td class="py-1">@PriorityText(task.Priority)</td>
                            <td class="py-1">@EstimateText(task.EstimatedDuration)</td>
                            <td class="py-1">@AgentName(task.AssignedAgentId ?? string.Empty)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <TmDelegateBoard Tasks="_delegateTasks"
                          Agents="_delegateAgents"
                          AutoAssign="_delegateAuto"
                          AutoAssignChanged="OnDelegateAutoChanged"
                          OnAssign="OnDelegateAssigned"
                          OnUnassign="OnDelegateUnassigned"
                          Title="@Loc["TmAiAgentsDemo_DelegateTitle"]"
                          DataTestId="ai-viz-delegate" />
    }
</section>

@* ---------------------------------------------------------------------------------------------------------
   A week of scheduled runs. The surface's own Week/Day/Table switch is the text alternative; the page owns the
   supply, the runs and the move it applies. *@
<section class="demo-section mb-8" data-testid="ai-viz-runs-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_RunsTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">@Loc["TmAiAgentVizDemo_RunsHint"]</p>
    <p class="text-sm text-slate-700 dark:text-slate-300 mb-3" data-testid="ai-viz-runs-log">@RunsLog</p>

    <TmScheduledRuns Windows="_windows"
                     Runs="_runs"
                     ViewMode="_runsView"
                     ViewModeChanged="OnRunsViewChanged"
                     OnMove="OnRunMoved"
                     Title="@Loc["TmAiAgentsDemo_RunsTitle"]"
                     DataTestId="ai-viz-runs" />
</section>

@* ---------------------------------------------------------------------------------------------------------
   Three agents over twenty-five files with four real conflicts. The radar is a native table with a radio group per
   conflict; the page's text presentation lists every change and every decision. *@
<section class="demo-section mb-8" data-testid="ai-viz-conflict-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_ConflictTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">@Loc["TmAiAgentVizDemo_ConflictHint"]</p>
    <p class="text-sm text-slate-700 dark:text-slate-300 mb-3" data-testid="ai-viz-conflict-log">@ConflictLog</p>

    <div class="mb-3">
        <TmButton Variant="ButtonVariant.Secondary"
                  Class="min-h-11"
                  Size="ButtonSize.Sm"
                  data-testid="ai-viz-conflict-view"
                  OnClick="@(() => ToggleTextView("conflict"))">@TextViewLabel("conflict")</TmButton>
    </div>

    @if (IsTextView("conflict"))
    {
        <div data-testid="ai-viz-conflict-table">
            <p class="text-xs text-slate-500 dark:text-slate-400 mb-2">@Loc["TmAiAgentVizDemo_TableHelp"]</p>
            <table class="w-full text-left text-sm">
                <caption class="mb-2 text-left text-sm text-slate-600 dark:text-slate-400">@Loc["TmAiAgentVizDemo_ConflictTableCaption"]</caption>
                <thead>
                    <tr>
                        <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColFile"]</th>
                        <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColAgent"]</th>
                        <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColChange"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var branch in _branches)
                    {
                        @foreach (var change in branch.ChangedPaths)
                        {
                            <tr data-testid="ai-viz-conflict-row" data-path="@change.Path">
                                <th scope="row" class="py-1 font-normal">@ShortPath(change.Path)</th>
                                <td class="py-1">@branch.Agent.Name</td>
                                <td class="py-1">@ChangeText(change.Kind)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <ul class="mt-3 text-sm" data-testid="ai-viz-conflict-decisions">
                @foreach (var path in ConflictingPaths())
                {
                    <li data-testid="ai-viz-conflict-decision" data-path="@path">
                        @ShortPath(path): @ResolutionText(path)
                    </li>
                }
            </ul>
        </div>
    }
    else
    {
        <TmConflictRadar Agents="_branches"
                         Resolutions="_resolutions"
                         ResolutionsChanged="OnResolutionsChanged"
                         OnMerge="OnMerge"
                         @bind-ConflictOnly="_conflictOnly"
                         Title="@Loc["TmAiAgentsDemo_ConflictTitle"]"
                         DataTestId="ai-viz-conflict" />
    }
</section>

@* ---------------------------------------------------------------------------------------------------------
   Where the collaborators are. The page renders the document itself and its paragraphs carry the anchors; the
   overlay measures them. The roster is the text alternative the page offers for the cursors. *@
<section class="demo-section mb-8" data-testid="ai-viz-presence-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">@Loc["TmAiAgentsDemo_PresenceTitle"]</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">@Loc["TmAiAgentVizDemo_PresenceHint"]</p>

    <div class="mb-3">
        <TmButton Variant="ButtonVariant.Secondary"
                  Class="min-h-11"
                  Size="ButtonSize.Sm"
                  data-testid="ai-viz-presence-view"
                  OnClick="@(() => ToggleTextView("presence"))">@TextViewLabel("presence")</TmButton>
    </div>

    @if (IsTextView("presence"))
    {
        <div data-testid="ai-viz-presence-table">
            <p class="text-xs text-slate-500 dark:text-slate-400 mb-2">@Loc["TmAiAgentVizDemo_TableHelp"]</p>
            <table class="w-full text-left text-sm">
                <caption class="mb-2 text-left text-sm text-slate-600 dark:text-slate-400">@Loc["TmAiAgentVizDemo_PresenceTableCaption"]</caption>
                <thead>
                    <tr>
                        <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColAgent"]</th>
                        <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColRole"]</th>
                        <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColActivity"]</th>
                        <th scope="col" class="py-1">@Loc["TmAiAgentVizDemo_ColAnchor"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var marker in Markers)
                    {
                        <tr data-testid="ai-viz-presence-row" data-agent-id="@marker.Agent.Id">
                            <th scope="row" class="py-1 font-normal">@marker.Agent.Name</th>
                            <td class="py-1">@marker.Agent.Role</td>
                            <td class="py-1">@ActivityText(marker.Activity)</td>
                            <td class="py-1">@AnchorLabel(marker.AnchorId)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <TmAgentPresenceOverlay Markers="Markers"
                                ShowRoster="true"
                                RosterLabel="@Loc["TmAgentPresenceOverlay_RosterTitle"]"
                                DataTestId="ai-viz-presence">
            <div class="rounded-lg border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
                <h3 class="mb-3 text-base font-semibold text-slate-900 dark:text-white">
                    @Loc["TmAiAgentVizDemo_PresenceDocumentTitle"]
                </h3>
                <p class="mb-3 text-sm text-slate-700 dark:text-slate-300">
                    @Loc["TmAiAgentVizDemo_PresenceDocumentLead"]<span data-presence-anchor="plan-lead"></span>
                </p>
                <p class="mb-3 text-sm text-slate-700 dark:text-slate-300">
                    @Loc["TmAiAgentVizDemo_PresenceDocumentGoal"]<span data-presence-anchor="plan-goal"></span>
                </p>
                <p class="mb-3 text-sm text-slate-700 dark:text-slate-300">
                    @Loc["TmAiAgentVizDemo_PresenceDocumentRisk"]<span data-presence-anchor="plan-risk"></span>
                </p>
                <p class="text-sm text-slate-700 dark:text-slate-300">
                    @Loc["TmAiAgentVizDemo_PresenceDocumentClose"]<span data-presence-anchor="plan-close"></span>
                </p>
            </div>
        </TmAgentPresenceOverlay>
    }
</section>
