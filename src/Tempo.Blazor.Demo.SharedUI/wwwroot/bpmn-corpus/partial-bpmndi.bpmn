<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_PartialDi"
             name="Partial DI process"
             targetNamespace="http://tempo.example/bpmn/corpus/partial-di">
  <!-- Hand-authored (MIT): a process whose BPMNDI covers only SOME flow nodes and edges —
       Task_QA, EndEvent_Done and the Flow_2/Flow_Done edges carry no DI. The importer's
       partial-DI fill (design §5.4) must place the missing geometry without overlapping the
       stored DI bounding box. -->
  <process id="Process_PartialDi" name="Partial DI" isExecutable="false">
    <startEvent id="StartEvent_Partial" name="Started">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <task id="Task_Build" name="Build">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </task>
    <task id="Task_QA" name="QA">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_Done</outgoing>
    </task>
    <endEvent id="EndEvent_Done" name="Done">
      <incoming>Flow_Done</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="StartEvent_Partial" targetRef="Task_Build"/>
    <sequenceFlow id="Flow_2" sourceRef="Task_Build" targetRef="Task_QA"/>
    <sequenceFlow id="Flow_Done" sourceRef="Task_QA" targetRef="EndEvent_Done"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Partial" name="Partial DI">
    <bpmndi:BPMNPlane id="BPMNPlane_Partial" bpmnElement="Process_PartialDi">
      <bpmndi:BPMNShape id="StartEvent_Partial_di" bpmnElement="StartEvent_Partial">
        <dc:Bounds x="172" y="152" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Build_di" bpmnElement="Task_Build">
        <dc:Bounds x="260" y="130" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="208" y="170"/>
        <di:waypoint x="260" y="170"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
