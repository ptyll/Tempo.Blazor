    // collapse into "More" like any other and still open its panel (anchored to the ribbon row then).
    private RenderFragment TableInsertItem => @<TmToolbarItem Class="tm-document-editor__ribbon-item tm-document-editor__ribbon-item--popup"
                   Priority="@CorePriority("insertTable")"
                   Disabled="@(!IsCommandEnabled("insertTable"))"
                   MenuLabel="@Loc["TmDocumentEditor_InsertTable"]"
                   MenuIcon="table"
                   OnMenuInvoke="OpenTableFromMenu">
        <DocumentRibbonButton @ref="_tableButton"
                              Icon="table"
                              Text="@Loc["TmDocumentEditor_InsertTable"]"
                              Disabled="@(!IsCommandEnabled("insertTable"))"
                              Tooltip="@(GetEditingCommandTitle(Loc["TmDocumentEditor_InsertTable"]))"
                              OnClick="ToggleTableGridPicker"
                              Command="insertTable"
                              Large="@LargeActions"
                              TestId="@TestId("document-toolbar-table")"
                              aria-haspopup="dialog"
                              aria-controls="@(_tableGridPickerOpen ? FloatingPanelId("table") : null)"
                              aria-expanded="@_tableGridPickerOpen.ToString().ToLowerInvariant()" />
    </TmToolbarItem>;

    private RenderFragment ImageInsertItem => @<TmToolbarItem Class="tm-document-editor__ribbon-item tm-document-editor__ribbon-item--popup"
                   Priority="@CorePriority("insertImage")"
                   Disabled="@(!IsCommandEnabled("insertImage"))"
                   MenuLabel="@Loc["TmDocumentEditor_InsertImage"]"
                   MenuItems="@ImageMenuItems()">
        <DocumentRibbonButton @ref="_imageButton"
                              Icon="image"
                              Text="@Loc["TmDocumentEditor_InsertImage"]"
                              Disabled="@(!IsCommandEnabled("insertImage"))"
                              Tooltip="@(GetEditingCommandTitle(Loc["TmDocumentEditor_InsertImage"]))"
                              OnClick="InsertImageFromBarAsync"
                              Command="insertImage"
                              Large="@LargeActions"
                              TestId="@TestId("document-toolbar-image")"
                              aria-haspopup="dialog"
                              aria-expanded="@ImageIsOpen.ToString().ToLowerInvariant()" />
    </TmToolbarItem>;

    // A select that can leave the bar offers its options in "More" as one check-marked section: the same handler the native
    // <select> runs, fed a ChangeEventArgs. The current value is the checked entry (null: a mixed selection, nothing checked).
    private IReadOnlyList<TmActionItem> OptionMenu(
        IEnumerable<(string Value, string Label)> options,
        string? current,
        bool disabled,
        Func<ChangeEventArgs, Task> handler,
        bool showChecks = true)
    {
        var items = new List<TmActionItem>();
        foreach (var (value, label) in options)
        {
            var captured = value;
            items.Add(new TmActionItem
            {
                Id = string.IsNullOrEmpty(value) ? "default" : value,
                Label = label,
                Checked = showChecks ? string.Equals(current, value, StringComparison.Ordinal) : null,
                Disabled = disabled,
                OnClick = EventCallback.Factory.Create(this, () => handler(new ChangeEventArgs { Value = captured })),
            });
        }

        return items;
    }

    /// <summary>
    /// The block-style option the select / More list marks as current. The editor reports the style by its descriptor id
    /// (<c>normal</c>, <c>heading-1</c>) or by its option name (<c>Normal</c>, <c>Heading1</c>); the options are keyed by name,
    /// so an id that did not match any option left the select blank.
    /// </summary>
    private string SelectedBlockStyleValue
    {
        get
        {
            if (string.IsNullOrEmpty(CurrentBlockStyle))
            {
                return "Normal";
            }

            return ResolveStyleDescriptor(CurrentBlockStyle).Id switch
            {
                "normal" => "Normal",
                "title" => "Title",
                "heading-1" => "Heading1",
                "heading-2" => "Heading2",
                "heading-3" => "Heading3",
                "heading-4" => "Heading4",
                "heading-5" => "Heading5",
                "heading-6" => "Heading6",
                "quote" => "Quote",
                _ => CurrentBlockStyle,
            };
        }
    }

    private IReadOnlyList<TmActionItem> BlockStyleMenuItems()
    {
        var options = new List<(string, string)>();
        var current = SelectedBlockStyleValue;
        if (IsCurrentBlockStyleCustom)
        {
            options.Add((CurrentBlockStyle!, ResolveCurrentStyleName()));
        }

        options.Add(("Normal", Loc["TmDocumentEditor_StyleNormal"]));
        options.Add(("Title", Loc["TmDocumentEditor_StyleTitle"]));
        options.Add(("Heading1", Loc["TmDocumentEditor_Heading1"]));
        options.Add(("Heading2", Loc["TmDocumentEditor_Heading2"]));
        options.Add(("Heading3", Loc["TmDocumentEditor_Heading3"]));
        options.Add(("Heading4", Loc["TmDocumentEditor_Heading4"]));
        options.Add(("Heading5", Loc["TmDocumentEditor_Heading5"]));
        options.Add(("Heading6", Loc["TmDocumentEditor_Heading6"]));
        options.Add(("Quote", Loc["TmDocumentEditor_StyleQuote"]));
        return OptionMenu(options, current, ReadOnly, HandleBlockStyleChangedAsync);
    }

    private IReadOnlyList<TmActionItem> FontFamilyMenuItems()
    {
        var options = new List<(string, string)>();
        if (IsFontFamilyUnknown && !FontFamilyMixed)
        {
            options.Add((CurrentFontFamily!, FontFamilyLabel(CurrentFontFamily)));
        }

        options.Add((string.Empty, Loc["TmDocumentEditor_FontFamilyDefault"]));
        options.AddRange(FontFamilies.Select(font => (font.CssFamily, font.DisplayName)));
        return OptionMenu(options, FontFamilyMixed ? null : CurrentFontFamily ?? string.Empty, !IsCommandEnabled("fontFamily"), HandleFontFamilyChangedAsync);
    }

    // The More menu lists the common sizes only (the native select keeps the full list): fifteen entries made the menu taller than the
    // viewport. A current size outside the shortlist is added (and checked), so the list never hides where the selection is.
    private static readonly int[] MenuFontSizes = [8, 9, 10, 11, 12, 14, 18, 24, 36];

    private IReadOnlyList<TmActionItem> FontSizeMenuItems()
    {
        var current = FontSizeMixed ? null : NormalizeFontSizeValue(CurrentFontSize);
        var sizes = MenuFontSizes.Select(size => size.ToString(CultureInfo.InvariantCulture)).ToList();
        if (!string.IsNullOrEmpty(current) && !sizes.Contains(current))
        {
            sizes.Add(current);
            sizes = [.. sizes.OrderBy(size => double.TryParse(size, NumberStyles.Float, CultureInfo.InvariantCulture, out var n) ? n : double.MaxValue)];
        }

        return OptionMenu(sizes.Select(size => (size, $"{size} pt")), current, !IsCommandEnabled("fontSize"), HandleFontSizeChangedAsync);
    }

    private IReadOnlyList<TmActionItem> LineSpacingMenuItems()
        => OptionMenu(
            LineSpacingOptions.Select(spacing => (spacing.ToString("0.##", CultureInfo.InvariantCulture), spacing.ToString("0.##", CultureInfo.InvariantCulture))),
            NormalizeLineSpacingValue(GetEffectiveLineSpacing()),
            !IsCommandEnabled("lineSpacing"),
            HandleLineSpacingChangedAsync);

    private IReadOnlyList<TmActionItem> SpacingMenuItems(double current, bool mixed, string key, Func<ChangeEventArgs, Task> handler)
    {
        _ = key;
        return OptionMenu(
            ParagraphSpacingOptions.Select(spacing => (spacing.ToString(CultureInfo.InvariantCulture), spacing.ToString(CultureInfo.InvariantCulture))),
            mixed ? null : NormalizeParagraphSpacingValue(current),
            !IsCommandEnabled("lineSpacing"),
            handler);
    }

    private IReadOnlyList<TmActionItem> ChangeCaseMenuItems()
        => OptionMenu(
            [
                ("sentenceCase", Loc["TmDocumentEditor_CaseSentence"]),
                ("lowercase", Loc["TmDocumentEditor_CaseLowercase"]),
                ("uppercase", Loc["TmDocumentEditor_CaseUppercase"]),
                ("titleCase", Loc["TmDocumentEditor_CaseTitle"]),
                ("toggleCase", Loc["TmDocumentEditor_CaseToggle"]),
            ],
            current: null,
            disabled: !IsCommandEnabled("changeCase"),
