                                <span>@Loc["TmDocumentEditor_PageXOfY"]</span>
                            </button>
                            <button type="button" role="menuitem" data-testid="@TestId("document-header-footer-menu-date")" @onclick="() => InsertHeaderFooterFieldFromMenuAsync(OnInsertDateField)">
                                <TmIcon Name="calendar-days" Size="IconSize.Sm" />
                                <span>@Loc["TmDocumentEditor_FieldDate"]</span>
                            </button>
                            <button type="button" role="menuitem" data-testid="@TestId("document-header-footer-menu-title")" @onclick="() => InsertHeaderFooterFieldFromMenuAsync(OnInsertDocumentTitleField)">
                                <TmIcon Name="file-text" Size="IconSize.Sm" />
                                <span>@Loc["TmDocumentEditor_DocumentTitle"]</span>
                            </button>
                            <button type="button" role="menuitem" data-testid="@TestId("document-header-footer-menu-author")" @onclick="() => InsertHeaderFooterFieldFromMenuAsync(OnInsertAuthorField)">
                                <TmIcon Name="user" Size="IconSize.Sm" />
                                <span>@Loc["TmDocumentEditor_Author"]</span>
                            </button>
                        </div>
                    }
                </div>
                <div class="tm-document-header-footer-menu-wrapper">
                    <button class="@($"tm-document-editor__ribbon-button{(_headerFooterPresetMenuOpen ? " tm-document-editor__ribbon-button--active" : "")}")"
                            type="button"
                            disabled="@ReadOnly"
                            title="@Loc["TmDocumentEditor_HeaderFooterPresets"]"
                            aria-haspopup="menu"
                            aria-expanded="@_headerFooterPresetMenuOpen.ToString().ToLowerInvariant()"
                            @onclick="ToggleHeaderFooterPresetMenu"
                            @onmousedown:preventDefault="true"
                            data-command="headerFooterPresets"
                            data-testid="@TestId("document-header-footer-preset-menu")">
                        <TmIcon Name="layout-template" Size="IconSize.Sm" />
                        <span>@Loc["TmDocumentEditor_HeaderFooterPresets"]</span>
                    </button>
                    @if (_headerFooterPresetMenuOpen)
                    {
                        <div class="tm-document-header-footer-menu tm-document-header-footer-menu--presets"
                             role="menu"
                             aria-label="@Loc["TmDocumentEditor_HeaderFooterPresets"]"
                             data-testid="@TestId("document-header-footer-presets-menu")"
                             tabindex="-1"
                             @ref="_headerFooterPresetMenu"
                             @onkeydown="HandleHeaderFooterMenuKeyDown"
