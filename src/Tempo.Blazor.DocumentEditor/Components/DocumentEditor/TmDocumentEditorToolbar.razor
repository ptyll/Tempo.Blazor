                        data-testid="@TestId("document-header-footer-insert-page-number")">
                    <TmIcon Name="hash" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_PageNumber"]</span>
                </button>
                <button class="tm-document-editor__ribbon-button"
                        type="button"
                        disabled="@ReadOnly"
                        title="@Loc["TmDocumentEditor_InsertPageCount"]"
                        @onmousedown:preventDefault="true"
                        @onclick="OnInsertPageCount"
                        data-command="insertPageCount"
                        data-testid="@TestId("document-header-footer-insert-page-count")">
                    <TmIcon Name="files" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_TotalPages"]</span>
                </button>
                <button class="tm-document-editor__ribbon-button"
                        type="button"
                        disabled="@ReadOnly"
                        title="@Loc["TmDocumentEditor_InsertPageXOfY"]"
                        @onmousedown:preventDefault="true"
                        @onclick="OnInsertPageXOfY"
                        data-command="insertPageXOfY"
                        data-testid="@TestId("document-header-footer-insert-page-x-of-y")">
                    <TmIcon Name="file-stack" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_PageXOfY"]</span>
                </button>
                <button class="tm-document-editor__ribbon-button"
                        type="button"
                        disabled="@ReadOnly"
                        title="@Loc["TmDocumentEditor_InsertDateField"]"
                        @onmousedown:preventDefault="true"
                        @onclick="OnInsertDateField"
                        data-command="insertDateField"
                        data-testid="@TestId("document-header-footer-insert-date")">
                    <TmIcon Name="calendar-days" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_FieldDate"]</span>
                </button>
                <button class="tm-document-editor__ribbon-button"
                        type="button"
                        disabled="@ReadOnly"
                        title="@Loc["TmDocumentEditor_InsertDocumentTitleField"]"
                        @onmousedown:preventDefault="true"
                        @onclick="OnInsertDocumentTitleField"
                        data-command="insertDocumentTitleField"
                        data-testid="@TestId("document-header-footer-insert-title")">
                    <TmIcon Name="file-text" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_DocumentTitle"]</span>
                </button>
            </section>
            <section class="tm-document-editor__ribbon-group" aria-label="@Loc["TmDocumentEditor_TabHeaderFooter"]">
                <button class="tm-document-editor__ribbon-button"
                        type="button"
                        title="@Loc["TmDocumentEditor_CloseHeaderFooter"]"
                        @onclick="OnCloseHeaderFooter"
                        data-command="closeHeaderFooter"
                        data-testid="@TestId("document-close-header-footer")">
                    <TmIcon Name="x" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_CloseHeaderFooter"]</span>
                </button>
            </section>
        }
    </div>
    <TmDocumentToolbarOverflowMenu IsOverflowing="_isOverflowing"
                                   IsOpen="_overflowMenuOpen"
                                   ShowSearch="ShowOverflowSearch"
                                   SearchQuery="@_overflowSearchQuery"
                                   Groups="GetOverflowMenuGroups()"
                                   MoreLabel="@Loc["TmDocumentEditor_More"]"
                                   MoreCommandsLabel="@Loc["TmDocumentEditor_MoreCommands"]"
                                   SearchLabel="@Loc["Tm_Search"]"
                                   NoResultsLabel="@Loc["TmDocumentEditor_OverflowNoResults"]"
                                   OnToggle="ToggleOverflowMenu"
                                   OnMoreKeyDown="HandleMoreButtonKeyDown"
                                   OnSearchInput="HandleOverflowSearchInput"
                                   OnCommandRequested="ExecuteGuardedOverflowCommandAsync"
                                   OnMenuItemKeyDown="HandleOverflowMenuItemKeyDown" />
    </div>

    @if (_linkDialogOpen && !ReadOnly)
    {
        <section class="tm-document-editor__link-dialog"
                 role="dialog"
                 aria-modal="false"
                 aria-label="@Loc["TmDocumentEditor_Link"]"
                 data-testid="@TestId("document-link-dialog")"
                 @onkeydown="HandleLinkDialogKeyDown"
                 @onkeydown:stopPropagation="true">
            <label>
                <span>@Loc["TmDocumentEditor_LinkUrl"]</span>
                <input @ref="_linkUrlInput"
                       value="@_pendingLinkUrl"
                       @oninput="args => _pendingLinkUrl = args.Value?.ToString()"
                       data-testid="@TestId("document-link-url")" />
            </label>
            <label>
                <span>@Loc["TmDocumentEditor_LinkTitle"]</span>
                <input value="@_pendingLinkTitle" @oninput="args => _pendingLinkTitle = args.Value?.ToString()" data-testid="@TestId("document-link-title")" />
            </label>
            @if (!string.IsNullOrWhiteSpace(_linkError))
            {
                <span class="tm-document-editor__link-error" role="alert" data-testid="@TestId("document-link-error")">@_linkError</span>
            }
            <button type="button" @onclick="ApplyLinkAsync" data-testid="@TestId("document-apply-link")">@Loc["TmDocumentEditor_ApplyLink"]</button>
            @if (!string.IsNullOrWhiteSpace(_pendingLinkUrl) && OnLinkRemoved.HasDelegate)
            {
                <button type="button" @onclick="RemoveLinkAsync" data-testid="@TestId("document-remove-link")">@Loc["TmDocumentEditor_RemoveLink"]</button>
            }
            <button type="button" @onclick="CloseLinkDialog">@Loc["TmDocumentEditor_Cancel"]</button>
        </section>
    }
    @if (_docxImportOpen && CanImportDocx)
    {
        <section class="tm-document-editor__format-import-panel"
                 aria-label="@Loc["TmDocumentEditor_FormatImportPanelLabel"]"
                 data-testid="@TestId("document-import-docx-panel")">
            <TmFileDropZone Multiple="false"
                            MaxFileCount="1"
                            Accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                            Disabled="@IsImportingDocx"
                            Class="tm-document-editor__format-drop-zone"
                            InputTestId="document-import-docx"
                            InputAriaLabel="@Loc["TmDocumentEditor_ImportDocxDropZoneAria"]"
                            OnFilesSelected="HandleDocxImportSelectedAsync">
                <div class="tm-document-editor__format-drop-zone-content">
                    <TmIcon Name="upload" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_ImportDocxDropZone"]</span>
                </div>
            </TmFileDropZone>
        </section>
    }
</header>

