    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (_optimisticParagraphAlignment is not null
            && _optimisticParagraphAlignment.Value != ParagraphAlignment)
        {
            _optimisticParagraphAlignment = null;
        }

        if (_optimisticLineSpacing is not null
            && Math.Abs(_optimisticLineSpacing.Value - CurrentLineSpacing) > 0.001)
        {
            _optimisticLineSpacing = null;
        }

        if (ParagraphAlignmentMixed)
        {
            _optimisticParagraphAlignment = null;
        }

        if (LineSpacingMixed)
        {
            _optimisticLineSpacing = null;
        }

        if (ListMixed)
        {
            _optimisticBulletListActive = null;
            _optimisticNumberedListActive = null;
        }

        var styleDescriptor = ResolveStyleDescriptor(CurrentBlockStyle);
        if (!string.Equals(_styleRenameSourceId, styleDescriptor.Id, StringComparison.Ordinal))
        {
            _styleRenameSourceId = styleDescriptor.Id;
            _styleRenameValue = styleDescriptor.Name;
        }

        if (IsHeaderFooterMode && !_wasHeaderFooterMode)
        {
            _activeRibbonTab = DocumentRibbonTab.HeaderFooter;
        }
        else if (!IsHeaderFooterMode && _activeRibbonTab == DocumentRibbonTab.HeaderFooter)
        {
            _activeRibbonTab = DocumentRibbonTab.Home;
        }

        _wasHeaderFooterMode = IsHeaderFooterMode;
        // N9.2: Blazor does not consult ShouldRender for the initial render -- seed the signature
        // AFTER the state fix-ups above so the second render compares against the truly rendered state.
        _lastToolbarRenderSignature ??= ComputeRenderSignature();
    }

