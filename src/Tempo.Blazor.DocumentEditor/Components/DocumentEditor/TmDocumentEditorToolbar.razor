    private IReadOnlyList<TmActionItem> ReviewDisplayMenuItems()
        => OptionMenu(
            [
                (DocumentReviewDisplayMode.AllMarkup.ToString(), Loc["TmDocumentEditor_ReviewModeAllMarkup"]),
                (DocumentReviewDisplayMode.SimpleMarkup.ToString(), Loc["TmDocumentEditor_ReviewModeSimpleMarkup"]),
                (DocumentReviewDisplayMode.NoMarkup.ToString(), Loc["TmDocumentEditor_ReviewModeNoMarkup"]),
                (DocumentReviewDisplayMode.Original.ToString(), Loc["TmDocumentEditor_ReviewModeOriginal"]),
            ],
            ReviewDisplayMode.ToString(),
            !IsFeatureEnabled(DocumentEditorFeatureNames.TrackChanges) || !IsCommandEnabled("reviewDisplayMode", fallback: true),
            HandleReviewDisplayModeChanged);

    // ─── declared priority (the registry is the single source) ──────────────

    // The registry's rank - except on a phone, where the row has room for few commands. The core toolbar drops by COUNT: lowest rank first, among equals
    // the LATER control first, and it never backfills a gap with a smaller later control. The phone's Home row is B I U (the registry's Primary) + the
    // alignment menu and the bulleted list: every OTHER command that goes through here is Secondary on a phone, so it leaves first (the link, the comment,
    // the table and the image would otherwise sit after the list and take its place). A 390 px row is B I U + alignment + the list, a 320 px row
    // B I U + alignment - the phone row's gutter is 2 px for exactly that (see _document-editor-toolbar.css). The rank published as data-priority stays
    // the registry's.
    private static readonly HashSet<string> PhoneKeptCommands = new(StringComparer.Ordinal) { "alignment", "bulletList" };

    private ToolbarButtonPriority CorePriority(string command)
        => PhoneLayout
            ? (PhoneKeptCommands.Contains(command) ? ToolbarButtonPriority.Primary : ToolbarButtonPriority.Secondary)
            : (DocumentEditorBuiltInToolbar.FindItemByCommandName(command)?.Priority ?? ToolbarItemPriority.Secondary).ToCorePriority();

    private ToolbarItemPriority? PhonePrimary(string command)
        => !PhoneLayout
            ? null
            : PhoneKeptCommands.Contains(command) ? ToolbarItemPriority.Primary : ToolbarItemPriority.Secondary;

    private static string PriorityData(string command)
        => (DocumentEditorBuiltInToolbar.FindItemByCommandName(command)?.Priority ?? ToolbarItemPriority.Secondary).ToDataValue();

    // ─── font family: an unknown family still shows ──────────────────────────

    private bool IsFontFamilyUnknown
        => !string.IsNullOrWhiteSpace(CurrentFontFamily)
        && !FontFamilies.Any(font => string.Equals(font.CssFamily, CurrentFontFamily, StringComparison.OrdinalIgnoreCase));

    /// <summary>The name of a family that is not in the configured list: the first family of its CSS stack, unquoted.</summary>
    private static string FontFamilyLabel(string? cssFamily)
    {
        var first = (cssFamily ?? string.Empty).Split(',')[0].Trim().Trim('"', '\'');
        return string.IsNullOrEmpty(first) ? (cssFamily ?? string.Empty) : first;
    }

    // ─── alignment: one item, the current alignment as its icon ──────────────

    private static readonly DocumentTextAlignment[] AlignmentChoices =
        [DocumentTextAlignment.Left, DocumentTextAlignment.Center, DocumentTextAlignment.Right, DocumentTextAlignment.Justify];

    private DocumentTextAlignment EffectiveAlignmentForDisplay => GetEffectiveParagraphAlignment();

    /// <summary>The checked alignment; null while a mixed selection (an optimistic choice wins until the host confirms it).</summary>
    private DocumentTextAlignment? CurrentAlignmentChoice
        => ParagraphAlignmentMixed && _optimisticParagraphAlignment is null ? null : EffectiveAlignmentForDisplay;

    private static string AlignmentIcon(DocumentTextAlignment alignment) => alignment switch
    {
        DocumentTextAlignment.Center => "align-center",
        DocumentTextAlignment.Right => "align-right",
        DocumentTextAlignment.Justify => "align-justify",
        _ => "align-left",
    };

    private string AlignmentLabel(DocumentTextAlignment alignment) => alignment switch
    {
        DocumentTextAlignment.Center => Loc["TmDocumentEditor_AlignCenter"],
        DocumentTextAlignment.Right => Loc["TmDocumentEditor_AlignRight"],
        DocumentTextAlignment.Justify => Loc["TmDocumentEditor_AlignJustify"],
        _ => Loc["TmDocumentEditor_AlignLeft"],
    };

    private Task HandleAlignmentSelectedAsync(string value)
        => Enum.TryParse<DocumentTextAlignment>(value, out var alignment)
            ? HandleParagraphAlignmentClickedAsync(alignment)
            : Task.CompletedTask;

    private IReadOnlyList<TmActionItem> AlignmentMenuItems()
    {
        var current = CurrentAlignmentChoice;
        var disabled = !IsCommandEnabled("paragraphAlignment");
        return [.. AlignmentChoices.Select(alignment => new TmActionItem
        {
            Id = alignment.ToString(),
            Label = AlignmentLabel(alignment),
            Icon = AlignmentIcon(alignment),
            Checked = current == alignment,
            Disabled = disabled,
            OnClick = EventCallback.Factory.Create(this, () => HandleParagraphAlignmentClickedAsync(alignment)),
        })];
    }

    // ─── colours: named palette entries ──────────────────────────────────────

    private IReadOnlyDictionary<string, string> ColorNames => _colorNames ??= BuildColorNames();

    private Dictionary<string, string>? _colorNames;

    private Dictionary<string, string> BuildColorNames()
    {
        var names = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var color in DocumentTextColors.Concat(DocumentHighlightColors))
        {
            names[color] = Loc[$"TmDocumentEditor_Color_{color.TrimStart('#').ToLowerInvariant()}"];
        }

        return names;
    }

    private string ColorTriggerLabel(string label, string? value, bool mixed)
    {
        var normalized = NormalizeColorValue(value, string.Empty);
        var state = mixed ? Loc["TmDocumentEditor_MixedFormatting"] : string.IsNullOrEmpty(normalized) ? Loc["TmDocumentEditor_ColorNotSet"] : normalized;
        return Loc["TmDocumentEditor_CommandTitleFormat", label, state];
    }

    private IReadOnlyList<TmActionItem> TextColorMenuItems()
        => ColorMenuItems(DocumentTextColors, CurrentTextColor, TextColorMixed, !IsCommandEnabled("textColor"), HandleTextColorAppliedAsync, clearLabel: null);

    private IReadOnlyList<TmActionItem> HighlightColorMenuItems()
        => ColorMenuItems(DocumentHighlightColors, CurrentHighlightColor, HighlightColorMixed, !IsCommandEnabled("highlightColor"), HandleHighlightColorAppliedAsync, Loc["TmDocumentEditor_NoHighlight"]);

    private IReadOnlyList<TmActionItem> ColorMenuItems(string[] palette, string? current, bool mixed, bool disabled, Func<string?, Task> apply, string? clearLabel)
    {
        var normalizedCurrent = mixed ? string.Empty : NormalizeColorValue(current, string.Empty);
        var items = new List<TmActionItem>();
        if (clearLabel is not null)
        {
            items.Add(new TmActionItem
            {
                Id = "none",
                Label = clearLabel,
                Checked = !mixed && normalizedCurrent.Length == 0,
                Disabled = disabled,
                OnClick = EventCallback.Factory.Create(this, () => apply(string.Empty)),
            });
        }

        foreach (var color in palette)
        {
            var captured = color;
            items.Add(new TmActionItem
            {
                Id = color,
                Label = ColorNames.TryGetValue(color, out var name) ? name : color,
                Checked = string.Equals(normalizedCurrent, color, StringComparison.OrdinalIgnoreCase),
                Disabled = disabled,
                OnClick = EventCallback.Factory.Create(this, () => apply(captured)),
            });
        }

        return items;
    }

    // ─── image: its More form ────────────────────────────────────────────────

    private IReadOnlyList<TmActionItem> ImageMenuItems()
    {
        var items = new List<TmActionItem>
        {
            new() { Id = "url", Label = Loc["TmDocumentEditor_ImageInsertUrl"], Icon = "link", OnClick = EventCallback.Factory.Create(this, InsertImageFromUrlAsync) },
            new() { Id = "upload", Label = Loc["TmDocumentEditor_UploadImage"], Icon = "upload", Disabled = !CanUploadImages, OnClick = EventCallback.Factory.Create(this, InsertImageFromUploadAsync) },
        };
        if (CanBrowseImageAssets)
        {
            items.Add(new TmActionItem { Id = "asset", Label = Loc["TmDocumentEditor_ImageInsertAsset"], Icon = "images", OnClick = EventCallback.Factory.Create(this, InsertImageFromAssetAsync) });
        }

        return items;
    }

    private bool IsFeatureEnabled(string featureName) =>
        DisabledFeatures is null
        || !DisabledFeatures.Any(disabledFeature => string.Equals(disabledFeature, featureName, StringComparison.OrdinalIgnoreCase));

    private string ToolbarClass
    {
        get
        {
            var classes = new List<string> { "tm-document-editor__ribbon" };
            if (_keyboardMode)
            {
                classes.Add("tm-document-editor__ribbon--keyboard-mode");
            }

            if (ToolbarMode == DocumentToolbarMode.Compact)
            {
                classes.Add("tm-document-editor__ribbon--compact");
            }
            else if (ToolbarMode == DocumentToolbarMode.DistractionFree)
            {
                classes.Add("tm-document-editor__ribbon--distraction-free");
            }

            return string.Join(' ', classes);
        }
    }

    private string ActiveRibbonTabDataValue => GetRibbonTabDataValue(_activeRibbonTab);

    private string TrackChangesState => TrackChangesEnabled ? "on" : "off";

    /// <summary>Moves focus to the currently active ribbon tab.</summary>
    public async ValueTask FocusActiveTabAsync()
    {
        _keyboardMode = true;
        await GetActiveTabReference().FocusAsync();
    }

    private void HandleToolbarKeyDown(KeyboardEventArgs args)
    {
        if (args.Key != "Escape")
        {
            return;
        }

        CloseToolbarFloatingUi();
    }

    // Perf plan N9.2: the toolbar is ~4 500 lines of markup rebuilt on every parent render even
    // when nothing visible changed. ShouldRender fingerprints EVERY display-bearing input: all value
    // parameters, reference parameters by identity (the parent hands stable references),
    // CommandRegistry.Version (N7 -- bumps only on a real command-state refresh) and all internal UI
    // state fields. EventCallback parameters are deliberately excluded (delegate identity changes per
    // parent render but behavior does not). When adding a parameter or UI state field that affects
    // markup, extend ComputeRenderSignature.
    private int? _lastToolbarRenderSignature;

    protected override bool ShouldRender()
    {
        var signature = ComputeRenderSignature();
        if (_lastToolbarRenderSignature == signature)
        {
            return false;
        }

        _lastToolbarRenderSignature = signature;
        return true;
    }

    private int ComputeRenderSignature()
    {
        var hash = new HashCode();
        // Value parameters.
        hash.Add((int)ToolbarMode); hash.Add(PhoneLayout); hash.Add(ShowQuickAccess); hash.Add(ReadOnly); hash.Add(IsSaving); hash.Add(IsDirty);
        hash.Add(SaveMessage); hash.Add(LastSavedAt); hash.Add(CanUndo); hash.Add(CanRedo);
        hash.Add(NextUndoDescription); hash.Add(NextRedoDescription); hash.Add(TrackChangesEnabled);
        hash.Add(CanTrackChanges); hash.Add(IsDocumentProtected); hash.Add(ShowBlocks);
        hash.Add(ShowNonPrintingCharacters); hash.Add(IsFullscreen); hash.Add(ShowDebugTools);
        hash.Add((int)BoldState); hash.Add((int)ItalicState); hash.Add((int)UnderlineState);
        hash.Add((int)StrikethroughState); hash.Add((int)SuperscriptState); hash.Add((int)SubscriptState);
        hash.Add((int)SmallCapsState); hash.Add((int)AllCapsState); hash.Add((int)DoubleStrikethroughState);
        hash.Add((int)ParagraphAlignment); hash.Add(ParagraphAlignmentMixed);
        hash.Add(CurrentFontFamily); hash.Add(FontFamilyMixed); hash.Add(CurrentFontSize); hash.Add(FontSizeMixed);
        hash.Add(CurrentTextColor); hash.Add(TextColorMixed); hash.Add(CurrentHighlightColor); hash.Add(HighlightColorMixed);
        hash.Add(CurrentLineSpacing); hash.Add(LineSpacingMixed); hash.Add(CurrentSpacingBefore); hash.Add(SpacingBeforeMixed);
        hash.Add(CurrentSpacingAfter); hash.Add(SpacingAfterMixed); hash.Add(BulletListActive);
        hash.Add(NumberedListActive); hash.Add(ListMixed); hash.Add((int)ReviewDisplayMode); hash.Add(CanComment);
        hash.Add(TemplatePreviewEnabled); hash.Add(CanPreviewTemplate); hash.Add(CanExportPdf); hash.Add(IsExportingPdf);
        hash.Add(CanImportDocx); hash.Add(CanExportDocx); hash.Add(IsImportingDocx); hash.Add(IsExportingDocx);
        hash.Add(ShowPrintPreviewTools); hash.Add(PrintPreviewActive); hash.Add(TemplatePreviewMessage);
        hash.Add(CanCompareDocuments); hash.Add(ShowAdvancedFields); hash.Add(ActiveRegion);
        hash.Add(ActiveHeaderFooterScopeLabel); hash.Add(DifferentFirstPage); hash.Add(DifferentOddAndEvenPages);
        hash.Add(ShowRuler); hash.Add(ZoomPercent); hash.Add(ZoomPageWidth); hash.Add(ZoomAutoFit); hash.Add(ShowAutomaticZoom); hash.Add(CanUploadImages);
        hash.Add(CanBrowseImageAssets); hash.Add(ShowEquationTools); hash.Add(ShowSymbolTools); hash.Add(ShowBlockStyle);
        hash.Add(CurrentBlockStyle); hash.Add(ShowStyleManagement); hash.Add(ShowAdvancedCharacterFormatting);
        // Inherited from TmComponentBase — both feed rendered data-testid attribute values.
        hash.Add(DataTestId); hash.Add(TestIdPrefix);
        // Reference parameters by identity (parent hands stable references) + registry version.
        hash.Add(CommandRegistry?.Version ?? -1);
        hash.Add(ReferenceHash(FontFamilies)); hash.Add(ReferenceHash(DisabledFeatures));
        hash.Add(ReferenceHash(PageSettings)); hash.Add(ReferenceHash(SectionColumns)); hash.Add(ReferenceHash(LineNumbering));
        // Internal UI state (menus, dialogs, overflow, optimistic formatting).
        hash.Add((int)_activeRibbonTab);
        hash.Add(_linkDialogOpen); hash.Add(_pendingLinkUrl); hash.Add(_pendingLinkTitle); hash.Add(_linkError);
        hash.Add((int)_floating); hash.Add(_floatingFromMenu); hash.Add(ImagePanelOpen); hash.Add(_docxImportOpen);
        hash.Add(_keyboardMode); hash.Add(_wasHeaderFooterMode);
        hash.Add(_styleFontSizeValue); hash.Add(_styleNameValue); hash.Add(_styleRenameSourceId); hash.Add(_styleRenameValue);
        hash.Add(_optimisticParagraphAlignment.HasValue ? (int)_optimisticParagraphAlignment.Value : -1);
        hash.Add(_optimisticParagraphAlignmentExpiresAt.UtcTicks);
        hash.Add(_optimisticLineSpacing ?? double.MinValue); hash.Add(_optimisticLineSpacingExpiresAt.UtcTicks);
        hash.Add(_optimisticBulletListActive); hash.Add(_optimisticNumberedListActive); hash.Add(_optimisticListExpiresAt.UtcTicks);
        return hash.ToHashCode();
    }

    private static int ReferenceHash(object? value)
        => value is null ? 0 : System.Runtime.CompilerServices.RuntimeHelpers.GetHashCode(value);

