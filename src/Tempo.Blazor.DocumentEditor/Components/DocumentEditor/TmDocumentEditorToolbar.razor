        else if (_activeRibbonTab == DocumentRibbonTab.HeaderFooter)
        {
            <section class="tm-document-editor__ribbon-group tm-document-editor__ribbon-group--scope" aria-label="@Loc["TmDocumentEditor_HeaderFooterScope"]">
                <span class="tm-document-header-footer-scope"
                      data-testid="@TestId("document-header-footer-scope-label")">
                    <TmIcon Name="map-pin" Size="IconSize.Sm" />
                    <span>@(string.IsNullOrWhiteSpace(ActiveHeaderFooterScopeLabel) ? Loc["TmDocumentEditor_HeaderFooterScopePrimary"] : ActiveHeaderFooterScopeLabel)</span>
                </span>
            </section>
            @* The first-page / odd-even structure toggles sit right after the scope chip: they define
