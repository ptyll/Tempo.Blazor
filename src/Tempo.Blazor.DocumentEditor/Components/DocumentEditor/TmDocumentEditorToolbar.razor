                            <button type="button" role="menuitem" data-testid="@TestId("document-header-footer-preset-page-x-of-y-right-footer")" @onclick='() => ApplyHeaderFooterPresetFromMenuAsync("footer-page-x-of-y-right")'>
                                <span class="tm-document-header-footer-menu__preview tm-document-header-footer-menu__preview--right"></span>
                                <span>@Loc["TmDocumentEditor_PresetPageXOfYRightFooter"]</span>
