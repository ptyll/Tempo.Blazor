                                <span class="tm-document-header-footer-menu__preview tm-document-header-footer-menu__preview--center"></span>
                                <span>@Loc["TmDocumentEditor_PresetPageNumberCenterFooter"]</span>
                            </button>
                            <button type="button" role="menuitem" data-testid="@TestId("document-header-footer-preset-title-page-header")" @onclick='() => ApplyHeaderFooterPresetFromMenuAsync("header-title-page-number")'>
