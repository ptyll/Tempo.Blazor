                                      Tooltip="@Loc["TmDocumentEditor_InsertPageXOfY"]"
                                      OnClick="OnInsertPageXOfY"
                                      Command="insertPageXOfY"
                                      TestId="@TestId("document-header-footer-insert-page-x-of-y")" />
                <DocumentRibbonButton Icon="calendar-days"
