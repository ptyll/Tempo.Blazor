    /// <summary>
    /// Opens the link popover (prefilled from the link under the selection) and focuses its URL field once it is displayed.
    /// Used by the Ctrl+K command; the popover anchors to the ribbon row because the shortcut has no trigger.
    /// </summary>
    public Task OpenLinkDialogAsync() => OpenLinkAsync(fromMenu: true);

    private async Task OpenLinkAsync(bool fromMenu)
    {
        if (ReadOnly)
        {
            return;
        }

        _linkError = null;
        var info = LinkInfoProvider is null ? null : await LinkInfoProvider.Invoke();
        _pendingLinkUrl = info?.Href;
        _pendingLinkTitle = info?.Title;
        // "Remove link" is offered only when the selection already carries a link; typing a URL into a fresh popover must not offer it.
        _linkHadExistingHref = !string.IsNullOrWhiteSpace(info?.Href);
        OpenFloating(ToolbarFloating.Link, fromMenu);
        await InvokeAsync(StateHasChanged);
    }

    private async Task FocusLinkUrlAsync()
    {
        try
        {
            await _linkUrlInput.FocusAsync(preventScroll: true);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
            // The popover closed before the focus move ran.
        }
    }

    private void ResetLinkDraft()
    {
        _linkHadExistingHref = false;
        _pendingLinkUrl = null;
        _pendingLinkTitle = null;
        _linkError = null;
    }

