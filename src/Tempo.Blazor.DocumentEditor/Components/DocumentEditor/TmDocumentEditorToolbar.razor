@namespace Tempo.Blazor.Components.DocumentEditor
@inherits Tempo.Blazor.Components.TmComponentBase
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Tempo.Blazor.Abstractions.Models
@using Tempo.Blazor.Components.Files
@using Tempo.Blazor.Components.DocumentEditor.Features
@using Tempo.Blazor.Components.DocumentEditor.Registry
@using Tempo.Blazor.DocumentEditor.Models
@inject IJSRuntime JS
@implements IAsyncDisposable

<header class="@ToolbarClass"
        role="group"
        aria-label="@Loc["TmDocumentEditor_ToolbarLabel"]"
        hidden="@(ToolbarMode == DocumentToolbarMode.DistractionFree)"
        data-testid="@TestId("document-toolbar")"
        data-keyboard-mode="@_keyboardMode.ToString().ToLowerInvariant()"
        data-toolbar-mode="@ToolbarMode.ToString()"
        data-active-ribbon-tab="@ActiveRibbonTabDataValue"
        data-track-changes-state="@TrackChangesState"
        @onkeydown="HandleToolbarKeyDown">
    @if (HasToolbarFloatingUi)
    {
        <button type="button"
                class="tm-document-editor__toolbar-floating-backdrop"
                aria-label="@Loc["TmDocumentEditor_Close"]"
                data-testid="@TestId("document-toolbar-floating-backdrop")"
                @onclick="CloseToolbarFloatingUi"
                @oncontextmenu:preventDefault="true"
                @oncontextmenu="CloseToolbarFloatingUi">
        </button>
    }

    <div class="tm-document-editor__ribbon-tabs" role="tablist" aria-label="@Loc["TmDocumentEditor_ToolbarTabsLabel"]">
        <button type="button"
                @ref="_homeTab"
                class="@GetRibbonTabClass(DocumentRibbonTab.Home)"
                id="@GetRibbonTabId(DocumentRibbonTab.Home)"
                role="tab"
                aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.Home)"
                aria-current="@GetRibbonTabCurrent(DocumentRibbonTab.Home)"
                aria-controls="@RibbonPanelId"
                tabindex="@GetRibbonTabIndex(DocumentRibbonTab.Home)"
                @onclick="() => SelectRibbonTab(DocumentRibbonTab.Home)"
                @onkeydown="args => HandleRibbonTabKeyDownAsync(args, DocumentRibbonTab.Home)"
                @onpointerdown:preventDefault="true"
                @onmousedown:preventDefault="true"
                data-ribbon-tab="@GetRibbonTabDataValue(DocumentRibbonTab.Home)"
                data-active="@GetRibbonTabSelected(DocumentRibbonTab.Home)"
                data-testid="@TestId("document-ribbon-tab-home")">@Loc["TmDocumentEditor_TabHome"]</button>
        <button type="button"
                @ref="_insertTab"
                class="@GetRibbonTabClass(DocumentRibbonTab.Insert)"
                id="@GetRibbonTabId(DocumentRibbonTab.Insert)"
                role="tab"
                aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.Insert)"
                aria-current="@GetRibbonTabCurrent(DocumentRibbonTab.Insert)"
                aria-controls="@RibbonPanelId"
                tabindex="@GetRibbonTabIndex(DocumentRibbonTab.Insert)"
                @onclick="() => SelectRibbonTab(DocumentRibbonTab.Insert)"
                @onkeydown="args => HandleRibbonTabKeyDownAsync(args, DocumentRibbonTab.Insert)"
                @onpointerdown:preventDefault="true"
                @onmousedown:preventDefault="true"
                data-ribbon-tab="@GetRibbonTabDataValue(DocumentRibbonTab.Insert)"
                data-active="@GetRibbonTabSelected(DocumentRibbonTab.Insert)"
                data-testid="@TestId("document-ribbon-tab-insert")">@Loc["TmDocumentEditor_TabInsert"]</button>
        <button type="button"
                @ref="_mathTab"
                class="@GetRibbonTabClass(DocumentRibbonTab.Math)"
                id="@GetRibbonTabId(DocumentRibbonTab.Math)"
                role="tab"
                aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.Math)"
                aria-current="@GetRibbonTabCurrent(DocumentRibbonTab.Math)"
                aria-controls="@RibbonPanelId"
                tabindex="@GetRibbonTabIndex(DocumentRibbonTab.Math)"
                @onclick="() => SelectRibbonTab(DocumentRibbonTab.Math)"
                @onkeydown="args => HandleRibbonTabKeyDownAsync(args, DocumentRibbonTab.Math)"
                @onpointerdown:preventDefault="true"
                @onmousedown:preventDefault="true"
                data-ribbon-tab="@GetRibbonTabDataValue(DocumentRibbonTab.Math)"
                data-active="@GetRibbonTabSelected(DocumentRibbonTab.Math)"
                data-testid="@TestId("document-ribbon-tab-math")">@Loc["TmDocumentEditor_TabMath"]</button>
        <button type="button"
                @ref="_layoutTab"
                class="@GetRibbonTabClass(DocumentRibbonTab.Layout)"
                id="@GetRibbonTabId(DocumentRibbonTab.Layout)"
                role="tab"
                aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.Layout)"
                aria-current="@GetRibbonTabCurrent(DocumentRibbonTab.Layout)"
                aria-controls="@RibbonPanelId"
                tabindex="@GetRibbonTabIndex(DocumentRibbonTab.Layout)"
                @onclick="() => SelectRibbonTab(DocumentRibbonTab.Layout)"
                @onkeydown="args => HandleRibbonTabKeyDownAsync(args, DocumentRibbonTab.Layout)"
                @onpointerdown:preventDefault="true"
                @onmousedown:preventDefault="true"
                data-ribbon-tab="@GetRibbonTabDataValue(DocumentRibbonTab.Layout)"
                data-active="@GetRibbonTabSelected(DocumentRibbonTab.Layout)"
                data-testid="@TestId("document-ribbon-tab-layout")">@Loc["TmDocumentEditor_TabLayout"]</button>
        <button type="button"
                @ref="_referencesTab"
                class="@GetRibbonTabClass(DocumentRibbonTab.References)"
                id="@GetRibbonTabId(DocumentRibbonTab.References)"
                role="tab"
                aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.References)"
                aria-current="@GetRibbonTabCurrent(DocumentRibbonTab.References)"
                aria-controls="@RibbonPanelId"
                tabindex="@GetRibbonTabIndex(DocumentRibbonTab.References)"
                @onclick="() => SelectRibbonTab(DocumentRibbonTab.References)"
                @onkeydown="args => HandleRibbonTabKeyDownAsync(args, DocumentRibbonTab.References)"
                @onpointerdown:preventDefault="true"
                @onmousedown:preventDefault="true"
                data-ribbon-tab="@GetRibbonTabDataValue(DocumentRibbonTab.References)"
                data-active="@GetRibbonTabSelected(DocumentRibbonTab.References)"
                data-testid="@TestId("document-ribbon-tab-references")">@Loc["TmDocumentEditor_TabReferences"]</button>
        <button type="button"
                @ref="_reviewTab"
                class="@GetRibbonTabClass(DocumentRibbonTab.Review)"
                id="@GetRibbonTabId(DocumentRibbonTab.Review)"
                role="tab"
                aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.Review)"
                aria-current="@GetRibbonTabCurrent(DocumentRibbonTab.Review)"
                aria-controls="@RibbonPanelId"
                tabindex="@GetRibbonTabIndex(DocumentRibbonTab.Review)"
                @onclick="() => SelectRibbonTab(DocumentRibbonTab.Review)"
                @onkeydown="args => HandleRibbonTabKeyDownAsync(args, DocumentRibbonTab.Review)"
                @onpointerdown:preventDefault="true"
                @onmousedown:preventDefault="true"
                data-ribbon-tab="@GetRibbonTabDataValue(DocumentRibbonTab.Review)"
                data-active="@GetRibbonTabSelected(DocumentRibbonTab.Review)"
                data-testid="@TestId("document-ribbon-tab-review")">@Loc["TmDocumentEditor_TabReview"]</button>
        <button type="button"
                @ref="_viewTab"
                class="@GetRibbonTabClass(DocumentRibbonTab.View)"
                id="@GetRibbonTabId(DocumentRibbonTab.View)"
                role="tab"
                aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.View)"
                aria-current="@GetRibbonTabCurrent(DocumentRibbonTab.View)"
                aria-controls="@RibbonPanelId"
                tabindex="@GetRibbonTabIndex(DocumentRibbonTab.View)"
                @onclick="() => SelectRibbonTab(DocumentRibbonTab.View)"
                @onkeydown="args => HandleRibbonTabKeyDownAsync(args, DocumentRibbonTab.View)"
                @onpointerdown:preventDefault="true"
                @onmousedown:preventDefault="true"
                data-ribbon-tab="@GetRibbonTabDataValue(DocumentRibbonTab.View)"
                data-active="@GetRibbonTabSelected(DocumentRibbonTab.View)"
                data-testid="@TestId("document-ribbon-tab-view")">@Loc["TmDocumentEditor_TabView"]</button>
        @if (IsHeaderFooterMode)
        {
            <button type="button"
                    @ref="_headerFooterTab"
                    class="@GetRibbonTabClass(DocumentRibbonTab.HeaderFooter)"
                    id="@GetRibbonTabId(DocumentRibbonTab.HeaderFooter)"
                    role="tab"
                    aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.HeaderFooter)"
                    aria-current="@GetRibbonTabCurrent(DocumentRibbonTab.HeaderFooter)"
                    aria-controls="@RibbonPanelId"
                    tabindex="@GetRibbonTabIndex(DocumentRibbonTab.HeaderFooter)"
                    @onclick="() => SelectRibbonTab(DocumentRibbonTab.HeaderFooter)"
                    @onkeydown="args => HandleRibbonTabKeyDownAsync(args, DocumentRibbonTab.HeaderFooter)"
                    @onpointerdown:preventDefault="true"
                    @onmousedown:preventDefault="true"
                    data-ribbon-tab="@GetRibbonTabDataValue(DocumentRibbonTab.HeaderFooter)"
                    data-active="@GetRibbonTabSelected(DocumentRibbonTab.HeaderFooter)"
                    data-testid="@TestId("document-ribbon-tab-header-footer")">@Loc["TmDocumentEditor_TabHeaderFooter"]</button>
        }
    </div>

    <div class="tm-document-editor__ribbon-commands-wrapper">
    <section class="tm-document-editor__ribbon-group tm-document-editor__ribbon-group--quick-access"
             aria-label="@Loc["TmDocumentEditor_GroupClipboard"]">
        <button class="tm-document-editor__ribbon-button"
                type="button"
                disabled="@(!CanExecuteSave)"
                title="@SaveTitle"
                aria-label="@SaveTitle"
                aria-disabled="@AriaDisabled(!CanExecuteSave)"
                @onclick='() => ExecuteToolbarCommandAsync("save", OnSave, !ReadOnly && !IsSaving)'
                data-command="save"
                data-testid="@TestId("document-save")">
            <TmIcon Name="save" Size="IconSize.Sm" />
            <span>@Loc["TmDocumentEditor_Save"]</span>
        </button>
        <button class="tm-document-editor__ribbon-button"
                type="button"
                disabled="@(!CanExecuteUndo)"
                title="@UndoTitle"
                aria-label="@UndoTitle"
                aria-disabled="@AriaDisabled(!CanExecuteUndo)"
                @onclick='() => ExecuteToolbarCommandAsync("undo", OnUndo, !ReadOnly && CanUndo)'
                data-command="undo"
                data-testid="@TestId("document-undo")">
            <TmIcon Name="undo-2" Size="IconSize.Sm" />
            <span>@Loc["TmDocumentEditor_Undo"]</span>
        </button>
        <button class="tm-document-editor__ribbon-button"
                type="button"
                disabled="@(!CanExecuteRedo)"
                title="@RedoTitle"
                aria-label="@RedoTitle"
                aria-disabled="@AriaDisabled(!CanExecuteRedo)"
                @onclick='() => ExecuteToolbarCommandAsync("redo", OnRedo, !ReadOnly && CanRedo)'
                data-command="redo"
                data-testid="@TestId("document-redo")">
            <TmIcon Name="redo-2" Size="IconSize.Sm" />
            <span>@Loc["TmDocumentEditor_Redo"]</span>
        </button>
    </section>
    <div id="@RibbonPanelId"
         class="tm-document-editor__ribbon-groups"
         role="tabpanel"
         aria-labelledby="@GetRibbonTabId(_activeRibbonTab)"
         data-testid="@TestId("document-ribbon-panel")"
         data-active-ribbon-tab="@ActiveRibbonTabDataValue"
         @ref="_ribbonGroupsRef">
        @if (_activeRibbonTab == DocumentRibbonTab.Home)
        {
            <section class="tm-document-editor__ribbon-group tm-document-editor__ribbon-group--formatting" aria-label="@Loc["TmDocumentEditor_GroupFormatting"]">
                @if (ShowBlockStyle)
                {
                    <div class="tm-document-style-gallery-wrapper">
                        <label class="tm-document-editor__ribbon-select tm-document-editor__ribbon-select--compact" title="@Loc["TmDocumentEditor_BlockStyle"]">
                            <span>@Loc["TmDocumentEditor_BlockStyle"]</span>
                            <select value="@(string.IsNullOrEmpty(CurrentBlockStyle) ? "Normal" : CurrentBlockStyle)"
                                    @onchange="HandleBlockStyleChangedAsync"
                                    aria-label="@Loc["TmDocumentEditor_BlockStyle"]"
                                    data-command="blockStyle"
                                    data-testid="@TestId("document-block-style")">
                                @if (IsCurrentBlockStyleCustom)
                                {
                                    <option value="@CurrentBlockStyle">@ResolveCurrentStyleName()</option>
                                }
                                <option value="Normal">@Loc["TmDocumentEditor_StyleNormal"]</option>
                                <option value="Title">@Loc["TmDocumentEditor_StyleTitle"]</option>
                                <option value="Heading1">@Loc["TmDocumentEditor_Heading1"]</option>
                                <option value="Heading2">@Loc["TmDocumentEditor_Heading2"]</option>
                                <option value="Heading3">@Loc["TmDocumentEditor_Heading3"]</option>
                                <option value="Heading4">@Loc["TmDocumentEditor_Heading4"]</option>
                                <option value="Heading5">@Loc["TmDocumentEditor_Heading5"]</option>
                                <option value="Heading6">@Loc["TmDocumentEditor_Heading6"]</option>
                                <option value="Quote">@Loc["TmDocumentEditor_StyleQuote"]</option>
                            </select>
                        </label>
                        @if (ShowStyleManagement)
                        {
                            <button class="@($"tm-document-editor__ribbon-button tm-document-style-gallery__toggle{(_styleGalleryOpen ? " tm-document-editor__ribbon-button--active" : "")}")"
                                    type="button"
                                    disabled="@ReadOnly"
                                    title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_StyleGallery"]))"
                                    aria-haspopup="dialog"
                                    aria-expanded="@_styleGalleryOpen.ToString().ToLowerInvariant()"
                                    @onclick="ToggleStyleGallery"
                                    data-command="styleGallery"
                                    data-testid="@TestId("document-style-gallery-toggle")">
                                <TmIcon Name="gallery-horizontal-end" Size="IconSize.Sm" />
                                <span>@Loc["TmDocumentEditor_StyleGallery"]</span>
                            </button>
                            @if (_styleGalleryOpen)
                            {
                                <section class="tm-document-style-gallery"
                                         role="dialog"
                                         aria-label="@Loc["TmDocumentEditor_StyleGallery"]"
                                         data-testid="@TestId("document-style-gallery")"
                                         tabindex="-1"
                                         @ref="_styleGallery"
                                         @onkeydown="HandleStyleGalleryKeyDown"
                                         @onkeydown:stopPropagation="true"
                                         @onclick:stopPropagation="true">
                                    <div class="tm-document-style-gallery__quick" role="group" aria-label="@Loc["TmDocumentEditor_QuickStyles"]">
                                        @foreach (var style in QuickStyleButtons)
                                        {
                                            <button type="button"
                                                    class="@GetQuickStyleButtonClass(style.Value)"
                                                    disabled="@ReadOnly"
                                                    aria-pressed="@IsCurrentQuickStyle(style.Value).ToString().ToLowerInvariant()"
                                                    @onclick="() => ApplyQuickStyleAsync(style.Value)"
                                                    data-testid="@($"document-style-quick-{style.TestId}")">
                                                <span class="tm-document-style-gallery__sample">@style.Label</span>
                                                <span>@style.Label</span>
                                            </button>
                                        }
                                    </div>
                                    <label class="tm-document-style-gallery__field">
                                        <span>@Loc["TmDocumentEditor_StyleFontSize"]</span>
                                        <input type="number"
                                               min="8"
                                               max="96"
                                               step="1"
                                               value="@_styleFontSizeValue"
                                               @oninput="HandleStyleFontSizeInput"
                                               data-testid="@TestId("document-style-font-size")" />
                                    </label>
                                    <label class="tm-document-style-gallery__field">
                                        <span>@Loc["TmDocumentEditor_StyleName"]</span>
                                        <input type="text"
                                               value="@_styleNameValue"
                                               @oninput="HandleStyleNameInput"
                                               aria-label="@Loc["TmDocumentEditor_StyleName"]"
                                               data-testid="@TestId("document-style-name")" />
                                    </label>
                                    <label class="tm-document-style-gallery__field">
                                        <span>@Loc["TmDocumentEditor_StyleRenameName"]</span>
                                        <input type="text"
                                               value="@_styleRenameValue"
                                               @oninput="HandleStyleRenameInput"
                                               aria-label="@Loc["TmDocumentEditor_StyleRenameName"]"
                                               data-testid="@TestId("document-style-rename-name")" />
                                    </label>
                                    <div class="tm-document-style-gallery__actions" role="group" aria-label="@Loc["TmDocumentEditor_StyleActions"]">
                                        <button type="button"
                                                class="tm-document-editor__ribbon-button tm-document-style-gallery__primary"
                                                disabled="@ReadOnly"
                                                @onclick="ModifyCurrentStyleAsync"
                                                data-command="modifyStyle"
                                                data-testid="@TestId("document-style-modify")">
                                            <TmIcon Name="wand-sparkles" Size="IconSize.Sm" />
                                            <span>@Loc["TmDocumentEditor_ModifyStyle"]</span>
                                        </button>
                                        <button type="button"
                                                class="tm-document-editor__ribbon-button"
                                                disabled="@(ReadOnly || string.IsNullOrWhiteSpace(_styleNameValue))"
                                                @onclick="CreateStyleFromSelectionAsync"
                                                data-command="createStyleFromSelection"
                                                data-testid="@TestId("document-style-create")">
                                            <TmIcon Name="plus" Size="IconSize.Sm" />
                                            <span>@Loc["TmDocumentEditor_CreateStyle"]</span>
                                        </button>
                                        <button type="button"
                                                class="tm-document-editor__ribbon-button"
                                                disabled="@(ReadOnly || string.IsNullOrWhiteSpace(_styleRenameValue))"
                                                @onclick="RenameCurrentStyleAsync"
                                                data-command="renameStyle"
                                                data-testid="@TestId("document-style-rename")">
                                            <TmIcon Name="pencil" Size="IconSize.Sm" />
                                            <span>@Loc["TmDocumentEditor_RenameStyle"]</span>
                                        </button>
                                        <button type="button"
                                                class="tm-document-editor__ribbon-button"
                                                disabled="@(ReadOnly || IsCurrentStyleBuiltIn)"
                                                @onclick="DeleteCurrentStyleAsync"
                                                data-command="deleteStyle"
                                                data-testid="@TestId("document-style-delete")">
                                            <TmIcon Name="trash-2" Size="IconSize.Sm" />
                                            <span>@Loc["TmDocumentEditor_DeleteStyle"]</span>
                                        </button>
                                        <button type="button"
                                                class="tm-document-editor__ribbon-button"
                                                disabled="@ReadOnly"
                                                @onclick="ResetStyleFormattingAsync"
                                                data-command="resetStyleFormatting"
                                                data-testid="@TestId("document-style-reset-formatting")">
                                            <TmIcon Name="eraser" Size="IconSize.Sm" />
                                            <span>@Loc["TmDocumentEditor_ResetStyleFormatting"]</span>
                                        </button>
                                    </div>
                                </section>
                            }
                        }
                    </div>
                }
                <label class="tm-document-editor__ribbon-select" title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_FontFamily"]))">
                    <TmIcon Name="type" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_FontFamily"]</span>
                    <select disabled="@(!IsCommandEnabled("fontFamily"))"
                            value="@(FontFamilyMixed ? string.Empty : CurrentFontFamily)"
                            title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_FontFamily"]))"
                            aria-label="@Loc["TmDocumentEditor_FontFamily"]"
                            aria-disabled="@AriaDisabled(!IsCommandEnabled("fontFamily"))"
                            @onchange="HandleFontFamilyChangedAsync"
                            data-testid="@TestId("document-font-family")">
                        <option value="">@Loc["TmDocumentEditor_FontFamilyDefault"]</option>
                        @foreach (var font in FontFamilies)
                        {
                            <option value="@font.CssFamily">@font.DisplayName</option>
                        }
                    </select>
                </label>
                <label class="tm-document-editor__ribbon-select tm-document-editor__ribbon-select--compact" title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_FontSize"]))">
                    <span>@Loc["TmDocumentEditor_FontSize"]</span>
                    <select disabled="@(!IsCommandEnabled("fontSize"))"
                            value="@(FontSizeMixed ? string.Empty : NormalizeFontSizeValue(CurrentFontSize))"
                            title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_FontSize"]))"
                            aria-label="@Loc["TmDocumentEditor_FontSize"]"
                            aria-disabled="@AriaDisabled(!IsCommandEnabled("fontSize"))"
                            @onchange="HandleFontSizeChangedAsync"
                            data-testid="@TestId("document-font-size")">
                        @if (FontSizeMixed)
                        {
                            <option value="">@Loc["TmDocumentEditor_MixedFormatting"]</option>
                        }
                        @foreach (var size in FontSizes)
                        {
                            <option value="@size">@($"{size} pt")</option>
                        }
                    </select>
                </label>
                <button class="@GetFormattingButtonClass(BoldState)"
                        type="button"
                        disabled="@(!IsCommandEnabled("bold"))"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_Bold"]))"
                        aria-label="@Loc["TmDocumentEditor_Bold"]"
                        aria-pressed="@GetRegistryFormattingAriaPressed("bold", BoldState)"
                        aria-disabled="@AriaDisabled(!IsCommandEnabled("bold"))"
                        @onclick='() => ExecuteToolbarCommandAsync("bold", OnBold)'
                        @onpointerdown:preventDefault="true"
                        @onmousedown:preventDefault="true"
                        data-command="bold"
                        data-testid="@TestId("document-bold")">
                    <TmIcon Name="bold" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_Bold"]</span>
                </button>
                <button class="@GetFormattingButtonClass(ItalicState)"
                        type="button"
                        disabled="@(!IsCommandEnabled("italic"))"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_Italic"]))"
                        aria-label="@Loc["TmDocumentEditor_Italic"]"
                        aria-pressed="@GetRegistryFormattingAriaPressed("italic", ItalicState)"
                        aria-disabled="@AriaDisabled(!IsCommandEnabled("italic"))"
                        @onclick='() => ExecuteToolbarCommandAsync("italic", OnItalic)'
                        @onpointerdown:preventDefault="true"
                        @onmousedown:preventDefault="true"
                        data-command="italic"
                        data-testid="@TestId("document-italic")">
                    <TmIcon Name="italic" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_Italic"]</span>
                </button>
                <button class="@GetFormattingButtonClass(UnderlineState)"
                        type="button"
                        disabled="@(!IsCommandEnabled("underline"))"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_Underline"]))"
                        aria-label="@Loc["TmDocumentEditor_Underline"]"
                        aria-pressed="@GetRegistryFormattingAriaPressed("underline", UnderlineState)"
                        aria-disabled="@AriaDisabled(!IsCommandEnabled("underline"))"
                        @onclick='() => ExecuteToolbarCommandAsync("underline", OnUnderline)'
                        @onpointerdown:preventDefault="true"
                        @onmousedown:preventDefault="true"
                        data-command="underline"
                        data-testid="@TestId("document-underline")">
                    <TmIcon Name="underline" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_Underline"]</span>
                </button>
                <button class="@GetFormattingButtonClass(StrikethroughState)"
                        type="button"
                        disabled="@(!IsCommandEnabled("strikethrough"))"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_Strikethrough"]))"
                        aria-label="@Loc["TmDocumentEditor_Strikethrough"]"
                        aria-pressed="@GetRegistryFormattingAriaPressed("strikethrough", StrikethroughState)"
                        aria-disabled="@AriaDisabled(!IsCommandEnabled("strikethrough"))"
                        @onclick='() => ExecuteToolbarCommandAsync("strikethrough", OnStrikethrough)'
                        @onpointerdown:preventDefault="true"
                        @onmousedown:preventDefault="true"
                        data-command="strikethrough"
                        data-testid="@TestId("document-strikethrough")">
                    <TmIcon Name="strikethrough" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_Strikethrough"]</span>
                </button>
                @if (ShowAdvancedCharacterFormatting)
                {
                    <div class="tm-document-editor__advanced-char-tools">
                    <button class="@GetFormattingButtonClass(SuperscriptState)"
                        type="button"
                        disabled="@(!IsCommandEnabled("superscript"))"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_Superscript"]))"
                        aria-label="@Loc["TmDocumentEditor_Superscript"]"
                        aria-pressed="@GetRegistryFormattingAriaPressed("superscript", SuperscriptState)"
                        aria-disabled="@AriaDisabled(!IsCommandEnabled("superscript"))"
                        @onclick='() => ExecuteToolbarCommandAsync("superscript", OnSuperscript)'
                        @onpointerdown:preventDefault="true"
                        @onmousedown:preventDefault="true"
                        data-command="superscript"
                        data-testid="@TestId("document-superscript")">
                    <TmIcon Name="superscript" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_Superscript"]</span>
                </button>
                <button class="@GetFormattingButtonClass(SubscriptState)"
                        type="button"
                        disabled="@(!IsCommandEnabled("subscript"))"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_Subscript"]))"
                        aria-label="@Loc["TmDocumentEditor_Subscript"]"
                        aria-pressed="@GetRegistryFormattingAriaPressed("subscript", SubscriptState)"
                        aria-disabled="@AriaDisabled(!IsCommandEnabled("subscript"))"
                        @onclick='() => ExecuteToolbarCommandAsync("subscript", OnSubscript)'
                        @onpointerdown:preventDefault="true"
                        @onmousedown:preventDefault="true"
                        data-command="subscript"
                        data-testid="@TestId("document-subscript")">
                    <TmIcon Name="subscript" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_Subscript"]</span>
                </button>
                <button class="@GetFormattingButtonClass(SmallCapsState)"
                        type="button"
