            <TmToolbarGroup Class="tm-document-editor__ribbon-group" Label="@Loc["TmDocumentEditor_TabHeaderFooter"]">
                <DocumentRibbonButton Icon="x"
                                      Text="@Loc["TmDocumentEditor_CloseHeaderFooter"]"
                                      Tooltip="@Loc["TmDocumentEditor_CloseHeaderFooter"]"
                                      OnClick="OnCloseHeaderFooter"
                                      Command="closeHeaderFooter"
                                      TestId="@TestId("document-close-header-footer")" />
