        lineNumbering.Restart = restart;
        return RaisePageSetupChangedAsync(EffectivePageSettings, EffectiveSectionColumns, lineNumbering);
    }

    private Task RaisePageSetupChangedAsync(
        DocumentPageSettings pageSettings,
        DocumentSectionColumns columns,
        DocumentLineNumbering lineNumbering)
    {
        if (PageSetupChanged.HasDelegate)
        {
            return PageSetupChanged.InvokeAsync(new DocumentSectionPageSetup
            {
                PageSettings = ClonePageSettings(pageSettings),
                Columns = CloneSectionColumns(columns),
                LineNumbering = CloneLineNumbering(lineNumbering)
            });
        }

        return PageSettingsChanged.InvokeAsync(ClonePageSettings(pageSettings));
    }

    private static DocumentPageSettings ClonePageSettings(DocumentPageSettings? settings)
    {
        settings ??= new DocumentPageSettings();
        return new DocumentPageSettings
        {
            Size = ClonePageSize(settings.Size ?? DocumentPageSize.A4),
            Margins = CloneMargins(settings.Margins ?? DocumentPageMargins.Default),
            Landscape = settings.Landscape,
            HeaderDistanceFromTop = settings.HeaderDistanceFromTop,
            FooterDistanceFromBottom = settings.FooterDistanceFromBottom
        };
    }

    private static DocumentPageSize ClonePageSize(DocumentPageSize size) =>
        new()
        {
            Name = string.IsNullOrWhiteSpace(size.Name) ? "A4" : size.Name,
            Width = size.Width,
            Height = size.Height
        };

    private static DocumentSectionColumns CloneSectionColumns(DocumentSectionColumns? columns)
    {
        columns ??= new DocumentSectionColumns();
        return new DocumentSectionColumns
        {
            Count = Math.Clamp(columns.Count <= 0 ? 1 : columns.Count, 1, 3),
            Spacing = Math.Max(0, columns.Spacing),
            SeparatorLine = columns.SeparatorLine,
            Balance = columns.Balance,
            Preset = string.IsNullOrWhiteSpace(columns.Preset) ? "one" : columns.Preset,
            Items = columns.Items
                .Select(item => new DocumentSectionColumn
                {
                    Width = item.Width,
                    SpacingAfter = item.SpacingAfter
                })
                .ToList()
        };
    }

    private static DocumentLineNumbering CloneLineNumbering(DocumentLineNumbering? lineNumbering)
    {
        lineNumbering ??= new DocumentLineNumbering();
        return new DocumentLineNumbering
        {
            Enabled = lineNumbering.Enabled,
            StartAt = Math.Clamp(lineNumbering.StartAt <= 0 ? 1 : lineNumbering.StartAt, 1, 9999),
            Increment = Math.Clamp(lineNumbering.Increment <= 0 ? 1 : lineNumbering.Increment, 1, 100),
            DistanceFromText = Math.Max(0, lineNumbering.DistanceFromText),
            Restart = lineNumbering.Restart
        };
    }

    private static DocumentPageMargins CloneMargins(DocumentPageMargins margins) =>
        new()
        {
            Top = margins.Top,
            Right = margins.Right,
            Bottom = margins.Bottom,
            Left = margins.Left
        };

    private static DocumentPageMargins CreateMargins(double value) =>
        new() { Top = value, Right = value, Bottom = value, Left = value };

    private static bool MarginsEqual(DocumentPageMargins margins, double top, double right, double bottom, double left) =>
        Math.Abs(margins.Top - top) < 0.01
        && Math.Abs(margins.Right - right) < 0.01
        && Math.Abs(margins.Bottom - bottom) < 0.01
        && Math.Abs(margins.Left - left) < 0.01;

    private static double ParsePoints(string? value, double min, double max, double fallback)
    {
        if (!double.TryParse(value, NumberStyles.Number, CultureInfo.InvariantCulture, out var result))
        {
            return fallback;
        }

        return Math.Max(min, Math.Min(max, result));
    }

    private static int ParseInteger(string? value, int min, int max, int fallback)
    {
        if (!int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var result))
        {
            return fallback;
        }

        return Math.Max(min, Math.Min(max, result));
    }

    private static string FormatPoints(double value) =>
        value.ToString("0.##", CultureInfo.InvariantCulture);

    private void SelectRibbonTab(DocumentRibbonTab tab)
    {
        if (tab == DocumentRibbonTab.HeaderFooter && !IsHeaderFooterMode)
        {
            return;
        }

        _activeRibbonTab = tab;
    }

    private async Task HandleRibbonTabKeyDownAsync(KeyboardEventArgs args, DocumentRibbonTab currentTab)
    {
        var tabs = RibbonTabs.ToArray();
        var currentIndex = Array.IndexOf(tabs, currentTab);
        if (currentIndex < 0)
        {
            currentIndex = Array.IndexOf(tabs, _activeRibbonTab);
        }

        var nextIndex = args.Key switch
        {
            "ArrowRight" => (currentIndex + 1) % tabs.Length,
            "ArrowLeft" => (currentIndex - 1 + tabs.Length) % tabs.Length,
            "Home" => 0,
            "End" => tabs.Length - 1,
            _ => -1
        };

        if (nextIndex >= 0)
        {
            SelectRibbonTab(tabs[nextIndex]);
            _keyboardMode = true;
            await InvokeAsync(StateHasChanged);
            await Task.Yield();
            await GetActiveTabReference().FocusAsync();
        }
    }

