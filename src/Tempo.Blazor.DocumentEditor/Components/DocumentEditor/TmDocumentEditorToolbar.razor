    private async Task HandleBlockStyleChangedAsync(ChangeEventArgs args)
    {
        var style = args.Value?.ToString();
        if (!string.IsNullOrEmpty(style))
        {
            await OnBlockStyleChanged.InvokeAsync(style);
        }
    }

    private void HandleStyleFontSizeInput(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        if (double.TryParse(value, NumberStyles.Number, CultureInfo.InvariantCulture, out var number))
        {
            _styleFontSizeValue = Math.Clamp(number, 8, 96).ToString("0.##", CultureInfo.InvariantCulture);
        }
    }

    private void HandleStyleNameInput(ChangeEventArgs args)
    {
        _styleNameValue = args.Value?.ToString();
    }

    private void HandleStyleRenameInput(ChangeEventArgs args)
    {
        _styleRenameValue = args.Value?.ToString();
    }

    private void ToggleStyleGallery()
    {
        _styleGalleryOpen = !_styleGalleryOpen;
        _focusStyleGalleryOnRender = _styleGalleryOpen;
        _focusHeaderFooterFieldMenuOnRender = false;
        _focusHeaderFooterPresetMenuOnRender = false;
        _focusPageLayoutInspectorOnRender = false;
        _focusEquationMenuOnRender = false;
        _focusSymbolMenuOnRender = false;
        _headerFooterFieldMenuOpen = false;
        _headerFooterPresetMenuOpen = false;
        _pageLayoutInspectorOpen = false;
        _tableGridPickerOpen = false;
        _imageInsertMenuOpen = false;
        _equationMenuOpen = false;
        _symbolMenuOpen = false;
    }

    private async Task ApplyQuickStyleAsync(string style)
    {
        _styleGalleryOpen = false;
        _focusStyleGalleryOnRender = false;
        await OnBlockStyleChanged.InvokeAsync(style);
    }

    private async Task ModifyCurrentStyleAsync()
    {
        var style = BuildStyleDefinition(ResolveStyleDescriptor(CurrentBlockStyle), ResolveCurrentStyleName(), withFontSize: true);
        if (style is null)
        {
            return;
        }

        await OnStyleDefinitionChanged.InvokeAsync(style);
    }

    private async Task CreateStyleFromSelectionAsync()
    {
        var styleName = _styleNameValue?.Trim();
        if (string.IsNullOrWhiteSpace(styleName))
        {
            return;
        }

        var style = BuildStyleDefinition(
            new StyleDescriptor(SlugStyleName(styleName), styleName, ResolveStyleDescriptor(CurrentBlockStyle).Id, null),
            styleName,
            withFontSize: true);
        if (style is null)
        {
            return;
        }

        await OnStyleCreatedFromSelection.InvokeAsync(style);
        await OnBlockStyleChanged.InvokeAsync(style.Id);
        _styleRenameSourceId = style.Id;
        _styleRenameValue = style.Name;
    }

    private async Task RenameCurrentStyleAsync()
    {
        var name = _styleRenameValue?.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            return;
        }

        var descriptor = ResolveStyleDescriptor(CurrentBlockStyle);
        var style = BuildStyleDefinition(descriptor, name, withFontSize: false);
        if (style is null)
        {
            return;
        }

        await OnStyleRenamed.InvokeAsync(style);
        _styleRenameSourceId = style.Id;
        _styleRenameValue = style.Name;
    }

    private async Task DeleteCurrentStyleAsync()
    {
        if (IsCurrentStyleBuiltIn)
        {
            return;
        }

        var descriptor = ResolveStyleDescriptor(CurrentBlockStyle);
        await OnStyleDeleted.InvokeAsync(new DocumentStyleDefinition
        {
            Id = descriptor.Id,
            Name = descriptor.Name,
            Type = DocumentStyleType.Paragraph
        });
        await OnBlockStyleChanged.InvokeAsync("Normal");
    }

    private Task ResetStyleFormattingAsync()
        => OnStyleFormattingReset.InvokeAsync();

    private DocumentStyleDefinition? BuildStyleDefinition(StyleDescriptor descriptor, string? name, bool withFontSize)
    {
        var styleName = name?.Trim();
        if (string.IsNullOrWhiteSpace(styleName))
        {
            return null;
        }

        var style = new DocumentStyleDefinition
        {
            Id = descriptor.Id,
            Name = styleName,
            Type = DocumentStyleType.Paragraph,
            BasedOn = descriptor.BasedOn,
            Next = "normal",
            IsQuickStyle = true,
            IsPrimary = true,
            HeadingLevel = descriptor.HeadingLevel,
            OutlineLevel = descriptor.HeadingLevel
        };

        if (withFontSize && double.TryParse(_styleFontSizeValue, NumberStyles.Number, CultureInfo.InvariantCulture, out var fontSize))
        {
            style.CharacterFormat["fontSize"] = Math.Clamp(fontSize, 8, 96);
        }

        if (descriptor.HeadingLevel is not null)
        {
            style.CharacterFormat["fontWeight"] = "700";
        }

        return style;
    }

    private Task HandleStyleGalleryKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            _styleGalleryOpen = false;
            _focusStyleGalleryOnRender = false;
        }

        return Task.CompletedTask;
    }

    private string GetQuickStyleButtonClass(string style)
        => IsCurrentQuickStyle(style)
            ? "tm-document-style-gallery__quick-style tm-document-style-gallery__quick-style--active"
            : "tm-document-style-gallery__quick-style";

    private bool IsCurrentQuickStyle(string style)
        => string.Equals(NormalizeStyleKey(CurrentBlockStyle), NormalizeStyleKey(style), StringComparison.Ordinal);

    private static StyleDescriptor ResolveStyleDescriptor(string? value)
    {
        var key = NormalizeStyleKey(value);
        if (key == "title")
        {
            return new("title", "Title", "normal", 1);
        }

        if (key.StartsWith("heading", StringComparison.Ordinal)
            && key.Length == 8
            && int.TryParse(key[^1].ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var level))
        {
            var id = FormattableString.Invariant($"heading-{level}");
            var basedOn = level <= 1 ? "normal" : FormattableString.Invariant($"heading-{level - 1}");
            return new(id, FormattableString.Invariant($"Heading {level}"), basedOn, level);
        }

        if (key == "quote")
        {
            return new("quote", "Quote", "normal", null);
        }

        if (key == "normal")
        {
            return new("normal", "Normal", null, null);
        }

        var name = string.IsNullOrWhiteSpace(value) ? "Normal" : value.Trim();
        return new(SlugStyleName(name), name, "normal", null);
    }

    private static string NormalizeStyleKey(string? value)
        => string.Concat((value ?? "Normal").Where(char.IsLetterOrDigit)).ToLowerInvariant();

    private string ResolveCurrentStyleName()
        => ResolveStyleDescriptor(CurrentBlockStyle).Name;

    private static string SlugStyleName(string value)
    {
        var slug = string.Concat(value
            .Trim()
            .ToLowerInvariant()
            .Select(character => char.IsLetterOrDigit(character) ? character : '-'))
            .Trim('-');

        while (slug.Contains("--", StringComparison.Ordinal))
        {
            slug = slug.Replace("--", "-", StringComparison.Ordinal);
        }

        return string.IsNullOrWhiteSpace(slug) ? "custom-style" : slug;
    }

