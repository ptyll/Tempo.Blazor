            <section class="tm-document-editor__ribbon-group" aria-label="@Loc["TmDocumentEditor_TabView"]">
                <button class="tm-document-editor__ribbon-button @(TemplatePreviewEnabled ? "tm-document-editor__ribbon-button--active" : null)"
