    private bool GetEffectiveListActive(bool fallback, bool isBullet)
    {
        if (DateTimeOffset.UtcNow > _optimisticListExpiresAt)
        {
            _optimisticBulletListActive = null;
            _optimisticNumberedListActive = null;
            return fallback;
        }

        if (isBullet && _optimisticBulletListActive is not null)
        {
            return _optimisticBulletListActive.Value;
        }

        if (!isBullet && _optimisticNumberedListActive is not null)
        {
            return _optimisticNumberedListActive.Value;
        }

        return fallback;
    }

