@namespace Tempo.Blazor.Components.DocumentEditor
@inherits Tempo.Blazor.Components.TmComponentBase
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Tempo.Blazor.Abstractions.Models
@using Tempo.Blazor.Components.Actions
@using Tempo.Blazor.Components.Dropdowns
@using Tempo.Blazor.Components.Files
@using Tempo.Blazor.Components.Overlay
@using Tempo.Blazor.Components.DocumentEditor.Features
@using Tempo.Blazor.Components.DocumentEditor.Registry
@using Tempo.Blazor.DocumentEditor.Models

<header class="@ToolbarClass"
        role="group"
        aria-label="@Loc["TmDocumentEditor_ToolbarLabel"]"
        hidden="@(ToolbarMode == DocumentToolbarMode.DistractionFree)"
        data-testid="@TestId("document-toolbar")"
        data-focus-region="ribbon"
        data-keyboard-mode="@_keyboardMode.ToString().ToLowerInvariant()"
        data-toolbar-mode="@ToolbarMode.ToString()"
        data-active-ribbon-tab="@ActiveRibbonTabDataValue"
        data-track-changes-state="@TrackChangesState"
        @onkeydown="HandleToolbarKeyDown">
    <div class="tm-document-editor__ribbon-tabs" role="tablist" aria-label="@Loc["TmDocumentEditor_ToolbarTabsLabel"]">
        <button type="button"
                @ref="_homeTab"
                class="@GetRibbonTabClass(DocumentRibbonTab.Home)"
                id="@GetRibbonTabId(DocumentRibbonTab.Home)"
                role="tab"
                aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.Home)"
                aria-current="@GetRibbonTabCurrent(DocumentRibbonTab.Home)"
                aria-controls="@RibbonPanelId"
                tabindex="@GetRibbonTabIndex(DocumentRibbonTab.Home)"
                @onclick="() => SelectRibbonTab(DocumentRibbonTab.Home)"
                @onkeydown="args => HandleRibbonTabKeyDownAsync(args, DocumentRibbonTab.Home)"
                @onpointerdown:preventDefault="true"
                @onmousedown:preventDefault="true"
                data-ribbon-tab="@GetRibbonTabDataValue(DocumentRibbonTab.Home)"
                data-active="@GetRibbonTabSelected(DocumentRibbonTab.Home)"
                data-testid="@TestId("document-ribbon-tab-home")">@Loc["TmDocumentEditor_TabHome"]</button>
        <button type="button"
                @ref="_insertTab"
                class="@GetRibbonTabClass(DocumentRibbonTab.Insert)"
                id="@GetRibbonTabId(DocumentRibbonTab.Insert)"
                role="tab"
                aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.Insert)"
                aria-current="@GetRibbonTabCurrent(DocumentRibbonTab.Insert)"
                aria-controls="@RibbonPanelId"
                tabindex="@GetRibbonTabIndex(DocumentRibbonTab.Insert)"
                @onclick="() => SelectRibbonTab(DocumentRibbonTab.Insert)"
                @onkeydown="args => HandleRibbonTabKeyDownAsync(args, DocumentRibbonTab.Insert)"
                @onpointerdown:preventDefault="true"
                @onmousedown:preventDefault="true"
                data-ribbon-tab="@GetRibbonTabDataValue(DocumentRibbonTab.Insert)"
                data-active="@GetRibbonTabSelected(DocumentRibbonTab.Insert)"
                data-testid="@TestId("document-ribbon-tab-insert")">@Loc["TmDocumentEditor_TabInsert"]</button>
        @if (!PhoneLayout)
        {
            <button type="button"
                    @ref="_mathTab"
                    class="@GetRibbonTabClass(DocumentRibbonTab.Math)"
                    id="@GetRibbonTabId(DocumentRibbonTab.Math)"
                    role="tab"
                    aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.Math)"
                    aria-current="@GetRibbonTabCurrent(DocumentRibbonTab.Math)"
                    aria-controls="@RibbonPanelId"
                    tabindex="@GetRibbonTabIndex(DocumentRibbonTab.Math)"
                    @onclick="() => SelectRibbonTab(DocumentRibbonTab.Math)"
                    @onkeydown="args => HandleRibbonTabKeyDownAsync(args, DocumentRibbonTab.Math)"
                    @onpointerdown:preventDefault="true"
                    @onmousedown:preventDefault="true"
                    data-ribbon-tab="@GetRibbonTabDataValue(DocumentRibbonTab.Math)"
                    data-active="@GetRibbonTabSelected(DocumentRibbonTab.Math)"
                    data-testid="@TestId("document-ribbon-tab-math")">@Loc["TmDocumentEditor_TabMath"]</button>
        }
        @if (!PhoneLayout)
        {
            <button type="button"
                    @ref="_layoutTab"
                    class="@GetRibbonTabClass(DocumentRibbonTab.Layout)"
                    id="@GetRibbonTabId(DocumentRibbonTab.Layout)"
                    role="tab"
                    aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.Layout)"
                    aria-current="@GetRibbonTabCurrent(DocumentRibbonTab.Layout)"
                    aria-controls="@RibbonPanelId"
                    tabindex="@GetRibbonTabIndex(DocumentRibbonTab.Layout)"
                    @onclick="() => SelectRibbonTab(DocumentRibbonTab.Layout)"
                    @onkeydown="args => HandleRibbonTabKeyDownAsync(args, DocumentRibbonTab.Layout)"
                    @onpointerdown:preventDefault="true"
                    @onmousedown:preventDefault="true"
                    data-ribbon-tab="@GetRibbonTabDataValue(DocumentRibbonTab.Layout)"
                    data-active="@GetRibbonTabSelected(DocumentRibbonTab.Layout)"
                    data-testid="@TestId("document-ribbon-tab-layout")">@Loc["TmDocumentEditor_TabLayout"]</button>
        }
        @if (!PhoneLayout)
        {
            <button type="button"
                    @ref="_referencesTab"
                    class="@GetRibbonTabClass(DocumentRibbonTab.References)"
                    id="@GetRibbonTabId(DocumentRibbonTab.References)"
                    role="tab"
                    aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.References)"
                    aria-current="@GetRibbonTabCurrent(DocumentRibbonTab.References)"
                    aria-controls="@RibbonPanelId"
                    tabindex="@GetRibbonTabIndex(DocumentRibbonTab.References)"
                    @onclick="() => SelectRibbonTab(DocumentRibbonTab.References)"
                    @onkeydown="args => HandleRibbonTabKeyDownAsync(args, DocumentRibbonTab.References)"
                    @onpointerdown:preventDefault="true"
                    @onmousedown:preventDefault="true"
                    data-ribbon-tab="@GetRibbonTabDataValue(DocumentRibbonTab.References)"
                    data-active="@GetRibbonTabSelected(DocumentRibbonTab.References)"
                    data-testid="@TestId("document-ribbon-tab-references")">@Loc["TmDocumentEditor_TabReferences"]</button>
        }
        <button type="button"
                @ref="_reviewTab"
                class="@GetRibbonTabClass(DocumentRibbonTab.Review)"
                id="@GetRibbonTabId(DocumentRibbonTab.Review)"
                role="tab"
                aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.Review)"
                aria-current="@GetRibbonTabCurrent(DocumentRibbonTab.Review)"
                aria-controls="@RibbonPanelId"
                tabindex="@GetRibbonTabIndex(DocumentRibbonTab.Review)"
                @onclick="() => SelectRibbonTab(DocumentRibbonTab.Review)"
                @onkeydown="args => HandleRibbonTabKeyDownAsync(args, DocumentRibbonTab.Review)"
                @onpointerdown:preventDefault="true"
                @onmousedown:preventDefault="true"
                data-ribbon-tab="@GetRibbonTabDataValue(DocumentRibbonTab.Review)"
                data-active="@GetRibbonTabSelected(DocumentRibbonTab.Review)"
                data-testid="@TestId("document-ribbon-tab-review")">@Loc["TmDocumentEditor_TabReview"]</button>
        <button type="button"
                @ref="_viewTab"
                class="@GetRibbonTabClass(DocumentRibbonTab.View)"
                id="@GetRibbonTabId(DocumentRibbonTab.View)"
                role="tab"
                aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.View)"
                aria-current="@GetRibbonTabCurrent(DocumentRibbonTab.View)"
                aria-controls="@RibbonPanelId"
                tabindex="@GetRibbonTabIndex(DocumentRibbonTab.View)"
                @onclick="() => SelectRibbonTab(DocumentRibbonTab.View)"
                @onkeydown="args => HandleRibbonTabKeyDownAsync(args, DocumentRibbonTab.View)"
                @onpointerdown:preventDefault="true"
                @onmousedown:preventDefault="true"
                data-ribbon-tab="@GetRibbonTabDataValue(DocumentRibbonTab.View)"
                data-active="@GetRibbonTabSelected(DocumentRibbonTab.View)"
                data-testid="@TestId("document-ribbon-tab-view")">@Loc["TmDocumentEditor_TabView"]</button>
        @if (IsHeaderFooterMode)
        {
            <button type="button"
                    @ref="_headerFooterTab"
                    class="@GetRibbonTabClass(DocumentRibbonTab.HeaderFooter)"
                    id="@GetRibbonTabId(DocumentRibbonTab.HeaderFooter)"
                    role="tab"
                    aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.HeaderFooter)"
                    aria-current="@GetRibbonTabCurrent(DocumentRibbonTab.HeaderFooter)"
                    aria-controls="@RibbonPanelId"
                    tabindex="@GetRibbonTabIndex(DocumentRibbonTab.HeaderFooter)"
                    @onclick="() => SelectRibbonTab(DocumentRibbonTab.HeaderFooter)"
                    @onkeydown="args => HandleRibbonTabKeyDownAsync(args, DocumentRibbonTab.HeaderFooter)"
                    @onpointerdown:preventDefault="true"
                    @onmousedown:preventDefault="true"
                    data-ribbon-tab="@GetRibbonTabDataValue(DocumentRibbonTab.HeaderFooter)"
                    data-active="@GetRibbonTabSelected(DocumentRibbonTab.HeaderFooter)"
                    data-testid="@TestId("document-ribbon-tab-header-footer")">@Loc["TmDocumentEditor_TabHeaderFooter"]</button>
        }
    </div>

    <div class="tm-document-editor__ribbon-commands-wrapper">
    <div id="@RibbonPanelId"
         @ref="_ribbonPanel"
         class="tm-document-editor__ribbon-groups"
         role="tabpanel"
         aria-labelledby="@GetRibbonTabId(_activeRibbonTab)"
         data-testid="@TestId("document-ribbon-panel")"
         data-active-ribbon-tab="@ActiveRibbonTabDataValue">
        @* The ribbon runs on the core TmToolbar (redesign 146c7e1b, DE-1.2): tm-toolbar.js measures how many commands fit,
           the shared partition (by priority) decides which leave, and the core "More" menu - a role=menu with grouped
           sections, arrow keys and typeahead - offers the rest. The ribbon keeps no overflow logic of its own. *@
        <TmToolbar Class="tm-document-editor__ribbon-toolbar"
                   Overflow="ToolbarOverflow.Menu"
                   OverflowPresentation="@(PhoneLayout ? PanelPresentation.Auto : PanelPresentation.Popover)"
                   Labels="ToolbarLabels.ShrinkBeforeOverflow"
                   AriaLabel="@Loc["TmDocumentEditor_RibbonCommandsLabel"]"
                   OverflowLabel="@Loc["TmDocumentEditor_MoreCommands"]"
                   data-testid="@TestId("document-ribbon-toolbar")">
            @if (ShowQuickAccess)
            {
                <TmToolbarGroup Class="tm-document-editor__ribbon-group tm-document-editor__ribbon-group--quick-access" Label="@Loc["TmDocumentEditor_GroupClipboard"]">
                    @if (!PhoneLayout)
                    {
                        @* A phone's Save is the primary tile of the action bar (exactly one Save per editor). *@
                        <DocumentRibbonButton Icon="save"
                                              Text="@Loc["TmDocumentEditor_Save"]"
                                              Disabled="@(!CanExecuteSave)"
                                              Tooltip="@SaveTitle"
                                              AriaLabel="@SaveTitle"
                                              OnClick='() => ExecuteToolbarCommandAsync("save", OnSave, !ReadOnly && !IsSaving)'
                                              Command="save"
                                              TestId="@TestId("document-save")" />
                    }
                    <DocumentRibbonButton Icon="undo-2"
                                          Text="@Loc["TmDocumentEditor_Undo"]"
                                          Disabled="@(!CanExecuteUndo)"
                                          Tooltip="@UndoTitle"
                                          AriaLabel="@UndoTitle"
                                          OnClick='() => ExecuteToolbarCommandAsync("undo", OnUndo, !ReadOnly && CanUndo)'
                                          Command="undo"
                                          TestId="@TestId("document-undo")" />
                    <DocumentRibbonButton Icon="redo-2"
                                          Text="@Loc["TmDocumentEditor_Redo"]"
                                          Disabled="@(!CanExecuteRedo)"
                                          Tooltip="@RedoTitle"
                                          AriaLabel="@RedoTitle"
                                          OnClick='() => ExecuteToolbarCommandAsync("redo", OnRedo, !ReadOnly && CanRedo)'
                                          Command="redo"
                                          TestId="@TestId("document-redo")" />
                </TmToolbarGroup>
                <TmToolbarDivider />
            }
        @if (_activeRibbonTab == DocumentRibbonTab.Home)
        {
            <TmToolbarGroup Class="tm-document-editor__ribbon-group tm-document-editor__ribbon-group--style" Label="@Loc["TmDocumentEditor_GroupStyle"]">
                @if (ShowBlockStyle)
                {
                    <TmToolbarItem Class="tm-document-editor__ribbon-item tm-document-editor__ribbon-item--style"
                                   Priority="@CorePriority("blockStyle")"
                                   Disabled="@ReadOnly"
                                   MenuLabel="@Loc["TmDocumentEditor_BlockStyle"]"
                                   MenuItems="@BlockStyleMenuItems()">
                        <label class="tm-document-editor__ribbon-select tm-document-editor__ribbon-select--style" title="@Loc["TmDocumentEditor_BlockStyle"]">
                            <span class="tm-sr-only">@Loc["TmDocumentEditor_BlockStyle"]</span>
                            <select value="@SelectedBlockStyleValue"
                                    @onchange="HandleBlockStyleChangedAsync"
                                    aria-label="@Loc["TmDocumentEditor_BlockStyle"]"
                                    data-command="blockStyle"
                                    data-priority="@PriorityData("blockStyle")"
                                    data-testid="@TestId("document-block-style")">
                                @if (IsCurrentBlockStyleCustom)
                                {
                                    <option value="@CurrentBlockStyle">@ResolveCurrentStyleName()</option>
                                }
                                <option value="Normal">@Loc["TmDocumentEditor_StyleNormal"]</option>
                                <option value="Title">@Loc["TmDocumentEditor_StyleTitle"]</option>
                                <option value="Heading1">@Loc["TmDocumentEditor_Heading1"]</option>
                                <option value="Heading2">@Loc["TmDocumentEditor_Heading2"]</option>
                                <option value="Heading3">@Loc["TmDocumentEditor_Heading3"]</option>
                                <option value="Heading4">@Loc["TmDocumentEditor_Heading4"]</option>
                                <option value="Heading5">@Loc["TmDocumentEditor_Heading5"]</option>
                                <option value="Heading6">@Loc["TmDocumentEditor_Heading6"]</option>
                                <option value="Quote">@Loc["TmDocumentEditor_StyleQuote"]</option>
                            </select>
                        </label>
                    </TmToolbarItem>
                    @if (ShowStyleManagement)
                    {
                        @* OverflowOnly (a More entry, never on the bar): the gallery is a floating panel rendered after the toolbar (see
                           FloatingPanels), anchored to the ribbon row, so it opens the same way whatever the width. *@
                        <DocumentRibbonButton Icon="gallery-horizontal-end"
                                              Text="@Loc["TmDocumentEditor_StyleGallery"]"
                                              Disabled="@ReadOnly"
                                              Tooltip="@(GetEditingCommandTitle(Loc["TmDocumentEditor_StyleGallery"]))"
                                              OnClick="ToggleStyleGallery"
                                              Command="styleGallery"
                                              TestId="@TestId("document-style-gallery-toggle")"
                                              aria-haspopup="dialog"
                                              aria-controls="@(_styleGalleryOpen ? FloatingPanelId("style-gallery") : null)"
                                              aria-expanded="@_styleGalleryOpen.ToString().ToLowerInvariant()" />
                    }
                }
                <TmToolbarItem Class="tm-document-editor__ribbon-item tm-document-editor__ribbon-item--font"
                               Priority="@CorePriority("fontFamily")"
                               Disabled="@(!IsCommandEnabled("fontFamily"))"
                               MenuLabel="@Loc["TmDocumentEditor_FontFamily"]"
                               MenuItems="@FontFamilyMenuItems()">
                    <label class="tm-document-editor__ribbon-select tm-document-editor__ribbon-select--font" title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_FontFamily"]))">
                        <span class="tm-sr-only">@Loc["TmDocumentEditor_FontFamily"]</span>
                        <select disabled="@(!IsCommandEnabled("fontFamily"))"
                                value="@(FontFamilyMixed ? "__mixed" : CurrentFontFamily)"
                                title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_FontFamily"]))"
                                aria-label="@Loc["TmDocumentEditor_FontFamily"]"
                                @onchange="HandleFontFamilyChangedAsync"
                                data-priority="@PriorityData("fontFamily")"
                                data-testid="@TestId("document-font-family")">
                            @if (FontFamilyMixed)
                            {
                                <option value="__mixed" selected disabled>@Loc["TmDocumentEditor_MixedFormatting"]</option>
                            }
                            else if (IsFontFamilyUnknown)
                            {
                                <option value="@CurrentFontFamily" selected>@FontFamilyLabel(CurrentFontFamily)</option>
                            }
                            <option value="">@Loc["TmDocumentEditor_FontFamilyDefault"]</option>
                            @foreach (var font in FontFamilies)
                            {
                                <option value="@font.CssFamily">@font.DisplayName</option>
                            }
                        </select>
                    </label>
                </TmToolbarItem>
                <TmToolbarItem Class="tm-document-editor__ribbon-item tm-document-editor__ribbon-item--size"
                               Priority="@CorePriority("fontSize")"
                               Disabled="@(!IsCommandEnabled("fontSize"))"
                               MenuLabel="@Loc["TmDocumentEditor_FontSize"]"
                               MenuItems="@FontSizeMenuItems()">
                    <label class="tm-document-editor__ribbon-select tm-document-editor__ribbon-select--size" title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_FontSize"]))">
                        <span class="tm-sr-only">@Loc["TmDocumentEditor_FontSize"]</span>
                        <select disabled="@(!IsCommandEnabled("fontSize"))"
                                value="@(FontSizeMixed ? string.Empty : NormalizeFontSizeValue(CurrentFontSize))"
                                title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_FontSize"]))"
                                aria-label="@Loc["TmDocumentEditor_FontSize"]"
                                @onchange="HandleFontSizeChangedAsync"
                                data-priority="@PriorityData("fontSize")"
                                data-testid="@TestId("document-font-size")">
                            @if (FontSizeMixed)
                            {
                                <option value="">@Loc["TmDocumentEditor_MixedFormatting"]</option>
                            }
                            @foreach (var size in FontSizes)
                            {
                                <option value="@size">@($"{size} pt")</option>
                            }
                        </select>
                    </label>
                </TmToolbarItem>
            </TmToolbarGroup>
            <TmToolbarDivider />
            <TmToolbarGroup Class="tm-document-editor__ribbon-group tm-document-editor__ribbon-group--character" Label="@Loc["TmDocumentEditor_GroupCharacter"]">
                <DocumentRibbonButton Icon="bold"
                                      Text="@Loc["TmDocumentEditor_Bold"]"
                                      Disabled="@(!IsCommandEnabled("bold"))"
                                      Tooltip="@(GetEditingCommandTitle(Loc["TmDocumentEditor_Bold"]))"
                                      PressedState="@GetRegistryFormattingAriaPressed("bold", BoldState)"
                                      OnClick='() => ExecuteToolbarCommandAsync("bold", OnBold)'
                                      Command="bold"
                                      TestId="@TestId("document-bold")" />
                <DocumentRibbonButton Icon="italic"
                                      Text="@Loc["TmDocumentEditor_Italic"]"
                                      Disabled="@(!IsCommandEnabled("italic"))"
                                      Tooltip="@(GetEditingCommandTitle(Loc["TmDocumentEditor_Italic"]))"
                                      PressedState="@GetRegistryFormattingAriaPressed("italic", ItalicState)"
                                      OnClick='() => ExecuteToolbarCommandAsync("italic", OnItalic)'
                                      Command="italic"
                                      TestId="@TestId("document-italic")" />
                <DocumentRibbonButton Icon="underline"
                                      Text="@Loc["TmDocumentEditor_Underline"]"
                                      Disabled="@(!IsCommandEnabled("underline"))"
                                      Tooltip="@(GetEditingCommandTitle(Loc["TmDocumentEditor_Underline"]))"
                                      PressedState="@GetRegistryFormattingAriaPressed("underline", UnderlineState)"
                                      OnClick='() => ExecuteToolbarCommandAsync("underline", OnUnderline)'
                                      Command="underline"
                                      TestId="@TestId("document-underline")" />
                <DocumentRibbonButton Icon="strikethrough"
                                      Text="@Loc["TmDocumentEditor_Strikethrough"]"
                                      Disabled="@(!IsCommandEnabled("strikethrough"))"
                                      Tooltip="@(GetEditingCommandTitle(Loc["TmDocumentEditor_Strikethrough"]))"
                                      PressedState="@GetRegistryFormattingAriaPressed("strikethrough", StrikethroughState)"
                                      OnClick='() => ExecuteToolbarCommandAsync("strikethrough", OnStrikethrough)'
                                      Command="strikethrough"
                                      Priority="@PhonePrimary("strikethrough")"
                                      TestId="@TestId("document-strikethrough")" />
                <TmToolbarItem Class="tm-document-editor__ribbon-item tm-document-editor__ribbon-item--color"
                               Priority="@CorePriority("textColor")"
                               Disabled="@(!IsCommandEnabled("textColor"))"
                               MenuLabel="@Loc["TmDocumentEditor_FontColor"]"
                               MenuItems="@TextColorMenuItems()">
                    <div class="tm-document-editor__ribbon-color-picker"
                         title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_FontColor"]))"
                         data-command="textColor"
                         data-priority="@PriorityData("textColor")">
                        <TmColorPicker Value="@NormalizeColorValue(CurrentTextColor, string.Empty)"
                                       ValueChanged="HandleTextColorAppliedAsync"
                                       Format="ColorFormat.Hex"
                                       ShowAlpha="false"
                                       ShowGradient="false"
                                       ShowHexInput="true"
                                       ShowPalette="true"
                                       PaletteColors="DocumentTextColors"
                                       PaletteColorNames="@ColorNames"
                                       PaletteColumns="6"
                                       ShowClearButton="false"
                                       ShowApplyButton="true"
                                       ShowCancelButton="true"
                                       Disabled="@(!IsCommandEnabled("textColor"))"
                                       Placeholder="@Loc["TmDocumentEditor_FontColor"]"
                                       TriggerIcon="type"
                                       TriggerAriaLabel="@ColorTriggerLabel(Loc["TmDocumentEditor_FontColor"], CurrentTextColor, TextColorMixed)"
                                       ApplyText="@Loc["TmDocumentEditor_ApplyColor"]"
                                       CancelText="@Loc["TmDocumentEditor_CancelColor"]"
                                       Class="@GetTempoColorPickerClass(TextColorMixed)"
                                       data-testid="@TestId("document-font-color-trigger")" />
                    </div>
                </TmToolbarItem>
                <TmToolbarItem Class="tm-document-editor__ribbon-item tm-document-editor__ribbon-item--color"
                               Priority="@CorePriority("highlightColor")"
                               Disabled="@(!IsCommandEnabled("highlightColor"))"
                               MenuLabel="@Loc["TmDocumentEditor_HighlightColor"]"
                               MenuItems="@HighlightColorMenuItems()">
                    <div class="tm-document-editor__ribbon-color-picker"
                         title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_HighlightColor"]))"
                         data-command="highlightColor"
                         data-priority="@PriorityData("highlightColor")">
                        <TmColorPicker Value="@NormalizeColorValue(CurrentHighlightColor, string.Empty)"
                                       ValueChanged="HandleHighlightColorAppliedAsync"
                                       Format="ColorFormat.Hex"
                                       ShowAlpha="false"
                                       ShowGradient="false"
                                       ShowHexInput="true"
                                       ShowPalette="true"
                                       PaletteColors="DocumentHighlightColors"
                                       PaletteColorNames="@ColorNames"
                                       PaletteColumns="6"
                                       ShowClearButton="true"
                                       ShowApplyButton="true"
                                       ShowCancelButton="true"
                                       Disabled="@(!IsCommandEnabled("highlightColor"))"
                                       Placeholder="@Loc["TmDocumentEditor_HighlightColor"]"
                                       TriggerIcon="highlighter"
                                       TriggerAriaLabel="@ColorTriggerLabel(Loc["TmDocumentEditor_HighlightColor"], CurrentHighlightColor, HighlightColorMixed)"
                                       ApplyText="@Loc["TmDocumentEditor_ApplyColor"]"
                                       CancelText="@Loc["TmDocumentEditor_CancelColor"]"
                                       Class="@GetTempoColorPickerClass(HighlightColorMixed)"
                                       data-testid="@TestId("document-highlight-color-trigger")" />
                    </div>
                </TmToolbarItem>
            </TmToolbarGroup>
            <TmToolbarDivider />
            <TmToolbarGroup Class="tm-document-editor__ribbon-group tm-document-editor__ribbon-group--paragraph" Label="@Loc["TmDocumentEditor_GroupParagraph"]">
                <TmToolbarItem Class="tm-document-editor__ribbon-item tm-document-editor__ribbon-item--alignment"
                               Priority="@CorePriority("alignment")"
                               Disabled="@(!IsCommandEnabled("paragraphAlignment"))"
                               MenuLabel="@Loc["TmDocumentEditor_GroupAlignment"]"
                               MenuItems="@AlignmentMenuItems()">
                    <TmDropdown Icon="@AlignmentIcon(EffectiveAlignmentForDisplay)"
                                Text=""
                                AriaLabel="@($"{Loc["TmDocumentEditor_GroupAlignment"]}: {AlignmentLabel(EffectiveAlignmentForDisplay)}")"
                                Disabled="@(!IsCommandEnabled("paragraphAlignment"))"
                                Class="tm-document-editor__ribbon-alignment"
                                OnSelect="HandleAlignmentSelectedAsync"
                                data-command="alignment"
                                data-priority="@PriorityData("alignment")"
                                data-testid="@TestId("document-align")">
                        @foreach (var alignment in AlignmentChoices)
                        {
                            <TmDropdownItem Value="@alignment.ToString()"
                                            Icon="@AlignmentIcon(alignment)"
                                            Checked="@(CurrentAlignmentChoice == alignment)"
                                            data-testid="@TestId($"document-align-{alignment.ToString().ToLowerInvariant()}")">@AlignmentLabel(alignment)</TmDropdownItem>
                        }
                    </TmDropdown>
                </TmToolbarItem>
                <DocumentRibbonButton Icon="list"
                                      Text="@Loc["TmDocumentEditor_BulletedList"]"
                                      Disabled="@(!IsCommandEnabled("bulletList"))"
                                      Tooltip="@(GetEditingCommandTitle(Loc["TmDocumentEditor_BulletedList"]))"
                                      AriaLabel="@Loc["TmDocumentEditor_BulletedList"]"
                                      PressedState="@GetListAriaPressed(BulletListActive, isBullet: true)"
                                      OnClick='() => ExecuteToolbarCommandAsync("bulletList", HandleToggleBulletListAsync)'
                                      Command="bulletList"
                                      Priority="@PhonePrimary("bulletList")"
                                      TestId="@TestId("document-bullet-list")" />
                <DocumentRibbonButton Icon="list-ordered"
                                      Text="@Loc["TmDocumentEditor_NumberedList"]"
                                      Disabled="@(!IsCommandEnabled("numberedList"))"
                                      Tooltip="@(GetEditingCommandTitle(Loc["TmDocumentEditor_NumberedList"]))"
                                      AriaLabel="@Loc["TmDocumentEditor_NumberedList"]"
                                      PressedState="@GetListAriaPressed(NumberedListActive, isBullet: false)"
                                      OnClick='() => ExecuteToolbarCommandAsync("numberedList", HandleToggleNumberedListAsync)'
                                      Command="numberedList"
                                      TestId="@TestId("document-numbered-list")" />
                <TmToolbarItem Class="tm-document-editor__ribbon-item tm-document-editor__ribbon-item--spacing"
                               Priority="@CorePriority("lineSpacing")"
                               Disabled="@(!IsCommandEnabled("lineSpacing"))"
                               MenuLabel="@Loc["TmDocumentEditor_LineSpacing"]"
                               MenuItems="@LineSpacingMenuItems()">
                    <label class="tm-document-editor__ribbon-select tm-document-editor__ribbon-select--spacing" title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_LineSpacing"]))">
