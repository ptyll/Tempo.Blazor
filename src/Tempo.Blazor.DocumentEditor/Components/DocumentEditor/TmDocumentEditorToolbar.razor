    private Task HandleMarginChangedAsync(string side, ChangeEventArgs args)
    {
        var settings = EffectivePageSettings;
        var margins = CloneMargins(settings.Margins);
        var value = ParsePoints(args.Value?.ToString(), 0, 144, 72);
        switch (side)
        {
            case "Top":
                margins.Top = value;
                break;
            case "Right":
                margins.Right = value;
                break;
            case "Bottom":
                margins.Bottom = value;
                break;
            case "Left":
                margins.Left = value;
                break;
        }

        settings.Margins = margins;
        return RaisePageSetupChangedAsync(settings, EffectiveSectionColumns, EffectiveLineNumbering);
    }

