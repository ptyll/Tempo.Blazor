    // ─── floating panels (redesign 146c7e1b, phase 5) ───────────────────────────────────────────────────────────────────
    // ONE panel is open at a time. The panels are TmDocumentFloatingPanel (core TmOverlayPanel in the top layer) rendered AFTER the
    // toolbar, so a trigger that collapsed into "More" can still open its panel. An outside press closes the panel and is NOT
    // swallowed (the header Undo, a canvas click and another ribbon button all still run); Escape closes it and gives focus back
    // to the canvas through OnRestoreFocus.

    private enum ToolbarFloating
    {
        None,
        StyleGallery,
        Table,
        Equation,
        Symbol,
        PageLayout,
        HeaderFooterFields,
        HeaderFooterPresets,
        Link,
    }

    private string FloatingPanelId(string kind) => $"{_floatingIdPrefix}-{kind}";

    private ElementReference FloatingAnchor(DocumentRibbonButton? trigger)
        => _floatingFromMenu || trigger is null || trigger.Element.Id is null ? _ribbonPanel : trigger.Element;

    private OverlayAlign FloatingAlign => _floatingFromMenu ? OverlayAlign.End : OverlayAlign.Start;

    private void OpenFloating(ToolbarFloating kind, bool fromMenu)
    {
        _floating = kind;
        _floatingFromMenu = fromMenu;
    }

    private void ToggleFloating(ToolbarFloating kind, bool fromMenu = false)
    {
        if (_floating == kind)
        {
            CloseToolbarFloatingUi();
            return;
        }

        OpenFloating(kind, fromMenu);
    }

    /// <summary>Closes the open ribbon panel. Raised by the panel's own X / Escape / outside press and after a choice applied.</summary>
    private void CloseToolbarFloatingUi()
    {
        _floating = ToolbarFloating.None;
        _floatingFromMenu = false;
    }

    // The close report of a panel arrives asynchronously (overlay.js -> .NET): when the press that dismissed it was on ANOTHER ribbon
    // trigger, that trigger's click may already have opened the next panel. A report only closes the panel it came from.
    private async Task HandleFloatingClosedAsync(ToolbarFloating kind, DocumentFloatingCloseReason reason)
    {
        if (_floating != kind)
        {
            return;
        }

        // The sheet's Done is the form's confirm: a link panel applies the URL when there is a valid one, then closes (an empty or unsafe
        // draft is discarded like a cancel - the sheet has no Apply button to leave open).
        if (kind == ToolbarFloating.Link && reason == DocumentFloatingCloseReason.Done
            && !string.IsNullOrWhiteSpace(_pendingLinkUrl)
            && DocumentLinkUtility.IsSafeHref(DocumentLinkUtility.NormalizeHref(_pendingLinkUrl)))
        {
            await ApplyLinkAsync();
            return;
        }

        // The link panel keeps its draft only while it is open; every other panel is stateless.
        if (kind == ToolbarFloating.Link)
        {
            ResetLinkDraft();
        }

        CloseToolbarFloatingUi();
    }

