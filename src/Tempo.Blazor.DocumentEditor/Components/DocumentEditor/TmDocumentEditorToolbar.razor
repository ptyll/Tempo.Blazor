    private void HandleLinkUrlInput(ChangeEventArgs args)
    {
        _pendingLinkUrl = args.Value?.ToString();
        // Inline validation while typing: an empty field is not an error yet (Apply stays the gate); an unsafe value says so at once.
        var href = DocumentLinkUtility.NormalizeHref(_pendingLinkUrl);
        _linkError = string.IsNullOrWhiteSpace(_pendingLinkUrl) || DocumentLinkUtility.IsSafeHref(href)
            ? null
            : Loc["TmDocumentEditor_LinkInvalidUrl"];
    }

    private async Task HandleLinkInputKeyDownAsync(KeyboardEventArgs args)
    {
        // Enter in a text field submits (a field has no native activation); Escape is the core panel's (window capture).
        if (args.Key == "Enter")
        {
            await ApplyLinkAsync();
        }
    }

    private async Task ApplyLinkAsync()
    {
        var href = DocumentLinkUtility.NormalizeHref(_pendingLinkUrl);
        if (!DocumentLinkUtility.IsSafeHref(href))
        {
            _linkError = Loc["TmDocumentEditor_LinkInvalidUrl"];
            return;
        }

        var payload = new WysiwygLinkPayload
        {
            Href = href,
            Title = string.IsNullOrWhiteSpace(_pendingLinkTitle) ? null : _pendingLinkTitle.Trim()
        };

        ResetLinkDraft();
        CloseToolbarFloatingUi();
        if (OnLinkApplied.HasDelegate)
        {
            await OnLinkApplied.InvokeAsync(payload);
        }
        else
        {
            await OnLink.InvokeAsync(payload.Href);
        }
    }

    private async Task RemoveLinkAsync()
    {
        if (!OnLinkRemoved.HasDelegate)
        {
            return;
        }

        ResetLinkDraft();
        CloseToolbarFloatingUi();
        await OnLinkRemoved.InvokeAsync();
    }

