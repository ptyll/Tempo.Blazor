    private Task HandleColumnCountChangedAsync(ChangeEventArgs args)
    {
        var columns = EffectiveSectionColumns;
        columns.Count = ParseInteger(args.Value?.ToString(), 1, 3, 1);
        columns.Preset = columns.Count switch
        {
            2 => "two",
            3 => "three",
            _ => "one"
        };
        columns.Items = [];
        return RaisePageSetupChangedAsync(EffectivePageSettings, columns, EffectiveLineNumbering);
    }

