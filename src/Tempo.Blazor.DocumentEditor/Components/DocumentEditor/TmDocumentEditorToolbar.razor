    private bool CanExecuteUndo =>
        !ReadOnly && (CanUndo || (CommandRegistry?.GetState("undo")?.IsEnabled ?? false));

    private bool CanExecuteRedo =>
        !ReadOnly && (CanRedo || (CommandRegistry?.GetState("redo")?.IsEnabled ?? false));

    // Fáze 16 — sjednocený fallback (jedno chování napříč cestami):
    //   * Registry PŘIPOJENÝ = zdroj pravdy. Nezaregistrovaný příkaz ⇒ DISABLED tady a v overflow,
    //     HIDDEN v deklarativní cestě (DocumentEditorToolbarRegistry.IsAvailable drop) — obě cesty
    //     shodně říkají „příkaz není k dispozici" místo dřívějšího enabled-ale-mrtvého tlačítka.
    //   * BEZ registry (standalone toolbar, 2.0.x konzumenti) platí historický fallback !ReadOnly.
    private bool IsCommandEnabled(string commandName) =>
        CommandRegistry is null ? !ReadOnly : CommandRegistry.GetState(commandName)?.IsEnabled ?? false;

    private bool IsCommandEnabled(string commandName, bool fallback) =>
        CommandRegistry is null ? fallback : CommandRegistry.GetState(commandName)?.IsEnabled ?? false;

    private static string AriaDisabled(bool disabled)
        => disabled ? "true" : "false";

    private Task ExecuteToolbarCommandAsync(string commandName, EventCallback callback, bool fallback = true)
    {
        if (!IsCommandEnabled(commandName, fallback))
