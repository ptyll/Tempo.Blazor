    private async Task ApplyLinkAsync()
    {
        var href = DocumentLinkUtility.NormalizeHref(_pendingLinkUrl);
        if (!DocumentLinkUtility.IsSafeHref(href))
        {
            _linkError = Loc["TmDocumentEditor_LinkInvalidUrl"];
            return;
        }

        var payload = new WysiwygLinkPayload
        {
            Href = href,
            Title = string.IsNullOrWhiteSpace(_pendingLinkTitle) ? null : _pendingLinkTitle.Trim()
        };

        if (OnLinkApplied.HasDelegate)
        {
            await OnLinkApplied.InvokeAsync(payload);
        }
        else
        {
            await OnLink.InvokeAsync(payload.Href);
        }

        _pendingLinkUrl = null;
        _pendingLinkTitle = null;
        _linkError = null;
        _linkDialogOpen = false;
    }

    private async Task RemoveLinkAsync()
    {
        if (!OnLinkRemoved.HasDelegate)
        {
            return;
        }

        await OnLinkRemoved.InvokeAsync();
        _pendingLinkUrl = null;
        _pendingLinkTitle = null;
        _linkError = null;
        _linkDialogOpen = false;
    }

