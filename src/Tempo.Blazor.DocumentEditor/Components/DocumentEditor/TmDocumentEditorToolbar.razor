    private Task ClosePageLayoutAsync()
    {
        CloseToolbarFloatingUi();
        return OnRestoreFocus.InvokeAsync();
    }

    // A numeric field of the page layout: the value, the unit suffix (pt) and the id the input is described by, so a screen reader
    // reads "Top, 24, pt". Every field keeps its live @oninput (the editor relayouts as the value is typed - the same cost as before).
    private RenderFragment PointsField(string testId, string label, string value, Func<ChangeEventArgs, Task> onInput, int max = 144, int step = 6) => @<label class="tm-document-inspector-form__field tm-document-inspector-form__field--stacked">
        <span class="tm-document-inspector-form__label">@label</span>
        <span class="tm-document-inspector-form__control tm-document-page-layout__points">
            <input type="number"
                   class="tm-input"
                   min="0"
                   max="@max"
                   step="@step"
                   value="@value"
                   aria-describedby="@(_floatingIdPrefix + "-unit-" + testId)"
                   @oninput="onInput"
                   data-testid="@TestId("document-" + testId)" />
            <span id="@(_floatingIdPrefix + "-unit-" + testId)" class="tm-document-inspector-form__suffix">@Loc["TmDocumentEditor_UnitPoints"]</span>
        </span>
    </label>;

    // HTML/CSS previews of the equation structures (no MathML, no canvas): decorative, the button's label names the structure.
    private RenderFragment EquationPreview(DocumentEquationPaletteItem item)
    {
        switch (item.Preset)
        {
            case "fraction":
                return @<span class="tm-document-math__frac"><span>a</span><span>b</span></span>;
            case "radical":
                return @<span class="tm-document-math__rad"><span>&#x221A;</span><span class="tm-document-math__rad-body">a</span></span>;
            case "superscript":
                return @<span>a<sup>b</sup></span>;
            case "subscript":
                return @<span>a<sub>b</sub></span>;
            case "sum":
                return @<span class="tm-document-math__limits"><span>n</span><span class="tm-document-math__big">&#x2211;</span><span>i</span></span>;
            case "product":
                return @<span class="tm-document-math__limits"><span>n</span><span class="tm-document-math__big">&#x220F;</span><span>i</span></span>;
            case "matrix":
                return @<span class="tm-document-math__matrix"><span class="tm-document-math__bracket">[</span><span class="tm-document-math__cells"><span>a</span><span>b</span><span>c</span><span>d</span></span><span class="tm-document-math__bracket">]</span></span>;
            case "limit":
                return @<span class="tm-document-math__limits"><span>lim</span><span>x&#x2192;0</span></span>;
            case "accent":
                return @<span class="tm-document-math__accent">a</span>;
            case "borderBox":
                return @<span class="tm-document-math__box">a</span>;
            default:
                return @<span>@Loc[item.SymbolKey ?? "TmDocumentEditor_EquationSymbolQuadratic"]</span>;
        }
    }

    /// <summary>
    /// The inline sample style of a quick-style tile: the size, weight and colour the style shows in the document, taken from the same
    /// descriptor the ribbon resolves the current style with. Tokens only - the sample follows the theme.
    /// </summary>
    private static string StyleSampleStyle(string? style)
    {
        var descriptor = ResolveStyleDescriptor(style);
        if (descriptor.Id == "title")
        {
            return "font-size: var(--tm-font-size-xl); font-weight: var(--tm-font-weight-bold); color: var(--tm-color-text);";
        }

        return descriptor.HeadingLevel switch
        {
            1 => "font-size: var(--tm-font-size-lg); font-weight: var(--tm-font-weight-bold); color: var(--tm-color-primary);",
            2 => "font-size: var(--tm-font-size-md); font-weight: var(--tm-font-weight-semibold); color: var(--tm-color-text);",
            3 => "font-size: var(--tm-font-size-base); font-weight: var(--tm-font-weight-semibold); color: var(--tm-color-text-secondary); font-style: italic;",
            _ => descriptor.Id == "quote"
                ? "font-size: var(--tm-font-size-base); font-weight: var(--tm-font-weight-normal); color: var(--tm-color-text-secondary); font-style: italic;"
                : "font-size: var(--tm-font-size-base); font-weight: var(--tm-font-weight-normal); color: var(--tm-color-text);",
        };
    }

