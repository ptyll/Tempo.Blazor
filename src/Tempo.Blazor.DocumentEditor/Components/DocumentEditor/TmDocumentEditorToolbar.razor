    /// <summary>
    /// The page layout preview as CSS custom properties: the page aspect ratio, each margin as a share of the page, and the column
    /// count / gap. Plain properties on the preview root - a live <c>oninput</c> only restyles it, nothing relayouts.
    /// </summary>
    private string PagePreviewStyle
    {
        get
        {
            var page = EffectivePageSettings;
            var width = Math.Max(1, page.Landscape ? Math.Max(page.Size.Width, page.Size.Height) : Math.Min(page.Size.Width, page.Size.Height));
            var height = Math.Max(1, page.Landscape ? Math.Min(page.Size.Width, page.Size.Height) : Math.Max(page.Size.Width, page.Size.Height));
            var columns = EffectiveSectionColumns;
            string Pct(double value, double total) => (Math.Clamp(value / total, 0, 0.45) * 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";
            return string.Create(CultureInfo.InvariantCulture,
                $"--tm-page-preview-ratio: {width / height:0.####}; --tm-page-preview-margin-top: {Pct(page.Margins.Top, height)}; --tm-page-preview-margin-right: {Pct(page.Margins.Right, width)}; --tm-page-preview-margin-bottom: {Pct(page.Margins.Bottom, height)}; --tm-page-preview-margin-left: {Pct(page.Margins.Left, width)}; --tm-page-preview-columns: {Math.Clamp(columns.Count, 1, 3)}; --tm-page-preview-gap: {Pct(columns.Spacing, width)};");
        }
    }

    private static StyleDescriptor ResolveStyleDescriptor(string? value)
    {
        var key = NormalizeStyleKey(value);
        if (key == "title")
        {
            return new("title", "Title", "normal", 1);
        }

        if (key.StartsWith("heading", StringComparison.Ordinal)
            && key.Length == 8
            && int.TryParse(key[^1].ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var level))
        {
            var id = FormattableString.Invariant($"heading-{level}");
            var basedOn = level <= 1 ? "normal" : FormattableString.Invariant($"heading-{level - 1}");
            return new(id, FormattableString.Invariant($"Heading {level}"), basedOn, level);
        }

        if (key == "quote")
        {
            return new("quote", "Quote", "normal", null);
        }

        if (key == "normal")
        {
            return new("normal", "Normal", null, null);
        }

        var name = string.IsNullOrWhiteSpace(value) ? "Normal" : value.Trim();
        return new(SlugStyleName(name), name, "normal", null);
    }

    private static string NormalizeStyleKey(string? value)
        => string.Concat((value ?? "Normal").Where(char.IsLetterOrDigit)).ToLowerInvariant();

    private string ResolveCurrentStyleName()
        => ResolveStyleDescriptor(CurrentBlockStyle).Name;

    private static string SlugStyleName(string value)
    {
        var slug = string.Concat(value
            .Trim()
            .ToLowerInvariant()
            .Select(character => char.IsLetterOrDigit(character) ? character : '-'))
            .Trim('-');

        while (slug.Contains("--", StringComparison.Ordinal))
        {
            slug = slug.Replace("--", "-", StringComparison.Ordinal);
        }

        return string.IsNullOrWhiteSpace(slug) ? "custom-style" : slug;
    }

