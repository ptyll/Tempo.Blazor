    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_overflowModule is not null)
            {
                await _overflowModule.InvokeVoidAsync("disposeOverflowController", _ribbonGroupsRef);
                await _overflowModule.DisposeAsync();
            }
        }
        catch { }

        _dotNetRef?.Dispose();
    }

