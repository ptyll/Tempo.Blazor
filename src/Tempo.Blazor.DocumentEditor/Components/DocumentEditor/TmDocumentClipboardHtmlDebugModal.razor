@namespace Tempo.Blazor.Components.DocumentEditor
@inherits Tempo.Blazor.Components.TmComponentBase

<TmDocumentDebugModal IsOpen="IsOpen"
                      TestIdPrefix="@TestIdPrefix"
                      Title="@Loc["TmDocumentEditor_DebugClipboardHtmlTitle"]"
                      ModalTestId="document-clipboard-html-debug-modal"
                      CloseTestId="document-clipboard-html-debug-close"
                      RestoreFocusTargetId="@RestoreFocusTargetId"
                      OnClose="OnClose">
    <TmDocumentDebugSection TestIdPrefix="@TestIdPrefix"
                            Title="@Loc["TmDocumentEditor_DebugClipboardRawHtml"]"
                            SectionTestId="document-clipboard-raw-debug"
                            ContentTestId="document-clipboard-html-debug-content"
                            Content="@(RawHtml ?? Html)" />
    <TmDocumentDebugSection TestIdPrefix="@TestIdPrefix"
                            Title="@Loc["TmDocumentEditor_DebugClipboardNormalized"]"
                            SectionTestId="document-clipboard-normalized-debug"
                            ContentTestId="document-clipboard-normalized-debug-content"
                            Content="@NormalizedJson" />
    <TmDocumentDebugSection TestIdPrefix="@TestIdPrefix"
                            Title="@Loc["TmDocumentEditor_DebugClipboardWarnings"]"
                            SectionTestId="document-clipboard-warnings-debug"
                            ContentTestId="document-clipboard-warnings-debug-content"
                            Content="@WarningsJson" />
</TmDocumentDebugModal>

@code {
    /// <summary>
    /// The id of the element focus returns to when the dialog closes - the editor passes its canvas input, so the keyboard lands back in
    /// the document whatever opened the dialog (the command palette is gone by then). Null keeps the core modal's own restore (the opener).
    /// </summary>
    [Parameter] public string? RestoreFocusTargetId { get; set; }

    /// <summary>Whether the modal is open.</summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>Legacy HTML content to display when no raw clipboard HTML is provided.</summary>
    [Parameter] public string? Html { get; set; }

    /// <summary>Raw HTML captured from the last clipboard paste.</summary>
    [Parameter] public string? RawHtml { get; set; }

    /// <summary>Normalized Tempo block JSON from the last clipboard paste.</summary>
    [Parameter] public string? NormalizedJson { get; set; }

    /// <summary>Clipboard pipeline warnings from the last clipboard paste.</summary>
    [Parameter] public string? WarningsJson { get; set; }

    /// <summary>Raised when the modal should close.</summary>
    [Parameter] public EventCallback OnClose { get; set; }
}
