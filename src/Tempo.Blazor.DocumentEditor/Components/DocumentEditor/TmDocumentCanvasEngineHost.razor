    /// <summary>Enters header/footer editing (places the caret in the first header/footer of the type) (B6).</summary>
    public async Task EnterHeaderFooterAsync(string type)
    {
        if (_module is null || _handle is null)
        {
            return;
        }

        await _module.InvokeVoidAsync("editHeaderFooter", _handle, type);
    }

    /// <summary>Closes header/footer editing (moves the caret back to the body) (B6).</summary>
    public async Task CloseHeaderFooterAsync()
    {
        if (_module is null || _handle is null)
        {
            return;
        }

        await _module.InvokeVoidAsync("closeHeaderFooter", _handle);
    }

    /// <summary>Reads page metrics (total pages, per-page list, active page) for the navigator + status bar (B9).</summary>
    public Task<WysiwygPageMetrics> GetPageMetricsAsync()
        => ReadStateAsync("getPageMetricsJson", new WysiwygPageMetrics { TotalPages = 1, RenderedPages = 1, Pages = [new WysiwygPageMetric { PageIndex = 0, PageNumber = 1 }] });

    /// <summary>
    /// Exports each document page as a flat bitmap (plan S1) so the editor's output can be used as a
    /// signing-template page. Pulls one descriptor per page from the engine (it reuses the engine's
    /// current display list, so every page — including virtualized ones — is exported faithfully).
    /// </summary>
    public async Task<IReadOnlyList<DocumentPageImage>> ExportPageImagesAsync(DocumentPageImageExportOptions? options = null)
    {
        if (_module is null || _handle is null)
        {
            return [];
        }

        var resolved = options ?? new DocumentPageImageExportOptions();
        var optionsJson = JsonSerializer.Serialize(
            new { scale = resolved.Scale, format = resolved.Format, quality = resolved.Quality },
            CanvasJsonOptions);

        var metrics = await GetPageMetricsAsync();
        var total = Math.Max(0, metrics.TotalPages);
        var images = new List<DocumentPageImage>(total);
        for (var pageIndex = 0; pageIndex < total; pageIndex++)
        {
            var json = await _module.InvokeAsync<string?>("exportPageImage", _handle, pageIndex, optionsJson);
            var image = DeserializeState<DocumentPageImage?>(json, null);
            if (image is not null)
            {
                images.Add(image);
            }
        }

        return images;
    }

    /// <summary>
    /// Reads the signing fields the editor currently lays out (plan S2). Areas are derived from the
    /// layout — a body field has one area, a header/footer field one per page — and the attachment id
    /// is applied to every area so the produced fields plug straight into the signing designer/runner.
    /// </summary>
    public async Task<IReadOnlyList<Tempo.Blazor.Abstractions.Models.SigningField>> GetSigningFieldsAsync(string attachmentUuid)
    {
        if (_module is null || _handle is null)
        {
            return [];
        }

        var json = await _module.InvokeAsync<string?>("getSigningFieldsJson", _handle);
        if (string.IsNullOrWhiteSpace(json))
        {
            return [];
        }

        var descriptors = JsonSerializer.Deserialize<List<DocumentSigningFieldDescriptor>>(json, CanvasJsonOptions) ?? [];
        return descriptors.ToSigningFields(attachmentUuid);
    }

    /// <summary>Inserts a signing field at the current caret (body or header/footer) via the engine command.</summary>
    public async Task InsertSigningFieldAsync(Tempo.Blazor.Abstractions.Models.SigningField field)
    {
        ArgumentNullException.ThrowIfNull(field);

        if (_module is null || _handle is null)
        {
            return;
        }

        await ExecCommandAsync("insertSigningField", new
        {
            uuid = string.IsNullOrEmpty(field.Uuid) ? null : field.Uuid,
            fieldType = field.Type,
            submitterUuid = field.SubmitterUuid,
            required = field.Required,
            label = field.Title ?? string.Empty
        });
    }

