    /// <summary>JavaScript callback for canvas mini toolbar placement changes.</summary>
    [JSInvokable]
    public Task OnCanvasMiniToolbarChanged(string? stateJson)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        var request = DeserializeState<WysiwygMiniToolbarRequest?>(stateJson, null);
        // The selection payload also carries the pushed UI snapshot (B2). Dispatch it so a deliberate
        // selection updates the toolbar pressed-state immediately, without a follow-up interop pull.
        var envelope = DeserializeState<CanvasEngineUiStateEnvelope?>(stateJson, null);
        var miniToolbar = OnMiniToolbarChanged is not null ? OnMiniToolbarChanged(request) : Task.CompletedTask;
        var uiState = OnUiStateChanged is not null && envelope?.UiState is not null
            ? OnUiStateChanged(envelope.UiState)
            : Task.CompletedTask;
        return Task.WhenAll(miniToolbar, uiState);
    }

