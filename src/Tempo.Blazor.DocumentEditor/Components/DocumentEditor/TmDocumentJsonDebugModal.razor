@namespace Tempo.Blazor.Components.DocumentEditor
@inherits Tempo.Blazor.Components.TmComponentBase

<TmDocumentDebugModal IsOpen="IsOpen"
                      TestIdPrefix="@TestIdPrefix"
                      Title="@Loc["TmDocumentEditor_DebugDocumentJsonTitle"]"
                      ModalTestId="document-json-debug-modal"
                      CopyTestId="document-json-debug-copy"
                      CloseTestId="document-json-debug-close"
                      OnCopy="OnCopyJson"
                      RestoreFocusTargetId="@RestoreFocusTargetId"
                      OnClose="OnClose">
    <TmDocumentDebugSection TestIdPrefix="@TestIdPrefix"
                            Title="@Loc["TmDocumentEditor_DebugCanonicalDocument"]"
                            SectionTestId="document-canonical-debug"
                            ContentTestId="document-json-debug-content"
                            Content="@Json" />
    @if (!string.IsNullOrWhiteSpace(RuntimeDebugJson))
    {
        <TmDocumentDebugSection TestIdPrefix="@TestIdPrefix"
                                Title="@Loc["TmDocumentEditor_DebugRuntimeState"]"
                                SectionTestId="document-runtime-debug"
                                ContentTestId="document-runtime-debug-content"
                                Content="@RuntimeDebugJson" />
    }
    @if (!string.IsNullOrWhiteSpace(DocxDrawingMetadataJson))
    {
        <TmDocumentDebugSection TestIdPrefix="@TestIdPrefix"
                                Title="@Loc["TmDocumentEditor_DebugDocxDrawingMetadata"]"
                                SectionTestId="document-docx-drawing-debug"
                                ContentTestId="document-docx-drawing-debug-content"
                                Content="@DocxDrawingMetadataJson" />
    }
    @if (!string.IsNullOrWhiteSpace(RecoveryDetailJson))
    {
        <TmDocumentDebugSection TestIdPrefix="@TestIdPrefix"
                                Title="@Loc["TmDocumentEditor_DebugRuntimeRecovery"]"
                                SectionTestId="document-runtime-recovery-debug"
                                ContentTestId="document-runtime-recovery-debug-content"
                                Content="@RecoveryDetailJson" />
    }
</TmDocumentDebugModal>

@code {
    /// <summary>
    /// The id of the element focus returns to when the dialog closes - the editor passes its canvas input, so the keyboard lands back in
    /// the document whatever opened the dialog (the command palette is gone by then). Null keeps the core modal's own restore (the opener).
    /// </summary>
    [Parameter] public string? RestoreFocusTargetId { get; set; }

    /// <summary>Whether the modal is open.</summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>JSON string to display.</summary>
    [Parameter] public string? Json { get; set; }

    /// <summary>Optional JSON with the current runtime debug state.</summary>
    [Parameter] public string? RuntimeDebugJson { get; set; }

    /// <summary>Optional JSON with imported/exportable DOCX DrawingML metadata.</summary>
    [Parameter] public string? DocxDrawingMetadataJson { get; set; }

    /// <summary>Optional JSON with the latest runtime recovery detail.</summary>
    [Parameter] public string? RecoveryDetailJson { get; set; }

    /// <summary>Raised when the user requests copying the debug JSON payload.</summary>
    [Parameter] public EventCallback OnCopyJson { get; set; }

    /// <summary>Raised when the modal should close.</summary>
    [Parameter] public EventCallback OnClose { get; set; }
}
