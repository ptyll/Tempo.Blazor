@namespace Tempo.Blazor.Components.DocumentEditor
@inherits Tempo.Blazor.Components.TmComponentBase
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.JSInterop
@using Tempo.Blazor.Components.Files
@using Tempo.Blazor.DocumentEditor.Interfaces
@using Tempo.Blazor.DocumentEditor.Models
@using Tempo.Blazor.DocumentEditor.Services

@* Redesign 146c7e1b, phase 5 (G6): the compare dialog is the core TmModal - top layer, core focus scope and a fullscreen panel on a
   mobile layout (the diff is a tall surface). The editor renders it as a SIBLING of the floating root. The test id rides the overlay. *@
<TmModal Show="true"
         Title="@Loc["TmDocumentEditor_CompareDialogTitle"]"
         Size="ModalSize.Large"
         MobilePresentation="MobilePresentation.AutoFullscreen"
         FooterLayout="FooterLayout.Inline"
         Class="tm-document-compare-dialog"
         CloseButtonAdditionalAttributes="@CloseButtonAttributes"
         RestoreFocusTargetId="@RestoreFocusTargetId"
         OnClose="OnClose"
         data-testid="@TestId("document-compare-dialog")">
    <ChildContent>
        <p class="tm-document-compare-dialog__intro">@Loc["TmDocumentEditor_CompareEmpty"]</p>

        @* Redesign 146c7e1b, phase 7 (DE-2.6): each source is a CARD (title, what it is, "Change..."); the picker (current / history version /
           document id / uploaded DOCX) opens under the card instead of living in the dialog as two bare selects. *@
        <div class="tm-document-compare-dialog__sources">
            <TmDocumentCompareSourceCard @ref="_baseCard"
                                         Side="base"
                                         Title="@Loc["TmDocumentEditor_CompareBaseSource"]"
                                         Label="@SourceLabel(true)"
                                         Description="@SourceDescription(true)"
                                         Icon="@SourceIcon(true)"
                                         Expanded="@_baseEditing"
                                         Disabled="@_isComparing"
                                         TestIdPrefix="@TestIdPrefix"
                                         OnChange="() => ToggleEditor(true)">
                @RenderPicker(true)
            </TmDocumentCompareSourceCard>
            <TmDocumentCompareSourceCard @ref="_targetCard"
                                         Side="target"
                                         Title="@Loc["TmDocumentEditor_CompareTargetSource"]"
                                         Label="@SourceLabel(false)"
                                         Description="@SourceDescription(false)"
                                         Icon="@SourceIcon(false)"
                                         Expanded="@_compareEditing"
                                         Disabled="@_isComparing"
                                         TestIdPrefix="@TestIdPrefix"
                                         OnChange="() => ToggleEditor(false)">
                @RenderPicker(false)
            </TmDocumentCompareSourceCard>
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="tm-document-compare-dialog__message" role="status" data-testid="@TestId("document-compare-message")">@_message</div>
        }

        @if (_isComparing)
        {
            <div class="tm-document-compare-dialog__state" aria-busy="true" data-testid="@TestId("document-compare-loading")">
                @Loc["TmDocumentEditor_CompareLoading"]
            </div>
        }
        else if (_result is not null)
        {
            @RenderResult()
        }
        else
        {
            @* The empty result is one card with a title and a framed hint - no stray blank block between the sources and the footer. *@
            <section class="tm-document-compare-dialog__ready" aria-labelledby="@_readyTitleId" data-testid="@TestId("document-compare-empty")">
                <h4 id="@_readyTitleId" class="tm-document-compare-dialog__ready-title">@Loc["TmDocumentEditor_CompareReadyTitle"]</h4>
                <div class="tm-document-compare-dialog__ready-hint">
                    <TmIcon Name="git-compare" Size="IconSize.Lg" />
                    <span>@Loc["TmDocumentEditor_CompareReadyHint"]</span>
                </div>
            </section>
        }
    </ChildContent>
    <Footer>
        @* The primary action first, Cancel at the far end (the mockup's order). *@
        <button type="button"
                class="tm-btn tm-btn-sm tm-btn-primary"
                disabled="@(_isComparing || !CanCompare)"
                title="@(CanCompare ? null : Loc["TmDocumentEditor_CompareRunHint"])"
                @onclick="RunCompareAsync"
                data-testid="@TestId("document-compare-run")">
            @Loc["TmDocumentEditor_CompareRun"]
        </button>
        @if (_result is not null && _result.Summary.HasChanges && OnExportRedline.HasDelegate)
        {
            <button type="button"
                    class="tm-btn tm-btn-sm tm-btn-secondary"
                    disabled="@_isComparing"
                    aria-label="@Loc["TmDocumentEditor_CompareExportRedlineAria"]"
                    @onclick="() => OnExportRedline.InvokeAsync(_result)"
                    data-testid="@TestId("document-compare-export-redline")">
                @Loc["TmDocumentEditor_CompareExportRedline"]
            </button>
        }
        <button type="button" class="tm-btn tm-btn-sm tm-btn-secondary tm-document-compare-dialog__cancel" @onclick="OnClose" data-testid="@TestId("document-compare-cancel")">@Loc["TmDocumentEditor_Cancel"]</button>
    </Footer>
</TmModal>

@code {
    /// <summary>
    /// The id of the element focus returns to when the dialog closes - the editor passes its canvas input, so the keyboard lands back in
    /// the document whatever opened the dialog (the command palette is gone by then). Null keeps the core modal's own restore (the opener).
    /// </summary>
    [Parameter] public string? RestoreFocusTargetId { get; set; }

    private const long MaxCompareUploadSize = 20 * 1024 * 1024;
    private readonly DocumentComparisonService _localComparison = new();
    private string? _baseDocumentId;
    private string? _compareDocumentId;
    private DocumentEditorDocument? _baseUploadedDocument;
    private DocumentEditorDocument? _compareUploadedDocument;
    private string? _baseUploadedName;
    private string? _compareUploadedName;
    private bool _isComparing;
    private string? _message;
    private DocumentCompareResult? _result;
    private readonly string _readyTitleId = $"tm-document-compare-ready-{Guid.NewGuid():N}";
    private readonly string _resultTitleId = $"tm-document-compare-result-{Guid.NewGuid():N}";

    private Dictionary<string, object> CloseButtonAttributes => new()
    {
        ["data-testid"] = TestId("document-compare-close"),
    };

    /// <summary>Current editor document snapshot.</summary>
    [Parameter] public DocumentEditorDocument? CurrentDocument { get; set; }

    /// <summary>Provider used to resolve document id sources for local comparison.</summary>
    [Parameter] public IDocumentEditorProvider? DocumentProvider { get; set; }

    /// <summary>Optional external format provider used for DOCX upload comparison sources.</summary>
    [Parameter] public IDocumentFormatProvider? FormatProvider { get; set; }

    /// <summary>Optional provider-backed comparison boundary.</summary>
    [Parameter] public IDocumentComparisonProvider? ComparisonProvider { get; set; }

    /// <summary>Whether local comparison should be used when the provider fails.</summary>
    [Parameter] public bool UseLocalComparisonFallback { get; set; } = true;

    /// <summary>Author requesting the comparison.</summary>
    [Parameter] public DocumentEditorAuthor? Author { get; set; }

    /// <summary>Raised when comparison succeeds.</summary>
    [Parameter] public EventCallback<DocumentCompareResult> OnCompared { get; set; }

    /// <summary>Raised when comparison fails.</summary>
    [Parameter] public EventCallback<string> OnCompareFailed { get; set; }

    /// <summary>Raised when the dialog should close.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Raised when the user asks to export the current comparison as a redline (tracked-changes)
    /// document. The button renders only when the callback is wired and the result has changes.
    /// </summary>
    [Parameter] public EventCallback<DocumentCompareResult> OnExportRedline { get; set; }

    /// <summary>History versions the reader can compare against ("Version from history" in the source picker). Empty hides that choice.</summary>
    [Parameter] public IReadOnlyList<DocumentVersion> Versions { get; set; } = [];

    /// <summary>
    /// Raised when the reader asks to open the finished comparison in the document region ("Open comparison", or a click on one change of
    /// the list, which carries that block's id). The button and the clickable list render only when it is bound.
    /// </summary>
    [Parameter] public EventCallback<DocumentCompareOpenRequest> OnOpenComparison { get; set; }

    /// <summary>What the picker of a source can choose. The values are the option values of the picker's select.</summary>
    private enum SourceChoice
    {
        Current,
        Version,
        DocumentId,
        JsonSnapshot
    }

    private SourceChoice _baseChoice = SourceChoice.Current;
    private SourceChoice _compareChoice = SourceChoice.DocumentId;
    private string? _baseVersionId;
    private string? _compareVersionId;
    private bool _baseEditing;
    private bool _compareEditing;
    private TmDocumentCompareSourceCard? _baseCard;
    private TmDocumentCompareSourceCard? _targetCard;
    private bool? _focusChangeOfBase;

    // Compare needs both sources to name something: a current document, a picked version, a typed id, an uploaded file.
    private bool CanCompare => IsSourceValid(true) && IsSourceValid(false);

    private bool IsSourceValid(bool isBase) => ChoiceOf(isBase) switch
    {
        SourceChoice.Current => CurrentDocument is not null,
        SourceChoice.Version => VersionOf(isBase) is not null,
        SourceChoice.DocumentId => !string.IsNullOrWhiteSpace(isBase ? _baseDocumentId : _compareDocumentId),
        _ => (isBase ? _baseUploadedDocument : _compareUploadedDocument) is not null
    };

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusChangeOfBase is bool isBase)
        {
            _focusChangeOfBase = null;
            var card = isBase ? _baseCard : _targetCard;
            if (card is not null)
            {
                await card.FocusChangeAsync();
            }
        }
    }

    // Choosing something finished the job of the picker: it closes and the focus returns to "Change..." (a typed id keeps it open).
    private void CollapseEditor(bool isBase)
    {
        if (isBase)
        {
            _baseEditing = false;
        }
        else
        {
            _compareEditing = false;
        }

        _focusChangeOfBase = isBase;
    }

    private SourceChoice ChoiceOf(bool isBase) => isBase ? _baseChoice : _compareChoice;

    private IReadOnlyList<DocumentVersion> OrderedVersions => Versions.OrderByDescending(version => version.CreatedAt).ToList();

    private DocumentVersion? VersionOf(bool isBase)
    {
        var id = isBase ? _baseVersionId : _compareVersionId;
        return id is null ? null : Versions.FirstOrDefault(version => version.Id == id);
    }

    private void ToggleEditor(bool isBase)
    {
        if (isBase)
        {
            _baseEditing = !_baseEditing;
        }
        else
        {
            _compareEditing = !_compareEditing;
        }
    }

    private string SourceLabel(bool isBase) => ChoiceOf(isBase) switch
    {
        SourceChoice.Current => Loc["TmDocumentEditor_CompareSourceCurrent"],
        SourceChoice.Version => VersionOf(isBase) is { } version
            ? DocumentVersionText.Title(Loc, version)
            : Loc["TmDocumentEditor_CompareVersionNone"],
        SourceChoice.DocumentId => string.IsNullOrWhiteSpace(isBase ? _baseDocumentId : _compareDocumentId)
            ? Loc["TmDocumentEditor_CompareDocumentIdNone"]
            : (isBase ? _baseDocumentId : _compareDocumentId)!,
        _ => string.IsNullOrWhiteSpace(isBase ? _baseUploadedName : _compareUploadedName)
            ? Loc["TmDocumentEditor_CompareUploadNone"]
            : (isBase ? _baseUploadedName : _compareUploadedName)!
    };

    private string SourceDescription(bool isBase) => ChoiceOf(isBase) switch
    {
        SourceChoice.Current => Loc["TmDocumentEditor_CompareSourceCurrentHint"],
        SourceChoice.Version => VersionOf(isBase) is { } version
            ? string.Join(" \u00B7 ", new[] { DocumentVersionText.KindLabel(Loc, version.Kind), version.Author.DisplayName }.Where(part => !string.IsNullOrWhiteSpace(part)))
            : Loc["TmDocumentEditor_CompareSourceVersion"],
        SourceChoice.DocumentId => Loc["TmDocumentEditor_CompareSourceDocumentId"],
        _ => Loc["TmDocumentEditor_CompareSourceJsonSnapshot"]
    };

    private string SourceIcon(bool isBase) => ChoiceOf(isBase) switch
    {
        SourceChoice.Version => "history",
        SourceChoice.JsonSnapshot => "upload",
        _ => "file-text"
    };

    private RenderFragment RenderPicker(bool isBase) => @<div class="tm-document-compare-dialog__picker">
        <label class="tm-document-compare-dialog__field">
            <span>@Loc["TmDocumentEditor_CompareSourceKind"]</span>
            <select class="tm-input"
                    value="@ChoiceOf(isBase).ToString()"
                    aria-label="@Loc[isBase ? "TmDocumentEditor_CompareBaseSourceAria" : "TmDocumentEditor_CompareTargetSourceAria"]"
                    data-testid="@TestId(isBase ? "document-compare-base-source" : "document-compare-target-source")"
                    @onchange="args => ChangeSourceKind(isBase, args.Value?.ToString())">
                <option value="@SourceChoice.Current">@Loc["TmDocumentEditor_CompareSourceCurrent"]</option>
                @if (Versions.Count > 0)
                {
                    <option value="@SourceChoice.Version">@Loc["TmDocumentEditor_CompareSourceVersion"]</option>
                }
                <option value="@SourceChoice.DocumentId">@Loc["TmDocumentEditor_CompareSourceDocumentId"]</option>
                <option value="@SourceChoice.JsonSnapshot">@Loc["TmDocumentEditor_CompareSourceJsonSnapshot"]</option>
            </select>
        </label>
        @if (ChoiceOf(isBase) == SourceChoice.Version)
        {
            <label class="tm-document-compare-dialog__field">
                <span>@Loc["TmDocumentEditor_CompareSourceVersion"]</span>
                <select class="tm-input"
                        value="@(isBase ? _baseVersionId : _compareVersionId)"
                        aria-label="@Loc[isBase ? "TmDocumentEditor_CompareBaseVersionAria" : "TmDocumentEditor_CompareTargetVersionAria"]"
                        data-testid="@TestId(isBase ? "document-compare-base-version" : "document-compare-target-version")"
                        @onchange="args => ChangeVersion(isBase, args.Value?.ToString())">
                    <option value="">@Loc["TmDocumentEditor_CompareVersionPlaceholder"]</option>
                    @foreach (var version in OrderedVersions)
                    {
                        <option value="@version.Id">@DocumentVersionText.Title(Loc, version)</option>
                    }
                </select>
            </label>
        }
        else if (ChoiceOf(isBase) == SourceChoice.DocumentId)
        {
            <label class="tm-document-compare-dialog__field">
                <span>@Loc["TmDocumentEditor_CompareDocumentId"]</span>
                <input class="tm-input"
                       value="@(isBase ? _baseDocumentId : _compareDocumentId)"
                       aria-label="@Loc[isBase ? "TmDocumentEditor_CompareBaseDocumentIdAria" : "TmDocumentEditor_CompareTargetDocumentIdAria"]"
                       data-testid="@TestId(isBase ? "document-compare-base-document-id" : "document-compare-target-document-id")"
                       @oninput="args => ChangeDocumentId(isBase, args.Value?.ToString())" />
            </label>
        }
        else if (ChoiceOf(isBase) == SourceChoice.JsonSnapshot)
        {
            <TmFileDropZone Multiple="false"
                            MaxFileCount="1"
                            Accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                            Disabled="@_isComparing"
                            InputTestId="@TestId(isBase ? "document-compare-base-upload" : "document-compare-target-upload")"
                            InputAriaLabel="@Loc[isBase ? "TmDocumentEditor_CompareBaseUploadAria" : "TmDocumentEditor_CompareTargetUploadAria"]"
                            OnFilesSelected="args => ImportCompareSourceAsync(isBase, args)">
                <div>@Loc["TmDocumentEditor_CompareUploadDocx"]</div>
            </TmFileDropZone>
        }
    </div>;

    private RenderFragment RenderResult() => @<section class="tm-document-compare-dialog__result" aria-labelledby="@_resultTitleId" data-testid="@TestId("document-compare-result")">
        <header class="tm-document-compare-dialog__result-header">
            <h4 id="@_resultTitleId" class="tm-document-compare-dialog__result-title">@Loc["TmDocumentEditor_CompareResultTitle"]</h4>
            <ul class="tm-document-compare-dialog__summary" data-testid="@TestId("document-compare-summary")" aria-label="@Loc["TmDocumentEditor_CompareResultTitle"]">
                <li class="tm-document-compare-dialog__stat tm-document-compare-dialog__stat--added">
                    <span class="tm-document-compare-dialog__stat-value" data-testid="@TestId("document-compare-summary-added")">@_result!.Summary.AddedBlocks</span>
                    <span>@Loc["TmDocumentEditor_DiffLegendAdded"]</span>
                </li>
                <li class="tm-document-compare-dialog__stat tm-document-compare-dialog__stat--removed">
                    <span class="tm-document-compare-dialog__stat-value" data-testid="@TestId("document-compare-summary-removed")">@_result.Summary.RemovedBlocks</span>
                    <span>@Loc["TmDocumentEditor_DiffLegendRemoved"]</span>
                </li>
                <li class="tm-document-compare-dialog__stat tm-document-compare-dialog__stat--changed">
                    <span class="tm-document-compare-dialog__stat-value" data-testid="@TestId("document-compare-summary-changed")">@_result.Summary.ChangedBlocks</span>
                    <span>@Loc["TmDocumentEditor_DiffLegendChanged"]</span>
                </li>
            </ul>
            @if (_result.Summary.HasChanges && OnOpenComparison.HasDelegate)
            {
                <button type="button"
                        class="tm-btn tm-btn-sm tm-btn-secondary tm-document-compare-dialog__open"
                        data-testid="@TestId("document-compare-open-comparison")"
                        @onclick="() => OpenComparisonAsync(null)">
                    <TmIcon Name="git-compare" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_CompareOpenComparison"]</span>
                </button>
            }
        </header>
        @if (_result.Changes.Count == 0)
        {
            <div class="tm-document-compare-dialog__no-differences" data-testid="@TestId("document-compare-no-differences")">
                <TmEmptyState Icon="check"
                              Title="@Loc["TmDocumentEditor_CompareNoDifferencesTitle"]"
                              Description="@Loc["TmDocumentEditor_CompareNoDifferencesHint"]" />
            </div>
        }
        else
        {
            <h5 class="tm-document-compare-dialog__changes-title">@Loc["TmDocumentEditor_CompareChangesList", _result.Changes.Count]</h5>
            <ol class="tm-document-compare-dialog__changes" data-testid="@TestId("document-compare-changes")">
                @foreach (var change in _result.Changes)
                {
                    var quote = ChangeQuote(change);
                    var blockId = change.BlockId;
                    <li class="tm-document-compare-dialog__change tm-document-compare-dialog__change--@change.Kind.ToString().ToLowerInvariant()"
                        data-change-kind="@change.Kind.ToString().ToLowerInvariant()"
                        data-testid="@TestId("document-compare-change")">
                        @if (OnOpenComparison.HasDelegate)
                        {
                            <button type="button"
                                    class="tm-document-compare-dialog__change-button"
                                    aria-label="@Loc["TmDocumentEditor_CompareShowChangeAria", ChangeKindLabel(change.Kind), quote]"
                                    @onclick="() => OpenComparisonAsync(blockId)">
                                <span class="tm-document-compare-dialog__change-kind">@ChangeKindLabel(change.Kind)</span>
                                <span class="tm-document-compare-dialog__change-quote">@quote</span>
                            </button>
                        }
                        else
                        {
                            <span class="tm-document-compare-dialog__change-kind">@ChangeKindLabel(change.Kind)</span>
                            <span class="tm-document-compare-dialog__change-quote">@quote</span>
                        }
                    </li>
                }
            </ol>
        }
    </section>;

    private string ChangeKindLabel(DocumentCompareChangeKind kind) => kind switch
    {
        DocumentCompareChangeKind.Added => Loc["TmDocumentEditor_DiffLegendAdded"],
        DocumentCompareChangeKind.Removed => Loc["TmDocumentEditor_DiffLegendRemoved"],
        _ => Loc["TmDocumentEditor_DiffLegendChanged"]
    };

    private static string ChangeQuote(DocumentCompareBlockChange change)
    {
        var text = change.Kind == DocumentCompareChangeKind.Removed ? change.OldText : change.NewText;
        text = string.IsNullOrWhiteSpace(text) ? change.OldText : text;
        text = string.Join(' ', (text ?? string.Empty).Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
        return text.Length <= 140 ? text : text[..139] + "\u2026";
    }

    private async Task OpenComparisonAsync(string? blockId)
    {
        if (_result is null)
        {
            return;
        }

        await OnOpenComparison.InvokeAsync(new DocumentCompareOpenRequest(_result, blockId, GetSourceTitle(true), GetSourceTitle(false)));
    }

    private void ChangeSourceKind(bool isBase, string? value)
    {
        if (!Enum.TryParse<SourceChoice>(value, out var choice))
        {
            return;
        }

        if (isBase)
        {
            _baseChoice = choice;
        }
        else
        {
            _compareChoice = choice;
        }

        _result = null;
        if (choice == SourceChoice.Current)
        {
            CollapseEditor(isBase);
        }
    }

    private void ChangeVersion(bool isBase, string? value)
    {
        var id = string.IsNullOrEmpty(value) ? null : value;
        if (isBase)
        {
            _baseVersionId = id;
        }
        else
        {
            _compareVersionId = id;
        }

        _result = null;
        if (id is not null)
        {
            CollapseEditor(isBase);
        }
    }

    private void ChangeDocumentId(bool isBase, string? value)
    {
        if (isBase)
        {
            _baseDocumentId = value;
        }
        else
        {
            _compareDocumentId = value;
        }

        _result = null;
    }

    private async Task ImportCompareSourceAsync(bool isBase, InputFileChangeEventArgs args)
    {
        if (FormatProvider is null)
        {
            _message = Loc["TmDocumentEditor_CompareProviderUnavailable"];
            return;
        }

        var file = args.File;
        try
        {
            using var memory = new MemoryStream();
            await using (var stream = file.OpenReadStream(MaxCompareUploadSize))
            {
                await stream.CopyToAsync(memory);
            }

            var imported = await FormatProvider.ImportAsync(new DocumentFormatImportProviderRequest
            {
                DocumentId = CurrentDocument?.DocumentId ?? Guid.NewGuid().ToString("N"),
                Format = DocumentFormatProviderKind.Docx,
                FileName = file.Name,
                ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                Content = memory.ToArray(),
                Author = Author
            });

            if (!imported.Success || imported.Document is null)
            {
                _message = string.IsNullOrWhiteSpace(imported.ErrorMessage)
                    ? Loc["TmDocumentEditor_CompareImportFailed"]
                    : imported.ErrorMessage;
                return;
            }

            if (isBase)
            {
                _baseUploadedDocument = imported.Document;
                _baseUploadedName = file.Name;
            }
            else
            {
                _compareUploadedDocument = imported.Document;
                _compareUploadedName = file.Name;
            }

            _message = Loc["TmDocumentEditor_CompareImportComplete"];
            _result = null;
            CollapseEditor(isBase);
        }
        catch
        {
            _message = Loc["TmDocumentEditor_CompareImportFailed"];
        }
    }

    private async Task RunCompareAsync()
    {
        if (CurrentDocument is null)
        {
            _message = Loc["TmDocumentEditor_CompareError"];
            await OnCompareFailed.InvokeAsync(_message);
            return;
        }

        _isComparing = true;
        _message = null;
        _result = null;

        try
        {
            var request = new DocumentCompareRequest
            {
                DocumentId = CurrentDocument.DocumentId,
                CurrentDocument = CurrentDocument,
                BaseSource = BuildSource(true),
                CompareSource = BuildSource(false),
                Author = Author
            };

            DocumentCompareResult result;
            if (ComparisonProvider is not null)
            {
                try
                {
                    result = await ComparisonProvider.CompareAsync(request);
                }
                catch when (UseLocalComparisonFallback)
                {
                    result = await CompareLocallyAsync(request);
                }
            }
            else
            {
                result = await CompareLocallyAsync(request);
            }

            if (!result.Success)
            {
                _message = string.IsNullOrWhiteSpace(result.ErrorMessage)
                    ? Loc["TmDocumentEditor_CompareError"]
                    : result.ErrorMessage;
                await OnCompareFailed.InvokeAsync(_message);
                return;
            }

            result.BaseDocument ??= await ResolveSourceAsync(request.BaseSource, CurrentDocument);
            result.CompareDocument ??= await ResolveSourceAsync(request.CompareSource, CurrentDocument);
            _result = result;
            await OnCompared.InvokeAsync(result);
        }
        catch (Exception ex)
        {
            _message = string.IsNullOrWhiteSpace(ex.Message)
                ? Loc["TmDocumentEditor_CompareError"]
                : ex.Message;
            await OnCompareFailed.InvokeAsync(_message);
        }
        finally
        {
            _isComparing = false;
        }
    }

    private DocumentCompareSource BuildSource(bool isBase)
    {
        var choice = ChoiceOf(isBase);
        switch (choice)
        {
            case SourceChoice.Current:
                return new DocumentCompareSource
                {
                    Kind = DocumentCompareSourceKind.Current,
                    DocumentId = CurrentDocument?.DocumentId,
                    Document = CurrentDocument,
                    JsonSnapshot = CurrentDocument is null ? null : DocumentEditorJson.Serialize(CurrentDocument),
                    Label = Loc["TmDocumentEditor_CompareSourceCurrent"]
                };
            case SourceChoice.Version:
                var version = VersionOf(isBase);
                DocumentEditorDocument? snapshot = null;
                if (version is not null && !string.IsNullOrWhiteSpace(version.Snapshot.Json))
                {
                    try
                    {
                        snapshot = DocumentEditorJson.Deserialize(version.Snapshot.Json);
                    }
                    catch (System.Text.Json.JsonException)
                    {
                        // A snapshot that is not valid JSON names no document: the comparison fails with the localized message.
                    }
                }

                return new DocumentCompareSource
                {
                    Kind = DocumentCompareSourceKind.JsonSnapshot,
                    Document = snapshot,
                    JsonSnapshot = snapshot is null ? null : version!.Snapshot.Json,
                    Label = version is null ? null : DocumentVersionText.Title(Loc, version)
                };
            case SourceChoice.DocumentId:
                return new DocumentCompareSource
                {
                    Kind = DocumentCompareSourceKind.DocumentId,
                    DocumentId = isBase ? _baseDocumentId : _compareDocumentId
                };
            default:
                var document = isBase ? _baseUploadedDocument : _compareUploadedDocument;
                return new DocumentCompareSource
                {
                    Kind = DocumentCompareSourceKind.JsonSnapshot,
                    Document = document,
                    JsonSnapshot = document is null ? null : DocumentEditorJson.Serialize(document),
                    Label = isBase ? _baseUploadedName : _compareUploadedName
                };
        }
    }

    private async Task<DocumentCompareResult> CompareLocallyAsync(DocumentCompareRequest request)
    {
        var baseDocument = await ResolveSourceAsync(request.BaseSource, request.CurrentDocument);
        var compareDocument = await ResolveSourceAsync(request.CompareSource, request.CurrentDocument);
        return _localComparison.Compare(baseDocument, compareDocument);
    }

    private async Task<DocumentEditorDocument> ResolveSourceAsync(DocumentCompareSource source, DocumentEditorDocument? currentDocument)
    {
        if (source.Kind == DocumentCompareSourceKind.Current)
        {
            return Clone(currentDocument ?? source.Document ?? DocumentEditorDocument.Empty());
        }

        if (source.Document is not null)
        {
            return Clone(source.Document);
        }

        if (!string.IsNullOrWhiteSpace(source.JsonSnapshot))
        {
            return DocumentEditorJson.Deserialize(source.JsonSnapshot);
        }

        if (source.Kind == DocumentCompareSourceKind.DocumentId && !string.IsNullOrWhiteSpace(source.DocumentId) && DocumentProvider is not null)
        {
            var loaded = await DocumentProvider.LoadAsync(source.DocumentId, new DocumentEditorLoadOptions { IncludeDocument = true });
            if (loaded.Found && loaded.Document is not null)
            {
                return loaded.Document;
            }
        }

        throw new InvalidOperationException(Loc["TmDocumentEditor_CompareError"]);
    }

    private string GetSourceTitle(bool isBase)
    {
        var source = isBase ? BuildSource(true) : BuildSource(false);
        return source.Kind == DocumentCompareSourceKind.DocumentId
            ? source.DocumentId ?? Loc["TmDocumentEditor_CompareSourceDocumentId"]
            : source.Label ?? Loc[$"TmDocumentEditor_CompareSource{source.Kind}"];
    }

    private static T Clone<T>(T value)
    {
        var json = System.Text.Json.JsonSerializer.Serialize(value, DocumentEditorJson.Options);
        return System.Text.Json.JsonSerializer.Deserialize<T>(json, DocumentEditorJson.Options)!;
    }
}
