@namespace Tempo.Blazor.Components.DocumentEditor
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.DocumentEditor.Models

@* Redesign 146c7e1b, phase 5 (G6): the version dialog is the core TmModal - top layer, the core focus scope (trap, Escape,
   focus return) and, on a mobile layout, a bottom sheet. The editor renders it as a SIBLING of the floating root (a fixed or
   container ancestor would be the modal's containing block). The test id rides the overlay, so it is the scrim; the card is
   .tm-modal-container. *@
<TmModal Show="true"
         Title="@Loc["TmDocumentEditor_CreateVersion"]"
         Size="ModalSize.Small"
         MobilePresentation="MobilePresentation.Auto"
         FooterLayout="FooterLayout.Inline"
         InitialFocusTargetId="@_kindSelectId"
         CloseButtonAdditionalAttributes="@CloseButtonAttributes"
         Class="tm-document-version-dialog"
         RestoreFocusTargetId="@RestoreFocusTargetId"
         OnClose="OnCancel"
         data-testid="@TestId("document-version-dialog")">
    <ChildContent>
        <div class="tm-document-version-dialog__form">
            <label class="tm-document-version-dialog__field">
                <span>@Loc["TmDocumentEditor_VersionKind"]</span>
                <select id="@_kindSelectId"
                        class="tm-input"
                        value="@_kind"
                        @onchange="ChangeKind"
                        data-testid="@TestId("document-version-kind")">
                    <option value="@DocumentVersionKind.Minor">@Loc["TmDocumentEditor_VersionKindMinor"]</option>
                    <option value="@DocumentVersionKind.Major">@Loc["TmDocumentEditor_VersionKindMajor"]</option>
                </select>
            </label>

            <label class="tm-document-version-dialog__field">
                <span>@Loc["TmDocumentEditor_VersionLabel"]</span>
                <input class="tm-input" value="@_label" @oninput="args => _label = args.Value?.ToString()" data-testid="@TestId("document-version-label")" />
            </label>

            <label class="tm-document-version-dialog__field">
                <span>@Loc["TmDocumentEditor_VersionDescription"]</span>
                <textarea class="tm-input" value="@_description" @oninput="args => _description = args.Value?.ToString()" data-testid="@TestId("document-version-description")"></textarea>
            </label>

            @if (!string.IsNullOrWhiteSpace(_validationMessage))
            {
                <div class="tm-document-version-dialog__error" role="alert" data-testid="@TestId("document-version-error")">@_validationMessage</div>
            }
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="tm-btn tm-btn-sm tm-btn-ghost" @onclick="OnCancel" data-testid="@TestId("document-version-cancel")">@Loc["TmDocumentEditor_Cancel"]</button>
        <button type="button" class="tm-btn tm-btn-sm tm-btn-primary" @onclick="SubmitAsync" disabled="@IsBusy" data-testid="@TestId("document-version-create-submit")">
            @Loc["TmDocumentEditor_CreateVersion"]
        </button>
    </Footer>
</TmModal>

@code {
    /// <summary>
    /// The id of the element focus returns to when the dialog closes - the editor passes its canvas input, so the keyboard lands back in
    /// the document whatever opened the dialog (the command palette is gone by then). Null keeps the core modal's own restore (the opener).
    /// </summary>
    [Parameter] public string? RestoreFocusTargetId { get; set; }

    private readonly string _kindSelectId = $"tm-document-version-kind-{Guid.NewGuid():N}";
    private DocumentVersionKind _kind = DocumentVersionKind.Minor;
    private string? _label;
    private string? _description;
    private string? _validationMessage;

    /// <summary>Whether create action is currently running.</summary>
    [Parameter] public bool IsBusy { get; set; }

    /// <summary>Whether major versions require a non-empty description.</summary>
    [Parameter] public bool RequireMajorDescription { get; set; }

    /// <summary>Raised when the user confirms version creation.</summary>
    [Parameter] public EventCallback<DocumentVersionDialogResult> OnCreate { get; set; }

    /// <summary>Raised when the dialog should close without creating a version.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    private Dictionary<string, object> CloseButtonAttributes => new()
    {
        ["data-testid"] = TestId("document-version-dialog-close"),
    };

    private void ChangeKind(ChangeEventArgs args)
    {
        _validationMessage = null;
        if (Enum.TryParse<DocumentVersionKind>(args.Value?.ToString(), out var kind))
        {
            _kind = kind;
        }
    }

    private async Task SubmitAsync()
    {
        if (RequireMajorDescription
            && _kind == DocumentVersionKind.Major
            && string.IsNullOrWhiteSpace(_description))
        {
            _validationMessage = Loc["TmDocumentEditor_MajorVersionDescriptionRequired"];
            return;
        }

        await OnCreate.InvokeAsync(new DocumentVersionDialogResult
        {
            Kind = _kind,
            Label = string.IsNullOrWhiteSpace(_label) ? null : _label.Trim(),
            Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim()
        });
    }
}
