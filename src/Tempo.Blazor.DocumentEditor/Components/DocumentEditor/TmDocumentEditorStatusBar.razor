@namespace Tempo.Blazor.Components.DocumentEditor
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Components.Dropdowns
@using Tempo.Blazor.Components.Overlay

@* Only the save group is a live region: the page, the zoom and the controls change at the reader's own hand and must not be announced as a whole. *@
<footer class="tm-document-editor__status-bar"
        aria-label="@Loc["TmDocumentEditor_StatusBarLabel"]"
        data-testid="@TestId("document-status-bar")">
    <div class="tm-document-editor__status-bar-group tm-document-editor__status-bar-group--metrics">
        @* Phase 7 (DE-1.8): the page the reader is on ("Page 2 of 6") and the word count read through plural families; the zoom and the
           fullscreen switch are controls of the bar, not just text. *@
        <span data-testid="@TestId("document-status-page-count")" data-current-page="@Math.Max(1, CurrentPage)" data-page-count="@Math.Max(1, PageCount)">@Loc["TmDocumentEditor_StatusPageOf", Math.Max(1, CurrentPage), Math.Max(1, PageCount)]</span>
        <span data-testid="@TestId("document-status-word-count")">@Loc.Plural("TmDocumentEditor_WordCount", WordCount)</span>
        <span data-testid="@TestId("document-status-region")">@(string.IsNullOrWhiteSpace(ModeLabel) ? Loc["TmDocumentEditor_ActiveRegion", ActiveRegionLabel] : ModeLabel)</span>
    </div>


    <div class="tm-document-editor__status-bar-group tm-document-editor__status-bar-group--save" role="status" aria-live="polite">
        @if (PendingCount > 0)
        {
            <span class="tm-document-editor__pending" data-testid="@TestId("document-pending-status")">
                @if (!string.IsNullOrWhiteSpace(PendingMessage))
                {
                    @PendingMessage
                }
                else
                {
                    @Loc["TmDocumentEditor_PendingActions", PendingCount]
                }
            </span>
        }
        else if (IsDirty)
        {
            <span class="tm-document-editor__dirty" data-testid="@TestId("document-dirty-status")">@Loc["TmDocumentEditor_UnsavedChanges"]</span>
        }
        @if (!string.IsNullOrWhiteSpace(SaveMessage))
        {
            <span class="tm-document-editor__save-message" data-testid="@TestId("document-save-message")">@SaveMessage</span>
            @if (CanRetrySave)
            {
                <button type="button"
                        class="tm-document-editor__save-retry"
                        data-testid="@TestId("document-save-retry")"
                        @onclick="OnRetrySave">
                    @Loc["TmDocumentEditor_Retry"]
                </button>
            }
        }
        @if (ShowLastSaved && LastSavedAt is not null)
        {
            <span class="tm-document-editor__last-saved" data-testid="@TestId("document-last-saved")">
                @Loc["TmDocumentEditor_LastSavedAt", LastSavedAt.Value.ToLocalTime().ToString("HH:mm:ss")]
            </span>
        }
        @if (!string.IsNullOrWhiteSpace(RuntimeMessage))
        {
            <span class="tm-document-editor__runtime-message @(RuntimeFailed ? "tm-document-editor__runtime-message--failed" : "tm-document-editor__runtime-message--recovered")"
                  data-testid="@TestId("document-runtime-message")"
                  role="alert">@RuntimeMessage</span>
        }
    </div>

    <div class="tm-document-editor__status-bar-group tm-document-editor__status-bar-group--controls">
        @if (!ShowZoom)
        {
            @* a mode with a zoom of its own (the print preview) shows none here *@
        }
        else if (OnZoomChanged.HasDelegate)
        {
            <div class="tm-document-editor__status-zoom" role="group" aria-label="@Loc["TmDocumentEditor_ZoomGroupLabel"]" data-testid="@TestId("document-status-zoom-controls")">
                <button type="button"
                        class="tm-document-editor__status-button"
                        disabled="@(ZoomPercent <= ZoomMin)"
                        aria-label="@Loc["TmDocumentEditor_ZoomOut"]"
                        title="@Loc["TmDocumentEditor_ZoomOut"]"
                        data-testid="@TestId("document-status-zoom-out")"
                        @onclick="() => StepZoomAsync(-ZoomStep)">
                    <TmIcon Name="zoom-out" Size="IconSize.Sm" />
                </button>
                @* The zoom value is a MENU button (Phase 11 fix round): Automatic / Page width / Whole page and the round percents. The label is
                   the trigger text, so the percent a fitted page ended up at is always readable; the minus / plus buttons step on the grid of the
                   step (a fitted 62 % goes to 70 / 60, never to 72). *@
                <TmDropdown Class="tm-document-editor__status-zoom-menu"
                            Text="@ZoomLabel"
                            AriaLabel="@(string.IsNullOrEmpty(ZoomAriaLabel) ? Loc["TmDocumentEditor_ZoomStatus", ZoomLabel] : ZoomAriaLabel)"
                            ShowChevron="true"
                            Placement="OverlayPlacement.Top"
                            OnSelect="OnZoomMenuSelectAsync"
                            data-testid="@TestId("document-status-zoom")">
                    @if (ShowAutomaticZoom)
                    {
                        <TmDropdownItem Value="auto" Checked="@(ZoomAutoFit == "narrow")" data-testid="@TestId("document-status-zoom-auto")">@Loc["TmDocumentEditor_ZoomMenuAutomatic"]</TmDropdownItem>
                    }
                    <TmDropdownItem Value="pagewidth" Checked="@(ZoomPreset == "fitWidth" && ZoomAutoFit != "narrow")" data-testid="@TestId("document-status-zoom-page-width")">@Loc["TmDocumentEditor_ZoomPageWidth"]</TmDropdownItem>
                    <TmDropdownItem Value="wholepage" Checked="@(ZoomPreset == "fitPage")" data-testid="@TestId("document-status-zoom-whole-page")">@Loc["TmDocumentEditor_ZoomWholePage"]</TmDropdownItem>
                    @foreach (var preset in ZoomMenuPercents)
                    {
                        <TmDropdownItem Value="@preset.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        Checked="@(ZoomPreset == "custom" && ZoomAutoFit == "off" && ZoomPercent == preset)"
                                        data-testid="@TestId($"document-status-zoom-{preset}")">@DocumentZoomMath.FormatPercent(preset, Loc.Culture)</TmDropdownItem>
                    }
                </TmDropdown>
                <button type="button"
                        class="tm-document-editor__status-button"
                        disabled="@(ZoomPercent >= ZoomMax)"
                        aria-label="@Loc["TmDocumentEditor_ZoomIn"]"
                        title="@Loc["TmDocumentEditor_ZoomIn"]"
                        data-testid="@TestId("document-status-zoom-in")"
                        @onclick="() => StepZoomAsync(ZoomStep)">
                    <TmIcon Name="zoom-in" Size="IconSize.Sm" />
                </button>
            </div>
        }
        else
        {
            <span data-testid="@TestId("document-status-zoom")" aria-label="@(string.IsNullOrEmpty(ZoomAriaLabel) ? Loc["TmDocumentEditor_ZoomStatus", ZoomLabel] : ZoomAriaLabel)">@ZoomLabel</span>
        }
        @if (OnToggleFullscreen.HasDelegate)
        {
            <button type="button"
                    class="tm-document-editor__status-button"
                    aria-pressed="@(IsFullscreen ? "true" : "false")"
                    aria-label="@Loc["TmDocumentEditor_Fullscreen"]"
                    title="@Loc["TmDocumentEditor_Fullscreen"]"
                    data-testid="@TestId("document-status-fullscreen")"
                    @onclick="() => OnToggleFullscreen.InvokeAsync()">
                <TmIcon Name="@(IsFullscreen ? "minimize-2" : "maximize")" Size="IconSize.Sm" />
            </button>
        }
    </div>
</footer>

@code {
    /// <summary>
    /// Names the mode the editor is in instead of the region being edited (the print preview: "Print preview"). Empty keeps "Editing {region}".
    /// </summary>
    [Parameter] public string? ModeLabel { get; set; }

    /// <summary>Whether the zoom control (or label) is shown. A mode that has a zoom of its own, like the print preview, hides this one.</summary>
    [Parameter] public bool ShowZoom { get; set; } = true;

    /// <summary>Whether the document has local unsaved changes.</summary>
    [Parameter] public bool IsDirty { get; set; }

    /// <summary>Number of currently pending async operations.</summary>
    [Parameter] public int PendingCount { get; set; }

    /// <summary>Message of the first pending operation, or <c>null</c> when none.</summary>
    [Parameter] public string? PendingMessage { get; set; }

    /// <summary>Optional save status message.</summary>
    [Parameter] public string? SaveMessage { get; set; }

    /// <summary>Whether the latest save failure can be retried.</summary>
    [Parameter] public bool CanRetrySave { get; set; }

    /// <summary>Raised when the user requests retry after a recoverable save failure.</summary>
    [Parameter] public EventCallback OnRetrySave { get; set; }

    /// <summary>Timestamp of the latest successful save.</summary>
    [Parameter] public DateTimeOffset? LastSavedAt { get; set; }

    /// <summary>
    /// Whether the last-saved text is shown here. Defaults to <c>true</c>; the editor passes <c>false</c> while its header is visible,
    /// because the header owns the save state then and the same text must not render twice.
    /// </summary>
    [Parameter] public bool ShowLastSaved { get; set; } = true;

    /// <summary>Current document word count.</summary>
    [Parameter] public int WordCount { get; set; }

    /// <summary>Current document page count.</summary>
    [Parameter] public int PageCount { get; set; } = 1;

    /// <summary>The page the reader is on, one-based ("Page 2 of 6").</summary>
    [Parameter] public int CurrentPage { get; set; } = 1;

    /// <summary>The zoom in percent; the minus / plus buttons step from it and disable at <see cref="ZoomMin"/> / <see cref="ZoomMax"/>.</summary>
    [Parameter] public int ZoomPercent { get; set; } = 100;

    /// <summary>
    /// The lowest zoom the buttons and the menu percents reach, in percent. Defaults to the editor's reader floor, 50. The AUTOMATIC fit may show a smaller
    /// page on a narrow phone (the engine's floor is 25); the first step of the buttons from such a page lands on this floor.
    /// </summary>
    [Parameter] public int ZoomMin { get; set; } = 50;

    /// <summary>The highest zoom the buttons reach, in percent. Defaults to the editor's own ceiling, 200.</summary>
    [Parameter] public int ZoomMax { get; set; } = 200;

    /// <summary>How far one press of minus / plus moves the zoom, in percent. Defaults to 10.</summary>
    [Parameter] public int ZoomStep { get; set; } = 10;

    /// <summary>Raised with the new zoom percent when the reader presses minus / plus or picks a percent of the menu. The controls render only when it is bound.</summary>
    [Parameter] public EventCallback<int> OnZoomChanged { get; set; }

    /// <summary>The zoom preset the engine reports: <c>custom</c>, <c>fitWidth</c> or <c>fitPage</c>. Marks the checked entry of the zoom menu.</summary>
    [Parameter] public string ZoomPreset { get; set; } = "custom";

    /// <summary>The automatic-fit state the engine reports: <c>off</c> (the reader's zoom), <c>narrow</c> (Automatic) or <c>always</c> (Page width).</summary>
    [Parameter] public string ZoomAutoFit { get; set; } = "off";

    /// <summary>Whether the "Automatic" entry is offered. The editor hides it while its page fit mode is Off: there is no automatic zoom to return to.</summary>
    [Parameter] public bool ShowAutomaticZoom { get; set; }

    /// <summary>The accessible name of the zoom value. A fitted page names the fit ("Zoom 62 percent, fitted to width"); null derives it from <see cref="ZoomLabel"/>.</summary>
    [Parameter] public string? ZoomAriaLabel { get; set; }

    /// <summary>Raised when "Automatic" is chosen: back to the editor's configured automatic fit.</summary>
    [Parameter] public EventCallback OnZoomAutomatic { get; set; }

    /// <summary>Raised when "Page width" is chosen: the page follows the column from now on.</summary>
    [Parameter] public EventCallback OnZoomPageWidth { get; set; }

    /// <summary>Raised when "Whole page" is chosen: the whole page fits the document region.</summary>
    [Parameter] public EventCallback OnZoomWholePage { get; set; }

    /// <summary>Whether the editor is in fullscreen (the switch is pressed).</summary>
    [Parameter] public bool IsFullscreen { get; set; }

    /// <summary>Raised when the fullscreen switch is pressed. The switch renders only when it is bound.</summary>
    [Parameter] public EventCallback OnToggleFullscreen { get; set; }

    /// <summary>Label for the active editing region.</summary>
    [Parameter] public string ActiveRegionLabel { get; set; } = string.Empty;

    /// <summary>Current zoom label.</summary>
    [Parameter] public string ZoomLabel { get; set; } = "100%";

    /// <summary>Message shown after a JS runtime recovery event, or <c>null</c> when none.</summary>
    [Parameter] public string? RuntimeMessage { get; set; }

    /// <summary>When <c>true</c>, <see cref="RuntimeMessage"/> describes a recovery failure.</summary>
    [Parameter] public bool RuntimeFailed { get; set; }

    private IEnumerable<int> ZoomMenuPercents => new[] { 50, 75, 100, 125, 150, 200 }.Where(percent => percent >= ZoomMin && percent <= ZoomMax);

    // The buttons step on the grid of ZoomStep: from a fitted 62 percent the next step is 70 / 60, never 72 / 52.
    private Task StepZoomAsync(int delta)
        => OnZoomChanged.InvokeAsync(DocumentZoomMath.Step(ZoomPercent, Math.Abs(delta), ZoomMin, ZoomMax, up: delta > 0));

    private Task OnZoomMenuSelectAsync(string value) => value switch
    {
        "auto" => OnZoomAutomatic.InvokeAsync(),
        "pagewidth" => OnZoomPageWidth.InvokeAsync(),
        "wholepage" => OnZoomWholePage.InvokeAsync(),
        _ => int.TryParse(value, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var percent)
            ? OnZoomChanged.InvokeAsync(Math.Clamp(percent, ZoomMin, ZoomMax))
            : Task.CompletedTask,
    };
}
