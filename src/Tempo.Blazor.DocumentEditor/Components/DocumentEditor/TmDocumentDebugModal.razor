@namespace Tempo.Blazor.Components.DocumentEditor
@inherits Tempo.Blazor.Components.TmComponentBase
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@if (IsOpen)
{
    <div @ref="_dialog"
         class="tm-document-json-debug-modal"
         data-testid="@TestId(ModalTestId)"
         role="dialog"
         aria-modal="true"
         aria-label="@Title">
        <div class="tm-document-json-debug-modal__backdrop" @onclick="OnClose"></div>
        <div class="tm-document-json-debug-modal__content">
            <header class="tm-document-json-debug-modal__header">
                <span class="tm-document-json-debug-modal__title">@Title</span>
                @if (OnCopy.HasDelegate)
                {
                    <button type="button"
                            @ref="_copyButton"
                            class="tm-document-json-debug-modal__copy"
                            data-testid="@(string.IsNullOrEmpty(CopyTestId) ? null : TestId(CopyTestId))"
                            title="@Loc["TmDocumentEditor_Copy"]"
                            aria-label="@Loc["TmDocumentEditor_Copy"]"
                            @onclick="OnCopy">
                        <TmIcon Name="copy" Size="IconSize.Sm" />
                    </button>
                }
                <button type="button"
                        @ref="_closeButton"
                        class="tm-document-json-debug-modal__close"
                        data-testid="@(string.IsNullOrEmpty(CloseTestId) ? null : TestId(CloseTestId))"
                        title="@Loc["TmDocumentEditor_Close"]"
                        aria-label="@Loc["TmDocumentEditor_Close"]"
                        @onclick="OnClose">
                    <TmIcon Name="x" Size="IconSize.Sm" />
                </button>
            </header>
            @ChildContent
        </div>
    </div>
}

@code {
    private ElementReference _dialog;
    private ElementReference _copyButton;
    private ElementReference _closeButton;
    private DocumentEditorFocusTrapController? _focusTrap;
    private bool _focusTrapActive;

    /// <summary>Whether the modal is open.</summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>Modal title; it is the visible heading and the dialog's accessible name.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Unprefixed test id of the dialog root (resolved through <c>TestIdPrefix</c>).</summary>
    [Parameter, EditorRequired] public string ModalTestId { get; set; } = string.Empty;

    /// <summary>Unprefixed test id of the close button. No test id when omitted.</summary>
    [Parameter] public string? CloseTestId { get; set; }

    /// <summary>Unprefixed test id of the copy button. No test id when omitted.</summary>
    [Parameter] public string? CopyTestId { get; set; }

    /// <summary>Raised when the user asks to copy the payload. The copy button is rendered only when a handler is bound.</summary>
    [Parameter] public EventCallback OnCopy { get; set; }

    /// <summary>Raised when the modal should close (close button or backdrop).</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>The sections, normally <see cref="TmDocumentDebugSection"/> elements.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen)
        {
            if (!_focusTrapActive)
            {
                _focusTrap ??= new DocumentEditorFocusTrapController(JSRuntime);
                await _focusTrap.ActivateAsync(_dialog, OnCopy.HasDelegate ? _copyButton : _closeButton);
                _focusTrapActive = true;
            }

            return;
        }

        await ReleaseFocusTrapAsync(restoreFocus: true);
    }

    private async ValueTask ReleaseFocusTrapAsync(bool restoreFocus)
    {
        if (_focusTrap is not null && _focusTrapActive)
        {
            await _focusTrap.ReleaseAsync(restoreFocus);
        }

        _focusTrapActive = false;
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        await ReleaseFocusTrapAsync(restoreFocus: false);
        if (_focusTrap is not null)
        {
            await _focusTrap.DisposeAsync();
        }
    }
}
