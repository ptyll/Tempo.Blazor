@namespace Tempo.Blazor.Components.DocumentEditor
@inherits Tempo.Blazor.Components.TmComponentBase
@using System.Globalization
@using Tempo.Blazor.DocumentEditor.Models
@implements IDisposable

@* Redesign 146c7e1b, phase 6 (DE-2.2): the image inspector is the shared inspector form - chevron sections without frames, the
   label beside its control, a unit suffix on every number, wrap modes as icon + text tiles and the alignment as a segmented
   control. Hosted in the desktop inspector as the "image" context, whose header names it (ShowHeader=false); standalone and on
   the tablet / phone Properties tab it carries its own header. *@
<section class="tm-document-image-inspector tm-document-inspector-form tm-document-inspector-form--embedded"
         role="complementary"
         aria-label="@Loc["TmDocumentEditor_ImageInspectorLabel"]"
         data-testid="@TestId("document-image-inspector")"
         data-human-testid="document-image-properties-panel">
    @if (ShowHeader)
    {
        <TmDocumentInspectorHeader Title="@Loc["TmDocumentEditor_ImageTools"]"
                                   Icon="image"
                                   HeadingLevel="3"
                                   TestIdPrefix="@TestIdPrefix" />
    }

    @if (!ShortSet)
    {
    <TmDocumentInspectorSection Title="@Loc["TmDocumentEditor_ImageSectionPicture"]"
                                SectionTestId="document-image-inspector-section-picture"
                                TestIdPrefix="@TestIdPrefix">
        @if (ShowUrlImageLinkField)
        {
            <label class="tm-document-inspector-form__field">
                <span class="tm-document-inspector-form__label">@Loc["TmDocumentEditor_ImageUrl"]</span>
                <input class="tm-input"
                   value="@_linkInput"
                   placeholder="@Loc["TmDocumentEditor_ImageUrlPlaceholder"]"
                   data-testid="@TestId("document-image-inspector-link")"
                   @oninput="HandleLinkInputAsync"
                   @onchange="HandleLinkChangedAsync" />
            </label>
        }
        else
        {
            <div class="tm-document-inspector-form__field tm-document-image-inspector__asset"
                 data-testid="@TestId("document-image-inspector-asset-info")">
                <span class="tm-document-inspector-form__label">@ImageSourceLabel</span>
                <strong class="tm-document-image-inspector__asset-value">@ImageSourceValue</strong>
            </div>
        }

        @if (ToggleCaption.HasDelegate || CaptionChanged.HasDelegate)
        {
            <label class="tm-document-inspector-form__check">
                <input type="checkbox"
                       checked="@HasCaption"
                       data-testid="@TestId("document-image-inspector-caption-toggle")"
                       @onchange="HandleCaptionToggleChangedAsync" />
                <span>@Loc["TmDocumentEditor_ImageToggleCaption"]</span>
            </label>
        }

        @if (CaptionChanged.HasDelegate)
        {
            <label class="tm-document-inspector-form__field">
                <span class="tm-document-inspector-form__label">@Loc["TmDocumentEditor_ImageCaption"]</span>
                <input class="tm-input"
                   value="@_captionInput"
                   placeholder="@Loc["TmDocumentEditor_ImageCaption"]"
                   data-testid="@TestId("document-image-inspector-caption")"
                   data-human-testid="document-image-caption-input"
                   @oninput="HandleCaptionInputAsync"
                   @onchange="HandleCaptionChangedAsync" />
            </label>
        }
    </TmDocumentInspectorSection>
    }

    @if (SizeChanged.HasDelegate && !ShortSet)
    {
        <TmDocumentInspectorSection Title="@Loc["TmDocumentEditor_ImageSectionSizeRotation"]"
                                    SectionTestId="document-image-inspector-section-size"
                                    TestIdPrefix="@TestIdPrefix">
            <div class="tm-document-image-inspector__triple">
                <label class="tm-document-inspector-form__field tm-document-inspector-form__field--stacked">
                    <span class="tm-document-inspector-form__label">@Loc["TmDocumentEditor_ImageWidth"]</span>
                    <span class="tm-document-inspector-form__adorned">
                        <input class="tm-input"
                           type="number"
                           min="1"
                           step="1"
                           value="@_widthInput"
                           data-testid="@TestId("document-image-inspector-width")"
                           data-human-testid="document-image-width-input"
                           @oninput="HandleWidthInputAsync"
                           @onchange="HandleWidthChangedAsync"
                               aria-describedby="@_widthUnitId" />
                        <span class="tm-document-inspector-form__suffix" id="@_widthUnitId">@Loc["TmDocumentEditor_UnitPx"]</span>
                    </span>
                </label>
                <label class="tm-document-inspector-form__field tm-document-inspector-form__field--stacked">
                    <span class="tm-document-inspector-form__label">@Loc["TmDocumentEditor_ImageHeight"]</span>
                    <span class="tm-document-inspector-form__adorned">
                        <input class="tm-input"
                           type="number"
                           min="1"
                           step="1"
                           value="@_heightInput"
                           data-testid="@TestId("document-image-inspector-height")"
                           data-human-testid="document-image-height-input"
                           @oninput="HandleHeightInputAsync"
                           @onchange="HandleHeightChangedAsync"
                               aria-describedby="@_heightUnitId" />
                        <span class="tm-document-inspector-form__suffix" id="@_heightUnitId">@Loc["TmDocumentEditor_UnitPx"]</span>
                    </span>
                </label>
                <label class="tm-document-inspector-form__field tm-document-inspector-form__field--stacked">
                    <span class="tm-document-inspector-form__label">@Loc["TmDocumentEditor_ImageRotation"]</span>
                    <span class="tm-document-inspector-form__adorned">
                        <input class="tm-input"
                           type="number"
                           value="@RotationValue"
                           data-testid="@TestId("document-image-inspector-rotation")"
                           readonly
                               aria-describedby="@_rotationUnitId" />
                        <span class="tm-document-inspector-form__suffix" id="@_rotationUnitId">@Loc["TmDocumentEditor_UnitDegrees"]</span>
                    </span>
                </label>
            </div>
            <div class="tm-document-image-inspector__size-actions">
                <label class="tm-document-inspector-form__check">
                    <input type="checkbox"
                           checked="@LockAspectRatio"
                           data-testid="@TestId("document-image-inspector-lock-aspect")"
                           @onchange="HandleLockAspectRatioChangedAsync" />
                    <span>@Loc["TmDocumentEditor_ImageLockAspectRatio"]</span>
                </label>
                <button type="button"
                        class="tm-btn tm-btn-sm tm-btn-secondary tm-document-image-inspector__command"
                        data-testid="@TestId("document-image-inspector-reset-size")"
                        @onclick="HandleResetSizeAsync">
                    @Loc["TmDocumentEditor_ImageResetSize"]
                </button>
            </div>
        </TmDocumentInspectorSection>
    }

    @if (WrapModeChanged.HasDelegate)
    {
        <TmDocumentInspectorSection Title="@Loc["TmDocumentEditor_ImageSectionWrapping"]"
                                    SectionTestId="document-image-inspector-section-wrap"
                                    TestIdPrefix="@TestIdPrefix">
            <div class="tm-document-inspector-form__field tm-document-inspector-form__field--stacked">
                <span class="tm-document-inspector-form__label" id="@_wrapLabelId">@Loc["TmDocumentEditor_ImageWrapMode"]</span>
                <div class="tm-document-image-inspector__tiles" role="group" aria-labelledby="@_wrapLabelId">
                    @foreach (var tile in WrapTiles)
                    {
                        <button type="button"
                                class="@WrapButtonClass(tile.Mode)"
                                aria-pressed="@AriaPressed(CurrentWrapMode == tile.Mode)"
                                data-testid="@TestId(tile.TestId)"
                                data-human-testid="document-image-wrap-button"
                                data-wrap-mode="@tile.Mode"
                                @onclick="() => WrapModeChanged.InvokeAsync(tile.Mode)">
                            <TmIcon Name="@WrapIcon(tile.Mode)" Size="IconSize.Sm" />
                            <span class="tm-document-image-inspector__tile-label">@Loc[tile.LabelKey]</span>
                        </button>
                    }
                </div>
            </div>
        </TmDocumentInspectorSection>
    }

    @if (AlignmentChanged.HasDelegate || PositionChanged.HasDelegate || LockAnchorChanged.HasDelegate)
    {
        <TmDocumentInspectorSection Title="@Loc["TmDocumentEditor_ImageSectionPosition"]"
                                    SectionTestId="document-image-inspector-section-position"
                                    TestIdPrefix="@TestIdPrefix">
            @if (AlignmentChanged.HasDelegate)
            {
                <div class="tm-document-inspector-form__field">
                    <span class="tm-document-inspector-form__label" id="@_alignLabelId">@Loc["TmDocumentEditor_ImageAlignment"]</span>
                    <div class="tm-document-inspector-form__segmented" role="group" aria-labelledby="@_alignLabelId">
                        @foreach (var option in AlignmentOptions)
                        {
                            <button type="button"
                                    class="@AlignmentButtonClass(option.Alignment)"
                                    aria-pressed="@AriaPressed(CurrentAlignment == option.Alignment)"
                                    data-testid="@TestId(option.TestId)"
                                    @onclick="() => AlignmentChanged.InvokeAsync(option.Alignment)">
                                @Loc[option.LabelKey]
                            </button>
                        }
                    </div>
                </div>
            }
            @if (PositionChanged.HasDelegate && !ShortSet)
            {
                <div class="tm-document-image-inspector__pair">
                    <label class="tm-document-inspector-form__field">
                        <span class="tm-document-inspector-form__label">@Loc["TmDocumentEditor_ImagePositionX"]</span>
                        <span class="tm-document-inspector-form__adorned">
                            <input class="tm-input"
                               type="number"
                               step="1"
                               value="@_xInput"
                               data-testid="@TestId("document-image-inspector-position-x")"
                               @oninput="HandlePositionXInputAsync"
                               @onchange="HandlePositionXChangedAsync"
                                   aria-describedby="@_xUnitId" />
                            <span class="tm-document-inspector-form__suffix" id="@_xUnitId">@Loc["TmDocumentEditor_UnitPx"]</span>
                        </span>
                    </label>
                    <label class="tm-document-inspector-form__field">
                        <span class="tm-document-inspector-form__label">@Loc["TmDocumentEditor_ImagePositionY"]</span>
                        <span class="tm-document-inspector-form__adorned">
                            <input class="tm-input"
                               type="number"
                               step="1"
                               value="@_yInput"
                               data-testid="@TestId("document-image-inspector-position-y")"
                               @oninput="HandlePositionYInputAsync"
                               @onchange="HandlePositionYChangedAsync"
                                   aria-describedby="@_yUnitId" />
                            <span class="tm-document-inspector-form__suffix" id="@_yUnitId">@Loc["TmDocumentEditor_UnitPx"]</span>
                        </span>
                    </label>
                </div>
            }
            @if (!ShortSet)
            {
            <div class="tm-document-inspector-form__field tm-document-image-inspector__asset"
                 data-testid="@TestId("document-image-inspector-anchor-paragraph")">
                <span class="tm-document-inspector-form__label">@Loc["TmDocumentEditor_ImageAnchorParagraph"]</span>
                <strong class="tm-document-image-inspector__asset-value">@AnchorParagraphLabel</strong>
            </div>
            }
            @if (LockAnchorChanged.HasDelegate && !ShortSet)
            {
                <label class="tm-document-inspector-form__check">
                    <input type="checkbox"
                           checked="@IsAnchorLocked"
                           data-testid="@TestId("document-image-inspector-lock-anchor")"
                           @onchange="HandleLockAnchorChangedAsync" />
                    <span>@Loc["TmDocumentEditor_ImageLockAnchor"]</span>
                </label>
            }
        </TmDocumentInspectorSection>
    }

    @if ((BringForward.HasDelegate || SendBackward.HasDelegate) && !ShortSet)
    {
        <TmDocumentInspectorSection Title="@Loc["TmDocumentEditor_ImageSectionOrder"]"
                                    SectionTestId="document-image-inspector-section-order"
                                    TestIdPrefix="@TestIdPrefix">
            <div class="tm-document-image-inspector__order" role="group" aria-label="@Loc["TmDocumentEditor_ImageSectionOrder"]">
                @if (BringForward.HasDelegate)
                {
                    <button type="button"
                            class="tm-btn tm-btn-sm tm-btn-secondary"
                            data-testid="@TestId("document-image-inspector-bring-forward")"
                            @onclick="() => BringForward.InvokeAsync()">
                        @Loc["TmDocumentEditor_ImageBringForward"]
                    </button>
                }
                @if (SendBackward.HasDelegate)
                {
                    <button type="button"
                            class="tm-btn tm-btn-sm tm-btn-secondary"
                            data-testid="@TestId("document-image-inspector-send-backward")"
                            @onclick="() => SendBackward.InvokeAsync()">
                        @Loc["TmDocumentEditor_ImageSendBackward"]
                    </button>
                }
            </div>
        </TmDocumentInspectorSection>
    }

    <TmDocumentInspectorSection Title="@Loc["TmDocumentEditor_ImageSectionAccessibility"]"
                                SectionTestId="document-image-inspector-section-accessibility"
                                TestIdPrefix="@TestIdPrefix">
        @if (AltTextChanged.HasDelegate)
        {
            <label class="tm-document-inspector-form__field">
                <span class="tm-document-inspector-form__label">@Loc["TmDocumentEditor_ImageAltText"]</span>
                <input class="tm-input"
                   value="@_altInput"
                   disabled="@IsDecorative"
                   data-testid="@TestId("document-image-inspector-alt")"
                   data-human-testid="document-image-alt-input"
                   @oninput="HandleAltTextInputAsync"
                   @onchange="HandleAltTextChangedAsync" />
            </label>
        }
        @if (DecorativeChanged.HasDelegate)
        {
            <label class="tm-document-inspector-form__check">
                <input type="checkbox"
                       checked="@IsDecorative"
                       data-testid="@TestId("document-image-inspector-decorative")"
                       @onchange="HandleDecorativeChangedAsync" />
                <span>@Loc["TmDocumentEditor_ImageDecorative"]</span>
            </label>
        }
        @if (IsDecorative)
        {
            <div class="tm-document-image-inspector__hint"
                 role="status"
                 data-testid="@TestId("document-image-inspector-decorative-hint")">
                @Loc["TmDocumentEditor_ImageDecorativeHint"]
            </div>
        }
        else if (string.IsNullOrWhiteSpace(_altInput))
        {
            <div class="tm-document-image-inspector__warning"
                 role="status"
                 data-testid="@TestId("document-image-inspector-alt-warning")">
                @Loc["TmDocumentEditor_ImageAltMissing"]
            </div>
        }
    </TmDocumentInspectorSection>
</section>

@code {
    /// <summary>Image content displayed by the inspector.</summary>
    [Parameter] public ImageBlockContent? Image { get; set; }

    /// <summary>
    /// Text of the paragraph the image is anchored to (its first ~40 characters), resolved by the host from the document. Shown in
    /// the Position section instead of the block id; when it is not supplied an anchored image reads "Current paragraph".
    /// </summary>
    [Parameter] public string? AnchorText { get; set; }

    /// <summary>
    /// Whether the inspector renders its own header (icon and "Image tools"). Defaults to <c>true</c>; the desktop inspector hosts the
    /// panel as a contextual surface whose header already names it and passes <c>false</c>.
    /// </summary>
    [Parameter] public bool ShowHeader { get; set; } = true;

    /// <summary>
    /// The short set of a phone (decision G2: viewing plus light edits): the wrapping, the alignment and the alternative text. The picture
    /// source, the size, the exact position, the anchor and the stacking order stay for a tablet and up. Defaults to <c>false</c> (the
    /// full inspector).
    /// </summary>
    [Parameter] public bool ShortSet { get; set; }

    /// <summary>Raised when alternative text changes. The control renders only when this callback is bound.</summary>
    [Parameter] public EventCallback<string> AltTextChanged { get; set; }

    /// <summary>Raised when decorative image mode changes. The control renders only when this callback is bound.</summary>
    [Parameter] public EventCallback<bool> DecorativeChanged { get; set; }

    /// <summary>Raised when the caption should be toggled. The caption toggle renders only when this callback (or CaptionChanged) is bound.</summary>
    [Parameter] public EventCallback ToggleCaption { get; set; }

    /// <summary>Raised when the image caption text changes. The caption field (and the caption toggle) render only when this callback is bound.</summary>
    [Parameter] public EventCallback<string> CaptionChanged { get; set; }

    /// <summary>Raised when the source URL of an URL-backed image changes. The editable URL field renders only when this callback is bound; otherwise the source is shown read-only.</summary>
    [Parameter] public EventCallback<string?> UrlChanged { get; set; }

    /// <summary>Raised when text wrapping mode changes. The whole Wrapping section renders only when this callback is bound.</summary>
    [Parameter] public EventCallback<DocumentWrapMode> WrapModeChanged { get; set; }

    /// <summary>Raised when alignment changes. The alignment buttons render only when this callback is bound.</summary>
    [Parameter] public EventCallback<DocumentImageAlignment> AlignmentChanged { get; set; }

    /// <summary>Raised when image size changes. The whole Size section renders only when this callback is bound.</summary>
    [Parameter] public EventCallback<DocumentImageSize> SizeChanged { get; set; }

    /// <summary>Raised when image object position offsets change. The X / Y position fields render only when this callback is bound.</summary>
    [Parameter] public EventCallback<DocumentObjectPosition> PositionChanged { get; set; }

    /// <summary>Raised when the object anchor lock changes. The control renders only when this callback is bound.</summary>
    [Parameter] public EventCallback<bool> LockAnchorChanged { get; set; }

    /// <summary>Raised when the image should move one layer forward. The control renders only when this callback is bound.</summary>
    [Parameter] public EventCallback BringForward { get; set; }

    /// <summary>Raised when the image should move one layer backward. The control renders only when this callback is bound.</summary>
    [Parameter] public EventCallback SendBackward { get; set; }

    private const int InputDebounceMilliseconds = 250;

    private readonly string _widthUnitId = $"tm-document-image-width-unit-{Guid.NewGuid():N}";
    private readonly string _heightUnitId = $"tm-document-image-height-unit-{Guid.NewGuid():N}";
    private readonly string _rotationUnitId = $"tm-document-image-rotation-unit-{Guid.NewGuid():N}";
    private readonly string _xUnitId = $"tm-document-image-x-unit-{Guid.NewGuid():N}";
    private readonly string _yUnitId = $"tm-document-image-y-unit-{Guid.NewGuid():N}";
    private readonly string _wrapLabelId = $"tm-document-image-wrap-{Guid.NewGuid():N}";
    private readonly string _alignLabelId = $"tm-document-image-align-{Guid.NewGuid():N}";

    private static readonly (DocumentWrapMode Mode, string TestId, string LabelKey)[] WrapTiles =
    [
        (DocumentWrapMode.Inline, "document-image-inspector-wrap-inline", "TmDocumentEditor_ImageWrapInline"),
        (DocumentWrapMode.Square, "document-image-inspector-wrap-square", "TmDocumentEditor_ImageWrapSquare"),
        (DocumentWrapMode.Tight, "document-image-inspector-wrap-tight", "TmDocumentEditor_ImageWrapTight"),
        (DocumentWrapMode.Through, "document-image-inspector-wrap-through", "TmDocumentEditor_ImageWrapThrough"),
        (DocumentWrapMode.TopBottom, "document-image-inspector-wrap-top-bottom", "TmDocumentEditor_ImageWrapTopBottom"),
        (DocumentWrapMode.BehindText, "document-image-inspector-wrap-behind", "TmDocumentEditor_ImageWrapBehindText"),
        (DocumentWrapMode.InFrontOfText, "document-image-inspector-wrap-in-front", "TmDocumentEditor_ImageWrapInFrontOfText")
    ];

    private static readonly (DocumentImageAlignment Alignment, string TestId, string LabelKey)[] AlignmentOptions =
    [
        (DocumentImageAlignment.Start, "document-image-inspector-align-start", "TmDocumentEditor_ImageAlignStart"),
        (DocumentImageAlignment.Center, "document-image-inspector-align-center", "TmDocumentEditor_ImageAlignCenter"),
        (DocumentImageAlignment.End, "document-image-inspector-align-end", "TmDocumentEditor_ImageAlignEnd")
    ];

    private CancellationTokenSource? _altDebounce;
    private CancellationTokenSource? _captionDebounce;
    private CancellationTokenSource? _linkDebounce;
    private CancellationTokenSource? _sizeDebounce;
    private CancellationTokenSource? _positionDebounce;
    private string _altInput = string.Empty;
    private string _captionInput = string.Empty;
    private string _linkInput = string.Empty;
    private string _widthInput = string.Empty;
    private string _heightInput = string.Empty;
    private string _xInput = string.Empty;
    private string _yInput = string.Empty;
    private string? _lastImageSyncKey;
    private string? _lastDispatchedAlt;
    private string? _lastDispatchedCaption;
    private string? _lastDispatchedLink;
    private string? _lastDispatchedSize;
    private string? _lastDispatchedPosition;

    private string AltText => Image?.AltText ?? string.Empty;

    private string ImageUrl => Image?.Url ?? string.Empty;

    private string CaptionValue => Image?.Caption ?? string.Empty;

    private bool HasCaption => !string.IsNullOrWhiteSpace(CaptionValue);

    private bool ShowUrlImageLinkField =>
        UrlChanged.HasDelegate && Image?.Source == DocumentImageSource.Url && IsEditableImageUrl(Image.Url);

    private DocumentWrapMode CurrentWrapMode => Image?.Layout.Wrap.Mode ?? DocumentWrapMode.Inline;

    private DocumentImageAlignment CurrentAlignment =>
        Image?.Layout.Position.HorizontalAlignment switch
        {
            DocumentImageHorizontalPosition.Left => DocumentImageAlignment.Start,
            DocumentImageHorizontalPosition.Right => DocumentImageAlignment.End,
            DocumentImageHorizontalPosition.Center => DocumentImageAlignment.Center,
            _ => Image?.Alignment ?? DocumentImageAlignment.Center
        };

    private string WidthValue => (Image?.Layout.Transform.Width ?? Image?.Size.Width)?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;

    private string HeightValue => (Image?.Layout.Transform.Height ?? Image?.Size.Height)?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;

    private string PositionXValue => FormatNumber(Image?.Layout.Position.X ?? 0);

    private string PositionYValue => FormatNumber(Image?.Layout.Position.Y ?? 0);

    private string RotationValue => FormatNumber(Image?.Layout.Transform.Rotation ?? 0);

    private bool IsAnchorLocked => Image?.Layout.Anchor.LockAnchor ?? false;

    private bool LockAspectRatio => Image?.Size.LockAspectRatio ?? true;

    private bool IsDecorative => Image?.IsDecorative ?? false;

    // The block id is an implementation detail: the host resolves the paragraph's own text; without it an anchored image reads
    // "Current paragraph" and only an unanchored one reads "Not anchored".
    private string AnchorParagraphLabel =>
        NormalizeOptionalValue(AnchorText)
        ?? (NormalizeOptionalValue(Image?.Layout.Anchor.BlockId) is null
            ? Loc["TmDocumentEditor_ImageAnchorUnknown"]
            : Loc["TmDocumentEditor_ImageAnchorCurrent"]);

    private string ImageSourceLabel =>
        Image?.Source switch
        {
            DocumentImageSource.Asset => Loc["TmDocumentEditor_ImageSourceAsset"],
            DocumentImageSource.Clipboard => Loc["TmDocumentEditor_ImageSourceClipboard"],
            _ when !IsEditableImageUrl(Image?.Url) && !string.IsNullOrWhiteSpace(Image?.Url) => Loc["TmDocumentEditor_ImageSourceDataUrl"],
            _ => Loc["TmDocumentEditor_ImageSourceUrl"]
        };

    private string ImageSourceValue =>
        Image?.Source switch
        {
            DocumentImageSource.Asset => string.IsNullOrWhiteSpace(Image?.AssetId) ? Loc["TmDocumentEditor_ImageSourceAsset"] : Image.AssetId!,
            DocumentImageSource.Clipboard => string.IsNullOrWhiteSpace(Image?.AssetId) ? Loc["TmDocumentEditor_ImageSourceClipboard"] : Image.AssetId!,
            _ when ImageUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase) => Loc["TmDocumentEditor_ImageSourceDataUrl"],
            _ => NormalizeOptionalValue(Image?.Url) ?? Loc["TmDocumentEditor_ImageSourceUrl"]
        };

    protected override void OnParametersSet()
    {
        var syncKey = string.Join('|',
            Image?.Source.ToString() ?? string.Empty,
            Image?.Url ?? string.Empty,
            Image?.AssetId ?? string.Empty,
            Image?.AltText ?? string.Empty,
            Image?.Caption ?? string.Empty,
            IsDecorative.ToString(),
            WidthValue,
            HeightValue,
            PositionXValue,
            PositionYValue,
            Image?.Layout.Anchor.BlockId ?? string.Empty,
            Image?.Layout.Anchor.Offset?.ToString(CultureInfo.InvariantCulture) ?? string.Empty,
            Image?.Layout.Anchor.Region.ToString(),
            Image?.Layout.Anchor.MoveWithText.ToString() ?? string.Empty,
            Image?.Layout.Anchor.FixedOnPage.ToString() ?? string.Empty,
            Image?.Layout.Anchor.LockAnchor.ToString() ?? string.Empty,
            CurrentWrapMode.ToString(),
            CurrentAlignment.ToString(),
            Image?.Size.LockAspectRatio.ToString(CultureInfo.InvariantCulture) ?? string.Empty);

        if (syncKey == _lastImageSyncKey)
        {
            return;
        }

        _lastImageSyncKey = syncKey;
        if (_altDebounce is null)
        {
            _altInput = AltText;
            _lastDispatchedAlt = AltText;
        }

        if (_captionDebounce is null)
        {
            _captionInput = CaptionValue;
            _lastDispatchedCaption = CaptionValue;
        }

        if (_linkDebounce is null)
        {
            _linkInput = ImageUrl;
            _lastDispatchedLink = NormalizeOptionalValue(ImageUrl) ?? string.Empty;
        }

        if (_sizeDebounce is null)
        {
            _widthInput = WidthValue;
            _heightInput = HeightValue;
            _lastDispatchedSize = SizeInputKey;
        }

        if (_positionDebounce is null)
        {
            _xInput = PositionXValue;
            _yInput = PositionYValue;
            _lastDispatchedPosition = PositionInputKey;
        }
    }

    private string WrapButtonClass(DocumentWrapMode mode) =>
        $"tm-document-image-inspector__tile{(CurrentWrapMode == mode ? " tm-document-image-inspector__tile--active" : "")}";

    private string AlignmentButtonClass(DocumentImageAlignment alignment) =>
        $"tm-document-inspector-form__segmented-option{(CurrentAlignment == alignment ? " tm-document-inspector-form__segmented-option--active" : "")}";

    private static string WrapIcon(DocumentWrapMode mode) => mode switch
    {
        DocumentWrapMode.Inline => "align-center",
        DocumentWrapMode.Square => "square",
        DocumentWrapMode.Tight => "scan-line",
        DocumentWrapMode.Through => "square-dashed",
        DocumentWrapMode.TopBottom => "between-horizontal-start",
        DocumentWrapMode.BehindText => "layers",
        DocumentWrapMode.InFrontOfText => "layout-panel-top",
        _ => "square"
    };

    private Task HandleAltTextInputAsync(ChangeEventArgs args)
    {
        if (IsDecorative)
        {
            return Task.CompletedTask;
        }

        _altInput = args.Value?.ToString() ?? string.Empty;
        ScheduleDebouncedAlt();
        return Task.CompletedTask;
    }

    private async Task HandleAltTextChangedAsync(ChangeEventArgs args)
    {
        if (IsDecorative)
        {
            return;
        }

        _altInput = args.Value?.ToString() ?? string.Empty;
        CancelDebounce(ref _altDebounce);
        await DispatchAltTextAsync();
    }

    private Task HandleLinkInputAsync(ChangeEventArgs args)
    {
        _linkInput = args.Value?.ToString() ?? string.Empty;
        ScheduleDebouncedLink();
        return Task.CompletedTask;
    }

    private async Task HandleLinkChangedAsync(ChangeEventArgs args)
