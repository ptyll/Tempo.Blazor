    private Task HandleLockAnchorChangedAsync(ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value
            ? value
            : string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

        return LockAnchorChanged.InvokeAsync(isChecked);
    }

    private Task HandleDecorativeChangedAsync(ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value
            ? value
            : string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

        CancelDebounce(ref _altDebounce);
        return DecorativeChanged.InvokeAsync(isChecked);
    }

    private DocumentImageSize CloneSize(bool? lockAspectRatio = null) =>
        new()
        {
            Width = ParsePositive(_widthInput),
            Height = ParsePositive(_heightInput),
            LockAspectRatio = lockAspectRatio ?? Image?.Size.LockAspectRatio ?? true
        };

    private async Task HandleLockAspectRatioChangedAsync(ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value
            ? value
            : string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

        CancelDebounce(ref _sizeDebounce);
        _lastDispatchedSize = string.Empty;
        await SizeChanged.InvokeAsync(CloneSize(isChecked));
    }

    private async Task HandleResetSizeAsync()
    {
        var natural = Image?.NaturalSize;
        var fallback = Image?.Size;
        var width = natural?.Width ?? fallback?.Width;
        var height = natural?.Height ?? fallback?.Height;
        if (width is null && height is null)
        {
            return;
        }

        _widthInput = width?.ToString("0.##", CultureInfo.InvariantCulture) ?? string.Empty;
        _heightInput = height?.ToString("0.##", CultureInfo.InvariantCulture) ?? string.Empty;
        CancelDebounce(ref _sizeDebounce);
        _lastDispatchedSize = string.Empty;
        await SizeChanged.InvokeAsync(new DocumentImageSize
        {
            Width = width,
            Height = height,
            LockAspectRatio = LockAspectRatio
        });
    }

    private DocumentObjectPosition ClonePosition() =>
        new()
        {
            HorizontalRelativeTo = Image?.Layout.Position.HorizontalRelativeTo ?? DocumentRelativePosition.Page,
            VerticalRelativeTo = Image?.Layout.Position.VerticalRelativeTo ?? DocumentRelativePosition.Paragraph,
            HorizontalAlignment = Image?.Layout.Position.HorizontalAlignment,
            VerticalAlignment = Image?.Layout.Position.VerticalAlignment ?? DocumentObjectVerticalAlignment.None,
            X = ParseNumber(_xInput),
            Y = ParseNumber(_yInput)
        };

    private string SizeInputKey => $"{_widthInput.Trim()}|{_heightInput.Trim()}|{Image?.Size.LockAspectRatio.ToString(CultureInfo.InvariantCulture) ?? string.Empty}";

    private string PositionInputKey => $"{_xInput.Trim()}|{_yInput.Trim()}";

    private static double? ParsePositive(object? value) =>
        double.TryParse(value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed) && parsed > 0
            ? parsed
            : null;

    private static double ParseNumber(object? value) =>
        double.TryParse(value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed)
            ? parsed
            : 0;

    private static string FormatNumber(double value) =>
        value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string AriaPressed(bool value) => value ? "true" : "false";

    private static string? NormalizeOptionalValue(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static bool IsEditableImageUrl(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var trimmed = value.Trim();
        if (trimmed.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (trimmed.StartsWith("/", StringComparison.Ordinal))
        {
            return true;
        }

        return Uri.TryCreate(trimmed, UriKind.Absolute, out var uri)
            && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);
    }

    private void ScheduleDebouncedAlt() =>
        ScheduleDebounced(ref _altDebounce, DispatchAltTextAsync);

    private void ScheduleDebouncedCaption() =>
        ScheduleDebounced(ref _captionDebounce, DispatchCaptionAsync);

    private void ScheduleDebouncedLink() =>
        ScheduleDebounced(ref _linkDebounce, DispatchLinkAsync);

    private void ScheduleDebouncedSize() =>
        ScheduleDebounced(ref _sizeDebounce, DispatchSizeAsync);

    private void ScheduleDebouncedPosition() =>
        ScheduleDebounced(ref _positionDebounce, DispatchPositionAsync);

    private void ScheduleDebounced(ref CancellationTokenSource? field, Func<Task> action)
    {
        CancelDebounce(ref field);
        var cts = new CancellationTokenSource();
        field = cts;
        _ = RunDebouncedAsync(cts, action);
    }

    private async Task RunDebouncedAsync(CancellationTokenSource cts, Func<Task> action)
    {
        try
        {
            await Task.Delay(InputDebounceMilliseconds, cts.Token);
            if (cts.IsCancellationRequested)
            {
                return;
            }

            await InvokeAsync(async () =>
            {
                ClearMatchingDebounce(cts);
                await action();
            });
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task DispatchAltTextAsync()
    {
        if (_altInput == _lastDispatchedAlt)
        {
            return;
        }

        _lastDispatchedAlt = _altInput;
        await AltTextChanged.InvokeAsync(_altInput);
    }

    private async Task DispatchCaptionAsync()
    {
        if (_captionInput == _lastDispatchedCaption)
        {
            return;
        }

        _lastDispatchedCaption = _captionInput;
        await CaptionChanged.InvokeAsync(_captionInput);
    }

    private async Task DispatchLinkAsync()
    {
        var normalized = NormalizeOptionalValue(_linkInput);
        if ((normalized ?? string.Empty) == (_lastDispatchedLink ?? string.Empty))
        {
            return;
        }

        _lastDispatchedLink = normalized ?? string.Empty;
        await UrlChanged.InvokeAsync(normalized);
    }

    private async Task DispatchSizeAsync()
    {
        var sizeKey = SizeInputKey;
        if (sizeKey == _lastDispatchedSize)
        {
            return;
        }

        _lastDispatchedSize = sizeKey;
        await SizeChanged.InvokeAsync(CloneSize());
    }

    private async Task DispatchPositionAsync()
    {
        var positionKey = PositionInputKey;
        if (positionKey == _lastDispatchedPosition)
        {
            return;
        }

        _lastDispatchedPosition = positionKey;
        await PositionChanged.InvokeAsync(ClonePosition());
    }

    private void ClearMatchingDebounce(CancellationTokenSource cts)
    {
        if (ReferenceEquals(_altDebounce, cts))
        {
            _altDebounce = null;
        }
        else if (ReferenceEquals(_captionDebounce, cts))
        {
            _captionDebounce = null;
        }
        else if (ReferenceEquals(_linkDebounce, cts))
        {
            _linkDebounce = null;
        }
        else if (ReferenceEquals(_sizeDebounce, cts))
        {
            _sizeDebounce = null;
        }
        else if (ReferenceEquals(_positionDebounce, cts))
        {
            _positionDebounce = null;
        }
    }

    private static void CancelDebounce(ref CancellationTokenSource? cts)
    {
        cts?.Cancel();
        cts = null;
    }

    public void Dispose()
    {
        CancelDebounce(ref _altDebounce);
        CancelDebounce(ref _captionDebounce);
        CancelDebounce(ref _linkDebounce);
        CancelDebounce(ref _sizeDebounce);
        CancelDebounce(ref _positionDebounce);
    }
}
