@namespace Tempo.Blazor.Components.DocumentEditor
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.DocumentEditor.Models

@* Redesign 146c7e1b, phase 6 (DE-2.5): the shared inspector header (one X, none while the docked side panel hosts the panel), a primary
   full-width "Create version", and a card-less timeline - the version, a "Current preview" badge on the previewed one, "kind . time .
   author" with the time through the shared relative-time formatter, the description and the Base / Compare pair (the active one is
   primary). The preview of a version is a strip in the doc region (TmDocumentVersionPreviewStrip); this panel renders that strip itself
   only when no host takes it over (ShowPreviewStrip). *@
<aside class="tm-document-editor__version-panel" aria-label="@Loc["TmDocumentEditor_VersionsLabel"]" data-testid="@TestId("document-version-panel")">
    <TmDocumentInspectorHeader Title="@Loc["TmDocumentEditor_Versions"]"
                               HeadingLevel="3"
                               CloseTestId="document-version-panel-close"
                               TestIdPrefix="@TestIdPrefix"
                               OnClose="@(ShowClose ? OnClose : default)" />

    <button type="button"
            class="tm-btn tm-btn-primary tm-document-version-panel__create"
            disabled="@ReadOnly"
            @onclick="OnCreateVersion"
            data-testid="@TestId("document-version-create-open")">
        <TmIcon Name="git-commit" Size="IconSize.Sm" />
        <span>@Loc["TmDocumentEditor_CreateVersion"]</span>
    </button>

    @* One polite live region that is always in the DOM (a region inserted together with its text is not announced reliably); the editor
       clears the message on the reader's next action. *@
    <div class="tm-document-version-panel__status"
         role="status"
         aria-live="polite"
         data-testid="@TestId("document-version-status")"
         hidden="@string.IsNullOrWhiteSpace(StatusMessage)">@StatusMessage</div>

    @if (ShowPreviewStrip && PreviewVersion is not null)
    {
        <TmDocumentVersionPreviewStrip PreviewVersion="PreviewVersion"
                                       TestIdPrefix="@TestIdPrefix"
                                       OnReturnToCurrent="OnReturnToCurrent"
                                       OnRestoreVersion="OnRestoreVersion" />
    }

    @if (IsLoading)
    {
        <div class="tm-document-version-panel__empty" data-testid="@TestId("document-version-loading")">@Loc["TmDocumentEditor_LoadingVersions"]</div>
    }
    else if (OrderedVersions.Count == 0)
    {
        <div class="tm-document-version-panel__empty" data-testid="@TestId("document-version-empty")">@Loc["TmDocumentEditor_NoVersions"]</div>
    }
    else
    {
        <ol class="tm-document-version-panel__list" data-testid="@TestId("document-version-list")">
            @foreach (var version in OrderedVersions)
            {
                var previewed = PreviewVersion?.Id == version.Id;
                <li @key="version.Id" class="tm-document-version-panel__entry@(previewed ? " tm-document-version-panel__item--preview" : null)">
                    <button type="button"
                            class="tm-document-version-panel__item @(previewed ? "tm-document-version-panel__item--active" : null)"
                            aria-current="@(previewed ? "true" : null)"
                            @onclick="() => SelectVersionAsync(version)"
                            data-testid="@TestId("document-version-item")">
                        <span class="tm-document-version-panel__item-icon" aria-hidden="true"><TmIcon Name="file-text" Size="IconSize.Md" /></span>
                        <span class="tm-document-version-panel__item-body">
                            <span class="tm-document-version-panel__item-head">
                                <span class="tm-document-version-panel__item-title">@GetVersionTitle(version)</span>
                                @if (previewed)
                                {
                                    <span class="tm-document-version-panel__badge">@Loc["TmDocumentEditor_VersionCurrentPreview"]</span>
                                }
                            </span>
                            <span class="tm-document-version-panel__item-meta">@RenderMeta(version)</span>
                            @if (!string.IsNullOrWhiteSpace(version.Description))
                            {
                                <span class="tm-document-version-panel__item-description">@version.Description</span>
                            }
                        </span>
                    </button>
                    <div class="tm-document-version-panel__diff-actions">
                        <button type="button"
                                class="@GetDiffButtonClass(version, true)"
                                aria-pressed="@AriaPressed(_diffBaseVersionId == version.Id)"
                                @onclick="() => SelectDiffBase(version)"
                                data-testid="@TestId("document-version-diff-base")">
                            @Loc["TmDocumentEditor_DiffBase"]
                        </button>
                        <button type="button"
                                class="@GetDiffButtonClass(version, false)"
                                aria-pressed="@AriaPressed(_diffCompareVersionId == version.Id)"
                                @onclick="() => SelectDiffCompare(version)"
                                data-testid="@TestId("document-version-diff-compare")">
                            @Loc["TmDocumentEditor_DiffCompare"]
                        </button>
                    </div>
                </li>
            }
        </ol>

        @if (DiffBaseVersion is not null && DiffCompareVersion is not null)
        {
            <TmDocumentDiffViewer OldDocument="@ReadSnapshot(DiffBaseVersion)"
                                  NewDocument="@ReadSnapshot(DiffCompareVersion)"
                                  OldTitle="@GetVersionTitle(DiffBaseVersion)"
                                  NewTitle="@GetVersionTitle(DiffCompareVersion)"
                                  SideBySide="true" />
        }
    }
</aside>

@code {
    [Inject] private IServiceProvider Services { get; set; } = default!;

    private ITmRelativeTimeFormatter? _relativeTime;
    private string? _diffBaseVersionId;
    private string? _diffCompareVersionId;

    /// <summary>Versions to render.</summary>
    [Parameter] public IReadOnlyList<DocumentVersion> Versions { get; set; } = [];

    /// <summary>Whether version list is loading.</summary>
    [Parameter] public bool IsLoading { get; set; }

    /// <summary>Whether create actions should be disabled.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Optional version status message.</summary>
    [Parameter] public string? StatusMessage { get; set; }

    /// <summary>Version currently previewed by the editor.</summary>
    [Parameter] public DocumentVersion? PreviewVersion { get; set; }

    /// <summary>Raised when the create-version dialog should open.</summary>
    [Parameter] public EventCallback OnCreateVersion { get; set; }

    /// <summary>Raised when a historical version should be previewed.</summary>
    [Parameter] public EventCallback<DocumentVersion> OnSelectVersion { get; set; }

    /// <summary>Raised when preview should return to the current document.</summary>
    [Parameter] public EventCallback OnReturnToCurrent { get; set; }

    /// <summary>Raised when the previewed version should be restored.</summary>
    [Parameter] public EventCallback<DocumentVersion> OnRestoreVersion { get; set; }

    /// <summary>
    /// Whether the panel renders the "You are viewing version X" strip itself. Defaults to <c>true</c> so a standalone panel keeps working;
    /// the editor passes <c>false</c> because it shows the strip in the document region, where it stays visible with the panel closed.
    /// </summary>
    [Parameter] public bool ShowPreviewStrip { get; set; } = true;

    /// <summary>Raised when the panel should close.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Whether the panel renders its own close button. Defaults to <c>true</c>; the editor passes <c>false</c> while the panel is
    /// hosted in the docked side panel, whose own close button already does the same thing (two X in one corner).
    /// </summary>
    [Parameter] public bool ShowClose { get; set; } = true;

    private IReadOnlyList<DocumentVersion> OrderedVersions => Versions
        .OrderByDescending(version => version.CreatedAt)
        .ToList();

    private DocumentVersion? DiffBaseVersion => Versions.FirstOrDefault(version => version.Id == _diffBaseVersionId);

    private DocumentVersion? DiffCompareVersion => Versions.FirstOrDefault(version => version.Id == _diffCompareVersionId);

    private Task SelectVersionAsync(DocumentVersion version)
        => OnSelectVersion.InvokeAsync(version);

    private void SelectDiffBase(DocumentVersion version)
    {
        _diffBaseVersionId = version.Id;
        if (_diffCompareVersionId == version.Id)
        {
            _diffCompareVersionId = null;
        }
    }

    private void SelectDiffCompare(DocumentVersion version)
    {
        _diffCompareVersionId = version.Id;
        if (_diffBaseVersionId == version.Id)
        {
            _diffBaseVersionId = null;
        }
    }

    private string GetDiffButtonClass(DocumentVersion version, bool baseButton)
    {
        var active = baseButton
            ? _diffBaseVersionId == version.Id
            : _diffCompareVersionId == version.Id;

        return active
            ? "tm-btn tm-btn-sm tm-btn-primary tm-document-version-panel__diff-button tm-document-version-panel__diff-button--active"
            : "tm-btn tm-btn-sm tm-btn-secondary tm-document-version-panel__diff-button";
    }

    private static DocumentEditorDocument? ReadSnapshot(DocumentVersion version)
    {
        return string.IsNullOrWhiteSpace(version.Snapshot.Json)
            ? null
            : DocumentEditorJson.Deserialize(version.Snapshot.Json);
    }

    private static string AriaPressed(bool value) => value ? "true" : "false";

    private string GetVersionTitle(DocumentVersion version)
        => DocumentVersionText.Title(Loc, version);

    // "Minor version . yesterday at 4:20 PM . Ada Author": the localized template "{0} . {1} . {2}" is walked once, the kind and the author
    // are text, the time is a <time> element whose tooltip is the absolute moment - the stamp is relative without hiding when it really was.
    private RenderFragment RenderMeta(DocumentVersion version) => builder =>
    {
        var author = string.IsNullOrWhiteSpace(version.Author.DisplayName)
            ? Loc["TmDocumentEditor_UnknownAuthor"].ToString()
            : version.Author.DisplayName;
        var formatter = _relativeTime ??= TmRelativeTime.Resolve(Services, Loc);
        var template = Loc["TmDocumentEditor_VersionMeta"].ToString();

        var sequence = 0;
        var position = 0;
        foreach (System.Text.RegularExpressions.Match match in System.Text.RegularExpressions.Regex.Matches(template, @"\{([012])\}"))
        {
            if (match.Index > position)
            {
                builder.AddContent(sequence++, template[position..match.Index]);
            }

            switch (match.Groups[1].Value)
            {
                case "0":
                    builder.AddContent(sequence++, DocumentVersionText.KindLabel(Loc, version.Kind));
                    break;
                case "1":
                    builder.OpenElement(sequence++, "time");
                    builder.AddAttribute(sequence++, "datetime", version.CreatedAt.UtcDateTime.ToString("O"));
                    builder.AddAttribute(sequence++, "title", formatter.Absolute(version.CreatedAt));
                    builder.AddContent(sequence++, formatter.Format(version.CreatedAt));
                    builder.CloseElement();
                    break;
                default:
                    builder.AddContent(sequence++, author);
                    break;
            }

            position = match.Index + match.Length;
        }

        if (position < template.Length)
        {
            builder.AddContent(sequence++, template[position..]);
        }
    };
}
