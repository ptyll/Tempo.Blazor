@namespace Tempo.Blazor.Components.DocumentEditor
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Components.Layout
@using Tempo.Blazor.Components.DocumentEditor.Registry
@using Tempo.Blazor.Interfaces

@* The editor's command palette is an ADAPTER over the core TmCommandPalette (redesign 146c7e1b, phase 5 review; decision
   DE-COMMAND-PALETTE-HOST): the editor's registry state (DocumentEditorCommandState) becomes ICommandPaletteAction items and the
   core component owns everything else - the top-layer promotion, the focus scope (trap, Escape, focus return), the combobox /
   listbox semantics (the search input is the one tab stop, aria-activedescendant names the option, a disabled command is
   aria-disabled with its reason as the description), the category groups, the shortcut keys and the mobile layout. What the editor
   adds is only a modifier class (tm-document-command-palette), the stable document-command-palette* test ids and the order of its
   categories (Debug last). *@
@if (IsOpen && VisibleCommands.Count > 0)
{
    <TmCommandPalette IsOpen="true"
                      IsOpenChanged="HandleOpenChangedAsync"
                      Actions="@_actions"
                      GroupByCategory="true"
                      SplitShortcuts="true"
                      ShowIcons="true"
                      Class="tm-document-command-palette"
                      ItemAttributes="ItemAttributesFor"
                      InputAttributes="@_inputAttributes"
                      CloseButtonAttributes="@_closeAttributes"
                      data-testid="@TestId("document-command-palette")">
        <EmptyTemplate>
            <span data-testid="@TestId("document-command-palette-empty")">@Loc["TmCommandPalette_NoResults"]</span>
        </EmptyTemplate>
    </TmCommandPalette>
}

@code {
    // The categories the registry uses, in the order the palette lists them; an unknown category sorts after them (by name), Debug is
    // always last. The label is localized through TmDocumentEditor_CommandCategory_{Category}; a category without a key shows as is.
    private static readonly string[] CategoryOrder =
    [
        "File", "Edit", "Formatting", "Paragraph", "Insert", "Image", "Table", "HeaderFooter", "References", "Review", "Signing", "View",
    ];

    private IReadOnlyList<ICommandPaletteAction> _actions = [];
    private IReadOnlyDictionary<string, object>? _inputAttributes;
    private IReadOnlyDictionary<string, object>? _closeAttributes;
    private IReadOnlyDictionary<string, DocumentEditorCommandState>? _builtFrom;

    /// <summary>Whether the command palette is visible.</summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>Raised when the command palette should close (Escape, the X, the backdrop, or a command that was run).</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Current command states.</summary>
    [Parameter] public IReadOnlyDictionary<string, DocumentEditorCommandState>? Commands { get; set; }

    /// <summary>Raised when a command is selected. A disabled command is never raised.</summary>
    [Parameter] public EventCallback<string> OnExecuteCommand { get; set; }

    // Commands that only do something with a value picked in their ribbon menu (a font, a colour, a spacing, an alignment, a case): the palette runs a
    // command without a payload, so such a row would do nothing. They stay registry commands (the ribbon and hosts use them), just not rows here.
    private static readonly HashSet<string> PayloadOnlyCommands = new(StringComparer.OrdinalIgnoreCase)
    {
        "fontFamily", "fontSize", "textColor", "highlightColor", "lineSpacing", "spacingBefore", "spacingAfter", "paragraphAlignment", "changeCase",
    };

    private IReadOnlyList<DocumentEditorCommandState> VisibleCommands =>
        (Commands?.Values ?? Array.Empty<DocumentEditorCommandState>())
        .Where(command => command.IsVisible && !PayloadOnlyCommands.Contains(command.Name))
        .ToArray();

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (!IsOpen)
        {
            _builtFrom = null;
            return;
        }

        // The items are rebuilt when the registry state is a different snapshot (or the palette just opened), never per keystroke: the
        // core palette owns the query and the highlight and keeps the highlighted action by id across a rebuild.
        if (_builtFrom is null || !ReferenceEquals(_builtFrom, Commands))
        {
            _actions = BuildActions();
            _builtFrom = Commands;
        }

        _inputAttributes ??= new Dictionary<string, object> { ["data-testid"] = TestId("document-command-palette-search") };
        _closeAttributes ??= new Dictionary<string, object> { ["data-testid"] = TestId("document-command-palette-close") };
    }

    private IReadOnlyList<ICommandPaletteAction> BuildActions()
        => VisibleCommands
            .OrderBy(command => CategoryRank(command.Category))
            .ThenBy(command => command.Category ?? string.Empty, StringComparer.Ordinal)
            .ThenBy(GetLabel, StringComparer.CurrentCultureIgnoreCase)
            .Select(command => (ICommandPaletteAction)new CommandPaletteAction(
                Id: command.Name,
                Title: GetLabel(command),
                Icon: HasKnownIcon(command) ? command.Icon : null,
                Shortcut: command.DefaultShortcut,
                Category: GetCategoryLabel(command.Category),
                Execute: () => OnExecuteCommand.InvokeAsync(command.Name),
                IsDisabled: !command.IsEnabled,
                DisabledReason: GetDisabledReason(command),
                SearchTerms: SearchTermsOf(command)))
            .ToArray();

    private IReadOnlyDictionary<string, object>? ItemAttributesFor(ICommandPaletteAction action)
        => new Dictionary<string, object>
        {
            ["data-command"] = action.Id,
            ["data-testid"] = TestId("document-command-palette-item"),
        };

    private Task HandleOpenChangedAsync(bool open) => open ? Task.CompletedTask : OnClose.InvokeAsync();

    private string GetLabel(DocumentEditorCommandState command) =>
        string.IsNullOrWhiteSpace(command.DescriptionKey)
            ? command.Name
            : Loc[command.DescriptionKey];

    private string? GetDisabledReason(DocumentEditorCommandState command) =>
        command.IsEnabled
            ? null
            : string.IsNullOrWhiteSpace(command.DisabledReasonKey)
                ? command.DisabledReason
                : Loc[command.DisabledReasonKey];

    private string? GetCategoryLabel(string? category)
    {
        if (string.IsNullOrWhiteSpace(category))
        {
            return null;
        }

        return Loc.TryGetString("TmDocumentEditor_CommandCategory_" + category, out var label) ? label : category;
    }

    // What the local filter matches besides the label: the command name and the category as the registry knows it, so "review" still
    // finds the review commands whatever language the label is shown in.
    private static IReadOnlyList<string> SearchTermsOf(DocumentEditorCommandState command)
        => string.IsNullOrWhiteSpace(command.Category) ? [command.Name] : [command.Name, command.Category];

    private static int CategoryRank(string? category)
    {
        if (string.Equals(category, "Debug", StringComparison.Ordinal))
        {
            return int.MaxValue;
        }

        var index = Array.IndexOf(CategoryOrder, category);
        return index >= 0 ? index : CategoryOrder.Length;
    }

    // An icon the glyph set does not know would paint the dashed "unknown" placeholder: the column stays, the placeholder does not.
    private static bool HasKnownIcon(DocumentEditorCommandState command)
        => !string.IsNullOrWhiteSpace(command.Icon) && !string.IsNullOrEmpty(TmIcon.GetBuiltInSvg(command.Icon));
}
