@namespace Tempo.Blazor.Components.Wireframe
@using System.Globalization

@* ── TmWireframeRuler ───────────────────────────────────────────────────────
   SVG-based ruler with tick marks and numbers. Shared viewBox with the canvas
   so pan and zoom are respected automatically.
   ─────────────────────────────────────────────────────────────────────────── *@

<svg class="tm-wd-ruler tm-wd-ruler--@(_isHorizontal ? "horizontal" : "vertical") @Class"
     viewBox="@_viewBox"
     preserveAspectRatio="none"
     aria-label="@(_isHorizontal ? Loc["TmWireframe_HorizontalRuler"] : Loc["TmWireframe_VerticalRuler"])">

    @* Background *@
    <rect x="@_bgX" y="@_bgY" width="@_bgW" height="@_bgH" fill="var(--tm-wd-ruler-bg)" />

    @* Tick marks and labels *@
    @foreach (var tick in _ticks)
    {
        @if (_isHorizontal)
        {
            <line x1="@F(tick.Pos)" y1="0" x2="@F(tick.Pos)" y2="@F(tick.Len)"
                  stroke="var(--tm-wd-ruler-tick)" stroke-width="1" />
            @if (tick.ShowLabel)
            {
                @((MarkupString)$"""<text x="{F(tick.Pos + 2)}" y="14" font-size="9" font-family="var(--tm-wd-font)" fill="var(--tm-wd-ruler-text)">{tick.Label}</text>""")
            }
        }
        else
        {
            <line x1="0" y1="@F(tick.Pos)" x2="@F(tick.Len)" y2="@F(tick.Pos)"
                  stroke="var(--tm-wd-ruler-tick)" stroke-width="1" />
            @if (tick.ShowLabel)
            {
                @((MarkupString)$"""<text x="14" y="{F(tick.Pos - 2)}" font-size="9" font-family="var(--tm-wd-font)" fill="var(--tm-wd-ruler-text)" text-anchor="end" transform="rotate(-90, 14, {F(tick.Pos - 2)})">{tick.Label}</text>""")
            }
        }
    }

    @* Cursor indicator *@
    @if (IndicatorPos.HasValue)
    {
        @if (_isHorizontal)
        {
            <line x1="@F(IndicatorPos.Value)" y1="0"
                  x2="@F(IndicatorPos.Value)" y2="@Size"
                  stroke="var(--tm-wd-ruler-cursor)" stroke-width="1.5" />
        }
        else
        {
            <line x1="0" y1="@F(IndicatorPos.Value)"
                  x2="@Size" y2="@F(IndicatorPos.Value)"
                  stroke="var(--tm-wd-ruler-cursor)" stroke-width="1.5" />
        }
    }
</svg>
