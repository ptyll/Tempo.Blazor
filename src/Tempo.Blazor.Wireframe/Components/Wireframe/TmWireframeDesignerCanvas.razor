@namespace Tempo.Blazor.Components.Wireframe
@using System.Globalization
@using Microsoft.AspNetCore.Components.Rendering
@using Tempo.Blazor.Components.Wireframe.Models

<div class="tm-wd-canvas-wrap @Class" tabindex="0" @ref="_wrapRef">
    <svg @ref="_svgRef"
         id="@_svgId"
         class="tm-wd-canvas__svg"
         viewBox="@_viewBox"
         xmlns="http://www.w3.org/2000/svg"
         style="width:100%;height:100%;display:block;overflow:hidden;"
         aria-label="@Loc["TmWireframeCanvas_AriaLabel"]">

        <defs>
            @if (ShowGrid)
            {
                <pattern id="@_gridSmallId" width="@_gs" height="@_gs"
                         patternUnits="userSpaceOnUse">
                    <path d="M @_gs 0 L 0 0 0 @_gs"
                          fill="none" stroke-width="0.5" stroke-opacity="0.55"
                          style="stroke: var(--tm-wd-grid-minor)" data-wd-paint="stroke"/>
                </pattern>
                <pattern id="@_gridLargeId" width="@_gl" height="@_gl"
                         patternUnits="userSpaceOnUse">
                    <rect width="@_gl" height="@_gl"
                          fill="url(#@_gridSmallId)"/>
                    <path d="M @_gl 0 L 0 0 0 @_gl"
                          fill="none" stroke-width="1"
                          style="stroke: var(--tm-wd-grid-major)" data-wd-paint="stroke"/>
                </pattern>
            }
            @* Connector arrowhead markers *@
            @if (Document is not null)
            {
                @foreach (var c in Document.Connectors)
                {
                    @((RenderTreeBuilder __am) =>
                    {
                        var markers = WireframeConnectorRenderer.BuildArrowMarkers(c);
                        if (!string.IsNullOrEmpty(markers))
                            __am.AddMarkupContent(0, markers);
                    })
                }
            }
        </defs>

        @* Canvas background + grid *@
        <rect x="0" y="0" class="tm-wd-canvas__page"
              width="@(Document?.Width ?? 1200)" height="@(Document?.Height ?? 800)"
              stroke-width="1" rx="4"
              style="fill: var(--tm-wd-canvas-bg); stroke: var(--tm-wd-canvas-border)"
              data-wd-paint="fill stroke"/>
        @if (ShowGrid)
        {
            <rect x="0" y="0"
                  width="@(Document?.Width ?? 1200)" height="@(Document?.Height ?? 800)"
                  fill="url(#@_gridLargeId)"
                  pointer-events="none"/>
        }

        @* Connectors *@
        @if (Document is not null)
        {
            @foreach (var c in Document.Connectors.OrderBy(c => c.ZIndex))
            {
                var source = Document.Elements.FirstOrDefault(e => e.Id == c.FromId);
                var target = Document.Elements.FirstOrDefault(e => e.Id == c.ToId);
                if (source is null || target is null) continue;

                var pathD = WireframeConnectorRenderer.BuildPath(c, source, target);
                var labelPos = WireframeConnectorRenderer.GetLabelPosition(c, source, target);
                var startMarker = WireframeConnectorRenderer.GetArrowMarkerRef(c.StartArrow, true, c.Id);
                var endMarker = WireframeConnectorRenderer.GetArrowMarkerRef(c.EndArrow, false, c.Id);
                var isSelected = _currentConnectorSelectionIds.Contains(c.Id);
                var stroke = c.Stroke;
                var strokeWidth = c.StrokeWidth.ToString("0.##", CultureInfo.InvariantCulture);
                var dash = c.StrokeDasharray;
                var lx = labelPos.X.ToString("0.##", CultureInfo.InvariantCulture);
                var ly = labelPos.Y.ToString("0.##", CultureInfo.InvariantCulture);

                <g data-connector-id="@c.Id"
                   class="tm-wd-connector @(isSelected ? "tm-wd-connector--selected" : "")">

                    @* Hit-test path (wider, invisible) *@
                    <path d="@pathD"
                          fill="none"
                          stroke="transparent"
                          stroke-width="12"
                          class="tm-wd-connector__hit"
                          pointer-events="stroke" />

                    @* Visible path *@
                    <path d="@pathD"
                          fill="none"
                          stroke="@stroke"
                          stroke-width="@strokeWidth"
                          stroke-dasharray="@dash"
                          marker-start="@startMarker"
                          marker-end="@endMarker"
                          class="tm-wd-connector__path"
                          pointer-events="none" />

                    @* Label (rendered as MarkupString to avoid Razor <text> conflict) *@
                    @if (!string.IsNullOrEmpty(c.Label))
                    {
                        @((MarkupString)$"""<text x="{lx}" y="{ly}" text-anchor="middle" dominant-baseline="middle" font-size="12" font-family="ui-sans-serif,system-ui" style="fill: var(--tm-wd-paper-ink)" data-wd-paint="fill" class="tm-wd-connector__label" pointer-events="none">{WireframeSvg.Escape(c.Label)}</text>""")
                    }

                    @* Waypoint handles (visible when connector is selected) *@
                    @if (isSelected)
                    {
                        @for (int i = 0; i < c.Waypoints.Count; i++)
                        {
                            var wp = c.Waypoints[i];
                            var wpx = wp.X.ToString("0.##", CultureInfo.InvariantCulture);
                            var wpy = wp.Y.ToString("0.##", CultureInfo.InvariantCulture);
                            @* Finger-sized invisible hit circle (active on a coarse pointer only: CSS owns pointer-events and the radius) *@
                            <circle cx="@wpx" cy="@wpy" r="12"
                                    fill="transparent"
                                    class="tm-wd-connector__waypoint-hit"
                                    data-waypoint-index="@i" />
                            <circle cx="@wpx" cy="@wpy" r="4"
                                    stroke-width="1.5"
                                    class="tm-wd-connector__waypoint"
                                    data-waypoint-index="@i"
                                    pointer-events="all"
                                    data-wd-paint="fill stroke"
                                    style="fill: var(--tm-wd-handle-fill); stroke: var(--tm-wd-accent); cursor:move" />
                        }
                    }
                </g>
            }
        }

        @* Elements *@
        @if (Document is not null)
        {
            @foreach (var el in Document.Elements.OrderBy(e => e.ZIndex))
            {
                if (!IsLayerVisible(el.LayerId)) continue;

                var def    = _registry.GetDef(el.Type, ComponentScope);
                var transX = el.X.ToString("0.##", CultureInfo.InvariantCulture);
                var transY = el.Y.ToString("0.##", CultureInfo.InvariantCulture);
                var w      = el.W.ToString("0.##", CultureInfo.InvariantCulture);
                var h      = el.H.ToString("0.##", CultureInfo.InvariantCulture);

                var rot = el.Rotation.ToString("0.##", CultureInfo.InvariantCulture);
                var isLocked = el.IsLocked || !string.IsNullOrEmpty(el.LockedBy) || IsLayerLocked(el.LayerId);

                <g data-el-id="@el.Id"
                   data-type="@el.Type"
                   data-w="@w"
                   data-h="@h"
                   data-rotation="@rot"
                   data-locked="@(isLocked ? "true" : "false")"
                   data-group-id="@el.GroupId"
                   data-layer-id="@el.LayerId"
                   aria-label="@(string.IsNullOrWhiteSpace(el.Name) ? null : el.Name)"
                   class="@(isLocked ? "tm-wd-locked" : "")"
                   transform="translate(@transX, @transY) rotate(@rot, @((el.W / 2).ToString("0.##", CultureInfo.InvariantCulture)), @((el.H / 2).ToString("0.##", CultureInfo.InvariantCulture)))"
                   style="@(ReadOnly || isLocked ? "cursor:default" : "cursor:move")">

                    @if (!string.IsNullOrWhiteSpace(el.Name))
                    {
                        @* Element name = SVG tooltip (accessible name is the aria-label above) *@
                        <title>@el.Name</title>
                    }

                    @* Inner SVG viewport so element coords stay local (0,0) *@
                    <svg width="@w" height="@h"
                         viewBox="0 0 @w @h"
                         overflow="visible">
                        @if (def is not null)
                        {
                            @((RenderTreeBuilder __b) => def.RenderSvg(el, __b))
                        }
                        else
                        {
                            @* Fallback: unknown component placeholder – emitted as markup to avoid Razor <text> conflict *@
                            @((Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder __fb) =>
                            {
                                __fb.AddMarkupContent(0,
                                    $"<rect width='{w}' height='{h}' rx='4' stroke-width='1' stroke-dasharray='6 3' style='fill: var(--tm-wd-placeholder-fill); stroke: var(--tm-wd-placeholder-stroke)' data-wd-paint='fill stroke'></rect>" +
                                    $"<text x='4' y='14' font-size='10' style='fill: var(--tm-wd-placeholder-ink)' data-wd-paint='fill' font-family='ui-sans-serif,system-ui'>{WireframeSvg.Escape(Loc["TmWireframeCanvas_UnknownComponent", el.Type])}</text>");
                            })
                        }
                    </svg>
                </g>
            }
        }

    </svg>
</div>
