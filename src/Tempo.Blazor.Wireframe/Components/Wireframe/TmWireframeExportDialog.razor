@namespace Tempo.Blazor.Components.Wireframe
@using Tempo.Blazor.Abstractions.Wireframe.Export
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Inputs

<TmModal Show="@Show"
         OnClose="OnClose"
         Title="@Loc["TmWireframeExportDialog_Title"]"
         ShowDefaultFooterButtons="false"
         MobilePresentation="MobilePresentation"
         FooterLayout="FooterLayout.Inline"
         Size="ModalSize.Medium"
         CloseOnOverlayClick="true"
         CloseOnEscape="true">
    <ChildContent>
        <div class="tm-wd-export-dialog">
            @* File name *@
            <div class="tm-wd-export-dialog__field">
                <label class="tm-wd-export-dialog__label" for="wd-export-filename">
                    @Loc["TmWireframeExportDialog_FileName"]
                </label>
                <TmTextInput Id="wd-export-filename"
                             @bind-Value="_fileName"
                             Placeholder="@Loc["TmWireframeExportDialog_FileNamePlaceholder"]" />
            </div>

            @* Format *@
            <div class="tm-wd-export-dialog__field">
                <label class="tm-wd-export-dialog__label" for="wd-export-format">
                    @Loc["TmWireframeExportDialog_Format"]
                </label>
                <TmSelect Id="wd-export-format"
                          @bind-Value="_format"
                          Options="_formatOptions" />
            </div>

            @* Scale (PNG only) *@
            @if (_format == "png")
            {
                <div class="tm-wd-export-dialog__field">
                    <label class="tm-wd-export-dialog__label" for="wd-export-scale">
                        @Loc["TmWireframeExportDialog_Scale"]
                    </label>
                    <TmSelect Id="wd-export-scale"
                              @bind-Value="_scale"
                              Options="_scaleOptions" />
                </div>
            }

            @* Background *@
            <div class="tm-wd-export-dialog__field tm-wd-export-dialog__field--inline">
                <TmCheckbox Id="wd-export-bg"
                            @bind-Value="_includeBackground"
                            Label="@Loc["TmWireframeExportDialog_IncludeBackground"]" />
            </div>
        </div>
    </ChildContent>
    <Footer>
        <TmButton Variant="ButtonVariant.Secondary" OnClick="OnClose">
            @Loc["Tm_Cancel"]
        </TmButton>
        <TmButton Variant="ButtonVariant.Primary" OnClick="OnExportClick">
            @Loc["TmWireframeExportDialog_ExportButton"]
        </TmButton>
    </Footer>
</TmModal>

@code {
    /// <summary>Whether the dialog is visible. Every closed→open transition resets the form (file name, format, scale, background).</summary>
    [Parameter] public bool Show { get; set; }

    /// <summary>Raised when the user cancels, presses Escape or clicks the overlay. The host should set <see cref="Show"/> to <c>false</c>.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Raised with the chosen file name, format and options when the user confirms the export.</summary>
    [Parameter] public EventCallback<WireframeExportDialogResult> OnExport { get; set; }

    /// <summary>
    /// How the dialog presents on a narrow viewport. <see cref="MobilePresentation.Auto"/> (default) follows the core viewport scope: a bottom sheet
    /// on a phone, the centred dialog otherwise. A forced value pins one presentation (used by tests and host layouts). The footer is always
    /// inline (Cancel and Export side by side, sticky in the sheet).
    /// </summary>
    [Parameter] public MobilePresentation MobilePresentation { get; set; } = MobilePresentation.Auto;

    /// <summary>File name proposed (and restored) every time the dialog opens. Falls back to an empty field when <c>null</c>.</summary>
    [Parameter] public string? DefaultFileName { get; set; }

    /// <summary>
    /// Format preselected every time the dialog opens: <c>"png"</c> (default) or <c>"pdf"</c> (case-insensitive).
    /// Any other value falls back to PNG.
    /// </summary>
    [Parameter] public string? InitialFormat { get; set; }

    private string _fileName = "";
    private string _format = "png";
    private string _scale = "1";
    private bool _includeBackground = true;
    private bool _wasShown;

    private readonly List<SelectOption<string>> _formatOptions = new()
    {
        new() { Value = "png", Label = "PNG" },
        new() { Value = "pdf", Label = "PDF" }
    };

    private readonly List<SelectOption<string>> _scaleOptions = new()
    {
        new() { Value = "1", Label = "1×" },
        new() { Value = "2", Label = "2×" },
        new() { Value = "3", Label = "3×" }
    };

    protected override void OnParametersSet()
    {
        if (Show && !_wasShown)
        {
            // Closed → open: restore every field so a previous session's typing/selection never leaks in.
            _fileName = DefaultFileName ?? "";
            _format = NormalizeFormat(InitialFormat);
            _scale = "1";
            _includeBackground = true;
        }

        _wasShown = Show;
    }

    private static string NormalizeFormat(string? format)
        => string.Equals(format, "pdf", StringComparison.OrdinalIgnoreCase) ? "pdf" : "png";

    private async Task OnExportClick()
    {
        var result = new WireframeExportDialogResult
        {
            FileName = string.IsNullOrWhiteSpace(_fileName) ? "wireframe" : _fileName.Trim(),
            Format = _format,
            Options = new WireframeExportOptions
            {
                IncludeBackground = _includeBackground,
                Scale = int.TryParse(_scale, out var s) ? s : 1
            }
        };
        await OnExport.InvokeAsync(result);
    }
}
