@namespace Tempo.Blazor.Components.Wireframe
@using System.Globalization
@using System.Text.Json
@using Tempo.Blazor.Components.Wireframe.Models

<div class="tm-wd-props @Class">

    @* ── Nothing selected ─────────────────────────────────────────────────── *@
    @if (!_elements.Any() && !_connectors.Any())
    {
        var page = Document?.ActivePage;
        var canvasDisabled = ReadOnly || page is null;
        var presetId = SelectedPresetId;

        @* ── Canvas: device preset + width / height ───────────────────────── *@
        <details class="tm-wd-props__section" open data-testid="wd-section-canvas">
            <summary class="tm-wd-props__section-header">@Loc["TmWireframeProps_SectionCanvas"]</summary>
            <div class="tm-wd-props__section-body">
                <div class="tm-wd-props__field">
                    <label class="tm-wd-props__label" for="@_presetId">@Loc["TmWireframeProps_DevicePreset"]</label>
                    <select id="@_presetId" class="tm-wd-props__select" data-testid="wd-device-preset"
                            aria-label="@Loc["TmWireframeProps_DevicePreset"]"
                            disabled="@canvasDisabled"
                            @onchange="OnDevicePresetChanged">
                        @foreach (var preset in WireframeDevicePresets.All)
                        {
                            <option value="@preset.Id" selected="@(preset.Id == presetId)">@GetPresetLabel(preset)</option>
                        }
                    </select>
                </div>
                <div class="tm-wd-props__row">
                    <div class="tm-wd-props__field">
                        <label class="tm-wd-props__label" for="@_canvasWId">@Loc["TmWireframe_CanvasWidth"]</label>
                        <input id="@_canvasWId" class="tm-wd-props__input" type="number" min="100" max="9999" step="1"
                               data-testid="wd-canvas-width"
                               value="@_canvasWInput" disabled="@canvasDisabled"
                               @oninput="e => _canvasWInput = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    <div class="tm-wd-props__field">
                        <label class="tm-wd-props__label" for="@_canvasHId">@Loc["TmWireframe_CanvasHeight"]</label>
                        <input id="@_canvasHId" class="tm-wd-props__input" type="number" min="100" max="9999" step="1"
                               data-testid="wd-canvas-height"
                               value="@_canvasHInput" disabled="@canvasDisabled"
                               @oninput="e => _canvasHInput = e.Value?.ToString() ?? string.Empty" />
                    </div>
                </div>
                <div class="tm-wd-props__row">
                    <button type="button" class="tm-wd-editor__btn tm-wd-editor__btn--text"
                            data-testid="wd-canvas-apply"
                            disabled="@canvasDisabled"
                            @onclick="OnApplyCanvasSize">@Loc["TmWireframe_Apply"]</button>
                </div>
            </div>
        </details>

        @* ── Page: name of the active page ────────────────────────────────── *@
        <details class="tm-wd-props__section" open data-testid="wd-section-page">
            <summary class="tm-wd-props__section-header">@Loc["TmWireframeProps_SectionPage"]</summary>
            <div class="tm-wd-props__section-body">
                <div class="tm-wd-props__field">
                    <label class="tm-wd-props__label" for="@_pageNameId">@Loc["TmWireframeProps_PageName"]</label>
                    <input id="@_pageNameId" class="tm-wd-props__input" type="text"
                           data-testid="wd-page-name"
                           value="@(page?.Name ?? "")" disabled="@canvasDisabled"
                           @onchange="OnPageNameChanged" />
                </div>
            </div>
        </details>

        @* ── Grid: visibility + snapping size ─────────────────────────────── *@
        <details class="tm-wd-props__section" open data-testid="wd-section-grid">
            <summary class="tm-wd-props__section-header">@Loc["TmWireframeProps_SectionGrid"]</summary>
            <div class="tm-wd-props__section-body">
                <div class="tm-wd-props__field">
                    <label class="tm-wd-props__toggle">
                        <input type="checkbox" data-testid="wd-grid-show"
                               checked="@_showGrid"
                               @onchange="OnShowGridChanged" />
                        <span class="tm-wd-props__toggle-track"></span>
                        <span class="tm-wd-props__toggle-label">@Loc["TmWireframeProps_ShowGrid"]</span>
                    </label>
                </div>
                <div class="tm-wd-props__field">
                    <label class="tm-wd-props__label" for="@_gridSizeId">@Loc["TmWireframeProps_GridSize"]</label>
                    <input id="@_gridSizeId" class="tm-wd-props__input" type="number" min="0" max="128" step="1"
                           data-testid="wd-grid-size"
                           value="@_gridSize.ToString(CultureInfo.InvariantCulture)"
                           @onchange="OnGridSizeChanged" />
                </div>
            </div>
        </details>

        @* ── Selection hint ───────────────────────────────────────────────── *@
        <details class="tm-wd-props__section" open data-testid="wd-section-selection">
            <summary class="tm-wd-props__section-header">@Loc["TmWireframeProps_SectionSelection"]</summary>
            <div class="tm-wd-props__section-body">
                <div class="tm-wd-props__empty">
                    <span class="tm-wd-props__empty-icon" aria-hidden="true"><TmIcon Name="@IconNames.Square" Size="IconSize.Xl" /></span>
                    <span>@Loc["TmWireframeProps_NoSelectionHint"]</span>
                </div>
            </div>
        </details>
    }
    else if (_connectors.Any())
    {
    @* ── Connector Header ─────────────────────────────────────────────────── *@
    <div class="tm-wd-props__header">
        <span class="tm-wd-props__type-badge">Connector</span>
        <span class="tm-wd-props__subtitle">@(_connectors.Count == 1 ? _connectors[0].Id : $"{_connectors.Count} connectors")</span>
    </div>

    @* ── Connector Section ────────────────────────────────────────────────── *@
    <details class="tm-wd-props__section" open>
        <summary class="tm-wd-props__section-header">@Loc["TmWireframeProps_SectionConnector"]</summary>
        <div class="tm-wd-props__section-body">
            @if (_connectors.Count == 1)
            {
                var c = _connectors[0];
                <div class="tm-wd-props__field">
                    <label class="tm-wd-props__label">@Loc["TmWireframeProps_Routing"]</label>
                    <select class="tm-wd-props__select" value="@c.Routing" @onchange="e => OnConnectorRoutingChanged(c.Id, e)">
                        <option value="straight">Straight</option>
                        <option value="orthogonal">Orthogonal</option>
                        <option value="curved">Curved</option>
                    </select>
                </div>
                <div class="tm-wd-props__field">
                    <label class="tm-wd-props__label">@Loc["TmWireframeProps_StartArrow"]</label>
                    <select class="tm-wd-props__select" value="@c.StartArrow" @onchange="e => OnConnectorArrowChanged(c.Id, true, e)">
                        <option value="none">None</option>
                        <option value="classic">Classic</option>
                        <option value="block">Block</option>
                        <option value="open">Open</option>
                        <option value="oval">Oval</option>
                        <option value="diamond">Diamond</option>
                    </select>
                </div>
                <div class="tm-wd-props__field">
                    <label class="tm-wd-props__label">@Loc["TmWireframeProps_EndArrow"]</label>
                    <select class="tm-wd-props__select" value="@c.EndArrow" @onchange="e => OnConnectorArrowChanged(c.Id, false, e)">
                        <option value="none">None</option>
                        <option value="classic">Classic</option>
                        <option value="block">Block</option>
                        <option value="open">Open</option>
                        <option value="oval">Oval</option>
                        <option value="diamond">Diamond</option>
                    </select>
                </div>
                <div class="tm-wd-props__field">
                    <label class="tm-wd-props__label">@Loc["TmWireframeProps_Stroke"]</label>
                    <div class="tm-wd-props__color-row">
                        <input type="color" class="tm-wd-props__color-swatch" value="@c.Stroke" @onchange="e => OnConnectorStrokeChanged(c.Id, e)" />
                        <input type="text" class="tm-wd-props__input" value="@c.Stroke" @oninput="e => OnConnectorStrokeChanged(c.Id, e)" />
                    </div>
                </div>
                <div class="tm-wd-props__field">
                    <label class="tm-wd-props__label">@Loc["TmWireframeProps_StrokeWidth"]</label>
                    <input class="tm-wd-props__input" type="number" step="0.5" min="0.5" max="20" value="@c.StrokeWidth.ToString("0.#", CultureInfo.InvariantCulture)" @oninput="e => OnConnectorStrokeWidthChanged(c.Id, e)" />
                </div>
                <div class="tm-wd-props__field">
                    <label class="tm-wd-props__label">@Loc["TmWireframeProps_Label"]</label>
                    <input class="tm-wd-props__input" type="text" value="@c.Label" @oninput="e => OnConnectorLabelChanged(c.Id, e)" />
                </div>
            }
            else
            {
                <div class="tm-wd-props__field">
                    <span class="tm-wd-props__label">@Loc["TmWireframeProps_MultiConnectorHint"]</span>
                </div>
            }
        </div>
    </details>
    }
    else
    {

    @* ── Header ───────────────────────────────────────────────────────────── *@
    <div class="tm-wd-props__header">
        @if (_isMulti)
        {
            <span class="tm-wd-props__type-badge">@Loc.Plural("TmWireframeProps_ElementsCount", _elements.Count)</span>
            <span class="tm-wd-props__subtitle">
                @(_sameType ? _elements[0].Type : Loc["TmWireframeProps_MixedTypes"])
            </span>
        }
        else
        {
            <span class="tm-wd-props__type-badge">@_elements[0].Type</span>
            <span class="tm-wd-props__subtitle">@(_def?.DisplayName ?? _elements[0].Type)</span>
        }
    </div>

    @* ── Element section (Type read-only, ZIndex) ─────────────────────────── *@
    <details class="tm-wd-props__section" open>
        <summary class="tm-wd-props__section-header">@Loc["TmWireframeProps_SectionElement"]</summary>
        <div class="tm-wd-props__section-body">
            @if (!_isMulti)
            {
                <div class="tm-wd-props__field">
                    <label class="tm-wd-props__label" for="@_elementNameId">@Loc["TmWireframeProps_ElementName"]</label>
                    <input id="@_elementNameId" class="tm-wd-props__input" type="text"
                           data-testid="wd-element-name"
                           value="@(_elements[0].Name ?? "")"
                           placeholder="@Loc["TmWireframeProps_ElementNamePlaceholder"]"
                           disabled="@ReadOnly"
                           @onchange="OnElementNameChanged" />
                </div>
                <div class="tm-wd-props__field">
                    <label class="tm-wd-props__label">@Loc["TmWireframeProps_Type"]</label>
                    <input class="tm-wd-props__input tm-wd-props__input--readonly"
                           value="@_elements[0].Type" readonly />
                </div>
                <div class="tm-wd-props__field">
                    <label class="tm-wd-props__label">@Loc["TmWireframeProps_ZIndex"]</label>
                    <div class="tm-wd-props__row">
                        <input class="tm-wd-props__input tm-wd-props__input--grow"
                               type="number" step="1"
                               value="@_elements[0].ZIndex"
                               @oninput="@(e => OnZIndexChanged(e))" />
                        <button class="tm-wd-editor__btn tm-wd-editor__btn--icon"
                                title="@Loc["TmWireframeProps_SendToBack"]"
                                aria-label="@Loc["TmWireframeProps_SendToBack"]"
                                @onclick="OnSendToBack"><TmIcon Name="@IconNames.SendToBack" /></button>
                        <button class="tm-wd-editor__btn tm-wd-editor__btn--icon"
                                title="@Loc["TmWireframeProps_BringToFront"]"
                                aria-label="@Loc["TmWireframeProps_BringToFront"]"
                                @onclick="OnBringToFront"><TmIcon Name="@IconNames.BringToFront" /></button>
                    </div>
                </div>
                <div class="tm-wd-props__field">
                    <label class="tm-wd-props__label">@Loc["TmWireframeProps_Rotation"]</label>
                    <input class="tm-wd-props__input"
                           type="number" step="1"
                           value="@_elements[0].Rotation.ToString("0.##", CultureInfo.InvariantCulture)"
                           @oninput="@(e => OnRotationChanged(e))" />
                </div>
                <div class="tm-wd-props__field">
                    <label class="tm-wd-props__toggle">
                        <input type="checkbox"
                               checked="@_elements[0].IsLocked"
                               @onchange="@(e => OnLockChanged(e))" />
                        <span class="tm-wd-props__toggle-track"></span>
                        <span class="tm-wd-props__toggle-label">@Loc["TmWireframeProps_Locked"]</span>
                    </label>
                </div>
                @if (!string.IsNullOrEmpty(_elements[0].GroupId))
                {
                    <div class="tm-wd-props__field">
                        <label class="tm-wd-props__label">@Loc["TmWireframeProps_Group"]</label>
                        <input class="tm-wd-props__input tm-wd-props__input--readonly"
                               value="@GetGroupLabel(_elements[0].GroupId!)"
                               readonly />
                    </div>
                }
                <div class="tm-wd-props__field">
                    <label class="tm-wd-props__label">@Loc["TmWireframeProps_Layer"]</label>
                    <select class="tm-wd-props__select"
                            value="@(_elements[0].LayerId ?? "")"
                            @onchange="e => OnLayerChanged(e)">
                        @foreach (var layer in Document?.Layers.OrderBy(l => l.Order).ToList() ?? new List<WireframeLayer>())
                        {
                            <option value="@layer.Id">@layer.Name</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <div class="tm-wd-props__field">
                    <label class="tm-wd-props__label">@Loc["TmWireframeProps_Types"]</label>
                    <input class="tm-wd-props__input tm-wd-props__input--readonly"
                           value="@string.Join(", ", _elements.Select(e => e.Type).Distinct())"
                           readonly />
                </div>
            }
            <div class="tm-wd-props__field">
                <button type="button" class="tm-wd-props__delete" data-testid="wd-delete-element"
                        disabled="@ReadOnly"
                        @onclick="OnDeleteClicked">
                    <TmIcon Name="@IconNames.Trash" Size="IconSize.Sm" />
                    <span>@Loc["TmWireframeProps_DeleteElement"]</span>
                </button>
            </div>
        </div>
    </details>

    @* ── Arrange section (Align / Distribute) ─────────────────────────────── *@
    @if (_elements.Count >= 2)
    {
        <details class="tm-wd-props__section" open>
            <summary class="tm-wd-props__section-header">@Loc["TmWireframeProps_Arrange"]</summary>
            <div class="tm-wd-props__section-body">
                <div class="tm-wd-props__field">
                    <label class="tm-wd-props__label">@Loc["TmWireframe_Align"]</label>
                    <div class="tm-wd-props__row tm-wd-props__row--wrap">
                        <button class="tm-wd-editor__btn tm-wd-editor__btn--icon" title="@Loc["TmWireframe_AlignLeft"]" aria-label="@Loc["TmWireframe_AlignLeft"]" @onclick="() => OnAlign(WireframeAlignment.Left)"><TmIcon Name="@IconNames.AlignLeft" /></button>
                        <button class="tm-wd-editor__btn tm-wd-editor__btn--icon" title="@Loc["TmWireframe_AlignCenterH"]" aria-label="@Loc["TmWireframe_AlignCenterH"]" @onclick="() => OnAlign(WireframeAlignment.CenterH)"><TmIcon Name="@IconNames.AlignCenter" /></button>
                        <button class="tm-wd-editor__btn tm-wd-editor__btn--icon" title="@Loc["TmWireframe_AlignRight"]" aria-label="@Loc["TmWireframe_AlignRight"]" @onclick="() => OnAlign(WireframeAlignment.Right)"><TmIcon Name="@IconNames.AlignRight" /></button>
                        <button class="tm-wd-editor__btn tm-wd-editor__btn--icon" title="@Loc["TmWireframe_AlignTop"]" aria-label="@Loc["TmWireframe_AlignTop"]" @onclick="() => OnAlign(WireframeAlignment.Top)"><TmIcon Name="@IconNames.ArrowUpFromLine" /></button>
                        <button class="tm-wd-editor__btn tm-wd-editor__btn--icon" title="@Loc["TmWireframe_AlignCenterV"]" aria-label="@Loc["TmWireframe_AlignCenterV"]" @onclick="() => OnAlign(WireframeAlignment.CenterV)"><TmIcon Name="@IconNames.AlignVerticalDistributeCenter" /></button>
                        <button class="tm-wd-editor__btn tm-wd-editor__btn--icon" title="@Loc["TmWireframe_AlignBottom"]" aria-label="@Loc["TmWireframe_AlignBottom"]" @onclick="() => OnAlign(WireframeAlignment.Bottom)"><TmIcon Name="@IconNames.ArrowDownToLine" /></button>
                    </div>
                </div>
                @if (_elements.Count >= 3)
                {
                    <div class="tm-wd-props__field">
                        <label class="tm-wd-props__label">@Loc["TmWireframe_Distribute"]</label>
                        <div class="tm-wd-props__row">
                            <button class="tm-wd-editor__btn tm-wd-editor__btn--text" title="@Loc["TmWireframe_DistributeHorizontal"]" @onclick="() => OnDistribute(WireframeDistribution.Horizontal)">@Loc["TmWireframe_DistributeHorizontal"]</button>
                            <button class="tm-wd-editor__btn tm-wd-editor__btn--text" title="@Loc["TmWireframe_DistributeVertical"]" @onclick="() => OnDistribute(WireframeDistribution.Vertical)">@Loc["TmWireframe_DistributeVertical"]</button>
                        </div>
                    </div>
                }
            </div>
        </details>
    }

    @* ── Format Painter section ───────────────────────────────────────────── *@
    @if (_elements.Count >= 1)
    {
        <details class="tm-wd-props__section" open>
            <summary class="tm-wd-props__section-header">@Loc["TmWireframeProps_FormatPainter"]</summary>
            <div class="tm-wd-props__section-body">
                <div class="tm-wd-props__field">
                    <div class="tm-wd-props__row tm-wd-props__row--wrap">
                        <button class="tm-wd-editor__btn tm-wd-editor__btn--text"
                                title="@Loc["TmWireframe_CopyStyle"]"
                                disabled="@(_elements.Count != 1 || ReadOnly)"
                                @onclick="OnCopyStyle">
                            @Loc["TmWireframe_CopyStyle"]
                        </button>
                        <button class="tm-wd-editor__btn tm-wd-editor__btn--text"
                                title="@Loc["TmWireframe_PasteStyle"]"
                                disabled="@(!HasClipboardStyle || _elements.Count == 0 || ReadOnly)"
                                @onclick="OnPasteStyle">
                            @Loc["TmWireframe_PasteStyle"]
                        </button>
                        <button class="tm-wd-editor__btn tm-wd-editor__btn--text"
                                title="@Loc["TmWireframe_PasteSize"]"
                                disabled="@(!HasClipboardStyle || _elements.Count == 0 || ReadOnly)"
                                @onclick="OnPasteSize">
                            @Loc["TmWireframe_PasteSize"]
                        </button>
                    </div>
                </div>
            </div>
        </details>
    }

    @* ── Layout section (X, Y, W, H) ──────────────────────────────────────── *@
    <details class="tm-wd-props__section" open>
        <summary class="tm-wd-props__section-header">@Loc["TmWireframeProps_SectionLayout"]</summary>
        <div class="tm-wd-props__section-body tm-wd-props__section-body--grid2">
            @RenderLayoutField(Loc["TmWireframeProps_X"], _layoutX, "x", "0")
            @RenderLayoutField(Loc["TmWireframeProps_Y"], _layoutY, "y", "0")
            @RenderLayoutField(Loc["TmWireframeProps_W"], _layoutW, "w", "—")
            @RenderLayoutField(Loc["TmWireframeProps_H"], _layoutH, "h", "—")
        </div>
    </details>

    @* ── Per-category prop sections ────────────────────────────────────────── *@
    @foreach (var cat in _propCategories)
    {
        var propsInCat = GetPropsForCategory(cat);
        if (!propsInCat.Any()) continue;

        <details class="tm-wd-props__section" open>
            <summary class="tm-wd-props__section-header">@GetCategoryName(cat)</summary>
            <div class="tm-wd-props__section-body">
                @foreach (var prop in propsInCat)
                {
                    var isMixed  = _isMulti && IsMixedValue(prop.Name);
                    var hasError = _validationErrors.ContainsKey(prop.Name);
                    var valStr   = GetDisplayValue(prop.Name, prop);

                    <div class="tm-wd-props__field @(hasError ? "tm-wd-props__field--error" : "")">
                        <label class="tm-wd-props__label">
                            @prop.DisplayName
                            @if (prop.IsRequired) { <span class="tm-wd-props__required">*</span> }
                        </label>

                        @switch (prop.Type)
                        {
                            case PropType.Bool:
                                <label class="tm-wd-props__toggle">
                                    <input type="checkbox"
                                           checked="@(valStr == "true")"
                                           indeterminate="@isMixed"
                                           @onchange="@(e => OnBoolPropChanged(prop.Name, e))" />
                                    <span class="tm-wd-props__toggle-track"></span>
                                </label>
                                break;

                            case PropType.Enum when prop.Options is { Length: > 0 }:
                                <select class="tm-wd-props__select @(isMixed ? "tm-wd-props__input--mixed" : "")"
                                        value="@(isMixed ? "" : valStr)"
                                        @onchange="@(e => OnStringPropChanged(prop.Name, e))">
                                    @if (isMixed)
                                    {
                                        <option value="" disabled>— @Loc["TmWireframeProps_MixedPlaceholder"] —</option>
                                    }
                                    @foreach (var opt in prop.Options)
                                    {
                                        <option value="@opt">@opt</option>
                                    }
                                </select>
                                break;

                            case PropType.Color:
                                <div class="tm-wd-props__color-row">
                                    <input type="color"
                                           class="tm-wd-props__color-swatch"
                                           value="@(isMixed ? "#000000" : valStr)"
                                           @onchange="@(e => OnStringPropChanged(prop.Name, e))" />
                                    <input type="text"
                                           class="tm-wd-props__input @(isMixed ? "tm-wd-props__input--mixed" : "") @(hasError ? "tm-wd-props__input--error" : "")"
                                           placeholder="@(isMixed ? Loc["TmWireframeProps_MixedPlaceholder"] : "#rrggbb")"
                                           value="@(isMixed ? "" : valStr)"
                                           @oninput="@(e => OnStringPropChanged(prop.Name, e))" />
                                </div>
                                break;

                            case PropType.Int:
                            case PropType.Double:
                                <input type="number"
                                       class="tm-wd-props__input @(isMixed ? "tm-wd-props__input--mixed" : "") @(hasError ? "tm-wd-props__input--error" : "")"
                                       step="@(prop.Type == PropType.Int ? "1" : "0.01")"
                                       placeholder="@(isMixed ? Loc["TmWireframeProps_MixedPlaceholder"] : "")"
                                       value="@(isMixed ? "" : valStr)"
                                       @oninput="@(e => OnNumberPropChanged(prop.Name, prop.Type, e))" />
                                break;

                            case PropType.StringList:
                                <input type="text"
                                       class="tm-wd-props__input @(isMixed ? "tm-wd-props__input--mixed" : "") @(hasError ? "tm-wd-props__input--error" : "")"
                                       placeholder="@(isMixed ? Loc["TmWireframeProps_MixedPlaceholder"] : Loc["TmWireframeProps_CommaSeparatedPlaceholder"])"
                                       value="@(isMixed ? "" : valStr)"
                                       @oninput="@(e => OnStringListPropChanged(prop.Name, e))" />
                                break;

                            default: @* String, Icon, Object, unknown *@
                                <input type="text"
                                       class="tm-wd-props__input @(isMixed ? "tm-wd-props__input--mixed" : "") @(hasError ? "tm-wd-props__input--error" : "")"
                                       placeholder="@(isMixed ? Loc["TmWireframeProps_MixedPlaceholder"] : (prop.Default?.ToString() ?? ""))"
                                       value="@(isMixed ? "" : valStr)"
                                       @oninput="@(e => OnStringPropChanged(prop.Name, e, prop.ValidationRegex))" />
                                break;
                        }

                        @if (hasError)
                        {
                            <span class="tm-wd-props__error-msg">@_validationErrors[prop.Name]</span>
                        }
                    </div>
                }
            </div>
        </details>
    }

    } @* end else (elements selected) *@

</div>

@* ── Layout field helper (local RenderFragment factory) ───────────────────── *@
@code {
    private RenderFragment RenderLayoutField(string label, string? value, string fieldKey, string placeholder) =>
        @<div class="tm-wd-props__field">
            <label class="tm-wd-props__label">@label</label>
            <input type="number"
                   class="tm-wd-props__input @(value == MixedMarker ? "tm-wd-props__input--mixed" : "")"
                   step="1"
                   placeholder="@(value == MixedMarker ? Loc["TmWireframeProps_MixedPlaceholder"] : placeholder)"
                   value="@(value == MixedMarker ? "" : value)"
                   @oninput="@(e => OnLayoutChanged(fieldKey, e))" />
        </div>;
}
