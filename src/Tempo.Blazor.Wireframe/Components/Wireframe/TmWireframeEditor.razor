@namespace Tempo.Blazor.Components.Wireframe
@using Tempo.Blazor.Components.Wireframe.Models
@using Microsoft.AspNetCore.Components.Forms

@* ── TmWireframeEditor ──────────────────────────────────────────────────────
   Top-level wireframe editor. Composes Toolbox + Canvas + Properties Panel +
   optional Minimap and Toolbar. Creates and owns the WireframeCommandStack and
   exposes it to all child components via CascadingValue.
   ─────────────────────────────────────────────────────────────────────────── *@

<CascadingValue Value="_commandStack" IsFixed="false">

<div class="tm-wd-editor @Class" @onkeydown="OnKeyDown" tabindex="0">

    @* ── Toolbar ─────────────────────────────────────────────────────────── *@
    @if (ShowToolbar)
    {
        <div class="tm-wd-editor__toolbar" role="group" aria-label="@Loc["TmWireframe_ToolbarAriaLabel"]">

            @* Title *@
            <input class="tm-wd-editor__title"
                   type="text"
                   value="@_document?.Title"
                   placeholder="@Loc["TmWireframe_UntitledPlaceholder"]"
                   aria-label="@Loc["TmWireframe_DocumentTitleLabel"]"
                   @onchange="OnTitleChanged"
                   disabled="@ReadOnly"
                   title="@Loc["TmWireframe_DocumentTitleLabel"]" />

            @* Tool mode: Select / Pan *@
            <button class="tm-wd-editor__btn tm-wd-editor__btn--icon @(_toolMode == "select" ? "tm-wd-editor__btn--active" : "")"
                    aria-label="@Loc["TmWireframe_SelectTool"]"
                    aria-pressed="@(_toolMode == "select")"
                    title="@Loc["TmWireframe_SelectTool"]"
                    disabled="@ReadOnly"
                    @onclick='() => SetToolMode("select")'>
                ↖
            </button>
            <button class="tm-wd-editor__btn tm-wd-editor__btn--icon @(_toolMode == "pan" ? "tm-wd-editor__btn--active" : "")"
                    aria-label="@Loc["TmWireframe_PanTool"]"
                    aria-pressed="@(_toolMode == "pan")"
                    title="@Loc["TmWireframe_PanToolHint"]"
                    @onclick='() => SetToolMode("pan")'>
                ✋
            </button>
            <button class="tm-wd-editor__btn tm-wd-editor__btn--icon @(_toolMode == "connector" ? "tm-wd-editor__btn--active" : "")"
                    aria-label="@Loc["TmWireframe_ConnectorTool"]"
                    aria-pressed="@(_toolMode == "connector")"
                    title="@Loc["TmWireframe_ConnectorTool"]"
                    disabled="@ReadOnly"
                    @onclick='() => SetToolMode("connector")'>
                →
            </button>

            <div class="tm-wd-editor__toolbar-sep" role="separator"></div>

            @* Undo / Redo *@
            <button class="tm-wd-editor__btn"
                    aria-label="@Loc["TmWireframe_Undo"] @_commandStack.NextUndoName"
                    title="@Loc["TmWireframe_Undo"] (@_commandStack.NextUndoName)"
                    disabled="@(!_commandStack.CanUndo || ReadOnly)"
                    @onclick="OnUndoClicked">
                ↩
            </button>
            <button class="tm-wd-editor__btn"
                    aria-label="@Loc["TmWireframe_Redo"] @_commandStack.NextRedoName"
                    title="@Loc["TmWireframe_Redo"] (@_commandStack.NextRedoName)"
                    disabled="@(!_commandStack.CanRedo || ReadOnly)"
                    @onclick="OnRedoClicked">
                ↪
            </button>

            <div class="tm-wd-editor__toolbar-sep" role="separator"></div>

            @* Arrange: Bring to Front / Send to Back / Lock *@
            <button class="tm-wd-editor__btn tm-wd-editor__btn--icon"
                    aria-label="@Loc["TmWireframe_SendToBack"]"
                    title="@Loc["TmWireframe_SendToBack"]"
                    disabled="@(_selectedIds.Length == 0 || ReadOnly)"
                    @onclick="OnSendToBack">
                ⬇
            </button>
            <button class="tm-wd-editor__btn tm-wd-editor__btn--icon"
                    aria-label="@Loc["TmWireframe_BringToFront"]"
                    title="@Loc["TmWireframe_BringToFront"]"
                    disabled="@(_selectedIds.Length == 0 || ReadOnly)"
                    @onclick="OnBringToFront">
                ⬆
            </button>
            <button class="tm-wd-editor__btn tm-wd-editor__btn--icon @(_selectedIds.Length > 0 && IsSelectionLocked() ? "tm-wd-editor__btn--active" : "")"
                    aria-label="@(_selectedIds.Length > 0 && IsSelectionLocked() ? Loc["TmWireframe_Unlock"] : Loc["TmWireframe_Lock"])"
                    title="@(_selectedIds.Length > 0 && IsSelectionLocked() ? Loc["TmWireframe_Unlock"] : Loc["TmWireframe_Lock"])"
                    disabled="@(_selectedIds.Length == 0 || ReadOnly)"
                    @onclick="OnToggleLock">
                🔒
            </button>

            <div class="tm-wd-editor__toolbar-sep" role="separator"></div>

            @* Group / Ungroup *@
            <button class="tm-wd-editor__btn tm-wd-editor__btn--icon"
                    aria-label="@Loc["TmWireframe_Group"]"
                    title="@Loc["TmWireframe_Group"]"
                    disabled="@(_selectedIds.Length < 2 || ReadOnly)"
                    @onclick="OnGroup">
                📁
            </button>
            <button class="tm-wd-editor__btn tm-wd-editor__btn--icon"
                    aria-label="@Loc["TmWireframe_Ungroup"]"
                    title="@Loc["TmWireframe_Ungroup"]"
                    disabled="@(!SelectedIdsContainGroup() || ReadOnly)"
                    @onclick="OnUngroup">
                📂
            </button>

            <div class="tm-wd-editor__toolbar-sep" role="separator"></div>

            @* Align *@
            <div class="tm-wd-editor__dropdown-wrap">
                <button class="tm-wd-editor__btn tm-wd-editor__btn--icon"
                        aria-label="@Loc["TmWireframe_Align"]"
                        title="@Loc["TmWireframe_Align"]"
                        aria-haspopup="true"
                        aria-expanded="@_alignMenuOpen"
                        disabled="@(_selectedIds.Length < 2 || ReadOnly)"
                        @onclick="ToggleAlignMenu">
                    ⇹
                </button>
                @if (_alignMenuOpen)
                {
                    <div class="tm-wd-editor__dropdown" role="menu" aria-label="@Loc["TmWireframe_Align"]" @onfocusout="CloseAlignMenu">
                        <button class="tm-wd-editor__dropdown-item" role="menuitem" @onclick="() => { CloseAlignMenu(); OnAlign(WireframeAlignment.Left); }">@Loc["TmWireframe_AlignLeft"]</button>
                        <button class="tm-wd-editor__dropdown-item" role="menuitem" @onclick="() => { CloseAlignMenu(); OnAlign(WireframeAlignment.CenterH); }">@Loc["TmWireframe_AlignCenterH"]</button>
                        <button class="tm-wd-editor__dropdown-item" role="menuitem" @onclick="() => { CloseAlignMenu(); OnAlign(WireframeAlignment.Right); }">@Loc["TmWireframe_AlignRight"]</button>
                        <div class="tm-wd-editor__dropdown-sep"></div>
                        <button class="tm-wd-editor__dropdown-item" role="menuitem" @onclick="() => { CloseAlignMenu(); OnAlign(WireframeAlignment.Top); }">@Loc["TmWireframe_AlignTop"]</button>
                        <button class="tm-wd-editor__dropdown-item" role="menuitem" @onclick="() => { CloseAlignMenu(); OnAlign(WireframeAlignment.CenterV); }">@Loc["TmWireframe_AlignCenterV"]</button>
                        <button class="tm-wd-editor__dropdown-item" role="menuitem" @onclick="() => { CloseAlignMenu(); OnAlign(WireframeAlignment.Bottom); }">@Loc["TmWireframe_AlignBottom"]</button>
                    </div>
                }
            </div>

            @* Distribute *@
            <div class="tm-wd-editor__dropdown-wrap">
                <button class="tm-wd-editor__btn tm-wd-editor__btn--icon"
                        aria-label="@Loc["TmWireframe_Distribute"]"
                        title="@Loc["TmWireframe_Distribute"]"
                        aria-haspopup="true"
                        aria-expanded="@_distributeMenuOpen"
                        disabled="@(_selectedIds.Length < 3 || ReadOnly)"
                        @onclick="ToggleDistributeMenu">
                    ⇔
                </button>
                @if (_distributeMenuOpen)
                {
                    <div class="tm-wd-editor__dropdown" role="menu" aria-label="@Loc["TmWireframe_Distribute"]" @onfocusout="CloseDistributeMenu">
                        <button class="tm-wd-editor__dropdown-item" role="menuitem" @onclick="() => { CloseDistributeMenu(); OnDistribute(WireframeDistribution.Horizontal); }">@Loc["TmWireframe_DistributeHorizontal"]</button>
                        <button class="tm-wd-editor__dropdown-item" role="menuitem" @onclick="() => { CloseDistributeMenu(); OnDistribute(WireframeDistribution.Vertical); }">@Loc["TmWireframe_DistributeVertical"]</button>
                    </div>
                }
            </div>

            <div class="tm-wd-editor__toolbar-sep" role="separator"></div>

            @* Snap to Objects *@
            <button class="tm-wd-editor__btn tm-wd-editor__btn--icon @(_snapToObjects ? "tm-wd-editor__btn--active" : "")"
                    aria-label="@Loc["TmWireframe_SnapToObjects"]"
                    title="@Loc["TmWireframe_SnapToObjects"]"
                    disabled="@ReadOnly"
                    @onclick="ToggleSnapToObjects">
                🧲
            </button>

            @* Show Rulers *@
            <button class="tm-wd-editor__btn tm-wd-editor__btn--icon @(ShowRulers ? "tm-wd-editor__btn--active" : "")"
                    aria-label="@Loc["TmWireframe_ShowRulers"]"
                    title="@Loc["TmWireframe_ShowRulers"]"
                    @onclick="ToggleRulers">
                📏
            </button>

            <div class="tm-wd-editor__toolbar-sep" role="separator"></div>

            @* Format Painter *@
            <button class="tm-wd-editor__btn tm-wd-editor__btn--icon"
                    aria-label="@Loc["TmWireframe_CopyStyle"]"
                    title="@Loc["TmWireframe_CopyStyle"]"
                    disabled="@(_selectedIds.Length != 1 || ReadOnly)"
                    @onclick="OnCopyStyle">
                🎨
            </button>
            <button class="tm-wd-editor__btn tm-wd-editor__btn--icon @(_hasStyleOnClipboard ? "tm-wd-editor__btn--active" : "")"
                    aria-label="@Loc["TmWireframe_PasteStyle"]"
                    title="@Loc["TmWireframe_PasteStyle"]"
                    disabled="@(!_hasStyleOnClipboard || _selectedIds.Length == 0 || ReadOnly)"
                    @onclick="OnPasteStyle">
                🖌️
            </button>
            <button class="tm-wd-editor__btn tm-wd-editor__btn--icon"
                    aria-label="@Loc["TmWireframe_PasteSize"]"
                    title="@Loc["TmWireframe_PasteSize"]"
                    disabled="@(!_hasStyleOnClipboard || _selectedIds.Length == 0 || ReadOnly)"
                    @onclick="OnPasteSize">
                📐
            </button>

            <div class="tm-wd-editor__toolbar-sep" role="separator"></div>

            @* Zoom *@
            <button class="tm-wd-editor__btn" aria-label="@Loc["TmWireframe_ZoomOut"]" title="@Loc["TmWireframe_ZoomOut"]" @onclick="ZoomOut">−</button>
            <span class="tm-wd-editor__zoom-label" role="status" aria-live="polite" aria-label="@(string.Format(Loc["TmWireframeEditor_ZoomAria"], _zoomLabel))">@_zoomLabel</span>
            <button class="tm-wd-editor__btn" aria-label="@Loc["TmWireframeEditor_ZoomIn"]"  title="@Loc["TmWireframeEditor_ZoomIn"]"  @onclick="ZoomIn">+</button>
            <button class="tm-wd-editor__btn tm-wd-editor__btn--text" aria-label="@Loc["TmWireframe_FitToView"]" title="@Loc["TmWireframe_FitToView"]" @onclick="FitToView">@Loc["TmWireframe_FitToView"]</button>

            @* Canvas size *@
            @if (_canvasSizeEditing)
            {
                <input class="tm-wd-editor__canvas-size-input"
                       type="number" min="100" max="9999" step="1"
                       aria-label="@Loc["TmWireframe_CanvasWidth"]"
                       value="@_canvasWInput"
                       @oninput="e => _canvasWInput = e.Value?.ToString() ?? _canvasWInput" />
                <span class="tm-wd-editor__canvas-size-sep">×</span>
                <input class="tm-wd-editor__canvas-size-input"
                       type="number" min="100" max="9999" step="1"
                       aria-label="@Loc["TmWireframe_CanvasHeight"]"
                       value="@_canvasHInput"
                       @oninput="e => _canvasHInput = e.Value?.ToString() ?? _canvasHInput" />
                <button class="tm-wd-editor__btn tm-wd-editor__btn--text"
                        aria-label="@Loc["TmWireframe_Apply"]"
                        title="@Loc["TmWireframe_Apply"]"
                        @onclick="ApplyCanvasSize">✓</button>
                <button class="tm-wd-editor__btn tm-wd-editor__btn--text"
                        aria-label="@Loc["TmWireframe_Cancel"]"
                        title="@Loc["TmWireframe_Cancel"]"
                        @onclick="() => _canvasSizeEditing = false">✕</button>
            }
            else
            {
                <button class="tm-wd-editor__btn tm-wd-editor__btn--text tm-wd-editor__btn--canvas-size"
                        aria-label="@Loc["TmWireframe_ChangeCanvasSize"], current @((int)(_document?.Width ?? 1280))×@((int)(_document?.Height ?? 800))"
                        title="@Loc["TmWireframe_ChangeCanvasSize"]"
                        @onclick="OpenCanvasSize">
                    @((int)(_document?.Width ?? 1280))×@((int)(_document?.Height ?? 800))
                </button>
            }

            <div class="tm-wd-editor__toolbar-sep" role="separator"></div>

            @* Export *@
            <div class="tm-wd-editor__dropdown-wrap">
                <button class="tm-wd-editor__btn tm-wd-editor__btn--text"
                        aria-label="@Loc["TmWireframe_Export"]"
                        aria-haspopup="true"
                        aria-expanded="@_exportMenuOpen"
                        @onclick="ToggleExportMenu"
                        title="@Loc["TmWireframe_Export"]">
                    @Loc["TmWireframe_Export"] ▾
                </button>
                @if (_exportMenuOpen)
                {
                    <div class="tm-wd-editor__dropdown" role="menu" aria-label="@Loc["TmWireframe_Export"]" @onfocusout="CloseExportMenu">
                        <button class="tm-wd-editor__dropdown-item" role="menuitem" @onclick="ExportJson">@Loc["TmWireframe_ExportJson"]</button>
                        <button class="tm-wd-editor__dropdown-item" role="menuitem" @onclick="ExportSvg">@Loc["TmWireframe_ExportSvg"]</button>
                        <button class="tm-wd-editor__dropdown-item" role="menuitem" @onclick="ExportPng">@Loc["TmWireframe_ExportPng"]</button>
                        <button class="tm-wd-editor__dropdown-item" role="menuitem" @onclick="ExportPdf">@Loc["TmWireframe_ExportPdf"]</button>
                    </div>
                }
            </div>

            @* Import *@
            <label class="tm-wd-editor__btn tm-wd-editor__btn--text" title="@Loc["TmWireframe_ImportJson"]" aria-label="@Loc["TmWireframe_ImportJson"]">
                @Loc["TmWireframe_ImportJson"]
                <InputFile class="tm-wd-editor__file-input" OnChange="OnImportFile" accept=".json,.wireframe.json" />
            </label>

            <div class="tm-wd-editor__toolbar-spacer"></div>

            @* Read-only toggle *@
            <button class="tm-wd-editor__btn tm-wd-editor__btn--text @(ReadOnly ? "tm-wd-editor__btn--active" : "")"
                    aria-label="@(ReadOnly ? Loc["TmWireframe_SwitchToEditMode"] : Loc["TmWireframe_SwitchToReadOnlyMode"])"
                    aria-pressed="@ReadOnly"
                    title="@(ReadOnly ? Loc["TmWireframe_SwitchToEditMode"] : Loc["TmWireframe_SwitchToReadOnlyMode"])"
                    @onclick="ToggleReadOnly">
                @(ReadOnly ? "🔒 " + Loc["TmWireframe_ReadOnly"] : "✏ " + Loc["TmWireframe_Edit"])
            </button>

            @* Panel toggles *@
            @if (ShowToolbox)
            {
                <button class="tm-wd-editor__btn tm-wd-editor__btn--icon @(_toolboxCollapsed ? "" : "tm-wd-editor__btn--active")"
                        aria-label="@(_toolboxCollapsed ? Loc["TmWireframe_ShowToolbox"] : Loc["TmWireframe_HideToolbox"])"
                        aria-pressed="@(!_toolboxCollapsed)"
                        title="@Loc["TmWireframe_ToggleToolbox"]"
                        @onclick="() => _toolboxCollapsed = !_toolboxCollapsed">
                    ◧
                </button>
            }
            @if (ShowPropertiesPanel)
            {
                <button class="tm-wd-editor__btn tm-wd-editor__btn--icon @(_propsCollapsed ? "" : "tm-wd-editor__btn--active")"
                        aria-label="@(_propsCollapsed ? Loc["TmWireframe_ShowProperties"] : Loc["TmWireframe_HideProperties"])"
                        aria-pressed="@(!_propsCollapsed)"
                        title="@Loc["TmWireframe_ToggleProperties"]"
                        @onclick="() => _propsCollapsed = !_propsCollapsed">
                    ◨
                </button>
            }

        </div>
    }

    @* ── Page tabs ───────────────────────────────────────────────────────── *@
    @if (ShowPageTabs && _document?.Pages.Count > 0)
    {
        <div class="tm-wd-editor__page-tabs">
            @foreach (var pg in _document.Pages)
            {
                var isActive = _activePage?.Id == pg.Id;
                <div class="tm-wd-editor__page-tab @(isActive ? "tm-wd-editor__page-tab--active" : "")"
                     role="tab"
                     aria-selected="@isActive"
                     draggable="true"
                     @ondragstart="() => OnPageDragStart(pg.Id)"
                     @ondrop="() => OnPageDrop(pg.Id)"
                     @ondragover:preventDefault
                     @onclick="() => SwitchPage(pg.Id)">
                    @if (_renamingPageId == pg.Id)
                    {
                        <input class="tm-wd-editor__page-tab-input"
                               type="text"
                               value="@pg.Name"
                               @onchange="e => OnPageRenamed(pg.Id, e)"
                               @onblur="() => _renamingPageId = null"
                               @onkeydown="OnRenameInputKeyDown"
                               autofocus />
                    }
                    else
                    {
                        <span class="tm-wd-editor__page-tab-label"
                              @ondblclick:stopPropagation
                              @ondblclick="() => StartRenamePage(pg.Id)">@pg.Name</span>
                    }
                    @if (_document.Pages.Count > 1)
                    {
                        <button class="tm-wd-editor__page-tab-close"
                                aria-label="@Loc["TmWireframe_ClosePage"]"
                                title="@Loc["TmWireframe_ClosePage"]"
                                @onclick:stopPropagation
                                @onclick="() => DeletePage(pg.Id)">✕</button>
                    }
                </div>
            }
            <button class="tm-wd-editor__page-tab-add"
                    aria-label="@Loc["TmWireframe_AddPage"]"
                    title="@Loc["TmWireframe_AddPage"]"
                    @onclick="AddPage">+</button>
            @if (_activePage is not null)
            {
                <button class="tm-wd-editor__page-tab-dup"
                        aria-label="@Loc["TmWireframe_DuplicatePage"]"
                        title="@Loc["TmWireframe_DuplicatePage"]"
                        @onclick="DuplicatePage">@Loc["TmWireframe_DuplicatePageShort"]</button>
            }
        </div>
    }

    @* ── Import error banner ──────────────────────────────────────────────── *@
    @if (_importError is not null)
    {
        <div class="tm-wd-editor__error-banner" role="alert" aria-live="assertive">
            @_importError
            <button class="tm-wd-editor__error-close" aria-label="@Loc["TmWireframe_DismissError"]" @onclick="() => _importError = null">✕</button>
        </div>
    }

    @* ── Body (toolbox + rulers + canvas + props) ───────────────────────── *@
    <div class="tm-wd-editor__body">

        @* Left: Toolbox *@
        @if (ShowToolbox && !_toolboxCollapsed)
        {
            <div class="tm-wd-editor__toolbox-wrap">
                <TmWireframeToolbox OnComponentActivated="OnToolboxActivated"
                                    ComponentScope="@ComponentScope"
                                    Class="tm-wd-editor__toolbox" />
            </div>
        }

        @* Centre: Rulers + Canvas *@
        <div class="tm-wd-editor__canvas-area">
            @* Horizontal ruler *@
            @if (ShowRulers)
            {
                <TmWireframeRuler Orientation="Horizontal"
                                  Size="20"
                                  ViewBoxX="@_viewBoxX"
                                  ViewBoxY="@_viewBoxY"
                                  ViewBoxW="@_viewBoxW"
                                  ViewBoxH="@_viewBoxH"
                                  Scale="@_zoomLevel"
                                  IndicatorPos="@_rulerCursorX"
                                  Class="tm-wd-editor__ruler-h" />
            }

            <div class="tm-wd-editor__canvas-inner">
                @* Vertical ruler *@
                @if (ShowRulers)
                {
                    <TmWireframeRuler Orientation="Vertical"
                                      Size="20"
                                      ViewBoxX="@_viewBoxX"
                                      ViewBoxY="@_viewBoxY"
                                      ViewBoxW="@_viewBoxW"
                                      ViewBoxH="@_viewBoxH"
                                      Scale="@_zoomLevel"
                                      IndicatorPos="@_rulerCursorY"
                                      Class="tm-wd-editor__ruler-v" />
                }

                @* Canvas *@
                <div class="tm-wd-editor__canvas-wrap">
                    <TmWireframeDesignerCanvas @ref="_canvas"
                                       Document="@_document"
                                       DocumentChanged="OnDocumentChanged"
                                       ComponentScope="@ComponentScope"
                                       ShowGrid="@ShowGrid"
                                       GridSize="@GridSize"
                                       SnapToObjects="@_snapToObjects"
                                       ReadOnly="@ReadOnly"
                                       OnSelectionChanged="OnSelectionChanged"
                                       OnConnectorSelectionChanged="OnConnectorSelectionChanged"
                                       OnConnectorCreated="OnConnectorCreated"
                                       OnDeleteConnectors="OnDeleteConnectors"
                                       OnConnectorWaypointDragged="OnConnectorWaypointDragged"
                                       OnConnectorWaypointAdded="OnConnectorWaypointAdded"
                                       OnConnectorDragged="OnConnectorDragged"
                                       OnToolModeChanged="OnCanvasToolModeChanged"
                                       OnCopyStyleRequested="OnCopyStyle"
                                       OnPasteStyleRequested="OnPasteStyle"
                                       OnPasteSizeRequested="OnPasteSize"
                                       OnElementContextMenuRequested="OnElementContextMenuRequested"
                                       OnConnectorContextMenuRequested="OnConnectorContextMenuRequested"
                                       OnCanvasContextMenuRequested="OnCanvasContextMenuRequested"
                                       OnCloseContextMenu="CloseContextMenu"
                                       OnViewBoxChangedEvent="OnCanvasViewBoxChanged"
                                       OnCanvasMouseMoved="OnCanvasMouseMoved"
                                       Class="tm-wd-editor__canvas" />

            @* Context menu (right-click) *@
            <TmWireframeContextMenu @ref="_contextMenu"
                                    IsOpen="@_ctxMenuOpen"
                                    X="@_ctxMenuX"
                                    Y="@_ctxMenuY"
                                    MenuType="@_ctxMenuType"
                                    CanUndo="@_commandStack.CanUndo"
                                    CanRedo="@_commandStack.CanRedo"
                                    HasClipboardStyle="@WireframeClipboard.HasStyle"
                                    SelectedCount="@_selectedIds.Length"
                                    HasGroupInSelection="@SelectedIdsContainGroup()"
                                    IsSelectionLocked="@IsSelectionLocked()"
                                    ReadOnly="@ReadOnly"
                                    ShowGrid="@ShowGrid"
                                    SnapToObjects="@_snapToObjects"
                                    OnClose="CloseContextMenu"
                                    OnUndo="OnUndoClicked"
                                    OnRedo="OnRedoClicked"
                                    OnSelectAll="OnSelectAll"
                                    OnCopyStyle="OnCopyStyle"
                                    OnDuplicate="OnDuplicateFromContextMenu"
                                    OnDelete="OnDeleteFromContextMenu"
                                    OnBringToFront="OnBringToFront"
                                    OnSendToBack="OnSendToBack"
                                    OnGroup="OnGroup"
                                    OnUngroup="OnUngroup"
                                    OnLock="OnLockFromContextMenu"
                                    OnUnlock="OnUnlockFromContextMenu"
                                    OnPasteStyle="OnPasteStyle"
                                    OnPasteSize="OnPasteSize"
                                    OnAlign="OnAlign"
                                    OnDistribute="OnDistribute"
                                    OnToggleGrid="ContextMenuToggleGrid"
                                    OnToggleSnapToObjects="ContextMenuToggleSnapToObjects"
                                    OnFitToView="ContextMenuFitToView"
                                    OnEditConnectorLabel="OnEditConnectorLabelFromContextMenu"
                                    OnSetConnectorRouting="OnSetConnectorRoutingFromContextMenu" />

            @if (ShowMinimap)
            {
                <div class="tm-wd-editor__minimap-wrap">
                    <TmWireframeMinimap @ref="_minimap"
                                        Document="@_document"
                                        SelectedIds="@_selectedIds"
                                        Viewport="@_minimapViewport"
                                        Width="180"
                                        NavigateRequested="OnMinimapNavigate"
                                        Class="tm-wd-editor__minimap" />
                </div>
            }
                </div> @* canvas-wrap *@
            </div> @* canvas-inner *@
        </div> @* canvas-area *@

        @* Right: Properties Panel + Layers *@
        @if (ShowPropertiesPanel && !_propsCollapsed)
        {
            <div class="tm-wd-editor__props-wrap">
                <TmWireframePropertiesPanel Document="@_document"
                                            DocumentChanged="OnDocumentChanged"
                                            ComponentScope="@ComponentScope"
                                            SelectedIds="@_selectedIds"
                                            SelectedConnectorIds="@_selectedConnectorIds"
                                            OnCopyStyle="OnCopyStyle"
                                            OnPasteStyle="OnPasteStyle"
                                            OnPasteSize="OnPasteSize"
                                            ReadOnly="@ReadOnly"
                                            Class="tm-wd-editor__props" />
                <TmWireframeLayersPanel Document="@_document"
                                        DocumentChanged="OnDocumentChanged"
                                        SelectedElementIds="@_selectedIds"
                                        ActiveLayerId="@_activeLayerId"
                                        ActiveLayerIdChanged="OnActiveLayerChanged"
                                        ReadOnly="@ReadOnly"
                                        Class="tm-wd-editor__layers" />
            </div>
        }

    </div>

</div>

</CascadingValue>

@* Export dialog *@
<TmWireframeExportDialog Show="@_exportDialogOpen"
                         OnClose="CloseExportDialog"
                         OnExport="OnExportDialogExport"
                         DefaultFileName="@SanitizeFileName(_document?.Title ?? Loc["TmWireframe_ExportFilename"])" />

@* Hidden download anchor for export *@
<a @ref="_downloadAnchor" style="display:none"></a>
