<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- NuGet Package Metadata -->
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Tempo.Blazor.Abstractions</PackageId>
<Version>2.8.19</Version>
    <Authors>ptyll</Authors>
    <Description>Interfaces and models for Tempo.Blazor component library. Zero UI dependencies – safe to reference from API/service projects.</Description>
    <PackageTags>blazor;abstractions;interfaces;models</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ptyll/Tempo.Blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ptyll/Tempo.Blazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- CS1591: interface already provides XML docs for implementing properties -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Žádná UI závislost, žádný Blazor reference -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
    <ApiCompatSuppressionFile Include="CompatibilitySuppressions.xml"
                              Condition="'$(EnablePackageValidation)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Minimal DI abstractions (IServiceCollection, ServiceDescriptor) — no runtime dependency -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>

</Project>
