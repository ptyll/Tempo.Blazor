<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- DemoDiagramSchema.LockNameFor: the cross-process schema tooth has to take the very mutex the host
         would take, so the lock name has one spelling and both sides read it from there. -->
    <InternalsVisibleTo Include="Tempo.Blazor.Demo.Api.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tempo.Blazor.Demo.Shared\Tempo.Blazor.Demo.Shared.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.Abstractions\Tempo.Blazor.Abstractions.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.Collaboration\Tempo.Blazor.Collaboration.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.DocumentFormats\Tempo.Blazor.DocumentFormats.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.EmailTemplates.Abstractions\Tempo.Blazor.EmailTemplates.Abstractions.csproj" />
    <!-- The demo API renders the preview for the WASM editor: that is exactly the server-side usage of
         Tempo.Blazor.EmailTemplates.Engine (contract §3.0/§3.5). -->
    <ProjectReference Include="..\Tempo.Blazor.EmailTemplates.Engine\Tempo.Blazor.EmailTemplates.Engine.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.Mcp\Tempo.Blazor.Mcp.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.Wireframe\Tempo.Blazor.Wireframe.csproj" />
    <ProjectReference Include="..\Tempo.Blazor.WebPush\Tempo.Blazor.WebPush.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The gallery demo images live in Demo.SharedUI/wwwroot so every demo host serves them at the
         page origin (thumbnails); the API serves the same files through the lightbox ticket
         endpoint, so they are linked into the API output as content. -->
    <Content Include="..\Tempo.Blazor.Demo.SharedUI\wwwroot\gallery\*.svg" Link="gallery\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <!-- NuGetAudit NU1902/NU1903: MailKit/MimeKit and Microsoft.Data.SqlClient pull System.Security.Cryptography.Pkcs 10.0.0 transitively (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7); pin the patched build. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="QuestPDF" Version="2026.2.4" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.2" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Svg.Skia" Version="4.2.0" />
  </ItemGroup>
</Project>
