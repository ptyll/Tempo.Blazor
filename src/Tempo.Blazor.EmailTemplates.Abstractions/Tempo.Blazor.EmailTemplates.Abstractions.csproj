<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- NuGet Package Metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>Tempo.Blazor.EmailTemplates.Abstractions</PackageId>
    <Version>2.9.1</Version>
    <Authors>ptyll</Authors>
    <Title>Tempo.Blazor.EmailTemplates.Abstractions</Title>
    <Description>Logic and contracts for the Tempo.Blazor email template editor: block model, MJML generation and import, Scriban templating sandbox, variable extraction, render pipeline, DTOs and validators. No Blazor dependency – safe to reference from API/service projects.</Description>
    <PackageTags>blazor;email;mjml;templates;scriban</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ptyll/Tempo.Blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ptyll/Tempo.Blazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.5" />
    <PackageReference Include="Mjml.Net" Version="4.15.0" />
    <PackageReference Include="Scriban" Version="7.5.1" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <!-- ═══ Localization: JSON resources embedded in THIS assembly ═══
       The request validators' messages live in
       Resources/EmailTemplateValidationResources[.<culture>].json — a flat { "Key": "Value" } map read
       by the CLOSED IStringLocalizer<EmailTemplateValidationResources> (JsonStringLocalizer<T>,
       registered by AddTempoEmailTemplateEngine). They used to be .resx, which only resolves through
       the host's IStringLocalizerFactory: a host that replaces it got bare keys as validation
       messages, and a host that never calls AddLocalization() could not resolve the validator at all. -->
  <ItemGroup>
    <!-- WithCulture=false keeps every file in the MAIN assembly (a culture suffix would route it into a
         satellite assembly, which is not loaded under Blazor WebAssembly). -->
    <EmbeddedResource Include="Resources/EmailTemplateValidationResources.json">
      <WithCulture>false</WithCulture>
      <LogicalName>Tempo.Blazor.EmailTemplates.Abstractions.Resources.EmailTemplateValidationResources.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources/EmailTemplateValidationResources.cs.json">
      <WithCulture>false</WithCulture>
      <LogicalName>Tempo.Blazor.EmailTemplates.Abstractions.Resources.EmailTemplateValidationResources.cs.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources/EmailTemplateValidationResources.sk.json">
      <WithCulture>false</WithCulture>
      <LogicalName>Tempo.Blazor.EmailTemplates.Abstractions.Resources.EmailTemplateValidationResources.sk.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources/EmailTemplateValidationResources.fr.json">
      <WithCulture>false</WithCulture>
      <LogicalName>Tempo.Blazor.EmailTemplates.Abstractions.Resources.EmailTemplateValidationResources.fr.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Tempo.Blazor.EmailTemplates.Abstractions.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- Phase 6 (D11) moves the sandbox implementation into the Engine package; the moved types stay
         internal, so the future assembly needs access to the current ones during the extraction. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Tempo.Blazor.EmailTemplates.Engine</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
