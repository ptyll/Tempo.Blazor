@namespace Tempo.Blazor.Components.NotionEditor.Blocks.Text
@using Tempo.Blazor.NotionEditor.Interfaces
@using Tempo.Blazor.NotionEditor.Enums
@using Tempo.Blazor.Components.NotionEditor.Services
@using Tempo.Blazor.Components.NotionEditor.UI

<div class="tm-notion-callout @_variantClass @_bgClass"
     data-variant="@_variantName"
     data-bg="@NotionColorTokens.Name(Content?.BackgroundColor)">

    <div class="tm-notion-callout__icon-wrap">
        <button class="tm-notion-callout__icon"
                type="button"
                disabled="@ReadOnly"
                aria-label="@Loc["TmNotionCalloutBlock_ChangeIcon"]"
                title="@Loc["TmNotionCalloutBlock_ChangeIcon"]"
                @onclick="ToggleEmojiPicker"
                @onclick:stopPropagation="true">
            @_currentEmoji
        </button>

        @if (_showEmojiPicker && !ReadOnly)
        {
            <TmNotionEmojiPicker Visible="true"
                                  OnEmojiSelected="HandleEmojiSelectedAsync"
                                  OnRemoved="HandleEmojiRemovedAsync"
                                  OnClosed="CloseEmojiPicker"
                                  ShowRemove="true" />
        }
    </div>

    @if (ReadOnly)
    {
        <div @key="ReadOnly"
             class="tm-notion-callout__body tm-notion-editable tm-notion-editable--readonly @_alignClass"
             contenteditable="false"
             data-color="@NotionColorTokens.Name(Content?.TextColor)">
            @((MarkupString)NotionHtmlSanitizer.SanitizeBlockContent(Content?.Html))
        </div>
    }
    else
    {
        <div @key="ReadOnly"
             class="tm-notion-callout__body tm-notion-editable @_alignClass"
             contenteditable="true"
             data-placeholder="@Placeholder"
             data-color="@NotionColorTokens.Name(Content?.TextColor)"
             spellcheck="true"
             @ref="_editableRef"
             @oninput="() => _dirty = true"
             @onblur="OnBlurAsync"
             @onfocus="HandleFocusAsync">
        </div>
    }

</div>
