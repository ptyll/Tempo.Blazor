@using Tempo.Blazor.Components.NotionEditor.Services
@namespace Tempo.Blazor.Components.NotionEditor.Blocks.Text
@using Tempo.Blazor.NotionEditor.Models

<div class="tm-notion-heading tm-notion-heading--h@(Content?.Level ?? 1) @_closedClass"
     data-notion-heading>

    @* ── Toggle arrow (only when IsToggleable) ────────────────────────────── *@
    @if (Content?.IsToggleable == true)
    {
        <button class="tm-notion-heading__toggle @(_isToggleOpen ? "tm-notion-heading__toggle--open" : "")"
                type="button"
                tabindex="-1"
                aria-label="@Loc["TmNotionHeadingBlock_ToggleSection"]"
                aria-expanded="@_isToggleOpen.ToString().ToLower()"
                @onclick="HandleToggleAsync"
                @onclick:stopPropagation="true">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5"
                      stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
    }

    @* ── Semantic heading element (h1 / h2 / h3) ──────────────────────────── *@
    @if ((Content?.Level ?? 1) == 1)
    {
        @if (ReadOnly)
        {
            <h1 @key="ReadOnly"
                class="tm-notion-h1 tm-notion-editable tm-notion-editable--readonly @_alignClass @_bgClass"
                contenteditable="false"
                data-bg="@NotionColorTokens.Name(Content?.BackgroundColor)"
                data-color="@NotionColorTokens.Name(Content?.TextColor)">
                @((MarkupString)NotionHtmlSanitizer.SanitizeBlockContent(Content?.Html))
            </h1>
        }
        else
        {
            <h1 @key="ReadOnly"
                class="tm-notion-h1 tm-notion-editable @_alignClass @_bgClass"
                contenteditable="true"
                data-placeholder="@Loc["TmNotionHeadingBlock_Placeholder"]"
                data-bg="@NotionColorTokens.Name(Content?.BackgroundColor)"
                data-color="@NotionColorTokens.Name(Content?.TextColor)"
                spellcheck="true"
                @ref="_editableRef"
                @oninput="() => _dirty = true"
                @onblur="OnBlurAsync"
                @onfocus="HandleFocusAsync">
            </h1>
        }
    }
    else if ((Content?.Level ?? 1) == 2)
    {
        @if (ReadOnly)
        {
            <h2 @key="ReadOnly"
                class="tm-notion-h2 tm-notion-editable tm-notion-editable--readonly @_alignClass @_bgClass"
                contenteditable="false"
                data-bg="@NotionColorTokens.Name(Content?.BackgroundColor)"
                data-color="@NotionColorTokens.Name(Content?.TextColor)">
                @((MarkupString)NotionHtmlSanitizer.SanitizeBlockContent(Content?.Html))
            </h2>
        }
        else
        {
            <h2 @key="ReadOnly"
                class="tm-notion-h2 tm-notion-editable @_alignClass @_bgClass"
                contenteditable="true"
                data-placeholder="@Loc["TmNotionHeadingBlock_Placeholder"]"
                data-bg="@NotionColorTokens.Name(Content?.BackgroundColor)"
                data-color="@NotionColorTokens.Name(Content?.TextColor)"
                spellcheck="true"
                @ref="_editableRef"
                @oninput="() => _dirty = true"
                @onblur="OnBlurAsync"
                @onfocus="HandleFocusAsync">
            </h2>
        }
    }
    else
    {
        @if (ReadOnly)
        {
            <h3 @key="ReadOnly"
                class="tm-notion-h3 tm-notion-editable tm-notion-editable--readonly @_alignClass @_bgClass"
                contenteditable="false"
                data-bg="@NotionColorTokens.Name(Content?.BackgroundColor)"
                data-color="@NotionColorTokens.Name(Content?.TextColor)">
                @((MarkupString)NotionHtmlSanitizer.SanitizeBlockContent(Content?.Html))
            </h3>
        }
        else
        {
            <h3 @key="ReadOnly"
                class="tm-notion-h3 tm-notion-editable @_alignClass @_bgClass"
                contenteditable="true"
                data-placeholder="@Loc["TmNotionHeadingBlock_Placeholder"]"
                data-bg="@NotionColorTokens.Name(Content?.BackgroundColor)"
                data-color="@NotionColorTokens.Name(Content?.TextColor)"
                spellcheck="true"
                @ref="_editableRef"
                @oninput="() => _dirty = true"
                @onblur="OnBlurAsync"
                @onfocus="HandleFocusAsync">
            </h3>
        }
    }

</div>
