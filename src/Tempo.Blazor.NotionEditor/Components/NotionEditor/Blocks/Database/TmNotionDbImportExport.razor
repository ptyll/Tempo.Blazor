@namespace Tempo.Blazor.Components.NotionEditor.Blocks.Database
@using Tempo.Blazor.NotionEditor.Enums
@using Tempo.Blazor.NotionEditor.Interfaces
@using Tempo.Blazor.NotionEditor.Models
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Feedback

@* Phase 4 (DB-3): import/export rides the core TmModal — visible title, ×, Escape, focus return,
   fixed footer with the primary action (mobile renders the mapping rows as cards under 600 px).
   No own overlay. *@
<TmModal Show="Show"
         OnClose="CloseAsync"
         Title="@Loc["TmNotionDbImportExport_Title"]"
         Subtitle="@(string.IsNullOrEmpty(DatabaseName) ? null : DatabaseName)"
         Size="ModalSize.Large"
         MobilePresentation="MobilePresentation.Auto">
    <ChildContent>
        <div class="tm-dbie">

        @* ── Tabs ──────────────────────────────────────────────────────── *@
        <div class="tm-dbie__tabs" role="tablist">
            @if (!ReadOnly)
            {
                <button class="tm-dbie__tab @(_tab == ActiveTab.Import ? "tm-dbie__tab--active" : "")"
                        role="tab"
                        aria-selected="@(_tab == ActiveTab.Import)"
                        type="button"
                        @onclick="() => SetTab(ActiveTab.Import)">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        <polyline points="17 8 12 3 7 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <line x1="12" y1="3" x2="12" y2="15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                    @Loc["TmNotionDbImportExport_TabImport"]
                </button>
            }
            <button class="tm-dbie__tab @(_tab == ActiveTab.Export ? "tm-dbie__tab--active" : "")"
                    role="tab"
                    aria-selected="@(_tab == ActiveTab.Export)"
                    type="button"
                    @onclick="() => SetTab(ActiveTab.Export)">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <polyline points="7 10 12 15 17 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <line x1="12" y1="15" x2="12" y2="3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                @Loc["TmNotionDbImportExport_TabExport"]
            </button>
        </div>

        @* ── Body ──────────────────────────────────────────────────────── *@
        <div class="tm-dbie__body">

            @if (_tab == ActiveTab.Import)
            {
                @if (_importStep == ImportStep.Upload)
                {
                    @* ── Step 1: Upload ──────────────────────────── *@
                    <div class="tm-dbie__upload-zone">
                        <InputFile OnChange="HandleFileSelectedAsync"
                                   accept=".csv"
                                   class="tm-dbie__file-input"
                                   id="@FileInputId"
                                   disabled="@_importLoading" />
                        <label for="@FileInputId" class="tm-dbie__drop-label">
                            @if (_importLoading)
                            {
                                <span class="tm-dbie__spinner" aria-hidden="true"></span>
                                <span>@Loc["Tm_Loading"]</span>
                            }
                            else
                            {
                                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="tm-dbie__upload-icon">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                    <polyline points="17 8 12 3 7 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    <line x1="12" y1="3" x2="12" y2="15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                </svg>
                                <span class="tm-dbie__drop-text">@Loc["TmNotionDbImportExport_DropZone"]</span>
                                <span class="tm-dbie__choose-file">@Loc["TmNotionDbImportExport_ChooseFile"]</span>
                                <span class="tm-dbie__drop-hint">@Loc["TmNotionDbImportExport_DropZoneHint"]</span>
                            }
                        </label>
                    </div>

                    @if (_importError is not null)
                    {
                        <div class="tm-dbie__error" role="alert">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                                <path d="M12 8v4M12 16h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                            @_importError
                        </div>
                    }
                }
                else
                {
                    @* ── Step 2: Map columns ─────────────────────── *@
                    <div class="tm-dbie__map-header">
                        <button class="tm-dbie__back-btn" type="button" @onclick="BackToUpload">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M19 12H5M12 19l-7-7 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            @Loc["TmNotionDbImportExport_Back"]
                        </button>
                        <span class="tm-dbie__filename">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="1.5"/>
                                <polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                            </svg>
                            @_selectedFileName
                        </span>
                        <span class="tm-dbie__row-count">
                            @string.Format(Loc["TmNotionDbImportExport_RowsToImport"], _csvDataRows)
                        </span>
                    </div>

                    <div class="tm-dbie__map-wrap">
                        <table class="tm-dbie__map-table">
                            <thead>
                                <tr>
                                    <th>@Loc["TmNotionDbImportExport_CsvColumn"]</th>
                                    <th>@Loc["TmNotionDbImportExport_MapsTo"]</th>
                                    <th>@Loc["TmNotionDbImportExport_Preview"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < _csvHeaders.Length; i++)
                                {
                                    var colIdx     = i;
                                    var header     = _csvHeaders[i];
                                    var previewVal = colIdx < _csvPreview.Length ? _csvPreview[colIdx] : string.Empty;
                                    var mappedId   = _columnMapping.GetValueOrDefault(colIdx);

                                    <tr class="@(mappedId.HasValue ? "" : "tm-dbie__map-row--skipped")">
                                        <td class="tm-dbie__map-col-name">@header</td>
                                        <td class="tm-dbie__map-field">
                                            <select class="tm-dbie__map-select"
                                                    value="@(mappedId?.ToString() ?? string.Empty)"
                                                    @onchange="e => _columnMapping[colIdx] = e.Value is string s && s.Length > 0 && Guid.TryParse(s, out var g) ? g : (Guid?)null">
                                                <option value="">— @Loc["TmNotionDbImportExport_Skip"] —</option>
                                                @foreach (var field in Fields)
                                                {
                                                    <option value="@field.Id">@field.Name</option>
                                                }
                                            </select>
                                        </td>
                                        <td class="tm-dbie__map-preview" title="@previewVal">@previewVal</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (_importError is not null)
                    {
                        <div class="tm-dbie__error" role="alert">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                                <path d="M12 8v4M12 16h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                            @_importError
                        </div>
                    }
                }
            }
            else
            {
                @* ── Export tab ─────────────────────────────────────── *@
                <div class="tm-dbie__export-body">

                    <p class="tm-dbie__export-label">@Loc["TmNotionDbImportExport_ExportView"]</p>

                    <div class="tm-dbie__export-options">
                        <label class="tm-dbie__export-opt @(_exportViewId is null ? "tm-dbie__export-opt--active" : "")">
                            <input type="radio" name="@ExportViewName" @onchange="() => _exportViewId = null" checked="@(_exportViewId is null)" />
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M3 9h18M3 15h18M9 3v18M15 3v18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                            @Loc["TmNotionDbImportExport_ExportAll"]
                        </label>

                        @foreach (var view in Views)
                        {
                            var v = view;
                            <label class="tm-dbie__export-opt @(_exportViewId == v.Id ? "tm-dbie__export-opt--active" : "")">
                                <input type="radio" name="@ExportViewName" @onchange="() => _exportViewId = v.Id" checked="@(_exportViewId == v.Id)" />
                                <span class="tm-dbie__view-icon" aria-hidden="true">@ViewIcon(v.Type)</span>
                                @v.Name
                            </label>
                        }
                    </div>

                    @if (_exportError is not null)
                    {
                        <div class="tm-dbie__error" role="alert">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                                <path d="M12 8v4M12 16h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                            @_exportError
                        </div>
                    }

                </div>
            }

        </div>
        </div>
    </ChildContent>
    <Footer>
        <div class="tm-dbie__footer">
            @if (_tab == ActiveTab.Import && _importStep == ImportStep.MapColumns)
            {
                <TmButton Variant="ButtonVariant.Ghost" OnClick="BackToUpload">@Loc["TmNotionDbImportExport_Back"]</TmButton>
            }
            <div class="tm-dbie__footer-main">
                <TmButton Variant="ButtonVariant.Ghost" OnClick="CloseAsync">@Loc["TmNotionDbImportExport_Close"]</TmButton>
                @if (_tab == ActiveTab.Import && _importStep == ImportStep.MapColumns)
                {
                    <TmButton Variant="ButtonVariant.Primary"
                              Disabled="@(_importLoading || !_columnMapping.Any(kv => kv.Value.HasValue))"
                              OnClick="HandleImportAsync">
                        @Loc["TmNotionDbImportExport_ImportBtn"]
                    </TmButton>
                }
                else if (_tab == ActiveTab.Export)
                {
                    <TmButton Variant="ButtonVariant.Primary"
                              Disabled="@_exportLoading"
                              OnClick="HandleExportAsync">
                        @Loc["TmNotionDbImportExport_ExportBtn"]
                    </TmButton>
                }
            </div>
        </div>
    </Footer>
</TmModal>

@code {
    private static MarkupString ViewIcon(DatabaseViewType type) => (MarkupString)(type switch
    {
        DatabaseViewType.Board    => "<svg width='13' height='13' viewBox='0 0 24 24' fill='none'><rect x='2' y='3' width='6' height='18' rx='1' stroke='currentColor' stroke-width='1.5'/><rect x='9' y='3' width='6' height='12' rx='1' stroke='currentColor' stroke-width='1.5'/><rect x='16' y='3' width='6' height='15' rx='1' stroke='currentColor' stroke-width='1.5'/></svg>",
        DatabaseViewType.Gallery  => "<svg width='13' height='13' viewBox='0 0 24 24' fill='none'><rect x='2' y='2' width='9' height='9' rx='1' stroke='currentColor' stroke-width='1.5'/><rect x='13' y='2' width='9' height='9' rx='1' stroke='currentColor' stroke-width='1.5'/><rect x='2' y='13' width='9' height='9' rx='1' stroke='currentColor' stroke-width='1.5'/><rect x='13' y='13' width='9' height='9' rx='1' stroke='currentColor' stroke-width='1.5'/></svg>",
        DatabaseViewType.Calendar => "<svg width='13' height='13' viewBox='0 0 24 24' fill='none'><rect x='3' y='4' width='18' height='17' rx='2' stroke='currentColor' stroke-width='1.5'/><path d='M16 2v4M8 2v4M3 10h18' stroke='currentColor' stroke-width='1.5' stroke-linecap='round'/></svg>",
        DatabaseViewType.Timeline => "<svg width='13' height='13' viewBox='0 0 24 24' fill='none'><path d='M3 6h18M3 12h14M3 18h10' stroke='currentColor' stroke-width='1.5' stroke-linecap='round'/></svg>",
        DatabaseViewType.List     => "<svg width='13' height='13' viewBox='0 0 24 24' fill='none'><path d='M8 6h13M8 12h13M8 18h13' stroke='currentColor' stroke-width='1.5' stroke-linecap='round'/><circle cx='4' cy='6' r='1.5' fill='currentColor'/><circle cx='4' cy='12' r='1.5' fill='currentColor'/><circle cx='4' cy='18' r='1.5' fill='currentColor'/></svg>",
        _                         => "<svg width='13' height='13' viewBox='0 0 24 24' fill='none'><path d='M3 10h18M3 14h18M10 3v18M14 3v18' stroke='currentColor' stroke-width='1.5' stroke-linecap='round'/></svg>",
    });
}
