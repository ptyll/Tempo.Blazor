@namespace Tempo.Blazor.Components.NotionEditor.Blocks.Database.Cells
@inherits TmNotionDbCellBase
@using Tempo.Blazor.NotionEditor.Models

<div class="tm-dbc @(ReadOnly ? "tm-dbc--readonly" : "")"
     style="justify-content:center"
     @onclick="ToggleAsync"
     aria-label="@(IsChecked ? Loc["TmNotionDatabaseBlock_CheckedYes"] : Loc["TmNotionDatabaseBlock_CheckedNo"])"
     role="@(!ReadOnly ? "checkbox" : null)"
     aria-checked="@AriaChecked">

    <span class="tm-dbc__checkbox">
        @if (IsChecked)
        {
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="4" fill="var(--tm-color-primary)"/>
                <path d="M7 12l4 4 6-6" stroke="var(--tm-color-on-primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        }
        else
        {
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="4" stroke="var(--tm-border-color)" stroke-width="1.5"/>
            </svg>
        }
    </span>
</div>
