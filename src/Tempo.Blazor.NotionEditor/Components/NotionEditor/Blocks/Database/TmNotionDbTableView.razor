@namespace Tempo.Blazor.Components.NotionEditor.Blocks.Database
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Localization
@using Tempo.Blazor.NotionEditor.Enums
@using Tempo.Blazor.NotionEditor.Models
@using Tempo.Blazor.NotionEditor.Interfaces
@using Tempo.Blazor.Components.NotionEditor.Blocks.Database.Cells
@using Tempo.Blazor.Components.Dropdowns

<div class="tm-dbt-wrap @RowHeightClass @(WrapCells ? "tm-dbt--wrap" : "")"
     @ref="_tableRef">
    <span id="@ResizeHintId" class="tm-dbt__resize-hint">@Loc["TmNotionDbTableView_ResizeColumnHint"]</span>

    <div class="tm-dbt-scroll">
        <table class="tm-dbt" role="grid" aria-label="@Loc["TmNotionDatabaseBlock_ViewTable"]">
            <thead>
                <tr class="tm-dbt__head-row">

                    @* Checkbox select-all *@
                    <th class="tm-dbt__th tm-dbt__th--check" scope="col">
                        <input class="tm-dbt__check"
                               type="checkbox"
                               checked="@AllSelected"
                               title="@Loc["TmNotionDbTableView_SelectAllRows"]"
                               aria-label="@Loc["TmNotionDbTableView_SelectAllRows"]"
                               @onchange="ToggleSelectAll" />
                    </th>

                    @* Field columns *@
                    @{ var fieldIdx = 0; }
                    @foreach (var field in VisibleFields)
                    {
                        var fi        = fieldIdx++;
                        var width     = GetColumnWidth(field);
                        var isDragOver = _dragOverFieldIndex == fi && _dragFromFieldIndex >= 0 && _dragFromFieldIndex != fi;
                        <th class="tm-dbt__th @(field.IsPrimary ? "tm-dbt__th--primary" : "") @(isDragOver ? "tm-dbt__th--dragover" : "")"
                            scope="col"
                            style="min-width:@(width)px; width:@(width)px"
                            draggable="@(!ReadOnly)"
                            @ondragstart="e => OnHeaderDragStart(e, fi)"
                            @ondragover:preventDefault="true"
                            @ondragover="() => OnDragOver(fi)"
                            @ondrop="() => OnDropAsync(fi)">
                            <span class="tm-dbt__th-inner"
                                  role="@(OnFieldEdit.HasDelegate ? "button" : null)"
                                  @onclick="() => OnFieldEdit.InvokeAsync(field)">
                                <span class="tm-dbt__th-icon" aria-hidden="true">@FieldTypeIcon(field.Type)</span>
                                <span class="tm-dbt__th-name">@field.Name</span>
                            </span>
                            @if (!ReadOnly)
                            {
                                <span class="tm-dbt__resize-handle"
                                      data-resize-field="@field.Id"
                                      draggable="false"
                                      tabindex="0"
                                      role="separator"
                                      aria-orientation="vertical"
                                      aria-valuemin="60"
                                      aria-valuemax="800"
                                      aria-valuenow="@width"
                                      aria-keyshortcuts="Alt+ArrowLeft Alt+ArrowRight"
                                      aria-describedby="@ResizeHintId"
                                      aria-label="@Loc["TmNotionDbTableView_ResizeColumn", field.Name]"
                                      title="@Loc["TmNotionDbTableView_ResizeColumnHint"]"
                                      @ondragstart:preventDefault="true"></span>
                            }
                        </th>
                    }

                    @* Add field *@
                    @if (!ReadOnly)
                    {
                        <th class="tm-dbt__th tm-dbt__th--add" scope="col">
                            <button class="tm-dbt__add-field-btn"
                                    type="button"
                                    title="@Loc["TmNotionDatabaseBlock_AddField"]"
                                    aria-label="@Loc["TmNotionDatabaseBlock_AddField"]"
                                    @onclick="OnNewField">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                </svg>
                            </button>
                        </th>
                    }
                </tr>
            </thead>

            <tbody>
                @if (Records.Count == 0)
                {
                    <tr>
                        <td class="tm-dbt__empty" colspan="@(VisibleFields.Count() + 1 + (!ReadOnly ? 1 : 0))">
                            @Loc["TmNotionDatabaseBlock_NoRecords"]
                        </td>
                    </tr>
                }
                else
                {
                    var colCount = VisibleFields.Count() + 1 + (!ReadOnly ? 1 : 0);

                    @foreach (var group in GetGroups())
                    {
                        var g           = group;
                        var isCollapsed = IsGroupCollapsed(g.Key);

                        @* ── Group separator row ── *@
                        @if (GroupByField is not null)
                        {
                            <tr class="tm-dbt__group-row">
                                <td class="tm-dbt__group-sep" colspan="@colCount">
                                    <div class="tm-dbt__group-sep-inner">
                                        <button class="tm-dbt__group-toggle"
                                                type="button"
                                                aria-expanded="@(!isCollapsed)"
                                                aria-label="@(isCollapsed ? Loc["TmNotionDbTableView_GroupExpand"] : Loc["TmNotionDbTableView_GroupCollapse"])"
                                                @onclick="() => ToggleGroup(g.Key)">
                                            <svg class="tm-dbt__group-chevron @(isCollapsed ? "tm-dbt__group-chevron--collapsed" : "")"
                                                 width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </button>

                                        @if (GroupByField is not null && g.Key != "__empty__" && IsOptionLikeField(GroupByField.Type))
                                        {
                                            <span class="tm-dbt__group-chip">@g.Label</span>
                                        }
                                        else
                                        {
                                            <span class="tm-dbt__group-label">@(g.Label ?? Loc["TmNotionDbTableView_GroupNoValue"])</span>
                                        }

                                        <span class="tm-dbt__group-count">@g.Records.Count</span>
                                    </div>
                                </td>
                            </tr>
                        }

                        @* ── Records in group ── *@
                        @if (!isCollapsed)
                        {
                            @foreach (var record in FilterRecordsForGroup(g.Records))
                            {
                                var isSelected = IsSelected(record.Id);
                                var hasKids    = ShowSubItems && HasChildren(record.Id);
                                var isExpanded = ShowSubItems && IsRecordExpanded(record.Id);

                                @* ── Parent row ── *@
                                <tr class="tm-dbt__row @(isSelected ? "tm-dbt__row--selected" : "")">

                                    @* Row checkbox and the non-drag delete (the row has no context menu) *@
                                    <td class="tm-dbt__cell tm-dbt__cell--check">
                                        <input class="tm-dbt__check"
                                               type="checkbox"
                                               checked="@isSelected"
                                               title="@Loc["TmNotionDbTableView_SelectRow"]"
                                               aria-label="@Loc["TmNotionDbTableView_SelectRow"]"
                                               @onchange="() => ToggleSelectRow(record.Id)"
                                               @onclick:stopPropagation="true" />
                                        @if (!ReadOnly && OnRecordDeleted.HasDelegate)
                                        {
                                            <span class="tm-dbt__row-menu" @onclick:stopPropagation="true">
                                                <TmDropdown Class="tm-dbt__row-delete"
                                                            Icon="@IconNames.MoreHorizontal"
                                                            ShowChevron="false"
                                                            Text=""
                                                            AriaLabel="@Loc["Tm_More"]"
                                                            data-testid="@TestId("notion-db-table-row-delete")"
                                                            OnSelect="v => OnRowMenuAsync(record, v)">
                                                    <TmDropdownItem Value="delete" Icon="@IconNames.Trash">
                                                        @Loc["TmNotionDbRecordDetail_Delete"]
                                                    </TmDropdownItem>
                                                </TmDropdown>
                                            </span>
                                        }
                                    </td>

                                    @* Data cells *@
                                    @foreach (var field in VisibleFields)
                                    {
                                        var isEditing = IsEditing(record.Id, field.Id);
                                        var cellRec   = record;
                                        var cellField = field;
                                        var cellValue = record.Fields.TryGetValue(field.Id.ToString(), out var cv) ? cv : null;
                                        var isReadOnlyField = field.Type is
                                            DatabaseFieldType.Formula or
                                            DatabaseFieldType.Rollup or
                                            DatabaseFieldType.CreatedTime or
                                            DatabaseFieldType.LastEditedTime or
                                            DatabaseFieldType.CreatedBy or
                                            DatabaseFieldType.LastEditedBy;

                                        <td class="tm-dbt__cell @(field.IsPrimary ? "tm-dbt__cell--primary" : "") @(isEditing ? "tm-dbt__cell--editing" : "") @(isReadOnlyField || ReadOnly ? "tm-dbt__cell--readonly" : "")"
                                            style="padding:0">
                                            @if (ShowSubItems && field.IsPrimary)
                                            {
                                                <span class="tm-dbt__expand-wrap">
                                                    @if (hasKids)
                                                    {
                                                        <button class="tm-dbt__expand-btn"
                                                                type="button"
                                                                aria-expanded="@isExpanded"
                                                                aria-label="@(isExpanded ? Loc["TmNotionDbTableView_CollapseRow"] : Loc["TmNotionDbTableView_ExpandRow"])"
                                                                @onclick="() => ToggleExpandRecord(cellRec)"
                                                                @onclick:stopPropagation="true">
                                                            <svg class="tm-dbt__expand-chevron @(isExpanded ? "tm-dbt__expand-chevron--open" : "")"
                                                                 width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                                <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                                            </svg>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span class="tm-dbt__expand-spacer" aria-hidden="true"></span>
                                                    }
                                                </span>
                                            }
                                            <TmNotionDbCell Field="@cellField"
                                                            Value="@cellValue"
                                                            ReadOnly="@(ReadOnly || isReadOnlyField)"
                                                            IsEditing="@isEditing"
                                                            OnCommit="v => HandleCellCommitAsync(cellRec, cellField, v)"
                                                            OnCancel="CancelEdit"
                                                            OnEditRequested="() => StartEdit(cellRec, cellField)" />
                                        </td>
                                    }

                                    @if (!ReadOnly)
                                    {
                                        <td class="tm-dbt__cell tm-dbt__cell--spacer"
                                            @onclick="() => OnRecordClicked.InvokeAsync(record)"></td>
                                    }
                                </tr>

                                @* ── Sub-item rows (one level deep) ── *@
                                @if (ShowSubItems && isExpanded)
                                {
                                    @foreach (var child in GetDirectChildren(record.Id))
                                    {
                                        var childSelected = IsSelected(child.Id);
                                        <tr class="tm-dbt__row tm-dbt__row--sub @(childSelected ? "tm-dbt__row--selected" : "")">

                                            <td class="tm-dbt__cell tm-dbt__cell--check">
                                                <input class="tm-dbt__check"
                                                       type="checkbox"
                                                       checked="@childSelected"
                                                       title="@Loc["TmNotionDbTableView_SelectRow"]"
                                                       @onchange="() => ToggleSelectRow(child.Id)"
                                                       @onclick:stopPropagation="true" />
                                            </td>

                                            @foreach (var field in VisibleFields)
                                            {
                                                var isEditing  = IsEditing(child.Id, field.Id);
                                                var childRec   = child;
                                                var childField = field;
                                                var childValue = child.Fields.TryGetValue(field.Id.ToString(), out var ccv) ? ccv : null;
                                                var isRoField  = field.Type is
                                                    DatabaseFieldType.Formula or
                                                    DatabaseFieldType.Rollup or
                                                    DatabaseFieldType.CreatedTime or
                                                    DatabaseFieldType.LastEditedTime or
                                                    DatabaseFieldType.CreatedBy or
                                                    DatabaseFieldType.LastEditedBy;

                                                <td class="tm-dbt__cell @(field.IsPrimary ? "tm-dbt__cell--primary tm-dbt__cell--sub-primary" : "") @(isEditing ? "tm-dbt__cell--editing" : "") @(isRoField || ReadOnly ? "tm-dbt__cell--readonly" : "")"
                                                    style="padding:0">
                                                    @if (field.IsPrimary)
                                                    {
                                                        <span class="tm-dbt__sub-indent" aria-hidden="true">
                                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                                <path d="M6 4v10h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                            </svg>
                                                        </span>
                                                    }
                                                    <TmNotionDbCell Field="@childField"
                                                                    Value="@childValue"
                                                                    ReadOnly="@(ReadOnly || isRoField)"
                                                                    IsEditing="@isEditing"
                                                                    OnCommit="v => HandleCellCommitAsync(childRec, childField, v)"
                                                                    OnCancel="CancelEdit"
                                                                    OnEditRequested="() => StartEdit(childRec, childField)" />
                                                </td>
                                            }

                                            @if (!ReadOnly)
                                            {
                                                <td class="tm-dbt__cell tm-dbt__cell--spacer"
                                                    @onclick="() => OnRecordClicked.InvokeAsync(child)"></td>
                                            }
                                        </tr>
                                    }
                                }
                            }
                        }
                    }
                }
            </tbody>
        </table>
    </div>

    @* Add row *@
    @if (!ReadOnly)
    {
        <button class="tm-dbt__add-row-btn"
                type="button"
                @onclick="OnNewRecord">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            @Loc["TmNotionDatabaseBlock_AddRecord"]
        </button>
    }

    <div class="tm-dbt__footer" data-testid="@TestId("notion-db-table-footer")">
        @Loc.Plural("TmNotionDbTableView_RecordCount", Records.Count)
    </div>

    <TmDialog Show="@(_pendingDelete is not null)"
              Title="@Loc["TmNotionDbRecordDetail_Delete"]"
              Type="DialogType.Confirm"
              IsDangerous="true"
              Message="@Loc["TmNotionDbRecordDetail_DeleteConfirm"]"
              OkButtonText="@Loc["Tm_Delete"]"
              CancelButtonText="@Loc["Tm_Cancel"]"
              OnResult="ConfirmDeleteRowAsync" />
</div>
