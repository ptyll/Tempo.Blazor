@namespace Tempo.Blazor.Components.NotionEditor.Blocks.Database
@using Tempo.Blazor.NotionEditor.Interfaces
@using Tempo.Blazor.NotionEditor.Models

<div class="tm-dbtm" role="dialog" aria-label="@Loc["TmNotionDbTemplateMenu_Title"]" @ref="_root" @onkeydown="OnKeyDown">

    @* ── Header ───────────────────────────────────────────────────────────── *@
    <div class="tm-dbtm__header">
        <span class="tm-dbtm__title">@Loc["TmNotionDbTemplateMenu_Title"]</span>
        <button class="tm-dbtm__close-btn"
                type="button"
                aria-label="@Loc["TmNotionDbTemplateMenu_Close"]"
                @onclick="OnClose">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
        </button>
    </div>

    @* ── New template button ───────────────────────────────────────────────── *@
    @if (!ReadOnly)
    {
        <button class="tm-dbtm__new-btn" type="button" @onclick="HandleNewTemplateAsync">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            @Loc["TmNotionDbTemplateMenu_NewTemplate"]
        </button>
    }

    @* ── Template list ─────────────────────────────────────────────────────── *@
    @if (_loading)
    {
        <div class="tm-dbtm__loading" aria-busy="true" aria-label="@Loc["Tm_Loading"]">
            @for (var i = 0; i < 3; i++)
            {
                <div class="tm-notion-skeleton tm-notion-skeleton--line" style="width:@(85 - i * 15)%"></div>
            }
        </div>
    }
    else if (_templates.Count == 0)
    {
        <p class="tm-dbtm__empty">@Loc["TmNotionDbTemplateMenu_Empty"]</p>
    }
    else
    {
        <ul class="tm-dbtm__list" role="list">
            @foreach (var tpl in _templates)
            {
                var t            = tpl;
                var isConfirming = _deletingId == t.Id;

                <li class="tm-dbtm__item @(isConfirming ? "tm-dbtm__item--confirming" : "")" @key="t.Id" role="listitem">

                    @* Primary action — create from template *@
                    <button class="tm-dbtm__use-btn"
                            type="button"
                            title="@Loc["TmNotionDbTemplateMenu_UseTemplate"]"
                            @onclick="() => HandleCreateFromTemplateAsync(t)">
                        @if (t.IconEmoji is { Length: > 0 } emoji)
                        {
                            <span class="tm-dbtm__emoji" aria-hidden="true">@emoji</span>
                        }
                        else
                        {
                            <svg class="tm-dbtm__default-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
                                <path d="M7 8h10M7 12h7M7 16h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                        }
                        <span class="tm-dbtm__name">@t.Name</span>
                    </button>

                    @* Per-item actions *@
                    <div class="tm-dbtm__item-actions">
                        @if (isConfirming)
                        {
                            <button class="tm-dbtm__confirm-del-btn" type="button"
                                    @onclick="() => HandleDeleteAsync(t.Id)"
                                    @onclick:stopPropagation="true">
                                @Loc["TmNotionDbTemplateMenu_ConfirmDelete"]
                            </button>
                            <button class="tm-dbtm__cancel-del-btn" type="button"
                                    @onclick="() => _deletingId = null"
                                    @onclick:stopPropagation="true">
                                @Loc["TmNotionDbTemplateMenu_Cancel"]
                            </button>
                        }
                        else if (!ReadOnly)
                        {
                            <button class="tm-dbtm__action-btn" type="button"
                                    title="@Loc["TmNotionDbTemplateMenu_EditTemplate"]"
                                    @onclick="() => OnEditTemplate.InvokeAsync(t)"
                                    @onclick:stopPropagation="true">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                            <button class="tm-dbtm__action-btn tm-dbtm__action-btn--danger" type="button"
                                    title="@Loc["TmNotionDbTemplateMenu_Delete"]"
                                    @onclick="() => _deletingId = t.Id"
                                    @onclick:stopPropagation="true">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <polyline points="3 6 5 6 21 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M19 6l-1 14H6L5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M10 11v6M14 11v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                    <path d="M9 6V4h6v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                        }
                    </div>

                </li>
            }
        </ul>
    }

</div>
