@namespace Tempo.Blazor.Components.NotionEditor.Blocks.Database
@using Tempo.Blazor.NotionEditor.Enums
@using Tempo.Blazor.NotionEditor.Models
@using Tempo.Blazor.NotionEditor.Interfaces

<div class="tm-dbfe" role="dialog" aria-label="@Loc["TmNotionDbFieldEditor_Title"]">

    @* ── Header ──────────────────────────────────────────────────────────── *@
    <div class="tm-dbfe__header">
        <span class="tm-dbfe__title">@Loc["TmNotionDbFieldEditor_Title"]</span>
        <button class="tm-dbfe__close" type="button" @onclick="OnClose" title="@Loc["TmNotionDbFieldEditor_Close"]">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
        </button>
    </div>

    @* ── Name & type ─────────────────────────────────────────────────────── *@
    <div class="tm-dbfe__section">
        <label class="tm-dbfe__label" for="@IdFor("name")">@Loc["TmNotionDbFieldEditor_FieldName"]</label>
        <input class="tm-dbfe__input"
               id="@IdFor("name")"
               type="text"
               value="@_name"
               disabled="@ReadOnly"
               placeholder="@Field.Name"
               @oninput="e => _name = e.Value?.ToString() ?? string.Empty" />
    </div>

    @if (!Field.IsPrimary)
    {
        <div class="tm-dbfe__section">
            <label class="tm-dbfe__label" for="@IdFor("type")">@Loc["TmNotionDbFieldEditor_FieldType"]</label>
            <div class="tm-dbfe__select-wrap">
                <select class="tm-dbfe__select"
                        id="@IdFor("type")"
                        disabled="@ReadOnly"
                        @onchange="OnTypeChanged">
                    @foreach (var t in Enum.GetValues<DatabaseFieldType>())
                    {
                        <option value="@t.ToString()" selected="@(_type == t)">@TypeLabel(t)</option>
                    }
                </select>
            </div>
            @if (_typeChanged)
            {
                <p class="tm-dbfe__warning">@Loc["TmNotionDbFieldEditor_TypeWarning"]</p>
            }
        </div>
    }

    @* ── Type-specific config ─────────────────────────────────────────────── *@

    @if (_type is DatabaseFieldType.Select or DatabaseFieldType.MultiSelect)
    {
        <div class="tm-dbfe__section tm-dbfe__section--options">
            <div class="tm-dbfe__section-hd">
                <span class="tm-dbfe__label">@Loc["TmNotionDbFieldEditor_Options"]</span>
            </div>

            <div class="tm-dbfe__options-list">
                @foreach (var opt in _options)
                {
                    var o = opt;
                    var isDragOver = _dragOver == o && _dragging != o;
                    var isDragging = _dragging == o;
                    <div class="tm-dbfe__opt-row @(isDragOver ? "tm-dbfe__opt-row--drag-over" : "") @(isDragging ? "tm-dbfe__opt-row--dragging" : "")"
                         @key="@o.Id"
                         draggable="@(ReadOnly ? "false" : "true")"
                         @ondragstart="() => StartDrag(o)"
                         @ondragend="_ => EndDrag()"
                         @ondragover:preventDefault="true"
                         @ondragover="_ => SetDragOver(o)"
                         @ondrop="_ => DropOn(o)">
                        <span class="tm-dbfe__opt-drag" aria-hidden="true">
                            <svg width="10" height="14" viewBox="0 0 10 14" fill="none">
                                <circle cx="3" cy="2.5" r="1" fill="currentColor"/>
                                <circle cx="7" cy="2.5" r="1" fill="currentColor"/>
                                <circle cx="3" cy="7"   r="1" fill="currentColor"/>
                                <circle cx="7" cy="7"   r="1" fill="currentColor"/>
                                <circle cx="3" cy="11.5" r="1" fill="currentColor"/>
                                <circle cx="7" cy="11.5" r="1" fill="currentColor"/>
                            </svg>
                        </span>
                        <span class="tm-dbfe__opt-chip tm-dbfe__opt-chip--@o.Color">@o.Name</span>
                        @if (!ReadOnly)
                        {
                            <input class="tm-dbfe__opt-input"
                                   type="text"
                                   value="@o.Name"
                                   @oninput="e => o.Name = e.Value?.ToString() ?? string.Empty" />
                            <div class="tm-dbfe__color-dots">
                                @foreach (var c in SelectColors)
                                {
                                    var cc = c;
                                    <button class="tm-dbfe__color-dot tm-dbfe__color-dot--@cc @(o.Color == cc ? "tm-dbfe__color-dot--active" : "")"
                                            type="button"
                                            title="@cc"
                                            @onclick="() => o.Color = cc"></button>
                                }
                            </div>
                            <button class="tm-dbfe__opt-remove"
                                    type="button"
                                    title="@Loc["TmNotionDbFieldEditor_RemoveOption"]"
                                    @onclick="() => RemoveOption(o)">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                </svg>
                            </button>
                        }
                    </div>
                }
            </div>

            @if (!ReadOnly)
            {
                <button class="tm-dbfe__add-option" type="button" @onclick="AddOption">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                    @Loc["TmNotionDbFieldEditor_AddOption"]
                </button>
            }
        </div>
    }

    @if (_type == DatabaseFieldType.Status)
    {
        <div class="tm-dbfe__section tm-dbfe__section--options">
            <div class="tm-dbfe__section-hd">
                <span class="tm-dbfe__label">@Loc["TmNotionDbFieldEditor_Groups"]</span>
            </div>
            @foreach (var grp in _statusGroups)
            {
                var g = grp;
                <div class="tm-dbfe__status-group">
                    <div class="tm-dbfe__status-group-header">
                        <span class="tm-dbfe__status-dot tm-dbfe__status-dot--@g.Color"></span>
                        <span class="tm-dbfe__status-group-name">@g.Name</span>
                    </div>
                    @foreach (var opt in g.Options)
                    {
                        var o = opt;
                        <div class="tm-dbfe__opt-row" @key="@o.Id">
                            <span class="tm-dbfe__opt-chip tm-dbfe__opt-chip--@o.Color">@o.Name</span>
                            @if (!ReadOnly)
                            {
                                <input class="tm-dbfe__opt-input"
                                       type="text"
                                       value="@o.Name"
                                       @oninput="e => o.Name = e.Value?.ToString() ?? string.Empty" />
                                <button class="tm-dbfe__opt-remove"
                                        type="button"
                                        title="@Loc["TmNotionDbFieldEditor_RemoveOption"]"
                                        @onclick="() => RemoveStatusOption(g, o)">
                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                    </svg>
                                </button>
                            }
                        </div>
                    }
                    @if (!ReadOnly)
                    {
                        <button class="tm-dbfe__add-option tm-dbfe__add-option--indent" type="button" @onclick="() => AddStatusOption(g)">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                            @Loc["TmNotionDbFieldEditor_AddOption"]
                        </button>
                    }
                </div>
            }
        </div>
    }

    @if (_type == DatabaseFieldType.Number)
    {
        <div class="tm-dbfe__section">
            <label class="tm-dbfe__label" for="@IdFor("numfmt")">@Loc["TmNotionDbFieldEditor_NumberFormat"]</label>
            <div class="tm-dbfe__select-wrap">
                <select class="tm-dbfe__select"
                        id="@IdFor("numfmt")"
                        disabled="@ReadOnly"
                        @onchange="e => { if (Enum.TryParse<NumberFormat>(e.Value?.ToString(), out var f)) _numberFormat = f; }">
                    @foreach (var f in Enum.GetValues<NumberFormat>())
                    {
                        <option value="@f.ToString()" selected="@(_numberFormat == f)">@NumberFormatLabel(f)</option>
                    }
                </select>
            </div>
        </div>
    }

    @if (_type == DatabaseFieldType.Formula)
    {
        <div class="tm-dbfe__section">
            <label class="tm-dbfe__label" for="@IdFor("formula")">@Loc["TmNotionDbFieldEditor_Formula"]</label>
            <textarea class="tm-dbfe__textarea"
                      id="@IdFor("formula")"
                      rows="3"
                      disabled="@ReadOnly"
                      placeholder="@Loc["TmNotionDbFieldEditor_FormulaPlaceholder"]"
                      @oninput="e => _formulaExpression = e.Value?.ToString() ?? string.Empty">@_formulaExpression</textarea>
        </div>
    }

    @if (_type == DatabaseFieldType.Relation)
    {
        <div class="tm-dbfe__section">
            <label class="tm-dbfe__label" for="@IdFor("reldb")">@Loc["TmNotionDbFieldEditor_RelationTarget"]</label>
            <input class="tm-dbfe__input"
                   id="@IdFor("reldb")"
                   type="text"
                   disabled="@ReadOnly"
                   placeholder="@Loc["TmNotionDbFieldEditor_RelationTargetPlaceholder"]"
                   value="@_relationTargetDbId"
                   @oninput="e => _relationTargetDbId = e.Value?.ToString() ?? string.Empty" />
        </div>
        <div class="tm-dbfe__section tm-dbfe__section--row">
            <span class="tm-dbfe__label">@Loc["TmNotionDbFieldEditor_Bidirectional"]</span>
            <label class="tm-dbgb__switch">
                <input class="tm-dbgb__switch-input"
                       type="checkbox"
                       checked="@_isBidirectional"
                       disabled="@ReadOnly"
                       @onchange="e => _isBidirectional = (bool)(e.Value ?? false)" />
                <span class="tm-dbgb__switch-track"></span>
            </label>
        </div>
    }

    @if (_type == DatabaseFieldType.Rollup)
    {
        var relFields = RelationFields.ToList();

        <div class="tm-dbfe__section">
            <label class="tm-dbfe__label" for="@IdFor("rollrel")">@Loc["TmNotionDbFieldEditor_RollupRelation"]</label>
            @if (relFields.Count == 0)
            {
                <p class="tm-dbfe__hint">@Loc["TmNotionDbFieldEditor_NoRelationFields"]</p>
            }
            else
            {
                <div class="tm-dbfe__select-wrap">
                    <select class="tm-dbfe__select"
                            id="@IdFor("rollrel")"
                            disabled="@ReadOnly"
                            @onchange="SetRollupRelationField">
                        <option value="">@Loc["TmNotionDbFieldEditor_SelectField"]</option>
                        @foreach (var f in relFields)
                        {
                            <option value="@f.Id.ToString()" selected="@(_rollupRelationFieldId == f.Id)">@f.Name</option>
                        }
                    </select>
                </div>
            }
        </div>

        @if (RollupRelationField?.Config is IRelationFieldConfig relConf)
        {
            <div class="tm-dbfe__section">
                <label class="tm-dbfe__label" for="@IdFor("rollprop")">@Loc["TmNotionDbFieldEditor_RollupProperty"]</label>
                <div class="tm-dbfe__select-wrap">
                    <select class="tm-dbfe__select"
                            id="@IdFor("rollprop")"
                            disabled="@ReadOnly"
                            @onchange="SetRollupTargetField">
                        <option value="">@Loc["TmNotionDbFieldEditor_SelectField"]</option>
                        @foreach (var f in Fields.Where(f => f.Id != Field.Id))
                        {
                            <option value="@f.Id.ToString()" selected="@(_rollupTargetFieldId == f.Id)">@f.Name</option>
                        }
                    </select>
                </div>
            </div>
        }

        <div class="tm-dbfe__section">
            <label class="tm-dbfe__label" for="@IdFor("rollagg")">@Loc["TmNotionDbFieldEditor_RollupAggregate"]</label>
            <div class="tm-dbfe__select-wrap">
                <select class="tm-dbfe__select"
                        id="@IdFor("rollagg")"
                        disabled="@ReadOnly"
                        @onchange="e => { if (Enum.TryParse<RollupAggregation>(e.Value?.ToString(), out var a)) _rollupAggregation = a; }">
                    @foreach (var a in Enum.GetValues<RollupAggregation>())
                    {
                        <option value="@a.ToString()" selected="@(_rollupAggregation == a)">@AggregationLabel(a)</option>
                    }
                </select>
            </div>
        </div>
    }

    @if (_type is DatabaseFieldType.Date or DatabaseFieldType.DateRange)
    {
        <div class="tm-dbfe__section">
            <label class="tm-dbfe__label" for="@IdFor("datefmt")">@Loc["TmNotionDbFieldEditor_DateFormat"]</label>
            <div class="tm-dbfe__select-wrap">
                <select class="tm-dbfe__select"
                        id="@IdFor("datefmt")"
                        disabled="@ReadOnly"
                        @onchange="e => _dateFormat = e.Value?.ToString() ?? _dateFormat">
                    <option value="MMMM D, YYYY"  selected="@(_dateFormat == "MMMM D, YYYY")">@Loc["TmNotionDbFieldEditor_DF_Full"]</option>
                    <option value="MMM D, YYYY"   selected="@(_dateFormat == "MMM D, YYYY")">@Loc["TmNotionDbFieldEditor_DF_Short"]</option>
                    <option value="YYYY-MM-DD"    selected="@(_dateFormat == "YYYY-MM-DD")">@Loc["TmNotionDbFieldEditor_DF_ISO"]</option>
                    <option value="MM/DD/YYYY"    selected="@(_dateFormat == "MM/DD/YYYY")">MM/DD/YYYY</option>
                    <option value="DD/MM/YYYY"    selected="@(_dateFormat == "DD/MM/YYYY")">DD/MM/YYYY</option>
                </select>
            </div>
        </div>
        <div class="tm-dbfe__section tm-dbfe__section--row">
            <span class="tm-dbfe__label">@Loc["TmNotionDbFieldEditor_IncludeTime"]</span>
            <label class="tm-dbgb__switch">
                <input class="tm-dbgb__switch-input"
                       type="checkbox"
                       checked="@_includeTime"
                       disabled="@ReadOnly"
                       @onchange="e => _includeTime = (bool)(e.Value ?? false)" />
                <span class="tm-dbgb__switch-track"></span>
            </label>
        </div>
    }

    @* ── Footer ───────────────────────────────────────────────────────────── *@
    <div class="tm-dbfe__footer">
        @if (!ReadOnly)
        {
            <div class="tm-dbfe__footer-danger">
                <button class="tm-dbfe__btn tm-dbfe__btn--ghost"
                        type="button"
                        title="@Loc["TmNotionDbFieldEditor_Duplicate"]"
                        @onclick="DuplicateAsync">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="9" y="9" width="13" height="13" rx="2" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                    @Loc["TmNotionDbFieldEditor_Duplicate"]
                </button>

                @if (!Field.IsPrimary)
                {
                    <button class="tm-dbfe__btn tm-dbfe__btn--danger"
                            type="button"
                            title="@Loc["TmNotionDbFieldEditor_Delete"]"
                            @onclick="DeleteAsync">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <polyline points="3 6 5 6 21 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            <path d="M19 6l-1 14H6L5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M10 11v6M14 11v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" stroke="currentColor" stroke-width="1.5"/>
                        </svg>
                        @Loc["TmNotionDbFieldEditor_Delete"]
                    </button>
                }
            </div>

            <button class="tm-dbfe__btn tm-dbfe__btn--primary"
                    type="button"
                    @onclick="SaveAsync">
                @Loc["TmNotionDbFieldEditor_Save"]
            </button>
        }
        else
        {
            <button class="tm-dbfe__btn tm-dbfe__btn--primary"
                    type="button"
                    @onclick="OnClose">
                @Loc["TmNotionDbFieldEditor_Close"]
            </button>
        }
    </div>

</div>
