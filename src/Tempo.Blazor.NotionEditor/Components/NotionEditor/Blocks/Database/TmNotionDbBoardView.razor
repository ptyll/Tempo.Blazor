@namespace Tempo.Blazor.Components.NotionEditor.Blocks.Database
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.NotionEditor.Models
@using Tempo.Blazor.NotionEditor.Interfaces
@using Tempo.Blazor.NotionEditor.Enums

<div class="tm-dbb" @ref="_boardRef">

    <div class="tm-dbb__scroll">

        @foreach (var group in _groups)
        {
            var gv      = group.Value;
            var isTarget = _dragOverGroup == gv && _dragRecordId.HasValue;

            <div class="tm-dbb__col @(isTarget ? "tm-dbb__col--target" : "")"
                 data-group-value="@gv"
                 data-testid="@TestId("notion-db-board-group")">

                @* ── Column header ───────────────────────────── *@
                <div class="tm-dbb__col-header">
                    @if (group.Color is not null)
                    {
                        <span class="tm-dbb__col-dot" style="background:@group.Color" aria-hidden="true"></span>
                    }
                    <span class="tm-dbb__col-label">
                        @(group.Label.Length > 0 ? group.Label : Loc["TmNotionDatabaseBlock_Uncategorized"])
                    </span>
                    <span class="tm-dbb__col-count">@group.Records.Count</span>
                    @if (!ReadOnly)
                    {
                        <button class="tm-dbb__col-add"
                                type="button"
                                title="@Loc["TmNotionDbBoardView_AddCard"]"
                                @onclick="() => HandleAddCardAsync(gv)">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </button>
                    }
                </div>

                @* ── Cards ───────────────────────────────────── *@
                <div class="tm-dbb__cards">

                    @foreach (var record in group.Records)
                    {
                        var rec           = record;
                        var isDraggingThis = _dragRecordId == rec.Id;
                        var coverUrl      = GetCoverUrl(rec);

                        <div class="tm-dbb__card @(isDraggingThis ? "tm-dbb__card--dragging" : "")"
                             draggable="@(!ReadOnly ? "true" : "false")"
                             data-testid="@TestId("notion-db-board-card")"
                             data-record-id="@rec.Id"
                             data-from-group="@gv"
                             role="button"
                             tabindex="0"
                             @key="rec.Id"
                             @onclick="() => HandleCardClickAsync(rec)"
                             @onkeydown="e => HandleCardKeyAsync(e, rec)">

                            @if (coverUrl is not null)
                            {
                                <div class="tm-dbb__card-cover">
                                    <img src="@coverUrl" alt="" loading="lazy" />
                                </div>
                            }

                            <div class="tm-dbb__card-body">
                                <span class="tm-dbb__card-title">@GetPrimaryValue(rec)</span>

                                @foreach (var field in _previewFields)
                                {
                                    var val = FormatFieldValue(rec, field);
                                    if (val.Length > 0)
                                    {
                                        <div class="tm-dbb__card-prop">
                                            <span class="tm-dbb__card-prop-icon" aria-hidden="true">@FieldTypeIcon(field.Type)</span>
                                            <span class="tm-dbb__card-prop-val">@val</span>
                                        </div>
                                    }
                                }

                                @{ var subCount = GetSubItemCount(rec); }
                                @if (subCount > 0)
                                {
                                    <div class="tm-dbb__card-subitems" aria-label="@subCount @Loc["TmNotionDbBoardView_SubItems"]">
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                            <path d="M8 6h13M8 12h10M8 18h7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                            <circle cx="4" cy="6"  r="1.5" fill="currentColor"/>
                                            <circle cx="4" cy="12" r="1.5" fill="currentColor"/>
                                            <circle cx="4" cy="18" r="1.5" fill="currentColor"/>
                                        </svg>
                                        <span>@subCount @Loc["TmNotionDbBoardView_SubItems"]</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (group.Records.Count == 0 && isTarget)
                    {
                        <div class="tm-dbb__drop-hint">@Loc["TmNotionDbBoardView_DropHere"]</div>
                    }
                    else if (group.Records.Count == 0)
                    {
                        <p class="tm-dbb__empty" data-testid="@TestId("notion-db-board-empty")">@Loc["TmNotionDbBoardView_EmptyGroup"]</p>
                    }

                </div>
            </div>
        }

    </div>

</div>
