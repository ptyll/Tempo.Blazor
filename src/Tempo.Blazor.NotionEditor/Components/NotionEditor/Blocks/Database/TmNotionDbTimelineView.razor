@namespace Tempo.Blazor.Components.NotionEditor.Blocks.Database
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.NotionEditor.Models
@using Tempo.Blazor.NotionEditor.Interfaces
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Localization
@using Tempo.Blazor.NotionEditor.Enums
@using System.Globalization

<div class="tm-dbtl @(IsMobile ? "tm-dbtl--mobile" : "")"
     data-layout="@(Layout?.CssModifier ?? "desktop")"
     data-px-per-day="@PxPerDay.ToString("F4", CultureInfo.InvariantCulture)"
     data-readonly="@(ReadOnly ? "true" : "false")"
     @ref="_rootRef">

    @* ── Toolbar ─────────────────────────────────────────────────────────── *@
    <div class="tm-dbtl__toolbar">

        <button class="tm-dbtl__tool-btn @(_showTableArea ? "tm-dbtl__tool-btn--active" : "")"
                type="button"
                title="@Loc["TmNotionDbTimelineView_ToggleTable"]"
                @onclick="() => _showTableArea = !_showTableArea">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="2" y="3" width="7" height="18" rx="1" stroke="currentColor" stroke-width="1.5"/>
                <rect x="11" y="3" width="11" height="18" rx="1" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            @Loc["TmNotionDbTimelineView_ToggleTable"]
        </button>

        <div class="tm-dbtl__nav">
            <button class="tm-dbtl__nav-btn"
                    type="button"
                    aria-label="@Loc["TmNotionDbTimelineView_Prev"]"
                    @onclick="PrevPeriod">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="tm-dbtl__nav-label">@Loc["TmNotionDbTimelineView_Prev"]</span>
            </button>

            <button class="tm-dbtl__today-btn" type="button" @onclick="GoToToday">
                @Loc["TmNotionDbTimelineView_Today"]
            </button>

            <button class="tm-dbtl__nav-btn"
                    type="button"
                    aria-label="@Loc["TmNotionDbTimelineView_Next"]"
                    @onclick="NextPeriod">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="tm-dbtl__nav-label">@Loc["TmNotionDbTimelineView_Next"]</span>
            </button>
        </div>

        <div class="tm-dbtl__zoom-group" role="group" aria-label="@Loc["TmNotionDbTimelineView_Zoom"]">
            <button class="tm-dbtl__zoom-btn @(_zoom == TimelineZoom.Day ? "tm-dbtl__zoom-btn--active" : "")"
                    type="button"
                    aria-pressed="@(_zoom == TimelineZoom.Day ? "true" : "false")"
                    @onclick="() => SetZoom(TimelineZoom.Day)">
                @Loc["TmNotionDbTimelineView_ZoomDay"]
            </button>
            <button class="tm-dbtl__zoom-btn @(_zoom == TimelineZoom.Week ? "tm-dbtl__zoom-btn--active" : "")"
                    type="button"
                    aria-pressed="@(_zoom == TimelineZoom.Week ? "true" : "false")"
                    @onclick="() => SetZoom(TimelineZoom.Week)">
                @Loc["TmNotionDbTimelineView_ZoomWeek"]
            </button>
            <button class="tm-dbtl__zoom-btn @(_zoom == TimelineZoom.Month ? "tm-dbtl__zoom-btn--active" : "")"
                    type="button"
                    aria-pressed="@(_zoom == TimelineZoom.Month ? "true" : "false")"
                    @onclick="() => SetZoom(TimelineZoom.Month)">
                @Loc["TmNotionDbTimelineView_ZoomMonth"]
            </button>
        </div>

        @if (!ReadOnly)
        {
            <button class="tm-dbtl__new-btn" type="button" @onclick="() => OnNewRecord.InvokeAsync()">
                @Loc["TmNotionDbTimelineView_NewRecord"]
            </button>
        }

    </div>

    @* ── Body ────────────────────────────────────────────────────────────── *@
    <div class="tm-dbtl__body">

        @{
            var headers     = GetColumnHeaders();
            var sidebarCols = SidebarFields.ToList();
        }

        @* ── Sidebar ─────────────────────────────────────────────────────── *@
        @if (ShowSidebar)
        {
            <div class="tm-dbtl__sidebar">

                <div class="tm-dbtl__sidebar-head">
                    <span class="tm-dbtl__sidebar-title">@Loc["TmNotionDbTimelineView_Name"]</span>
                    @foreach (var sf in sidebarCols)
                    {
                        <span class="tm-dbtl__sidebar-col">@sf.Name</span>
                    }
                </div>

                @foreach (var record in Records)
                {
                    var rec = record;
                    <div class="tm-dbtl__sidebar-row"
                         role="button"
                         tabindex="0"
                         data-testid="@TestId("notion-db-timeline-bar")"
                         @onclick="() => OnRecordClicked.InvokeAsync(rec)"
                         @onkeydown="e => HandleItemKeyAsync(e, rec)">
                        <span class="tm-dbtl__sidebar-name">@NotionDatabaseValueFormatter.PrimaryText(rec, Fields)</span>
                        @foreach (var sf in sidebarCols)
                        {
                            <span class="tm-dbtl__sidebar-val"><TmNotionDbPropertyValue Field="sf" Value="@RawValue(rec, sf)" /></span>
                        }
                    </div>
                }

                @if (!ReadOnly)
                {
                    <button class="tm-dbtl__sidebar-add" type="button" @onclick="() => OnNewRecord.InvokeAsync()">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                        @Loc["TmNotionDbTimelineView_NewRecord"]
                    </button>
                }

            </div>
        }

        @* ── Gantt ────────────────────────────────────────────────────────── *@
        <div class="tm-dbtl__gantt-wrap">
            <div class="tm-dbtl__gantt"
                 style="min-width:@(TotalGanttWidth.ToString("F0", CultureInfo.InvariantCulture))px">

                @* Two header rows: the month spans above the week/day columns. *@
                <div class="tm-dbtl__gantt-head">
                <div class="tm-dbtl__head-months" data-testid="@TestId("notion-db-timeline-months")">
                    @foreach (var (label, span) in MonthHeaderSpans())
                    {
                        <div class="tm-dbtl__month"
                             style="width:@((span * ColWidthPx).ToString("F0", CultureInfo.InvariantCulture))px">
                            @label
                        </div>
                    }
                </div>
                <div class="tm-dbtl__head-weeks">
                    @foreach (var (colStart, label) in headers)
                    {
                        var isTodayCol = _zoom == TimelineZoom.Day && colStart.Date == DateTime.Today;
                        <div class="tm-dbtl__col-header @(isTodayCol ? "tm-dbtl__col-header--today" : "")"
                             style="width:@(ColWidthPx.ToString("F0", CultureInfo.InvariantCulture))px">
                            @label
                        </div>
                    }
                </div>
                </div>

                @* Gantt body *@
                <div class="tm-dbtl__gantt-body">

                    @* Background column stripes *@
                    <div class="tm-dbtl__grid-bg" aria-hidden="true">
                        @foreach (var (colStart, _) in headers)
                        {
                            var isWeekend = _zoom == TimelineZoom.Day &&
                                (colStart.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday);
                            var isTodayCol = _zoom == TimelineZoom.Day && colStart.Date == DateTime.Today;
                            <div class="tm-dbtl__col-stripe @(isTodayCol ? "tm-dbtl__col-stripe--today" : "") @(isWeekend ? "tm-dbtl__col-stripe--weekend" : "")"
                                 style="width:@(ColWidthPx.ToString("F0", CultureInfo.InvariantCulture))px">
                            </div>
                        }
                    </div>

                    @* Today marker *@
                    @if (TodayVisible)
                    {
                        <div class="tm-dbtl__today-line"
                             data-testid="@TestId("notion-db-timeline-today")"
                             style="left:@(TodayPixel.ToString("F1", CultureInfo.InvariantCulture))px">
                            <span class="tm-dbtl__today-label">@Loc["TmNotionDbTimelineView_Today"]</span>
                        </div>
                    }

                    @* Rows *@
                    <div class="tm-dbtl__rows">
                        @if (StartField is null)
                        {
                            <div class="tm-dbtl__no-field">@Loc["TmNotionDbTimelineView_NoStartField"]</div>
                        }
                        else
                        {
                            @foreach (var record in Records)
                            {
                                var rec = record;
                                var (left, width, visible) = GetBarGeometry(rec);
                                var color = GetBarColor(rec);

                                <div class="tm-dbtl__row">
                                    @if (visible)
                                    {
                                        <div class="tm-dbtl__bar"
                                             data-timeline-bar
                                             data-record-id="@rec.Id"
                                             style="left:@(left.ToString("F1", CultureInfo.InvariantCulture))px;width:@(width.ToString("F1", CultureInfo.InvariantCulture))px;--bar-color:@color"
                                             @key="rec.Id"
                                             role="button"
                                             tabindex="0"
                                             data-testid="@TestId("notion-db-timeline-bar")"
                                             aria-keyshortcuts="Alt+ArrowLeft Alt+ArrowRight Alt+Shift+ArrowLeft Alt+Shift+ArrowRight"
                                             title="@NotionDatabaseValueFormatter.PrimaryText(rec, Fields)"
                                             @onclick="() => OnBarClickAsync(rec)"
                                             @onclick:stopPropagation="true"
                                             @onkeydown="e => HandleItemKeyAsync(e, rec)">
                                            <span class="tm-dbtl__bar-label">@NotionDatabaseValueFormatter.PrimaryText(rec, Fields)</span>
                                            @if (!ReadOnly)
                                            {
                                                <div class="tm-dbtl__bar-resize"
                                                     data-timeline-resize
                                                     title="@Loc["TmNotionDbTimelineView_ResizeBar"]"
                                                     aria-label="@Loc["TmNotionDbTimelineView_ResizeBar"]">
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @if (!ReadOnly && Records.Count == 0)
                            {
                                <div class="tm-dbtl__empty-rows">
                                    <button class="tm-dbtl__empty-add" type="button"
                                            @onclick="() => OnNewRecord.InvokeAsync()">
                                        @Loc["TmNotionDbTimelineView_NewRecord"]
                                    </button>
                                </div>
                            }
                        }
                    </div>

                </div>
            </div>
        </div>

    </div>

    <div class="tm-dbtl__footer" data-testid="@TestId("notion-db-timeline-footer")">
        @RecordCountLabel
    </div>

    @* ── Mobile record list (F-10): the sidebar stays tablet+, a phone gets the record list
         under the axis — tap opens the date sheet like a bar tap. ───────────────────────── *@
    @if (IsMobile && Records.Count > 0)
    {
        <div class="tm-dbtl__mobile-list" data-testid="@TestId("notion-db-timeline-mobile-list")">
            @foreach (var record in Records)
            {
                var rec   = record;
                var start = GetDate(rec, StartField);
                <div class="tm-dbtl__mobile-row"
                     role="button"
                     tabindex="0"
                     @onclick="() => OnBarClickAsync(rec)"
                     @onkeydown="e => HandleItemKeyAsync(e, rec)">
                    <span class="tm-dbtl__mobile-row-name">@NotionDatabaseValueFormatter.PrimaryText(rec, Fields)</span>
                    @if (start is not null)
                    {
                        <span class="tm-dbtl__mobile-row-dates">
                            @start.Value.ToString("d", CultureInfo.CurrentCulture) – @((GetDate(rec, EndField) ?? start.Value.AddDays(1)).ToString("d", CultureInfo.CurrentCulture))
                        </span>
                    }
                </div>
            }
        </div>
    }

    @if (IsCoarseSheet && SheetRecord is { } sheet)
    {
        <TmModal Show="true"
                 ShowChanged="open => { if (!open) CloseDateSheet(); }"
                 Title="@NotionDatabaseValueFormatter.PrimaryText(sheet, Fields)"
                 MobilePresentation="MobilePresentation.Sheet"
                 Size="ModalSize.Medium">
            <div class="tm-dbtl__date-sheet" data-testid="@TestId("notion-db-timeline-date-sheet")">
                <label class="tm-dbtl__date-field">
                    <span>@Loc["TmNotionDbTimelineView_Start"]</span>
                    <input type="date" value="@SheetDate(sheet, StartField)"
                           @onchange="e => CommitSheetDateAsync(sheet, end: false, e)" />
                </label>
                <label class="tm-dbtl__date-field">
                    <span>@Loc["TmNotionDbTimelineView_End"]</span>
                    <input type="date" value="@SheetDate(sheet, EndField)"
                           @onchange="e => CommitSheetDateAsync(sheet, end: true, e)" />
                </label>
                <button type="button" class="tm-dbtl__date-open" @onclick="() => OpenSheetRecordAsync(sheet)">
                    @Loc["TmNotionDbTimelineView_OpenRecord"]
                </button>
            </div>
        </TmModal>
    }
</div>
