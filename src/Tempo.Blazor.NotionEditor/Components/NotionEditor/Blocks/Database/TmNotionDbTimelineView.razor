@namespace Tempo.Blazor.Components.NotionEditor.Blocks.Database
@using Tempo.Blazor.NotionEditor.Models
@using Tempo.Blazor.NotionEditor.Interfaces
@using Tempo.Blazor.NotionEditor.Enums
@using System.Globalization

<div class="tm-dbt @(_dragMode != DragMode.None ? "tm-dbt--dragging" : "")">

    @* ── Drag capture overlay ─────────────────────────────────────────────── *@
    @if (_dragMode != DragMode.None)
    {
        <div class="tm-dbt__drag-overlay"
             @onmousemove="HandleMouseMove"
             @onmousemove:preventDefault="true"
             @onmouseup="HandleMouseUpAsync"
             @onmouseleave="CancelDrag">
        </div>
    }

    @* ── Toolbar ─────────────────────────────────────────────────────────── *@
    <div class="tm-dbt__toolbar">

        <button class="tm-dbt__tool-btn @(_showTableArea ? "tm-dbt__tool-btn--active" : "")"
                type="button"
                title="@Loc["TmNotionDbTimelineView_ToggleTable"]"
                @onclick="() => _showTableArea = !_showTableArea">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="2" y="3" width="7" height="18" rx="1" stroke="currentColor" stroke-width="1.5"/>
                <rect x="11" y="3" width="11" height="18" rx="1" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            @Loc["TmNotionDbTimelineView_ToggleTable"]
        </button>

        <div class="tm-dbt__nav">
            <button class="tm-dbt__nav-btn"
                    type="button"
                    title="@Loc["TmNotionDbTimelineView_Prev"]"
                    @onclick="PrevPeriod">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>

            <button class="tm-dbt__today-btn" type="button" @onclick="GoToToday">
                @Loc["TmNotionDbTimelineView_Today"]
            </button>

            <button class="tm-dbt__nav-btn"
                    type="button"
                    title="@Loc["TmNotionDbTimelineView_Next"]"
                    @onclick="NextPeriod">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        </div>

        <div class="tm-dbt__zoom-group" role="group" aria-label="@Loc["TmNotionDbTimelineView_Zoom"]">
            <button class="tm-dbt__zoom-btn @(_zoom == TimelineZoom.Day ? "tm-dbt__zoom-btn--active" : "")"
                    type="button"
                    @onclick="() => SetZoom(TimelineZoom.Day)">
                @Loc["TmNotionDbTimelineView_ZoomDay"]
            </button>
            <button class="tm-dbt__zoom-btn @(_zoom == TimelineZoom.Week ? "tm-dbt__zoom-btn--active" : "")"
                    type="button"
                    @onclick="() => SetZoom(TimelineZoom.Week)">
                @Loc["TmNotionDbTimelineView_ZoomWeek"]
            </button>
            <button class="tm-dbt__zoom-btn @(_zoom == TimelineZoom.Month ? "tm-dbt__zoom-btn--active" : "")"
                    type="button"
                    @onclick="() => SetZoom(TimelineZoom.Month)">
                @Loc["TmNotionDbTimelineView_ZoomMonth"]
            </button>
        </div>

    </div>

    @* ── Body ────────────────────────────────────────────────────────────── *@
    <div class="tm-dbt__body">

        @{
            var headers     = GetColumnHeaders();
            var sidebarCols = SidebarFields.ToList();
        }

        @* ── Sidebar ─────────────────────────────────────────────────────── *@
        @if (_showTableArea)
        {
            <div class="tm-dbt__sidebar">

                <div class="tm-dbt__sidebar-head">
                    <span class="tm-dbt__sidebar-title">@Loc["TmNotionDbTimelineView_Name"]</span>
                    @foreach (var sf in sidebarCols)
                    {
                        <span class="tm-dbt__sidebar-col">@sf.Name</span>
                    }
                </div>

                @foreach (var record in Records)
                {
                    var rec = record;
                    <div class="tm-dbt__sidebar-row"
                         role="button"
                         tabindex="0"
                         data-testid="notion-db-timeline-bar"
                         @onclick="() => OnRecordClicked.InvokeAsync(rec)"
                         @onkeydown="e => HandleItemKeyAsync(e, rec)">
                        <span class="tm-dbt__sidebar-name">@GetPrimaryValue(rec)</span>
                        @foreach (var sf in sidebarCols)
                        {
                            <span class="tm-dbt__sidebar-val">@GetFieldValue(rec, sf)</span>
                        }
                    </div>
                }

                @if (!ReadOnly)
                {
                    <button class="tm-dbt__sidebar-add" type="button" @onclick="() => OnNewRecord.InvokeAsync()">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                        @Loc["TmNotionDbTimelineView_NewRecord"]
                    </button>
                }

            </div>
        }

        @* ── Gantt ────────────────────────────────────────────────────────── *@
        <div class="tm-dbt__gantt-wrap">
            <div class="tm-dbt__gantt"
                 style="min-width:@(TotalGanttWidth.ToString("F0", CultureInfo.InvariantCulture))px">

                @* Column headers — sticky top *@
                <div class="tm-dbt__gantt-head">
                    @foreach (var (colStart, label) in headers)
                    {
                        var isTodayCol = _zoom == TimelineZoom.Day && colStart.Date == DateTime.Today;
                        <div class="tm-dbt__col-header @(isTodayCol ? "tm-dbt__col-header--today" : "")"
                             style="width:@(ColWidthPx.ToString("F0", CultureInfo.InvariantCulture))px">
                            @label
                        </div>
                    }
                </div>

                @* Gantt body *@
                <div class="tm-dbt__gantt-body">

                    @* Background column stripes *@
                    <div class="tm-dbt__grid-bg" aria-hidden="true">
                        @foreach (var (colStart, _) in headers)
                        {
                            var isWeekend = _zoom == TimelineZoom.Day &&
                                (colStart.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday);
                            var isTodayCol = _zoom == TimelineZoom.Day && colStart.Date == DateTime.Today;
                            <div class="tm-dbt__col-stripe @(isTodayCol ? "tm-dbt__col-stripe--today" : "") @(isWeekend ? "tm-dbt__col-stripe--weekend" : "")"
                                 style="width:@(ColWidthPx.ToString("F0", CultureInfo.InvariantCulture))px">
                            </div>
                        }
                    </div>

                    @* Today marker *@
                    @if (TodayVisible)
                    {
                        <div class="tm-dbt__today-line"
                             style="left:@(TodayPixel.ToString("F1", CultureInfo.InvariantCulture))px"
                             aria-hidden="true">
                        </div>
                    }

                    @* Rows *@
                    <div class="tm-dbt__rows">
                        @if (StartField is null)
                        {
                            <div class="tm-dbt__no-field">@Loc["TmNotionDbTimelineView_NoStartField"]</div>
                        }
                        else
                        {
                            @foreach (var record in Records)
                            {
                                var rec = record;
                                var (left, width, visible) = GetBarGeometry(rec);
                                var color      = GetBarColor(rec);
                                var isDragging = _dragId == rec.Id;

                                <div class="tm-dbt__row">
                                    @if (visible)
                                    {
                                        <div class="tm-dbt__bar @(isDragging ? "tm-dbt__bar--dragging" : "")"
                                             style="left:@(left.ToString("F1", CultureInfo.InvariantCulture))px;width:@(width.ToString("F1", CultureInfo.InvariantCulture))px;--bar-color:@color"
                                             @key="rec.Id"
                                             role="button"
                                             tabindex="0"
                                             title="@GetPrimaryValue(rec)"
                                             @onclick="() => OnRecordClicked.InvokeAsync(rec)"
                                             @onclick:stopPropagation="true"
                                             @onmousedown="e => StartMoveBar(e, rec)"
                                             @onmousedown:stopPropagation="true"
                                             @onkeydown="e => HandleItemKeyAsync(e, rec)">
                                            <span class="tm-dbt__bar-label">@GetPrimaryValue(rec)</span>
                                            @if (!ReadOnly)
                                            {
                                                <div class="tm-dbt__bar-resize"
                                                     title="@Loc["TmNotionDbTimelineView_ResizeBar"]"
                                                     @onmousedown="e => StartResizeBar(e, rec)"
                                                     @onmousedown:stopPropagation="true"
                                                     @onclick:stopPropagation="true">
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @if (!ReadOnly && Records.Count == 0)
                            {
                                <div class="tm-dbt__empty-rows">
                                    <button class="tm-dbt__empty-add" type="button"
                                            @onclick="() => OnNewRecord.InvokeAsync()">
                                        @Loc["TmNotionDbTimelineView_NewRecord"]
                                    </button>
                                </div>
                            }
                        }
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>
