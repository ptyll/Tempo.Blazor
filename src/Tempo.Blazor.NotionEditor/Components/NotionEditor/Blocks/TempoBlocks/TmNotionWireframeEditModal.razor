@namespace Tempo.Blazor.Components.NotionEditor.Blocks.TempoBlocks
@using Tempo.Blazor.Components.Wireframe.Models

<TmNotionTempoEditorModal Title="@Loc["TmNotionWireframeEditModal_Title"]"
                          Loading="_loading"
                          Saving="_saving"
                          Missing="@(_document is null || WireframeEditorComponentType is null)"
                          MissingText="@Loc["TmNotionWireframeEditModal_MissingPackage"]"
                          IsDirty="_dirty"
                          DiscardText="@Loc["TmNotionWireframeEditModal_Discard"]"
                          SaveText="@Loc["TmNotionWireframeEditModal_Save"]"
                          ConfirmTitle="@Loc["TmNotionTempoEditorModal_DiscardTitle"]"
                          ConfirmMessage="@Loc["TmNotionTempoEditorModal_DiscardMessage"]"
                          ConfirmOkText="@Loc["TmNotionTempoEditorModal_DiscardConfirm"]"
                          ConfirmCancelText="@Loc["Tm_Cancel"]"
                          StatusClass="tm-notion-wireframe-edit-modal__loading"
                          DiscardClass="tm-notion-wireframe-edit-modal__btn"
                          SaveClass="tm-notion-wireframe-edit-modal__btn tm-notion-wireframe-edit-modal__btn--primary"
                          Class="tm-notion-wireframe-edit-modal"
                          TestId="notion-wireframe-edit-modal"
                          OnSave="SaveAsync"
                          OnDiscard="DiscardAsync">
    <DynamicComponent @ref="_editorRef"
                      Type="WireframeEditorComponentType"
                      Parameters="WireframeEditorParameters" />
</TmNotionTempoEditorModal>
