@namespace Tempo.Blazor.Components.NotionEditor.Blocks.TempoBlocks
@using Tempo.Blazor.Components.Diagram.Models
@using Tempo.Blazor.Components.Diagram.Services

<TmNotionTempoEditorModal Title="@Loc["TmNotionDiagramEditModal_Title"]"
                          Loading="_loading"
                          Saving="_saving"
                          Missing="@(_document is null || DiagramEditorComponentType is null)"
                          MissingText="@Loc["TmNotionDiagramEditModal_MissingPackage"]"
                          IsDirty="_dirty"
                          DiscardText="@Loc["TmNotionDiagramEditModal_Discard"]"
                          SaveText="@Loc["TmNotionDiagramEditModal_Save"]"
                          ConfirmTitle="@Loc["TmNotionTempoEditorModal_DiscardTitle"]"
                          ConfirmMessage="@Loc["TmNotionTempoEditorModal_DiscardMessage"]"
                          ConfirmOkText="@Loc["TmNotionTempoEditorModal_DiscardConfirm"]"
                          ConfirmCancelText="@Loc["Tm_Cancel"]"
                          StatusClass="tm-notion-diagram-edit-modal__loading"
                          DiscardClass="tm-notion-diagram-edit-modal__btn"
                          SaveClass="tm-notion-diagram-edit-modal__btn tm-notion-diagram-edit-modal__btn--primary"
                          Class="tm-notion-diagram-edit-modal"
                          TestId="notion-diagram-edit-modal"
                          OnSave="SaveAsync"
                          OnDiscard="DiscardAsync">
    <DynamicComponent Type="DiagramEditorComponentType" Parameters="DiagramEditorParameters" />
</TmNotionTempoEditorModal>
