@namespace Tempo.Blazor.Components.NotionEditor.Blocks.TempoBlocks

<TmNotionTempoEditorModal Title="@Loc["TmNotionSpreadsheetEditModal_Title"]"
                          Loading="_loading"
                          Saving="_saving"
                          Missing="@(SpreadsheetComponentType is null)"
                          MissingText="@Loc["TmNotionSpreadsheetEditModal_MissingPackage"]"
                          IsDirty="_dirty"
                          DiscardText="@Loc["TmNotionSpreadsheetEditModal_Discard"]"
                          SaveText="@Loc["TmNotionSpreadsheetEditModal_Save"]"
                          ConfirmTitle="@Loc["TmNotionTempoEditorModal_DiscardTitle"]"
                          ConfirmMessage="@Loc["TmNotionTempoEditorModal_DiscardMessage"]"
                          ConfirmOkText="@Loc["TmNotionTempoEditorModal_DiscardConfirm"]"
                          ConfirmCancelText="@Loc["Tm_Cancel"]"
                          StatusClass="tm-notion-spreadsheet-edit-modal__loading"
                          DiscardClass="tm-notion-spreadsheet-edit-modal__btn--discard"
                          SaveClass="tm-notion-spreadsheet-edit-modal__btn--primary"
                          Class="tm-notion-spreadsheet-edit-modal"
                          TestId="notion-spreadsheet-edit-modal"
                          OnSave="SaveAsync"
                          OnDiscard="DiscardAsync">
    <div class="tm-notion-spreadsheet-edit-modal__editor">
        <DynamicComponent @ref="_spreadsheetRef"
                          Type="SpreadsheetComponentType"
                          Parameters="SpreadsheetEditorParameters" />
    </div>
</TmNotionTempoEditorModal>
