@namespace Tempo.Blazor.Components.NotionEditor.Blocks
@using Tempo.Blazor.NotionEditor.Enums
@using Tempo.Blazor.NotionEditor.Interfaces

@* ── Transparent backdrop — captures outside clicks ──────────────────────── *@
<div class="tm-notion-ctx-backdrop" @onclick="CloseAsync" aria-hidden="true"></div>

@* ── Menu panel ───────────────────────────────────────────────────────────── *@
<div class="tm-notion-ctx" role="menu" aria-label="@Loc["TmNotionBlockHandle_OpenMenu"]"
     tabindex="-1"
     @ref="_menuRef"
     @onkeydown="HandleKeyDownAsync"
     @onclick:stopPropagation="true">

    @* Delete *@
    <button class="tm-notion-ctx__item tm-notion-ctx__item--danger"
            type="button" role="menuitem"
            @onclick="HandleDeleteAsync">
        <svg class="tm-notion-ctx__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" stroke="currentColor" stroke-width="1.5"
                  stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        @Loc["TmNotionBlockContextMenu_Delete"]
    </button>

    <div class="tm-notion-ctx__separator"></div>

    @* Duplicate *@
    <button class="tm-notion-ctx__item" type="button" role="menuitem" @onclick="HandleDuplicateAsync">
        <svg class="tm-notion-ctx__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" stroke="currentColor" stroke-width="1.5"/>
            <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" stroke="currentColor" stroke-width="1.5"/>
        </svg>
        @Loc["TmNotionBlockContextMenu_Duplicate"]
    </button>

    @* Turn into (with submenu). The trigger is a real <button> — native Enter/Space activation,
       reachable by the focus trap's button selector and by AT. The hover wrapper is a neutral
       div (position: relative keeps the submenu's absolute offset anchored to the row) so the
       submenu panel is the button's SIBLING, never interactive content inside a button (N188). *@
    <div class="tm-notion-ctx__sub"
         @onmouseenter="() => OpenSub(Sub.TurnInto)"
         @onmouseleave="() => CloseSub(Sub.TurnInto)">
        <button type="button"
                class="tm-notion-ctx__item tm-notion-ctx__item--sub @(_showTurnInto ? "tm-notion-ctx__item--sub-open" : "")"
                role="menuitem"
                aria-haspopup="menu"
                aria-expanded="@(_showTurnInto ? "true" : "false")"
                @ref="_turnIntoTriggerRef"
                @onclick="() => OpenSub(Sub.TurnInto)">
            <svg class="tm-notion-ctx__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"
                      stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>@Loc["TmNotionBlockContextMenu_TurnInto"]</span>
            <svg class="tm-notion-ctx__chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M4.5 2l4 4-4 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
            </svg>
        </button>
        @if (_showTurnInto)
        {
            <div class="tm-notion-ctx-sub tm-notion-ctx-sub--right" role="menu" aria-label="@Loc["TmNotionBlockContextMenu_TurnInto"]">
                @foreach (var item in AllowedTurnIntoItems)
                {
                    <button class="tm-notion-ctx__item @(Block.Type == item.Type ? "tm-notion-ctx__item--active" : "")"
                            type="button" role="menuitem"
                            @onclick="() => HandleTurnIntoAsync(item.Type)">
                        <span class="tm-notion-ctx__turn-label">@Loc[item.LabelKey]</span>
                    </button>
                }
            </div>
        }
    </div>

    @* Move to *@
    <button class="tm-notion-ctx__item" type="button" role="menuitem" @onclick="HandleMoveToAsync">
        <svg class="tm-notion-ctx__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="1.5"
                  stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        @Loc["TmNotionBlockContextMenu_MoveTo"]
    </button>

    <div class="tm-notion-ctx__separator"></div>

    @* Copy link *@
    <button class="tm-notion-ctx__item" type="button" role="menuitem" @onclick="HandleCopyLinkAsync">
        <svg class="tm-notion-ctx__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71" stroke="currentColor"
                  stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71" stroke="currentColor"
                  stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        @Loc["TmNotionBlockContextMenu_CopyLink"]
    </button>

    @if (HasCommentProvider)
    {
        @* Comment (open existing threads) *@
        <button class="tm-notion-ctx__item" type="button" role="menuitem" @onclick="HandleCommentAsync">
            <svg class="tm-notion-ctx__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2v10z" stroke="currentColor"
                      stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            @Loc["TmNotionBlockContextMenu_Comment"]
        </button>

        @* New comment thread *@
        <button class="tm-notion-ctx__item" type="button" role="menuitem" @onclick="HandleNewThreadAsync">
            <svg class="tm-notion-ctx__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            @Loc["TmNotionBlockContextMenu_NewThread"]
        </button>
    }

    @if (Block.Type == BlockType.Callout)
    {
        <div class="tm-notion-ctx__sub"
             @onmouseenter="() => OpenSub(Sub.PanelType)"
             @onmouseleave="() => CloseSub(Sub.PanelType)">
            <button type="button"
                    class="tm-notion-ctx__item tm-notion-ctx__item--sub @(_showPanelType ? "tm-notion-ctx__item--sub-open" : "")"
                    role="menuitem"
                    aria-haspopup="menu"
                    aria-expanded="@(_showPanelType ? "true" : "false")"
                    @ref="_panelTypeTriggerRef"
                    @onclick="() => OpenSub(Sub.PanelType)">
                <svg class="tm-notion-ctx__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="3" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M8 9h8M8 13h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <span>@Loc["TmNotionBlockContextMenu_PanelType"]</span>
                <svg class="tm-notion-ctx__chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M4.5 2l4 4-4 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
                </svg>
            </button>
            @if (_showPanelType)
            {
                <div class="tm-notion-ctx-sub tm-notion-ctx-sub--right" role="menu" aria-label="@Loc["TmNotionBlockContextMenu_PanelType"]">
                    @foreach (var item in _panelTypeItems)
                    {
                        <button class="tm-notion-ctx__item"
                                type="button" role="menuitem"
                                @onclick="() => HandleCalloutVariantAsync(item.Variant)">
                            <span class="tm-notion-ctx__turn-label">@Loc[item.LabelKey]</span>
                        </button>
                    }
                </div>
            }
        </div>
    }

    <div class="tm-notion-ctx__separator"></div>

    @* Color (with submenu) — same structure as the Turn-into submenu. *@
    <div class="tm-notion-ctx__sub"
         @onmouseenter="() => OpenSub(Sub.Color)"
         @onmouseleave="() => CloseSub(Sub.Color)">
        <button type="button"
                class="tm-notion-ctx__item tm-notion-ctx__item--sub @(_showColor ? "tm-notion-ctx__item--sub-open" : "")"
                role="menuitem"
                aria-haspopup="menu"
                aria-expanded="@(_showColor ? "true" : "false")"
                @ref="_colorTriggerRef"
                @onclick="() => OpenSub(Sub.Color)">
            <svg class="tm-notion-ctx__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 22a1 1 0 100-2 1 1 0 000 2zM4.22 4.22C2.78 5.66 2 7.6 2 9.6c0 2.83 1.59 5.54 4 7.12l2 1.17.49.29M19.78 4.22C21.22 5.66 22 7.6 22 9.6c0 2.83-1.59 5.54-4 7.12l-2 1.17-.49.29"
                      stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M12 2v10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <span>@Loc["TmNotionBlockContextMenu_Color"]</span>
            <svg class="tm-notion-ctx__chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M4.5 2l4 4-4 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
            </svg>
        </button>
        @if (_showColor)
        {
            <div class="tm-notion-ctx-sub tm-notion-ctx-sub--right" role="menu" aria-label="@Loc["TmNotionBlockContextMenu_Color"]">
                <div class="tm-notion-ctx-color__section-label">@Loc["TmNotionBlockContextMenu_TextColor"]</div>
                @foreach (var c in _colorItems)
                {
                    <button class="tm-notion-ctx__item tm-notion-ctx-color__item"
                            type="button" role="menuitem"
                            @onclick="() => HandleTextColorAsync(c.Value)">
                        <span class="tm-notion-ctx-color__swatch tm-notion-ctx-color__swatch--text"
                              style="@(c.Value is null ? "" : $"color: var(--tm-notion-text-{c.Value})")">A</span>
                        @Loc[c.LabelKey]
                    </button>
                }
                <div class="tm-notion-ctx__separator"></div>
                <div class="tm-notion-ctx-color__section-label">@Loc["TmNotionBlockContextMenu_Background"]</div>
                @foreach (var c in _colorItems)
                {
                    <button class="tm-notion-ctx__item tm-notion-ctx-color__item"
                            type="button" role="menuitem"
                            @onclick="() => HandleBackgroundAsync(c.Value)">
                        <span class="tm-notion-ctx-color__swatch tm-notion-ctx-color__swatch--bg"
                              style="@(c.Value is null ? "" : $"background: var(--tm-notion-bg-{c.Value})")"></span>
                        @Loc[c.LabelKey]
                    </button>
                }
            </div>
        }
    </div>
</div>
