@namespace Tempo.Blazor.Components.NotionEditor.Blocks.Table
@using Tempo.Blazor.NotionEditor.Interfaces

<div class="tm-notion-table-block"
     data-aggregate-enabled="@(Context.AggregateSession is not null ? "true" : "false")"
     @ref="_containerRef">

    @if (_hasConflict)
    {
        <div class="tm-notion-table-block__conflict"
             role="alert"
             data-testid="@ConflictTestId">
            <div>
                <strong>@Loc["TmNotionTableBlock_ConflictTitle"]</strong>
                <span>@Loc["TmNotionTableBlock_ConflictMessage"]</span>
            </div>
            <div class="tm-notion-table-block__conflict-actions">
                <button type="button" disabled="@_saving" @onclick="ReloadConflictAsync">
                    @Loc["TmNotionTableBlock_ConflictReload"]
                </button>
                <button type="button" disabled="@_saving" @onclick="ReapplyConflictAsync">
                    @Loc["TmNotionTableBlock_ConflictReapply"]
                </button>
            </div>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_saveError))
    {
        <div class="tm-notion-table-block__save-error" role="alert">
            @Loc["TmNotionTableBlock_SaveError"] @_saveError
        </div>
    }

    @if (_loadingRows)
    {
        <div class="tm-notion-table-block__loading" role="status" aria-label="@Loc["TmNotionTableBlock_Loading"]">
            <div class="tm-notion-skeleton tm-notion-skeleton--rect" style="height:28px;margin-bottom:1px"></div>
            <div class="tm-notion-skeleton tm-notion-skeleton--rect" style="height:28px;margin-bottom:1px"></div>
            <div class="tm-notion-skeleton tm-notion-skeleton--rect" style="height:28px"></div>
        </div>
    }
    else
    {
        @if (CanAuthor)
        {
            <div class="tm-notion-table-block__toolbar">
                <button class="tm-notion-table-block__toggle @(_hasHeaderRow ? "tm-notion-table-block__toggle--active" : "")"
                        type="button"
                        title="@Loc["TmNotionTableBlock_ToggleHeaderRow"]"
                        aria-pressed="@(_hasHeaderRow ? "true" : "false")"
                        @onclick="ToggleHeaderRowAsync"
                        @onclick:stopPropagation="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
                        <line x1="3" y1="9" x2="21" y2="9" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                    <span>@Loc["TmNotionTableBlock_ToggleHeaderRow"]</span>
                </button>
                <button class="tm-notion-table-block__toggle @(_hasHeaderColumn ? "tm-notion-table-block__toggle--active" : "")"
                        type="button"
                        title="@Loc["TmNotionTableBlock_ToggleHeaderColumn"]"
                        aria-pressed="@(_hasHeaderColumn ? "true" : "false")"
                        @onclick="ToggleHeaderColumnAsync"
                        @onclick:stopPropagation="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
                        <line x1="9" y1="3" x2="9" y2="21" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                    <span>@Loc["TmNotionTableBlock_ToggleHeaderColumn"]</span>
                </button>
                <button class="tm-notion-table-block__tool"
                        type="button"
                        title="@Loc["TmNotionTableBlock_Undo"]"
                        aria-label="@Loc["TmNotionTableBlock_Undo"]"
                        disabled="@(_undoStack.Count == 0)"
                        @onclick="UndoTableChangeAsync"
                        @onclick:stopPropagation="true">
                    @Loc["TmNotionTableBlock_Undo"]
                </button>
                <button class="tm-notion-table-block__tool"
                        type="button"
                        title="@Loc["TmNotionTableBlock_Redo"]"
                        aria-label="@Loc["TmNotionTableBlock_Redo"]"
                        disabled="@(_redoStack.Count == 0 || _saving)"
                        @onclick="RedoTableChangeAsync"
                        @onclick:stopPropagation="true">
                    @Loc["TmNotionTableBlock_Redo"]
                </button>
                @if (_selection is not null)
                {
                    <div class="tm-notion-table-block__selection-tools" role="group" aria-label="@Loc["TmNotionTableBlock_SelectionTools"]">
                        <button class="tm-notion-table-block__tool"
                                type="button"
                                title="@Loc["TmNotionTableBlock_Merge"]"
                                disabled="@(!HasRangeSelection)"
                                @onclick="MergeSelectionAsync"
                                @onclick:stopPropagation="true">
                            @Loc["TmNotionTableBlock_Merge"]
                        </button>
                        <button class="tm-notion-table-block__tool"
                                type="button"
                                title="@Loc["TmNotionTableBlock_Split"]"
                                @onclick="SplitSelectionAsync"
                                @onclick:stopPropagation="true">
                            @Loc["TmNotionTableBlock_Split"]
                        </button>
                        <button class="tm-notion-table-block__swatch tm-notion-table-block__swatch--yellow"
                                type="button"
                                title="@Loc["TmNotionTableBlock_ColorYellow"]"
                                aria-label="@Loc["TmNotionTableBlock_ColorYellow"]"
                                @onclick="@(() => ApplySelectionColorAsync("rgba(245, 158, 11, 0.16)"))"
                                @onclick:stopPropagation="true"></button>
                        <button class="tm-notion-table-block__swatch tm-notion-table-block__swatch--green"
                                type="button"
                                title="@Loc["TmNotionTableBlock_ColorGreen"]"
                                aria-label="@Loc["TmNotionTableBlock_ColorGreen"]"
                                @onclick="@(() => ApplySelectionColorAsync("rgba(34, 197, 94, 0.16)"))"
                                @onclick:stopPropagation="true"></button>
                        <button class="tm-notion-table-block__swatch tm-notion-table-block__swatch--blue"
                                type="button"
                                title="@Loc["TmNotionTableBlock_ColorBlue"]"
                                aria-label="@Loc["TmNotionTableBlock_ColorBlue"]"
                                @onclick="@(() => ApplySelectionColorAsync("rgba(59, 130, 246, 0.14)"))"
                                @onclick:stopPropagation="true"></button>
                        <button class="tm-notion-table-block__swatch tm-notion-table-block__swatch--red"
                                type="button"
                                title="@Loc["TmNotionTableBlock_ColorRed"]"
                                aria-label="@Loc["TmNotionTableBlock_ColorRed"]"
                                @onclick="@(() => ApplySelectionColorAsync("rgba(239, 68, 68, 0.14)"))"
                                @onclick:stopPropagation="true"></button>
                        <button class="tm-notion-table-block__tool"
                                type="button"
                                title="@Loc["TmNotionTableBlock_ClearColor"]"
                                @onclick="ClearSelectionColorAsync"
                                @onclick:stopPropagation="true">
                            @Loc["TmNotionTableBlock_ClearColor"]
                        </button>
                        <button class="tm-notion-table-block__tool"
                                type="button"
                                title="@Loc["TmNotionTableBlock_Sort"]"
                                @onclick="SortSelectedColumnAsync"
                                @onclick:stopPropagation="true">
                            @Loc["TmNotionTableBlock_Sort"]
                        </button>
                    </div>
                }
            </div>
        }

        <div class="tm-notion-table-block__wrapper">
            <div class="tm-notion-table-block__table-shell">
                <table class="tm-notion-table @(_hasHeaderRow ? "tm-notion-table--has-header-row" : "") @(_hasHeaderColumn ? "tm-notion-table--has-header-col" : "")"
                       role="grid"
                       aria-label="@Loc["TmNotionTableBlock_TableLabel"]"
                       @ref="_tableRef">

                    @if (CanAuthor && _columnCount > 0)
                    {
                        <thead>
                            <tr class="tm-notion-table__ctrl-row" aria-hidden="true">
                                <th class="tm-notion-table__corner-cell"></th>
                                @for (var c = 0; c < _columnCount; c++)
                                {
                                    var colIdx = c;
                                    <th class="tm-notion-table__col-ctrl-cell">
                                        @if (_columnCount > 1)
                                        {
                                            <button class="tm-notion-table__col-delete"
                                                    type="button"
                                                    title="@Loc["TmNotionTableBlock_DeleteColumn"]"
                                                    aria-label="@Loc["TmNotionTableBlock_DeleteColumn"]"
                                                    @onclick="() => DeleteColumnAsync(colIdx)"
                                                    @onclick:stopPropagation="true">
                                                <svg width="8" height="8" viewBox="0 0 8 8" fill="none" aria-hidden="true">
                                                    <line x1="1" y1="1" x2="7" y2="7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                                    <line x1="7" y1="1" x2="1" y2="7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                                </svg>
                                            </button>
                                        }
                                    </th>
                                }
                            </tr>
                        </thead>
                    }

                    <tbody>
                        @for (var r = 0; r < _rows.Count; r++)
                        {
                            var row     = _rows[r];
                            var rowIdx  = r;
                            var isHeader = _hasHeaderRow && r == 0;
                            <TmNotionTableRowBlock Row="row"
                                                   RowIndex="rowIdx"
                                     ColumnCount="_columnCount"
                                     ColumnAlignments="_columnAlignments"
                                     ColumnWidths="_columnWidths"
                                                   IsHeaderRow="isHeader"
                                                   HasHeaderColumn="_hasHeaderColumn"
                                                   ReadOnly="@(!CanAuthor)"
                                                   IsDragging="_dragSourceIndex == rowIdx"
                                                   IsDragOver="_dragOverIndex == rowIdx && _dragOverIndex != _dragSourceIndex"
                                                   CanDelete="_rows.Count > 1"
                                                   OnCellsChanged="cells => HandleCellsChangedAsync(row, cells)"
                                                   OnDeleteRequested="() => DeleteRowAsync(rowIdx)"
                                                   OnFocused="OnFocused"
                                                   OnTabFromLastCell="() => FocusCellAsync(rowIdx + 1, 0)"
                                                   OnShiftTabFromFirstCell="() => FocusCellAsync(rowIdx - 1, _columnCount - 1)"
                                                   OnDragStart="() => HandleRowDragStartAsync(rowIdx)"
                                                   OnDragOver="() => HandleRowDragOverAsync(rowIdx)"
                                                   OnDrop="HandleRowDropAsync"
                                                   OnDragEnd="HandleRowDragEndAsync"
                                                   OnCellMouseDown="HandleCellMouseDown"
                                                   OnCellMouseEnter="HandleCellMouseEnter"
                                                   OnCellMouseUp="HandleCellMouseUp"
                                                   IsCellSelected="IsCellSelected" />
                        }
                    </tbody>
                </table>

                @if (_rows.Count == 0 && _columnCount > 0)
                {
                    <div class="tm-notion-table-block__empty-grid"
                         style="--tm-notion-table-empty-columns: @_columnCount"
                         aria-hidden="true">
                        <span class="tm-notion-table-block__empty-handle"></span>
                        @for (var c = 0; c < _columnCount; c++)
                        {
                            <span class="tm-notion-table-block__empty-cell"></span>
                        }
                    </div>
                }
            </div>

            @if (CanAuthor)
            {
                <button class="tm-notion-table-block__add-col"
                        type="button"
                        title="@Loc["TmNotionTableBlock_AddColumn"]"
                        aria-label="@Loc["TmNotionTableBlock_AddColumn"]"
                        @onclick="AddColumnAsync"
                        @onclick:stopPropagation="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <line x1="12" y1="5" x2="12" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        <line x1="5" y1="12" x2="19" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                </button>
            }
        </div>

        @if (CanAuthor)
        {
            <button class="tm-notion-table-block__add-row"
                    type="button"
                    aria-label="@Loc["TmNotionTableBlock_AddRow"]"
                    @onclick="AddRowAsync"
                    @onclick:stopPropagation="true">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <line x1="5" y1="12" x2="19" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <span>@Loc["TmNotionTableBlock_AddRow"]</span>
            </button>
        }
    }

</div>
