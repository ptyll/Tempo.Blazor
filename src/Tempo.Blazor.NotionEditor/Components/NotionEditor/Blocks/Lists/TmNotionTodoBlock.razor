@namespace Tempo.Blazor.Components.NotionEditor.Blocks.Lists
@using Tempo.Blazor.Components.Pickers
@using Tempo.Blazor.NotionEditor.Interfaces
@using Tempo.Blazor.NotionEditor.Enums
@using Tempo.Blazor.Components.NotionEditor.Services

<div class="@_rootClass"
     data-bg="@NotionColorTokens.Name(Content?.BackgroundColor)">

    <span class="tm-notion-todo__check-wrap" aria-hidden="true">
        <input class="tm-notion-todo__input"
               type="checkbox"
               aria-label="@Loc["Notion_Todo_Toggle"]"
               checked="@_isChecked"
               disabled="@ReadOnly"
               tabindex="-1"
               @onchange="HandleCheckboxChangeAsync" />
        <span class="tm-notion-todo__box">
            <svg class="tm-notion-todo__check-icon" viewBox="0 0 12 12" fill="none"
                 aria-hidden="true" focusable="false">
                <polyline points="2,6 5,9 10,3" stroke="currentColor"
                          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </span>
    </span>

    @if (ReadOnly)
    {
        <div @key="ReadOnly"
             class="tm-notion-todo__text tm-notion-editable tm-notion-editable--readonly @_alignClass"
             contenteditable="false"
             data-color="@NotionColorTokens.Name(Content?.TextColor)">
            @((MarkupString)NotionHtmlSanitizer.SanitizeBlockContent(Content?.Html))
        </div>
    }
    else
    {
        <div @key="ReadOnly"
             class="tm-notion-todo__text tm-notion-editable @_alignClass"
             contenteditable="true"
             data-placeholder="@Placeholder"
             data-color="@NotionColorTokens.Name(Content?.TextColor)"
             spellcheck="true"
             @ref="_editableRef"
             @oninput="() => _dirty = true"
             @onblur="OnBlurAsync"
             @onfocus="HandleFocusAsync">
        </div>
    }

    <div class="tm-notion-todo__meta">
        @if (HasAssignee)
        {
            <span class="tm-notion-todo__assignee">
                <span class="tm-notion-todo__avatar" aria-hidden="true">@AssigneeInitials</span>
                <span class="tm-notion-todo__assignee-name">@AssigneeDisplayName</span>
                @if (!ReadOnly)
                {
                    <button type="button"
                            class="tm-notion-todo__chip-remove"
                            aria-label="@Loc["Notion_Todo_Unassign"]"
                            @onclick="ClearAssigneeAsync">
                        ×
                    </button>
                }
            </span>
        }

        @if (HasDueDate)
        {
            <button type="button"
                    class="@DueClass"
                    disabled="@ReadOnly"
                    @onclick="ToggleDatePicker">
                @DueText
            </button>
        }

        @if (!ReadOnly && Context.MentionProvider is not null)
        {
            <button type="button"
                    class="tm-notion-todo__action"
                    @onclick="ToggleAssigneePickerAsync">
                @Loc["Notion_Todo_Assign"]
            </button>
        }

        @if (!ReadOnly)
        {
            <button type="button"
                    class="tm-notion-todo__action"
                    @onclick="ToggleDatePicker">
                @Loc["Notion_Todo_DueDate"]
            </button>
        }
    </div>

    @if (_showAssigneePicker)
    {
        <div class="tm-notion-todo__picker tm-notion-todo__picker--assignee">
            <input class="tm-notion-todo__search"
                   value="@_assigneeQuery"
                   placeholder="@Loc["Notion_Todo_AssigneeSearch"]"
                   @oninput="HandleAssigneeSearchAsync" />
            @if (_loadingAssignees)
            {
                <div class="tm-notion-todo__picker-state">@Loc["Notion_Todo_LoadingUsers"]</div>
            }
            else if (_assignees.Count == 0)
            {
                <div class="tm-notion-todo__picker-state">@Loc["Notion_Todo_NoAssignees"]</div>
            }
            else
            {
                @foreach (var user in _assignees)
                {
                    <button type="button"
                            class="tm-notion-todo__user"
                            @onclick="() => SelectAssigneeAsync(user)">
                        <span class="tm-notion-todo__avatar" aria-hidden="true">
                            @UserInitials(user.DisplayName)
                        </span>
                        <span class="tm-notion-todo__user-name">@user.DisplayName</span>
                    </button>
                }
            }
        </div>
    }

    @if (_showDatePicker)
    {
        <div class="tm-notion-todo__picker tm-notion-todo__picker--date">
            <TmDatePicker Value="@DueDateOnly"
                          ValueChanged="HandleDueDateSelectedAsync"
                          Class="tm-notion-todo__date-picker" />
        </div>
    }

</div>
