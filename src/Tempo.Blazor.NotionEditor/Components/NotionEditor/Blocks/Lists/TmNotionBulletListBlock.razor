@namespace Tempo.Blazor.Components.NotionEditor.Blocks.Lists
@using Tempo.Blazor.NotionEditor.Interfaces
@using Tempo.Blazor.NotionEditor.Enums
@using Tempo.Blazor.Components.NotionEditor.Services

<div class="tm-notion-bullet @_bgClass"
     data-bg="@NotionColorTokens.Name(Content?.BackgroundColor)"
     data-indent="@(Content?.IndentLevel ?? 0)">

    <span class="tm-notion-bullet__marker" aria-hidden="true"></span>

    @if (ReadOnly)
    {
        <div @key="ReadOnly"
             class="tm-notion-bullet__body tm-notion-editable tm-notion-editable--readonly @_alignClass"
             contenteditable="false"
             data-color="@NotionColorTokens.Name(Content?.TextColor)">
            @((MarkupString)NotionHtmlSanitizer.SanitizeBlockContent(Content?.Html))
        </div>
    }
    else
    {
        <div @key="ReadOnly"
             class="tm-notion-bullet__body tm-notion-editable @_alignClass"
             contenteditable="true"
             data-placeholder="@Placeholder"
             data-color="@NotionColorTokens.Name(Content?.TextColor)"
             spellcheck="true"
             @ref="_editableRef"
             @oninput="() => _dirty = true"
             @onblur="OnBlurAsync"
             @onfocus="HandleFocusAsync">
        </div>
    }

</div>
