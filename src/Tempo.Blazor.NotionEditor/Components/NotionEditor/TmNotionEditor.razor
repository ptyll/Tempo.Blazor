@namespace Tempo.Blazor.Components.NotionEditor
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.NotionEditor.Interfaces
@using Tempo.Blazor.NotionEditor.Models
@using Tempo.Blazor.Components.NotionEditor.Services
@using Tempo.Blazor.Components.NotionEditor.Page
@using Tempo.Blazor.Components.NotionEditor.Sidebar
@using Tempo.Blazor.Components.NotionEditor.UI
@using Tempo.Blazor.Components.Notifications
@using Tempo.Blazor.Components.Layout
@using Tempo.Blazor.Components.Toolbar
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Components.Actions
@using Tempo.Blazor.Abstractions.Layout

@* N0: the editor is a TmEditorShell. Its header spans the full width (sidebar included), the left
   slot is the page tree (a drawer below 1024 through the shell's tablet overlay / mobile sheet),
   the right slot is the host inspector (empty by default — G10) and the mobile slot is the F5
   action bar. LayoutMode is cascaded so the page, the menus and the database blocks read the same
   mode. The slots pass as null when their chrome is absent (ShowSidebar=false, no inspector), so
   the shell never renders empty rails or toggles. *@
<CascadingValue Value="_context" IsFixed="false">
<CascadingValue Value="LayoutCascade" IsFixed="false">
<TmEditorShell Class="@RootClasses"
               LayoutMode="LayoutMode"
               TabletPanelPresentation="TabletPanelPresentation.Overlay"
               ResolvedLayoutChanged="OnShellLayoutChanged"
               LeftOpen="_sidebarVisible"
               LeftOpenChanged="OnSidebarOpenChanged"
               RightOpen="_inspectorOpen"
               RightOpenChanged="OnInspectorOpenChanged"
               Left="SidebarSlot"
               Right="InspectorSlot"
               Header="@HeaderSlot"
               LeftTitle="@Loc["TmNotionEditor_Navigation"]"
               RightTitle="@Loc["TmNotionEditor_Inspector"]"
               MobileActions="MobileBarActions"
               AdditionalAttributes="ShellAttributes">
    <Canvas>
        <div class="tm-notion-main" @ref="_mainRef" data-notion-scroll-root>

            @* ── Shell panels: at most ONE open (_openShellPanel). Overlay (default) rides the
               core TmSidePanel (docked on desktop, side sheet on tablet, full-height sheet on
               mobile) over the still-mounted page; Main replaces the page in the main region. ── *@
            @if (ShellPanelPresentation == NotionShellPanelPresentation.Main)
            {
                @if (_openShellPanel == NotionShellPanel.Tasks && _context.WorkItemSource is not null)
                {
                    <aside class="tm-notion-tasks-panel tm-notion-shell-panel tm-notion-shell-panel--main"
                           aria-label="@Loc["Notion_Tasks_Title"]">
                        <TmNotionMyTasks WorkItemSource="_context.WorkItemSource"
                                         CurrentUserId="@EffectiveCurrentUserId"
                                         OnClosed="CloseShellPanel"
                                         OnNavigateToBlock="NavigateToTaskBlockAsync" />
                    </aside>
                }
                @if (_openShellPanel == NotionShellPanel.Blog && _context.BlogProvider is not null)
                {
                    <aside class="tm-notion-shell-panel tm-notion-shell-panel--wide tm-notion-shell-panel--main">
                        <TmNotionBlogList BlogProvider="_context.BlogProvider"
                                          SpaceId="@CurrentSpaceId"
                                          CurrentUserId="@EffectiveCurrentUserId"
                                          OnClosed="CloseShellPanel" />
                    </aside>
                }
                @if (_openShellPanel == NotionShellPanel.Analytics && _context.AnalyticsProvider is not null)
                {
                    <aside class="tm-notion-shell-panel tm-notion-shell-panel--main">
                        <TmNotionAnalyticsPanel AnalyticsProvider="_context.AnalyticsProvider"
                                                SpaceId="@CurrentSpaceId"
                                                CurrentPageId="@_currentPage?.Id"
                                                OnClosed="CloseShellPanel" />
                    </aside>
                }
                @if (_openShellPanel == NotionShellPanel.Audit && _context.AuditProvider is not null)
                {
                    <aside class="tm-notion-shell-panel tm-notion-shell-panel--wide tm-notion-shell-panel--main">
                        <TmNotionAuditLogPanel ActivityProvider="_context.AuditProvider"
                                               Class="tm-notion-audit-panel tm-notion-shell-panel__content"
                                               OnClosed="CloseShellPanel" />
                    </aside>
                }
            }
            else if (_openShellPanel != NotionShellPanel.None)
            {
                <TmSidePanel Open="true"
                             OpenChanged="OnShellPanelOverlayClosed"
                             LayoutMode="LayoutMode"
                             Title="@ShellPanelTitle"
                             ShowHeader="false"
                             CloseOnEscape="true"
                             RestoreFocusTargetId="@ShellPanelTriggerId"
                             Class="tm-notion-shell-panel tm-notion-shell-panel--overlay"
                             Width="@ShellPanelWidth">
                    <ChildContent>
                        @switch (_openShellPanel)
                        {
                            case NotionShellPanel.Tasks when _context.WorkItemSource is not null:
                                <div class="tm-notion-shell-panel__body tm-notion-tasks-panel tm-notion-shell-panel__body--tasks">
                                    <TmNotionMyTasks WorkItemSource="_context.WorkItemSource"
                                                     CurrentUserId="@EffectiveCurrentUserId"
                                                     OnClosed="CloseShellPanel"
                                                     OnNavigateToBlock="NavigateToTaskBlockAsync" />
                                </div>
                                break;
                            case NotionShellPanel.Blog when _context.BlogProvider is not null:
                                <div class="tm-notion-shell-panel__body tm-notion-shell-panel__body--wide">
                                    <TmNotionBlogList BlogProvider="_context.BlogProvider"
                                                      SpaceId="@CurrentSpaceId"
                                                      CurrentUserId="@EffectiveCurrentUserId"
                                                      OnClosed="CloseShellPanel" />
                                </div>
                                break;
                            case NotionShellPanel.Analytics when _context.AnalyticsProvider is not null:
                                <div class="tm-notion-shell-panel__body">
                                    <TmNotionAnalyticsPanel AnalyticsProvider="_context.AnalyticsProvider"
                                                            SpaceId="@CurrentSpaceId"
                                                            CurrentPageId="@_currentPage?.Id"
                                                            OnClosed="CloseShellPanel" />
                                </div>
                                break;
                            case NotionShellPanel.Audit when _context.AuditProvider is not null:
                                <div class="tm-notion-shell-panel__body tm-notion-shell-panel__body--wide">
                                    <TmNotionAuditLogPanel ActivityProvider="_context.AuditProvider"
                                                           Class="tm-notion-audit-panel"
                                                           OnClosed="CloseShellPanel" />
                                </div>
                                break;
                        }
                    </ChildContent>
                </TmSidePanel>
            }

            @* ── Page content area ────────────────────────────────────────── *@
            @if (HasSinglePageConfigError)
            {
                <div class="tm-notion-load-error" role="alert" data-testid="@TestId("notion-single-page-config-error")">
                    <svg class="tm-notion-load-error__icon" width="24" height="24" viewBox="0 0 24 24"
                         fill="none" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M12 7v5M12 16h.01" stroke="currentColor" stroke-width="1.5"
                              stroke-linecap="round"/>
                    </svg>
                    <span class="tm-notion-load-error__message">
                        @Loc["TmNotionEditor_SinglePageRequiresInitialPage"]
                    </span>
                </div>
            }
            else if (_isLoading)
            {
                <div class="tm-notion-loading" role="status" aria-label="@Loc["TmNotionEditor_Loading"]" aria-busy="true">
                    <div class="tm-notion-skeleton tm-notion-skeleton--title"></div>
                    <div class="tm-notion-skeleton tm-notion-skeleton--line" style="width:85%"></div>
                    <div class="tm-notion-skeleton tm-notion-skeleton--line" style="width:70%"></div>
                    <div class="tm-notion-skeleton tm-notion-skeleton--line-short"></div>
                    <div class="tm-notion-skeleton tm-notion-skeleton--line" style="width:60%"></div>
                </div>
            }
            else if (_loadError is not null)
            {
                <div class="tm-notion-load-error" role="alert">
                    <svg class="tm-notion-load-error__icon" width="24" height="24" viewBox="0 0 24 24"
                         fill="none" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M12 7v5M12 16h.01" stroke="currentColor" stroke-width="1.5"
                              stroke-linecap="round"/>
                    </svg>
                    <span class="tm-notion-load-error__message">
                        @_loadError
                    </span>
                    <button class="tm-notion-load-error__retry"
                            type="button"
                            @onclick="RetryLoadAsync">
                        @Loc["Tm_Retry"]
                    </button>
                </div>
            }
            else if (_currentPage is not null && !MainPanelReplacesPage)
            {
                @if (HasNoAccess)
                {
                    <section class="tm-notion-no-access" role="alert">
                        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                            <path d="M8 12V9.2a6 6 0 1 1 12 0V12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                            <rect x="6.5" y="12" width="15" height="11" rx="2.5" stroke="currentColor" stroke-width="1.7"/>
                            <path d="M14 16.5v2.7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                        </svg>
                        <div>
                            <h2>@Loc["Notion_Restrictions_NoAccessTitle"]</h2>
                            <p>@Loc["Notion_Restrictions_NoAccess"]</p>
                        </div>
                    </section>
                }
                else
                {
                    <TmNotionLabelEditor PageId="_currentPage.Id"
                                         Labels="_currentPage.Labels"
                                         ReadOnly="IsEffectivelyReadOnly || _currentPage.IsLocked"
                                         OnLabelsChanged="HandleCurrentPageLabelsChangedAsync" />
                    <CascadingValue Value="_scrollSpyBlockId" Name="TmActiveHeadingBlockId" IsFixed="false">
                        <TmNotionPage Page="_currentPage"
                                      ReadOnly="IsEffectivelyReadOnly || _currentPage.IsLocked"
                                      ShowMeta="ShowMeta"
                                      EffectivePermission="_effectivePermission"
                                      OnPermissionsChanged="OnPagePermissionsChangedAsync"
                                      OnPageUpdated="OnChildPageUpdatedAsync"
                                      OnNavigateToPage="NavigateToPageAsync"
                                      OnCreateTokenRequested="OnCreateTokenRequested" />
                    </CascadingValue>
                }
            }

        </div>

        @* ── Page Search (Ctrl+P / Cmd+P) ──────────────────────────────────── *@
        <TmNotionPageSearch />

        @if (!SinglePageMode)
        {
            <TmNotionTemplateGallery Visible="_templateGalleryOpen"
                                     TemplateProvider="_context.TemplateProvider"
                                     OnTemplateSelected="HandleTemplateSelectedAsync"
                                     OnClosed="CloseTemplateGallery" />
        }

        @* ── Notification toasts ─────────────────────────────────────────────── *@
        <TmNotificationToastContainer IsPanelOpen="_notificationPanelOpen" />

    </Canvas>
</TmEditorShell>
@* The shortcuts modal lives outside the shell canvas: crossing into the mobile band remounts
   the canvas (NOTION-EDITOR-SHELL-CANVAS-REMOUNT) and a modal inside it would dispose mid-open,
   taking the ? listener with it. *@
<TmNotionShortcutsPanel Visible="_shortcutsVisible"
                        VisibleChanged="HandleShortcutsVisibleChangedAsync"
                        LayoutMode="EffectiveLayout" />
@* Restrictions and share follow the shortcuts panel: the canvas remounts on a band flip, so a
   dialog rendered inside it closed itself on 1440 → 390. The page opens them through the context. *@
@if (_context.PublicShareProvider is not null && (_pageDialogPageId ?? _currentPage?.Id) is { } sharePageId)
{
    <TmNotionShareDialog Visible="_shareDialogOpen"
                         VisibleChanged="OnShareVisibleChanged"
                         PageId="sharePageId"
                         Provider="_context.PublicShareProvider"
                         LayoutMode="EffectiveLayout" />
}
@if (_context.PermissionProvider is not null && (_pageDialogPageId ?? _currentPage?.Id) is { } restrictionsPageId)
{
    <TmNotionRestrictionsDialog PageId="restrictionsPageId"
                                Provider="_context.PermissionProvider"
                                EffectivePermission="@(_pageDialogPageId is null || _pageDialogPageId == _currentPage?.Id ? _effectivePermission : null)"
                                Visible="_restrictionsDialogOpen"
                                VisibleChanged="OnRestrictionsVisibleChanged"
                                OnSaved="OnRestrictionsSavedAsync"
                                LayoutMode="EffectiveLayout" />
}
</CascadingValue>
</CascadingValue>

@code {
    // The top bar rides the shell header as a NULLABLE fragment: Minimal/None chrome pass null, so
    // the shell never draws the empty 25px header band (the host page — e.g. the public page —
    // supplies the only header then). Full chrome keeps the top bar.

    private RenderFragment TopBarMarkup => @<header class="tm-notion-topbar @(_topbarScrolled ? "tm-notion-topbar--scrolled" : "")" role="banner">
            <TmToolbar Overflow="ToolbarOverflow.Menu" Labels="ToolbarLabels.Auto" Class="tm-notion-topbar__toolbar" AriaLabel="@Loc["TmNotionEditor_Toolbar"]">
                @if (!SinglePageMode)
                {
                <TmToolbarGroup Label="@Loc["TmNotionEditor_GroupNavigation"]" AdditionalAttributes="@(Group("navigation"))">
                    @if (EffectiveShowSidebar && !IsReadOnlyViewMode)
                    {
                        <TmToolbarButton Class="tm-notion-sidebar-toggle"
                                         Icon="@IconNames.PanelLeft"
                                         Tooltip="@Loc["TmNotionEditor_ToggleSidebar"]"
                                         Priority="ToolbarButtonPriority.Pinned"
                                         OnClick="ToggleSidebarAsync"
                                         AdditionalAttributes="@(Attrs(("aria-controls", "tm-notion-sidebar"), ("aria-expanded", _sidebarVisible ? "true" : "false")))" />
                    }
                    @if (!SinglePageMode && _navStack.Count > 1)
                    {
                        <TmToolbarButton Class="tm-notion-topbar__back"
                                         Icon="@IconNames.ChevronLeft"
                                         Text="@Loc["TmNotionEditor_NavigateBack"]"
                                         Tooltip="@Loc["TmNotionEditor_NavigateBack"]"
                                         Priority="ToolbarButtonPriority.Pinned"
                                         OnClick="NavigateBackAsync" />
                    }
                </TmToolbarGroup>
                }
                @if (_currentPage is not null)
                {
                    <span class="tm-notion-topbar__title" aria-live="polite">@PageTitle</span>
                }

                <TmToolbarGroup Label="@Loc["TmNotionEditor_GroupCollaboration"]" AdditionalAttributes="@(Group("collaboration"))">
                    @if (_context.CollaborationProvider is not null)
                    {
                        <TmNotionCollaborationCursors />
                    }
                    @if (_context.WatchProvider is not null && _currentPage is not null && !IsReadOnlyViewMode)
                    {
                        <TmNotionWatchButton Provider="_context.WatchProvider"
                                             PageId="@_currentPage.Id.ToString("D")"
                                             UserId="@EffectiveCurrentUserId" />
                    }
                    <TmNotionNotificationCenter CurrentUserId="@EffectiveCurrentUserId"
                                                OnDropdownOpenChanged="OnNotificationDropdownOpenChanged" />
                </TmToolbarGroup>

                @if (!IsReadOnlyViewMode)
                {
                    <TmToolbarGroup Label="@Loc["TmNotionEditor_GroupTools"]" AdditionalAttributes="@(Group("tools"))">
                        @if (_context.AuditProvider is not null && !SinglePageMode)
                        {
                            <TmToolbarButton Class="tm-notion-topbar__tool"
                                             Icon="@IconNames.FileText"
                                             Tooltip="@Loc["Notion_Audit_Title"]"
                                             Pressed="_openShellPanel == NotionShellPanel.Audit"
                                             Priority="@ToolPriority"
                                             OnClick="ToggleAuditPanelAsync"
                                             AdditionalAttributes="@(Test("notion-audit-open"))" />
                        }
                        @* Pinned on desktop and tablet: a Secondary button collapses into More and keeps its
                           data-testid on the visibility:hidden bar copy. On the mobile band the action-bar
                           More sheet already carries this trigger — a second pinned copy sits under the
                           fixed header, and a tap at its center hits More instead of opening shortcuts. *@
                        @if (EffectiveLayout != TmLayoutMode.Mobile)
                        {
                        <TmToolbarButton Class="tm-notion-topbar__shortcuts tm-notion-topbar__tool"
                                         AdditionalAttributes="@(Test("notion-shortcuts-open"))"
                                         Icon="@IconNames.HelpCircle"
                                         Tooltip="@Loc["Notion_Shortcuts_Title"]"
                                         Pressed="_shortcutsVisible"
                                         Priority="ToolbarButtonPriority.Pinned"
                                         OnClick="OpenShortcutsAsync" />
                        }
                        @if (_context.BlogProvider is not null && !SinglePageMode)
                        {
                            <TmToolbarButton Class="tm-notion-topbar__tool"
                                             Icon="@IconNames.BookOpen"
                                             Tooltip="@Loc["Notion_Blog_Title"]"
                                             Pressed="_openShellPanel == NotionShellPanel.Blog"
                                             Priority="@ToolPriority"
                                             OnClick="ToggleBlogPanelAsync"
                                             AdditionalAttributes="@(Test("notion-blog-open"))" />
                        }
                        @if (_context.AnalyticsProvider is not null && !SinglePageMode)
                        {
                            <TmToolbarButton Class="tm-notion-topbar__tool"
                                             Icon="@IconNames.BarChart2"
                                             Tooltip="@Loc["Notion_Analytics_Title"]"
                                             Pressed="_openShellPanel == NotionShellPanel.Analytics"
                                             Priority="@ToolPriority"
                                             OnClick="ToggleAnalyticsPanelAsync"
                                             AdditionalAttributes="@(Test("notion-analytics-open"))" />
                        }
                        @if (_context.PublicShareProvider is not null && !SinglePageMode)
                        {
                            <TmToolbarButton Class="tm-notion-topbar__tool"
                                             Icon="@IconNames.Share"
                                             Tooltip="@Loc["Notion_Share_Title"]"
                                             Priority="ToolbarButtonPriority.Secondary"
                                             OnClick="OpenShareAsync"
                                             AdditionalAttributes="@(Test("notion-share-open"))" />
                        }
                    </TmToolbarGroup>
                }

                @* Modes render in EVERY view mode: the toggles enter reading/presentation,
                   the exit button must be visible while a read-only view mode is active —
                   nested under !IsReadOnlyViewMode it never rendered and the only way out
                   was Escape (CF19 regression). *@
                <TmToolbarGroup Label="@Loc["TmNotionEditor_GroupModes"]" AdditionalAttributes="@(Group("modes"))">
                    @if (IsReadOnlyViewMode)
                    {
                        <TmToolbarButton Class="tm-notion-reading-exit tm-notion-topbar__tool"
                                         Icon="@IconNames.X"
                                         Tooltip="@Loc["Notion_Reading_Exit"]"
                                         Priority="ToolbarButtonPriority.Pinned"
                                         OnClick="ExitViewModeAsync" />
                    }
                    else
                    {
                        <TmToolbarButton Class="tm-notion-reading-toggle tm-notion-topbar__tool"
                                         AdditionalAttributes="@(Test("notion-reading-toggle"))"
                                         Icon="@IconNames.BookOpen"
                                         Tooltip="@Loc["Notion_Reading_Enter"]"
                                         Priority="ToolbarButtonPriority.Secondary"
                                         OnClick="EnterReadingModeAsync" />
                        <TmToolbarButton Class="tm-notion-presentation-toggle tm-notion-topbar__tool"
                                         AdditionalAttributes="@(Test("notion-presentation-toggle"))"
                                         Icon="@IconNames.Monitor"
                                         Tooltip="@Loc["Notion_Presentation_Enter"]"
                                         Priority="ToolbarButtonPriority.Secondary"
                                         OnClick="EnterPresentationModeAsync" />
                    }
                </TmToolbarGroup>

                @if (_context.WorkItemSource is not null && !IsReadOnlyViewMode && !SinglePageMode)
                {
                    <TmToolbarGroup Label="@Loc["TmNotionEditor_GroupPrimary"]" AdditionalAttributes="@(Group("primary"))">
                        <TmToolbarButton Class="tm-notion-topbar__tasks"
                                         Icon="@IconNames.CheckSquare"
                                         Text="@Loc["Notion_Tasks_Title"]"
                                         Tooltip="@Loc["Notion_Tasks_Title"]"
                                         Pressed="_openShellPanel == NotionShellPanel.Tasks"
                                         Priority="@TasksPriority"
                                         OnClick="ToggleTasksPanelAsync"
                                         AdditionalAttributes="@(Test("notion-tasks"))" />
                    </TmToolbarGroup>
                }

                @if (IsPermissionRestricted)
                {
                    <span class="tm-notion-restricted-badge" role="status">
                        <TmIcon Name="@IconNames.Lock" Size="IconSize.Sm" />
                        @Loc["Notion_Restrictions_Title"]
                    </span>
                }
                @if (IsEffectivelyReadOnly)
                {
                    <span class="tm-notion-locked-badge" role="status">
                        <TmIcon Name="@IconNames.Lock" Size="IconSize.Sm" />
                        @Loc["TmNotionEditor_Locked"]
                    </span>
                }
            </TmToolbar>
</header>;
    private RenderFragment? HeaderSlot => Chrome == NotionEditorChrome.Full
        ? TopBarMarkup
        : null;

    // The sidebar and inspector ride the shell slots as NULLABLE fragments: a null slot renders no
    // region, rail or toggle at all (an empty fragment would still make the shell draw the chrome).
    private RenderFragment? SidebarSlot => EffectiveShowSidebar && !IsReadOnlyViewMode && !HasNoAccess
        ? SidebarMarkup
        : null;

    private RenderFragment SidebarMarkup => @<aside id="tm-notion-sidebar"
                                                    class="tm-notion-sidebar @(_sidebarVisible ? "tm-notion-sidebar--visible" : "tm-notion-sidebar--hidden")"
                                                    aria-label="@Loc["TmNotionEditor_SidebarLabel"]"
                                                    role="navigation"
                                                    tabindex="-1"
                                                    @ref="_sidebarRef">
        @* Desktop-only chrome: below desktop the shell overlay / mobile sheet owns the close (×)
           and Escape, so the drawer gets no second close control. *@
        @if (EffectiveLayout == TmLayoutMode.Desktop)
        {
            <div class="tm-notion-sidebar__bar">
                <h2 class="tm-notion-sidebar__heading">@Loc["TmNotionEditor_Navigation"]</h2>
                <button class="tm-notion-sidebar-collapse"
                        type="button"
                        aria-label="@Loc["TmNotionEditor_CollapseSidebar"]"
                        title="@Loc["TmNotionEditor_CollapseSidebar"]"
                        @onclick="CloseSidebar">
                    <TmIcon Name="@IconNames.PanelLeft" Size="IconSize.Sm" />
                </button>
            </div>
        }
        <TmNotionSidebar ActivePageId="@_currentPageId"
                         OnTrashRequested="OnTrashRequestedAsync" />
    </aside>;

    private RenderFragment? InspectorSlot => InspectorContent is not null
        ? InspectorMarkup
        : null;

    private RenderFragment InspectorMarkup => @<aside class="tm-notion-inspector" data-region="right" aria-label="@Loc["TmNotionEditor_Inspector"]">@InspectorContent</aside>;
}
