@namespace Tempo.Blazor.Components.NotionEditor.Page
@using Tempo.Blazor.NotionEditor.Interfaces
@using Tempo.Blazor.NotionEditor.Enums
@using Tempo.Blazor.Components.NotionEditor.Services
@using Tempo.Blazor.Components.NotionEditor.Blocks
@using Tempo.Blazor.Components.NotionEditor.UI
@using Tempo.Blazor.NotionEditor.Models

<article class="tm-notion-page @_pageMods"
         data-page-id="@Page.Id"
         @ref="_pageRef">

    @* ── Page settings button (top-right corner) ────────────────────────────── *@
    @if (!ReadOnly || Page.IsLocked)
    {
        <div class="tm-notion-page__settings-btn">
            <TmNotionPageSettingsMenu Page="Page"
                                      ReadOnly="ReadOnly"
                                      OnPageUpdated="OnPageSettingsUpdated"
                                      OnPageDeleted="HandlePageDeletedAsync"
                                      OnPageHistoryRequested="HandlePageHistoryRequestedAsync"
                                      OnPageInfoRequested="HandlePageInfoRequestedAsync"
                                      OnShareRequested="HandleShareRequestedAsync"
                                      OnRestrictionsRequested="HandleRestrictionsRequestedAsync"
                                      OnAISummarizeRequested="HandleAISummarizeRequestedAsync"
                                      OnAIAskPageRequested="HandleAIAskPageRequestedAsync"
                                      OnNavigateToImportedPage="HandleNavigateToImportedPageAsync" />
        </div>
    }

    @* ── Page header (cover + icon + title + description) ──────────────────── *@
    <TmNotionPageHeader Page="Page"
                        ReadOnly="ReadOnly"
                        ShowRestrictedIndicator="@(EffectivePermission is { Mode: not PageRestrictionMode.Open })"
                        UnresolvedCommentCount="_pageUnresolvedCommentCount"
                        OnPageUpdated="OnPageUpdated"
                        OnTitleEnterPressed="HandleTitleEnterPressedAsync"
                        OnCommentBadgeClicked="HandleCommentBadgeClickedAsync" />

    @* ── Content wrapper ────────────────────────────────────────────────────── *@
    <div class="tm-notion-page__content">

        @* ── Block list area ─────────────────────────────────────────────── *@
        <div class="tm-notion-page__blocks"
             data-page-blocks
             @onclick="OnContentAreaClickAsync">

            @if (_hasAggregateConflict)
            {
                <div class="tm-notion-load-error tm-notion-page__aggregate-conflict"
                     role="alert"
                     data-testid="@AggregateConflictTestId"
                     @onclick:stopPropagation="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                         class="tm-notion-load-error__icon">
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M12 7v5M12 16h.01" stroke="currentColor" stroke-width="1.75"
                              stroke-linecap="round"/>
                    </svg>
                    <span class="tm-notion-load-error__message">
                        <strong>@Loc["TmNotionTableBlock_ConflictTitle"]</strong>
                        @Loc["TmNotionPage_SaveConflict"]
                        @if (!string.IsNullOrWhiteSpace(_aggregateConflictError))
                        {
                            <span>@_aggregateConflictError</span>
                        }
                    </span>
                    <button type="button"
                            class="tm-notion-load-error__retry"
                            disabled="@_resolvingAggregateConflict"
                            @onclick="ReloadAggregateConflictAsync">
                        @Loc["TmNotionTableBlock_ConflictReload"]
                    </button>
                    <button type="button"
                            class="tm-notion-load-error__retry"
                            disabled="@_resolvingAggregateConflict"
                            @onclick="ReapplyAggregateConflictAsync">
                        @Loc["TmNotionTableBlock_ConflictReapply"]
                    </button>
                </div>
            }

            @if (_isLoadingBlocks)
            {
                <div class="tm-notion-loading" role="status" aria-busy="true"
                     aria-label="@Loc["TmNotionEditor_Loading"]">
                    <div class="tm-notion-skeleton tm-notion-skeleton--line" style="width:90%"></div>
                    <div class="tm-notion-skeleton tm-notion-skeleton--line" style="width:76%"></div>
                    <div class="tm-notion-skeleton tm-notion-skeleton--line-short"></div>
                    <div class="tm-notion-skeleton tm-notion-skeleton--line" style="width:83%"></div>
                </div>
            }
            else if (_loadBlocksError is not null)
            {
                <div class="tm-notion-load-error" role="alert">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                         class="tm-notion-load-error__icon">
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M12 7v5M12 16h.01" stroke="currentColor" stroke-width="1.75"
                              stroke-linecap="round"/>
                    </svg>
                    <span class="tm-notion-load-error__message">
                        @_loadBlocksError
                    </span>
                    <button type="button" class="tm-notion-load-error__retry" @onclick="RefreshAsync">
                        @Loc["Tm_Retry"]
                    </button>
                </div>
            }
            else if (_blocks.Count == 0 && !ReadOnly)
            {
                <div class="tm-notion-page__empty-hint"
                     role="button"
                     tabindex="0"
                     aria-label="@Loc["TmNotionPage_WriteHint"]"
                     @onclick="OnEmptyHintClickAsync"
                     @onkeydown="OnEmptyHintKeyDownAsync">
                    @Loc["TmNotionPage_WriteHint"]
                </div>
            }
            else
            {
                <CascadingValue Value="(IReadOnlyList<IPageBlock>)_blocks" Name="TmPageBlocks" IsFixed="false">
                    <TmNotionBlockList Blocks="_blocks"
                                       PageId="Page.Id"
                                       ReadOnly="ReadOnly"
                                       ActiveBlockId="_activeBlockId"
                                       BlockCommentCounts="_blockCommentCounts"
                                       OnReorder="HandleBlockReorderAsync"
                                       OnExternalBlockDropped="HandleExternalBlockDroppedAsync"
                                       OnExternalBlockRemoved="HandleExternalBlockRemovedAsync"
                                       OnBlockFocused="HandleBlockFocusedAsync"
                                       OnBlockDeleted="HandleBlockDeletedAsync"
                                       OnMergeBlockWithPrevious="args => MergeBlockIntoPreviousAsync(args.BlockId, args.Html)"
                                       OnBlockUpdated="HandleBlockUpdatedAsync"
                                       OnBlockDuplicated="HandleBlockDuplicatedAsync"
                                       OnConvertBlock="HandleConvertBlockAsync"
                                       OnAddBlockAfter="HandleAddBlockAfterAsync"
                                       OnInsertTemplateBlocksAfter="HandleInsertTemplateBlocksAfterAsync"
                                       OnAddBlockAtEnd="HandleAddBlockAtEndAsync"
                                       OnSlashMenu="HandleSlashMenuOpenedAsync"
                                       OnMentionMenu="HandleMentionMenuOpenedAsync"
                                       OnPageLinkMenu="HandlePageLinkMenuOpenedAsync"
                                       OnTokenMenu="HandleTokenMenuOpenedAsync"
                                       OnMoveFocus="HandleMoveFocusAsync"
                                       OnComment="HandleBlockCommentAsync"
                                       OnNewThread="HandleBlockNewThreadAsync" />
                </CascadingValue>
            }

        </div>

        <TmNotionPageReactions PageId="Page.Id" />

        @* ── Page comments panel ──────────────────────────────────────────── *@
        @if (Context.CommentProvider is not null)
        {
            <section class="tm-notion-page__comments"
                     aria-label="@Loc["TmNotionPage_CommentsLabel"]">
                <TmNotionPageCommentPanel PageId="@Page.Id.ToString()"
                                          Expanded="_pageCommentExpanded"
                                          OnExpandedChanged="HandlePageCommentExpandedChangedAsync"
                                          OnCountChanged="LoadPageUnresolvedCommentCountAsync" />
            </section>
        }

    </div>

</article>

@* ── Slash menu (portal — rendered outside the article scroll so position:fixed works) *@
<TmNotionSlashMenu Visible="_slashMenuVisible"
                   Top="_slashMenuTop"
                   Left="_slashMenuLeft"
                   OnItemSelected="HandleSlashItemSelectedAsync"
                   OnSlashItemSelected="HandleSlashMenuItemSelectedAsync"
                   OnAISelected="HandleSlashAISelectedAsync"
                   OnClosed="HandleSlashMenuClosedAsync" />

<TmNotionStatusPicker Visible="_statusPickerVisible"
                      Top="_statusPickerTop"
                      Left="_statusPickerLeft"
                      InitialLabel="@_statusInitialLabel"
                      InitialColor="_statusInitialColor"
                      OnInserted="HandleStatusInsertedAsync"
                      OnClosed="HandleStatusPickerClosedAsync" />

@* ── Mention menu (portal — position:fixed, outside scroll) *@
<TmNotionMentionMenu Visible="_mentionMenuVisible"
                     Top="_mentionMenuTop"
                     Left="_mentionMenuLeft"
                     PagesOnly="_mentionPagesOnly"
                     OnItemSelected="HandleMentionItemSelectedAsync"
                     OnClosed="HandleMentionMenuClosedAsync" />

@* ── Token dropdown (portal — position:fixed, outside scroll) *@
@if (Context.TokenProvider is not null)
{
    <TmNotionTokenDropdown Visible="_tokenDropdownVisible"
                           Top="_tokenDropdownTop"
                           Left="_tokenDropdownLeft"
                           CurrentKey="_tokenCurrentKey"
                           OnItemSelected="HandleTokenItemSelectedAsync"
                           OnClosed="HandleTokenDropdownClosedAsync"
                           OnCreateRequested="@(OnCreateTokenRequested is not null
                               ? EventCallback.Factory.Create<string>(this, HandleTokenCreateRequestedAsync)
                               : default)" />
}

@* ── Page history panel (portal — position:fixed) *@
<TmNotionPageHistory Visible="_historyVisible"
                     PageId="@Page.Id.ToString("D")"
                     OnClosed="() => { _historyVisible = false; StateHasChanged(); }"
                     OnRestored="HandleHistoryRestoredAsync" />

@* ── Page info panel (portal — position:fixed) *@
<TmNotionPageInfoPanel Page="Page"
                       Blocks="_blocks"
                       Visible="_pageInfoVisible"
                       VisibleChanged="HandlePageInfoVisibleChangedAsync" />

<TmNotionShareDialog PageId="Page.Id"
                     Provider="Context.PublicShareProvider"
                     Visible="_shareVisible"
                     VisibleChanged="HandleShareVisibleChangedAsync" />

<TmNotionRestrictionsDialog PageId="Page.Id"
                            Provider="Context.PermissionProvider"
                            EffectivePermission="EffectivePermission"
                            Visible="_restrictionsVisible"
                            VisibleChanged="HandleRestrictionsVisibleChangedAsync"
                            OnSaved="HandleRestrictionsSavedAsync" />

@* ── Inline formatting toolbar (portal — position:fixed, outside scroll) *@
<TmNotionInlineToolbar Visible="_toolbarVisible"
                       Top="_toolbarTop"
                       Left="_toolbarLeft"
                       IsBold="_toolbarIsBold"
                       IsItalic="_toolbarIsItalic"
                       IsUnderline="_toolbarIsUnderline"
                       IsStrikethrough="_toolbarIsStrikethrough"
                       IsCode="_toolbarIsCode"
                       CurrentHref="@_toolbarCurrentHref"
                       CurrentAlign="_toolbarCurrentAlign"
                       OnTurnInto="HandleToolbarTurnIntoAsync"
                       OnAlignChange="HandleToolbarAlignAsync"
                       OnComment="HandleTextCommentAsync"
                       ShowAI="@(Context.AIProvider is not null)"
                       OnAI="HandleToolbarAIAsync"
                       BlockId="@_toolbarBlockId"
                       DotNetRef="@_toolbarDotNetRef" />

<TmNotionAiMenu Visible="_aiMenuVisible"
                Top="_aiMenuTop"
                Left="_aiMenuLeft"
                Panel="_aiMenuPanel"
                InitialMode="_aiMenuMode"
                PageId="@Page.Id.ToString("D")"
                SourceText="@_aiSourceText"
                ContextHtml="@_aiContextHtml"
                OnAccepted="HandleAIAcceptedAsync"
                OnClosed="HandleAIClosedAsync" />

@* ── Block comment panel (portal — position:fixed) *@
<TmNotionBlockCommentPanel Visible="@_blockCommentVisible"
                           BlockId="@_blockCommentBlockId"
                           Top="@_blockCommentTop"
                           Left="@_blockCommentLeft"
                           StartInNewThreadMode="@_blockCommentStartInNewThreadMode"
                           OnClosed="HandleBlockCommentClosedAsync"
                           OnCountChanged="async _ => await HandleBlockCommentCountChangedAsync(_blockCommentBlockId)" />

@* ── Text comment panel (portal — position:fixed) *@
<TmNotionTextCommentPanel Visible="@_textCommentVisible"
                          CommentId="@_textCommentId"
                          BlockId="@_textCommentBlockId"
                          StartOffset="@_textCommentStartOffset"
                          EndOffset="@_textCommentEndOffset"
                          HighlightedText="@_textCommentHighlight"
                          Top="@_textCommentTop"
                          Left="@_textCommentLeft"
                          OnClosed="HandleTextCommentClosedAsync"
                          OnResolved="HandleTextCommentResolvedAsync"
                          OnCountChanged="_ => StateHasChanged()" />
