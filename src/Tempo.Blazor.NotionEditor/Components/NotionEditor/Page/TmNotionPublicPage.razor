@namespace Tempo.Blazor.Components.NotionEditor.Page
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Components.NotionEditor
@using Tempo.Blazor.NotionEditor.Interfaces

<section class="tm-npp @Class" data-testid="@TestId("notion-public-page")">
    @if (_loading)
    {
        <div class="tm-npp__state" role="status" aria-busy="true">
            <span class="tm-npp__spinner" aria-hidden="true"></span>
            @Loc["Tm_Loading"]
        </div>
    }
    else if (_share is null)
    {
        <div class="tm-npp__state tm-npp__state--empty" data-testid="@TestId("notion-public-not-found")">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                <path d="M9 13h10M11 17h6M8 4.5h8l4 4v15H8z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M16 4.5v4h4" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            </svg>
            <h1>@Loc["Notion_Share_NotFoundTitle"]</h1>
            <p>@Loc["Notion_Share_Disabled"]</p>
        </div>
    }
    else
    {
        <header class="tm-npp__header">
            <div class="tm-npp__heading">
                @if (!string.IsNullOrEmpty(_pageIconEmoji))
                {
                    <span class="tm-npp__icon" aria-hidden="true">@_pageIconEmoji</span>
                }
                else if (!string.IsNullOrEmpty(_pageIconImageUrl))
                {
                    <img class="tm-npp__icon tm-npp__icon--image" src="@_pageIconImageUrl" alt="" aria-hidden="true" />
                }
                <h1 class="tm-npp__title">@(string.IsNullOrWhiteSpace(_pageTitle) ? Loc["Notion_Share_PublicPage"] : _pageTitle)</h1>
                <span class="tm-npp__shared" data-testid="@TestId("notion-public-shared")">@Loc["TmNotionPublicPage_SharedLabel"]</span>
            </div>
            <div class="tm-npp__meta">
                <p>@Loc["Notion_Share_ReadOnlyNotice"]</p>
                @if (_share.ExpiresAt is not null)
                {
                    <span class="tm-npp__expires">
                        <TmIcon Name="@IconNames.Calendar" Size="IconSize.Sm" />
                        @Loc["Notion_Share_ExpiresOn", _share.ExpiresAt.Value.ToLocalTime().ToString("d")]
                    </span>
                }
            </div>
        </header>

        <div class="tm-npp__editor">
            <TmNotionEditor DataProvider="DataProvider"
                            AggregateProvider="AggregateProvider"
                            CommentProvider="@(_share.AllowComments ? CommentProvider : null)"
                            InitialPageId="@_share.PageId.ToString("D")"
                            ShowSidebar="false"
                            ReadOnly="@true"
                            Chrome="NotionEditorChrome.Minimal"
                            CurrentUserId="anonymous"
                            OnPageChanged="OnEditorPageChanged"
                            Class="tm-npp__editor-inner tm-notion-editor--locked" />
        </div>
    }
</section>
