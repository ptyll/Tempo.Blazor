@namespace Tempo.Blazor.Components.NotionEditor.Page
@using Tempo.Blazor.NotionEditor.Interfaces
@using Tempo.Blazor.NotionEditor.Models

@if (Visible)
{
    <div class="tm-nprd-backdrop" aria-hidden="true" @onclick="CloseAsync"></div>
    <section class="tm-nprd"
             role="dialog"
             aria-modal="true"
             aria-labelledby="tm-nprd-title"
             @onclick:stopPropagation="true">
        <header class="tm-nprd__header">
            <div>
                <h2 id="tm-nprd-title">@Loc["Notion_Restrictions_Title"]</h2>
                @if (EffectivePermission?.IsInherited == true)
                {
                    <p class="tm-nprd__inherited">@Loc["Notion_Restrictions_Inherited"]</p>
                }
            </div>
            <button class="tm-nprd__icon-btn"
                    type="button"
                    aria-label="@Loc["Tm_Close"]"
                    title="@Loc["Tm_Close"]"
                    @onclick="CloseAsync">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </button>
        </header>

        @if (_loading)
        {
            <div class="tm-nprd__loading" role="status" aria-busy="true">
                <span class="tm-nprd__spinner" aria-hidden="true"></span>
                @Loc["Tm_Loading"]
            </div>
        }
        else
        {
            <div class="tm-nprd__field">
                <label for="tm-nprd-mode">@Loc["Notion_Restrictions_Mode"]</label>
                <select id="tm-nprd-mode" class="tm-nprd__select" value="@_mode" @onchange="HandleModeChanged">
                    <option value="@PageRestrictionMode.Open">@Loc["Notion_Restrictions_ModeOpen"]</option>
                    <option value="@PageRestrictionMode.ReadOnlyForSome">@Loc["Notion_Restrictions_ModeReadOnlyForSome"]</option>
                    <option value="@PageRestrictionMode.EditForSome">@Loc["Notion_Restrictions_ModeEditForSome"]</option>
                </select>
            </div>

            <div class="tm-nprd__add" role="group" aria-label="@Loc["Notion_Restrictions_AddUser"]">
                <select class="tm-nprd__select tm-nprd__select--compact"
                        aria-label="@Loc["Notion_Restrictions_SubjectType"]"
                        value="@_newSubjectType"
                        @onchange="HandleSubjectTypeChanged">
                    <option value="@PageRestrictionSubjectType.User">@Loc["Notion_Restrictions_User"]</option>
                    <option value="@PageRestrictionSubjectType.Group">@Loc["Notion_Restrictions_Group"]</option>
                </select>
                <input class="tm-nprd__input"
                       type="text"
                       aria-label="@Loc["Notion_Restrictions_Subject"]"
                       placeholder="@Loc["Notion_Restrictions_SubjectPlaceholder"]"
                       value="@_newSubjectId"
                       @oninput="e => _newSubjectId = e.Value?.ToString() ?? string.Empty" />
                <select class="tm-nprd__select tm-nprd__select--compact"
                        aria-label="@Loc["Notion_Restrictions_Permission"]"
                        value="@_newPermission"
                        @onchange="HandlePermissionChanged">
                    <option value="@PageRestrictionPermission.View">@Loc["Notion_Restrictions_View"]</option>
                    <option value="@PageRestrictionPermission.Comment">@Loc["Notion_Restrictions_Comment"]</option>
                    <option value="@PageRestrictionPermission.Edit">@Loc["Notion_Restrictions_Edit"]</option>
                </select>
                <button class="tm-nprd__add-btn"
                        type="button"
                        disabled="@string.IsNullOrWhiteSpace(_newSubjectId)"
                        @onclick="AddEntry">
                    @(_newSubjectType == PageRestrictionSubjectType.User
                        ? Loc["Notion_Restrictions_AddUser"]
                        : Loc["Notion_Restrictions_AddGroup"])
                </button>
            </div>

            @if (_entries.Count == 0)
            {
                <div class="tm-nprd__empty">@Loc["Notion_Restrictions_Empty"]</div>
            }
            else
            {
                <div class="tm-nprd__entries" role="list">
                    @foreach (var entry in _entries)
                    {
                        var captured = entry;
                        <div class="tm-nprd__entry" role="listitem">
                            <span class="tm-nprd__subject-kind">@SubjectTypeText(captured.SubjectType)</span>
                            <span class="tm-nprd__subject" title="@captured.SubjectId">@captured.SubjectId</span>
                            <span class="tm-nprd__source">@Loc["Notion_Restrictions_Explicit"]</span>
                            <select class="tm-nprd__select tm-nprd__select--entry"
                                    aria-label="@Loc["Notion_Restrictions_Permission"]"
                                    value="@captured.Permission"
                                    @onchange="e => UpdateEntryPermission(captured, e)">
                                <option value="@PageRestrictionPermission.View">@Loc["Notion_Restrictions_View"]</option>
                                <option value="@PageRestrictionPermission.Comment">@Loc["Notion_Restrictions_Comment"]</option>
                                <option value="@PageRestrictionPermission.Edit">@Loc["Notion_Restrictions_Edit"]</option>
                            </select>
                            <button class="tm-nprd__icon-btn"
                                    type="button"
                                    aria-label="@Loc["Notion_Restrictions_Remove"]"
                                    title="@Loc["Notion_Restrictions_Remove"]"
                                    @onclick="() => RemoveEntry(captured)">
                                <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                                    <path d="M3 4h9M6 4V2.7h3V4M5 6.2v4.2M10 6.2v4.2M4 4l.5 8h6L11 4"
                                          stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                                </svg>
                            </button>
                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="tm-nprd__error" role="alert">@_error</div>
            }

            <footer class="tm-nprd__footer">
                <button class="tm-nprd__secondary" type="button" @onclick="CloseAsync">
                    @Loc["Tm_Cancel"]
                </button>
                <button class="tm-nprd__primary" type="button" disabled="@_saving" @onclick="SaveAsync">
                    @if (_saving)
                    {
                        <span class="tm-nprd__spinner" aria-hidden="true"></span>
                    }
                    @Loc["Tm_Save"]
                </button>
            </footer>
        }
    </section>
}
