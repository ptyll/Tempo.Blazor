@namespace Tempo.Blazor.Components.NotionEditor.Page
@using Tempo.Blazor.NotionEditor.Interfaces
@using Tempo.Blazor.NotionEditor.Models
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Abstractions.Layout

@* Phase 7 (N8): restrictions ride the core TmModal. The footer (including "Remove restrictions")
   sits outside the scrolling body. Records become cards on a mobile layout. *@
<TmModal Show="Visible"
         OnClose="CloseAsync"
         Title="@Loc["Notion_Restrictions_Title"]"
         Size="ModalSize.Large"
         MobilePresentation="MobilePresentation.Sheet"
         LayoutMode="ResolvedLayout"
         CloseOnOverlayClick="false"
         Class="tm-nprd-host"
         data-testid="notion-restrictions-dialog">
    <ChildContent>
        @if (_loading)
        {
            <div class="tm-nprd__loading" role="status" aria-busy="true">
                <span class="tm-nprd__spinner" aria-hidden="true"></span>
                @Loc["Tm_Loading"]
            </div>
        }
        else
        {
            <div class="tm-nprd" data-layout="@ResolvedLayout.ToString().ToLowerInvariant()">
                @if (EffectivePermission?.IsInherited == true)
                {
                    <TmAlert Severity="AlertSeverity.Info"
                             Variant="AlertVariant.Soft"
                             Class="tm-nprd__banner"
                             role="status"
                             data-testid="notion-restrictions-inherited">
                        @Loc["Notion_Restrictions_Inherited"]
                    </TmAlert>
                }

                <section class="tm-nprd__section" aria-labelledby="tm-nprd-mode-heading">
                    <h3 id="tm-nprd-mode-heading" class="tm-nprd__heading">@Loc["Notion_Restrictions_Mode"]</h3>
                    <label class="tm-nprd__field tm-sr-only" for="tm-nprd-mode">@Loc["Notion_Restrictions_Mode"]</label>
                    <select id="tm-nprd-mode" class="tm-nprd__select" value="@_mode" @onchange="HandleModeChanged">
                        <option value="@PageRestrictionMode.Open">@Loc["Notion_Restrictions_ModeOpen"]</option>
                        <option value="@PageRestrictionMode.ReadOnlyForSome">@Loc["Notion_Restrictions_ModeReadOnlyForSome"]</option>
                        <option value="@PageRestrictionMode.EditForSome">@Loc["Notion_Restrictions_ModeEditForSome"]</option>
                    </select>
                </section>

                <section class="tm-nprd__section" aria-labelledby="tm-nprd-people-heading">
                    <h3 id="tm-nprd-people-heading" class="tm-nprd__heading">@Loc["Notion_Restrictions_People"]</h3>
                    <form class="tm-nprd__add"
                          data-testid="notion-restrictions-add-form"
                          @onsubmit="AddEntry"
                          @onsubmit:preventDefault="true">
                        <select class="tm-nprd__select tm-nprd__select--compact"
                                aria-label="@Loc["Notion_Restrictions_SubjectType"]"
                                value="@_newSubjectType"
                                @onchange="HandleSubjectTypeChanged">
                            <option value="@PageRestrictionSubjectType.User">@Loc["Notion_Restrictions_User"]</option>
                            <option value="@PageRestrictionSubjectType.Group">@Loc["Notion_Restrictions_Group"]</option>
                        </select>
                        <input class="tm-nprd__input"
                               type="text"
                               aria-label="@Loc["Notion_Restrictions_Subject"]"
                               placeholder="@Loc["Notion_Restrictions_SubjectPlaceholder"]"
                               value="@_newSubjectId"
                               data-testid="notion-restrictions-subject"
                               @oninput="e => _newSubjectId = e.Value?.ToString() ?? string.Empty" />
                        <select class="tm-nprd__select tm-nprd__select--compact"
                                aria-label="@Loc["Notion_Restrictions_Permission"]"
                                value="@_newPermission"
                                @onchange="HandlePermissionChanged">
                            <option value="@PageRestrictionPermission.View">@Loc["Notion_Restrictions_View"]</option>
                            <option value="@PageRestrictionPermission.Comment">@Loc["Notion_Restrictions_Comment"]</option>
                            <option value="@PageRestrictionPermission.Edit">@Loc["Notion_Restrictions_Edit"]</option>
                        </select>
                        <TmButton Type="ButtonType.Submit"
                                  Variant="ButtonVariant.Secondary"
                                  Class="tm-nprd__add-btn"
                                  Disabled="@string.IsNullOrWhiteSpace(_newSubjectId)">
                            @(_newSubjectType == PageRestrictionSubjectType.User
                                ? Loc["Notion_Restrictions_AddUser"]
                                : Loc["Notion_Restrictions_AddGroup"])
                        </TmButton>
                    </form>
                </section>

                <div class="tm-nprd__scroll" data-testid="notion-restrictions-scroll">
                    @if (_entries.Count == 0)
                    {
                        <div class="tm-nprd__empty">@Loc["Notion_Restrictions_Empty"]</div>
                    }
                    else
                    {
                        <div class="tm-nprd__entries" role="list">
                            @foreach (var entry in _entries)
                            {
                                var captured = entry;
                                <div class="tm-nprd__entry" role="listitem" data-testid="notion-restrictions-entry">
                                    <TmIcon Name="@(captured.SubjectType == PageRestrictionSubjectType.User ? IconNames.User : IconNames.Users)"
                                            Size="IconSize.Sm" />
                                    <span class="tm-nprd__subject-kind">@SubjectTypeText(captured.SubjectType)</span>
                                    <span class="tm-nprd__subject" title="@captured.SubjectId">@captured.SubjectId</span>
                                    <span class="tm-nprd__source">@Loc["Notion_Restrictions_Explicit"]</span>
                                    <select class="tm-nprd__select tm-nprd__select--entry"
                                            aria-label="@Loc["Notion_Restrictions_Permission"]"
                                            value="@captured.Permission"
                                            @onchange="e => UpdateEntryPermission(captured, e)">
                                        <option value="@PageRestrictionPermission.View">@Loc["Notion_Restrictions_View"]</option>
                                        <option value="@PageRestrictionPermission.Comment">@Loc["Notion_Restrictions_Comment"]</option>
                                        <option value="@PageRestrictionPermission.Edit">@Loc["Notion_Restrictions_Edit"]</option>
                                    </select>
                                    <button class="tm-nprd__icon-btn"
                                            type="button"
                                            aria-label="@Loc["Notion_Restrictions_Remove"]"
                                            title="@Loc["Notion_Restrictions_Remove"]"
                                            @onclick="() => RemoveEntry(captured)">
                                        <TmIcon Name="@IconNames.Trash2" Size="IconSize.Xs" />
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="tm-nprd__error" role="alert">@_error</div>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        @if (!_loading)
        {
            <div class="tm-nprd__footer">
                <TmButton Variant="ButtonVariant.Danger"
                          Disabled="_saving"
                          OnClick="RemoveRestrictions"
                          data-testid="notion-restrictions-remove-all">
                    @Loc["Notion_Restrictions_RemoveAll"]
                </TmButton>
                <div class="tm-nprd__footer-end">
                    <TmButton Variant="ButtonVariant.Ghost" OnClick="CloseAsync">@Loc["Tm_Cancel"]</TmButton>
                    <TmButton Variant="ButtonVariant.Primary"
                              Class="tm-nprd__primary"
                              Disabled="_saving"
                              OnClick="SaveAsync"
                              data-testid="notion-restrictions-save">
                        @Loc["Tm_Save"]
                    </TmButton>
                </div>
            </div>
        }
    </Footer>
</TmModal>
