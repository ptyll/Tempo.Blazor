@namespace Tempo.Blazor.Components.NotionEditor.Page
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.NotionEditor.Interfaces
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Components.Inputs

@* Phase 7 (N8): the share dialog rides the core TmModal — a sheet on mobile. No own backdrop
   or z-index. An active link keeps its fields locked (NO5); revoking asks first. *@
<TmModal Show="Visible"
         OnClose="CloseAsync"
         Title="@Loc["Notion_Share_Title"]"
         Subtitle="@Loc["Notion_Share_AnonymousReadOnly"]"
         Size="ModalSize.Medium"
         MobilePresentation="MobilePresentation.Sheet"
         LayoutMode="LayoutMode"
         CloseOnOverlayClick="false"
         Class="tm-npsd-host"
         data-testid="@TestId("notion-share-dialog")">
    <ChildContent>
        @if (_loading)
        {
            <div class="tm-npsd__loading" role="status" aria-busy="true">
                <span class="tm-npsd__spinner" aria-hidden="true"></span>
                @Loc["Tm_Loading"]
            </div>
        }
        else
        {
            <div class="tm-npsd">
                <div class="tm-npsd__status @StatusClass" data-testid="@StatusTestId">
                    <span class="tm-npsd__status-dot" aria-hidden="true"></span>
                    <span>@StatusText</span>
                </div>

                @if (IsShareUsable)
                {
                    <p id="tm-npsd-locked-hint" class="tm-npsd__hint" data-testid="@TestId("notion-share-locked-hint")">
                        <TmIcon Name="@IconNames.Lock" Size="IconSize.Xs" />
                        @Loc["Notion_Share_LockedHint"]
                    </p>
                }
                else
                {
                    <p class="tm-npsd__hint">@Loc["Notion_Share_CreateHint"]</p>
                }

                <TmToggle Value="_allowComments"
                          ValueChanged="HandleAllowCommentsChanged"
                          Label="@Loc["Notion_Share_AllowComments"]"
                          Disabled="@(_saving || IsShareUsable)"
                          AriaDescribedBy="@(IsShareUsable ? "tm-npsd-locked-hint" : null)"
                          Class="tm-npsd__toggle"
                          data-testid="@TestId("notion-share-allow-comments")" />

                <div class="tm-npsd__field">
                    <label for="tm-npsd-expires">@Loc["Notion_Share_Expires"]</label>
                    <input id="tm-npsd-expires"
                           class="tm-npsd__input"
                           type="date"
                           value="@ExpiresValue"
                           disabled="@(_saving || IsShareUsable)"
                           aria-describedby="@(IsShareUsable ? "tm-npsd-locked-hint" : null)"
                           data-testid="@TestId("notion-share-expires")"
                           @onchange="HandleExpiresChanged" />
                </div>

                @if (IsShareUsable)
                {
                    <div class="tm-npsd__field">
                        <label for="tm-npsd-url">@Loc["Notion_Share_PublicUrl"]</label>
                        <div class="tm-npsd__url-row">
                            <input id="tm-npsd-url"
                                   class="tm-npsd__input tm-npsd__input--url"
                                   type="text"
                                   value="@ShareUrl"
                                   readonly
                                   data-testid="@TestId("notion-share-url")" />
                            <TmCopyButton Text="@ShareUrl"
                                          ShowLabel="true"
                                          Class="tm-npsd__copy"
                                          data-testid="@TestId("notion-share-copy")"
                                          OnCopied="AnnounceCopied" />
                        </div>
                        <p class="tm-npsd__live" role="status" aria-live="polite" data-testid="@TestId("notion-share-copied")">@_copied</p>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="tm-npsd__error" role="alert">@_error</div>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        @if (!_loading)
        {
            <div class="tm-npsd__footer tm-npsd__footer--split" data-testid="@TestId("notion-share-footer")">
                <TmButton Variant="ButtonVariant.Ghost" OnClick="CloseAsync">@Loc["Tm_Close"]</TmButton>
                <div class="tm-npsd__footer-end">
                    @if (IsShareUsable)
                    {
                        <TmButton Variant="ButtonVariant.Danger"
                                  Disabled="_saving"
                                  OnClick="AskRevoke"
                                  data-testid="@TestId("notion-share-revoke")">
                            @Loc["Notion_Share_Revoke"]
                        </TmButton>
                    }
                    else
                    {
                        <TmButton Variant="ButtonVariant.Primary"
                                  Disabled="_saving"
                                  OnClick="CreateAsync"
                                  data-testid="@TestId("notion-share-create")">
                            @Loc["Notion_Share_CreateLink"]
                        </TmButton>
                    }
                </div>
            </div>
        }
    </Footer>
</TmModal>

<TmDialog Show="_confirmRevoke"
          Type="DialogType.Confirm"
          Variant="DialogVariant.Warning"
          IsDangerous="true"
          Title="@Loc["Notion_Share_RevokeConfirmTitle"]"
          Message="@Loc["Notion_Share_RevokeConfirmBody"]"
          OkButtonText="@Loc["Notion_Share_Revoke"]"
          CancelButtonText="@Loc["Tm_Cancel"]"
          LayoutMode="ResolvedLayout"
          OnResult="HandleRevokeResult"
          data-testid="@TestId("notion-share-revoke-confirm")" />
