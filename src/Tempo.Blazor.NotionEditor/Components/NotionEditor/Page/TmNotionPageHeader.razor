@namespace Tempo.Blazor.Components.NotionEditor.Page
@using Tempo.Blazor.NotionEditor.Interfaces
@using Tempo.Blazor.Components.NotionEditor.Services
@using Tempo.Blazor.Components.Overlay
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Components.Avatars

@* ── Cover image ─────────────────────────────────────────────────────────── *@
@if (!string.IsNullOrEmpty(Page.CoverImageUrl))
{
    <div class="tm-notion-header-cover @(!ReadOnly ? "tm-notion-header-cover--editable" : "")"
         style="@CoverStyle"
         @ref="_coverRef"
         @onmousedown="OnCoverMouseDownAsync"
         @onmousedown:preventDefault="true">

        @if (!ReadOnly)
        {
            <div class="tm-notion-header-cover__actions">
                <button class="tm-notion-header-cover__btn"
                        type="button"
                        @onclick="ToggleCoverDialog"
                        @onclick:stopPropagation="true"
                        @onmousedown:stopPropagation="true">
                    @Loc["TmNotionPage_ChangeCover"]
                </button>
                <button class="tm-notion-header-cover__btn tm-notion-header-cover__btn--remove"
                        type="button"
                        @onclick="RemoveCoverAsync"
                        @onclick:stopPropagation="true"
                        @onmousedown:stopPropagation="true">
                    @Loc["TmNotionPage_RemoveCover"]
                </button>
            </div>
            <div class="tm-notion-header-cover__drag-hint" aria-hidden="true">
                @Loc["TmNotionPageHeader_DragToReposition"]
            </div>
        }
    </div>
}

@* ── Cover dialog — core TmModal (phase 4): visible title, ×, Escape, focus return. *@
<TmModal Show="_showCoverDialog"
         OnClose="CloseCoverDialog"
         Title="@Loc["TmNotionPageHeader_CoverDialogTitle"]"
         Class="tm-notion-cover-dialog"
         Size="ModalSize.Small"
         MobilePresentation="MobilePresentation.Auto"
         LayoutMode="LayoutMode"
         InitialFocusSelector="#tm-notion-cover-url">
    <ChildContent>
        <div class="tm-notion-cover-dialog__body">
            <label class="tm-notion-cover-dialog__label" for="tm-notion-cover-url">@Loc["TmNotionPageHeader_CoverUrl"]</label>
            <div class="tm-notion-cover-dialog__input-row">
                <input class="tm-notion-cover-dialog__input"
                       id="tm-notion-cover-url"
                       type="url"
                       placeholder="https://..."
                       @bind="_coverUrlInput"
                       @bind:event="oninput"
                       @onkeydown="OnCoverUrlKeyDown" />
            </div>
            <p class="tm-notion-cover-dialog__label">@Loc["TmNotionPageHeader_CoverPresets"]</p>
            <div class="tm-notion-cover-dialog__presets"
                 role="group"
                 aria-label="@Loc["TmNotionPageHeader_CoverPresets"]">
                @foreach (var preset in _coverPresets)
                {
                    var isCurrent = IsCurrentPreset(preset);
                    <button class="tm-notion-cover-dialog__preset @(isCurrent ? "tm-notion-cover-dialog__preset--current" : "")"
                            type="button"
                            title="@preset.Label"
                            aria-label="@preset.Label"
                            aria-pressed="@(isCurrent ? "true" : "false")"
                            style="background:@preset.Background"
                            @onclick="() => ApplyCoverPresetAsync(preset)">
                        @if (isCurrent)
                        {
                            <span class="tm-notion-cover-dialog__preset-check" aria-hidden="true">✓</span>
                        }
                    </button>
                }
            </div>
        </div>
    </ChildContent>
    <Footer>
        <TmButton Variant="ButtonVariant.Ghost" OnClick="CloseCoverDialog">@Loc["Tm_Cancel"]</TmButton>
        <TmButton Variant="ButtonVariant.Primary"
                  Disabled="@string.IsNullOrWhiteSpace(_coverUrlInput)"
                  OnClick="SaveCoverUrlAsync">
            @Loc["TmNotionPageHeader_SetCover"]
        </TmButton>
    </Footer>
</TmModal>

@* ── Page meta (icon + title + description) ───────────────────────────────── *@
<div class="tm-notion-header-meta @(Page.CoverImageUrl is not null ? "tm-notion-header-meta--with-cover" : "")">

    @* Icon *@
    @if (!string.IsNullOrEmpty(Page.IconEmoji))
    {
        <button class="tm-notion-header-icon tm-notion-header-icon--emoji"
                type="button"
                disabled="@ReadOnly"
                aria-label="@Loc["TmNotionPage_IconLabel"]"
                title="@Loc["TmNotionPage_IconLabel"]"
                @onclick="ToggleIconPickerAsync">
            @Page.IconEmoji
        </button>
    }
    else if (!string.IsNullOrEmpty(Page.IconImageUrl))
    {
        <button class="tm-notion-header-icon tm-notion-header-icon--image"
                type="button"
                disabled="@ReadOnly"
                aria-label="@Loc["TmNotionPage_IconLabel"]"
                @onclick="ToggleIconPickerAsync">
            <img src="@Page.IconImageUrl" alt="" aria-hidden="true" />
        </button>
    }

    @* Quick-add hover buttons *@
    @if (!ReadOnly)
    {
        <div class="tm-notion-header-meta__add-row">
            @if (string.IsNullOrEmpty(Page.IconEmoji) && string.IsNullOrEmpty(Page.IconImageUrl))
            {
                <button class="tm-notion-header-meta__add-btn" type="button" @onclick="ToggleIconPickerAsync">
                    @Loc["TmNotionPage_AddIcon"]
                </button>
            }
            @if (string.IsNullOrEmpty(Page.CoverImageUrl))
            {
                <button class="tm-notion-header-meta__add-btn" type="button" @onclick="ToggleCoverDialog">
                    @Loc["TmNotionPage_AddCover"]
                </button>
            }
            @if (!_showDescription && string.IsNullOrEmpty(Page.Description))
            {
                <button class="tm-notion-header-meta__add-btn" type="button" @onclick="ShowDescriptionAsync">
                    @Loc["TmNotionPageHeader_AddDescription"]
                </button>
            }
        </div>
    }

    @* Title + comment badge *@
    <div class="tm-notion-header-title-row">
        <h1 class="tm-notion-header-title tm-notion-editable tm-notion-h1
                   @(ReadOnly ? "" : "tm-notion-header-title--editable")"
            contenteditable="@(!ReadOnly ? "true" : "false")"
            data-placeholder="@Loc["TmNotionPage_TitlePlaceholder"]"
            spellcheck="true"
            aria-label="@Loc["TmNotionPage_TitlePlaceholder"]"
            @ref="_titleRef"
            @oninput="OnTitleInput"
            @onblur="OnTitleBlurAsync"
            @onkeydown="OnTitleKeyDownAsync">
        </h1>

        @if (UnresolvedCommentCount > 0 && !ShowMeta)
        {
            <button class="tm-notion-header-comment-badge"
                    type="button"
                    title="@Loc.Plural("TmNotionPageHeader_UnresolvedComments", UnresolvedCommentCount)"
                    aria-label="@Loc.Plural("TmNotionPageHeader_UnresolvedComments", UnresolvedCommentCount)"
                    @onclick="OnCommentBadgeClicked"
                    @onclick:stopPropagation="true">
                @UnresolvedCommentCount
            </button>
        }
    </div>

    @if (ShowRestrictedIndicator)
    {
        <div class="tm-notion-header-permissions">
            <span class="tm-notion-header-restricted-badge"
                  role="status"
                  aria-label="@Loc["Notion_Restrictions_Title"]">
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                    <path d="M3.25 5.5V4.1a3.25 3.25 0 1 1 6.5 0v1.4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
                    <rect x="2.25" y="5.4" width="8.5" height="6.1" rx="1.6" fill="currentColor" opacity=".78"/>
                </svg>
                @Loc["Notion_Restrictions_Title"]
            </span>
        </div>
    }

    @* Description *@
    @if (_showDescription || !string.IsNullOrEmpty(Page.Description))
    {
        <div class="tm-notion-header-description-wrap">
            <div class="tm-notion-header-description tm-notion-editable"
                 contenteditable="@(!ReadOnly ? "true" : "false")"
                 data-placeholder="@Loc["TmNotionPageHeader_DescriptionPlaceholder"]"
                 aria-label="@Loc["TmNotionPageHeader_DescriptionPlaceholder"]"
                 @ref="_descRef"
                 @oninput="OnDescriptionInput"
                 @onblur="OnDescriptionBlurAsync">
            </div>
            @if (!ReadOnly && _showDescription && string.IsNullOrEmpty(Page.Description))
            {
                <button class="tm-notion-header-description-wrap__remove"
                        type="button"
                        aria-label="@Loc["TmNotionPageHeader_RemoveDescription"]"
                        title="@Loc["TmNotionPageHeader_RemoveDescription"]"
                        @onclick="HideDescriptionAsync">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path d="M2 2l8 8M10 2L2 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                </button>
            }
        </div>
    }

    @* Meta row (phase 5, N2; opt-in via ShowMeta) *@
    @if (ShowMeta)
    {
        <div class="tm-notion-header-meta-row" data-testid="notion-page-meta">
            @if (Page.LastEditedAt is { } lastEdited && lastEdited != default)
            {
                <span class="tm-notion-header-meta-row__item">
                    <TmIcon Name="@IconNames.Clock" Size="IconSize.Xs" />
                    <span class="tm-notion-header-meta-row__label">@Loc["TmNotionPageHeader_MetaLastEdited"]</span>
                    <time class="tm-notion-header-meta-row__time"
                          datetime="@lastEdited.ToString("O")"
                          title="@AbsoluteTime(lastEdited)">
                        @RelativeTime.Format(lastEdited)
                    </time>
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(Page.LastEditedByUserId))
            {
                <span class="tm-notion-header-meta-row__item">
                    <TmAvatar Name="@_lastEditorName" Size="AvatarSize.Xs" Alt="@_lastEditorName" />
                    <span class="tm-notion-header-meta-row__author">@_lastEditorName</span>
                </span>
            }
            @if (UnresolvedCommentCount > 0)
            {
                <button class="tm-notion-header-meta-row__item tm-notion-header-meta-row__comment-link"
                        type="button"
                        data-testid="notion-page-meta-comments"
                        title="@Loc.Plural("TmNotionPageHeader_UnresolvedComments", UnresolvedCommentCount)"
                        aria-label="@Loc.Plural("TmNotionPageHeader_UnresolvedComments", UnresolvedCommentCount)"
                        @onclick="OnCommentBadgeClicked"
                        @onclick:stopPropagation="true">
                    <TmIcon Name="@IconNames.MessageSquare" Size="IconSize.Xs" />
                    @Loc.Plural("TmNotionPageHeader_MetaComments", UnresolvedCommentCount)
                </button>
            }
        </div>
    }

</div>

@* ── Emoji picker — core TmModal (phase 4): titled, × closes, Escape handled by the focus trap,
   focus returns to the icon trigger. On a mobile layout the core sheet presents it. *@
@if (_showIconPicker && !ReadOnly)
{
    <TmModal Show="true"
             OnClose="CloseIconPicker"
             Title="@Loc["TmNotionPageHeader_EmojiPickerTitle"]"
             Size="ModalSize.Small"
             MobilePresentation="MobilePresentation.Auto"
             LayoutMode="LayoutMode"
             InitialFocusSelector=".tm-notion-emoji-picker__search">
        <ChildContent>
            <div class="tm-notion-emoji-picker__panel">
                <div class="tm-notion-emoji-picker__header">
                    <input class="tm-notion-emoji-picker__search"
                           type="text"
                           autocomplete="off"
                           aria-label="@Loc["TmNotionPageHeader_EmojiSearch"]"
                           placeholder="@Loc["TmNotionPageHeader_EmojiSearch"]"
                           @bind="_emojiSearch"
                           @bind:event="oninput" />
                    <button class="tm-notion-emoji-picker__remove"
                            type="button"
                            @onclick="RemoveIconAsync">
                        @Loc["TmNotionPageHeader_RemoveIcon"]
                    </button>
                </div>
                <div class="tm-notion-emoji-picker__body">
                    @if (_recentEmojis.Count > 0 && string.IsNullOrWhiteSpace(_emojiSearch))
                    {
                        <div class="tm-notion-emoji-picker__category tm-notion-emoji-picker__category--recent">
                            <div class="tm-notion-emoji-picker__category-label">@Loc["TmNotionEmojiPicker_RecentlyUsed"]</div>
                            <div class="tm-notion-emoji-picker__grid">
                                @foreach (var recent in _recentEmojis)
                                {
                                    var captured = recent;
                                    <button class="tm-notion-emoji-picker__btn"
                                            type="button"
                                            title="@captured"
                                            aria-label="@captured"
                                            @onclick="() => SelectEmojiAsync(captured)">
                                        @captured
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    @foreach (var cat in FilteredCategories)
                    {
                        <div class="tm-notion-emoji-picker__category">
                            <div class="tm-notion-emoji-picker__category-label">@cat.Name</div>
                            <div class="tm-notion-emoji-picker__grid">
                                @foreach (var emoji in cat.Emojis)
                                {
                                    <button class="tm-notion-emoji-picker__btn"
                                            type="button"
                                            title="@emoji.Name"
                                            aria-label="@emoji.Name"
                                            @onclick="() => SelectEmojiAsync(emoji.Char)">
                                        @emoji.Char
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </ChildContent>
    </TmModal>
}
