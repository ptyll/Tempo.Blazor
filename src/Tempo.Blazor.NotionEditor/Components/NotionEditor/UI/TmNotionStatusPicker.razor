@namespace Tempo.Blazor.Components.NotionEditor.UI
@using Tempo.Blazor.NotionEditor.Enums
@using Tempo.Blazor.Components.Overlay

<TmNotionFloatingMenu IsOpen="Visible"
                      LayoutMode="LayoutMode"
                      Top="Top"
                      Left="Left"
                      Placement="OverlayPlacement.Bottom"
                      Role="dialog"
                      Title="@Loc["TmNotionStatusPicker_Title"]"
                      AriaLabel="@Loc["Notion_Status_Insert"]"
                      Class="tm-notion-status-picker"
                      OnClose="HandleBackdropClickAsync">
    <div class="tm-notion-status-picker__body" @onkeydown="HandleKeyDownAsync" @onkeydown:stopPropagation="true">

        <label class="tm-notion-status-picker__label" for="@_inputId">@Loc["Notion_Status_Placeholder"]</label>
        <input id="@_inputId"
               class="tm-notion-status-picker__input"
               type="text"
               autocomplete="off"
               spellcheck="false"
               maxlength="@MaxLabelLength"
               placeholder="@Loc["Notion_Status_Placeholder"]"
               value="@_label"
               @ref="_inputRef"
               @oninput="HandleLabelInputAsync"
               @onkeydown="HandleInputKeyDownAsync" />

        <div class="tm-notion-status-picker__preview" aria-live="polite">
            <span class="@PreviewClass">
                <span class="tm-notion-status__label">@PreviewLabel</span>
            </span>
        </div>

        <div class="tm-notion-status-picker__colors" role="radiogroup" aria-label="@Loc["Notion_Status_Insert"]">
            @foreach (var color in Colors)
            {
                var selected = color == _color;
                <button type="button"
                        role="radio"
                        class="tm-notion-status-picker__swatch tm-notion-status-picker__swatch--@CssColor(color) @(selected ? "tm-notion-status-picker__swatch--selected" : null)"
                        aria-label="@Loc[$"Notion_Status_Color_{color}"]"
                        aria-checked="@(selected ? "true" : "false")"
                        title="@Loc[$"Notion_Status_Color_{color}"]"
                        @onclick="() => SelectColor(color)">
                    <span aria-hidden="true"></span>
                </button>
            }
        </div>

        <button type="button"
                class="tm-notion-status-picker__insert"
                disabled="@IsInsertDisabled"
                @onclick="InsertAsync">
            @Loc["Notion_Status_Insert"]
        </button>
    </div>
</TmNotionFloatingMenu>
