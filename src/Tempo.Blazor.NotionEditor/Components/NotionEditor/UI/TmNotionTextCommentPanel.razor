@namespace Tempo.Blazor.Components.NotionEditor.UI
@using Tempo.Blazor.Abstractions.Shared
@using Tempo.Blazor.Components.NotionEditor.Models
@using Tempo.Blazor.Components.NotionEditor.Services
@using Tempo.Blazor.Components.Feedback

@* ── Backdrop ────────────────────────────────────────────────────────────── *@
@if (Visible)
{
    <div class="tm-ntcp-backdrop" @onclick="CloseAsync" aria-hidden="true"></div>

    @* ── Popover card ────────────────────────────────────────────────────────── *@
    <div class="tm-ntcp"
         role="dialog"
         aria-label="@Loc["TmNotionTextComment_PanelLabel"]"
         aria-modal="true"
         style="top:@(_top)px;left:@(_left)px"
         @onkeydown:stopPropagation="true"
         @ref="_panelRef">

        @* ── Header ──────────────────────────────────────────────────────── *@
        <div class="tm-ntcp__header">
            @* Highlighted text preview *@
            @if (!string.IsNullOrEmpty(HighlightedText))
            {
                <div class="tm-ntcp__highlight-preview" aria-label="@Loc["TmNotionTextComment_HighlightedText"]">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path d="M2 9l2-2 5-5 1 1-5 5-2 2H2V9z" fill="currentColor" opacity=".6"/>
                    </svg>
                    <span class="tm-ntcp__highlight-snippet">@TruncateText(HighlightedText, 60)</span>
                </div>
            }
            <div class="tm-ntcp__header-actions">
                @if (_comment is not null)
                {
                    @if (IsSubscribed)
                    {
                        <button class="tm-ntcp__watch-btn tm-ntcp__watch-btn--watching"
                                type="button"
                                title="@Loc["TmNotionTextComment_Unwatch"]"
                                @onclick="UnsubscribeAsync">
                            <TmIcon Name="@IconNames.BellOff" Size="IconSize.Xs" />
                            @Loc["TmNotionTextComment_Unwatch"]
                        </button>
                    }
                    else
                    {
                        <button class="tm-ntcp__watch-btn"
                                type="button"
                                title="@Loc["TmNotionTextComment_Watch"]"
                                @onclick="SubscribeAsync">
                            <TmIcon Name="@IconNames.Bell" Size="IconSize.Xs" />
                            @Loc["TmNotionTextComment_Watch"]
                        </button>
                    }
                    @if (_comment.IsResolved())
                    {
                        <button class="tm-ntcp__resolve-btn tm-ntcp__resolve-btn--unresolve"
                                type="button"
                                title="@Loc["TmNotionTextComment_Unresolve"]"
                                @onclick="UnresolveAsync">
                            <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                                <circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.4"/>
                                <path d="M4 6.5l2 2 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            @Loc["TmNotionTextComment_Unresolve"]
                        </button>
                    }
                    else
                    {
                        <button class="tm-ntcp__resolve-btn"
                                type="button"
                                title="@Loc["TmNotionTextComment_Resolve"]"
                                @onclick="ResolveAsync">
                            <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                                <circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.4"/>
                                <path d="M4 6.5l2 2 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            @Loc["TmNotionTextComment_Resolve"]
                        </button>
                    }
                }
                <button class="tm-ntcp__close-btn"
                        type="button"
                        aria-label="@Loc["Tm_Close"]"
                        @onclick="CloseAsync">
                    <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                        <path d="M2 2l9 9M11 2L2 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
        </div>

        @* ── Resolved banner ──────────────────────────────────────────────── *@
        @if (_comment?.IsResolved() == true)
        {
            <div class="tm-ntcp__resolved-banner" role="status">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.4"/>
                    <path d="M3.5 6l2 2 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                @Loc["TmNotionTextComment_Resolved"]
            </div>
        }

        @* ── Thread ──────────────────────────────────────────────────────── *@
        <TmNotionCommentThreadList ClassPrefix="tm-ntcp"
                                   ListLabel="@Loc["TmNotionTextComment_Thread"]"
                                   Loading="_loading"
                                   Empty="@(_comment is null)"
                                   LoadingText="@Loc["TmNotionTextComment_Loading"]"
                                   EmptyText="@Loc["TmNotionTextComment_NoComments"]"
                                   ShowDeleteConfirm="_showDeleteConfirm"
                                   DeleteTitle="@Loc["TmNotionTextComment_Delete"]"
                                   DeleteMessage="@Loc["TmNotionTextComment_DeleteConfirm"]"
                                   DeleteOkText="@Loc["Tm_Delete"]"
                                   DeleteCancelText="@Loc["Tm_Cancel"]"
                                   OnDeleteResult="HandleDeleteConfirmResult">
            @if (_comment is not null)
            {
                <TmNotionCommentThreadView ClassPrefix="tm-ntcp"
                                           Nodes="@CommentThreadHelper.BuildTree(_comment.Entries)"
                                           ReplyingToEntryId="@_replyingToEntryId"
                                           EditingEntryId="@_editingEntryId"
                                           EditText="@_editText"
                                           OnEditTextChanged="OnEditTextChanged"
                                           OnEditKeyDown="HandleEditKeyDownAsync"
                                           InlineReplyText="@_inlineReplyText"
                                           InlineReplyBaseline="@_inlineReplyBaseline"
                                           InlineReplyResetToken="_inlineReset"
                                           InlineReplyTextChanged="OnInlineText"
                                           FormatTime="FormatTime"
                                           AbsoluteTime="AbsoluteTime"
                                           FormatBody="FormatEntry"
                                           CanEdit="e => e.CanEdit"
                                           CanDelete="e => e.CanDelete"
                                           MentionProvider="Context.MentionProvider"
                                           OnEntryKeyDown="OnEntryKey"
                                           OnReply="StartReplyToEntry"
                                           OnEdit="StartEdit"
                                           OnDelete="DeleteEntryAsync"
                                           OnSubmitReply="SendInlineReplyAsync"
                                           OnCancelReply="CancelInlineReply"
                                           OnSaveEdit="SaveEditAsync"
                                           OnCancelEdit="CancelEdit"
                                           OnDraftChanged="NotifyDraftChangedAsync"
                                           Submitting="_submitting"
                                           LabelPrefix="TmNotionTextComment">
                    <Reactions>
                        <span @onkeydown:stopPropagation="true">
                            <TmCommentReactions Reactions="context.Reactions"
                                                EntryId="@context.Id"
                                                CurrentUserId="@CurrentUserId"
                                                Provider="@(Context.CommentProvider as ITmCommentReactionProvider)"
                                                OnChanged="StateHasChanged" />
                        </span>
                    </Reactions>
                </TmNotionCommentThreadView>
            }
        </TmNotionCommentThreadList>

        @* ── Reply input ─────────────────────────────────────────────────── *@
        @if ((_comment is null || !_comment.IsResolved()) && _replyingToEntryId is null)
        {
            <TmNotionCommentComposer ClassPrefix="tm-ntcp"
                                     Class="tm-ntcp__reply"
                                     Value=""
                                     ResetToken="_composerReset"
                                     TextChanged="OnReplyText"
                                     DraftChanged="OnReplyDraft"
                                     Placeholder="@Loc[_comment is null ? "TmNotionTextComment_NewPlaceholder" : "TmNotionTextComment_ReplyPlaceholder"]"
                                     AriaLabel="@Loc["TmNotionTextComment_ReplyLabel"]"
                                     Hint="@Loc["TmNotionTextComment_ReplyHint"]"
                                     SubmitText="@Loc[_comment is null ? "TmNotionTextComment_Comment" : "TmNotionTextComment_Reply"]"
                                     OnSubmit="SubmitReply"
                                     Submitting="_submitting"
                                     ShowAvatar="true"
                                     AuthorName="@CurrentUserId"
                                     MentionProvider="Context.MentionProvider" />
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="tm-ntcp__error" role="alert">@_error</div>
        }

    </div>
}


