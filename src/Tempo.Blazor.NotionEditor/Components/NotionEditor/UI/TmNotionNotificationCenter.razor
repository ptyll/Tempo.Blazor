@namespace Tempo.Blazor.Components.NotionEditor.UI
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Abstractions.Shared
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Components.Overlay
@implements IDisposable

<div class="tm-notification-bell tm-notion-notifications @Class @(_hasNew ? "tm-notification-bell--pulse" : "")"
     data-testid="@TestId("notion-notification-center")"
     @attributes="AdditionalAttributes">
    <button type="button"
            class="tm-notification-bell__button tm-notion-notifications__button"
            data-testid="@TestId("notion-notification-toggle")"
            aria-label="@AriaLabelText"
            title="@AriaLabelText"
            aria-haspopup="dialog"
            aria-expanded="@(_isOpen ? "true" : "false")"
            aria-controls="@(_isOpen ? _panelId : null)"
            @ref="_buttonRef"
            @onclick="ToggleAsync">
        <TmIcon Name="@IconNames.Bell" Size="IconSize.Sm" />
        @if (BadgeCount > 0)
        {
            <span class="tm-notification-bell__badge" data-testid="@TestId("notion-notification-badge")">@BadgeCount</span>
        }
    </button>

    @* The panel is a TmOverlayPanel (N189): popover="manual" puts it in the browser top layer,
       overlay.js provides Escape + outside-pointerdown dismissal and focus restoration to the
       bell button — the same contract TmNotificationBell exposes. The old plain div had none of
       that and its z-index:1060 sat above the modal band, so it could cover a later modal. *@
    <TmOverlayPanel Anchor="_buttonRef"
                    IsOpen="_isOpen"
                    IsOpenChanged="SetOpenFromJsAsync"
                    Id="@_panelId"
                    DataTestId="@TestId("notion-notification-panel")"
                    Placement="OverlayPlacement.Bottom"
                    Align="OverlayAlign.End"
                    Offset="8"
                    Role="dialog"
                    Class="tm-notification-bell__dropdown tm-notion-notifications__panel">
            <div class="tm-notification-bell__header">
                <span class="tm-notification-bell__title">@Loc["Notion_Notifications_Title"]</span>
                <div class="tm-notification-bell__actions">
                    <button type="button"
                            class="tm-notification-bell__filter"
                            data-testid="@TestId("notion-notification-filter")"
                            @onclick="() => _showOnlyUnread = !_showOnlyUnread">
                        @(_showOnlyUnread ? Loc["TmNotificationBell_ShowAll"] : Loc["TmNotificationBell_ShowOnlyUnread"])
                    </button>
                    @if (_unreadCount > 0)
                    {
                        <button type="button"
                                class="tm-notification-bell__mark-all"
                                data-testid="@TestId("notion-notification-mark-all")"
                                @onclick="MarkAllReadAsync">
                            @Loc["Notion_Notifications_MarkAllRead"]
                        </button>
                    }
                </div>
            </div>

            <div class="tm-notification-bell__list">
                @if (_loading)
                {
                    <div class="tm-notion-notifications__status" role="status">@Loc["Tm_Loading"]</div>
                }
                else if (VisibleNotifications.Any())
                {
                    @foreach (var n in VisibleNotifications)
                    {
                        <button type="button"
                                class="tm-notification-bell__item tm-notion-notifications__item @(n.IsRead ? "" : "tm-notification-bell__item--unread")"
                                data-testid="@TestId("notion-notification-item")"
                                @onclick="() => OnItemClickAsync(n)">
                            <span class="tm-notification-bell__avatar" aria-hidden="true">
                                @if (!string.IsNullOrEmpty(n.Actor?.AvatarUrl))
                                {
                                    <img src="@n.Actor.AvatarUrl" alt="" />
                                }
                                else
                                {
                                    <TmIcon Name="@TypeIcon(n.Type)" Size="IconSize.Sm" />
                                }
                            </span>
                            <span class="tm-notification-bell__content">
                                <span class="tm-notification-bell__message">@n.Title</span>
                                <span class="tm-notification-bell__time">@FormatTime(n.CreatedAt)</span>
                            </span>
                            @if (!n.IsRead)
                            {
                                <span class="tm-notification-bell__dot" aria-hidden="true"></span>
                            }
                        </button>
                    }
                }
                else
                {
                    <div class="tm-notification-bell__empty" data-testid="@TestId("notion-notification-empty")">
                        @Loc["Notion_Notifications_Empty"]
                    </div>
                }
            </div>
    </TmOverlayPanel>
</div>

@code {
    [Inject] private ITmNotificationService NotificationService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    /// <summary>Additional CSS class on the notification center root.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>User whose notifications should be shown in the center.</summary>
    [Parameter] public string CurrentUserId { get; set; } = "demo";

    /// <summary>Raised whenever the dropdown is opened or closed.</summary>
    [Parameter] public EventCallback<bool> OnDropdownOpenChanged { get; set; }

    /// <summary>Polling interval for server-backed notification services. Defaults to 2.5 seconds.</summary>
    [Parameter] public TimeSpan PollInterval { get; set; } = TimeSpan.FromMilliseconds(2500);

    /// <summary>Additional unmatched attributes applied to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool _isOpen;
    private bool _hasNew;
    private bool _showOnlyUnread;
    private bool _loading;
    private int _unreadCount;
    private List<TmNotification> _notifications = new();
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _pollCts;
    private ElementReference _buttonRef;
    // Per-instance id so the toggle's aria-controls can reference the overlay panel element.
    private readonly string _panelId = $"tm-notion-notification-panel-{Guid.NewGuid():n}";

    private int BadgeCount => _unreadCount;

    private string AriaLabelText => BadgeCount > 0
        ? Loc["TmNotificationBell_NewCount", BadgeCount]
        : Loc["Notion_Notifications_Title"];

    private IEnumerable<TmNotification> VisibleNotifications =>
        _showOnlyUnread ? _notifications.Where(n => !n.IsRead) : _notifications;

    protected override async Task OnInitializedAsync()
    {
        NotificationService.OnChanged += OnNotificationsChanged;
        await RefreshUnreadCountAsync(forceRender: false);
        StartPolling();
    }

    private void StartPolling()
    {
        if (PollInterval <= TimeSpan.Zero)
            return;

        _pollCts = new CancellationTokenSource();
        _timer = new PeriodicTimer(PollInterval);
        _ = PollAsync(_pollCts.Token);
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        if (_timer is null)
            return;

        try
        {
            while (await _timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshUnreadCountAsync(forceRender: true);
                    if (_isOpen)
                        await LoadNotificationsAsync();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async void OnNotificationsChanged()
    {
        await InvokeAsync(async () =>
        {
            _hasNew = true;
            await RefreshUnreadCountAsync(forceRender: false);
            if (_isOpen)
                await LoadNotificationsAsync();
            StateHasChanged();
        });
    }

    private async Task ToggleAsync()
    {
        _isOpen = !_isOpen;
        if (_isOpen)
        {
            _hasNew = false;
            await LoadNotificationsAsync();
        }
        else
        {
            _showOnlyUnread = false;
        }

        await OnDropdownOpenChanged.InvokeAsync(_isOpen);
    }

    /// <summary>
    /// JS-driven dismissal (Escape or outside pointerdown from overlay.js) — same state effects
    /// as the toggle path: reset the unread-only filter and notify OnDropdownOpenChanged.
    /// </summary>
    private async Task SetOpenFromJsAsync(bool open)
    {
        if (open == _isOpen)
            return;
        _isOpen = open;
        if (open)
        {
            _hasNew = false;
            await LoadNotificationsAsync();
        }
        else
        {
            _showOnlyUnread = false;
        }
        await OnDropdownOpenChanged.InvokeAsync(_isOpen);
    }

    private async Task RefreshUnreadCountAsync(bool forceRender)
    {
        var next = await NotificationService.GetUnreadCountAsync(CurrentUserId);
        if (next > _unreadCount)
            _hasNew = true;
        if (next != _unreadCount || forceRender)
        {
            _unreadCount = next;
            StateHasChanged();
        }
    }

    private async Task LoadNotificationsAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            _notifications = (await NotificationService.GetNotificationsAsync(new TmNotificationQuery
            {
                RecipientUserId = CurrentUserId,
                Take = 50
            })).ToList();
            _unreadCount = _notifications.Count(n => !n.IsRead);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task MarkAllReadAsync()
    {
        await NotificationService.MarkAllAsReadAsync(CurrentUserId);
        await LoadNotificationsAsync();
        await RefreshUnreadCountAsync(forceRender: true);
    }

    private async Task OnItemClickAsync(TmNotification notification)
    {
        if (!notification.IsRead)
            await NotificationService.MarkAsReadAsync(notification.Id, CurrentUserId);

        if (!string.IsNullOrEmpty(notification.ActionUrl))
            Navigation.NavigateTo(notification.ActionUrl);

        await LoadNotificationsAsync();
        await RefreshUnreadCountAsync(forceRender: true);
    }

    private string FormatTime(DateTimeOffset dt)
    {
        var diff = DateTimeOffset.UtcNow - dt.ToUniversalTime();
        if (diff.TotalMinutes < 1) return Loc["Notion_Notifications_JustNow"];
        if (diff.TotalHours < 1) return Loc["Notion_Notifications_MinutesAgo", (int)diff.TotalMinutes];
        if (diff.TotalDays < 1) return Loc["Notion_Notifications_HoursAgo", (int)diff.TotalHours];
        if (diff.TotalDays < 7) return Loc["Notion_Notifications_DaysAgo", (int)diff.TotalDays];
        return dt.ToLocalTime().ToString("d");
    }

    private static string TypeIcon(string type) => type switch
    {
        TmNotificationTypes.Mention => IconNames.AtSign,
        TmNotificationTypes.Reply => IconNames.MessageSquare,
        TmNotificationTypes.Reaction => IconNames.ThumbsUp,
        TmNotificationTypes.ThreadResolved => IconNames.CheckCircle,
        TmNotificationTypes.NewThread => IconNames.PlusCircle,
        TmNotificationTypes.PageEdited => IconNames.Edit,
        TmNotificationTypes.PageCommentAdded => IconNames.MessageSquare,
        TmNotificationTypes.TaskAssigned => IconNames.CheckSquare,
        TmNotificationTypes.PageShared => IconNames.Share,
        _ => IconNames.Bell
    };

    public void Dispose()
    {
        NotificationService.OnChanged -= OnNotificationsChanged;
        _pollCts?.Cancel();
        _timer?.Dispose();
        _pollCts?.Dispose();
    }
}
