@namespace Tempo.Blazor.Components.NotionEditor.UI
@using Tempo.Blazor.Abstractions.Shared
@using Tempo.Blazor.Components.NotionEditor.Models
@using Tempo.Blazor.Components.NotionEditor.Services
@using Tempo.Blazor.Components.Feedback

@* ── Inline panel — rendered inside page header area ─────────────────────── *@
<div class="tm-npcp @(Expanded ? "tm-npcp--expanded" : "")"
     role="region"
     aria-label="@Loc["TmNotionPageComment_PanelLabel"]"
     @ref="_panelRef">

    @* ── Toggle header ─────────────────────────────────────────────────────── *@
    <button class="tm-npcp__toggle"
            type="button"
            aria-expanded="@Expanded"
            @onclick="ToggleExpandedAsync">
        <svg class="tm-npcp__toggle-icon @(Expanded ? "tm-npcp__toggle-icon--open" : "")"
             width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
            <path d="M4 5.5l2.5 2.5 2.5-2.5"
                  stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="tm-npcp__toggle-label">@Loc["TmNotionPageComment_Toggle"]</span>
        @if (_unresolvedCount > 0)
        {
            <span class="tm-npcp__badge" aria-label="@Loc.Plural("TmNotionPageComment_BadgeLabel", _unresolvedCount)">
                @_unresolvedCount
            </span>
        }
    </button>

    @* ── Expandable body ───────────────────────────────────────────────────── *@
    @if (Expanded)
    {
        <div class="tm-npcp__body">

            @* ── Thread list ──────────────────────────────────────────────── *@
            <TmNotionCommentThreadList ClassPrefix="tm-npcp"
                                       Class="tm-npcp__threads"
                                       ListLabel="@Loc["TmNotionPageComment_Thread"]"
                                       Loading="_loading"
                                       Empty="@(_comments.Count == 0)"
                                       LoadingText="@Loc["TmNotionPageComment_Loading"]"
                                       EmptyText="@Loc["TmNotionPageComment_NoComments"]"
                                       ShowDeleteConfirm="_showDeleteConfirm"
                                       DeleteTitle="@Loc["TmNotionPageComment_Delete"]"
                                       DeleteMessage="@Loc["TmNotionPageComment_DeleteConfirm"]"
                                       DeleteOkText="@Loc["Tm_Delete"]"
                                       DeleteCancelText="@Loc["Tm_Cancel"]"
                                       OnDeleteResult="HandleDeleteConfirmResult">
            @if (!_loading && _comments.Count > 0)
            {
                @* ── Toolbar ──────────────────────────────────────────────── *@
                <div class="tm-npcp__toolbar">
                    <button class="tm-npcp__mark-all-read"
                            type="button"
                            @onclick="MarkAllAsReadAsync">
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                            <path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        @Loc["TmNotionPageComment_MarkAllAsRead"]
                    </button>
                </div>

                @foreach (var comment in _comments)
                    {
                        var threadTree = CommentThreadHelper.BuildTree(comment.Entries);
                        <div class="tm-npcp__thread @(comment.IsResolved() ? "tm-npcp__thread--resolved" : "")"
                             role="listitem">

                            @* ── Thread header ────────────────────────────── *@
                            <div class="tm-npcp__thread-header">
                                @if (comment.IsResolved())
                                {
                                    <span class="tm-npcp__thread-resolved-badge">
                                        <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
                                            <circle cx="5.5" cy="5.5" r="4" stroke="currentColor" stroke-width="1.3"/>
                                            <path d="M3 5.5l2 2 2.5-2.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        @Loc["TmNotionPageComment_Resolved"]
                                    </span>
                                }
                                <div class="tm-npcp__thread-actions" role="group">
                                    @if (IsSubscribed(comment))
                                    {
                                        <button class="tm-npcp__watch-btn tm-npcp__watch-btn--watching"
                                                type="button"
                                                title="@Loc["TmNotionPageComment_Unwatch"]"
                                                @onclick="() => UnsubscribeAsync(comment)">
                                            <TmIcon Name="@IconNames.BellOff" Size="IconSize.Xs" />
                                            @Loc["TmNotionPageComment_Unwatch"]
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="tm-npcp__watch-btn"
                                                type="button"
                                                title="@Loc["TmNotionPageComment_Watch"]"
                                                @onclick="() => SubscribeAsync(comment)">
                                            <TmIcon Name="@IconNames.Bell" Size="IconSize.Xs" />
                                            @Loc["TmNotionPageComment_Watch"]
                                        </button>
                                    }
                                    @if (!comment.IsResolved())
                                    {
                                        <button class="tm-npcp__thread-action"
                                                type="button"
                                                title="@Loc["TmNotionPageComment_Resolve"]"
                                                @onclick="() => ResolveAsync(comment)">
                                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                                                <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.3"/>
                                                <path d="M3.5 6l2 2 3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                            @Loc["TmNotionPageComment_Resolve"]
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="tm-npcp__thread-action"
                                                type="button"
                                                title="@Loc["TmNotionPageComment_Unresolve"]"
                                                @onclick="() => UnresolveAsync(comment)">
                                            @Loc["TmNotionPageComment_Unresolve"]
                                        </button>
                                    }
                                </div>
                            </div>

                            @* ── Entries (tree) ───────────────────────────── *@
                            <TmNotionCommentThreadView ClassPrefix="tm-npcp"
                                                       Nodes="threadTree"
                                                       ReplyingToEntryId="@_replyingToEntryId"
                                                       EditingEntryId="@_editingEntryId"
                                                       EditText="@_editText"
                                                       OnEditTextChanged="OnEditTextChanged"
                                                       OnEditKeyDown="HandleEditKeyDownAsync"
                                                       InlineReplyText="@_inlineReplyText"
                                                       InlineReplyBaseline="@_inlineReplyBaseline"
                                                       InlineReplyResetToken="_inlineReset"
                                                       InlineReplyTextChanged="OnInlineText"
                                                       FormatTime="FormatTime"
                                                       AbsoluteTime="AbsoluteTime"
                                                       FormatBody="FormatEntry"
                                                       CanEdit="e => e.CanEdit"
                                                       CanDelete="e => e.CanDelete"
                                                       MentionProvider="Context.MentionProvider"
                                                       OnEntryKeyDown="OnEntryKey"
                                                       OnReply="OnReply"
                                                       OnEdit="StartEdit"
                                                       OnDelete="OnDelete"
                                                       OnSubmitReply="SendInlineReplyAsync"
                                                       OnCancelReply="CancelInlineReply"
                                                       OnSaveEdit="SaveEditAsync"
                                                       OnCancelEdit="CancelEdit"
                                                       OnDraftChanged="NotifyDraftChangedAsync"
                                                       Submitting="_submitting"
                                                       LabelPrefix="TmNotionPageComment">
                                <Reactions>
                                    <span @onkeydown:stopPropagation="true">
                                        <TmCommentReactions Reactions="context.Reactions"
                                                            EntryId="@context.Id"
                                                            CurrentUserId="@CurrentUserId"
                                                            Provider="@(Context.CommentProvider as ITmCommentReactionProvider)"
                                                            OnChanged="StateHasChanged" />
                                    </span>
                                </Reactions>
                            </TmNotionCommentThreadView>

                            @* ── Thread reply ────────────────────────────── *@
                            @if (!comment.IsResolved() && _replyingToEntryId is null)
                            {
                                @if (_replyingToCommentId == comment.Id)
                                {
                                    <TmNotionCommentComposer ClassPrefix="tm-npcp"
                                                             Class="tm-npcp__thread-reply"
                                                             Value=""
                                                             ResetToken="_replyReset"
                                                             TextChanged="OnReplyText"
                                                             DraftChanged="OnComposerDraft"
                                                             Placeholder="@Loc["TmNotionPageComment_ReplyPlaceholder"]"
                                                             AriaLabel="@Loc["TmNotionPageComment_ReplyLabel"]"
                                                             Hint="@Loc["TmNotionPageComment_ReplyHint"]"
                                                             SubmitText="@Loc["TmNotionPageComment_Reply"]"
                                                             CancelText="@Loc["TmNotionPageComment_Cancel"]"
                                                             Cancel="CancelReply"
                                                             OnSubmit="SubmitReply"
                                                             Submitting="_submitting"
                                                             MentionProvider="Context.MentionProvider" />
                                }
                                else
                                {
                                    <button class="tm-npcp__reply-trigger" type="button"
                                            @onclick="() => StartReply(comment)">
                                        @Loc["TmNotionPageComment_ReplyTrigger"]
                                    </button>
                                }
                            }
                        </div>
                    }
            }
            </TmNotionCommentThreadList>

            @* ── New comment input ─────────────────────────────────────────── *@
            @if (_replyingToCommentId is null && _replyingToEntryId is null)
            {
                <TmNotionCommentComposer ClassPrefix="tm-npcp"
                                         Class="tm-npcp__new-comment"
                                         Value=""
                                         ResetToken="_newReset"
                                         TextChanged="OnNewText"
                                         DraftChanged="OnComposerDraft"
                                         Placeholder="@Loc["TmNotionPageComment_NewPlaceholder"]"
                                         AriaLabel="@Loc["TmNotionPageComment_NewLabel"]"
                                         Hint="@Loc["TmNotionPageComment_ReplyHint"]"
                                         SubmitText="@Loc["TmNotionPageComment_Comment"]"
                                         OnSubmit="SubmitNew"
                                         Submitting="_submitting"
                                         ShowAvatar="true"
                                         AuthorName="@CurrentUserId"
                                         MentionProvider="Context.MentionProvider" />
            }

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="tm-npcp__error" role="alert">@_error</div>
            }



        </div>
    }

</div>
