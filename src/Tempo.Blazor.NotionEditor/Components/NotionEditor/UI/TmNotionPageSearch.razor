@namespace Tempo.Blazor.Components.NotionEditor.UI
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.NotionEditor.Interfaces
@using Tempo.Blazor.NotionEditor.Models
@using Tempo.Blazor.Components.NotionEditor.Services

@* Phase 6 (N10): page search rides the core TmModal — title, ×, Escape, focus return and a
   fullscreen sheet on mobile. No own backdrop or z-index. *@
<TmModal Show="_visible"
         OnClose="CloseAsync"
         Title="@Loc["TmNotionPageSearch_DialogLabel"]"
         Size="ModalSize.Medium"
         MobilePresentation="MobilePresentation.Fullscreen"
         Class="tm-nps-host"
         InitialFocusSelector=".tm-nps__search-input">
    <ChildContent>
        <div class="tm-nps tm-nps__card" @onkeydown:stopPropagation="true">

            @* ── Search row ────────────────────────────────────────────────── *@
            <div class="tm-nps__search-row">

                <svg class="tm-nps__search-icon" width="16" height="16" viewBox="0 0 16 16"
                     fill="none" aria-hidden="true">
                    <circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.4"/>
                    <path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.4"
                          stroke-linecap="round"/>
                </svg>

                <input id="@_inputId"
                       class="tm-nps__search-input"
                       type="text"
                       autocomplete="off"
                       spellcheck="false"
                       role="combobox"
                       aria-autocomplete="list"
                       aria-expanded="true"
                       aria-controls="@ResultsId"
                       aria-activedescendant="@ActiveOptionId"
                       placeholder="@Loc["TmNotionPageSearch_Placeholder"]"
                       value="@_query"
                       @ref="_inputRef"
                       @oninput="HandleQueryInputAsync"
                       @onkeydown="HandleSearchKeyDownAsync" />

                <button class="tm-nps__filter-toggle @(_showFilters || HasActiveFilters ? "tm-nps__filter-toggle--active" : "")"
                        type="button"
                        aria-expanded="@(_showFilters ? "true" : "false")"
                        aria-controls="@FiltersId"
                        title="@Loc["TmNotionPageSearch_FilterTitle"]"
                        @onclick="ToggleFilters"
                        @onkeydown="StopToggleKey"
                        @onkeydown:stopPropagation="true">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path d="M1 2.5h10M3 6h6M5 9.5h2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                    </svg>
                    @Loc["TmNotionPageSearch_FilterLabel"]
                    @if (HasActiveFilters)
                    {
                        <span>· @ActiveFilterCount</span>
                    }
                </button>

            </div>

            @* ── Advanced filter panel ─────────────────────────────────────── *@
            @if (_showFilters)
            {
                <div id="tm-nps-filters" class="tm-nps__filters">

                    <div class="tm-nps__filter-group">
                        <label class="tm-nps__filter-label" for="@_filterIds["author"]">@Loc["TmNotionPageSearch_FilterAuthorLabel"]</label>
                        <input id="@_filterIds["author"]"
                               class="tm-nps__filter-input"
                               data-testid="@TestId("notion-search-filter-author")"
                               type="text"
                               placeholder="@Loc["TmNotionPageSearch_FilterAuthorPlaceholder"]"
                               value="@_filterAuthor"
                               @onchange="e => { _filterAuthor = e.Value?.ToString() ?? string.Empty; _ = ApplyFiltersAsync(); }" />
                    </div>

                    <div class="tm-nps__filter-group">
                        <label class="tm-nps__filter-label" for="@_filterIds["label"]">@Loc["TmNotionPageSearch_FilterLabelLabel"]</label>
                        <input id="@_filterIds["label"]"
                               class="tm-nps__filter-input"
                               data-testid="@TestId("notion-search-filter-label")"
                               type="text"
                               placeholder="@Loc["TmNotionPageSearch_FilterLabelPlaceholder"]"
                               value="@_filterLabel"
                               @onchange="e => { _filterLabel = e.Value?.ToString() ?? string.Empty; _ = ApplyFiltersAsync(); }" />
                    </div>

                    <div class="tm-nps__filter-group">
                        <label class="tm-nps__filter-label" for="@_filterIds["type"]">@Loc["TmNotionPageSearch_FilterTypeLabel"]</label>
                        <select id="@_filterIds["type"]"
                                class="tm-nps__filter-input"
                                data-testid="@TestId("notion-search-filter-type")"
                                value="@_filterType"
                                @onchange="e => { _filterType = e.Value?.ToString() ?? string.Empty; _ = ApplyFiltersAsync(); }">
                            <option value="">@Loc["TmNotionPageSearch_FilterTypeAll"]</option>
                            <option value="Page">@Loc["TmNotionPageSearch_FilterTypePage"]</option>
                            <option value="Paragraph">@Loc["TmNotionPageSearch_FilterTypeParagraph"]</option>
                            <option value="Heading">@Loc["TmNotionPageSearch_FilterTypeHeading"]</option>
                            <option value="Todo">@Loc["TmNotionPageSearch_FilterTypeTodo"]</option>
                            <option value="Media">@Loc["TmNotionPageSearch_FilterTypeMedia"]</option>
                            <option value="Table">@Loc["TmNotionPageSearch_FilterTypeTable"]</option>
                        </select>
                    </div>

                    <div class="tm-nps__filter-group">
                        <label class="tm-nps__filter-label" for="@_filterIds["space"]">@Loc["TmNotionPageSearch_FilterSpaceLabel"]</label>
                        <input id="@_filterIds["space"]"
                               class="tm-nps__filter-input"
                               data-testid="@TestId("notion-search-filter-space")"
                               type="text"
                               placeholder="@Loc["TmNotionPageSearch_FilterSpacePlaceholder"]"
                               value="@_filterSpace"
                               @onchange="e => { _filterSpace = e.Value?.ToString() ?? string.Empty; _ = ApplyFiltersAsync(); }" />
                    </div>

                    <div class="tm-nps__filter-group">
                        <label class="tm-nps__filter-label" for="@_filterIds["from"]">@Loc["TmNotionPageSearch_FilterDateFromLabel"]</label>
                        <input id="@_filterIds["from"]"
                               class="tm-nps__filter-input"
                               data-testid="@TestId("notion-search-filter-created-after")"
                               type="date"
                               value="@_filterDateFrom"
                               @onchange="e => { _filterDateFrom = e.Value?.ToString() ?? string.Empty; _ = ApplyFiltersAsync(); }" />
                    </div>

                    <div class="tm-nps__filter-group">
                        <label class="tm-nps__filter-label" for="@_filterIds["to"]">@Loc["TmNotionPageSearch_FilterDateToLabel"]</label>
                        <input id="@_filterIds["to"]"
                               class="tm-nps__filter-input"
                               data-testid="@TestId("notion-search-filter-created-before")"
                               type="date"
                               value="@_filterDateTo"
                               @onchange="e => { _filterDateTo = e.Value?.ToString() ?? string.Empty; _ = ApplyFiltersAsync(); }" />
                    </div>

                    <div class="tm-nps__filter-group">
                        <label class="tm-nps__filter-label" for="@_filterIds["edited"]">@Loc["TmNotionPageSearch_FilterEditedBeforeLabel"]</label>
                        <input id="@_filterIds["edited"]"
                               class="tm-nps__filter-input"
                               data-testid="@TestId("notion-search-filter-edited-before")"
                               type="date"
                               value="@_filterEditedBefore"
                               @onchange="e => { _filterEditedBefore = e.Value?.ToString() ?? string.Empty; _ = ApplyFiltersAsync(); }" />
                    </div>

                    @if (HasActiveFilters)
                    {
                        <button class="tm-nps__filter-clear"
                                data-testid="@TestId("notion-search-filter-clear")"
                                type="button"
                                @onclick="ClearFiltersAsync">
                            @Loc["TmNotionPageSearch_FilterClear"]
                        </button>
                    }

                </div>
            }

            @* ── Results ───────────────────────────────────────────────────── *@
            <div class="tm-nps__results"
                 id="@ResultsId"
                 role="listbox"
                 aria-label="@Loc["TmNotionPageSearch_ResultsLabel"]">

                @if (_loading)
                {
                    <div class="tm-nps__status" aria-live="polite" aria-busy="true">
                        <span class="tm-nps__spinner" aria-hidden="true"></span>
                        @Loc["TmNotionPageSearch_Loading"]
                    </div>
                }
                else if (_flatResults.Count == 0)
                {
                    <div class="tm-nps__status" aria-live="polite">
                        @(string.IsNullOrEmpty(_query)
                            ? Loc["TmNotionPageSearch_StartTyping"]
                            : Loc["TmNotionPageSearch_NoResults"])
                    </div>
                }
                else
                {
                    @* ── Pages section ───────────────────────────────────────── *@
                    @if (_pages.Count > 0)
                    {
                        <div class="tm-nps__section-header" role="presentation">
                            @Loc["TmNotionPageSearch_SectionPages"] (@_pages.Count)
                        </div>

                        @for (int _pIdx = 0; _pIdx < _pages.Count; _pIdx++)
                        {
                            var page   = _pages[_pIdx];
                            var pIdx   = _pIdx;

                            <div id="@OptionId(pIdx)"
                                 class="tm-nps__item @(IsPageSelected(pIdx) ? "tm-nps__item--selected" : "")"
                                 role="option"
                                 aria-selected="@IsPageSelected(pIdx)"
                                 @onclick="() => NavigateToPageAsync(page)"
                                 @onmouseenter="() => _selectedIndex = pIdx">

                                <span class="tm-nps__item-icon" aria-hidden="true">
                                    @GetPageIcon(page)
                                </span>

                                <div class="tm-nps__item-body">
                                    <span class="tm-nps__item-title">@GetPageTitle(page)</span>
                                    @if (PagePath(page) is { } path)
                                    {
                                        <span class="tm-nps__item-path">
                                            <span class="tm-sr-only">@Loc["TmNotionPageSearch_Path"] </span>@path
                                        </span>
                                    }
                                    <span class="tm-nps__item-meta">@PageMeta(page)</span>
                                </div>

                                <span class="tm-nps__item-shortcut" aria-hidden="true">↵</span>

                            </div>
                        }
                    }

                    @* ── Blocks section ──────────────────────────────────────── *@
                    @if (_blocks.Count > 0)
                    {
                        <div class="tm-nps__section-header" role="presentation">
                            @Loc["TmNotionPageSearch_SectionBlocks"] (@_blocks.Count)
                        </div>

                        @for (int _bIdx = 0; _bIdx < _blocks.Count; _bIdx++)
                        {
                            var result = _blocks[_bIdx];
                            var bIdx   = _bIdx;

                            <div id="@OptionId(_pages.Count + bIdx)"
                                 class="tm-nps__item @(IsBlockSelected(bIdx) ? "tm-nps__item--selected" : "")"
                                 role="option"
                                 aria-selected="@IsBlockSelected(bIdx)"
                                 @onclick="() => NavigateToBlockResultAsync(result)"
                                 @onmouseenter="() => _selectedIndex = _pages.Count + bIdx">

                                <span class="tm-nps__item-icon tm-nps__item-icon--block" aria-hidden="true">
                                    ¶
                                </span>

                                <div class="tm-nps__item-body">
                                    <span class="tm-nps__item-title">
                                        @(result.PageIconEmoji is { Length: > 0 } e ? e + " " : "📄 ")@result.PageTitle
                                    </span>
                                    @if (!string.IsNullOrEmpty(result.MatchSnippet))
                                    {
                                        <span class="tm-nps__item-snippet">@BuildSnippet(result)</span>
                                    }
                                </div>

                                <span class="tm-nps__item-shortcut" aria-hidden="true">↵</span>

                            </div>
                        }
                    }
                }

            </div>

            @* ── Footer hints ──────────────────────────────────────────────── *@
            <div class="tm-nps__footer">
                <span class="tm-nps__footer-count">@string.Format(Loc["TmNotionPageSearch_ResultCount"], _flatResults.Count)</span>
                <span class="tm-nps__footer-hint">
                    <kbd class="tm-nps__kbd">↑</kbd>
                    <kbd class="tm-nps__kbd">↓</kbd>
                    @Loc["TmNotionPageSearch_HintNavigate"]
                </span>
                <span class="tm-nps__footer-hint">
                    <kbd class="tm-nps__kbd">↵</kbd>
                    @Loc["TmNotionPageSearch_HintOpen"]
                </span>
                <span class="tm-nps__footer-hint">
                    <kbd class="tm-nps__kbd">Esc</kbd>
                    @Loc["TmNotionPageSearch_HintClose"]
                </span>
                <span class="tm-nps__footer-spacer"></span>
                @if (Context.SearchProvider is null)
                {
                    <span class="tm-nps__footer-hint">@Loc["TmNotionPageSearch_NoProvider"]</span>
                }
            </div>

        </div>
    </ChildContent>
</TmModal>
