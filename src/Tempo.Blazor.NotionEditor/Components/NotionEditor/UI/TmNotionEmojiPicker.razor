@namespace Tempo.Blazor.Components.NotionEditor.UI
@using Tempo.Blazor.Components.Overlay

@if (Inline)
{
    <div class="tm-notion-emoji-picker tm-notion-emoji-picker__panel tm-notion-emoji-picker--inline" role="group"
         aria-label="@Loc["TmNotionEmojiPicker_SearchPlaceholder"]">
        @PickerBody
    </div>
}
else
{
<TmNotionFloatingMenu IsOpen="Visible"
                      LayoutMode="LayoutMode"
                      Top="Top"
                      Left="Left"
                      Placement="OverlayPlacement.Bottom"
                      Role="dialog"
                      Title="@Loc["TmNotionEmojiPicker_Title"]"
                      AriaLabel="@Loc["TmNotionEmojiPicker_SearchPlaceholder"]"
                      Class="tm-notion-emoji-picker tm-notion-emoji-picker__panel"
                      OnClose="HandleBackdropClickAsync">
    <Footer>
        @if (ShowRemove)
        {
            <button class="tm-notion-emoji-picker__remove tm-notion-emoji-picker__remove--footer"
                    type="button"
                    @onclick="HandleRemoveAsync">
                @Loc["TmNotionEmojiPicker_Remove"]
            </button>
        }
    </Footer>
    <ChildContent>
        @PickerBody
    </ChildContent>
</TmNotionFloatingMenu>
}

@code {
    private int _recentLoop;
    private int _categoryLoop;
    private int _searchLoop;

    private RenderFragment EmojiCell(int index, string emoji, string name)
        => index == _focusIndex ? FocusedCell(emoji, name) : RestCell(emoji, name);

    private RenderFragment FocusedCell(string emoji, string name) => @<button class="tm-notion-emoji-picker__emoji tm-notion-emoji-picker__btn"
            type="button"
            title="@name"
            aria-label="@name"
            tabindex="0"
            @ref="_focusCell"
            @onclick="() => SelectEmojiAsync(emoji)"
            @onclick:preventDefault="true">@emoji</button>;

    private RenderFragment RestCell(string emoji, string name) => @<button class="tm-notion-emoji-picker__emoji tm-notion-emoji-picker__btn"
            type="button"
            title="@name"
            aria-label="@name"
            tabindex="-1"
            @onclick="() => SelectEmojiAsync(emoji)"
            @onclick:preventDefault="true">@emoji</button>;

    private RenderFragment PickerBody => @<div class="tm-notion-emoji-picker__body" @onkeydown="HandleKeyDownAsync" @onmousedown:preventDefault="true">

        <div class="tm-notion-emoji-picker__top">
            <div class="tm-notion-emoji-picker__search-wrap">
                <svg class="tm-notion-emoji-picker__search-icon" width="14" height="14"
                     viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.3"/>
                    <path d="M9.5 9.5l3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
                <input class="tm-notion-emoji-picker__search"
                       type="text"
                       autocomplete="off"
                       spellcheck="false"
                       placeholder="@Loc["TmNotionEmojiPicker_SearchPlaceholder"]"
                       value="@_query"
                       @ref="_searchRef"
                       @oninput="HandleQueryInputAsync"
                       @onmousedown:stopPropagation="true"
                       @onkeydown="HandleSearchKeyDownAsync"
                       @onkeydown:stopPropagation="true" />
            </div>
            @if (ShowRemove && Inline)
            {
                <button class="tm-notion-emoji-picker__remove"
                        type="button"
                        @onclick="HandleRemoveAsync"
                        @onclick:stopPropagation="true">
                    @Loc["TmNotionEmojiPicker_Remove"]
                </button>
            }
            <button class="tm-notion-emoji-picker__random"
                    title="@Loc["TmNotionEmojiPicker_Random"]"
                    @onclick="HandleRandomAsync"
                    @onclick:preventDefault="true">
                🎲
            </button>
        </div>

        @if (!_isSearching)
        {
            <div class="tm-notion-emoji-picker__tabs" role="tablist">
                @foreach (var tab in _tabs)
                {
                    var capturedTab = tab;
                    <button class="tm-notion-emoji-picker__tab @(_activeCategory == capturedTab.Category ? "tm-notion-emoji-picker__tab--active" : "")"
                            role="tab"
                            aria-selected="@(_activeCategory == capturedTab.Category)"
                            title="@Loc[capturedTab.NameKey]"
                            @onclick="() => SetCategory(capturedTab.Category)"
                            @onclick:preventDefault="true">
                        @capturedTab.Icon
                    </button>
                }
            </div>
        }

        <div class="tm-notion-emoji-picker__scroll" @ref="_scrollRef">

            @if (_isSearching)
            {
                @if (_searchResults.Count == 0)
                {
                    <div class="tm-notion-emoji-picker__empty">
                        @Loc["TmNotionEmojiPicker_NoResults"]
                    </div>
                }
                else
                {
                    <div class="tm-notion-emoji-picker__grid" @ref="_searchGridRef" @onkeydown="HandleGridKeyDownAsync" @onkeydown:preventDefault="_gridNavHandled">
                        @{ _searchLoop = 0; }
                        @foreach (var entry in _searchResults)
                        {
                            var captured = entry;
                            var index = _searchLoop++;
                            @EmojiCell(index, captured.Emoji, captured.Name)
                        }
                    </div>
                }
            }
            else
            {
                @if (_recentEmojis.Count > 0)
                {
                    <div class="tm-notion-emoji-picker__category tm-notion-emoji-picker__category--recent">
                    <div class="tm-notion-emoji-picker__section-label">
                        @Loc["TmNotionEmojiPicker_RecentlyUsed"]
                    </div>
                    <div class="tm-notion-emoji-picker__grid tm-notion-emoji-picker__grid--recent" @ref="_recentGridRef" @onkeydown="HandleGridKeyDownAsync" @onkeydown:preventDefault="_gridNavHandled">
                        @{ _recentLoop = 0; }
                        @foreach (var emoji in _recentEmojis)
                        {
                            var captured = emoji;
                            var index = _recentLoop++;
                            @EmojiCell(index, captured, captured)
                        }
                    </div>
                    </div>
                }

                <div class="tm-notion-emoji-picker__section-label">
                    @CategoryLabel(_activeCategory)
                </div>
                <div class="tm-notion-emoji-picker__grid" @ref="_categoryGridRef" @onkeydown="HandleGridKeyDownAsync" @onkeydown:preventDefault="_gridNavHandled">
                    @{ _categoryLoop = 0; }
                    @foreach (var entry in _categoryEmojis)
                    {
                        var captured = entry;
                        var index = _recentEmojis.Count + _categoryLoop++;
                        @EmojiCell(index, captured.Emoji, captured.Name)
                    }
                </div>
            }

        </div>

    </div>;
}
