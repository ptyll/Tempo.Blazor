@namespace Tempo.Blazor.Components.NotionEditor.UI
@using Tempo.Blazor.Abstractions.Shared
@using Tempo.Blazor.Components.NotionEditor.Models
@using Tempo.Blazor.Components.NotionEditor.Services
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Overlay
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Icons

@* ── Phase 4 (NO1): CommentPresentation decides the surface. Dialog (or Auto on a narrow /
     mobile layout) rides the core TmModal — visible title, footer "Close", Escape, focus return.
     Auto on a desktop layout keeps the anchored popover bubble — no own backdrop, no z-index,
     no false aria-modal. ── *@
@if (Visible)
{
    @if (UseDialog)
    {
        <TmModal Show="true"
                 OnClose="CloseAsync"
                 Title="@DialogTitle"
                 Size="ModalSize.Large"
                 MobilePresentation="MobilePresentation.Auto"
                 Class="tm-nbcp-dialog">
            <ChildContent>@CardContent</ChildContent>
            <Footer>
                <TmButton Variant="ButtonVariant.Primary" OnClick="CloseAsync">@Loc["Tm_Close"]</TmButton>
            </Footer>
        </TmModal>
    }
    else
    {
        @* Phase 4 review: a fixed zero-size anchor span at the bubble position lets the core
           TmOverlayPanel promote the bubble into the browser top layer (Escape, outside click,
           anchor tracking) — no host-computed fixed card, no own backdrop or z-index. *@
        <span class="tm-nbcp-anchor"
              style="position:fixed;top:@(_top)px;left:@(_left)px;width:0;height:0"
              aria-hidden="true"
              @ref="_anchorRef"></span>
        <TmOverlayPanel Anchor="_anchorRef"
                        IsOpen="true"
                        Role="dialog"
                        AriaLabel="@Loc["TmNotionBlockComment_PanelLabel"]"
                        Placement="OverlayPlacement.Bottom"
                        Align="OverlayAlign.Start"
                        Offset="0"
                        Class="tm-nbcp-popover"
                        OnDismissed="CloseAsync">
            @CardContent
        </TmOverlayPanel>
    }
}

@code {
    /// <summary>The anchored popover card — the single content definition for both surfaces. The
    /// dialog role and accessible name live on the surface that hosts the card: the core
    /// TmFocusScope of the TmModal (UseDialog) or the TmOverlayPanel popover — never both.</summary>
    private RenderFragment CardContent => __builder =>
    {
        <div class="tm-nbcp @(IsSplit ? "tm-nbcp--split" : "") @(UseDialog ? "tm-nbcp--in-dialog" : "tm-nbcp--popover")"
             role="@(UseDialog ? null : "dialog")"
             aria-label="@(UseDialog ? null : Loc["TmNotionBlockComment_PanelLabel"])"
             @onkeydown:stopPropagation="true"
             @ref="_panelRef">

        @* ── Header ────────────────────────────────────────────────────────── *@
        <div class="tm-nbcp__header">
            @if (IsThreadList)
            {
                <span class="tm-nbcp__header-title">@Loc["TmNotionBlockComment_Title"] (@_comments.Count)</span>
                <div class="tm-nbcp__header-actions">
                    <button class="tm-nbcp__new-thread-btn"
                            type="button"
                            title="@Loc["TmNotionBlockComment_NewThread"]"
                            @onclick="StartNewThread">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                            <path d="M7 2v10M2 7h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                        @Loc["TmNotionBlockComment_NewThread"]
                    </button>
                    <button class="tm-nbcp__close-btn"
                            type="button"
                            aria-label="@Loc["Tm_Close"]"
                            @onclick="CloseAsync">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                            <path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>
            }
            else if (_isCreatingNewThread)
            {
                @* With zero threads there is no list to go back to — the back affordance would
                   strand the user on an empty sheet (UX review of the phase-4 mobile capture). *@
                @if (!IsSplit && _comments.Count > 0)
                {
                    <button class="tm-nbcp__back-btn"
                            type="button"
                            aria-label="@Loc["Tm_Back"]"
                            @onclick="BackToThreadList">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                            <path d="M10 2L4 7l6 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                }
                <span class="tm-nbcp__header-title">@Loc["TmNotionBlockComment_NewThread"]</span>
                <div class="tm-nbcp__header-actions">
                    <button class="tm-nbcp__close-btn"
                            type="button"
                            aria-label="@Loc["Tm_Close"]"
                            @onclick="CloseAsync">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                            <path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>
            }
            else if (IsThreadDetail)
            {
                @if (!IsSplit)
                {
                    <button class="tm-nbcp__back-btn"
                            type="button"
                            aria-label="@Loc["Tm_Back"]"
                            @onclick="BackToThreadList">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                            <path d="M10 2L4 7l6 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                }
                <span class="tm-nbcp__header-title">@Loc["TmNotionBlockComment_ThreadDetail"]</span>
                <div class="tm-nbcp__header-actions">
                    @if (_selectedComment is not null)
                    {
                        @if (_isSubscribed)
                        {
                            <button class="tm-nbcp__watch-btn tm-nbcp__watch-btn--watching"
                                    type="button"
                                    title="@Loc["TmNotionBlockComment_Unwatch"]"
                                    @onclick="UnsubscribeAsync">
                                <TmIcon Name="@IconNames.BellOff" Size="IconSize.Xs" />
                                @Loc["TmNotionBlockComment_Unwatch"]
                            </button>
                        }
                        else
                        {
                            <button class="tm-nbcp__watch-btn"
                                    type="button"
                                    title="@Loc["TmNotionBlockComment_Watch"]"
                                    @onclick="SubscribeAsync">
                                <TmIcon Name="@IconNames.Bell" Size="IconSize.Xs" />
                                @Loc["TmNotionBlockComment_Watch"]
                            </button>
                        }
                        @if (_selectedComment.IsResolved())
                        {
                            @if (!_isReadByCurrentUser)
                            {
                                <button class="tm-nbcp__read-btn"
                                        type="button"
                                        title="@Loc["TmNotionBlockComment_MarkAsRead"]"
                                        @onclick="MarkAllAsReadAsync">
                                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                                        <path d="M2 7l4 4 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                    @Loc["TmNotionBlockComment_MarkAsRead"]
                                </button>
                            }
                            <button class="tm-nbcp__resolve-btn tm-nbcp__resolve-btn--unresolve"
                                    type="button"
                                    title="@Loc["TmNotionBlockComment_Unresolve"]"
                                    @onclick="UnresolveAsync">
                                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                                    <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.4"/>
                                    <path d="M4.5 7l2 2 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                @Loc["TmNotionBlockComment_Unresolve"]
                            </button>
                        }
                        else
                        {
                            <button class="tm-nbcp__resolve-btn"
                                    type="button"
                                    title="@Loc["TmNotionBlockComment_Resolve"]"
                                    @onclick="ResolveAsync">
                                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                                    <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.4"/>
                                    <path d="M4.5 7l2 2 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                @Loc["TmNotionBlockComment_Resolve"]
                            </button>
                        }
                    }
                    <button class="tm-nbcp__close-btn"
                            type="button"
                            aria-label="@Loc["Tm_Close"]"
                            @onclick="CloseAsync">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                            <path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>
            }
            else
            {
                <span class="tm-nbcp__header-title">@Loc["TmNotionBlockComment_Title"]</span>
                <div class="tm-nbcp__header-actions">
                    <button class="tm-nbcp__close-btn"
                            type="button"
                            aria-label="@Loc["Tm_Close"]"
                            @onclick="CloseAsync">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                            <path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>
            }
        </div>

        @* ── Thread list (also pinned next to the detail in the split dialog) ── *@
        @if (IsThreadList || (IsSplit && _selectedComment is not null))
        {
            <div class="tm-nbcp__thread-list" role="list" aria-label="@Loc["TmNotionBlockComment_ThreadList"]">
                @foreach (var comment in _comments.OrderBy(c => c.IsResolved()).ThenByDescending(c => c.LastActivityAt()))
                {
                    var firstEntry = comment.Entries.FirstOrDefault();
                    @* The card body is a native button so Enter and Space select the thread exactly once
                       (no emulated keydown — a second handler would double-activate). The resolve
                       action is a sibling inside the card: a button cannot contain another button,
                       and the E2E resolves a thread from `.tm-nbcp__thread-card`. *@
                    <div class="tm-nbcp__thread-card @(comment.IsResolved() ? "tm-nbcp__thread-card--resolved" : "")"
                         role="listitem">
                    <button type="button"
                            class="tm-nbcp__thread-card__open"
                            @onclick="() => SelectThreadAsync(comment)">
                        <div class="tm-nbcp__thread-card__avatar" aria-hidden="true">
                            @if (firstEntry is not null && !string.IsNullOrEmpty(firstEntry.AuthorAvatarUrl()))
                            {
                                <img class="tm-nbcp__thread-card__avatar-img" src="@firstEntry.AuthorAvatarUrl()" alt="" />
                            }
                            else
                            {
                                <span class="tm-nbcp__thread-card__avatar-fallback">
                                    @(firstEntry is not null ? AvatarInitial(firstEntry.AuthorDisplayName()) : "?")
                                </span>
                            }
                        </div>
                        <div class="tm-nbcp__thread-card__body">
                            <div class="tm-nbcp__thread-card__meta">
                                <span class="tm-nbcp__thread-card__author">@(firstEntry?.AuthorDisplayName() ?? "")</span>
                                @if (firstEntry is not null)
                                {
                                    <time class="tm-nbcp__thread-card__time"
                                          datetime="@firstEntry.CreatedAt.UtcDateTime.ToString("O", System.Globalization.CultureInfo.InvariantCulture)"
                                          title="@AbsoluteTime(firstEntry.CreatedAt)">
                                        @FormatTime(firstEntry.CreatedAt)
                                    </time>
                                }
                            </div>
                            <div class="tm-nbcp__thread-card__preview">
                                @(firstEntry is not null ? StripHtml(firstEntry.HtmlContent()) : "")
                            </div>
                            <div class="tm-nbcp__thread-card__stats">
                                @if (comment.Entries.Count > 1)
                                {
                                    <span>@Loc["TmNotionBlockComment_RepliesCount", comment.Entries.Count - 1]</span>
                                }
                                @if (comment.IsResolved())
                                {
                                    <span class="tm-nbcp__thread-card__resolved-badge">@Loc["TmNotionBlockComment_Resolved"]</span>
                                }
                            </div>
                        </div>
                    </button>
                            <div class="tm-nbcp__thread-card__actions" role="group" aria-label="@Loc["TmNotionBlockComment_ThreadActions"]">
                                @if (!comment.IsResolved())
                                {
                                    <button class="tm-nbcp__thread-card__action"
                                            type="button"
                                            title="@Loc["TmNotionBlockComment_Resolve"]"
                                            @onclick="() => ResolveThreadAsync(comment)">
                                        <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                                            <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.4"/>
                                            <path d="M4.5 7l2 2 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        @Loc["TmNotionBlockComment_Resolve"]
                                    </button>
                                }
                                else
                                {
                                    <button class="tm-nbcp__thread-card__action tm-nbcp__thread-card__action--unresolve"
                                            type="button"
                                            title="@Loc["TmNotionBlockComment_Unresolve"]"
                                            @onclick="() => UnresolveThreadAsync(comment)">
                                        <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                                            <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.4"/>
                                            <path d="M4.5 7l2 2 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        @Loc["TmNotionBlockComment_Unresolve"]
                                    </button>
                                }
                            </div>
                    </div>
                }
            </div>
        }

        @* ── Thread detail (entries) ───────────────────────────────────────── *@
        @if (IsThreadDetail || _isCreatingNewThread)
        {
            @if (_selectedComment?.IsResolved() == true)
            {
                <div class="tm-nbcp__resolved-banner" role="status">
                    <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                        <circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.4"/>
                        <path d="M4 6.5l2 2 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    @Loc["TmNotionBlockComment_Resolved"]
                </div>
            }

            <TmNotionCommentThreadList ClassPrefix="tm-nbcp"
                                       Class="tm-nbcp__thread"
                                       ListLabel="@Loc["TmNotionBlockComment_Thread"]"
                                       Loading="_loading"
                                       Empty="@(_selectedComment is null && !_isCreatingNewThread)"
                                       LoadingText="@Loc["TmNotionBlockComment_Loading"]"
                                       EmptyText="@Loc["TmNotionBlockComment_NoComments"]"
                                       ShowDeleteConfirm="_showDeleteConfirm"
                                       DeleteTitle="@Loc["TmNotionBlockComment_Delete"]"
                                       DeleteMessage="@Loc["TmNotionBlockComment_DeleteConfirm"]"
                                       DeleteOkText="@Loc["Tm_Delete"]"
                                       DeleteCancelText="@Loc["Tm_Cancel"]"
                                       OnDeleteResult="HandleDeleteConfirmResult">
                @if (_selectedComment is not null)
                {
                    <TmNotionCommentThreadView ClassPrefix="tm-nbcp"
                                               Nodes="_threadTree"
                                               ReplyingToEntryId="@_replyingToEntryId"
                                               EditingEntryId="@_editingEntryId"
                                               EditText="@_editText"
                                               OnEditTextChanged="OnEditTextChanged"
                                               OnEditKeyDown="HandleEditKeyDownAsync"
                                               InlineReplyText="@_inlineReplyText"
                                               InlineReplyBaseline="@_inlineReplyBaseline"
                                               InlineReplyResetToken="_inlineReset"
                                               InlineReplyTextChanged="OnInlineText"
                                               FormatTime="FormatTime"
                                               AbsoluteTime="AbsoluteTime"
                                               FormatBody="FormatEntry"
                                               CanEdit="e => e.CanEdit"
                                               CanDelete="e => e.CanDelete"
                                               MentionProvider="Context.MentionProvider"
                                               OnEntryKeyDown="OnEntryKey"
                                               OnReply="StartReplyToEntry"
                                               OnEdit="StartEdit"
                                               OnDelete="DeleteEntryAsync"
                                               OnSubmitReply="SendInlineReplyAsync"
                                               OnCancelReply="CancelInlineReply"
                                               OnSaveEdit="SaveEditAsync"
                                               OnCancelEdit="CancelEdit"
                                               OnDraftChanged="NotifyDraftChangedAsync"
                                               Submitting="_submitting"
                                               LabelPrefix="TmNotionBlockComment">
                        <Reactions>
                            <span @onkeydown:stopPropagation="true">
                                <TmCommentReactions Reactions="context.Reactions"
                                                    EntryId="@context.Id"
                                                    CurrentUserId="@CurrentUserId"
                                                    Provider="@(Context.CommentProvider as ITmCommentReactionProvider)"
                                                    OnChanged="StateHasChanged" />
                            </span>
                        </Reactions>
                    </TmNotionCommentThreadView>
                }
            </TmNotionCommentThreadList>

            @* ── Reply input ─────────────────────────────────────────────────── *@
            @if ((_selectedComment is null || !_selectedComment.IsResolved()) && _replyingToEntryId is null)
            {
                <TmNotionCommentComposer ClassPrefix="tm-nbcp"
                                         Class="tm-nbcp__reply"
                                         Value=""
                                         ResetToken="_composerReset"
                                         TextChanged="OnReplyText"
                                         DraftChanged="OnReplyDraft"
                                         Placeholder="@Loc[_isCreatingNewThread ? "TmNotionBlockComment_NewPlaceholder" : "TmNotionBlockComment_ReplyPlaceholder"]"
                                         AriaLabel="@Loc["TmNotionBlockComment_ReplyLabel"]"
                                         Hint="@Loc["TmNotionBlockComment_ReplyHint"]"
                                         SubmitText="@Loc[_isCreatingNewThread ? "TmNotionBlockComment_Comment" : "TmNotionBlockComment_Reply"]"
                                         OnSubmit="SubmitReply"
                                         Submitting="_submitting"
                                         ShowAvatar="true"
                                         AuthorName="@CurrentUserId"
                                         MentionProvider="Context.MentionProvider" />
            }
        }

        @* ── Error ──────────────────────────────────────────────────────── *@
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="tm-nbcp__error" role="alert">@_error</div>
        }

        </div>
    };
}


