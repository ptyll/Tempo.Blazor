@namespace Tempo.Blazor.Components.NotionEditor.UI
@using Tempo.Blazor.Components.Overlay

<TmNotionFloatingMenu IsOpen="Visible"
                      LayoutMode="LayoutMode"
                      Top="Top"
                      Left="Left"
                      Placement="OverlayPlacement.Bottom"
                      Role="dialog"
                      Title="@Loc["TmNotionTokenDropdown_Label"]"
                      AriaLabel="@Loc["TmNotionTokenDropdown_Label"]"
                      Class="tm-notion-token-dropdown"
                      OnClose="HandleBackdropClickAsync">
    <div class="tm-notion-token-dropdown__body" @onkeydown:stopPropagation="true">

        @* ── Search input ──────────────────────────────────────────────────────── *@
        <div class="tm-notion-token-dropdown__search">
            <svg class="tm-notion-token-dropdown__search-icon" width="14" height="14" viewBox="0 0 14 14"
                 fill="none" aria-hidden="true">
                <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.3"/>
                <path d="M9.5 9.5l3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            </svg>
            <input class="tm-notion-token-dropdown__input"
                   type="text"
                   autocomplete="off"
                   spellcheck="false"
                   placeholder="@Loc["TmNotionTokenDropdown_SearchPlaceholder"]"
                   value="@_query"
                   @ref="_inputRef"
                   @oninput="HandleQueryInputAsync"
                   @onkeydown="HandleKeyDownAsync" />
        </div>

        @* ── Item list ─────────────────────────────────────────────────────────── *@
        <div class="tm-notion-token-dropdown__list" role="listbox" @ref="_listRef">
            @if (_isLoading)
            {
                <div class="tm-notion-token-dropdown__loading" aria-label="@Loc["TmNotionTokenDropdown_Loading"]">
                    <span class="tm-notion-token-dropdown__spinner" aria-hidden="true"></span>
                </div>
            }
            else if (_items.Count == 0)
            {
                <div class="tm-notion-token-dropdown__empty">@Loc["TmNotionTokenDropdown_NoResults"]</div>
            }
            else
            {
                @foreach (var (token, idx) in _items.Select((t, i) => (t, i)))
                {
                    var isSelected = idx == _selectedIndex;
                    <div class="tm-notion-token-dropdown__item @(isSelected ? "tm-notion-token-dropdown__item--selected" : "")"
                         role="option"
                         aria-selected="@isSelected"
                         @onclick="() => SelectItemAsync(token)"
                         @onpointermove="() => _selectedIndex = idx">
                        @if (!string.IsNullOrEmpty(token.Icon))
                        {
                            <span class="tm-notion-token-dropdown__item-icon" aria-hidden="true">@token.Icon</span>
                        }
                        <span class="tm-notion-token-dropdown__item-body">
                            <span class="tm-notion-token-dropdown__item-name">@token.DisplayName</span>
                            @if (!string.IsNullOrEmpty(token.Description))
                            {
                                <span class="tm-notion-token-dropdown__item-desc">@token.Description</span>
                            }
                        </span>
                        @if (!string.IsNullOrEmpty(token.TypeLabel))
                        {
                            <span class="tm-notion-token-dropdown__item-type">@token.TypeLabel</span>
                        }
                    </div>
                }
            }
        </div>

        @* ── Create token footer ───────────────────────────────────────────────── *@
        @if (OnCreateRequested.HasDelegate)
        {
            <div class="tm-notion-token-dropdown__footer">
                <button class="tm-notion-token-dropdown__create-btn"
                        type="button"
                        @onclick="HandleCreateAsync"
                        @onclick:stopPropagation="true">
                    <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <line x1="7" y1="1" x2="7" y2="13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                        <line x1="1" y1="7" x2="13" y2="7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                    @if (!string.IsNullOrWhiteSpace(_query))
                    {
                        @(string.Format(Loc["TmNotionTokenDropdown_CreateTokenNamed"], _query))
                    }
                    else
                    {
                        @Loc["TmNotionTokenDropdown_CreateToken"]
                    }
                </button>
            </div>
        }
    </div>
</TmNotionFloatingMenu>
