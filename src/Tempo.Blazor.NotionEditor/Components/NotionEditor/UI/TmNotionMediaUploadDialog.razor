@namespace Tempo.Blazor.Components.NotionEditor.UI
@using Tempo.Blazor.Components.NotionEditor.Services
@using Microsoft.AspNetCore.Components.Forms
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Feedback

@if (IsOpen)
{
    <TmModal Show="true"
             OnClose="HandleCancelAsync"
             Title="@_dialogTitle"
             Size="ModalSize.Large"
             MobilePresentation="MobilePresentation.Sheet"
             LayoutMode="ResolvedLayout"
              CloseOnOverlayClick="false"
             Class="tm-media-dialog-host">
    <ChildContent>
        <div class="tm-media-dialog"
             @ref="_dialogRef">

            <div class="tm-media-dialog__tabs" role="tablist" aria-label="@_dialogTitle">
                @if (CanUpload)
                {
                    <button class="tm-media-dialog__tab @(_activeTab == "upload" ? "tm-media-dialog__tab--active" : "")"
                            role="tab"
                            id="tm-media-tab-upload"
                            aria-controls="tm-media-panel-upload"
                            aria-selected="@(_activeTab == "upload" ? "true" : "false")"
                            tabindex="@(_activeTab == "upload" ? 0 : -1)"
                            type="button"
                            @onclick='() => SetTab("upload")'
                            @onkeydown="HandleTabKeyAsync"
                            @onkeydown:stopPropagation="true">
                        @Loc["TmNotionMediaUploadDialog_TabUpload"]
                    </button>
                }
                <button class="tm-media-dialog__tab @(_activeTab == "embed" ? "tm-media-dialog__tab--active" : "")"
                        role="tab"
                        id="tm-media-tab-embed"
                        aria-controls="tm-media-panel-embed"
                        aria-selected="@(_activeTab == "embed" ? "true" : "false")"
                        tabindex="@(_activeTab == "embed" ? 0 : -1)"
                        type="button"
                        @onclick='() => SetTab("embed")'
                        @onkeydown="HandleTabKeyAsync"
                        @onkeydown:stopPropagation="true">
                    @Loc["TmNotionMediaUploadDialog_TabEmbed"]
                </button>
                @if (CanBrowseLibrary)
                {
                    <button class="tm-media-dialog__tab @(_activeTab == "library" ? "tm-media-dialog__tab--active" : "")"
                            role="tab"
                            id="tm-media-tab-library"
                            aria-controls="tm-media-panel-library"
                            aria-selected="@(_activeTab == "library" ? "true" : "false")"
                            tabindex="@(_activeTab == "library" ? 0 : -1)"
                            type="button"
                            data-tab="library"
                            @onclick='() => SetTab("library")'
                            @onkeydown="HandleTabKeyAsync"
                            @onkeydown:stopPropagation="true">
                        @Loc["TmNotionMediaUploadDialog_TabLibrary"]
                    </button>
                }
            </div>

            <div class="tm-media-dialog__body">
                @if (!CanUpload)
                {
                    <div class="tm-media-dialog__notice" role="status">
                        @Loc["TmNotionMediaUploadDialog_NoProvider"]
                    </div>
                }

                @if (CanUpload)
                {
                    <div id="tm-media-panel-upload" role="tabpanel" aria-labelledby="tm-media-tab-upload" hidden="@(_activeTab != "upload")">
                    <label class="tm-media-dialog__dropzone @(_isDragging ? "tm-media-dialog__dropzone--dragging" : "")"
                           @ondragenter="() => _isDragging = true"
                           @ondragleave="() => _isDragging = false"
                           @ondragover:preventDefault="true">
                        <svg class="tm-media-dialog__dropzone-icon" width="36" height="36"
                             viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" stroke="currentColor"
                                  stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <polyline points="17 8 12 3 7 8" stroke="currentColor" stroke-width="1.5"
                                      stroke-linecap="round" stroke-linejoin="round"/>
                            <line x1="12" y1="3" x2="12" y2="15" stroke="currentColor"
                                  stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                        <span class="tm-media-dialog__dropzone-text">@Loc["TmNotionMediaUploadDialog_DropZone"]</span>
                        <span class="tm-media-dialog__browse-hint">@Loc["TmNotionMediaUploadDialog_BrowseFiles"]</span>
                        <span class="tm-media-dialog__choose-file">@Loc["TmNotionMediaUploadDialog_ChooseFile"]</span>
                        <span class="tm-media-dialog__formats">@string.Format(Loc["TmNotionMediaUploadDialog_Formats"], SupportedFormats)</span>
                        <InputFile class="tm-media-dialog__file-input"
                                   accept="@_acceptTypes"
                                   OnChange="HandleFileSelectedAsync" />
                    </label>

                    @if (_isUploading)
                    {
                        <div class="tm-media-dialog__status">
                            <span class="tm-media-dialog__spinner" aria-hidden="true"></span>
                            <span>@Loc["TmNotionMediaUploadDialog_Uploading"]</span>
                        </div>
                    }

                    @if (_selectedFile is not null)
                    {
                        <div class="tm-media-dialog__selected" data-testid="notion-media-selected-file">
                            <span>@Loc["TmNotionMediaUploadDialog_SelectedFile"]</span>
                            <span class="tm-media-dialog__selected-name">@_selectedFile.Name</span>
                            <span>@FormatSize(_selectedFile.Size)</span>
                            <button type="button"
                                    class="tm-media-dialog__selected-remove"
                                    aria-label="@Loc["TmNotionMediaUploadDialog_RemoveFile"]"
                                    @onclick="ClearSelectedFile">×</button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_uploadError))
                    {
                        <div class="tm-media-dialog__error" role="alert">@_uploadError</div>
                    }
                    </div>
                }
                else if (_activeTab == "library")
                {
                    <div id="tm-media-panel-library" role="tabpanel" aria-labelledby="tm-media-tab-library" class="tm-media-library">
                        <div class="tm-media-library__search">
                            <input class="tm-media-library__search-input"
                                   type="search"
                                   placeholder="@Loc["TmNotionMediaUploadDialog_LibrarySearch"]"
                                   value="@_libraryQuery"
                                   @oninput="OnLibrarySearchChangedAsync"
                                   aria-label="@Loc["TmNotionMediaUploadDialog_LibrarySearch"]" />
                        </div>

                        @if (_isLoadingLibrary && !_libraryItems.Any())
                        {
                            <div class="tm-media-dialog__status tm-media-library__status">
                                <span class="tm-media-dialog__spinner" aria-hidden="true"></span>
                                <span>@Loc["TmNotionMediaUploadDialog_LibraryLoading"]</span>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(_libraryError))
                        {
                            <div class="tm-media-dialog__error" role="alert">@_libraryError</div>
                        }
                        else if (_libraryLoaded && !_libraryItems.Any())
                        {
                            <div class="tm-media-library__empty">@Loc["TmNotionMediaUploadDialog_LibraryEmpty"]</div>
                        }
                        else
                        {
                            <div class="tm-media-library__grid" role="listbox"
                                 aria-label="@Loc["TmNotionMediaUploadDialog_LibraryGridLabel"]">
                                @foreach (var item in _libraryItems)
                                {
                                    <button class="tm-media-library__item @(_selectedLibraryItem?.Id == item.Id ? "tm-media-library__item--selected" : "")"
                                            type="button"
                                            role="option"
                                            aria-selected="@((_selectedLibraryItem?.Id == item.Id).ToString().ToLowerInvariant())"
                                            title="@item.Name"
                                            @onclick="() => SelectLibraryItem(item)"
                                            @ondblclick="() => HandleLibraryItemSelectedAsync(item)"
                                            @onkeydown:stopPropagation="true">
                                        @if (!string.IsNullOrEmpty(item.ThumbnailUrl))
                                        {
                                            <img src="@item.ThumbnailUrl"
                                                 alt="@item.Name"
                                                 class="tm-media-library__item-thumb"
                                                 loading="lazy"
                                                 draggable="false" />
                                        }
                                        else
                                        {
                                            <div class="tm-media-library__item-icon" aria-hidden="true">
                                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                                                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8L14 2z"
                                                          stroke="currentColor" stroke-width="1.5"
                                                          stroke-linecap="round" stroke-linejoin="round"/>
                                                    <path d="M14 2v6h6" stroke="currentColor" stroke-width="1.5"
                                                          stroke-linecap="round"/>
                                                </svg>
                                            </div>
                                        }
                                        <span class="tm-media-library__item-name">@item.Name</span>
                                    </button>
                                }
                            </div>

                            @if (_libraryHasMore)
                            {
                                <div class="tm-media-library__more">
                                    <button class="tm-media-library__more-btn"
                                            type="button"
                                            disabled="@_isLoadingLibrary"
                                            @onclick="() => LoadLibraryAsync(reset: false)">
                                        @if (_isLoadingLibrary)
                                        {
                                            <span class="tm-media-dialog__spinner" aria-hidden="true"></span>
                                        }
                                        @Loc["TmNotionMediaUploadDialog_LibraryLoadMore"]
                                    </button>
                                </div>
                            }
                        }
                    </div>
                }
                @{
                    /* always rendered so aria-controls has a target; hidden hides the inactive tab */
                    <div id="tm-media-panel-embed" role="tabpanel" aria-labelledby="tm-media-tab-embed" class="tm-media-dialog__embed" hidden="@(_activeTab != "embed")">
                        <div class="tm-media-dialog__embed-row">
                            <input class="tm-media-dialog__url-input"
                                   type="url"
                                   placeholder="@Loc["TmNotionMediaUploadDialog_UrlPlaceholder"]"
                                   @bind="_embedUrl"
                                   @bind:event="oninput"
                                   @onkeydown="HandleUrlKeyDownAsync"
                                   @ref="_urlInputRef" />
                            <button class="tm-media-dialog__embed-btn"
                                    type="button"
                                    disabled="@(string.IsNullOrWhiteSpace(_embedUrl))"
                                    @onclick="HandleEmbedConfirmAsync">
                                @Loc["TmNotionMediaUploadDialog_UrlConfirm"]
                            </button>
                        </div>
                    </div>
                }

            </div>

        </div>
    </ChildContent>
    <Footer>
        <TmButton Variant="ButtonVariant.Ghost" OnClick="HandleCancelAsync">@Loc["TmNotionMediaUploadDialog_Cancel"]</TmButton>
        <TmButton Variant="ButtonVariant.Primary"
                  Disabled="@(_selectedLibraryItem is null && _selectedFile is null && string.IsNullOrWhiteSpace(_embedUrl))"
                  OnClick="InsertSelectedAsync"
                  data-testid="notion-media-insert">
            @Loc["TmNotionMediaUploadDialog_Insert"]
        </TmButton>
    </Footer>
    </TmModal>
}
