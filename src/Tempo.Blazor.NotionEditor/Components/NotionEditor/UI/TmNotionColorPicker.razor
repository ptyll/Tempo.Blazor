@namespace Tempo.Blazor.Components.NotionEditor.UI
@using Tempo.Blazor.Components.Overlay

<TmNotionFloatingMenu IsOpen="Visible"
                      LayoutMode="LayoutMode"
                      Top="Top"
                      Left="Left"
                      Placement="OverlayPlacement.Bottom"
                      Role="dialog"
                      Title="@Loc["TmNotionColorPicker_TextColor"]"
                      AriaLabel="@Loc["TmNotionColorPicker_TextColor"]"
                      Class="tm-notion-color-picker"
                      OnClose="HandleBackdropClickAsync">
    <div class="tm-notion-color-picker__body" @onkeydown="HandleKeyDownAsync" @onmousedown:preventDefault="true">

        @* ── Text colors section ───────────────────────────────────────────── *@
        <div class="tm-notion-color-picker__section-label" role="presentation">
            @Loc["TmNotionColorPicker_TextColor"]
        </div>

        @foreach (var entry in _textColors)
        {
            var capturedEntry = entry;
            var isSelected    = SelectedTextColor == capturedEntry.Hex;
            <button class="tm-notion-color-picker__item @(isSelected ? "tm-notion-color-picker__item--selected" : "")"
                    role="option"
                    aria-selected="@isSelected"
                    aria-label="@Loc[capturedEntry.NameKey]"
                    title="@Loc[capturedEntry.NameKey]"
                    @onclick="() => HandleTextColorAsync(capturedEntry.Hex)"
                    @onclick:preventDefault="true">

                <span class="tm-notion-color-picker__swatch tm-notion-color-picker__swatch--text"
                      style="@(capturedEntry.Hex is not null ? $"color:var(--tm-notion-color-{capturedEntry.Hex})" : "")"
                      aria-hidden="true">
                    @if (capturedEntry.Hex is null)
                    {
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                            <path d="M2 10L10 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                    }
                    else
                    {
                        <span>A</span>
                    }
                </span>

                <span class="tm-notion-color-picker__label">@Loc[capturedEntry.NameKey]</span>

                <svg class="tm-notion-color-picker__check @(isSelected ? "tm-notion-color-picker__check--visible" : "")"
                     width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M2.5 7L5.5 10L11.5 4" stroke="currentColor" stroke-width="1.5"
                          stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        }

        <div class="tm-notion-color-picker__divider" role="separator"></div>

        @* ── Background colors section ─────────────────────────────────────── *@
        <div class="tm-notion-color-picker__section-label" role="presentation">
            @Loc["TmNotionColorPicker_BgColor"]
        </div>

        @foreach (var entry in _bgColors)
        {
            var capturedEntry = entry;
            var isSelected    = SelectedBgColor == capturedEntry.Hex;
            <button class="tm-notion-color-picker__item @(isSelected ? "tm-notion-color-picker__item--selected" : "")"
                    role="option"
                    aria-selected="@isSelected"
                    aria-label="@Loc[capturedEntry.NameKey]"
                    title="@Loc[capturedEntry.NameKey]"
                    @onclick="() => HandleBgColorAsync(capturedEntry.Hex)"
                    @onclick:preventDefault="true">

                <span class="tm-notion-color-picker__swatch tm-notion-color-picker__swatch--bg"
                      style="@(capturedEntry.Hex is not null ? $"background:var(--tm-notion-color-{capturedEntry.Hex}-bg)" : "")"
                      aria-hidden="true">
                    @if (capturedEntry.Hex is null)
                    {
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                            <path d="M2 10L10 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                    }
                </span>

                <span class="tm-notion-color-picker__label">@Loc[capturedEntry.NameKey]</span>

                <svg class="tm-notion-color-picker__check @(isSelected ? "tm-notion-color-picker__check--visible" : "")"
                     width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M2.5 7L5.5 10L11.5 4" stroke="currentColor" stroke-width="1.5"
                          stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        }

    </div>
</TmNotionFloatingMenu>
