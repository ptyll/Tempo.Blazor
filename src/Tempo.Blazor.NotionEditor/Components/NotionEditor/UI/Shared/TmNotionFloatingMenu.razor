@namespace Tempo.Blazor.Components.NotionEditor.UI
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Abstractions.Layout
@using Tempo.Blazor.Components.Overlay

@* N5: a thin wrap of the core overlay. Title and Close exist only on the mobile sheet. Escape is
   stopped here so a nested menu closes itself and the outer one stays open. *@
<div class="tm-notion-floating-menu" @onkeydown="OnKeyDown" @onkeydown:stopPropagation="true">
<span @ref="_anchor" class="tm-notion-floating-menu__anchor" style="@AnchorStyle" aria-hidden="true"></span>
<TmOverlayPanel Anchor="_anchor"
                IsOpen="IsOpen"
                IsOpenChanged="OnOpenChanged"
                LayoutMode="LayoutMode"
                MobilePresentation="PanelPresentation.Auto"
                Placement="Placement"
                Align="OverlayAlign.Start"
                Title="@(IsSheet ? Title : null)"
                SheetTitle="@Title"
                Role="@Role"
                AriaLabel="@(AriaLabel ?? Title)"
                CloseOnEscape="true"
                CloseOnOutsidePointerDown="true"
                OnDismissed="OnDismissed">
    @* The consumer class rides the body wrapper — the only surface rendered in BOTH the popover
       and the sheet presentation (the core overlay never forwards Class onto the sheet content).
       E2E selectors and the scoped card rules key off it. *@
    <div class="tm-notion-floating-menu__body @Class">
        @* The sheet header carries the title (SheetTitle is always passed) — an inner copy would
           render it twice. *@
        @ChildContent
        @if (IsSheet)
        {
            <button type="button" class="tm-notion-floating-menu__close" @onclick="CloseAsync">@Loc["Tm_Close"]</button>
        }
        @if (IsSheet && Footer is not null)
        {
            <div class="tm-notion-floating-menu__footer">@Footer</div>
        }
    </div>
</TmOverlayPanel>
</div>
