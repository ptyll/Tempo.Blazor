@namespace Tempo.Blazor.Components.NotionEditor.UI
@inherits Tempo.Blazor.Components.TmComponentBase

@* Phase 6 (N10): the shortcuts panel rides the core TmModal — a sheet on mobile. The kbd text
   stays in the accessibility tree. *@
<TmModal Show="Visible"
         OnClose="CloseAsync"
         Title="@Loc["Notion_Shortcuts_Title"]"
         Subtitle="@Loc["Notion_Shortcuts_Subtitle"]"
         Size="ModalSize.Medium"
         MobilePresentation="MobilePresentation.Sheet"
         LayoutMode="LayoutMode"
         Class="tm-nsp-host">
    <ChildContent>
        <div class="tm-nsp" data-testid="@TestId("notion-shortcuts-panel")">

            <div class="tm-nsp__grid">
                @foreach (var group in Groups)
                {
                    <section class="tm-nsp__group" data-shortcut-group="@group.TitleKey">
                        <h3 class="tm-nsp__group-title">@Loc[group.TitleKey]</h3>
                        <ul class="tm-nsp__list" aria-label="@Loc[group.TitleKey]">
                            @foreach (var item in group.Items)
                            {
                                <li class="tm-nsp__item" data-shortcut-action="@item.Action">
                                    <span class="tm-nsp__description">@Loc[item.DescriptionKey]</span>
                                    <span class="tm-nsp__keys">
                                        @foreach (var key in item.Keys)
                                        {
                                            <kbd class="tm-nsp__key">@key</kbd>
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                    </section>
                }
            </div>
        </div>
    </ChildContent>
</TmModal>
