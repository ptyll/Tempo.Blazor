@namespace Tempo.Blazor.Components.NotionEditor.UI
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Abstractions.Shared
@using Tempo.Blazor.Components.Dropdowns
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Icons

<section class="tm-notion-audit @LayoutModifier @Class" aria-label="@Loc["Notion_Audit_Title"]" data-testid="@TestId("notion-audit-panel")">
    <TmNotionPanelHeader Title="@Loc["Notion_Audit_Title"]"
                         OnClosed="OnClosed">
        <Actions>
            <span class="tm-notion-audit__subtitle" data-testid="@TestId("notion-audit-count")">@Loc["Notion_Audit_Count", _result.TotalCount]</span>
        </Actions>
    </TmNotionPanelHeader>

    @* ── Filters: inline on a wide container, sheet trigger on a compact one ── *@
    <div class="tm-notion-audit__filters tm-notion-audit__filters--inline" aria-label="@Loc["Notion_Audit_Filter"]">
        <label class="tm-notion-audit__field">
            <span>@Loc["Notion_Audit_User"]</span>
            <input value="@_userFilter"
                   data-testid="@TestId("notion-audit-user-filter")"
                   @oninput="OnUserFilterInput" />
        </label>

        <label class="tm-notion-audit__field">
            <span>@Loc["Notion_Audit_Action"]</span>
            <select value="@_actionFilter" data-testid="@TestId("notion-audit-action-filter")" @onchange="OnActionFilterChanged">
                <option value="">@Loc["Notion_Audit_Action_All"]</option>
                @foreach (var action in AvailableActions)
                {
                    <option value="@action">@GetActionLabel(action)</option>
                }
            </select>
        </label>

        <label class="tm-notion-audit__field">
            <span>@Loc["Notion_Audit_From"]</span>
            <input type="date" value="@_fromFilter" data-testid="@TestId("notion-audit-from-filter")" @onchange="OnFromFilterChanged" />
        </label>

        <label class="tm-notion-audit__field">
            <span>@Loc["Notion_Audit_To"]</span>
            <input type="date" value="@_toFilter" data-testid="@TestId("notion-audit-to-filter")" @onchange="OnToFilterChanged" />
        </label>

        <div class="tm-notion-audit__filter-actions">
            <button type="button" class="tm-notion-audit__button" data-testid="@TestId("notion-audit-apply")" @onclick="ApplyFiltersAsync">
                @Loc["Notion_Audit_Filter"]
            </button>
            <button type="button" class="tm-notion-audit__button tm-notion-audit__button--ghost" data-testid="@TestId("notion-audit-clear")" @onclick="ClearFiltersAsync">
                @Loc["Notion_Audit_Clear"]
            </button>
        </div>
    </div>

    @* ── Compact filter sheet trigger + the ⋯ overflow with the export ── *@
    <div class="tm-notion-audit__compact-bar">
        <button type="button"
                class="tm-notion-audit__button tm-notion-audit__button--ghost"
                data-testid="@TestId("notion-audit-filters-open")"
                @onclick="OpenFiltersSheetAsync">
            @(string.Format(Loc["Notion_Audit_FiltersOpen"], ActiveFilterCount))
        </button>
        <TmDropdown AriaLabel="@Loc["Notion_Audit_More"]"
                    Icon="@IconNames.MoreHorizontal"
                    Class="tm-notion-audit__more"
                    OnSelect="HandleMoreActionAsync">
            <ChildContent>
                <TmDropdownItem Value="export">@Loc["Notion_Audit_Export"]</TmDropdownItem>
            </ChildContent>
        </TmDropdown>
    </div>

    <div class="tm-notion-audit__toolbar">
        <button type="button"
                class="tm-notion-audit__button tm-notion-audit__button--primary"
                data-testid="@TestId("notion-audit-export")"
                disabled="@_isLoading"
                @onclick="PrepareCsvExportAsync">
            @Loc["Notion_Audit_Export"]
        </button>

        @if (_csvHref is not null)
        {
            <a class="tm-notion-audit__download"
               data-testid="@TestId("notion-audit-export-link")"
               href="@_csvHref"
               download="@CsvFileName">
                @Loc["Notion_Audit_DownloadReady"]
            </a>
        }
    </div>

    @if (_isLoading)
    {
        <div class="tm-notion-audit__state" role="status" aria-busy="true">
            <span class="tm-notion-audit__spinner" aria-hidden="true"></span>
            <span>@Loc["Tm_Loading"]</span>
        </div>
    }
    else if (_loadError is not null)
    {
        <div class="tm-notion-audit__state tm-notion-audit__state--error" role="alert">
            <span>@Loc["Notion_Audit_LoadError"]</span>
            <button type="button" class="tm-notion-audit__button" @onclick="LoadAsync">@Loc["Tm_Retry"]</button>
        </div>
    }
    else if (_result.Items.Count == 0)
    {
        <div class="tm-notion-audit__empty" data-testid="@TestId("notion-audit-empty")">
            @Loc["Notion_Audit_Empty"]
        </div>
    }
    else
    {
        @* ── Wide layout: a real table ──────────────────────────────────── *@
        <table class="tm-notion-audit__table" data-testid="@TestId("notion-audit-table")">
            <thead>
                <tr>
                    <th scope="col">@Loc["Notion_Audit_ColAction"]</th>
                    <th scope="col">@Loc["Notion_Audit_ColTimestamp"]</th>
                    <th scope="col">@Loc["Notion_Audit_ColUser"]</th>
                    <th scope="col">@Loc["Notion_Audit_ColEntityType"]</th>
                    <th scope="col">@Loc["Notion_Audit_ColEntityId"]</th>
                    <th scope="col">@Loc["Notion_Audit_ColDetails"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in _result.Items)
                {
                    var expanded = IsExpanded(entry);
                    <tr class="tm-notion-audit__row" data-testid="@TestId("notion-audit-row")">
                        <td>
                            <span class="tm-notion-audit__action tm-notion-audit__action--@NormalizeCssToken(entry.Action)">
                                @GetActionLabel(entry.Action)
                            </span>
                        </td>
                        <td>
                            <time datetime="@entry.Timestamp.ToString("O")">@FormatTimestamp(entry.Timestamp)</time>
                        </td>
                        <td>@GetUserDisplay(entry)</td>
                        <td><span class="tm-notion-audit__entity-type">@GetEntityTypeLabel(entry.EntityRef.EntityType)</span></td>
                        <td><code>@ShortenTargetId(entry.EntityRef.EntityId)</code></td>
                        <td>
                            @if (entry.Metadata?.Count > 0)
                            {
                                <button type="button"
                                        class="tm-notion-audit__row-toggle"
                                        aria-expanded="@(expanded ? "true" : "false")"
                                        aria-label="@Loc["Notion_Audit_DetailsFor", GetActionLabel(entry.Action), FormatTimestamp(entry.Timestamp)]"
                                        @onclick="() => ToggleExpanded(entry)">
                                    <svg class="tm-notion-audit__row-chevron @(expanded ? "tm-notion-audit__row-chevron--open" : "")"
                                         width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                                        <path d="M4 5.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </button>
                            }
                        </td>
                    </tr>
                    @if (entry.Metadata?.Count > 0 && expanded)
                    {
                        <tr class="tm-notion-audit__row-details-row">
                            <td colspan="6">
                                @EntryDetails(entry)
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        @* ── Narrow layout: cards (the container query picks one of the two) ── *@
        <ol class="tm-notion-audit__list" data-testid="@TestId("notion-audit-list")">
            @foreach (var entry in _result.Items)
            {
                var expanded = IsExpanded(entry);
                <li class="tm-notion-audit__entry" data-testid="@TestId("notion-audit-entry")">
                    <div class="tm-notion-audit__entry-head">
                        <span class="tm-notion-audit__action tm-notion-audit__action--@NormalizeCssToken(entry.Action)">
                            @GetActionLabel(entry.Action)
                        </span>
                        <time datetime="@entry.Timestamp.ToString("O")">@FormatTimestamp(entry.Timestamp)</time>
                        @if (entry.Metadata?.Count > 0)
                        {
                            <button type="button"
                                    class="tm-notion-audit__row-toggle"
                                    aria-expanded="@(expanded ? "true" : "false")"
                                    aria-label="@Loc["Notion_Audit_DetailsFor", GetActionLabel(entry.Action), FormatTimestamp(entry.Timestamp)]"
                                    @onclick="() => ToggleExpanded(entry)">
                                <svg class="tm-notion-audit__row-chevron @(expanded ? "tm-notion-audit__row-chevron--open" : "")"
                                     width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                                    <path d="M4 5.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                        }
                    </div>
                    <div class="tm-notion-audit__entry-main">
                        <strong>@GetUserDisplay(entry)</strong>
                        <span class="tm-notion-audit__entity-type">@GetEntityTypeLabel(entry.EntityRef.EntityType)</span>
                        <code>@ShortenTargetId(entry.EntityRef.EntityId)</code>
                    </div>
                    @if (entry.Metadata?.Count > 0 && expanded)
                    {
                        @EntryDetails(entry)
                    }
                </li>
            }
        </ol>

        <footer class="tm-notion-audit__pager" aria-label="@Loc["Notion_Audit_Page"]">
            <button type="button"
                    class="tm-notion-audit__icon-btn"
                    data-testid="@TestId("notion-audit-prev")"
                    disabled="@(!_result.HasPreviousPage)"
                    title="@Loc["Notion_Audit_Previous"]"
                    aria-label="@Loc["Notion_Audit_Previous"]"
                    @onclick="PreviousPageAsync">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M10 3.5L5.5 8l4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
            <span data-testid="@TestId("notion-audit-page")">@Loc["Notion_Audit_PageStatus", _result.Page, _result.TotalPages]</span>
            <button type="button"
                    class="tm-notion-audit__icon-btn"
                    data-testid="@TestId("notion-audit-next")"
                    disabled="@(!_result.HasNextPage)"
                    title="@Loc["Notion_Audit_Next"]"
                    aria-label="@Loc["Notion_Audit_Next"]"
                    @onclick="NextPageAsync">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M6 3.5L10.5 8 6 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        </footer>
    }
</section>

@* ── Compact filters sheet (a dialog on a wide container, a sheet on mobile) ── *@
@if (_filtersSheetOpen)
{
    <TmModal Show="true"
             OnClose="CloseFiltersSheet"
             Title="@Loc["Notion_Audit_FiltersSheet"]"
             Size="ModalSize.Small"
             MobilePresentation="MobilePresentation.Auto">
        <ChildContent>
            <div class="tm-notion-audit__filters tm-notion-audit__filters--sheet">
                <label class="tm-notion-audit__field">
                    <span>@Loc["Notion_Audit_User"]</span>
                    <input value="@_userFilter"
                           data-testid="@TestId("notion-audit-user-filter-sheet")"
                           @oninput="OnUserFilterInput" />
                </label>

                <label class="tm-notion-audit__field">
                    <span>@Loc["Notion_Audit_Action"]</span>
                    <select value="@_actionFilter" data-testid="@TestId("notion-audit-action-filter-sheet")" @onchange="OnActionFilterChanged">
                        <option value="">@Loc["Notion_Audit_Action_All"]</option>
                        @foreach (var action in AvailableActions)
                        {
                            <option value="@action">@GetActionLabel(action)</option>
                        }
                    </select>
                </label>

                <label class="tm-notion-audit__field">
                    <span>@Loc["Notion_Audit_From"]</span>
                    <input type="date" value="@_fromFilter" data-testid="@TestId("notion-audit-from-filter-sheet")" @onchange="OnFromFilterChanged" />
                </label>

                <label class="tm-notion-audit__field">
                    <span>@Loc["Notion_Audit_To"]</span>
                    <input type="date" value="@_toFilter" data-testid="@TestId("notion-audit-to-filter-sheet")" @onchange="OnToFilterChanged" />
                </label>

                <div class="tm-notion-audit__filter-actions">
                    <button type="button" class="tm-notion-audit__button" data-testid="@TestId("notion-audit-apply-sheet")" @onclick="ApplyFiltersFromSheetAsync">
                        @Loc["Notion_Audit_Filter"]
                    </button>
                    <button type="button" class="tm-notion-audit__button tm-notion-audit__button--ghost" data-testid="@TestId("notion-audit-clear-sheet")" @onclick="ClearFiltersFromSheetAsync">
                        @Loc["Notion_Audit_Clear"]
                    </button>
                </div>
            </div>
        </ChildContent>
    </TmModal>
}

@code {
    /// <summary>Details block shared by the table and card layouts: every metadata pair, translated keys.</summary>
    private RenderFragment EntryDetails(TmActivityEntry entry) => __builder =>
    {
        <dl class="tm-notion-audit__row-details" data-testid="@TestId("notion-audit-row-details")">
            @foreach (var detail in entry.Metadata!.OrderBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase))
            {
                <div>
                    <dt>@TranslateMetaKey(detail.Key)</dt>
                    <dd>@detail.Value</dd>
                </div>
            }
        </dl>
    };
}
