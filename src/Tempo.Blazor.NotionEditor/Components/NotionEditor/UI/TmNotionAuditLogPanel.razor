@namespace Tempo.Blazor.Components.NotionEditor.UI
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Abstractions.Shared

<section class="tm-notion-audit @Class" aria-label="@Loc["Notion_Audit_Title"]" data-testid="@TestId("notion-audit-panel")">
    <TmNotionPanelHeader Title="@Loc["Notion_Audit_Title"]"
                         OnClosed="OnClosed">
        <Actions>
            <span class="tm-notion-audit__subtitle" data-testid="@TestId("notion-audit-count")">@Loc["Notion_Audit_Count", _result.TotalCount]</span>
        </Actions>
    </TmNotionPanelHeader>

    <div class="tm-notion-audit__filters" aria-label="@Loc["Notion_Audit_Filter"]">
        <label class="tm-notion-audit__field">
            <span>@Loc["Notion_Audit_User"]</span>
            <input value="@_userFilter"
                   data-testid="@TestId("notion-audit-user-filter")"
                   @oninput="OnUserFilterInput" />
        </label>

        <label class="tm-notion-audit__field">
            <span>@Loc["Notion_Audit_Action"]</span>
            <select value="@_actionFilter" data-testid="@TestId("notion-audit-action-filter")" @onchange="OnActionFilterChanged">
                <option value="">@Loc["Notion_Audit_Action_All"]</option>
                @foreach (var action in AvailableActions)
                {
                    <option value="@action">@GetActionLabel(action)</option>
                }
            </select>
        </label>

        <label class="tm-notion-audit__field">
            <span>@Loc["Notion_Audit_From"]</span>
            <input type="date" value="@_fromFilter" data-testid="@TestId("notion-audit-from-filter")" @onchange="OnFromFilterChanged" />
        </label>

        <label class="tm-notion-audit__field">
            <span>@Loc["Notion_Audit_To"]</span>
            <input type="date" value="@_toFilter" data-testid="@TestId("notion-audit-to-filter")" @onchange="OnToFilterChanged" />
        </label>

        <div class="tm-notion-audit__filter-actions">
            <button type="button" class="tm-notion-audit__button" data-testid="@TestId("notion-audit-apply")" @onclick="ApplyFiltersAsync">
                @Loc["Notion_Audit_Filter"]
            </button>
            <button type="button" class="tm-notion-audit__button tm-notion-audit__button--ghost" data-testid="@TestId("notion-audit-clear")" @onclick="ClearFiltersAsync">
                @Loc["Notion_Audit_Clear"]
            </button>
        </div>
    </div>

    <div class="tm-notion-audit__toolbar">
        <button type="button"
                class="tm-notion-audit__button tm-notion-audit__button--primary"
                data-testid="@TestId("notion-audit-export")"
                disabled="@_isLoading"
                @onclick="PrepareCsvExportAsync">
            @Loc["Notion_Audit_Export"]
        </button>

        @if (_csvHref is not null)
        {
            <a class="tm-notion-audit__download"
               data-testid="@TestId("notion-audit-export-link")"
               href="@_csvHref"
               download="@CsvFileName">
                @Loc["Notion_Audit_DownloadReady"]
            </a>
        }
    </div>

    @if (_isLoading)
    {
        <div class="tm-notion-audit__state" role="status" aria-busy="true">
            <span class="tm-notion-audit__spinner" aria-hidden="true"></span>
            <span>@Loc["Tm_Loading"]</span>
        </div>
    }
    else if (_loadError is not null)
    {
        <div class="tm-notion-audit__state tm-notion-audit__state--error" role="alert">
            <span>@Loc["Notion_Audit_LoadError"]</span>
            <button type="button" class="tm-notion-audit__button" @onclick="LoadAsync">@Loc["Tm_Retry"]</button>
        </div>
    }
    else if (_result.Items.Count == 0)
    {
        <div class="tm-notion-audit__empty" data-testid="@TestId("notion-audit-empty")">
            @Loc["Notion_Audit_Empty"]
        </div>
    }
    else
    {
        <ol class="tm-notion-audit__list" data-testid="@TestId("notion-audit-list")">
            @foreach (var entry in _result.Items)
            {
                <li class="tm-notion-audit__entry" data-testid="@TestId("notion-audit-entry")">
                    <div class="tm-notion-audit__entry-head">
                        <span class="tm-notion-audit__action tm-notion-audit__action--@NormalizeCssToken(entry.Action)">
                            @GetActionLabel(entry.Action)
                        </span>
                        <time datetime="@entry.Timestamp.ToString("O")">@FormatTimestamp(entry.Timestamp)</time>
                    </div>
                    <div class="tm-notion-audit__entry-main">
                        <strong>@GetUserDisplay(entry)</strong>
                        <span>@entry.EntityRef.EntityType</span>
                        <code>@ShortenTargetId(entry.EntityRef.EntityId)</code>
                    </div>
                    @if (entry.Metadata?.Count > 0)
                    {
                        <dl class="tm-notion-audit__details">
                            @foreach (var detail in entry.Metadata.OrderBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase))
                            {
                                <div>
                                    <dt>@detail.Key</dt>
                                    <dd>@detail.Value</dd>
                                </div>
                            }
                        </dl>
                    }
                </li>
            }
        </ol>

        <footer class="tm-notion-audit__pager" aria-label="@Loc["Notion_Audit_Page"]">
            <button type="button"
                    class="tm-notion-audit__icon-btn"
                    data-testid="@TestId("notion-audit-prev")"
                    disabled="@(!_result.HasPreviousPage)"
                    title="@Loc["Notion_Audit_Previous"]"
                    aria-label="@Loc["Notion_Audit_Previous"]"
                    @onclick="PreviousPageAsync">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M10 3.5L5.5 8l4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
            <span data-testid="@TestId("notion-audit-page")">@Loc["Notion_Audit_PageStatus", _result.Page, _result.TotalPages]</span>
            <button type="button"
                    class="tm-notion-audit__icon-btn"
                    data-testid="@TestId("notion-audit-next")"
                    disabled="@(!_result.HasNextPage)"
                    title="@Loc["Notion_Audit_Next"]"
                    aria-label="@Loc["Notion_Audit_Next"]"
                    @onclick="NextPageAsync">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M6 3.5L10.5 8 6 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        </footer>
    }
</section>
