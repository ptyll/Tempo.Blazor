@namespace Tempo.Blazor.Components.NotionEditor.UI
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.NotionEditor.Enums

@if (Visible)
{
    <div class="tm-notion-inline-toolbar"
         role="group"
         aria-label="@Loc["TmNotionInlineToolbar_Label"]"
         style="top:@(_top)px;left:@(_leftClamped)px"
         @ref="_toolbarRef"
         @onkeydown="HandleKeyDownAsync">

        @if (_showLinkInput)
        {
            @* ── Link URL input panel ──────────────────────────────────────── *@
            <div class="tm-notion-inline-toolbar__link-panel">
                <svg class="tm-notion-inline-toolbar__link-icon" width="14" height="14" viewBox="0 0 14 14"
                     fill="none" aria-hidden="true">
                    <path d="M5.5 8.5a3 3 0 004.24 0l2-2a3 3 0 00-4.24-4.24L6.37 3.38"
                          stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                    <path d="M8.5 5.5a3 3 0 00-4.24 0l-2 2a3 3 0 004.24 4.24l1.12-1.12"
                          stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
                <input class="tm-notion-inline-toolbar__link-input"
                       type="url"
                       placeholder="@Loc["TmNotionInlineToolbar_LinkPlaceholder"]"
                       @bind="_linkUrl"
                       @bind:event="oninput"
                       @ref="_linkInputRef"
                       @onmousedown:stopPropagation="true"
                       @onkeydown="HandleLinkKeyDownAsync" />
                @if (!string.IsNullOrEmpty(CurrentHref))
                {
                    <button class="tm-notion-inline-toolbar__link-remove"
                            title="@Loc["TmNotionInlineToolbar_RemoveLink"]"
                            @onclick="HandleRemoveLinkAsync"
                            @onclick:preventDefault="true">
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                            <path d="M2 2l8 8M10 2L2 10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                        </svg>
                    </button>
                }
                <button class="tm-notion-inline-toolbar__link-apply"
                        @onclick="HandleApplyLinkAsync"
                        @onclick:preventDefault="true"
                        disabled="@string.IsNullOrWhiteSpace(_linkUrl)">
                    @Loc["TmNotionInlineToolbar_LinkApply"]
                </button>
            </div>
        }
        else if (_showColorPanel)
        {
            @* ── Color picker panel ─────────────────────────────────────────── *@
            <div class="tm-notion-inline-toolbar__color-panel">
                <div class="tm-notion-inline-toolbar__color-row-label">@Loc["TmNotionInlineToolbar_TextColor"]</div>
                <div class="tm-notion-inline-toolbar__color-row">
                    @foreach (var (name, textHex, _) in Colors)
                    {
                        var hex = textHex;
                        <button class="tm-notion-inline-toolbar__color-swatch @(hex is null ? "tm-notion-inline-toolbar__color-swatch--default" : "")"
                                style="@(hex is not null ? $"background:{hex}" : "")"
                                title="@Loc[$"TmNotionInlineToolbar_Color{char.ToUpper(name[0])}{name[1..]}"]"
                                @onclick="() => HandleTextColorAsync(hex)"
                                @onclick:preventDefault="true">
                            @if (hex is null)
                            {
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                                    <path d="M2 10L10 2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                                </svg>
                            }
                        </button>
                    }
                </div>
                <div class="tm-notion-inline-toolbar__color-row-label">@Loc["TmNotionInlineToolbar_BgColor"]</div>
                <div class="tm-notion-inline-toolbar__color-row">
                    @foreach (var (name, _, bgHex) in Colors)
                    {
                        var hex = bgHex;
                        <button class="tm-notion-inline-toolbar__color-swatch @(hex is null ? "tm-notion-inline-toolbar__color-swatch--default" : "")"
                                style="@(hex is not null ? $"background:{hex}" : "")"
                                title="@Loc[$"TmNotionInlineToolbar_Color{char.ToUpper(name[0])}{name[1..]}"]"
                                @onclick="() => HandleBgColorAsync(hex)"
                                @onclick:preventDefault="true">
                            @if (hex is null)
                            {
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                                    <path d="M2 10L10 2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                                </svg>
                            }
                        </button>
                    }
                </div>
            </div>
        }
        else if (_showTurnIntoPanel)
        {
            @* ── Turn Into panel ────────────────────────────────────────────── *@
            <div class="tm-notion-inline-toolbar__turninto-panel" role="listbox">
                @foreach (var (blockType, nameKey) in TurnIntoItems)
                {
                    var capturedType = blockType;
                    <button class="tm-notion-inline-toolbar__turninto-item"
                            role="option"
                            @onclick="() => HandleTurnIntoAsync(capturedType)"
                            @onclick:preventDefault="true">
                        @Loc[nameKey]
                    </button>
                }
            </div>
        }
        else if (_showAlignPanel)
        {
            @* ── Align panel ────────────────────────────────────────────────── *@
            <div class="tm-notion-inline-toolbar__align-panel">
                <button class="tm-notion-inline-toolbar__btn @(CurrentAlign == TextAlignment.Left ? "tm-notion-inline-toolbar__btn--active" : "")"
                        title="@Loc["TmNotionInlineToolbar_AlignLeft"]"
                        @onclick="() => HandleAlignAsync(TextAlignment.Left)"
                        @onclick:preventDefault="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M2 4h12M2 8h8M2 12h10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    </svg>
                </button>
                <button class="tm-notion-inline-toolbar__btn @(CurrentAlign == TextAlignment.Center ? "tm-notion-inline-toolbar__btn--active" : "")"
                        title="@Loc["TmNotionInlineToolbar_AlignCenter"]"
                        @onclick="() => HandleAlignAsync(TextAlignment.Center)"
                        @onclick:preventDefault="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M2 4h12M4 8h8M3 12h10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    </svg>
                </button>
                <button class="tm-notion-inline-toolbar__btn @(CurrentAlign == TextAlignment.Right ? "tm-notion-inline-toolbar__btn--active" : "")"
                        title="@Loc["TmNotionInlineToolbar_AlignRight"]"
                        @onclick="() => HandleAlignAsync(TextAlignment.Right)"
                        @onclick:preventDefault="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M2 4h12M6 8h8M4 12h10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
        }
        else
        {
            @* ── Main toolbar buttons ───────────────────────────────────────── *@

            @* Bold *@
            <button class="tm-notion-inline-toolbar__btn @(IsBold ? "tm-notion-inline-toolbar__btn--active" : "")"
                    title="@Loc["TmNotionInlineToolbar_Bold"]"
                    @onclick="HandleBoldAsync" @onclick:preventDefault="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M4 3h5a3 3 0 010 6H4V3zM4 9h5.5a3.5 3.5 0 010 7H4V9z"
                          stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>

            @* Italic *@
            <button class="tm-notion-inline-toolbar__btn @(IsItalic ? "tm-notion-inline-toolbar__btn--active" : "")"
                    title="@Loc["TmNotionInlineToolbar_Italic"]"
                    @onclick="HandleItalicAsync" @onclick:preventDefault="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M10 3H7M9 13H6M8.5 3L6.5 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </button>

            @* Underline *@
            <button class="tm-notion-inline-toolbar__btn @(IsUnderline ? "tm-notion-inline-toolbar__btn--active" : "")"
                    title="@Loc["TmNotionInlineToolbar_Underline"]"
                    @onclick="HandleUnderlineAsync" @onclick:preventDefault="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M4 3v5a4 4 0 008 0V3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M2 14h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </button>

            @* Strikethrough *@
            <button class="tm-notion-inline-toolbar__btn @(IsStrikethrough ? "tm-notion-inline-toolbar__btn--active" : "")"
                    title="@Loc["TmNotionInlineToolbar_Strikethrough"]"
                    @onclick="HandleStrikethroughAsync" @onclick:preventDefault="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3 8h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M5 5c0-1.1.9-2 2-2h2a2 2 0 010 4H7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    <path d="M7 8c-.9 0-2 .3-2 2a2 2 0 002 2h2a2 2 0 002-2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
            </button>

            @* Inline code *@
            <button class="tm-notion-inline-toolbar__btn @(IsCode ? "tm-notion-inline-toolbar__btn--active" : "")"
                    title="@Loc["TmNotionInlineToolbar_Code"]"
                    @onclick="HandleCodeAsync" @onclick:preventDefault="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M5 5L2 8l3 3M11 5l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>

            <span class="tm-notion-inline-toolbar__sep" role="separator"></span>

            @* Link *@
            <button class="tm-notion-inline-toolbar__btn @(!string.IsNullOrEmpty(CurrentHref) ? "tm-notion-inline-toolbar__btn--active" : "")"
                    title="@Loc["TmNotionInlineToolbar_Link"]"
                    @onclick="HandleLinkClickAsync" @onclick:preventDefault="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M6.5 9.5a3.5 3.5 0 005 0l2-2a3.5 3.5 0 00-5-4.95L7.38 3.68"
                          stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    <path d="M9.5 6.5a3.5 3.5 0 00-5 0l-2 2a3.5 3.5 0 004.95 4.95l1.13-1.13"
                          stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
            </button>

            @* Color (A with underline) *@
            <button class="tm-notion-inline-toolbar__btn tm-notion-inline-toolbar__btn--color"
                    title="@Loc["TmNotionInlineToolbar_Color"]"
                    @onclick="HandleColorClickAsync" @onclick:preventDefault="true">
                <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                    <text x="3" y="12" font-size="11" font-weight="700" fill="currentColor" font-family="system-ui,sans-serif">A</text>
                    <path d="M2 14h12" stroke="var(--tm-color-primary,#2383e2)" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </button>

            <span class="tm-notion-inline-toolbar__sep" role="separator"></span>

            @* Turn Into *@
            <button class="tm-notion-inline-toolbar__btn tm-notion-inline-toolbar__btn--text"
                    title="@Loc["TmNotionInlineToolbar_TurnInto"]"
                    aria-label="@Loc["TmNotionInlineToolbar_TurnInto"]"
                    @onclick="HandleTurnIntoClickAsync" @onclick:preventDefault="true">
                <svg class="tm-notion-inline-toolbar__turn-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <rect x="2.5" y="3" width="5" height="4" rx="1" stroke="currentColor" stroke-width="1.3"/>
                    <rect x="8.5" y="9" width="5" height="4" rx="1" stroke="currentColor" stroke-width="1.3"/>
                    <path d="M7.5 5h2.25A2.25 2.25 0 0112 7.25V9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
                <span class="tm-notion-inline-toolbar__btn-label">@Loc["TmNotionInlineToolbar_TurnInto"]</span>
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                    <path d="M2 4l3 3 3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>

            @* Align *@
            <button class="tm-notion-inline-toolbar__btn"
                    title="@Loc["TmNotionInlineToolbar_Align"]"
                    @onclick="HandleAlignClickAsync" @onclick:preventDefault="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M2 4h12M2 8h8M2 12h10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                    <path d="M2 4l3 3 3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>

            <span class="tm-notion-inline-toolbar__sep" role="separator"></span>

            @* Comment *@
            <button class="tm-notion-inline-toolbar__btn"
                    title="@Loc["TmNotionInlineToolbar_Comment"]"
                    @onclick="HandleCommentAsync" @onclick:preventDefault="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M13 3H3a1 1 0 00-1 1v7a1 1 0 001 1h2.5L7 14l1.5-2H13a1 1 0 001-1V4a1 1 0 00-1-1z"
                          stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>

            @* Math *@
            <button class="tm-notion-inline-toolbar__btn"
                    title="@Loc["TmNotionInlineToolbar_Math"]"
                    @onclick="HandleMathAsync" @onclick:preventDefault="true">
                <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                    <text x="3" y="12" font-size="12" fill="currentColor" font-family="serif">∑</text>
                </svg>
            </button>

            @if (ShowAI)
            {
                <span class="tm-notion-inline-toolbar__sep" role="separator"></span>

                <button class="tm-notion-inline-toolbar__btn"
                        title="@Loc["Notion_AI_Assistant"]"
                        data-testid="@TestId("notion-inline-ai")"
                        @onclick="HandleAIAsync" @onclick:preventDefault="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M8 1.75l1.05 3.2 3.2 1.05-3.2 1.05L8 10.25 6.95 7.05 3.75 6l3.2-1.05L8 1.75z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
                        <path d="M4.5 10.5l.55 1.65 1.65.55-1.65.55L4.5 14.9l-.55-1.65-1.65-.55 1.65-.55.55-1.65z" fill="currentColor"/>
                    </svg>
                </button>
            }
        }

    </div>
}
