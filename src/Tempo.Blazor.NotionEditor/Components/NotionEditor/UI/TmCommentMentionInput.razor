@namespace Tempo.Blazor.Components.NotionEditor.UI
@using Tempo.Blazor.Abstractions.Shared
@using Tempo.Blazor.Components.Overlay

<div class="tm-comment-mention-input">
    <textarea class="@Class"
              rows="@Rows"
              placeholder="@Placeholder"
              disabled="@Disabled"
              aria-label="@AriaLabel"
              value="@_text"
              @oninput="OnTextChangedAsync"
              @onkeydown="HandleKeyDownAsync"
              @ref="_textareaRef"></textarea>

    @* CF18-7: the dropdown is a TmOverlayPanel — popover="manual" puts it in the browser top
       layer so it paints above a host TmModal (the old z-index:1030 element sat under the
       modal band). The textarea itself is the anchor; overlay.js supplies outside-pointerdown
       + Escape dismissal and reflow on scroll/resize, replacing getMentionDropdownPosition. *@
    <TmOverlayPanel Anchor="_textareaRef"
                    IsOpen="_showDropdown"
                    IsOpenChanged="SetOpenFromJsAsync"
                    Placement="OverlayPlacement.Bottom"
                    Align="OverlayAlign.Start"
                    MatchAnchorWidth="true"
                    Role="listbox"
                    Class="tm-comment-mention-dropdown">
        @for (int i = 0; i < _users.Count; i++)
        {
            var idx = i;
            var user = _users[idx];
            <div class="tm-comment-mention-dropdown__item @(idx == _selectedIndex ? "tm-comment-mention-dropdown__item--selected" : "")"
                 role="option"
                 aria-selected="@(idx == _selectedIndex)"
                 @onclick="() => SelectUserAsync(user)"
                 @onmouseenter="() => _selectedIndex = idx">
                <div class="tm-comment-mention-dropdown__avatar" aria-hidden="true">
                    @if (!string.IsNullOrEmpty(user.AvatarUrl))
                    {
                        <img class="tm-comment-mention-dropdown__avatar-img" src="@user.AvatarUrl" alt="" />
                    }
                    else
                    {
                        <span class="tm-comment-mention-dropdown__avatar-fallback">
                            @(user.DisplayName.Length > 0 ? user.DisplayName[0].ToString().ToUpperInvariant() : "?")
                        </span>
                    }
                </div>
                <div class="tm-comment-mention-dropdown__body">
                    <span class="tm-comment-mention-dropdown__name">@user.DisplayName</span>
                    @if (!string.IsNullOrEmpty(user.Email))
                    {
                        <span class="tm-comment-mention-dropdown__email">@user.Email</span>
                    }
                </div>
            </div>
        }
    </TmOverlayPanel>
</div>

@code {
    private string _text = string.Empty;
    private bool _showDropdown;
    private int _selectedIndex;
    private List<TmUser> _users = new();
    private ElementReference _textareaRef;

    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public int Rows { get; set; } = 2;
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    [Parameter] public ITmPeopleProvider? MentionProvider { get; set; }

    protected override void OnParametersSet()
    {
        if (_text != Value)
            _text = Value;
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (_showDropdown && _users.Count > 0)
        {
            switch (e.Key)
            {
                case "ArrowDown":
                    _selectedIndex = (_selectedIndex + 1) % _users.Count;
                    return;
                case "ArrowUp":
                    _selectedIndex = (_selectedIndex - 1 + _users.Count) % _users.Count;
                    return;
                case "Enter":
                    if (!e.CtrlKey && !e.MetaKey && !e.ShiftKey)
                    {
                        await SelectUserAsync(_users[_selectedIndex]);
                        return;
                    }
                    break;
                case "Escape":
                    _showDropdown = false;
                    return;
            }
        }

        await OnKeyDown.InvokeAsync(e);
    }

    private async Task SelectUserAsync(TmUser user)
    {
        var query = GetMentionQuery(_text);
        if (query is not null)
        {
            // Replace the trailing @query with @DisplayName + space
            var lastAt = _text.LastIndexOf('@');
            if (lastAt >= 0)
            {
                _text = _text.Substring(0, lastAt) + "@" + user.DisplayName + " ";
                await ValueChanged.InvokeAsync(_text);
            }
        }
        _showDropdown = false;
        _users.Clear();
    }

    private void CloseDropdown()
    {
        _showDropdown = false;
    }

    private async Task OnTextChangedAsync(ChangeEventArgs e)
    {
        _text = e.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(_text);
        await UpdateDropdownAsync();
    }

    private async Task UpdateDropdownAsync()
    {
        var query = GetMentionQuery(_text);
        if (query is null || MentionProvider is null)
        {
            _showDropdown = false;
            _users.Clear();
            return;
        }

        try
        {
            _users = (await MentionProvider.SearchAsync(new TmPeopleQuery { SearchText = query, Take = 8 })).ToList();
            _selectedIndex = 0;
            _showDropdown = _users.Count > 0;
        }
        catch
        {
            _showDropdown = false;
            _users.Clear();
        }
    }

    /// <summary>JS-driven dismissal (Escape or outside pointerdown from overlay.js).</summary>
    private Task SetOpenFromJsAsync(bool open)
    {
        _showDropdown = open;
        return Task.CompletedTask;
    }

    private static string? GetMentionQuery(string text)
    {
        if (string.IsNullOrEmpty(text)) return null;

        var lastAt = text.LastIndexOf('@');
        if (lastAt < 0) return null;

        // Must be preceded by whitespace or start of string
        if (lastAt > 0 && !char.IsWhiteSpace(text[lastAt - 1])) return null;

        var afterAt = text.Substring(lastAt + 1);
        if (afterAt.Contains(' ') || afterAt.Contains('\n') || afterAt.Contains('\r')) return null;
        if (afterAt.Length == 0) return string.Empty;

        if (!System.Text.RegularExpressions.Regex.IsMatch(afterAt, @"^[a-zA-Z0-9_-]+$"))
            return null;

        return afterAt;
    }
}
