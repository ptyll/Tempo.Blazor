@namespace Tempo.Blazor.Components.Spreadsheet
@using Tempo.Blazor.Components.Spreadsheet.Data

@* Data Validation on the one core dialog frame (G6). TmModal owns the overlay, the dialog role, the
   focus trap, Escape, the focus restore and the mobile sheet; the package owns the tabbed form.
   The TITLE key has no trailing ellipsis — the "…" spelling belongs to the toolbar command.
   Content follows the reference: a label | field form once the body is at least 640px wide, stacked
   fields on a phone, and the core Tm inputs instead of raw selects/inputs. *@
<TmModal Show="true"
         Title="@Loc["TmSpreadsheet_Validation_Title"]"
         Size="ModalSize.Medium"
         LayoutMode="@LayoutMode"
         MobilePresentation="MobilePresentation.Auto"
         FooterLayout="FooterLayout.Inline"
         CloseOnEscape="true"
         CloseOnOverlayClick="true"
         RestoreFocusTargetId="@RestoreFocusTargetId"
         Class="tm-dvd"
         OnClose="OnCancel">
    <ChildContent>
        <!-- Tab bar -->
        <div class="tm-dvd__tabs" role="tablist">
            <button class="tm-dvd__tab @(_activeTab == "Settings" ? "tm-dvd__tab--active" : "")"
                    role="tab"
                    aria-selected="@(_activeTab == "Settings")"
                    @onclick='() => _activeTab = "Settings"'>
                @Loc["TmSpreadsheet_Validation_TabSettings"]
            </button>
            <button class="tm-dvd__tab @(_activeTab == "InputMessage" ? "tm-dvd__tab--active" : "")"
                    role="tab"
                    aria-selected="@(_activeTab == "InputMessage")"
                    @onclick='() => _activeTab = "InputMessage"'>
                @Loc["TmSpreadsheet_Validation_TabInputMessage"]
            </button>
            <button class="tm-dvd__tab @(_activeTab == "ErrorAlert" ? "tm-dvd__tab--active" : "")"
                    role="tab"
                    aria-selected="@(_activeTab == "ErrorAlert")"
                    @onclick='() => _activeTab = "ErrorAlert"'>
                @Loc["TmSpreadsheet_Validation_TabErrorAlert"]
            </button>
        </div>

        <div class="tm-dvd__form">
            @if (_activeTab == "Settings")
            {
                <div class="tm-dvd__field">
                    <label class="tm-dvd__label" for="@TypeSelectDomId">@Loc["TmSpreadsheet_Validation_AllowLabel"]</label>
                    <TmSelect TValue="SpreadsheetValidationType"
                              Id="@TypeSelectDomId"
                              Class="tm-dvd__select"
                              Value="_validationType"
                              ValueChanged="OnTypeChanged"
                              Options="TypeOptions" />
                </div>

                @if (_validationType != SpreadsheetValidationType.Any && _validationType != SpreadsheetValidationType.List && _validationType != SpreadsheetValidationType.Custom)
                {
                    <div class="tm-dvd__field">
                        <label class="tm-dvd__label" for="@OperatorSelectDomId">@Loc["TmSpreadsheet_Validation_DataLabel"]</label>
                        <TmSelect TValue="SpreadsheetValidationOperator"
                                  Id="@OperatorSelectDomId"
                                  Class="tm-dvd__select"
                                  Value="_operator"
                                  ValueChanged="OnOperatorChanged"
                                  Options="OperatorOptions" />
                    </div>
                }

                @if (_validationType != SpreadsheetValidationType.Any)
                {
                    <div class="tm-dvd__field">
                        <label class="tm-dvd__label" for="@Formula1DomId">
                            @(_validationType == SpreadsheetValidationType.List
                                ? Loc["TmSpreadsheet_Validation_SourceLabel"]
                                : (_operator == SpreadsheetValidationOperator.Between || _operator == SpreadsheetValidationOperator.NotBetween
                                    ? Loc["TmSpreadsheet_Validation_MinimumLabel"]
                                    : Loc["TmSpreadsheet_Validation_ValueLabel"]))
                        </label>
                        <TmTextInput Id="@Formula1DomId"
                                     Class="tm-dvd__input"
                                     Value="@_formula1"
                                     ValueChanged="value => _formula1 = value" />
                    </div>

                    @if (_operator == SpreadsheetValidationOperator.Between || _operator == SpreadsheetValidationOperator.NotBetween)
                    {
                        <div class="tm-dvd__field">
                            <label class="tm-dvd__label" for="@Formula2DomId">@Loc["TmSpreadsheet_Validation_MaximumLabel"]</label>
                            <TmTextInput Id="@Formula2DomId"
                                         Class="tm-dvd__input"
                                         Value="@_formula2"
                                         ValueChanged="value => _formula2 = value" />
                        </div>
                    }
                }

                <div class="tm-dvd__checks">
                    <TmCheckbox Class="tm-dvd__checkbox"
                                Label="@Loc["TmSpreadsheet_Validation_AllowBlank"]"
                                Value="@_allowBlank"
                                ValueChanged="value => _allowBlank = value" />

                    @if (_validationType == SpreadsheetValidationType.List)
                    {
                        <TmCheckbox Class="tm-dvd__checkbox"
                                    Label="@Loc["TmSpreadsheet_Validation_ShowDropDown"]"
                                    Value="@_showDropDown"
                                    ValueChanged="value => _showDropDown = value" />
                    }
                </div>
            }
            else if (_activeTab == "InputMessage")
            {
                <div class="tm-dvd__checks">
                    <TmCheckbox Class="tm-dvd__checkbox"
                                Label="@Loc["TmSpreadsheet_Validation_ShowInputMessage"]"
                                Value="@_showInputMessage"
                                ValueChanged="value => _showInputMessage = value" />
                </div>
                <div class="tm-dvd__field">
                    <label class="tm-dvd__label" for="@InputTitleDomId">@Loc["TmSpreadsheet_Validation_TitleLabel"]</label>
                    <TmTextInput Id="@InputTitleDomId"
                                 Class="tm-dvd__input"
                                 Value="@_inputTitle"
                                 ValueChanged="value => _inputTitle = value" />
                </div>
                <div class="tm-dvd__field tm-dvd__field--multiline">
                    <label class="tm-dvd__label" for="@InputMessageDomId">@Loc["TmSpreadsheet_Validation_MessageLabel"]</label>
                    <textarea class="tm-dvd__textarea" id="@InputMessageDomId" @bind="_inputMessage" rows="4"></textarea>
                </div>
            }
            else if (_activeTab == "ErrorAlert")
            {
                <div class="tm-dvd__checks">
                    <TmCheckbox Class="tm-dvd__checkbox"
                                Label="@Loc["TmSpreadsheet_Validation_ShowErrorAlert"]"
                                Value="@_showErrorAlert"
                                ValueChanged="value => _showErrorAlert = value" />
                </div>
                <div class="tm-dvd__field">
                    <label class="tm-dvd__label" for="@ErrorStyleDomId">@Loc["TmSpreadsheet_Validation_StyleLabel"]</label>
                    <TmSelect TValue="SpreadsheetValidationErrorStyle"
                              Id="@ErrorStyleDomId"
                              Class="tm-dvd__select"
                              Value="_errorStyle"
                              ValueChanged="OnErrorStyleChanged"
                              Options="ErrorStyleOptions" />
                </div>
                <div class="tm-dvd__field">
                    <label class="tm-dvd__label" for="@ErrorTitleDomId">@Loc["TmSpreadsheet_Validation_TitleLabel"]</label>
                    <TmTextInput Id="@ErrorTitleDomId"
                                 Class="tm-dvd__input"
                                 Value="@_errorTitle"
                                 ValueChanged="value => _errorTitle = value" />
                </div>
                <div class="tm-dvd__field tm-dvd__field--multiline">
                    <label class="tm-dvd__label" for="@ErrorMessageDomId">@Loc["TmSpreadsheet_Validation_MessageLabel"]</label>
                    <textarea class="tm-dvd__textarea" id="@ErrorMessageDomId" @bind="_errorMessage" rows="4"></textarea>
                </div>
            }
        </div>
    </ChildContent>
    <Footer>
        <div class="tm-dvd__actions">
            <TmButton Variant="ButtonVariant.Ghost" OnClick="OnCancel">@Loc["Tm_Cancel"]</TmButton>
            <TmButton OnClick="OnApply">@Loc["Tm_Apply"]</TmButton>
        </div>
    </Footer>
</TmModal>
