@namespace Tempo.Blazor.Components.Spreadsheet.Dialogs
@using Tempo.Blazor.Components.Spreadsheet.Data

@* Paste Special on the one core dialog frame (G6). The content and the arithmetic operation are two
   radio columns (the reference stacks them; two columns keep the dialog short while making every
   choice a single tap target), the toggles sit underneath. *@
<TmModal Show="true"
         Title="@Loc["TmSpreadsheet_PasteSpecial_Title"]"
         Size="ModalSize.Medium"
         LayoutMode="@LayoutMode"
         MobilePresentation="MobilePresentation.Auto"
         FooterLayout="FooterLayout.Inline"
         CloseOnEscape="true"
         CloseOnOverlayClick="true"
         InitialFocusSelector="input[name='ps-content']:checked"
         RestoreFocusTargetId="@RestoreFocusTargetId"
         Class="tm-spreadsheet-pastespecial"
         OnClose="Close">
    <ChildContent>
        <div class="tm-spreadsheet-pastespecial__grid">
            <div class="tm-spreadsheet-pastespecial__group">
                <TmRadioGroup T="SpreadsheetPasteContent"
                              Name="ps-content"
                              Label="@Loc["TmSpreadsheet_PasteSpecial_Paste"]"
                              Layout="RadioLayout.Vertical"
                              Value="_content"
                              ValueChanged="OnContentChanged"
                              Options="@ContentOptions" />
            </div>
            <div class="tm-spreadsheet-pastespecial__group">
                <TmRadioGroup T="SpreadsheetPasteOperation"
                              Name="ps-operation"
                              Label="@Loc["TmSpreadsheet_PasteSpecial_Operation"]"
                              Layout="RadioLayout.Vertical"
                              Value="_operation"
                              ValueChanged="OnOperationChanged"
                              Options="@OperationOptions" />
            </div>
        </div>

        <div class="tm-spreadsheet-pastespecial__toggles">
            <TmCheckbox Class="tm-spreadsheet-pastespecial__toggle"
                        Label="@Loc["TmSpreadsheet_PasteSpecial_SkipBlanks"]"
                        Value="@_skipBlanks"
                        ValueChanged="value => _skipBlanks = value" />
            <TmCheckbox Class="tm-spreadsheet-pastespecial__toggle"
                        Label="@Loc["TmSpreadsheet_PasteSpecial_Transpose"]"
                        Value="@_transpose"
                        ValueChanged="value => _transpose = value" />
        </div>
    </ChildContent>
    <Footer>
        <div class="tm-spreadsheet-pastespecial__actions">
            <TmButton Variant="ButtonVariant.Ghost" OnClick="Close" Class="tm-spreadsheet-pastespecial__btn tm-spreadsheet-pastespecial__btn--cancel">@Loc["TmSpreadsheet_PasteSpecial_Cancel"]</TmButton>
            <TmButton OnClick="Apply" Class="tm-spreadsheet-pastespecial__btn tm-spreadsheet-pastespecial__btn--ok">@Loc["TmSpreadsheet_PasteSpecial_Ok"]</TmButton>
        </div>
    </Footer>
</TmModal>
