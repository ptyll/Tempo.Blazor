@namespace Tempo.Blazor.Components.Spreadsheet.Dialogs
@using Tempo.Blazor.Components.Spreadsheet.Models

@* Named Range Edit on the one core dialog frame (G6). TmModal owns the overlay, the dialog role, the
   initial focus on the name field, Escape and the focus restore (to the grid, or to the Name Manager
   the editor was opened from); the form and its Ctrl+Enter shortcut stay the package's. *@
<TmModal Show="true"
         Title="@(_isNew ? Loc["TmSpreadsheet_NamesEdit_TitleNew"] : Loc["TmSpreadsheet_NamesEdit_Title"])"
         Size="ModalSize.Medium"
         LayoutMode="@LayoutMode"
         MobilePresentation="MobilePresentation.Auto"
         FooterLayout="FooterLayout.Inline"
         CloseOnEscape="true"
         CloseOnOverlayClick="true"
         InitialFocusTargetId="@NameInputDomId"
         RestoreFocusTargetId="@RestoreFocusTargetId"
         Class="tm-spreadsheet-named-range-edit"
         OnClose="OnCancelClick">
    <ChildContent>
        @* Ctrl+Enter applies from any field. The footer buttons are the modal's own and sit outside
           this wrapper, so their keydown never reaches the shortcut. *@
        <div class="tm-spreadsheet-named-range-edit__body" @onkeydown="OnKeyDown">
            <div class="tm-spreadsheet-named-range-edit__field">
                <label for="@NameInputDomId">@Loc["TmSpreadsheet_NamesEdit_Name"]</label>
                <input id="@NameInputDomId"
                       type="text"
                       @ref="_nameInputRef"
                       @bind="_name"
                       @bind:event="oninput"
                       class="tm-spreadsheet-named-range-edit__input"
                       aria-invalid="@(HasNameError ? "true" : null)"
                       aria-describedby="@(HasNameError ? NameErrorDomId : null)" />
                @if (_errors.Contains("name"))
                {
                    <span class="tm-spreadsheet-named-range-edit__error" id="@NameErrorDomId" role="alert">@Loc["TmSpreadsheet_NamesEdit_NameRequired"]</span>
                }
                else if (_errors.Contains("invalid"))
                {
                    <span class="tm-spreadsheet-named-range-edit__error" id="@NameErrorDomId" role="alert">@Loc["TmSpreadsheet_NamesEdit_InvalidName"]</span>
                }
            </div>

            <div class="tm-spreadsheet-named-range-edit__field">
                <label for="@RefersToInputDomId">@Loc["TmSpreadsheet_NamesEdit_RefersTo"]</label>
                <input id="@RefersToInputDomId"
                       type="text"
                       @ref="_refersToInputRef"
                       @bind="_refersTo"
                       @bind:event="oninput"
                       class="tm-spreadsheet-named-range-edit__input"
                       aria-invalid="@(_errors.Contains("refersTo") ? "true" : null)"
                       aria-describedby="@(_errors.Contains("refersTo") ? RefersToErrorDomId : null)" />
                @if (_errors.Contains("refersTo"))
                {
                    <span class="tm-spreadsheet-named-range-edit__error" id="@RefersToErrorDomId" role="alert">@Loc["TmSpreadsheet_NamesEdit_RefersToRequired"]</span>
                }
            </div>

            <div class="tm-spreadsheet-named-range-edit__field">
                <label for="@ScopeSelectDomId">@Loc["TmSpreadsheet_NamesEdit_Scope"]</label>
                <select id="@ScopeSelectDomId" @bind="_scope" class="tm-spreadsheet-named-range-edit__select">
                    <option value="@NamedRangeScope.Workbook">@Loc["TmSpreadsheet_NamesEdit_ScopeWorkbook"]</option>
                    <option value="@NamedRangeScope.Sheet">@Loc["TmSpreadsheet_NamesEdit_ScopeSheet"]</option>
                </select>
            </div>

            @if (_scope == NamedRangeScope.Sheet)
            {
                <div class="tm-spreadsheet-named-range-edit__field">
                    <label for="@SheetSelectDomId">@Loc["TmSpreadsheet_NamesEdit_Sheet"]</label>
                    <select id="@SheetSelectDomId" @bind="_sheetIndex" class="tm-spreadsheet-named-range-edit__select">
                        @for (var i = 0; i < Workbook.Sheets.Count; i++)
                        {
                            <option value="@i">@Workbook.Sheets[i].Name</option>
                        }
                    </select>
                </div>
            }

            <div class="tm-spreadsheet-named-range-edit__field">
                <label for="@CommentInputDomId">@Loc["TmSpreadsheet_NamesEdit_Comment"]</label>
                <input id="@CommentInputDomId" type="text" @bind="_comment" class="tm-spreadsheet-named-range-edit__input" />
            </div>
        </div>
    </ChildContent>
    <Footer>
        <div class="tm-spreadsheet-named-range-edit__actions">
            <TmButton Variant="ButtonVariant.Ghost" OnClick="OnCancelClick" Class="tm-spreadsheet-named-range-edit__btn tm-spreadsheet-named-range-edit__btn--cancel">@Loc["TmSpreadsheet_NamesEdit_Cancel"]</TmButton>
            <TmButton OnClick="OnSaveClick" Class="tm-spreadsheet-named-range-edit__btn tm-spreadsheet-named-range-edit__btn--ok">@Loc["TmSpreadsheet_NamesEdit_Save"]</TmButton>
        </div>
    </Footer>
</TmModal>
