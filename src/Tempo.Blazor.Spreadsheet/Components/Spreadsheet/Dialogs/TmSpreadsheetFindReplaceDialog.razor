@namespace Tempo.Blazor.Components.Spreadsheet.Dialogs
@using Tempo.Blazor.Components.Spreadsheet.Enums

<div class="tm-spreadsheet-find" role="dialog" aria-label="@Loc["TmSpreadsheet_Find_Title"]" @onkeydown="OnRootKeyDown">
    <div class="tm-spreadsheet-find__header">
        <span class="tm-spreadsheet-find__title">@Loc["TmSpreadsheet_Find_Title"]</span>
        <button type="button"
                class="tm-spreadsheet-find__close"
                title="@Loc["Tm_Close"]"
                aria-label="@Loc["Tm_Close"]"
                @onclick="Close">
            <TmIcon Name="close" />
        </button>
    </div>

    <div class="tm-spreadsheet-find__row">
        <input class="tm-spreadsheet-find__input tm-spreadsheet-find__query"
               placeholder="@Loc["TmSpreadsheet_Find_Query"]"
               aria-label="@Loc["TmSpreadsheet_Find_Query"]"
               value="@_query"
               @ref="_queryInput"
               @oninput="OnQueryInput"
               @onkeydown="OnFieldKeyDown" />
        <span class="tm-spreadsheet-find__counter">@CounterText</span>
    </div>

    <div class="tm-spreadsheet-find__row">
        <input class="tm-spreadsheet-find__input tm-spreadsheet-find__replace"
               placeholder="@Loc["TmSpreadsheet_Find_ReplaceWith"]"
               aria-label="@Loc["TmSpreadsheet_Find_ReplaceWith"]"
               value="@_replacement"
               @oninput="OnReplacementInput"
               @onkeydown="OnFieldKeyDown" />
    </div>

    <div class="tm-spreadsheet-find__options">
        <label class="tm-spreadsheet-find__option">
            <input type="checkbox" checked="@_options.MatchCase" @onchange="OnMatchCaseToggle" />
            <span>@Loc["TmSpreadsheet_Find_MatchCase"]</span>
        </label>
        <label class="tm-spreadsheet-find__option">
            <input type="checkbox" checked="@_options.WholeCell" @onchange="OnWholeCellToggle" />
            <span>@Loc["TmSpreadsheet_Find_WholeCell"]</span>
        </label>
        <label class="tm-spreadsheet-find__option">
            <input type="checkbox" checked="@(_options.SearchIn == SpreadsheetSearchIn.Formulas)" @onchange="OnInFormulasToggle" />
            <span>@Loc["TmSpreadsheet_Find_InFormulas"]</span>
        </label>
        <label class="tm-spreadsheet-find__option">
            <input type="checkbox" checked="@(_options.Scope == SpreadsheetSearchScope.Workbook)" @onchange="OnWorkbookScopeToggle" />
            <span>@Loc["TmSpreadsheet_Find_WorkbookScope"]</span>
        </label>
    </div>

    <div class="tm-spreadsheet-find__actions">
        <button type="button" class="tm-spreadsheet-find__btn" title="@Loc["TmSpreadsheet_Find_FindPrevious"]" @onclick="FindPrevious">
            <TmIcon Name="chevron-up" />
        </button>
        <button type="button" class="tm-spreadsheet-find__btn" title="@Loc["TmSpreadsheet_Find_FindNext"]" @onclick="FindNext">
            <TmIcon Name="chevron-down" />
        </button>
        <span class="tm-spreadsheet-find__spacer"></span>
        <button type="button" class="tm-spreadsheet-find__btn tm-spreadsheet-find__btn--text" @onclick="Replace">@Loc["TmSpreadsheet_Find_Replace"]</button>
        <button type="button" class="tm-spreadsheet-find__btn tm-spreadsheet-find__btn--text" @onclick="ReplaceAll">@Loc["TmSpreadsheet_Find_ReplaceAll"]</button>
    </div>
</div>
