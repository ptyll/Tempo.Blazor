@namespace Tempo.Blazor.Components.Spreadsheet.Dialogs
@using Tempo.Blazor.Components.Spreadsheet.Enums

@* Find & Replace stays NON-MODAL (Q5): a floating panel on the desktop layout, a non-modal bottom
   sheet on the mobile layout (TmDrawer Modal=false), so the grid behind it keeps working and the
   highlighted matches stay visible. The panel's own keys (Ctrl+F / Ctrl+H, Enter / Shift+Enter /
   Escape) are unchanged. *@
@* The presentation is the VIEWPORT's, never a measurement of this panel's own root: the panel is
   position-absolute on the desktop layout (so its root has no size) and any measurement of it would
   flip the layout on every render. A forced LayoutMode pins the mode; Auto reads the app-level
   viewport scope and keeps the floating panel when the host has none. *@
    @if (Mobile)
    {
        @* The sheet owns the presentation (grabber, viewport anchoring, Escape); the panel is its
           content, so a swipe or an Escape closes the same surface the desktop panel is. *@
        @* CloseOnEscape is FALSE on purpose: the panel's own root handler is the single Escape path
           (it works wherever the focus is inside the panel). With the drawer's own listener on top,
           one Escape raised OnClose twice. *@
        <TmDrawer IsOpen="true"
                  Modal="false"
                  Position="DrawerPosition.Bottom"
                  ShowOverlay="false"
                  ShowHandle="true"
                  ShowCloseButton="false"
                  CloseOnEscape="false"
                  LayoutMode="TmLayoutMode.Mobile"
                  AriaLabel="@Loc["TmSpreadsheet_Find_Title"]"
                  Class="tm-spreadsheet-find-host"
                  IsOpenChanged="OnSheetOpenChanged">
            <ChildContent>
                @PanelContent
            </ChildContent>
        </TmDrawer>
    }
    else
    {
        @PanelContent
    }

@code {
    /// <summary>
    /// The panel itself — one markup for both presentations, so the fields, the counter and the
    /// keyboard contract cannot drift between the floating panel and the mobile sheet.
    /// </summary>
    private RenderFragment PanelContent => __builder =>
    {
            <div class="tm-spreadsheet-find" role="@(Mobile ? null : "dialog")" aria-label="@(Mobile ? null : Loc["TmSpreadsheet_Find_Title"])" @onkeydown="OnRootKeyDown">
                <div class="tm-spreadsheet-find__header">
                    <span class="tm-spreadsheet-find__title">@Loc["TmSpreadsheet_Find_Title"]</span>
                    <button type="button"
                            class="tm-spreadsheet-find__close"
                            title="@Loc["Tm_Close"]"
                            aria-label="@Loc["Tm_Close"]"
                            @onclick="Close">
                        <TmIcon Name="close" />
                    </button>
                </div>

                <div class="tm-spreadsheet-find__row">
                    <input class="tm-spreadsheet-find__input tm-spreadsheet-find__query"
                           placeholder="@Loc["TmSpreadsheet_Find_Query"]"
                           aria-label="@Loc["TmSpreadsheet_Find_Query"]"
                           value="@_query"
                           @ref="_queryInput"
                           @oninput="OnQueryInput"
                           @onkeydown="OnFieldKeyDown" />
                    <span class="tm-spreadsheet-find__counter" role="status" aria-live="polite">@CounterText</span>
                </div>

                <div class="tm-spreadsheet-find__row">
                    <input class="tm-spreadsheet-find__input tm-spreadsheet-find__replace"
                           placeholder="@Loc["TmSpreadsheet_Find_ReplaceWith"]"
                           aria-label="@Loc["TmSpreadsheet_Find_ReplaceWith"]"
                           value="@_replacement"
                           @oninput="OnReplacementInput"
                           @onkeydown="OnFieldKeyDown" />
                </div>

                <div class="tm-spreadsheet-find__options">
                    <label class="tm-spreadsheet-find__option">
                        <input type="checkbox" checked="@_options.MatchCase" @onchange="OnMatchCaseToggle" />
                        <span>@Loc["TmSpreadsheet_Find_MatchCase"]</span>
                    </label>
                    <label class="tm-spreadsheet-find__option">
                        <input type="checkbox" checked="@_options.WholeCell" @onchange="OnWholeCellToggle" />
                        <span>@Loc["TmSpreadsheet_Find_WholeCell"]</span>
                    </label>
                    <label class="tm-spreadsheet-find__option">
                        <input type="checkbox" checked="@(_options.SearchIn == SpreadsheetSearchIn.Formulas)" @onchange="OnInFormulasToggle" />
                        <span>@Loc["TmSpreadsheet_Find_InFormulas"]</span>
                    </label>
                    <label class="tm-spreadsheet-find__option">
                        <input type="checkbox" checked="@(_options.Scope == SpreadsheetSearchScope.Workbook)" @onchange="OnWorkbookScopeToggle" />
                        <span>@Loc["TmSpreadsheet_Find_WorkbookScope"]</span>
                    </label>
                </div>

                <div class="tm-spreadsheet-find__actions">
                    <button type="button" class="tm-spreadsheet-find__btn" title="@Loc["TmSpreadsheet_Find_FindPrevious"]" aria-label="@Loc["TmSpreadsheet_Find_FindPrevious"]" @onclick="FindPrevious">
                        <TmIcon Name="chevron-up" />
                    </button>
                    <button type="button" class="tm-spreadsheet-find__btn" title="@Loc["TmSpreadsheet_Find_FindNext"]" aria-label="@Loc["TmSpreadsheet_Find_FindNext"]" @onclick="FindNext">
                        <TmIcon Name="chevron-down" />
                    </button>
                    <span class="tm-spreadsheet-find__spacer"></span>
                    <button type="button" class="tm-spreadsheet-find__btn tm-spreadsheet-find__btn--text" @onclick="Replace">@Loc["TmSpreadsheet_Find_Replace"]</button>
                    <button type="button" class="tm-spreadsheet-find__btn tm-spreadsheet-find__btn--text" @onclick="ReplaceAll">@Loc["TmSpreadsheet_Find_ReplaceAll"]</button>
                </div>
            </div>
    };
}
