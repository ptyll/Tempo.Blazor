@namespace Tempo.Blazor.Components.Spreadsheet.Dialogs
@using Tempo.Blazor.Components.Spreadsheet.Enums

@* Find & Replace stays NON-MODAL (Q5): a floating panel on the desktop layout, a non-modal bottom
   sheet on the mobile layout (TmDrawer Modal=false), so the grid behind it keeps working and the
   highlighted matches stay visible. The panel's own keys (Ctrl+F / Ctrl+H, Enter / Shift+Enter /
   Escape) are unchanged. *@
@* The presentation is the VIEWPORT's, never a measurement of this panel's own root: the panel is
   position-absolute on the desktop layout (so its root has no size) and any measurement of it would
   flip the layout on every render. A forced LayoutMode pins the mode; Auto reads the app-level
   viewport scope and keeps the floating panel when the host has none. *@
    @if (Mobile)
    {
        @* The sheet owns the presentation (grabber, viewport anchoring, Escape); the panel is its
           content, so a swipe or an Escape closes the same surface the desktop panel is. *@
        @* CloseOnEscape is FALSE on purpose: the panel's own root handler is the single Escape path
           (it works wherever the focus is inside the panel). With the drawer's own listener on top,
           one Escape raised OnClose twice. *@
        <TmDrawer IsOpen="true"
                  Modal="false"
                  Position="DrawerPosition.Bottom"
                  ShowOverlay="false"
                  ShowHandle="true"
                  ShowCloseButton="false"
                  CloseOnEscape="false"
                  LayoutMode="TmLayoutMode.Mobile"
                  AriaLabel="@Loc["TmSpreadsheet_Find_Title"]"
                  Class="tm-spreadsheet-find-host"
                  IsOpenChanged="OnSheetOpenChanged">
            <ChildContent>
                @PanelContent
            </ChildContent>
        </TmDrawer>
    }
    else
    {
        @PanelContent
    }

@code {
    /// <summary>
    /// The panel itself — one markup for both presentations, so the fields, the counter and the
    /// keyboard contract cannot drift between the floating panel and the mobile sheet. The layout is
    /// the reference's: a labelled Find row with the match counter, a labelled Replace row, the four
    /// options in two columns and an action row whose primary action is Replace all.
    /// </summary>
    private RenderFragment PanelContent => __builder =>
    {
            <div class="tm-spreadsheet-find @(Mobile ? "tm-spreadsheet-find--sheet" : "tm-spreadsheet-find--floating")"
                 role="@(Mobile ? null : "dialog")"
                 aria-label="@(Mobile ? null : Loc["TmSpreadsheet_Find_Title"])"
                 @onkeydown="OnRootKeyDown">
                <div class="tm-spreadsheet-find__header">
                    <span class="tm-spreadsheet-find__title">@Loc["TmSpreadsheet_Find_Title"]</span>
                    <button type="button"
                            class="tm-spreadsheet-find__close"
                            title="@Loc["Tm_Close"]"
                            aria-label="@Loc["Tm_Close"]"
                            @onclick="Close">
                        <TmIcon Name="close" />
                    </button>
                </div>

                <div class="tm-spreadsheet-find__fields">
                    <div class="tm-spreadsheet-find__field">
                        <label class="tm-spreadsheet-find__label" for="@QueryDomId">@Loc["TmSpreadsheet_Find_Query"]</label>
                        <div class="tm-spreadsheet-find__control">
                            <TmTextInput @ref="_queryInput"
                                         Id="@QueryDomId"
                                         Class="tm-spreadsheet-find__input tm-spreadsheet-find__query"
                                         Value="@_query"
                                         ValueChanged="OnQueryChanged"
                                         OnKeyDown="OnFieldKeyDown"
                                         Placeholder="@Loc["TmSpreadsheet_Find_Query"]" />
                        </div>
                        <span class="tm-spreadsheet-find__counter" role="status" aria-live="polite">@CounterText</span>
                    </div>

                    <div class="tm-spreadsheet-find__field">
                        <label class="tm-spreadsheet-find__label" for="@ReplaceDomId">@Loc["TmSpreadsheet_Find_ReplaceWith"]</label>
                        <div class="tm-spreadsheet-find__control">
                            <TmTextInput Id="@ReplaceDomId"
                                         Class="tm-spreadsheet-find__input tm-spreadsheet-find__replace"
                                         Value="@_replacement"
                                         ValueChanged="OnReplacementChanged"
                                         OnKeyDown="OnFieldKeyDown"
                                         Placeholder="@Loc["TmSpreadsheet_Find_ReplaceWith"]" />
                        </div>
                    </div>
                </div>

                <div class="tm-spreadsheet-find__options">
                    <TmCheckbox Class="tm-spreadsheet-find__option"
                                Label="@Loc["TmSpreadsheet_Find_MatchCase"]"
                                Value="@_options.MatchCase"
                                ValueChanged="OnMatchCaseToggle" />
                    <TmCheckbox Class="tm-spreadsheet-find__option"
                                Label="@Loc["TmSpreadsheet_Find_InFormulas"]"
                                Value="@(_options.SearchIn == SpreadsheetSearchIn.Formulas)"
                                ValueChanged="OnInFormulasToggle" />
                    <TmCheckbox Class="tm-spreadsheet-find__option"
                                Label="@Loc["TmSpreadsheet_Find_WholeCell"]"
                                Value="@_options.WholeCell"
                                ValueChanged="OnWholeCellToggle" />
                    <TmCheckbox Class="tm-spreadsheet-find__option"
                                Label="@Loc["TmSpreadsheet_Find_WorkbookScope"]"
                                Value="@(_options.Scope == SpreadsheetSearchScope.Workbook)"
                                ValueChanged="OnWorkbookScopeToggle" />
                </div>

                <div class="tm-spreadsheet-find__actions">
                    <TmButton Variant="ButtonVariant.Outline"
                              Class="tm-spreadsheet-find__btn tm-spreadsheet-find__btn--nav"
                              Icon="chevron-up"
                              OnClick="FindPrevious">
                        @Loc["TmSpreadsheet_Find_FindPrevious"]
                    </TmButton>
                    <TmButton Variant="ButtonVariant.Outline"
                              Class="tm-spreadsheet-find__btn tm-spreadsheet-find__btn--nav"
                              Icon="chevron-down"
                              OnClick="FindNext">
                        @Loc["TmSpreadsheet_Find_FindNext"]
                    </TmButton>
                    <span class="tm-spreadsheet-find__spacer"></span>
                    <TmButton Variant="ButtonVariant.Outline"
                              Class="tm-spreadsheet-find__btn tm-spreadsheet-find__btn--text"
                              OnClick="Replace">
                        @Loc["TmSpreadsheet_Find_Replace"]
                    </TmButton>
                    <TmButton Class="tm-spreadsheet-find__btn tm-spreadsheet-find__btn--text tm-spreadsheet-find__btn--primary"
                              OnClick="ReplaceAll">
                        @Loc["TmSpreadsheet_Find_ReplaceAll"]
                    </TmButton>
                    @if (!Mobile)
                    {
                        <TmButton Variant="ButtonVariant.Outline"
                                  Class="tm-spreadsheet-find__btn tm-spreadsheet-find__btn--close"
                                  OnClick="Close">
                            @Loc["Tm_Close"]
                        </TmButton>
                    }
                </div>
            </div>
    };
}
