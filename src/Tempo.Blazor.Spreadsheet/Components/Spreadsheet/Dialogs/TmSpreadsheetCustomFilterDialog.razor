@namespace Tempo.Blazor.Components.Spreadsheet.Dialogs
@using Tempo.Blazor.Components.Spreadsheet.Data

@* Custom filter on the one core dialog frame (G6). TmModal owns the overlay, the dialog role, the
   focus trap, Escape and the mobile sheet; the package contributes the criteria form. The A/Nebo
   choice is the core segmented radio group (convention P17), the operands ask for the keyboard their
   column kind needs. *@
<TmModal Show="true"
         Title="@Loc["TmSpreadsheet_CustomFilter_Title"]"
         Size="ModalSize.Medium"
         LayoutMode="@LayoutMode"
         MobilePresentation="MobilePresentation.Auto"
         FooterLayout="FooterLayout.Inline"
         CloseOnEscape="true"
         CloseOnOverlayClick="true"
         InitialFocusTargetId="@FirstOperatorDomId"
         RestoreFocusTargetId="@RestoreFocusTargetId"
         Class="tm-spreadsheet-custom-filter"
         OnClose="Close">
    <ChildContent>
        <div class="tm-spreadsheet-custom-filter__form">
            <div class="tm-spreadsheet-custom-filter__row">
                <TmSelect TValue="SpreadsheetFilterOperator"
                          Id="@FirstOperatorDomId"
                          Class="tm-spreadsheet-custom-filter__op"
                          AriaLabel="@Loc["TmSpreadsheet_CustomFilter_FirstOperator"]"
                          Value="_op1"
                          ValueChanged="OnFirstOperatorChanged"
                          Options="OperatorOptions" />
                @if (NeedsValue(_op1))
                {
                    <TmTextInput Class="tm-spreadsheet-custom-filter__value"
                                 Placeholder="@Loc["TmSpreadsheet_CustomFilter_Value"]"
                                 aria-label="@Loc["TmSpreadsheet_CustomFilter_FirstValue"]"
                                 Value="@(_value1a ?? string.Empty)"
                                 ValueChanged="value => _value1a = value"
                                 inputmode="@ValueInputMode" />
                }
                @if (NeedsSecondValue(_op1))
                {
                    <TmTextInput Class="tm-spreadsheet-custom-filter__value"
                                 Placeholder="@Loc["TmSpreadsheet_CustomFilter_Value"]"
                                 aria-label="@Loc["TmSpreadsheet_CustomFilter_FirstValueTo"]"
                                 Value="@(_value1b ?? string.Empty)"
                                 ValueChanged="value => _value1b = value"
                                 inputmode="@ValueInputMode" />
                }
            </div>

            <div class="tm-spreadsheet-custom-filter__join">
                <TmRadioGroup T="SpreadsheetFilterJoin"
                              Name="custom-filter-join"
                              Appearance="RadioAppearance.Segmented"
                              Layout="RadioLayout.Horizontal"
                              Value="_join"
                              ValueChanged="OnJoinChanged"
                              Options="JoinOptions" />
            </div>

            <div class="tm-spreadsheet-custom-filter__row">
                <TmSelect TValue="SpreadsheetFilterOperator?"
                          Class="tm-spreadsheet-custom-filter__op"
                          AriaLabel="@Loc["TmSpreadsheet_CustomFilter_SecondOperator"]"
                          Value="_op2"
                          ValueChanged="OnSecondOperatorChanged"
                          Options="SecondOperatorOptions" />
                @if (_op2 is not null && NeedsValue(_op2.Value))
                {
                    <TmTextInput Class="tm-spreadsheet-custom-filter__value"
                                 Placeholder="@Loc["TmSpreadsheet_CustomFilter_Value"]"
                                 aria-label="@Loc["TmSpreadsheet_CustomFilter_SecondValue"]"
                                 Value="@(_value2a ?? string.Empty)"
                                 ValueChanged="value => _value2a = value"
                                 inputmode="@ValueInputMode" />
                }
                @if (_op2 is not null && NeedsSecondValue(_op2.Value))
                {
                    <TmTextInput Class="tm-spreadsheet-custom-filter__value"
                                 Placeholder="@Loc["TmSpreadsheet_CustomFilter_Value"]"
                                 aria-label="@Loc["TmSpreadsheet_CustomFilter_SecondValueTo"]"
                                 Value="@(_value2b ?? string.Empty)"
                                 ValueChanged="value => _value2b = value"
                                 inputmode="@ValueInputMode" />
                }
            </div>
        </div>
    </ChildContent>
    <Footer>
        <div class="tm-spreadsheet-custom-filter__actions">
            <TmButton Variant="ButtonVariant.Ghost" OnClick="Close" Class="tm-spreadsheet-custom-filter__btn tm-spreadsheet-custom-filter__btn--cancel">@Loc["Tm_Cancel"]</TmButton>
            <TmButton OnClick="Apply" Class="tm-spreadsheet-custom-filter__btn tm-spreadsheet-custom-filter__btn--ok">@Loc["Tm_Apply"]</TmButton>
        </div>
    </Footer>
</TmModal>
