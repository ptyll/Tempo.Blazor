@namespace Tempo.Blazor.Components.Spreadsheet.Dialogs
@using Tempo.Blazor.Components.Spreadsheet.Models

@* Modal overlay. The dialog contract (role, aria-modal, aria-labelledby, initial focus on the
   address field, document-level Escape, focus restore) is the core TmFocusScope's; this interim
   markup is replaced by the core TmModal in phase 3 of the redesign plan. *@
<div class="tm-spreadsheet-dialog-backdrop tm-spreadsheet-hyperlink__backdrop" @onclick="OnCancelClick">
    <TmFocusScope Active="true"
                  DialogRole="dialog"
                  AriaLabelledBy="@TitleDomId"
                  InitialFocusTargetId="@TargetInputDomId"
                  CloseOnEscape="true"
                  OnEscape="OnEscapeHandler"
                  RestoreFocusTargetId="@RestoreFocusTargetId"
                  Class="tm-spreadsheet-dialog-scope">
    <div class="tm-spreadsheet-dialog tm-spreadsheet-hyperlink"
         @onclick:stopPropagation
         @onkeydown="OnKeyDown"
         @onkeydown:stopPropagation="true">
        <div class="tm-spreadsheet-hyperlink__header">
            <h2 class="tm-spreadsheet-hyperlink__title" id="@TitleDomId">@Loc["TmSpreadsheet_Hyperlink_Title"]</h2>
            @* Native <button>: its keydown must not reach the dialog's
               Ctrl+Enter -> save shortcut on top of the button's own click. *@
            <button type="button" class="tm-spreadsheet-hyperlink__close" title="@Loc["Tm_Close"]" aria-label="@Loc["Tm_Close"]"
                    @onkeydown:stopPropagation="true" @onclick="OnCancelClick">
                <TmIcon Name="close" />
            </button>
        </div>

        <div class="tm-spreadsheet-hyperlink__body">
            <div class="tm-spreadsheet-hyperlink__field">
                <label for="hl-type">@Loc["TmSpreadsheet_Hyperlink_Type"]</label>
                <select id="hl-type" @bind="_kind" class="tm-spreadsheet-hyperlink__select">
                    <option value="@SpreadsheetHyperlinkKind.Web">@Loc["TmSpreadsheet_Hyperlink_TypeWeb"]</option>
                    <option value="@SpreadsheetHyperlinkKind.Email">@Loc["TmSpreadsheet_Hyperlink_TypeEmail"]</option>
                    <option value="@SpreadsheetHyperlinkKind.InternalRef">@Loc["TmSpreadsheet_Hyperlink_TypeInternal"]</option>
                    <option value="@SpreadsheetHyperlinkKind.NamedRange">@Loc["TmSpreadsheet_Hyperlink_TypeNamedRange"]</option>
                </select>
            </div>

            <div class="tm-spreadsheet-hyperlink__field">
                <label for="hl-target">@Loc["TmSpreadsheet_Hyperlink_Target"]</label>
                @if (_kind == SpreadsheetHyperlinkKind.NamedRange)
                {
                    <select id="hl-target" @bind="_target" class="tm-spreadsheet-hyperlink__select">
                        <option value="">@Loc["TmSpreadsheet_Hyperlink_SelectNamedRange"]</option>
                        @foreach (var nr in Workbook.NamedRanges)
                        {
                            <option value="@nr.Name">@nr.Name</option>
                        }
                    </select>
                }
                else
                {
                    <input id="hl-target" type="text" @bind="_target" @bind:event="oninput" class="tm-spreadsheet-hyperlink__input" />
                }
            </div>

            @if (_kind == SpreadsheetHyperlinkKind.Email)
            {
                <div class="tm-spreadsheet-hyperlink__field">
                    <label for="hl-subject">@Loc["TmSpreadsheet_Hyperlink_EmailSubject"]</label>
                    <input id="hl-subject" type="text" @bind="_emailSubject" class="tm-spreadsheet-hyperlink__input" />
                </div>
            }

            <div class="tm-spreadsheet-hyperlink__field">
                <label for="hl-display">@Loc["TmSpreadsheet_Hyperlink_Display"]</label>
                <input id="hl-display" type="text" @bind="_display" class="tm-spreadsheet-hyperlink__input" />
            </div>

            <div class="tm-spreadsheet-hyperlink__field">
                <label for="hl-tooltip">@Loc["TmSpreadsheet_Hyperlink_Tooltip"]</label>
                <input id="hl-tooltip" type="text" @bind="_tooltip" class="tm-spreadsheet-hyperlink__input" />
            </div>
        </div>

        @* Native <button>s: the group bars their keydown so Ctrl+Enter on a button runs only that
           button's own click instead of also firing the dialog's save shortcut. Escape is not
           handled here — the focus scope's document-level listener dismisses the dialog. *@
        <div class="tm-spreadsheet-hyperlink__actions"
             @onkeydown:stopPropagation="true">
            <button type="button" class="tm-spreadsheet-hyperlink__btn tm-spreadsheet-hyperlink__btn--cancel" @onclick="OnCancelClick">@Loc["TmSpreadsheet_Hyperlink_Cancel"]</button>
            <button type="button" class="tm-spreadsheet-hyperlink__btn tm-spreadsheet-hyperlink__btn--ok" @onclick="OnSaveClick">@Loc["TmSpreadsheet_Hyperlink_Save"]</button>
        </div>
    </div>
    </TmFocusScope>
</div>
