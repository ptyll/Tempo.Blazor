@namespace Tempo.Blazor.Components.Spreadsheet.Dialogs
@using Tempo.Blazor.Components.Spreadsheet.Models

@* Hyperlink on the one core dialog frame (G6). TmModal owns the overlay, the dialog role, the initial
   focus on the address field, Escape and the focus restore; the form and its Ctrl+Enter shortcut stay
   the package's. The link type is the core segmented radio group (convention P17, foundation F8), so
   all four kinds are visible at once instead of hidden behind a select. *@
<TmModal Show="true"
         Title="@Loc["TmSpreadsheet_Hyperlink_Title"]"
         Size="ModalSize.Medium"
         LayoutMode="@LayoutMode"
         MobilePresentation="MobilePresentation.Auto"
         FooterLayout="FooterLayout.Inline"
         CloseOnEscape="true"
         CloseOnOverlayClick="true"
         InitialFocusTargetId="@TargetInputDomId"
         RestoreFocusTargetId="@RestoreFocusTargetId"
         Class="tm-spreadsheet-hyperlink"
         OnClose="OnCancelClick">
    <ChildContent>
        @* Ctrl+Enter applies from any field. The footer buttons are the modal's own and sit outside
           this wrapper, so their keydown never reaches the shortcut. *@
        <div class="tm-spreadsheet-hyperlink__body" @onkeydown="OnKeyDown">
            <div class="tm-spreadsheet-hyperlink__field">
                <TmRadioGroup T="SpreadsheetHyperlinkKind"
                              id="@TypeSelectDomId"
                              Class="tm-spreadsheet-hyperlink__kinds"
                              Label="@Loc["TmSpreadsheet_Hyperlink_Type"]"
                              Appearance="RadioAppearance.Segmented"
                              Layout="RadioLayout.Horizontal"
                              Value="_kind"
                              ValueChanged="OnKindChanged"
                              Options="@KindOptions" />
            </div>

            <div class="tm-spreadsheet-hyperlink__field">
                <label class="tm-spreadsheet-hyperlink__label" for="@TargetInputDomId">@Loc["TmSpreadsheet_Hyperlink_Target"]</label>
                @if (_kind == SpreadsheetHyperlinkKind.NamedRange)
                {
                    <TmSelect TValue="string"
                              Id="@TargetInputDomId"
                              Class="tm-spreadsheet-hyperlink__select"
                              Value="@_target"
                              ValueChanged="OnTargetChanged">
                        <option value="">@Loc["TmSpreadsheet_Hyperlink_SelectNamedRange"]</option>
                        @foreach (var nr in Workbook.NamedRanges)
                        {
                            <option value="@nr.Name">@nr.Name</option>
                        }
                    </TmSelect>
                }
                else
                {
                    <TmTextInput Id="@TargetInputDomId"
                                 Class="tm-spreadsheet-hyperlink__input"
                                 Value="@_target"
                                 ValueChanged="OnTargetChanged"
                                 inputmode="@TargetInputMode" />
                }
            </div>

            @if (_kind == SpreadsheetHyperlinkKind.Email)
            {
                <div class="tm-spreadsheet-hyperlink__field">
                    <label class="tm-spreadsheet-hyperlink__label" for="@EmailSubjectDomId">@Loc["TmSpreadsheet_Hyperlink_EmailSubject"]</label>
                    <TmTextInput Id="@EmailSubjectDomId"
                                 Class="tm-spreadsheet-hyperlink__input"
                                 Value="@(_emailSubject ?? string.Empty)"
                                 ValueChanged="value => _emailSubject = value" />
                </div>
            }

            <div class="tm-spreadsheet-hyperlink__field">
                <label class="tm-spreadsheet-hyperlink__label" for="@DisplayInputDomId">@Loc["TmSpreadsheet_Hyperlink_Display"]</label>
                <TmTextInput Id="@DisplayInputDomId"
                             Class="tm-spreadsheet-hyperlink__input"
                             Value="@(_display ?? string.Empty)"
                             ValueChanged="value => _display = value" />
            </div>

            <div class="tm-spreadsheet-hyperlink__field">
                <label class="tm-spreadsheet-hyperlink__label" for="@TooltipInputDomId">@Loc["TmSpreadsheet_Hyperlink_Tooltip"]</label>
                <TmTextInput Id="@TooltipInputDomId"
                             Class="tm-spreadsheet-hyperlink__input"
                             Value="@(_tooltip ?? string.Empty)"
                             ValueChanged="value => _tooltip = value" />
            </div>
        </div>
    </ChildContent>
    <Footer>
        <div class="tm-spreadsheet-hyperlink__actions">
            <TmButton Variant="ButtonVariant.Ghost" OnClick="OnCancelClick" Class="tm-spreadsheet-hyperlink__btn tm-spreadsheet-hyperlink__btn--cancel">@Loc["TmSpreadsheet_Hyperlink_Cancel"]</TmButton>
            <TmButton OnClick="OnSaveClick" Class="tm-spreadsheet-hyperlink__btn tm-spreadsheet-hyperlink__btn--ok">@Loc["TmSpreadsheet_Hyperlink_Save"]</TmButton>
        </div>
    </Footer>
</TmModal>
