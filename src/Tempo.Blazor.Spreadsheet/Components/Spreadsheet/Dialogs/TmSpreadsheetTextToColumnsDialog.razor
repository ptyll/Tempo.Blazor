@namespace Tempo.Blazor.Components.Spreadsheet.Dialogs
@using Tempo.Blazor.Components.Spreadsheet.Data
@using Tempo.Blazor.Components.Workflow

@* Text to Columns on the one core dialog frame (G6). The wizard is a TALL surface, so it asks the
   frame for MobilePresentation.AutoFullscreen — a fullscreen panel on a phone, the centred dialog
   everywhere else (a sheet would clip the preview). The step indicator is the core TmStepper with the
   reference's labels; the phone swaps it for the compact "Step 2 of 3 · Delimiters" line. *@
<TmModal Show="true"
         Title="@Loc["TmSpreadsheet_TextToColumns_Title"]"
         Size="ModalSize.Large"
         LayoutMode="@LayoutMode"
         MobilePresentation="MobilePresentation.AutoFullscreen"
         FooterLayout="FooterLayout.Inline"
         CloseOnEscape="true"
         CloseOnOverlayClick="true"
         RestoreFocusTargetId="@RestoreFocusTargetId"
         Class="tm-spreadsheet-t2c"
         OnClose="Close">
    <ChildContent>
        @if (Mobile)
        {
            <div class="tm-spreadsheet-t2c__step-compact" role="status" aria-live="polite">
                @Loc["TmSpreadsheet_TextToColumns_StepCompact", _step, 3, StepLabel(_step)]
            </div>
        }
        else
        {
            <div class="tm-spreadsheet-t2c__stepper-host">
                <TmStepper Steps="_steps"
                           ActiveStep="@(_step - 1)"
                           Size="StepperSize.Small"
                           OnStepClick="OnStepClick" />
            </div>
        }

        @if (_step == 1)
        {
            <div class="tm-spreadsheet-t2c__body">
                <p class="tm-spreadsheet-t2c__steptitle">@Loc["TmSpreadsheet_TextToColumns_Step1Title"]</p>
                <label class="tm-spreadsheet-t2c__radio">
                    <input type="radio" name="t2c-mode"
                           checked="@IsMode(SpreadsheetTextToColumnsMode.Delimited)"
                           @onchange="() => SetMode(SpreadsheetTextToColumnsMode.Delimited)" />
                    <span>
                        <strong>@Loc["TmSpreadsheet_TextToColumns_Delimited"]</strong>
                        <small>@Loc["TmSpreadsheet_TextToColumns_DelimitedHint"]</small>
                    </span>
                </label>
                <label class="tm-spreadsheet-t2c__radio">
                    <input type="radio" name="t2c-mode"
                           checked="@IsMode(SpreadsheetTextToColumnsMode.FixedWidth)"
                           @onchange="() => SetMode(SpreadsheetTextToColumnsMode.FixedWidth)" />
                    <span>
                        <strong>@Loc["TmSpreadsheet_TextToColumns_FixedWidth"]</strong>
                        <small>@Loc["TmSpreadsheet_TextToColumns_FixedWidthHint"]</small>
                    </span>
                </label>
            </div>
        }
        else if (_step == 2)
        {
            <div class="tm-spreadsheet-t2c__body">
                @if (IsMode(SpreadsheetTextToColumnsMode.Delimited))
                {
                    @if (!Mobile)
                    {
                        <p class="tm-spreadsheet-t2c__steptitle">@Loc["TmSpreadsheet_TextToColumns_Step2DelimTitle"]</p>
                    }
                    <p class="tm-spreadsheet-t2c__hint">@Loc["TmSpreadsheet_TextToColumns_DelimHint"]</p>
                    <div class="tm-spreadsheet-t2c__delims">
                        <div class="tm-spreadsheet-t2c__delim">
                            <TmCheckbox Class="tm-spreadsheet-t2c__delim-check"
                                        Label="@Loc["TmSpreadsheet_TextToColumns_DelimTab"]"
                                        Value="@_options.Tab"
                                        ValueChanged="value => _options.Tab = value" />
                        </div>
                        <div class="tm-spreadsheet-t2c__delim">
                            <TmCheckbox Class="tm-spreadsheet-t2c__delim-check"
                                        Label="@Loc["TmSpreadsheet_TextToColumns_DelimSemicolon"]"
                                        Value="@_options.Semicolon"
                                        ValueChanged="value => _options.Semicolon = value" />
                        </div>
                        <div class="tm-spreadsheet-t2c__delim">
                            <TmCheckbox Class="tm-spreadsheet-t2c__delim-check"
                                        Label="@Loc["TmSpreadsheet_TextToColumns_DelimComma"]"
                                        Value="@_options.Comma"
                                        ValueChanged="value => _options.Comma = value" />
                        </div>
                        <div class="tm-spreadsheet-t2c__delim">
                            <TmCheckbox Class="tm-spreadsheet-t2c__delim-check"
                                        Label="@Loc["TmSpreadsheet_TextToColumns_DelimSpace"]"
                                        Value="@_options.Space"
                                        ValueChanged="value => _options.Space = value" />
                        </div>
                        <div class="tm-spreadsheet-t2c__delim tm-spreadsheet-t2c__delim-other">
                            <TmCheckbox Class="tm-spreadsheet-t2c__delim-check"
                                        Label="@Loc["TmSpreadsheet_TextToColumns_DelimOther"]"
                                        Value="@_useOther"
                                        ValueChanged="value => _useOther = value" />
                            <input type="text" maxlength="1" class="tm-spreadsheet-t2c__other-input"
                                   aria-label="@Loc["TmSpreadsheet_TextToColumns_DelimOther"]"
                                   value="@_otherDelimiter"
                                   @oninput="e => _otherDelimiter = e.Value?.ToString() ?? string.Empty" />
                        </div>
                    </div>
                    <div class="tm-spreadsheet-t2c__row">
                        <div class="tm-spreadsheet-t2c__inline">
                            <span class="tm-spreadsheet-t2c__inline-label">@Loc["TmSpreadsheet_TextToColumns_TextQualifier"]</span>
                            <TmSelect TValue="string"
                                      Class="tm-spreadsheet-t2c__qualifier"
                                      AriaLabel="@Loc["TmSpreadsheet_TextToColumns_TextQualifier"]"
                                      Value="_qualifier"
                                      ValueChanged="value => _qualifier = value ?? string.Empty">
                                <option value="&quot;">"</option>
                                <option value="'">'</option>
                                <option value="">@Loc["TmSpreadsheet_TextToColumns_QualifierNone"]</option>
                            </TmSelect>
                        </div>
                        <TmCheckbox Class="tm-spreadsheet-t2c__inline tm-spreadsheet-t2c__consecutive"
                                    Label="@Loc["TmSpreadsheet_TextToColumns_TreatConsecutive"]"
                                    Value="@_options.TreatConsecutiveAsOne"
                                    ValueChanged="value => _options.TreatConsecutiveAsOne = value" />
                    </div>
                }
                else
                {
                    @if (!Mobile)
                    {
                        <p class="tm-spreadsheet-t2c__steptitle">@Loc["TmSpreadsheet_TextToColumns_Step2FixedTitle"]</p>
                    }
                    <p class="tm-spreadsheet-t2c__hint">@Loc["TmSpreadsheet_TextToColumns_FixedHint"]</p>
                    <div class="tm-spreadsheet-t2c__inline">
                        <span class="tm-spreadsheet-t2c__inline-label">@Loc["TmSpreadsheet_TextToColumns_BreakPositions"]</span>
                        <input type="text" class="tm-spreadsheet-t2c__breaks-input" value="@_fixedBreaks" @oninput="e => _fixedBreaks = e.Value?.ToString() ?? string.Empty" placeholder="@Loc["TmSpreadsheet_TextToColumns_BreakPositionsPlaceholder"]" />
                    </div>
                }

                @RenderPreview(showFormatHeader: false)
            </div>
        }
        else
        {
            <div class="tm-spreadsheet-t2c__body">
                @if (!Mobile)
                {
                    <p class="tm-spreadsheet-t2c__steptitle">@Loc["TmSpreadsheet_TextToColumns_Step3Title"]</p>
                }
                <TmAlert Class="tm-spreadsheet-t2c__warning"
                         Severity="AlertSeverity.Warning">
                    @Loc["TmSpreadsheet_TextToColumns_OverwriteWarning"]
                </TmAlert>
                @if (PreviewColumnCount() > 0)
                {
                    <div class="tm-spreadsheet-t2c__formats">
                        @for (var c = 0; c < PreviewColumnCount(); c++)
                        {
                            var col = c;
                            <div class="tm-spreadsheet-t2c__format-field">
                                <span class="tm-spreadsheet-t2c__colname">@($"{Loc["TmSpreadsheet_TextToColumns_Column"]} {col + 1}")</span>
                                <TmSelect TValue="SpreadsheetColumnFormat"
                                          Class="tm-spreadsheet-t2c__format"
                                          Value="FormatFor(col)"
                                          ValueChanged="value => OnFormatChanged(col, value)">
                                    <option value="@SpreadsheetColumnFormat.General">@Loc["TmSpreadsheet_TextToColumns_FormatGeneral"]</option>
                                    <option value="@SpreadsheetColumnFormat.Text">@Loc["TmSpreadsheet_TextToColumns_FormatText"]</option>
                                    <option value="@SpreadsheetColumnFormat.Skip">@Loc["TmSpreadsheet_TextToColumns_FormatSkip"]</option>
                                </TmSelect>
                            </div>
                        }
                    </div>
                }
                @RenderPreview(showFormatHeader: true)            </div>
        }
    </ChildContent>
    <Footer>
        <div class="tm-spreadsheet-t2c__actions">
            <TmButton Variant="ButtonVariant.Ghost" OnClick="Close" Class="tm-spreadsheet-t2c__btn tm-spreadsheet-t2c__btn--cancel">@Loc["TmSpreadsheet_TextToColumns_Cancel"]</TmButton>
            <span class="tm-spreadsheet-t2c__spacer"></span>
            @if (_step > 1)
            {
                <TmButton Variant="ButtonVariant.Secondary" OnClick="Back" Class="tm-spreadsheet-t2c__btn tm-spreadsheet-t2c__btn--back">@Loc["TmSpreadsheet_TextToColumns_Back"]</TmButton>
            }
            @if (_step < 3)
            {
                <TmButton OnClick="Next" Class="tm-spreadsheet-t2c__btn tm-spreadsheet-t2c__btn--ok">@Loc["TmSpreadsheet_TextToColumns_Next"]</TmButton>
            }
            else
            {
                <TmButton OnClick="Finish" Class="tm-spreadsheet-t2c__btn tm-spreadsheet-t2c__btn--ok">@Loc["TmSpreadsheet_TextToColumns_Finish"]</TmButton>
            }
        </div>
    </Footer>
</TmModal>

@code {
    /// <summary>
    /// The preview: a real table with a sticky column header inside its own horizontal scroller, so a
    /// wide split scrolls sideways instead of widening the wizard. Built as a Razor TEMPLATE (not a
    /// RenderTreeBuilder fragment): only compiler-generated markup carries the component's CSS scope
    /// attribute, and a builder-built table silently lost every style of this stylesheet.
    /// </summary>
    private RenderFragment RenderPreview(bool showFormatHeader) => @<text>
        @{
            var previewRows = Preview();
            var previewColumns = PreviewColumnCount();
        }
        @if (previewRows.Count > 0 && previewColumns > 0)
        {
            <div class="tm-spreadsheet-t2c__preview">
                <div class="tm-spreadsheet-t2c__preview-label">@Loc["TmSpreadsheet_TextToColumns_Preview"]</div>
                <div class="tm-spreadsheet-t2c__preview-scroll">
                    <table class="tm-spreadsheet-t2c__preview-table">
                        <thead>
                            <tr>
                                @for (var c = 0; c < previewColumns; c++)
                                {
                                    <th scope="col">@($"{Loc["TmSpreadsheet_TextToColumns_Column"]} {c + 1}")</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in previewRows)
                            {
                                <tr>
                                    @for (var c = 0; c < previewColumns; c++)
                                    {
                                        var skipped = showFormatHeader && FormatFor(c) == SpreadsheetColumnFormat.Skip;
                                        <td class="@(skipped ? "tm-spreadsheet-t2c__preview-skip" : null)">@(c < row.Count ? row[c] : string.Empty)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </text>;
}
