@namespace Tempo.Blazor.Components.Spreadsheet.Dialogs
@using Tempo.Blazor.Components.Spreadsheet.Data

@* Text to Columns on the one core dialog frame (G6). The wizard is a TALL surface, so it asks the
   frame for MobilePresentation.AutoFullscreen — a fullscreen panel on a phone, the centred dialog
   everywhere else (a sheet would clip the preview). *@
<TmModal Show="true"
         Title="@Loc["TmSpreadsheet_TextToColumns_Title"]"
         Size="ModalSize.Large"
         LayoutMode="@LayoutMode"
         MobilePresentation="MobilePresentation.AutoFullscreen"
         FooterLayout="FooterLayout.Inline"
         CloseOnEscape="true"
         CloseOnOverlayClick="true"
         RestoreFocusTargetId="@RestoreFocusTargetId"
         Class="tm-spreadsheet-t2c"
         OnClose="Close">
    <ChildContent>
        <ol class="tm-spreadsheet-t2c__steps">
            <li class="@(_step == 1 ? "tm-spreadsheet-t2c__step--active" : "")">1</li>
            <li class="@(_step == 2 ? "tm-spreadsheet-t2c__step--active" : "")">2</li>
            <li class="@(_step == 3 ? "tm-spreadsheet-t2c__step--active" : "")">3</li>
        </ol>

        @if (_step == 1)
        {
            <div class="tm-spreadsheet-t2c__body">
                <p class="tm-spreadsheet-t2c__steptitle">@Loc["TmSpreadsheet_TextToColumns_Step1Title"]</p>
                <label class="tm-spreadsheet-t2c__radio">
                    <input type="radio" name="t2c-mode"
                           checked="@IsMode(SpreadsheetTextToColumnsMode.Delimited)"
                           @onchange="() => SetMode(SpreadsheetTextToColumnsMode.Delimited)" />
                    <span>
                        <strong>@Loc["TmSpreadsheet_TextToColumns_Delimited"]</strong>
                        <small>@Loc["TmSpreadsheet_TextToColumns_DelimitedHint"]</small>
                    </span>
                </label>
                <label class="tm-spreadsheet-t2c__radio">
                    <input type="radio" name="t2c-mode"
                           checked="@IsMode(SpreadsheetTextToColumnsMode.FixedWidth)"
                           @onchange="() => SetMode(SpreadsheetTextToColumnsMode.FixedWidth)" />
                    <span>
                        <strong>@Loc["TmSpreadsheet_TextToColumns_FixedWidth"]</strong>
                        <small>@Loc["TmSpreadsheet_TextToColumns_FixedWidthHint"]</small>
                    </span>
                </label>
            </div>
        }
        else if (_step == 2)
        {
            <div class="tm-spreadsheet-t2c__body">
                @if (IsMode(SpreadsheetTextToColumnsMode.Delimited))
                {
                    <p class="tm-spreadsheet-t2c__steptitle">@Loc["TmSpreadsheet_TextToColumns_Step2DelimTitle"]</p>
                    <div class="tm-spreadsheet-t2c__delims">
                        <label><input type="checkbox" checked="@_options.Tab" @onchange="e => _options.Tab = e.Value is bool b && b" /> @Loc["TmSpreadsheet_TextToColumns_DelimTab"]</label>
                        <label><input type="checkbox" checked="@_options.Semicolon" @onchange="e => _options.Semicolon = e.Value is bool b && b" /> @Loc["TmSpreadsheet_TextToColumns_DelimSemicolon"]</label>
                        <label><input type="checkbox" checked="@_options.Comma" @onchange="e => _options.Comma = e.Value is bool b && b" /> @Loc["TmSpreadsheet_TextToColumns_DelimComma"]</label>
                        <label><input type="checkbox" checked="@_options.Space" @onchange="e => _options.Space = e.Value is bool b && b" /> @Loc["TmSpreadsheet_TextToColumns_DelimSpace"]</label>
                        <label class="tm-spreadsheet-t2c__delim-other">
                            <input type="checkbox" checked="@_useOther" @onchange="e => _useOther = e.Value is bool b && b" /> @Loc["TmSpreadsheet_TextToColumns_DelimOther"]
                            <input type="text" maxlength="1" class="tm-spreadsheet-t2c__other-input" aria-label="@Loc["TmSpreadsheet_TextToColumns_DelimOther"]" value="@_otherDelimiter" @oninput="e => _otherDelimiter = e.Value?.ToString() ?? string.Empty" />
                        </label>
                    </div>
                    <div class="tm-spreadsheet-t2c__row">
                        <label class="tm-spreadsheet-t2c__inline">
                            @Loc["TmSpreadsheet_TextToColumns_TextQualifier"]
                            <select @bind="_qualifier" aria-label="@Loc["TmSpreadsheet_TextToColumns_TextQualifier"]">
                                <option value="&quot;">"</option>
                                <option value="'">'</option>
                                <option value="">@Loc["TmSpreadsheet_TextToColumns_QualifierNone"]</option>
                            </select>
                        </label>
                        <label class="tm-spreadsheet-t2c__inline">
                            <input type="checkbox" checked="@_options.TreatConsecutiveAsOne" @onchange="e => _options.TreatConsecutiveAsOne = e.Value is bool b && b" />
                            @Loc["TmSpreadsheet_TextToColumns_TreatConsecutive"]
                        </label>
                    </div>
                }
                else
                {
                    <p class="tm-spreadsheet-t2c__steptitle">@Loc["TmSpreadsheet_TextToColumns_Step2FixedTitle"]</p>
                    <p class="tm-spreadsheet-t2c__hint">@Loc["TmSpreadsheet_TextToColumns_FixedHint"]</p>
                    <label class="tm-spreadsheet-t2c__inline">
                        @Loc["TmSpreadsheet_TextToColumns_BreakPositions"]
                        <input type="text" class="tm-spreadsheet-t2c__breaks-input" value="@_fixedBreaks" @oninput="e => _fixedBreaks = e.Value?.ToString() ?? string.Empty" placeholder="@Loc["TmSpreadsheet_TextToColumns_BreakPositionsPlaceholder"]" />
                    </label>
                }

                @RenderPreview(showFormatHeader: false)
            </div>
        }
        else
        {
            <div class="tm-spreadsheet-t2c__body">
                <p class="tm-spreadsheet-t2c__steptitle">@Loc["TmSpreadsheet_TextToColumns_Step3Title"]</p>
                @if (PreviewColumnCount() > 0)
                {
                    <div class="tm-spreadsheet-t2c__formats">
                        @for (var c = 0; c < PreviewColumnCount(); c++)
                        {
                            var col = c;
                            <label class="tm-spreadsheet-t2c__inline">
                                <span class="tm-spreadsheet-t2c__colname">@($"{Loc["TmSpreadsheet_TextToColumns_Column"]} {col + 1}")</span>
                                <select value="@FormatFor(col)" @onchange="e => OnFormatChanged(col, e)">
                                    <option value="@SpreadsheetColumnFormat.General">@Loc["TmSpreadsheet_TextToColumns_FormatGeneral"]</option>
                                    <option value="@SpreadsheetColumnFormat.Text">@Loc["TmSpreadsheet_TextToColumns_FormatText"]</option>
                                    <option value="@SpreadsheetColumnFormat.Skip">@Loc["TmSpreadsheet_TextToColumns_FormatSkip"]</option>
                                </select>
                            </label>
                        }
                    </div>
                }
                @RenderPreview(showFormatHeader: true)
                <p class="tm-spreadsheet-t2c__warning">@Loc["TmSpreadsheet_TextToColumns_OverwriteWarning"]</p>
            </div>
        }
    </ChildContent>
    <Footer>
        <div class="tm-spreadsheet-t2c__actions">
            <TmButton Variant="ButtonVariant.Ghost" OnClick="Close" Class="tm-spreadsheet-t2c__btn tm-spreadsheet-t2c__btn--cancel">@Loc["TmSpreadsheet_TextToColumns_Cancel"]</TmButton>
            <span class="tm-spreadsheet-t2c__spacer"></span>
            @if (_step > 1)
            {
                <TmButton Variant="ButtonVariant.Secondary" OnClick="Back" Class="tm-spreadsheet-t2c__btn tm-spreadsheet-t2c__btn--back">@Loc["TmSpreadsheet_TextToColumns_Back"]</TmButton>
            }
            @if (_step < 3)
            {
                <TmButton OnClick="Next" Class="tm-spreadsheet-t2c__btn tm-spreadsheet-t2c__btn--ok">@Loc["TmSpreadsheet_TextToColumns_Next"]</TmButton>
            }
            else
            {
                <TmButton OnClick="Finish" Class="tm-spreadsheet-t2c__btn tm-spreadsheet-t2c__btn--ok">@Loc["TmSpreadsheet_TextToColumns_Finish"]</TmButton>
            }
        </div>
    </Footer>
</TmModal>

@code {
    private RenderFragment RenderPreview(bool showFormatHeader) => builder =>
    {
        var preview = Preview();
        var cols = PreviewColumnCount();
        if (preview.Count == 0 || cols == 0)
            return;

        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "tm-spreadsheet-t2c__preview");

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "tm-spreadsheet-t2c__preview-label");
        builder.AddContent(seq++, Loc["TmSpreadsheet_TextToColumns_Preview"]);
        builder.CloseElement();

        builder.OpenElement(seq++, "table");
        builder.AddAttribute(seq++, "class", "tm-spreadsheet-t2c__preview-table");
        foreach (var row in preview)
        {
            builder.OpenElement(seq++, "tr");
            for (var c = 0; c < cols; c++)
            {
                var skipped = showFormatHeader && FormatFor(c) == SpreadsheetColumnFormat.Skip;
                builder.OpenElement(seq++, "td");
                builder.AddAttribute(seq++, "class", skipped ? "tm-spreadsheet-t2c__preview-skip" : null);
                builder.AddContent(seq++, c < row.Count ? row[c] : string.Empty);
                builder.CloseElement();
            }
            builder.CloseElement();
        }
        builder.CloseElement();
        builder.CloseElement();
    };
}
