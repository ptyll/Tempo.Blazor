@namespace Tempo.Blazor.Components.Spreadsheet.Dialogs
@using Tempo.Blazor.Components.Spreadsheet.Data
@using Tempo.Blazor.Components.Spreadsheet.Models

@* The sort dialog rides the one core dialog frame (G6): TmModal owns the fixed overlay, the dialog
   role, aria-modal, the initial focus, the document-level Escape, the focus restore and the mobile
   presentation. The package contributes the level table, the toolbar and the footer actions. *@
<TmModal Show="true"
         Title="@Loc["TmSpreadsheet_Sort_Title"]"
         Size="ModalSize.Medium"
         LayoutMode="@LayoutMode"
         MobilePresentation="MobilePresentation.Auto"
         FooterLayout="FooterLayout.Inline"
         CloseOnEscape="true"
         CloseOnOverlayClick="true"
         InitialFocusTargetId="@AddLevelDomId"
         RestoreFocusTargetId="@RestoreFocusTargetId"
         Class="tm-spreadsheet-sort"
         OnClose="Close">
    <ChildContent>
        <div class="tm-spreadsheet-sort__toolbar">
            <button type="button" class="tm-spreadsheet-sort__tool" id="@AddLevelDomId" @onclick="AddLevel">
                <TmIcon Name="plus" /> @Loc["TmSpreadsheet_Sort_AddLevel"]
            </button>
            <label class="tm-spreadsheet-sort__header-toggle">
                <input type="checkbox" checked="@_hasHeader" @onchange="e => _hasHeader = e.Value is bool b && b" />
                <span>@Loc["TmSpreadsheet_Sort_HasHeader"]</span>
            </label>
            <label class="tm-spreadsheet-sort__header-toggle">
                <input type="checkbox" checked="@_caseSensitive" @onchange="e => _caseSensitive = e.Value is bool b2 && b2" />
                <span>@Loc["TmSpreadsheet_Sort_CaseSensitive"]</span>
            </label>
        </div>

        <table class="tm-spreadsheet-sort__table">
            <thead>
                <tr>
                    <th></th>
                    <th>@Loc["TmSpreadsheet_Sort_Column"]</th>
                    <th>@Loc["TmSpreadsheet_Sort_SortOn"]</th>
                    <th>@Loc["TmSpreadsheet_Sort_Order"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < _levels.Count; i++)
                {
                    var level = _levels[i];
                    var index = i;
                    <tr>
                        <td class="tm-spreadsheet-sort__rowlabel">@(index == 0 ? Loc["TmSpreadsheet_Sort_SortBy"] : Loc["TmSpreadsheet_Sort_ThenBy"])</td>
                        <td>
                            <select aria-label="@Loc["TmSpreadsheet_Sort_ColumnLevelAria", index + 1]" @bind="level.KeyIndex">
                                @foreach (var col in ColumnChoices)
                                {
                                    <option value="@col.Index">@col.Label</option>
                                }
                            </select>
                        </td>
                        <td>
                            <select aria-label="@Loc["TmSpreadsheet_Sort_SortOnLevelAria", index + 1]" @bind="level.SortOn">
                                <option value="@SpreadsheetSortOn.Value">@Loc["TmSpreadsheet_Sort_OnValue"]</option>
                                <option value="@SpreadsheetSortOn.CellColor">@Loc["TmSpreadsheet_Sort_OnCellColor"]</option>
                                <option value="@SpreadsheetSortOn.FontColor">@Loc["TmSpreadsheet_Sort_OnFontColor"]</option>
                            </select>
                        </td>
                        <td>
                            <select aria-label="@Loc["TmSpreadsheet_Sort_OrderLevelAria", index + 1]" @bind="level.Direction">
                                <option value="@SpreadsheetSortDirection.Ascending">@Loc["TmSpreadsheet_Sort_AtoZ"]</option>
                                <option value="@SpreadsheetSortDirection.Descending">@Loc["TmSpreadsheet_Sort_ZtoA"]</option>
                            </select>
                        </td>
                        <td>
                            <button type="button" class="tm-spreadsheet-sort__remove"
                                    title="@Loc["TmSpreadsheet_Sort_DeleteLevel"]"
                                    aria-label="@Loc["TmSpreadsheet_Sort_DeleteLevel"]"
                                    disabled="@(_levels.Count <= 1)"
                                    @onclick="() => RemoveLevel(index)">
                                <TmIcon Name="x" Size="IconSize.Sm" />
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </ChildContent>
    <Footer>
        <div class="tm-spreadsheet-sort__actions">
            <TmButton Variant="ButtonVariant.Ghost"
                      OnClick="Close"
                      Class="tm-spreadsheet-sort__btn tm-spreadsheet-sort__btn--cancel">
                @Loc["TmSpreadsheet_Sort_Cancel"]
            </TmButton>
            <TmButton OnClick="Apply"
                      Class="tm-spreadsheet-sort__btn tm-spreadsheet-sort__btn--ok">
                @Loc["TmSpreadsheet_Sort_Ok"]
            </TmButton>
        </div>
    </Footer>
</TmModal>
