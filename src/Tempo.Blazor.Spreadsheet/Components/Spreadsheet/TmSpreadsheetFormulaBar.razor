@namespace Tempo.Blazor.Components.Spreadsheet
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Components.Spreadsheet.Models

@* Formula bar per spreadsheet--desktop.png: the name box (with a named-range list when the workbook has
   any), the permanent fx mark, the editor and — while the bar is editing — the ✓ / ✗ commit and revert
   buttons (SP4). The DOM contracts the grid and the E2E specs key off stay: __ref (the name box input),
   __display, __input and the formula-bar input test id. *@
<div class="tm-spreadsheet-formula-bar" @ref="_rootRef">
    <div class="tm-spreadsheet-formula-bar__name-box"
         @ref="_nameBoxWrapperRef"
         @onkeydown="HandleNameBoxWrapperKeyDown"
         @onfocusout="HandleNameBoxFocusOutAsync">
        <input class="tm-spreadsheet-formula-bar__ref"
               type="text"
               @ref="_nameBoxRef"
               title="@Loc["TmSpreadsheet_CellReference"]"
               aria-label="@Loc["TmSpreadsheet_CellReference"]"
               value="@_nameBoxValue"
               aria-haspopup="@(HasNamedRanges ? "listbox" : null)"
               aria-expanded="@(HasNamedRanges ? (_isRefListOpen ? "true" : "false") : null)"
               aria-controls="@(HasNamedRanges && _isRefListOpen ? RefListId : null)"
               aria-activedescendant="@(HasNamedRanges && _isRefListOpen && _activeRefIndex >= 0 ? RefItemId(_activeRefIndex) : null)"
               @oninput="OnNameBoxInput"
               @onkeydown="HandleNameBoxKeyDown"
               @onblur="OnNameBoxBlur" />
        @if (HasNamedRanges)
        {
            <button type="button"
                    class="tm-spreadsheet-formula-bar__ref-toggle"
                    title="@Loc["TmSpreadsheet_NamedRanges"]"
                    aria-label="@Loc["TmSpreadsheet_NamedRanges"]"
                    aria-haspopup="listbox"
                    aria-expanded="@(_isRefListOpen ? "true" : "false")"
                    @onclick="ToggleNamedRangeList">
                <TmIcon Name="chevron-down" />
            </button>
        }
        @if (_isRefListOpen)
        {
            @* A transparent outside-click catcher: the list is a small inline popover under the name
               box, so a click anywhere else closes it without a global listener. *@
            <div class="tm-spreadsheet-formula-bar__ref-overlay"
                 aria-hidden="true"
                 @onclick="CloseNamedRangeList"></div>
            <div class="tm-spreadsheet-formula-bar__ref-list"
                 id="@RefListId"
                 role="listbox"
                 aria-label="@Loc["TmSpreadsheet_NamedRanges"]">
                @for (var index = 0; index < NamedRanges!.Count; index++)
                {
                    var i = index;
                    var range = NamedRanges[i];
                    <button type="button"
                            id="@RefItemId(i)"
                            class="tm-spreadsheet-formula-bar__ref-item @(_activeRefIndex == i ? "tm-spreadsheet-formula-bar__ref-item--active" : null)"
                            role="option"
                            aria-selected="@(_activeRefIndex == i ? "true" : "false")"
                            tabindex="-1"
                            @onmousedown:preventDefault
                            @onclick="() => SelectNamedRangeAsync(range)">
                        @range.Name
                    </button>
                }
            </div>
        }
    </div>
    <div class="tm-spreadsheet-formula-bar__fx" aria-hidden="true">
        fx
    </div>
    <div class="tm-spreadsheet-formula-bar__editor">
        @if (EditorIsEditing)
        {
            <input class="tm-spreadsheet-formula-bar__input"
                   type="text"
                   value="@_editValue"
                   @ref="_inputRef"
                   @oninput="OnInput"
                   @onkeydown="HandleKeyDown"
                   @onkeyup="RefreshSelectionStateAsync"
                   @onclick="RefreshSelectionStateAsync"
                   @ondblclick="RefreshSelectionStateAsync"
                   @onmouseup="RefreshSelectionStateAsync"
                   @onselect="RefreshSelectionStateAsync"
                   @onblur="HandleBlurAsync"
                   @onkeydown:stopPropagation="true"
                   aria-label="@Loc["TmSpreadsheet_FormulaEditorLabel"]"
                   aria-describedby="@GetFormulaAriaDescribedBy()"
                   placeholder="@Loc["TmSpreadsheet_FormulaBarPlaceholder"]"
                   data-testid="@TestId("tm-spreadsheet-formula-bar-input")" />
            @if (HasSuggestions)
            {
                <div class="tm-spreadsheet-formula-bar__suggestions"
                     role="listbox"
                     aria-label="@Loc["TmSpreadsheet_FormulaFunctionSuggestionsLabel"]"
                     data-testid="@TestId("tm-spreadsheet-formula-bar-suggestions")">
                    @for (var index = 0; index < CurrentSession.Suggestions.Count; index++)
                    {
                        var suggestion = CurrentSession.Suggestions[index];
                        var isSelected = index == CurrentSession.SelectedSuggestionIndex;
                        <button type="button"
                                class="tm-spreadsheet-formula-bar__suggestion @(isSelected ? "tm-spreadsheet-formula-bar__suggestion--selected" : null)"
                                role="option"
                                aria-selected="@(isSelected ? "true" : "false")"
                                @onmousedown:preventDefault
                                @onclick="() => AcceptSuggestionAsync(index)"
                                data-testid="@TestId("tm-spreadsheet-formula-bar-suggestion")">
                            <span class="tm-spreadsheet-formula-bar__suggestion-name">@suggestion.Name</span>
                            <span class="tm-spreadsheet-formula-bar__suggestion-signature">@suggestion.Signature</span>
                        </button>
                    }
                </div>
            }
            @if (CurrentSession.ActiveFunctionHint is not null && !HasSuggestions)
            {
                <div class="tm-spreadsheet-formula-bar__hint"
                     id="@_functionHintId"
                     aria-live="polite"
                     data-testid="@TestId("tm-spreadsheet-formula-bar-hint")">
                    <div class="tm-spreadsheet-formula-bar__hint-name">@CurrentSession.ActiveFunctionHint.Function.Name</div>
                    <div class="tm-spreadsheet-formula-bar__hint-signature">
                        <span>@($"{CurrentSession.ActiveFunctionHint.Function.Name}(")</span>
                        @for (var index = 0; index < CurrentSession.ActiveFunctionHint.Function.Arguments.Count; index++)
                        {
                            if (index > 0)
                            {
                                <span>, </span>
                            }
                            <span class="@(index == CurrentSession.ActiveFunctionHint.ActiveArgumentIndex ? "tm-spreadsheet-formula-bar__hint-arg tm-spreadsheet-formula-bar__hint-arg--active" : "tm-spreadsheet-formula-bar__hint-arg")">
                                @CurrentSession.ActiveFunctionHint.Function.Arguments[index]
                            </span>
                        }
                        <span>)</span>
                    </div>
                    <div class="tm-spreadsheet-formula-bar__hint-summary">@CurrentSession.ActiveFunctionHint.Function.Summary</div>
                </div>
            }
        }
        else
        {
            <div class="tm-spreadsheet-formula-bar__display"
                 role="button"
                 tabindex="0"
                 aria-label="@Loc["TmSpreadsheet_FormulaEditorLabel"]"
                 @onkeydown="HandleDisplayKeyDown"
                 @onmousedown="StartEdit"
                 @onclick="StartEdit">
                @(DisplayValue ?? Loc["TmSpreadsheet_FormulaBarPlaceholder"])
            </div>
        }
    </div>
    @if (EditorIsEditing)
    {
        <div class="tm-spreadsheet-formula-bar__actions">
            <button type="button"
                    class="tm-spreadsheet-formula-bar__confirm"
                    title="@Loc["TmSpreadsheet_FormulaConfirm"]"
                    aria-label="@Loc["TmSpreadsheet_FormulaConfirm"]"
                    @onmousedown:preventDefault
                    @onclick="ConfirmFromBarAsync">
                <TmIcon Name="check" />
            </button>
            <button type="button"
                    class="tm-spreadsheet-formula-bar__cancel"
                    title="@Loc["TmSpreadsheet_FormulaCancel"]"
                    aria-label="@Loc["TmSpreadsheet_FormulaCancel"]"
                    @onmousedown:preventDefault
                    @onclick="CancelFromBarAsync">
                <TmIcon Name="close" />
            </button>
        </div>
    }
</div>
