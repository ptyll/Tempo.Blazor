@namespace Tempo.Blazor.Components.Overlay
@inherits Tempo.Blazor.Components.TmComponentBase
@using Microsoft.JSInterop
@using System.Threading
@using Tempo.Blazor.Abstractions.Layout
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Layout
@using Tempo.Blazor.Helpers
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<OverlayLayout> LayoutLogger

@* The panel element itself is rendered only while open: an open top-layer popover whose element
   is detached is automatically hidden by the browser, so closing never needs hidePopover() on a
   dead node — and consumers' "menu absent while closed" markup contracts keep holding.

   Mobile presentation (F3): when the resolved presentation is a sheet, the panel composes
   TmDrawer Position=Bottom (content height, Modal) instead of the floating popover. The sheet
   renders in place — inside the modal's DOM when the anchor lives in a modal — so stacking and
   the nested focus trap stay correct. *@
@if (IsVisible && Viewport is null && LayoutMode == TmLayoutMode.Auto && MobilePresentation == PanelPresentation.Auto)
{
    @* No viewport scope: measure the viewport itself, so the first frame is not stuck on the
       initial mode. The probe is an internal component, so it is opened from C# — a tag in markup
       would compile to a literal HTML element and nothing would ever measure. *@
    @Probe
}
@if (IsVisible)
{
    if (IsSheet)
    {
        @* The sheet composes TmDrawer Position=Bottom (content height, Modal). The resolved layout
           is handed down — the drawer never measures a second time. ChildContent wraps in a
           content div that carries Role/Id/AdditionalAttributes, so menu/listbox ownership (axe
           aria-required-parent) and aria-controls targets survive the popover→sheet switch; a
           dialog role stays on the drawer's focus-scope root. *@
        <TmDrawer IsOpen="true"
                  IsOpenChanged="HandleSheetOpenChanged"
                  Position="DrawerPosition.Bottom"
                  Modal="true"
                  SnapPoints="Array.Empty<double>()"
                  ShowHandle="@CloseOnOutsidePointerDown"
                  ShowCloseButton="false"
                  CloseOnEscape="CloseOnEscape"
                  OnEscape="HandleSheetEscape"
                  CloseOnOverlayClick="CloseOnOutsidePointerDown"
                  SwipeToDismiss="CloseOnOutsidePointerDown"
                  RestoreFocusTarget="SheetRestoreTarget"
                  Title="@SheetTitle"
                  AriaLabel="@SheetAriaLabel"
                  LayoutMode="Context.Resolved"
                  InitialMode="Context.Resolved"
                  InitialFocusSelector="@SheetInitialFocusSelector"
                  Class="tm-overlay-panel-sheet"
                  DataTestId="@RootTestId("tm-overlay-panel")">
            <HeaderContent>
                @if (!string.IsNullOrEmpty(SheetTitle))
                {
                    <h2 id="@_sheetTitleId" class="tm-overlay-panel-sheet__title">@SheetTitle</h2>
                }
                <button type="button"
                        class="tm-overlay-panel-sheet__done"
                        disabled="@(!SheetDoneEnabled)"
                        @onclick="CloseSheetAsync">
                    @Loc["Tm_Done"]
                </button>
            </HeaderContent>
            <ChildContent>
                <div class="tm-overlay-panel-sheet__content"
                     id="@Id"
                     role="@(Role is "dialog" ? null : Role)"
                     aria-label="@AriaLabel"
                     aria-labelledby="@SheetContentLabelledBy"
                     @attributes="AdditionalAttributes">
                    @ChildContent
                </div>
            </ChildContent>
        </TmDrawer>
    }
    else if (TrapFocus)
    {
        @* A dialog-role popup that must enforce its modality: the focus scope IS the panel root,
           so the trap, the inert background and the top-layer popover share one element. Escape
           stays with overlay.js (window capture), which dismisses through NotifyDismissedAsync.
           Active is gated on _trapActive: the scope may only activate AFTER overlay.js open()
           ran showPopover() — activating earlier moves initial focus into a still-hidden
           (display:none) popover and loses focus to <body> (review finding T5). *@
        <TmFocusScope @ref="_scope"
                      Active="_trapActive"
                      Modal="true"
                      Class="@($"tm-overlay-panel {Class}")"
                      DialogRole="@Role"
                      AriaLabel="@EffectiveAriaLabel"
                      AriaLabelledBy="@AriaLabelledBy"
                      CloseOnEscape="false"
                      AdditionalAttributes="TrapFocusAttributes">
            @ChildContent
        </TmFocusScope>
    }
    else
    {
        <div @ref="_panelRef"
             id="@Id"
             class="tm-overlay-panel @Class"
             popover="manual"
             role="@Role"
             aria-label="@EffectiveAriaLabel"
             aria-labelledby="@AriaLabelledBy"
             data-testid="@RootTestId("tm-overlay-panel")"
             @attributes="AdditionalAttributes">
            @ChildContent
        </div>
    }
}

@code {
    private const string ModulePath = "./_content/Tempo.Blazor/js/overlay.js";

    private readonly string _key = $"tm-overlay-{Guid.NewGuid():n}";
    private readonly string _sheetTitleId = $"tm-overlay-panel-sheet-title-{Guid.NewGuid():n}";
    private ElementReference _panelRef;
    private TmFocusScope? _scope;
    private IJSObjectReference? _module;
    private DotNetObjectReference<TmOverlayPanel>? _dotNetRef;
    // Serializes every read/write of _jsOpen/_module/_disposed: two OnAfterRenderAsync runs (or a
    // DisposeAsync racing one) must never both observe _jsOpen==false and double-open (N198), and
    // a render resuming after DisposeAsync must not import a module it then leaks (N172).
    private readonly SemaphoreSlim _jsSync = new(1, 1);
    private readonly OverlayLayout _layout = new();
    private bool _disposed;
    private bool _jsOpen;
    private bool _internalOpen;
    private bool _trapActive;
    private bool _openedPending;
    private bool _openedFired;
    private string? _openOptionsSignature;

    /// <summary>
    /// Id of the rendered panel element. Defaults to a generated value; supply one when the anchor
    /// should reference it (e.g. via <c>aria-controls</c>). In sheet mode the id lands on the
    /// content wrapper inside the drawer body, so the reference resolves in both presentations.
    /// </summary>
    [Parameter] public string Id { get; set; } = $"tm-overlay-panel-{Guid.NewGuid():n}";

    /// <summary>
    /// The element the panel positions itself against. When unset (default
    /// <see cref="ElementReference"/>) overlay.js falls back to the panel's previous element
    /// sibling — the natural trigger-then-panel layout every built-in consumer uses. In sheet mode
    /// it is also the element focus returns to when the sheet closes.
    /// </summary>
    [Parameter] public ElementReference Anchor { get; set; }

    /// <summary>Preferred side of <see cref="Anchor"/> the panel opens on. Default <see cref="OverlayPlacement.Bottom"/>.</summary>
    [Parameter] public OverlayPlacement Placement { get; set; } = OverlayPlacement.Bottom;

    /// <summary>Cross-axis alignment against <see cref="Anchor"/>. Default <see cref="OverlayAlign.Start"/>.</summary>
    [Parameter] public OverlayAlign Align { get; set; } = OverlayAlign.Start;

    /// <summary>Gap in pixels between anchor and panel on the resolved side. Default 4.</summary>
    [Parameter] public int Offset { get; set; } = 4;

    /// <summary>Minimum distance in pixels the panel keeps from the viewport edges. Default 8.</summary>
    [Parameter] public int ViewportMargin { get; set; } = 8;

    /// <summary>Flip to the opposite side when the preferred side does not have enough room. Default true.</summary>
    [Parameter] public bool Flip { get; set; } = true;

    /// <summary>Slide the panel along the cross axis so it stays inside the viewport. Default true.</summary>
    [Parameter] public bool Shift { get; set; } = true;

    /// <summary>Stretch the panel to the anchor's width (dropdown/select menus). Default false. Popover mode only.</summary>
    [Parameter] public bool MatchAnchorWidth { get; set; }

    /// <summary>
    /// Cap the panel height at the room available on the resolved side (the script writes an inline
    /// <c>max-height</c>, honouring a smaller CSS cap when one exists) and let it scroll. Default false.
    /// Popover mode only.
    /// </summary>
    [Parameter] public bool ConstrainHeight { get; set; }

    /// <summary>Close when Escape is pressed while the panel is open. Default true.</summary>
    [Parameter] public bool CloseOnEscape { get; set; } = true;

    /// <summary>
    /// Close when a <c>pointerdown</c> lands outside both the panel and the anchor. Default true.
    /// The anchor is exempt so clicking the trigger toggles instead of close-then-reopen races.
    /// In sheet mode this governs the backdrop click and the swipe-to-dismiss gesture.
    /// </summary>
    [Parameter] public bool CloseOnOutsidePointerDown { get; set; } = true;

    /// <summary>Controlled open state. When null the panel tracks its own internal state.</summary>
    [Parameter] public bool? IsOpen { get; set; }

    /// <summary>Fires when the open state should change (two-way bindable).</summary>
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>
    /// Raised after the panel has finished opening: in popover mode once overlay.js
    /// <c>open()</c> ran <c>showPopover()</c> (the panel is displayed and in the top layer), in
    /// sheet mode after the sheet's opening render. Use it for post-open focus moves — e.g.
    /// focusing a filter input — because a consumer's <c>OnAfterRenderAsync</c> can run before
    /// the panel is displayed, and a focus move against a still-hidden popover is dropped
    /// (UX review round 2, m3). Fires once per open; closing resets it.
    /// </summary>
    [Parameter] public EventCallback OnOpened { get; set; }

    /// <summary>
    /// Fires when the panel is dismissed by a user gesture rather than by the consumer:
    /// <c>"escape"</c>, <c>"outside"</c> or <c>"anchor-hidden"</c> (the anchor scrolled fully out
    /// of the viewport while focus sat inside the panel — the hidden panel would keep swallowing
    /// keys, so it is closed and focus returns to the anchor). Programmatic closes
    /// (<see cref="CloseAsync"/>, <see cref="IsOpen"/> turning false) do not raise it — the
    /// consumer already knows. A sheet raises it for Escape (<c>"escape"</c>); Done, the backdrop
    /// click and the swipe close through the drawer's own <see cref="IsOpenChanged"/> without a
    /// reason.
    /// </summary>
    [Parameter] public EventCallback<string> OnDismissed { get; set; }

    /// <summary>
    /// Whether the sheet header's Done action is enabled. Default true. A consumer mid-task can
    /// keep Done disabled until its input is complete — TmDateRangePicker disables it until BOTH
    /// dates are picked, so a half range can never close the sheet silently (Escape, the backdrop
    /// click and the swipe still close and keep the partial selection, as on the popover).
    /// </summary>
    [Parameter] public bool SheetDoneEnabled { get; set; } = true;

    /// <summary>ARIA role of the panel — typically <c>menu</c>, <c>listbox</c>, <c>dialog</c> or <c>tooltip</c>.</summary>
    [Parameter] public string? Role { get; set; }

    /// <summary>
    /// Accessible name for the panel — emitted as <c>aria-label</c>. Every <c>Role="dialog"</c>
    /// panel must get a name from here, <see cref="AriaLabelledBy"/> or <see cref="Title"/>:
    /// an unnamed dialog announces only "dialog" and fails axe's aria-dialog-name rule.
    /// </summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>
    /// Id of the element that names the panel — emitted as <c>aria-labelledby</c>. Prefer this
    /// over <see cref="AriaLabel"/> when the panel already renders a visible title.
    /// </summary>
    [Parameter] public string? AriaLabelledBy { get; set; }

    /// <summary>
    /// Title of the sheet header when the panel presents as a bottom sheet. Falls back to
    /// <see cref="AriaLabel"/> and then to a generic localized "Menu", so the sheet dialog is
    /// always named. Also names the popover: when neither <see cref="AriaLabel"/> nor
    /// <see cref="AriaLabelledBy"/> is set, the popover emits this as its aria-label.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>
    /// How the panel presents on a narrow viewport. Default <see cref="PanelPresentation.Popover"/>:
    /// the anchored popover at every width. A surface whose anchor keeps focus (a typeahead, a
    /// caret menu, an inline toolbar) must stay on that default — presenting it as a modal sheet
    /// moves focus to the sheet header and loses keystrokes. Opt-in wrappers (TmDropdown,
    /// TmPopover) and deliberate sheet consumers (the column picker, the date/time pickers) pass
    /// <see cref="PanelPresentation.Auto"/>, which follows the viewport scope: a content-height
    /// bottom sheet on mobile, the anchored popover otherwise. A forced value renders that
    /// presentation without measuring, so a test can render it without a DOM. The popover's size
    /// still follows the trigger's container; only the popover-vs-sheet choice resolves from the
    /// viewport.
    /// </summary>
    [Parameter] public PanelPresentation MobilePresentation { get; set; } = PanelPresentation.Popover;

    /// <summary>
    /// Trap Tab inside the panel and mark the background inert while it is open — the modality a
    /// <c>Role="dialog"</c> popup promises. The panel element becomes the
    /// <see cref="TmFocusScope"/> root (same top-layer popover element); Escape stays with
    /// overlay.js, which restores focus to the anchor on dismissal. Default false. Popover mode only.
    /// </summary>
    [Parameter] public bool TrapFocus { get; set; }

    /// <summary>
    /// The layout the panel presentation resolves from. <see cref="TmLayoutMode.Auto"/> follows the
    /// viewport scope; a forced value never measures, so a test can render a mode without a DOM.
    /// </summary>
    [Parameter] public TmLayoutMode LayoutMode { get; set; } = TmLayoutMode.Auto;

    /// <summary>The layout rendered before the first measurement. Desktop unless the host says otherwise.</summary>
    [Parameter] public TmLayoutMode InitialMode { get; set; } = TmLayoutMode.Desktop;

    /// <summary>
    /// Raised when the resolved layout changes. The initial value is not a change. Never pair
    /// <see cref="LayoutMode"/> with this callback: it reports the resolved mode, and a two-way bind
    /// would pin that mode.
    /// </summary>
    [Parameter] public EventCallback<TmLayoutMode> ResolvedLayoutChanged { get; set; }

    /// <summary>The viewport's layout. A panel presented as a sheet is positioned against the viewport.</summary>
    [CascadingParameter(Name = TmLayoutScopes.Viewport)] public TmLayoutContext? Viewport { get; set; }

    /// <summary>Panel content. Rendered only while the panel is open.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Additional CSS class(es) for the panel element — components pass their own panel class here.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Additional HTML attributes applied to the panel element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsVisible => IsOpen ?? _internalOpen;

    private TmLayoutContext Context => _layout.Resolve(LayoutMode, Viewport, InitialMode);

    private bool IsSheet => ResolvedPresentation == PanelPresentation.Sheet;

    private PanelPresentation ResolvedPresentation => MobilePresentation == PanelPresentation.Auto
        ? (Context.IsMobile ? PanelPresentation.Sheet : PanelPresentation.Popover)
        : MobilePresentation;

    private string? SheetTitle => !string.IsNullOrEmpty(Title) ? Title : AriaLabel;

    // Title names the sheet header AND the popover: without a fallback the popover rendered with
    // only Title carried no accessible name at all (N326 regression, review finding T4).
    // AriaLabelledBy still wins — a visible in-panel title outranks the sheet-header text.
    private string? EffectiveAriaLabel => AriaLabel ?? (AriaLabelledBy is null ? Title : null);

    private string SheetAriaLabel => SheetTitle ?? Loc["TmOverlayPanel_SheetFallback"];

    /// <summary>
    /// The content wrapper's <c>aria-labelledby</c>: the consumer's explicit id wins; otherwise the
    /// sheet header title names the wrapper (menu/listbox/dialog content inside the sheet is then
    /// labelled by the same visible title the user reads).
    /// </summary>
    private string? SheetContentLabelledBy => AriaLabelledBy ?? (SheetTitle is not null ? _sheetTitleId : null);

    /// <summary>
    /// Menus and listboxes opened as a sheet land initial focus on the first menuitem/option —
    /// the header Done is a fallback, not the starting point. Other roles keep the scope default.
    /// </summary>
    private string? SheetInitialFocusSelector => Role is "menu" or "listbox"
        ? ".tm-overlay-panel-sheet__content [role='menuitem'], .tm-overlay-panel-sheet__content [role='option']"
        : null;

    private ElementReference? SheetRestoreTarget => Anchor.Id is not null ? Anchor : null;

    /// <summary>
    /// The attributes of the popover panel root in trap-focus mode: the popover contract, the id
    /// and the consumer's splat all land on the focus-scope root.
    /// </summary>
    private Dictionary<string, object> TrapFocusAttributes
    {
        get
        {
            var attributes = new Dictionary<string, object>
            {
                ["popover"] = "manual",
                ["id"] = Id,
                ["data-testid"] = RootTestId("tm-overlay-panel"),
            };
            if (AdditionalAttributes is not null)
            {
                foreach (var pair in AdditionalAttributes)
                {
                    attributes[pair.Key] = pair.Value;
                }
            }
            return attributes;
        }
    }

    /// <summary>
    /// The internal viewport probe, opened from C# because a Razor tag binds only to public
    /// components (an internal tag compiles to a literal element under a suppressed RZ10012).
    /// </summary>
    private RenderFragment Probe => builder =>
    {
        builder.OpenComponent<ViewportProbe>(0);
        builder.AddComponentParameter(1, nameof(ViewportProbe.OnMeasured),
            EventCallback.Factory.Create<TmLayoutMode>(this, OnProbed));
        builder.CloseComponent();
    };

    /// <summary>Opens the panel (fires <see cref="IsOpenChanged"/> in controlled mode).</summary>
    public Task SetOpenAsync(bool open) => ApplyOpenAsync(open, dismissed: false, reason: null);

    /// <summary>Closes the panel (fires <see cref="IsOpenChanged"/> in controlled mode).</summary>
    public Task CloseAsync() => ApplyOpenAsync(false, dismissed: false, reason: null);

    /// <summary>
    /// Called by overlay.js when a dismissal gesture (Escape, outside pointerdown) or a native
    /// <c>hidePopover</c> closes the panel. Returns <see langword="true"/> when the dismissal was
    /// accepted — the panel is no longer visible — and <see langword="false"/> when the consumer
    /// vetoed it (a controlled <see cref="IsOpenChanged"/> handler that leaves
    /// <see cref="IsOpen"/> true, e.g. a form with unsaved changes). overlay.js uses the answer
    /// to re-arm a vetoed entry so the next Escape still dismisses it (N167).
    /// </summary>
    [JSInvokable]
    public async Task<bool> NotifyDismissedAsync(string reason)
    {
        await ApplyOpenAsync(false, dismissed: true, reason);
        return !IsVisible;
    }

    private async Task ApplyOpenAsync(bool open, bool dismissed, string? reason)
    {
        if (IsOpen.HasValue)
        {
            await IsOpenChanged.InvokeAsync(open);
        }
        else
        {
            _internalOpen = open;
        }

        if (dismissed && OnDismissed.HasDelegate)
        {
            await OnDismissed.InvokeAsync(reason);
        }

        // Uncontrolled mode mutates _internalOpen without a parent re-render, and the
        // JS-invoked dismissal path must marshal back onto the renderer either way.
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>A sheet close request from the drawer (Done, backdrop click, swipe).</summary>
    private Task HandleSheetOpenChanged(bool open) => open ? Task.CompletedTask : ApplyOpenAsync(false, dismissed: false, reason: null);

    /// <summary>
    /// Escape inside the sheet raises <see cref="OnDismissed"/> with <c>"escape"</c> — parity
    /// with the popover's keyboard dismissal. Done, the backdrop click and the swipe close
    /// through <see cref="HandleSheetOpenChanged"/> without a reason, like a programmatic close.
    /// </summary>
    private Task HandleSheetEscape() => CloseOnEscape
        ? ApplyOpenAsync(false, dismissed: true, reason: "escape")
        : Task.CompletedTask;

    /// <summary>The Done action closes the sheet without a selection, like Escape on the popover.</summary>
    private Task CloseSheetAsync() => ApplyOpenAsync(false, dismissed: false, reason: null);

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        await ReportResolved();
    }

    private Task OnProbed(TmLayoutMode mode)
    {
        _layout.Measured(mode);
        OverlayLayout.HintOnce(LayoutLogger);
        return ReportResolved();
    }

    private Task ReportResolved() => _layout.ReportAsync(
        Context.Resolved, mode => ResolvedLayoutChanged.InvokeAsync(mode));

    // Anchor.Id is part of the signature so swapping the anchor mid-open re-pushes it through
    // update() — a bare options signature would leave the panel tracking the old element.
    private string OptionsSignature() => string.Join('|',
        Anchor.Id ?? "-",
        Placement.ToString(), Align.ToString(), Offset, ViewportMargin,
        Flip, Shift, MatchAnchorWidth, ConstrainHeight, CloseOnEscape, CloseOnOutsidePointerDown);

    private object BuildOptions() => new
    {
        placement = Placement.ToString().ToLowerInvariant(),
        align = Align.ToString().ToLowerInvariant(),
        offset = Offset,
        margin = ViewportMargin,
        flip = Flip,
        shift = Shift,
        matchAnchorWidth = MatchAnchorWidth,
        constrainHeight = ConstrainHeight,
        closeOnEscape = CloseOnEscape,
        closeOnOutsidePointerDown = CloseOnOutsidePointerDown,
    };

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The WHOLE body runs under the semaphore: a second render that started while this one
        // was parked on the import await must re-read IsVisible/_jsOpen AFTER it, not act on the
        // snapshot it was dispatched with (N198).
        await _jsSync.WaitAsync();
        try
        {
            if (_disposed)
            {
                return;
            }

            if (IsVisible && !IsSheet)
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
                if (_disposed)
                {
                    // DisposeAsync ran while the import was in flight: it releases _module itself
                    // below — bail out without calling open() on a half-torn-down component.
                    return;
                }

                _dotNetRef ??= DotNetObjectReference.Create(this);

                // A default ElementReference cannot be serialized to JS — pass null and let
                // overlay.js fall back to the panel's previous element sibling.
                var anchor = Anchor.Id is not null ? Anchor : (ElementReference?)null;

                // In trap-focus mode the focus-scope root IS the panel element.
                var panel = TrapFocus ? _scope!.Element : _panelRef;

                var signature = OptionsSignature();
                if (!_jsOpen)
                {
                    _jsOpen = true;
                    _openOptionsSignature = signature;
                    await _module.InvokeVoidAsync("open", _key, panel, anchor, _dotNetRef, BuildOptions());
                    // m3: only now — showPopover() has run — is the panel actually displayed; a
                    // consumer focus move before this point lands on a display:none element and
                    // is dropped. The sheet's opening render ran in this batch too (the drawer
                    // is a child), so one flag covers both presentations.
                    _openedPending = true;
                    // Only now — showPopover() has run — may the trap activate and move initial
                    // focus. The extra render flips Active, the scope activates in its own
                    // OnAfterRenderAsync, and the focus move lands inside the visible popover.
                    if (TrapFocus && !_trapActive)
                    {
                        _trapActive = true;
                        await InvokeAsync(StateHasChanged);
                    }
                }
                else if (_openOptionsSignature != signature)
                {
                    _openOptionsSignature = signature;
                    await _module.InvokeVoidAsync("update", _key, anchor, BuildOptions());
                }
            }
            else if (IsVisible && IsSheet && !_openedFired)
            {
                // Sheet mode renders without the overlay.js open() call; the drawer's opening
                // render (a child, so its OnAfterRenderAsync STARTED before this one) is the point
                // the sheet is displayed — its promotion lands from that call, which may still be
                // in flight here. OnOpened therefore fires from THIS OnAfterRender, after the
                // opening render batch completed, not from the drawer's callback.
                _openedPending = true;
            }
            else if (_jsOpen && _module is not null)
            {
                // Release BY KEY, not by element reference: a closing panel can already be detached
                // by the time this runs and Blazor resolves an ElementReference through a document
                // query — a detached element resolves to null, so passing it would silently release
                // nothing and leave the entry (and the shared scroll listener) behind.
                _jsOpen = false;
                _openOptionsSignature = null;
                _trapActive = false;
                await _module.InvokeVoidAsync("close", _key);
            }

            if (_openedPending)
            {
                _openedPending = false;
                _openedFired = true;
                await OnOpened.InvokeAsync();
            }

            if (!IsVisible)
            {
                // Both presentations reset here: the popover close branch above and a sheet that
                // unmounted with the close — the next open must fire OnOpened again.
                _openedFired = false;
            }
        }
        finally
        {
            _jsSync.Release();
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        // Same lock: a render parked on the import await finishes first, and once it lets go it
        // has either completed its open() or seen _disposed — either way the module release here
        // cannot race it (N172).
        await _jsSync.WaitAsync();
        try
        {
            _disposed = true;
            try
            {
                if (_module is not null && _jsOpen)
                {
                    _jsOpen = false;
                    await _module.InvokeVoidAsync("close", _key);
                }
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException)
            {
                // Best-effort teardown: the circuit may be gone (JSDisconnectedException) or the
                // close call itself failed on a slow/stuck JS side (JSException,
                // TaskCanceledException). Either way the module must still be released below and
                // the failure must not escape DisposeAsync — a cleanup error during disposal is
                // not actionable by the renderer (N172).
            }
            finally
            {
                if (_module is not null)
                {
                    try
                    {
                        await _module.DisposeAsync();
                    }
                    catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException)
                    {
                    }
                }
            }
        }
        finally
        {
            _jsSync.Release();
            _dotNetRef?.Dispose();
            // _jsSync itself is deliberately NOT disposed — a SemaphoreSlim.Dispose() would fault
            // any WaitAsync still parked on it; the component instance is being collected anyway.
        }
    }
}
