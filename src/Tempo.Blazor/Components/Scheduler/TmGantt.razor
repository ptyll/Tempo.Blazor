@namespace Tempo.Blazor.Components.Scheduler
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Abstractions.Models
@using Tempo.Blazor.Abstractions.Shared
@using Tempo.Blazor.Models
@using Tempo.Blazor.Components.Actions
@using Tempo.Blazor.Components.DataDisplay
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Layout
@using Tempo.Blazor.Abstractions.Layout
@inject ITmLocalizer Loc

@* The Gantt measures its OWN container (F1): the observer is the outer element, the chart root sits inside it and is the
   CSS size container the descendants query. IsContainer=false: the observer root is a plain block that only reports a width. *@
<TmLayoutObserver LayoutMode="EffectiveLayoutMode" ResolvedLayoutChanged="OnResolvedLayoutChanged" IsContainer="false"
                  Style="display: flex; flex-direction: column; height: 100%; min-height: 0">
<LayoutContent Context="lay">
@{ ApplyLayout(lay.Resolved); NoteRenderPass(); }
<div class="tm-gantt @LayoutClass(lay) @GetThemeClass() @Class" data-layout="@lay.CssModifier" data-density="@DensityAttribute" data-theme="@GetDataTheme()" @attributes="AdditionalAttributes">

    @if (HasHeader)
    {
        <div class="tm-gantt__header" data-testid="@TestId("gantt-header")">
            @if (!string.IsNullOrEmpty(Title) || !string.IsNullOrEmpty(Subtitle))
            {
                <div class="tm-gantt__header-titles">
                    @if (!string.IsNullOrEmpty(Title))
                    {
                        <h2 class="tm-gantt__title">@Title</h2>
                    }
                    @if (!string.IsNullOrEmpty(Subtitle))
                    {
                        <p class="tm-gantt__subtitle">@Subtitle</p>
                    }
                </div>
            }
            @if (HeaderStart is not null)
            {
                <div class="tm-gantt__header-start">@HeaderStart</div>
            }
            @if (HeaderActions is not null)
            {
                <div class="tm-gantt__header-actions">@HeaderActions</div>
            }
        </div>
    }

    @* The panel tabs (SidebarMode=Tabs) hide with the rail on mobile (the panels live in the More sheet). *@
    @if (!IsMobileLayout)
    {
        <TmGanttPanelTabs Owner="this" />
    }

    @if (ShowToolbar)
    {
        <TmGanttToolbar Owner="this" />
    }

    <TmGanttFilterBar Owner="this" />

    @* Tablet: the long-press / dependency-dot instruction, shown on a coarse pointer only (CSS). *@
    @if (IsTabletLayout)
    {
        <p class="tm-gantt__touch-hint" data-testid="@TestId("gantt-touch-hint")">@Loc["TmGantt_TouchHint"]</p>
    }

    <!-- Content area: sidebar + views -->
    <div class="tm-gantt__content">

    @* The rail / tabs sidebar is a desktop and tablet affordance: on mobile the panels live in the More sheet. *@
    @if (!IsMobileLayout)
    {
        <TmGanttSidebar Owner="this" />
    }

    @{
        // The view area (alternate views, or the tree + timeline). A template, because the docked workload wraps it
        // in a column with the panel underneath - and the default placement must not add a wrapper element.
        RenderFragment viewArea = @<text>
    <!-- Phase 5: alternate views (Workload, Calendar, Board, Dashboard, People) -->
    @if (View == GanttView.Workload)
    {
        <TmGanttWorkloadView Tasks="Data" WorkingSchedule="WorkingSchedule"
                             DisplayMode="WorkloadDisplayMode"
                             LayoutMode="CurrentLayout"
                             Today="TodayInZone()" />
    }
    else if (View == GanttView.Calendar)
    {
        <div class="tm-gantt__calendar-view" data-testid="@TestId("gantt-calendar-view")">
            <div class="tm-gantt__calendar-inner">
                @{
                    var calEvents = Data.Select(t => new TmScheduleEvent
                    {
                        Id    = t.Id,
                        Title = t.Title,
                        Start = t.Start,
                        End   = t.End,
                        Color = t.Color,
                        AllDay = true
                    }).ToList();
                }
                <TmScheduler Events="@calEvents"
                             @bind-View="_calendarView"
                             @bind-CurrentDate="_calendarDate"
                             HideTimeGrid="true"
                             OnEventChanged="OnCalendarEventChangedAsync"
                             OnEventClick="OnCalendarEventClickAsync" />
            </div>
        </div>
    }
    else if (View == GanttView.Board)
    {
        @* No column Color: the header is the same status chip as the tree (tokens, light and dark), so the board holds no hex. *@
        var kanbanColumns = new[]
        {
            new KanbanColumn(nameof(TmWorkItemStatus.Open),       Loc[$"GanttStatus_{TmWorkItemStatus.Open}"]),
            new KanbanColumn(nameof(TmWorkItemStatus.InProgress),  Loc[$"GanttStatus_{TmWorkItemStatus.InProgress}"]),
            new KanbanColumn(nameof(TmWorkItemStatus.Done),        Loc[$"GanttStatus_{TmWorkItemStatus.Done}"]),
            new KanbanColumn(nameof(TmWorkItemStatus.Closed),      Loc[$"GanttStatus_{TmWorkItemStatus.Closed}"]),
        };
        <div class="tm-gantt__board-view" data-testid="@TestId("gantt-board-view")">
            <TmKanbanBoard TItem="TmWorkItem"
                           Columns="kanbanColumns"
                           Items="Data"
                           ColumnSelector="t => t.Status.ToString()"
                           OnItemMoved="OnBoardItemMovedAsync"
                           OnCardClick="SelectTaskAsync">
                <ColumnHeaderTemplate Context="col">
                    @if (Enum.TryParse<TmWorkItemStatus>(col.Id, out var columnStatus))
                    {
                        <TmGanttStatusChip Status="columnStatus" />
                    }
                    else
                    {
                        <span class="tm-kanban__header-title">@col.Title</span>
                    }
                    <span class="tm-kanban__count">@Data.Count(t => t.Status.ToString() == col.Id)</span>
                </ColumnHeaderTemplate>
                <CardTemplate Context="task">
                    @if (!string.IsNullOrEmpty(task.Color))
                    {
                        <div class="tm-gantt__board-card-accent" style="background:@task.Color"></div>
                    }
                    <div class="tm-gantt__board-card-title">@task.Title</div>
                    <div class="tm-gantt__board-card-meta">
                        <span class="tm-gantt__board-card-dates">@task.Start.ToString("dd.MM") – @task.End.ToString("dd.MM")</span>
                        @if (task.PercentComplete > 0)
                        {
                            <div class="tm-gantt__board-card-progress">
                                <div class="tm-gantt__board-card-progress-fill" style="width:@task.PercentComplete%"></div>
                            </div>
                        }
                    </div>
                </CardTemplate>
            </TmKanbanBoard>
        </div>
    }
    else if (View == GanttView.Dashboard)
    {
        <div class="tm-gantt__dashboard-view">
            <div class="tm-gantt__dashboard-widget" data-testid="@TestId("dashboard-widget-status")">
                <h4>@Loc["TmGantt_DashboardStatus"]</h4>
                @{ var byStatus = Data.GroupBy(t => t.Status).ToList(); }
                @foreach (var g in byStatus)
                {
                    <div class="tm-gantt__dashboard-stat">
                        <TmGanttStatusChip Status="g.Key" />
                        <strong>@g.Count()</strong>
                    </div>
                }
            </div>
            <div class="tm-gantt__dashboard-widget" data-testid="@TestId("dashboard-widget-time")">
                <h4>@Loc["TmGantt_DashboardTime"]</h4>
                @{ var totalLogged = Data.Sum(t => GanttHelper.CalculateTotalLoggedHours(t.TimeLog)); }
                <div class="tm-gantt__dashboard-stat"><strong>@totalLogged.ToString("F1")h</strong></div>
            </div>
            <div class="tm-gantt__dashboard-widget" data-testid="@TestId("dashboard-widget-milestones")">
                <h4>@Loc["TmGantt_DashboardMilestones"]</h4>
                @foreach (var m in Data.Where(t => t.IsMilestone))
                {
                    <div class="tm-gantt__dashboard-stat">
                        <span>@m.Title</span>
                        <small>@m.End.ToString("dd.MM.yyyy")</small>
                    </div>
                }
            </div>
            <div class="tm-gantt__dashboard-widget" data-testid="@TestId("dashboard-widget-budget")">
                <h4>@Loc["TmGantt_DashboardBudget"]</h4>
                @{ var totalBudget = Data.Sum(t => t.BudgetHours ?? 0); var totalCost = Data.Sum(t => t.ActualCost ?? 0); }
                <div class="tm-gantt__dashboard-stat"><span>@totalBudget.ToString("F0")h</span></div>
                <div class="tm-gantt__dashboard-stat"><span>@totalCost.ToString("C2")</span></div>
            </div>
        </div>
    }
    else if (View == GanttView.People)
    {
        <div class="tm-gantt__people-view" data-testid="@TestId("gantt-people-view")">
            @{
                var peopleIds = GetPeopleViewAssigneeIds();
                var tsStart = GanttHelper.GetTimeRange(Data).Item1;
                var tsEnd   = GanttHelper.GetTimeRange(Data).Item2;
                var ppd     = GetPixelPerDay();
            }
            @foreach (var assigneeId in peopleIds)
            {
                var assignee = Data.SelectMany(t => t.Assignees)
                                   .FirstOrDefault(a => a.Id == assigneeId);
                var displayName = assignee?.Name ?? assigneeId;
                var assigneeTasks = Data.Where(t => t.Assignees.Any(a => a.Id == assigneeId)).ToList();
                var calendar = ResourceCalendars.FirstOrDefault(c => c.AssigneeId == assigneeId);
                <div class="tm-gantt__people-row" data-testid="@($"people-row-{assigneeId}")">
                    <div class="tm-gantt__people-row-header">
                        @if (!string.IsNullOrEmpty(assignee?.AvatarUrl))
                        {
                            <span class="tm-gantt__bar-avatar" style="background-image: url('@assignee.AvatarUrl'); background-size: cover;" title="@displayName"></span>
                        }
                        else
                        {
                            <span class="tm-gantt__bar-avatar" style="@GetAvatarStyle(assignee ?? new TmWorkItemAssignee { Name = displayName })" title="@displayName">
                                @(string.IsNullOrEmpty(displayName) ? "?" : displayName[0].ToString().ToUpperInvariant())
                            </span>
                        }
                        <span class="tm-gantt__people-row-name">@displayName</span>
                    </div>
                    <div class="tm-gantt__people-row-timeline" style="width: @(F(_totalTimelineWidth))px; position: relative;">
                        @* Vacation overlays *@
                        @if (calendar is not null)
                        {
                            @foreach (var vac in calendar.VacationDays)
                            {
                                var vacLeft  = (vac.Start - tsStart).TotalDays * ppd;
                                var vacWidth = (vac.End   - vac.Start).TotalDays * ppd;
                                <div class="tm-gantt__resource-vacation"
                                     data-testid="@($"vacation-overlay-{assigneeId}-{vac.Start:yyyy-MM-dd}")"
                                     style="left: @(F(vacLeft))px; width: @(F(vacWidth))px"></div>
                            }
                        }
                        @* Task bars for this assignee *@
                        @foreach (var task in assigneeTasks)
                        {
                            var (bl, bw) = GanttHelper.CalculateBarPosition(task.Start, task.End, tsStart, tsEnd, _totalTimelineWidth);
                            <div class="tm-gantt__people-bar" data-testid="@($"people-bar-{assigneeId}-{task.Id}")"
                                 style="left: @(F(bl))px; width: @(F(bw))px">
                                @task.Title
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {

    <!-- Main area: Tree + Timeline (also List view: tree only) -->
    <div class="tm-gantt__main @(View == GanttView.List ? "tm-gantt__main--list-view" : "")"
         role="@(SidebarMode == GanttSidebarMode.Tabs ? "tabpanel" : null)"
         id="@(SidebarMode == GanttSidebarMode.Tabs ? PanelDomId(GanttSidebarPanel.Tasks) : null)"
         aria-labelledby="@(SidebarMode == GanttSidebarMode.Tabs ? TabDomId(GanttSidebarPanel.Tasks) : null)">
        <TmGanttTree Owner="this" />

        <!-- Right: Timeline (hidden in List view) -->
        @if (View != GanttView.List)
        {
            <TmGanttTimeline Owner="this" />
        } @* end @if (View != GanttView.List) *@
    </div>
    } @* end else (main area) *@        </text>;
    }

    @if (DockedWorkload)
    {
        @* The summary band rides inside the center column: under the chart, above the docked workload. *@
        <div class="tm-gantt__center">
            @viewArea
            <TmGanttSummaryBand Owner="this" />
            <div class="tm-gantt__docked-workload" data-testid="@TestId("gantt-workload-dock")">
                @{ var dockRange = GanttHelper.GetTimeRange(Data); }
                <TmGanttWorkloadView Tasks="Data" WorkingSchedule="WorkingSchedule"
                                     DisplayMode="WorkloadDisplayMode"
                                     DisplayModeChanged="OnWorkloadModeChangedAsync"
                                     LayoutMode="CurrentLayout"
                                     Today="TodayInZone()"
                                     Docked="true" RangeStart="dockRange.Start" RangeEnd="dockRange.End" />
            </div>
        </div>
    }
    else { @viewArea }

    @* One right-hand surface at a time: the Reports inspector takes the place of the task panel while it is open.
       On a narrower container (TaskPanelMode Auto) or with Overlay the surface is a core TmSidePanel side sheet —
       the SHEETS render as siblings of the chart root (a size container confines fixed descendants). *@
    @{
        RenderFragment reportsPanel = @<TmGanttReportsPanel Reports="Reports" @attributes="ReportsPanelAttributes" OnReportRun="OnReportRun"
                                                            OnReportEdit="OnReportEdit" OnReportDelete="OnReportDelete"
                                                            OnReportDuplicate="OnReportDuplicate" OnNewReportRequested="OnNewReportRequested" />;
        // The mobile reports sheet is run-only: editing, duplicating, deleting and creating a report are tablet+.
        RenderFragment mobileReportsPanel = @<TmGanttReportsPanel Reports="Reports" @attributes="ReportsPanelAttributes" OnReportRun="OnReportRun" />;
        RenderFragment taskPanel = @<TmGanttTaskPanel @ref="_taskPanel" Task="SelectedTask" Tabbed="PanelsAsSheets" History="History" TimeZone="@DisplayZone"
                                                      AllTasks="Data" Dependencies="Dependencies" Breadcrumb="TaskBreadcrumb" MobileReadOnly="IsMobileLayout"
                                                      CanMoveUp="CanMoveSelected(-1)" CanMoveDown="CanMoveSelected(1)"
                                                      OnTaskUpdated="OnTaskUpdated" OnDependencyAdded="OnDependencyAdded" OnDependencyRemoved="OnDependencyRemoved"
                                                      OnCommentAdded="HandleTaskCommentAddedAsync" ActiveTimerTaskId="@ActiveTimerTaskId"
                                                      OnTimerStarted="OnTimerStarted" OnTimerStopped="OnTimerStopped" OnDescriptionChanged="OnDescriptionChanged"
                                                      OnAttachmentUpload="OnAttachmentUpload" OnAttachmentRemoved="OnAttachmentRemoved"
                                                      OnStatusChanged="OnTaskPanelStatusChangedAsync" OnAction="OnTaskPanelActionAsync"
                                                      IsOverloaded="SelectedTaskOverloaded" BaselineTask="SelectedTaskBaseline"
                                                      OnClose="@(PanelsAsSheets ? default : EventCallback.Factory.Create(this, () => SetTaskPanelOpen(false)))" />;
    }
    @if (ReportsPanelOpen && !PanelsAsSheets) { @reportsPanel }
    else if (_taskPanelOpen && !PanelsAsSheets) { @taskPanel }
</div> @* tm-gantt__content *@

@* The summary band (not docked): a child of .tm-gantt under the content; the part renders only for the chart views. *@
@if (!DockedWorkload) { <TmGanttSummaryBand Owner="this" /> }

    <!-- History Drawer (on the mobile container the read-only sheet of TmGanttMobileOverlays replaces it) -->
    @if (_historyDrawerOpen && !IsMobileLayout)
    {
        <TmGanttHistoryDrawer History="History" Tasks="Data" IsOpen="_historyDrawerOpen" Placement="HistoryDrawerPlacement"
                              OnTaskSelected="OpenTaskByIdAsync" TimeZone="@(_userZone?.Zone ?? Clock.LocalTimeZone)" OnClose="ToggleHistoryDrawer"
                              OnTimeTravelRequested="OnTimeTravelRequested" OnRollbackRequested="OnRollbackRequested" />
    }

</div>
@* Polite live region: a keyboard / menu reorder is announced here (WCAG 4.1.3). Always rendered (a region inserted together with its text is often not announced) and a sibling of the chart root, so the chart's own children stay as they were. *@
<div class="tm-sr-only" role="status" aria-live="polite" data-testid="@TestId("gantt-announcer")">@_announcement</div>

@* The mobile action bar (F5): a SIBLING of the chart root (the chart is overflow:hidden, and an
   overflow:hidden ancestor is the scrollport a sticky element sticks in — it could never pin inside). *@
@if (IsMobileLayout && ShowToolbar)
{
    <TmMobileActionBar Class="tm-gantt__mobile-bar" Placement="ActionBarPlacement.StickyContainer"
                       LayoutMode="TmLayoutMode.Mobile" MaxVisible="4" Items="MobileActionItems" TestIdPrefix="@TestIdPrefix" AriaLabel="@Loc["TmGantt_Toolbar"]" />
}

@* ── Overlays — SIBLINGS of .tm-gantt, never descendants: the chart root is a CSS size container
   (`container-type: inline-size`) and therefore the containing block of every fixed-position descendant,
   which would confine and clip them. They render here, inside the observer's LayoutContent. *@
@if (ReportsPanelOpen && PanelsAsSheets)
{
    @* The mobile reports sheet restores the focus to the More tile it came from (tablet keeps the default). *@
    <TmSidePanel Presentation="SidePanelPresentation.Sheet" Open="true" OpenChanged="HandleReportsSheetOpenChanged"
                 Title="@Loc["TmGantt_Reports"]" Width="@SheetWidth" Class="tm-gantt__sheet" DataTestId="@TestId("gantt-reports-sheet")"
                 RestoreFocusTargetId="@(IsMobileLayout ? TestId("gantt-mobile-more") : null)" LayoutMode="@(IsMobileLayout ? TmLayoutMode.Mobile : TmLayoutMode.Auto)">
        @(IsMobileLayout ? mobileReportsPanel : reportsPanel)
    </TmSidePanel>
}
else if (_taskPanelOpen && PanelsAsSheets && SelectedTask is not null)
{
    <TmSidePanel Presentation="SidePanelPresentation.Sheet" Open="true" OpenChanged="HandleTaskSheetOpenChanged"
                 Title="@SelectedTask.Title" Width="@SheetWidth" Class="tm-gantt__sheet" DataTestId="@TestId("gantt-task-sheet")"
                 LayoutMode="@(IsMobileLayout ? TmLayoutMode.Mobile : TmLayoutMode.Auto)"
                 FooterContent="@(IsMobileLayout ? MobileTaskSheetFooter : default(RenderFragment))">@taskPanel</TmSidePanel>
}

@* ── Mobile sheets + the limited long-press menu (read-mostly): a sibling part in the same overlay area. *@
<TmGanttMobileOverlays Owner="this" />

@if (_exportDialogOpen)
{
    <TmGanttExportDialog IsOpen="_exportDialogOpen" OnExport="HandleExportAsync" OnClose="CloseExportDialog"
                         PreviewTasks="@VisiblePreviewTasks"
                         PreviewDependencies="@VisiblePreviewDependencies"
                         PreviewCriticalPathIds="@PreviewCriticalPathIds" />
}

@if (_importDialogOpen)
{
    <TmGanttImportDialog IsOpen="_importDialogOpen" OnImportCompleted="HandleImportCompletedAsync"
                         OnImportResultCompleted="HandleImportResultCompletedAsync"
                         OnImportError="HandleImportErrorAsync" OnClose="CloseImportDialog" />
}

<!-- Filter Dialog (FilterPanelMode Dialog / Auto on a narrow container): always mounted, the TmModal toggles with Show,
     which lets it restore the focus to the trigger when it closes (a modal unmounted while open cannot). -->
@if (FilterPanelAsDialog)
{
    <TmGanttFilterPanel AsDialog="true"
                        Show="_filterPanelOpen"
                        DataTestId="@TestId("gantt-filter-panel")"
                        Filters="ActiveFiltersSnapshot()"
                        OnFiltersChanged="async filters => await ApplyFiltersAsync(filters)"
                        OnClose="CloseFilterPanel" />
}

@* The task panel's Delete asks first; rendered only while a delete is pending (the default markup is unchanged). *@
@if (_pendingDelete is not null)
{
    <TmDialog Show="true" Type="DialogType.Confirm" Variant="DialogVariant.Warning" IsDangerous="true"
              Title="@Loc["TmGantt_DeleteConfirmTitle"]"
              Message="@Loc["TmGantt_DeleteConfirmMessage", _pendingDelete.Title]"
              OkButtonText="@Loc["TmGantt_DeleteTask"]"
              OnResult="ConfirmDeleteAsync" />
}

@* Closing over a dirty draft keeps the sheet open and asks first: Discard closes it, Keep editing returns. *@
@if (_discardPromptOpen)
{
    <TmDialog Show="true" Type="DialogType.Confirm" Variant="DialogVariant.Warning"
              Title="@Loc["TmGantt_DiscardChangesTitle"]"
              Message="@Loc["TmGantt_DiscardChangesMessage"]"
              OkButtonText="@Loc["TmGantt_DiscardChangesDiscard"]"
              CancelButtonText="@Loc["TmGantt_DiscardChangesKeep"]"
              OnResult="ConfirmDiscardAsync" />
}

<!-- Context Menu (desktop / tablet; the read-mostly long-press menu of the mobile container is the TmGanttMobileOverlays part) -->
@if (_contextMenuVisible && _contextMenuTask is not null && !IsMobileLayout)
{
    @* The read-mostly long-press menu (Status / Percent / Add task only) is the TmGanttMobileOverlays part. *@
    <div class="tm-gantt__context-menu-overlay" @onclick="HideContextMenuFromOverlay">
        <div class="tm-gantt__context-menu"
             style="left: min(@(F(_contextMenuX))px, calc(100% - 13rem)); top: min(@(F(_contextMenuY))px, calc(100% - 20rem));"
             @onclick:stopPropagation>
            <button type="button" class="tm-gantt__context-menu-item"
                    @onclick="() => InsertTaskAsync(GanttInsertPosition.Above)">
                <TmIcon Name="arrow-up" Size="IconSize.Sm" />
                <span>@Loc["TmGantt_AddTaskAbove"]</span>
            </button>
            <button type="button" class="tm-gantt__context-menu-item"
                    @onclick="() => InsertTaskAsync(GanttInsertPosition.Below)">
                <TmIcon Name="arrow-down" Size="IconSize.Sm" />
                <span>@Loc["TmGantt_AddTaskBelow"]</span>
            </button>
            <button type="button" class="tm-gantt__context-menu-item"
                    @onclick="() => InsertTaskAsync(GanttInsertPosition.Child)">
                <TmIcon Name="corner-down-right" Size="IconSize.Sm" />
                <span>@Loc["TmGantt_AddTaskChild"]</span>
            </button>
            @if (ViewSettings.ShowAdvancedContextButtons)
            {
                <div class="tm-gantt__context-menu-divider"></div>
                <button type="button" class="tm-gantt__context-menu-item"
                        @onclick="DuplicateContextTaskAsync">
                    <TmIcon Name="copy" Size="IconSize.Sm" />
                    <span>@Loc["TmGantt_DuplicateTask"]</span>
                </button>
            }
            <div class="tm-gantt__context-menu-divider"></div>
            <button type="button" class="tm-gantt__context-menu-item" data-testid="@TestId("gantt-context-move-up")"
                    disabled="@(!CanMoveContextTask(-1))" @onclick="() => MoveContextTaskAsync(-1)">
                <TmIcon Name="chevron-up" Size="IconSize.Sm" />
                <span>@Loc["TmGantt_MoveUp"]</span>
            </button>
            <button type="button" class="tm-gantt__context-menu-item" data-testid="@TestId("gantt-context-move-down")"
                    disabled="@(!CanMoveContextTask(1))" @onclick="() => MoveContextTaskAsync(1)">
                <TmIcon Name="chevron-down" Size="IconSize.Sm" />
                <span>@Loc["TmGantt_MoveDown"]</span>
            </button>
            <div class="tm-gantt__context-menu-divider"></div>
            <button type="button" class="tm-gantt__context-menu-item tm-gantt__context-menu-item--danger"
                    @onclick="DeleteTaskAsync">
                <TmIcon Name="trash-2" Size="IconSize.Sm" />
                <span>@Loc["TmGantt_DeleteTask"]</span>
            </button>
        </div>
    </div>
}
</LayoutContent>
</TmLayoutObserver>

@code {
    /// <summary>The sticky footer of the mobile task sheet: Cancel | Save. Cancel routes through the sheet's close
    /// guard, so a dirty draft asks first; Save commits the two editable fields through the panel.</summary>
    private RenderFragment? MobileTaskSheetFooter => IsMobileLayout ? @<div class="tm-gantt__sheet-footer">
        <TmButton Variant="ButtonVariant.Ghost" data-testid="@TestId("task-mobile-cancel")"
                  OnClick="@(() => HandleTaskSheetOpenChanged(false))">@Loc["TmGanttTaskPanel_Cancel"]</TmButton>
        <TmButton Variant="ButtonVariant.Primary" data-testid="@TestId("task-mobile-save")"
                  OnClick="@(() => _taskPanel?.SaveAsync())">@Loc["TmGanttTaskPanel_Save"]</TmButton>
    </div> : null;
}
