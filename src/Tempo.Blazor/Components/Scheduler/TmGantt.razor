@namespace Tempo.Blazor.Components.Scheduler
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Abstractions.Models
@using Tempo.Blazor.Abstractions.Shared
@using Tempo.Blazor.Models
@using Tempo.Blazor.Components.DataDisplay
@inject ITmLocalizer Loc

<div class="tm-gantt @GetThemeClass() @Class" @attributes="AdditionalAttributes">

    <!-- Toolbar -->
    <div class="tm-gantt__toolbar">
        <div class="tm-gantt__toolbar-group">
            <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Primary" OnClick="AddTaskAsync" Title="@Loc["TmGantt_AddTask"]" data-testid="@TestId("gantt-add-task")">
                <TmIcon Name="plus" />
            </TmButton>
            <span class="tm-gantt__toolbar-divider"></span>
            <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="ExpandAllAsync" Title="@Loc["TmGantt_ExpandAll"]" data-testid="@TestId("gantt-expand-all")">
                <TmIcon Name="chevrons-down" Size="IconSize.Sm" />
            </TmButton>
            <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="CollapseAllAsync" Title="@Loc["TmGantt_CollapseAll"]" data-testid="@TestId("gantt-collapse-all")">
                <TmIcon Name="chevrons-up" Size="IconSize.Sm" />
            </TmButton>
            <span class="tm-gantt__toolbar-divider"></span>
            <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => SetViewAsync(GanttView.Day)">
                @Loc["TmGantt_DayView"]
            </TmButton>
            <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => SetViewAsync(GanttView.Week)">
                @Loc["TmGantt_WeekView"]
            </TmButton>
            <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => SetViewAsync(GanttView.Month)">
                @Loc["TmGantt_MonthView"]
            </TmButton>
        </div>
        <div class="tm-gantt__toolbar-group">
            <!-- Cascade sort -->
            <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="CascadeSortAsync"
                      Title="@Loc["TmGantt_CascadeSort"]" data-testid="@TestId("gantt-cascade-sort")">
                <TmIcon Name="list-ordered" Size="IconSize.Sm" />
            </TmButton>
            <span class="tm-gantt__toolbar-divider"></span>
            <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="FitToScreenAsync" Title="@Loc["TmGantt_FitToScreen"]">
                <TmIcon Name="maximize-2" />
            </TmButton>
            <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="ZoomOutAsync" data-testid="@TestId("gantt-zoom-out")">
                <TmIcon Name="zoom-out" />
            </TmButton>
            <!-- Zoom slider -->
            <input type="range" class="tm-gantt__zoom-slider" data-testid="@TestId("gantt-zoom-slider")"
                   min="50" max="200" step="25" value="@_zoomLevel"
                   @onchange="e => { _zoomLevel = int.Parse(e.Value!.ToString()!); RefreshVisibleData(); }" />
            <span class="tm-gantt__zoom-level">@(_zoomLevel)%</span>
            <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="ZoomInAsync" data-testid="@TestId("gantt-zoom-in")">
                <TmIcon Name="zoom-in" />
            </TmButton>
            <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => ShowTaskPanel = !ShowTaskPanel" Title="@Loc["TmGantt_ToggleTaskPanel"]">
                <TmIcon Name="edit" />
            </TmButton>
            <!-- Filter button -->
            <TmButton Size="ButtonSize.Sm" Variant="@(_filterPanelOpen ? ButtonVariant.Primary : ButtonVariant.Ghost)"
                      OnClick="ToggleFilterPanel" Title="@Loc["TmGantt_Filter"]"
                      data-testid="@TestId("gantt-filter-btn")">
                <TmIcon Name="filter" Size="IconSize.Sm" />
            </TmButton>
            <!-- Export button -->
            <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                      OnClick="ToggleExportDialog" Title="@Loc["TmGantt_Export"]"
                      data-testid="@TestId("gantt-export-btn")">
                <TmIcon Name="download" Size="IconSize.Sm" />
            </TmButton>
            <!-- Import button -->
            <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                      OnClick="ToggleImportDialog" Title="@Loc["TmGantt_Import"]"
                      data-testid="@TestId("gantt-import-btn")">
                <TmIcon Name="upload" Size="IconSize.Sm" />
            </TmButton>
            <!-- History button -->
            <TmButton Size="ButtonSize.Sm" Variant="@(_historyDrawerOpen ? ButtonVariant.Primary : ButtonVariant.Ghost)"
                      OnClick="ToggleHistoryDrawer" Title="@Loc["TmGantt_History"]"
                      data-testid="@TestId("gantt-history-btn")">
                <TmIcon Name="clock" Size="IconSize.Sm" />
            </TmButton>
            <!-- View Settings -->
            <div class="tm-gantt__view-settings-wrapper">
                <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="ToggleViewSettings" Title="@Loc["TmGantt_ViewSettings"]" data-testid="@TestId("gantt-view-settings-btn")">
                    <TmIcon Name="settings" Size="IconSize.Sm" />
                </TmButton>
                @if (_viewSettingsOpen)
                {
                    <div class="tm-gantt__view-settings-overlay" @onclick="ToggleViewSettings"></div>
                    <div class="tm-gantt__view-settings-menu" @onclick:stopPropagation>
                        <label class="tm-gantt__view-settings-item">
                            <input type="checkbox" data-testid="@TestId("vset-show-today")"
                                   checked="@ViewSettings.ShowTodayMarker"
                                   @onchange="e => SetShowTodayMarker((bool)e.Value!)" />
                            <span>@Loc["TmGantt_ShowTodayMarker"]</span>
                        </label>
                        <label class="tm-gantt__view-settings-item">
                            <input type="checkbox" data-testid="@TestId("vset-show-daysoff")"
                                   checked="@ViewSettings.ShowDaysOff"
                                   @onchange="e => SetShowDaysOff((bool)e.Value!)" />
                            <span>@Loc["TmGantt_ShowDaysOff"]</span>
                        </label>
                        <label class="tm-gantt__view-settings-item">
                            <input type="checkbox" data-testid="@TestId("vset-show-closed")"
                                   checked="@ViewSettings.ShowClosedTasks"
                                   @onchange="e => SetShowClosedTasks((bool)e.Value!)" />
                            <span>@Loc["TmGantt_ShowClosedTasks"]</span>
                        </label>
                        <div class="tm-gantt__view-settings-divider"></div>
                        <div class="tm-gantt__view-settings-label">@Loc["TmGantt_TaskNameLocation"]</div>
                        <label class="tm-gantt__view-settings-item">
                            <input type="radio" name="taskloc-@GetHashCode()" value="InsideBar"
                                   checked="@(ViewSettings.TaskNameLocation == GanttTaskNameLocation.InsideBar)"
                                   @onchange="() => SetTaskNameLocation(GanttTaskNameLocation.InsideBar)" />
                            <span>@Loc["TmGantt_TaskNameInside"]</span>
                        </label>
                        <label class="tm-gantt__view-settings-item">
                            <input type="radio" name="taskloc-@GetHashCode()" value="NextToBar"
                                   checked="@(ViewSettings.TaskNameLocation == GanttTaskNameLocation.NextToBar)"
                                   @onchange="() => SetTaskNameLocation(GanttTaskNameLocation.NextToBar)" />
                            <span>@Loc["TmGantt_TaskNameBeside"]</span>
                        </label>
                        <label class="tm-gantt__view-settings-item">
                            <input type="radio" name="taskloc-@GetHashCode()" value="Hidden"
                                   checked="@(ViewSettings.TaskNameLocation == GanttTaskNameLocation.Hidden)"
                                   @onchange="() => SetTaskNameLocation(GanttTaskNameLocation.Hidden)" />
                            <span>@Loc["TmGantt_TaskNameHidden"]</span>
                        </label>
                        <div class="tm-gantt__view-settings-divider"></div>
                        <div class="tm-gantt__view-settings-label">@Loc["TmGantt_ViewDensity"]</div>
                        <label class="tm-gantt__view-settings-item">
                            <input type="radio" name="density-@GetHashCode()" value="Comfortable"
                                   checked="@(ViewSettings.ViewDensity == GanttViewDensity.Comfortable)"
                                   @onchange="() => SetViewDensity(GanttViewDensity.Comfortable)" />
                            <span>@Loc["TmGantt_ViewComfortable"]</span>
                        </label>
                        <label class="tm-gantt__view-settings-item">
                            <input type="radio" name="density-@GetHashCode()" value="Compact"
                                   checked="@(ViewSettings.ViewDensity == GanttViewDensity.Compact)"
                                   @onchange="() => SetViewDensity(GanttViewDensity.Compact)" />
                            <span>@Loc["TmGantt_ViewCompact"]</span>
                        </label>
                        <div class="tm-gantt__view-settings-divider"></div>
                        <div class="tm-gantt__view-settings-label">@Loc["TmGantt_Theme"]</div>
                        <label class="tm-gantt__view-settings-item">
                            <input type="radio" name="theme-@GetHashCode()" value="Auto"
                                   checked="@(ViewSettings.Theme == GanttTheme.Auto)"
                                   @onchange="() => SetTheme(GanttTheme.Auto)" />
                            <span>@Loc["TmGantt_ThemeAuto"]</span>
                        </label>
                        <label class="tm-gantt__view-settings-item">
                            <input type="radio" name="theme-@GetHashCode()" value="Light"
                                   checked="@(ViewSettings.Theme == GanttTheme.Light)"
                                   @onchange="() => SetTheme(GanttTheme.Light)" />
                            <span>@Loc["TmGantt_ThemeLight"]</span>
                        </label>
                        <label class="tm-gantt__view-settings-item">
                            <input type="radio" name="theme-@GetHashCode()" value="Dark"
                                   checked="@(ViewSettings.Theme == GanttTheme.Dark)"
                                   @onchange="() => SetTheme(GanttTheme.Dark)" />
                            <span>@Loc["TmGantt_ThemeDark"]</span>
                        </label>
                    </div>
                }

                @if (NotificationSettings is not null)
                {
                    <div class="tm-gantt__view-settings-divider"></div>
                    <div class="tm-gantt__view-settings-label">@Loc["TmGantt_Notifications"]</div>
                    <div class="tm-gantt__notification-settings" data-testid="@TestId("notification-settings-section")">
                        <label class="tm-gantt__view-settings-item">
                            <input type="checkbox"
                                   checked="@NotificationSettings.EmailOnAssign"
                                   @onchange="e => UpdateNotification(s => s.EmailOnAssign = (bool)(e.Value ?? false))" />
                            <span>@Loc["TmGantt_NotifyOnAssignEmail"]</span>
                        </label>
                        <label class="tm-gantt__view-settings-item">
                            <input type="checkbox"
                                   checked="@NotificationSettings.EmailOnMention"
                                   @onchange="e => UpdateNotification(s => s.EmailOnMention = (bool)(e.Value ?? false))" />
                            <span>@Loc["TmGantt_NotifyOnMentionEmail"]</span>
                        </label>
                        <label class="tm-gantt__view-settings-item">
                            <input type="checkbox"
                                   checked="@NotificationSettings.PushOnAssign"
                                   @onchange="e => UpdateNotification(s => s.PushOnAssign = (bool)(e.Value ?? false))" />
                            <span>@Loc["TmGantt_NotifyOnAssignPush"]</span>
                        </label>
                        <label class="tm-gantt__view-settings-item">
                            <input type="checkbox"
                                   checked="@NotificationSettings.PushOnMention"
                                   @onchange="e => UpdateNotification(s => s.PushOnMention = (bool)(e.Value ?? false))" />
                            <span>@Loc["TmGantt_NotifyOnMentionPush"]</span>
                        </label>
                        <label class="tm-gantt__view-settings-item">
                            <input type="checkbox"
                                   checked="@NotificationSettings.PushOnDeadline"
                                   @onchange="e => UpdateNotification(s => s.PushOnDeadline = (bool)(e.Value ?? false))" />
                            <span>@Loc["TmGantt_NotifyOnDeadlinePush"]</span>
                        </label>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Filter Panel -->
    @if (_filterPanelOpen)
    {
        <div class="tm-gantt__filter-panel" data-testid="@TestId("gantt-filter-panel")">
            <TmGanttFilterPanel
                Filters="_activeFilters.ToList()"
                OnFiltersChanged="async filters => await ApplyFiltersAsync(filters)"
                OnClose="ToggleFilterPanel" />
        </div>
    }

    <!-- Content area: sidebar + views -->
    <div class="tm-gantt__content">

    @if (ShowSidebar)
    {
        <nav class="tm-gantt__sidebar" data-testid="@TestId("gantt-sidebar")">
            <button type="button" class="tm-gantt__sidebar-btn @(_activeSidebarPanel == GanttSidebarPanel.Tasks ? "tm-gantt__sidebar-btn--active" : "")"
                    data-testid="@TestId("sidebar-btn-tasks")"
                    title="@Loc["TmGantt_SidebarTasks"]"
                    @onclick="() => ToggleSidebarPanel(GanttSidebarPanel.Tasks)">
                <TmIcon Name="list" Size="IconSize.Sm" />
            </button>
            <button type="button" class="tm-gantt__sidebar-btn @(_activeSidebarPanel == GanttSidebarPanel.Workload ? "tm-gantt__sidebar-btn--active" : "")"
                    data-testid="@TestId("sidebar-btn-workload")"
                    title="@Loc["TmGantt_SidebarWorkload"]"
                    @onclick="() => ToggleSidebarPanel(GanttSidebarPanel.Workload)">
                <TmIcon Name="users" Size="IconSize.Sm" />
            </button>
            <button type="button" class="tm-gantt__sidebar-btn @(_activeSidebarPanel == GanttSidebarPanel.History ? "tm-gantt__sidebar-btn--active" : "")"
                    data-testid="@TestId("sidebar-btn-history")"
                    title="@Loc["TmGantt_SidebarHistory"]"
                    @onclick="() => ToggleSidebarPanel(GanttSidebarPanel.History)">
                <TmIcon Name="clock" Size="IconSize.Sm" />
            </button>
            <button type="button" class="tm-gantt__sidebar-btn @(_activeSidebarPanel == GanttSidebarPanel.Notifications ? "tm-gantt__sidebar-btn--active" : "")"
                    data-testid="@TestId("sidebar-btn-notifications")"
                    title="@Loc["TmGantt_SidebarNotifications"]"
                    @onclick="() => ToggleSidebarPanel(GanttSidebarPanel.Notifications)">
                <TmIcon Name="bell" Size="IconSize.Sm" />
            </button>
            <button type="button" class="tm-gantt__sidebar-btn @(_activeSidebarPanel == GanttSidebarPanel.Reports ? "tm-gantt__sidebar-btn--active" : "")"
                    data-testid="@TestId("sidebar-btn-reports")"
                    title="@Loc["TmGantt_SidebarReports"]"
                    @onclick="() => ToggleSidebarPanel(GanttSidebarPanel.Reports)">
                <TmIcon Name="bar-chart-2" Size="IconSize.Sm" />
            </button>
        </nav>
    }

    <!-- Sidebar drawers -->
    @if (_activeSidebarPanel == GanttSidebarPanel.Reports)
    {
        <TmGanttReportsPanel Reports="Reports"
                             OnReportRun="OnReportRun" />
    }
    else if (_activeSidebarPanel == GanttSidebarPanel.Tasks)
    {
        <div class="tm-gantt__sidebar-drawer" data-testid="@TestId("sidebar-panel-tasks")">
            <div class="tm-gantt__sidebar-drawer-header">
                <span class="tm-gantt__sidebar-drawer-title">@Loc["TmGantt_SidebarTasks"]</span>
            </div>
            <div class="tm-gantt__sidebar-drawer-body">
                @foreach (var task in Data)
                {
                    <div class="tm-gantt__sidebar-task-row @(task.Status == TmWorkItemStatus.Done || task.Status == TmWorkItemStatus.Closed ? "tm-gantt__sidebar-task-row--done" : "")">
                        <span class="tm-gantt__sidebar-task-dot" style="background: @(task.Color ?? "var(--tm-color-primary)")"></span>
                        <span class="tm-gantt__sidebar-task-title">@task.Title</span>
                        <span class="tm-gantt__sidebar-task-pct">@task.PercentComplete%</span>
                    </div>
                }
            </div>
        </div>
    }
    else if (_activeSidebarPanel == GanttSidebarPanel.Workload)
    {
        <div class="tm-gantt__sidebar-drawer" data-testid="@TestId("sidebar-panel-workload")">
            <div class="tm-gantt__sidebar-drawer-header">
                <span class="tm-gantt__sidebar-drawer-title">@Loc["TmGantt_SidebarWorkload"]</span>
            </div>
            <div class="tm-gantt__sidebar-drawer-body">
                @{
                    var wlEntries = WorkloadCalculator.Calculate(Data, WorkingSchedule);
                    var wlAssignees = wlEntries.Select(e => e.AssigneeId).Distinct().OrderBy(x => x).ToList();
                }
                @foreach (var aId in wlAssignees)
                {
                    var total = wlEntries.Where(e => e.AssigneeId == aId).Sum(e => e.AllocatedHours);
                    var capacity = wlEntries.Where(e => e.AssigneeId == aId).Sum(e => e.CapacityHours);
                    var name = Data.SelectMany(t => t.Assignees).FirstOrDefault(a => a.Id == aId)?.Name ?? aId;
                    var pct = capacity > 0 ? (int)(total / capacity * 100) : 0;
                    var over = total > capacity;
                    <div class="tm-gantt__sidebar-workload-row">
                        <span class="tm-gantt__sidebar-workload-name">@name</span>
                        <div class="tm-gantt__sidebar-workload-bar-wrap">
                            <div class="tm-gantt__sidebar-workload-bar @(over ? "tm-gantt__sidebar-workload-bar--over" : "")"
                                 style="width: @(Math.Min(pct, 100))%"></div>
                        </div>
                        <span class="tm-gantt__sidebar-workload-pct @(over ? "tm-gantt__sidebar-workload-pct--over" : "")">@pct%</span>
                    </div>
                }
            </div>
        </div>
    }
    else if (_activeSidebarPanel == GanttSidebarPanel.History)
    {
        <div class="tm-gantt__sidebar-drawer" data-testid="@TestId("sidebar-panel-history")">
            <div class="tm-gantt__sidebar-drawer-header">
                <span class="tm-gantt__sidebar-drawer-title">@Loc["TmGantt_SidebarHistory"]</span>
            </div>
            <div class="tm-gantt__sidebar-drawer-body">
                @if (!History.Any())
                {
                    <div class="tm-gantt__sidebar-empty">@Loc["TmGantt_HistoryEmpty"]</div>
                }
                @foreach (var entry in History.OrderByDescending(h => h.Timestamp).Take(50))
                {
                    <div class="tm-gantt__sidebar-history-row">
                        <span class="tm-gantt__sidebar-history-action">@entry.Action</span>
                        <span class="tm-gantt__sidebar-history-task">@(Data.FirstOrDefault(t => t.Id == entry.EntityRef.EntityId)?.Title ?? entry.EntityRef.EntityId)</span>
                        <span class="tm-gantt__sidebar-history-date">@entry.Timestamp.ToLocalTime().ToString("dd.MM HH:mm")</span>
                    </div>
                }
            </div>
        </div>
    }
    else if (_activeSidebarPanel == GanttSidebarPanel.Notifications && NotificationSettings is not null)
    {
        <div class="tm-gantt__sidebar-drawer" data-testid="@TestId("sidebar-panel-notifications")">
            <div class="tm-gantt__sidebar-drawer-header">
                <span class="tm-gantt__sidebar-drawer-title">@Loc["TmGantt_SidebarNotifications"]</span>
            </div>
            <div class="tm-gantt__sidebar-drawer-body">
                <div class="tm-gantt__notification-settings" data-testid="@TestId("notification-settings-section")">
                    <label class="tm-gantt__view-settings-item">
                        <input type="checkbox" checked="@NotificationSettings.EmailOnAssign"
                               @onchange="e => UpdateNotification(s => s.EmailOnAssign = (bool)(e.Value ?? false))" />
                        <span>@Loc["TmGantt_NotifyOnAssignEmail"]</span>
                    </label>
                    <label class="tm-gantt__view-settings-item">
                        <input type="checkbox" checked="@NotificationSettings.EmailOnMention"
                               @onchange="e => UpdateNotification(s => s.EmailOnMention = (bool)(e.Value ?? false))" />
                        <span>@Loc["TmGantt_NotifyOnMentionEmail"]</span>
                    </label>
                    <label class="tm-gantt__view-settings-item">
                        <input type="checkbox" checked="@NotificationSettings.PushOnAssign"
                               @onchange="e => UpdateNotification(s => s.PushOnAssign = (bool)(e.Value ?? false))" />
                        <span>@Loc["TmGantt_NotifyOnAssignPush"]</span>
                    </label>
                    <label class="tm-gantt__view-settings-item">
                        <input type="checkbox" checked="@NotificationSettings.PushOnMention"
                               @onchange="e => UpdateNotification(s => s.PushOnMention = (bool)(e.Value ?? false))" />
                        <span>@Loc["TmGantt_NotifyOnMentionPush"]</span>
                    </label>
                    <label class="tm-gantt__view-settings-item">
                        <input type="checkbox" checked="@NotificationSettings.PushOnDeadline"
                               @onchange="e => UpdateNotification(s => s.PushOnDeadline = (bool)(e.Value ?? false))" />
                        <span>@Loc["TmGantt_NotifyOnDeadlinePush"]</span>
                    </label>
                </div>
            </div>
        </div>
    }

    <!-- Phase 5: alternate views (Workload, Calendar, Board, Dashboard, People) -->
    @if (View == GanttView.Workload)
    {
        <TmGanttWorkloadView Tasks="Data" WorkingSchedule="WorkingSchedule"
                             DisplayMode="WorkloadDisplayMode"
                             Today="TodayInZone()" />
    }
    else if (View == GanttView.Calendar)
    {
        <div class="tm-gantt__calendar-view" data-testid="@TestId("gantt-calendar-view")">
            <div class="tm-gantt__calendar-inner">
                @{
                    var calEvents = Data.Select(t => new TmScheduleEvent
                    {
                        Id    = t.Id,
                        Title = t.Title,
                        Start = t.Start,
                        End   = t.End,
                        Color = t.Color,
                        AllDay = true
                    }).ToList();
                }
                <TmScheduler Events="@calEvents"
                             @bind-View="_calendarView"
                             @bind-CurrentDate="_calendarDate"
                             HideTimeGrid="true"
                             OnEventChanged="OnCalendarEventChangedAsync"
                             OnEventClick="OnCalendarEventClickAsync" />
            </div>
        </div>
    }
    else if (View == GanttView.Board)
    {
        var kanbanColumns = new[]
        {
            new KanbanColumn(nameof(TmWorkItemStatus.Open),       Loc[$"GanttStatus_{TmWorkItemStatus.Open}"],       "#e5e7eb"),
            new KanbanColumn(nameof(TmWorkItemStatus.InProgress),  Loc[$"GanttStatus_{TmWorkItemStatus.InProgress}"],  "#dbeafe"),
            new KanbanColumn(nameof(TmWorkItemStatus.Done),        Loc[$"GanttStatus_{TmWorkItemStatus.Done}"],        "#dcfce7"),
            new KanbanColumn(nameof(TmWorkItemStatus.Closed),      Loc[$"GanttStatus_{TmWorkItemStatus.Closed}"],      "#f3f4f6"),
        };
        <div class="tm-gantt__board-view" data-testid="@TestId("gantt-board-view")">
            <TmKanbanBoard TItem="TmWorkItem"
                           Columns="kanbanColumns"
                           Items="Data"
                           ColumnSelector="t => t.Status.ToString()"
                           OnItemMoved="OnBoardItemMovedAsync"
                           OnCardClick="SelectTaskAsync">
                <CardTemplate Context="task">
                    @if (!string.IsNullOrEmpty(task.Color))
                    {
                        <div class="tm-gantt__board-card-accent" style="background:@task.Color"></div>
                    }
                    <div class="tm-gantt__board-card-title">@task.Title</div>
                    <div class="tm-gantt__board-card-meta">
                        <span class="tm-gantt__board-card-dates">@task.Start.ToString("dd.MM") – @task.End.ToString("dd.MM")</span>
                        @if (task.PercentComplete > 0)
                        {
                            <div class="tm-gantt__board-card-progress">
                                <div class="tm-gantt__board-card-progress-fill" style="width:@task.PercentComplete%"></div>
                            </div>
                        }
                    </div>
                </CardTemplate>
            </TmKanbanBoard>
        </div>
    }
    else if (View == GanttView.Dashboard)
    {
        <div class="tm-gantt__dashboard-view">
            <div class="tm-gantt__dashboard-widget" data-testid="@TestId("dashboard-widget-status")">
                <h4>@Loc["TmGantt_DashboardStatus"]</h4>
                @{ var byStatus = Data.GroupBy(t => t.Status).ToList(); }
                @foreach (var g in byStatus)
                {
                    <div class="tm-gantt__dashboard-stat">
                        <span class="tm-gantt__status-badge @GetStatusBadgeClass(g.Key)">@Loc[$"GanttStatus_{g.Key}"]</span>
                        <strong>@g.Count()</strong>
                    </div>
                }
            </div>
            <div class="tm-gantt__dashboard-widget" data-testid="@TestId("dashboard-widget-time")">
                <h4>@Loc["TmGantt_DashboardTime"]</h4>
                @{ var totalLogged = Data.Sum(t => GanttHelper.CalculateTotalLoggedHours(t.TimeLog)); }
                <div class="tm-gantt__dashboard-stat"><strong>@totalLogged.ToString("F1")h</strong></div>
            </div>
            <div class="tm-gantt__dashboard-widget" data-testid="@TestId("dashboard-widget-milestones")">
                <h4>@Loc["TmGantt_DashboardMilestones"]</h4>
                @foreach (var m in Data.Where(t => t.IsMilestone))
                {
                    <div class="tm-gantt__dashboard-stat">
                        <span>@m.Title</span>
                        <small>@m.End.ToString("dd.MM.yyyy")</small>
                    </div>
                }
            </div>
            <div class="tm-gantt__dashboard-widget" data-testid="@TestId("dashboard-widget-budget")">
                <h4>@Loc["TmGantt_DashboardBudget"]</h4>
                @{ var totalBudget = Data.Sum(t => t.BudgetHours ?? 0); var totalCost = Data.Sum(t => t.ActualCost ?? 0); }
                <div class="tm-gantt__dashboard-stat"><span>@totalBudget.ToString("F0")h</span></div>
                <div class="tm-gantt__dashboard-stat"><span>@totalCost.ToString("C2")</span></div>
            </div>
        </div>
    }
    else if (View == GanttView.People)
    {
        <div class="tm-gantt__people-view" data-testid="@TestId("gantt-people-view")">
            @{
                var peopleIds = GetPeopleViewAssigneeIds();
                var tsStart = GanttHelper.GetTimeRange(Data).Item1;
                var tsEnd   = GanttHelper.GetTimeRange(Data).Item2;
                var ppd     = GetPixelPerDay();
            }
            @foreach (var assigneeId in peopleIds)
            {
                var assignee = Data.SelectMany(t => t.Assignees)
                                   .FirstOrDefault(a => a.Id == assigneeId);
                var displayName = assignee?.Name ?? assigneeId;
                var assigneeTasks = Data.Where(t => t.Assignees.Any(a => a.Id == assigneeId)).ToList();
                var calendar = ResourceCalendars.FirstOrDefault(c => c.AssigneeId == assigneeId);
                <div class="tm-gantt__people-row" data-testid="@($"people-row-{assigneeId}")">
                    <div class="tm-gantt__people-row-header">
                        @if (!string.IsNullOrEmpty(assignee?.AvatarUrl))
                        {
                            <span class="tm-gantt__bar-avatar" style="background-image: url('@assignee.AvatarUrl'); background-size: cover;" title="@displayName"></span>
                        }
                        else
                        {
                            <span class="tm-gantt__bar-avatar" style="@GetAvatarStyle(assignee ?? new TmWorkItemAssignee { Name = displayName })" title="@displayName">
                                @(string.IsNullOrEmpty(displayName) ? "?" : displayName[0].ToString().ToUpperInvariant())
                            </span>
                        }
                        <span class="tm-gantt__people-row-name">@displayName</span>
                    </div>
                    <div class="tm-gantt__people-row-timeline" style="width: @(F(_totalTimelineWidth))px; position: relative;">
                        @* Vacation overlays *@
                        @if (calendar is not null)
                        {
                            @foreach (var vac in calendar.VacationDays)
                            {
                                var vacLeft  = (vac.Start - tsStart).TotalDays * ppd;
                                var vacWidth = (vac.End   - vac.Start).TotalDays * ppd;
                                <div class="tm-gantt__resource-vacation"
                                     data-testid="@($"vacation-overlay-{assigneeId}-{vac.Start:yyyy-MM-dd}")"
                                     style="left: @(F(vacLeft))px; width: @(F(vacWidth))px"></div>
                            }
                        }
                        @* Task bars for this assignee *@
                        @foreach (var task in assigneeTasks)
                        {
                            var (bl, bw) = GanttHelper.CalculateBarPosition(task.Start, task.End, tsStart, tsEnd, _totalTimelineWidth);
                            <div class="tm-gantt__people-bar" data-testid="@($"people-bar-{assigneeId}-{task.Id}")"
                                 style="left: @(F(bl))px; width: @(F(bw))px">
                                @task.Title
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {

    <!-- Main area: Tree + Timeline (also List view: tree only) -->
    <div class="tm-gantt__main @(View == GanttView.List ? "tm-gantt__main--list-view" : "")">
        <!-- Left: Task Tree -->
        <div class="tm-gantt__tree" data-testid="@TestId("gantt-tree")">
            <div class="tm-gantt__tree-header">
                @if (AllowBulkSelect)
                {
                    <span class="tm-gantt__tree-header-cell tm-gantt__tree-header-cell--checkbox"></span>
                }
                @foreach (var col in EffectiveColumns.Where(c => c.Visible))
                {
                    @if (col.Key == GanttColumnKey.WBS)
                    {
                        <span class="tm-gantt__tree-header-cell tm-gantt__tree-header-cell--wbs">@Loc["TmGantt_WBS"]</span>
                    }
                    else if (col.Key == GanttColumnKey.Title)
                    {
                        <span class="tm-gantt__tree-header-cell">@Loc["TmGantt_TaskTitle"]</span>
                    }
                    else if (col.Key == GanttColumnKey.Status)
                    {
                        <span class="tm-gantt__tree-header-cell tm-gantt__tree-header-cell--status">@Loc["TmGantt_Status"]</span>
                    }
                    else if (col.Key == GanttColumnKey.Start)
                    {
                        <span class="tm-gantt__tree-header-cell tm-gantt__tree-header-cell--narrow">@Loc["TmGantt_Start"]</span>
                    }
                    else if (col.Key == GanttColumnKey.End)
                    {
                        <span class="tm-gantt__tree-header-cell tm-gantt__tree-header-cell--narrow">@Loc["TmGantt_End"]</span>
                    }
                    else if (col.Key == GanttColumnKey.Progress)
                    {
                        <span class="tm-gantt__tree-header-cell tm-gantt__tree-header-cell--narrow"
                              data-testid="@TestId("col-header-progress")">
                            %
                            <input type="checkbox" class="tm-gantt__col-toggle" checked
                                   data-testid="@TestId("col-toggle-progress")"
                                   @onchange="e => ToggleColumnVisibilityAsync(GanttColumnKey.Progress, (bool)e.Value!)" />
                        </span>
                    }
                }
                @foreach (var cf in CustomFields)
                {
                    <span class="tm-gantt__tree-header-cell tm-gantt__custom-field-header"
                          data-testid="@TestId($"custom-col-header-{cf.Id}")">@cf.Name</span>
                }
            </div>
            <div class="tm-gantt__tree-body" @ref="_treeBodyRef" @onscroll="OnTreeScroll">
                @foreach (var node in _visibleNodes)
                {
                    <div class="tm-gantt__tree-row @GetRowClass(node) @GetDragClass(node)"
                         data-testid="@TestId($"tree-row-{node.Task.Id}")"
                         draggable="true"
                         @onclick="() => SelectTaskAsync(node.Task)"
                         @oncontextmenu="e => ShowContextMenu(e, node.Task)"
                         @oncontextmenu:preventDefault
                         @ondragstart="() => OnDragStart(node.Task)"
                         @ondragover="e => OnDragOver(node.Task, e)"
                         @ondragover:preventDefault
                         @ondragleave="OnDragLeave"
                         @ondrop="() => OnDropAsync(node.Task)">

                        @if (AllowBulkSelect)
                        {
                            <span class="tm-gantt__tree-cell tm-gantt__tree-cell--checkbox" @onclick:stopPropagation>
                                <input type="checkbox" data-testid="@TestId($"bulk-select-{node.Task.Id}")"
                                       checked="@_selectedTaskIds.Contains(node.Task.Id)"
                                       @onchange="e => ToggleBulkSelect(node.Task.Id, (bool)e.Value!)" />
                            </span>
                        }

                        @foreach (var col in EffectiveColumns.Where(c => c.Visible))
                        {
                            @if (col.Key == GanttColumnKey.WBS)
                            {
                                <span class="tm-gantt__tree-cell tm-gantt__tree-cell--wbs"
                                      data-testid="@TestId("wbs-number")">@node.WbsNumber</span>
                            }
                            else if (col.Key == GanttColumnKey.Title)
                            {
                                <span class="tm-gantt__tree-cell tm-gantt__tree-cell--title" style="padding-left: @(node.Depth * 20)px">
                                    <span class="tm-gantt__drag-handle">
                                        <TmIcon Name="grip-vertical" Size="IconSize.Sm" />
                                    </span>
                                    @if (node.Children.Count > 0)
                                    {
                                        <button type="button" class="tm-gantt__expand-btn" @onclick:stopPropagation="true" @onclick="() => ToggleExpandAsync(node.Task)">
                                            <TmIcon Name="@(node.Task.IsExpanded ? "chevron-down" : "chevron-right")" />
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="tm-gantt__expand-spacer"></span>
                                    }
                                    @if (node.Task.IsMilestone)
                                    {
                                        <TmIcon Name="diamond" Class="tm-gantt__milestone-icon" />
                                    }
                                    <span class="tm-gantt__priority-icon @GetPriorityIconClass(node.Task.Priority)"
                                          data-testid="@TestId("priority-icon")"
                                          title="@Loc[$"GanttPriority_{node.Task.Priority}"]"></span>

                                    @if (_inlineEditTaskId == node.Task.Id && _inlineEditColumn == GanttColumnKey.Title)
                                    {
                                        <input class="tm-gantt__inline-edit"
                                               data-testid="@TestId("inline-edit-input")"
                                               value="@_inlineEditValue"
                                               @onclick:stopPropagation
                                               @onchange="e => _inlineEditValue = e.Value?.ToString() ?? string.Empty"
                                               @onkeydown="HandleInlineEditKeyDownAsync"
                                               @onblur="CommitInlineEditAsync" />
                                    }
                                    else
                                    {
                                        <span class="tm-gantt__task-title"
                                              data-testid="@TestId($"tree-cell-title-{node.Task.Id}")"
                                              @ondblclick:stopPropagation
                                              @ondblclick="() => StartInlineEdit(node.Task.Id, GanttColumnKey.Title, node.Task.Title)">
                                            @node.Task.Title
                                        </span>
                                        @if (node.Task.Attachments.Count > 0)
                                        {
                                            <span class="tm-gantt__inline-badge tm-gantt__inline-badge--attachment"
                                                  data-testid="@TestId($"attachment-count-{node.Task.Id}")"
                                                  title="@node.Task.Attachments.Count @Loc["GanttTask_Attachments"]">
                                                <TmIcon Name="paperclip" Size="IconSize.Xs" />
                                                @node.Task.Attachments.Count
                                            </span>
                                        }
                                        @if (node.Task.Comments.Count > 0)
                                        {
                                            <span class="tm-gantt__inline-badge tm-gantt__inline-badge--comment"
                                                  data-testid="@TestId($"comment-count-{node.Task.Id}")"
                                                  title="@node.Task.Comments.Count @Loc["GanttTask_Comments"]">
                                                <TmIcon Name="message-circle" Size="IconSize.Xs" />
                                                @node.Task.Comments.Count
                                            </span>
                                        }
                                        @* Overloaded assignee icon (F5.1.5) *@
                                        @if (_overloadedAssigneeIds.Count > 0 &&
                                             node.Task.Assignees.Any(a => _overloadedAssigneeIds.Contains(a.Id)))
                                        {
                                            @foreach (var ol in node.Task.Assignees.Where(a => _overloadedAssigneeIds.Contains(a.Id)))
                                            {
                                                <span class="tm-gantt__overload-icon"
                                                      data-testid="@($"overload-icon-{ol.Id}")"
                                                      title="@Loc["TmGantt_Overloaded"]">
                                                    <TmIcon Name="alert-triangle" Size="IconSize.Xs" />
                                                </span>
                                            }
                                        }
                                    }
                                </span>
                            }
                            else if (col.Key == GanttColumnKey.Status)
                            {
                                <span class="tm-gantt__tree-cell tm-gantt__tree-cell--status">
                                    <span class="tm-gantt__status-badge @GetStatusBadgeClass(node.Task.Status)"
                                          data-testid="@TestId("status-badge")">
                                        @Loc[$"GanttStatus_{node.Task.Status}"]
                                    </span>
                                </span>
                            }
                            else if (col.Key == GanttColumnKey.Start)
                            {
                                <span class="tm-gantt__tree-cell tm-gantt__tree-cell--narrow">
                                    @node.Task.Start.ToString("dd.MM.yyyy")
                                    @if (ActiveBaselineId is not null && _baselinePositions.ContainsKey(node.Task.Id))
                                    {
                                        var bt = Baselines.FirstOrDefault(b => b.Id == ActiveBaselineId)
                                                          ?.Tasks.FirstOrDefault(t => t.TaskId == node.Task.Id);
                                        var devDays = bt is not null ? (int)(node.Task.Start - bt.Start).TotalDays : 0;
                                        <span class="tm-gantt__deviation-badge @(devDays > 0 ? "tm-gantt__deviation-badge--late" : "tm-gantt__deviation-badge--early")"
                                              data-testid="@TestId($"deviation-badge-{node.Task.Id}")"
                                              title="@Loc["TmGantt_BaselineDeviation"]">
                                            @(devDays > 0 ? "+" : "")@devDays d
                                        </span>
                                    }
                                </span>
                            }
                            else if (col.Key == GanttColumnKey.End)
                            {
                                <span class="tm-gantt__tree-cell tm-gantt__tree-cell--narrow">@node.Task.End.ToString("dd.MM.yyyy")</span>
                            }
                            else if (col.Key == GanttColumnKey.Progress)
                            {
                                <span class="tm-gantt__tree-cell tm-gantt__tree-cell--narrow">
                                    <div class="tm-gantt__progress-mini">
                                        <div class="tm-gantt__progress-mini-fill" style="width: @(node.Task.PercentComplete)%"></div>
                                    </div>
                                    <span class="tm-gantt__progress-mini-label">@(node.Task.PercentComplete)%</span>
                                </span>
                            }
                        }

                        @foreach (var cf in CustomFields)
                        {
                            var cfVal = node.Task.CustomFields.TryGetValue(cf.Id, out var v) ? v : null;
                            @if (_inlineEditTaskId == node.Task.Id && _inlineEditCustomFieldId == cf.Id)
                            {
                                <span class="tm-gantt__tree-cell tm-gantt__custom-field-cell">
                                    <input class="tm-gantt__inline-edit" data-testid="@TestId("inline-edit-input")"
                                           value="@_inlineEditValue"
                                           @onclick:stopPropagation
                                           @oninput="e => _inlineEditValue = e.Value?.ToString() ?? string.Empty"
                                           @onchange="e => _inlineEditValue = e.Value?.ToString() ?? string.Empty"
                                           @onkeydown="HandleInlineEditKeyDownAsync"
                                           @onblur="CommitCustomFieldEditAsync" />
                                </span>
                            }
                            else
                            {
                                <span class="tm-gantt__tree-cell tm-gantt__custom-field-cell"
                                      data-testid="@TestId($"custom-cell-{cf.Id}-{node.Task.Id}")"
                                      @ondblclick:stopPropagation
                                      @ondblclick="() => StartCustomFieldInlineEdit(node.Task.Id, cf.Id, cfVal ?? string.Empty)">
                                    @cfVal
                                </span>
                            }
                        }
                    </div>
                }
            </div>

            <!-- Bulk toolbar -->
            @if (AllowBulkSelect && _selectedTaskIds.Count > 0)
            {
                <div class="tm-gantt__bulk-toolbar">
                    <span class="tm-gantt__bulk-toolbar-count">@_selectedTaskIds.Count @Loc["TmGantt_BulkSelected"]</span>
                    <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                              OnClick="() => ExecuteBulkStatusUpdateAsync(TmWorkItemStatus.Done)"
                              data-testid="@TestId("bulk-status-done")">
                        @Loc["TmGantt_BulkMarkDone"]
                    </TmButton>
                    <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                              OnClick="() => ExecuteBulkStatusUpdateAsync(TmWorkItemStatus.InProgress)"
                              data-testid="@TestId("bulk-status-inprogress")">
                        @Loc["TmGantt_BulkMarkInProgress"]
                    </TmButton>
                    <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                              OnClick="() => { _selectedTaskIds = []; }"
                              data-testid="@TestId("bulk-clear")">
                        <TmIcon Name="x" Size="IconSize.Sm" />
                    </TmButton>
                </div>
            }
        </div>

        <!-- Right: Timeline (hidden in List view) -->
        @if (View != GanttView.List)
        {
        <div class="tm-gantt__timeline @(_isPanning ? "tm-gantt__timeline--panning" : "")"
             data-testid="@TestId("gantt-timeline")"
             @ref="_timelineContainerRef"
             @onmousedown="OnTimelineMouseDown"
             @onmousemove="OnTimelineMouseMove"
             @onmouseup="OnTimelineMouseUp"
             @onmouseleave="OnTimelineMouseUp"
             @onwheel="OnTimelineWheel">

            <!-- Two-row Timeline Header -->
            <div class="tm-gantt__timeline-header" style="width: @(F(_totalTimelineWidth))px">
                <div class="tm-gantt__timeline-header--upper">
                    @foreach (var h in _upperHeaders)
                    {
                        <div class="tm-gantt__timeline-header-cell tm-gantt__timeline-header-cell--upper"
                             style="left: @(F(h.Offset))px; width: @(F(h.Width))px">@h.Label</div>
                    }
                </div>
                <div class="tm-gantt__timeline-header--lower">
                    @foreach (var h in _lowerHeaders)
                    {
                        <div class="tm-gantt__timeline-header-cell tm-gantt__timeline-header-cell--lower"
                             style="left: @(F(h.Offset))px; width: @(F(h.Width))px">@h.Label</div>
                    }
                </div>
            </div>

            <!-- Timeline Body -->
            <div class="tm-gantt__timeline-body"
                 @ref="_timelineBodyRef"
                 @onscroll="OnTimelineBodyScroll">
                <div class="tm-gantt__timeline-content"
                     style="height: @(F(_visibleNodes.Count * RowHeight))px; width: @(F(_totalTimelineWidth))px">

                    <!-- Non-working day overlays -->
                    @if (ViewSettings.ShowDaysOff)
                    {
                        @foreach (var rect in _nonWorkingRects)
                        {
                            <div class="tm-gantt__nonworking-overlay"
                                 data-testid="@TestId("nonworking-overlay")"
                                 style="left: @(F(rect.Offset))px; width: @(F(rect.Width))px"></div>
                        }
                    }

                    <!-- Grid lines -->
                    <div class="tm-gantt__grid">
                        @foreach (var header in _timelineHeaders)
                        {
                            <div class="tm-gantt__grid-line" style="left: @(F(header.Offset))px; width: @(F(header.Width))px"></div>
                        }
                    </div>

                    <!-- Today marker -->
                    @if (ViewSettings.ShowTodayMarker)
                    {
                        <div class="tm-gantt__today-marker"
                             data-testid="@TestId("today-marker")"
                             style="left: @(F(_todayOffset))px"
                             title="@Loc["TmGantt_Today"]"></div>
                    }

                    <!-- Current time marker (Hours view only) -->
                    @if (ZoomPreset == GanttZoomPreset.Hours)
                    {
                        <div class="tm-gantt__current-time-marker"
                             data-testid="@TestId("current-time-marker")"
                             style="left: @(F(_currentTimeOffset))px"></div>
                    }

                    <!-- Dependency lines (SVG) -->
                    <svg class="tm-gantt__dependencies" style="width: @(F(_totalTimelineWidth))px; height: 100%">
                        @foreach (var dep in _visibleDependencies)
                        {
                            <line x1="@F(dep.X1)" y1="@F(dep.Y1)" x2="@F(dep.X2)" y2="@F(dep.Y2)"
                                  class="@GetDepLineClass(dep)"
                                  data-testid="@TestId($"dep-line-{dep.DependencyId}")"
                                  @onclick:stopPropagation
                                  @onclick="() => SelectDependency(dep.DependencyId)" />
                            <polygon points="@GetArrowPoints(dep.X2, dep.Y2)"
                                     class="tm-gantt__dependency-arrow" />
                            @if (dep.LagDays != 0)
                            {
                                @((MarkupString)$"<text x=\"{F(dep.MidX)}\" y=\"{F(dep.MidY - 4)}\" class=\"tm-gantt__dep-lag-label\" data-testid=\"dep-lag-{dep.DependencyId}\" text-anchor=\"middle\">{(dep.LagDays > 0 ? "+" : "")}{dep.LagDays} d</text>")
                            }
                        }
                    </svg>

                    <!-- Baseline ghost bars -->
                    @if (ActiveBaselineId is not null)
                    {
                        @foreach (var bar in _taskBars.Where(b => b.BaselineLeft.HasValue))
                        {
                            <div class="tm-gantt__bar tm-gantt__bar--baseline"
                                 data-testid="@TestId($"ghost-bar-{bar.Task.Id}")"
                                 style="left: @(F(bar.BaselineLeft!.Value))px; width: @(F(bar.BaselineWidth!.Value))px; top: @(F(bar.Top))px;"></div>
                        }
                    }

                    <!-- Task bars -->
                    @foreach (var bar in _taskBars)
                    {
                        <div class="tm-gantt__task-row"
                             style="top: @(F(bar.Top))px; height: @(RowHeight)px">
                            @if (bar.Task.IsMilestone)
                            {
                                <div class="tm-gantt__milestone"
                                     style="left: @(F(bar.Left - 6))px"
                                     title="@bar.Task.Title"
                                     @onclick="() => SelectTaskAsync(bar.Task)"
                                     @onmousedown:stopPropagation="true">
                                </div>
                            }
                            else
                            {
                                <div class="tm-gantt__bar @GetBarClass(bar)"
                                     data-testid="@TestId($"task-bar-{bar.Task.Id}")"
                                     style="left: @(F(bar.Left))px; width: @(F(bar.Width))px; @GetBarColorStyle(bar)"
                                     title="@bar.Task.Title (@bar.Task.PercentComplete%)"
                                     @onclick="() => SelectTaskAsync(bar.Task)"
                                     @onmousedown:stopPropagation="true">
                                    <div class="tm-gantt__bar-progress" style="width: @(bar.Task.PercentComplete)%"></div>
                                    @if (ShouldRenderBarLabel(bar))
                                    {
                                        <span class="tm-gantt__bar-label">@bar.Task.Title</span>
                                    }

                                    <!-- Assignee avatars (up to 3 + overflow) -->
                                    @{
                                        var assignees = bar.Task.Assignees ?? [];
                                        var visibleAvatars = assignees.Take(3).ToList();
                                        var overflowCount = assignees.Count - visibleAvatars.Count;
                                    }
                                    @if (visibleAvatars.Count > 0)
                                    {
                                        <div class="tm-gantt__bar-avatars">
                                            @foreach (var a in visibleAvatars)
                                            {
                                                @if (a.IsVirtual && string.IsNullOrEmpty(a.AvatarUrl))
                                                {
                                                    <span class="tm-gantt__bar-avatar tm-gantt__bar-avatar--virtual"
                                                          data-testid="@($"bar-avatar-virtual-{a.Id}")"
                                                          title="@a.Name">
                                                        <TmIcon Name="users" Size="IconSize.Xs" />
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="tm-gantt__bar-avatar"
                                                          style="@GetAvatarStyle(a)"
                                                          title="@a.Name">
                                                        @if (string.IsNullOrEmpty(a.AvatarUrl))
                                                        {
                                                            @GetAvatarInitial(a)
                                                        }
                                                    </span>
                                                }
                                            }
                                            @if (overflowCount > 0)
                                            {
                                                <span class="tm-gantt__bar-avatar-overflow">+@overflowCount</span>
                                            }
                                        </div>
                                    }

                                    <!-- Dep creation handles -->
                                    @if (AllowDependencyCreation)
                                    {
                                        <span class="tm-gantt__dep-handle tm-gantt__dep-handle--start"
                                              @onmousedown:stopPropagation
                                              @onmousedown="() => StartDepDrag(bar.Task.Id, fromEnd: false)"></span>
                                        <span class="tm-gantt__dep-handle tm-gantt__dep-handle--end"
                                              @onmousedown:stopPropagation
                                              @onmousedown="() => StartDepDrag(bar.Task.Id, fromEnd: true)"
                                              @onmouseup:stopPropagation
                                              @onmouseup="() => OnDepDrop(bar.Task.Id)"></span>
                                    }

                                    <!-- Hover tooltip -->
                                    <div class="tm-gantt__bar-tooltip" data-testid="@TestId("bar-tooltip")">
                                        <div class="tm-gantt__bar-tooltip-title">@bar.Task.Title</div>
                                        <div class="tm-gantt__bar-tooltip-row">
                                            <span>@Loc["TmGantt_TooltipStart"]:</span>
                                            <span>@bar.Task.Start.ToString("dd.MM.yyyy")</span>
                                        </div>
                                        <div class="tm-gantt__bar-tooltip-row">
                                            <span>@Loc["TmGantt_TooltipEnd"]:</span>
                                            <span>@bar.Task.End.ToString("dd.MM.yyyy")</span>
                                        </div>
                                        <div class="tm-gantt__bar-tooltip-row">
                                            <span>@Loc["TmGantt_TooltipProgress"]:</span>
                                            <span>@bar.Task.PercentComplete%</span>
                                        </div>
                                    </div>
                                    <!-- Deadline exceeded marker -->
                                    @if (bar.IsDeadlineExceeded)
                                    {
                                        <span class="tm-gantt__bar-deadline" data-testid="@TestId("deadline-marker")" title="@Loc["GanttTask_DeadlineExceeded"]">
                                            <TmIcon Name="flame" Size="IconSize.Sm" />
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
        } @* end @if (View != GanttView.List) *@
    </div>
    } @* end else (main area) *@

    @if (ShowTaskPanel)
    {
        <TmGanttTaskPanel Task="SelectedTask"
                          AllTasks="Data"
                          Dependencies="Dependencies"
                          OnTaskUpdated="OnTaskUpdated"
                          OnDependencyAdded="OnDependencyAdded"
                          OnDependencyRemoved="OnDependencyRemoved"
                          OnCommentAdded="HandleTaskCommentAddedAsync"
                          OnClose="() => ShowTaskPanel = false" />
    }

    </div> @* tm-gantt__content *@

    <!-- Export Dialog -->
    @if (_exportDialogOpen)
    {
        <TmGanttExportDialog IsOpen="_exportDialogOpen"
                             OnExport="HandleExportAsync"
                             OnClose="ToggleExportDialog" />
    }

    <!-- Import Dialog -->
    @if (_importDialogOpen)
    {
        <TmGanttImportDialog IsOpen="_importDialogOpen"
                             OnImportCompleted="HandleImportCompletedAsync"
                             OnImportError="HandleImportErrorAsync"
                             OnClose="ToggleImportDialog" />
    }

    <!-- History Drawer -->
    @if (_historyDrawerOpen)
    {
        <TmGanttHistoryDrawer History="History"
                              IsOpen="_historyDrawerOpen"
                              OnTimeTravelRequested="OnTimeTravelRequested"
                              OnRollbackRequested="OnRollbackRequested"
                              OnClose="ToggleHistoryDrawer" />
    }

    <!-- Context Menu -->
    @if (_contextMenuVisible && _contextMenuTask is not null)
    {
        <div class="tm-gantt__context-menu-overlay" @onclick="HideContextMenu">
            <div class="tm-gantt__context-menu"
                 style="left: @(_contextMenuX)px; top: @(_contextMenuY)px;"
                 @onclick:stopPropagation>
                <button type="button" class="tm-gantt__context-menu-item"
                        @onclick="() => InsertTaskAsync(GanttInsertPosition.Above)">
                    <TmIcon Name="arrow-up" Size="IconSize.Sm" />
                    <span>@Loc["TmGantt_AddTaskAbove"]</span>
                </button>
                <button type="button" class="tm-gantt__context-menu-item"
                        @onclick="() => InsertTaskAsync(GanttInsertPosition.Below)">
                    <TmIcon Name="arrow-down" Size="IconSize.Sm" />
                    <span>@Loc["TmGantt_AddTaskBelow"]</span>
                </button>
                <button type="button" class="tm-gantt__context-menu-item"
                        @onclick="() => InsertTaskAsync(GanttInsertPosition.Child)">
                    <TmIcon Name="corner-down-right" Size="IconSize.Sm" />
                    <span>@Loc["TmGantt_AddTaskChild"]</span>
                </button>
                @if (ViewSettings.ShowAdvancedContextButtons)
                {
                    <div class="tm-gantt__context-menu-divider"></div>
                    <button type="button" class="tm-gantt__context-menu-item">
                        <TmIcon Name="copy" Size="IconSize.Sm" />
                        <span>@Loc["TmGantt_DuplicateTask"]</span>
                    </button>
                }
                <div class="tm-gantt__context-menu-divider"></div>
                <button type="button" class="tm-gantt__context-menu-item tm-gantt__context-menu-item--danger"
                        @onclick="DeleteTaskAsync">
                    <TmIcon Name="trash-2" Size="IconSize.Sm" />
                    <span>@Loc["TmGantt_DeleteTask"]</span>
                </button>
            </div>
        </div>
    }
</div>
