@namespace Tempo.Blazor.Components.Scheduler
@using Tempo.Blazor.Models

<div class="tm-scheduler-week">
    <TmSchedulerTimeGrid Dates="@_dates"
                         Events="@Events"
                         Resources="@Resources"
                         SlotDuration="@SlotDuration"
                         ReadOnly="@ReadOnly"
                         HideTimeGrid="@HideTimeGrid"
                         Today="@Today"
                         HighlightWeekends="@HighlightWeekends"
                         AllDayEventStyle="@AllDayEventStyle"
                         WorkDayStart="@WorkDayStart"
                         WorkDayEnd="@WorkDayEnd"
                         ShowFullDay="@ShowFullDay"
                         HighlightOffHours="@HighlightOffHours"
                         ScrollToTime="@ScrollToTime"
                         ShowNowIndicator="@ShowNowIndicator"
                         TimeZone="@TimeZone"
                         ResourceHeaderTemplate="@ResourceHeaderTemplate"
                         ShowEventResource="@ShowEventResource"
                         OnSlotClick="@OnSlotClick"
                         SelectedDate="@SelectedDate"
                         SelectedEvent="@SelectedEvent"
                         SelectedEventChanged="@SelectedEventChanged"
                         OnEventClick="@OnEventClick"
                         OnEventChanged="@OnEventChanged"
                          OnAnnounced="@OnAnnounced"
                         OnSlotContextMenu="@OnSlotContextMenu"
                         OnEventContextMenu="@OnEventContextMenu"
                         EventTemplate="@EventTemplate" />
</div>

@code {
    private List<DateOnly> _dates = [];

    /// <summary>Currently displayed date (any day in the target week).</summary>
    [Parameter] public DateTime CurrentDate { get; set; }

    /// <summary>First day of week (0=Sunday, 1=Monday, ...).</summary>
    [Parameter] public int FirstDayOfWeek { get; set; } = 1;

    /// <summary>Which days the week renders. <see cref="TmSchedulerWeekDays.WorkWeek"/> keeps Monday to Friday of the displayed week.</summary>
    [Parameter] public TmSchedulerWeekDays WeekDays { get; set; } = TmSchedulerWeekDays.FullWeek;

    /// <summary>Events to display.</summary>
    [Parameter] public IReadOnlyList<TmScheduleEvent>? Events { get; set; }

    /// <summary>Duration of each time slot in minutes.</summary>
    [Parameter] public int SlotDuration { get; set; } = 30;

    /// <summary>Fires when a time slot is clicked.</summary>
    [Parameter] public EventCallback<(DateTime Start, DateTime End)> OnSlotClick { get; set; }

    /// <summary>Fires when an event is clicked.</summary>
    [Parameter] public EventCallback<TmScheduleEvent> OnEventClick { get; set; }

    /// <summary>The selected day, forwarded to the time grid.</summary>
    [Parameter] public DateTime? SelectedDate { get; set; }

    /// <summary>The selected event, forwarded to the time grid.</summary>
    [Parameter] public TmScheduleEvent? SelectedEvent { get; set; }

    /// <summary>Fires when the user selects an event.</summary>
    [Parameter] public EventCallback<TmScheduleEvent?> SelectedEventChanged { get; set; }

    /// <summary>Whether events are read-only.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Fires when an event is moved or resized.</summary>
    [Parameter] public EventCallback<TmScheduleEvent> OnEventChanged { get; set; }

    /// <summary>Fires with the sentence a move or a resize should announce.</summary>
    [Parameter] public EventCallback<string> OnAnnounced { get; set; }

    /// <summary>Fires when right-clicking on a time slot.</summary>
    [Parameter] public EventCallback<SchedulerSlotContext> OnSlotContextMenu { get; set; }

    /// <summary>Fires when right-clicking on an event.</summary>
    [Parameter] public EventCallback<SchedulerEventContext> OnEventContextMenu { get; set; }

    /// <summary>Resources for grouping columns.</summary>
    [Parameter] public IReadOnlyList<TmScheduleResource>? Resources { get; set; }

    /// <summary>Optional custom event template.</summary>
    [Parameter] public RenderFragment<TmScheduleEvent>? EventTemplate { get; set; }

    /// <summary>When true, hides the hourly time grid body.</summary>
    [Parameter] public bool HideTimeGrid { get; set; }

    /// <summary>Today in the display zone. The matching column gets <c>tm-scheduler-timegrid-col--today</c>.</summary>
    [Parameter] public DateOnly Today { get; set; }

    /// <summary>When true, Saturday and Sunday columns get <c>tm-scheduler-timegrid-col--weekend</c>.</summary>
    [Parameter] public bool HighlightWeekends { get; set; }

    /// <summary>Paint of an all-day event, forwarded to the time grid.</summary>
    [Parameter] public TmAllDayEventStyle AllDayEventStyle { get; set; } = TmAllDayEventStyle.Solid;

    /// <summary>First minute of the working day, forwarded to the time grid.</summary>
    [Parameter] public TimeOnly WorkDayStart { get; set; } = new(8, 0);

    /// <summary>Last minute of the working day, forwarded to the time grid.</summary>
    [Parameter] public TimeOnly WorkDayEnd { get; set; } = new(17, 0);

    /// <summary>When false the grid shows only the working hours, forwarded to the time grid.</summary>
    [Parameter] public bool ShowFullDay { get; set; } = true;

    /// <summary>When true, slots outside the working day are tinted. Forwarded to the time grid. Default false.</summary>
    [Parameter] public bool HighlightOffHours { get; set; }

    /// <summary>When set, the grid scrolls this time into view after the first render, forwarded to the time grid.</summary>
    [Parameter] public TimeSpan? ScrollToTime { get; set; }

    /// <summary>When true today's column draws the current-time indicator, forwarded to the time grid.</summary>
    [Parameter] public bool ShowNowIndicator { get; set; } = true;

    /// <summary>Display zone for the current-time indicator, forwarded to the time grid.</summary>
    [Parameter] public TimeZoneInfo? TimeZone { get; set; }

    /// <summary>Replaces the default resource header, forwarded to the time grid.</summary>
    [Parameter] public RenderFragment<TmScheduleResource>? ResourceHeaderTemplate { get; set; }

    /// <summary>When true a timed event names its resource, forwarded to the time grid.</summary>
    [Parameter] public bool ShowEventResource { get; set; }

    protected override void OnParametersSet()
    {
        _dates = GetWeekDates();
    }

    private List<DateOnly> GetWeekDates()
        => SchedulerRange.WeekDates(CurrentDate, FirstDayOfWeek, WeekDays).ToList();
}
