@namespace Tempo.Blazor.Components.Scheduler
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Abstractions.Shared
@using Tempo.Blazor.Components.Feedback

@if (IsOpen)
{
    <div class="@DrawerClass" data-testid="@TestId("gantt-history-drawer")" tabindex="-1" @ref="_drawer"
         role="complementary" aria-label="@Loc["TmGantt_History"]" @onkeydown="OnKeyDownAsync">
        <div class="tm-gantt__history-drawer-header">
            <span class="tm-gantt__history-drawer-title">@Loc["TmGantt_History"]</span>
            <button type="button" class="tm-gantt__dialog-close" @onclick="CloseAsync"
                    aria-label="@Loc["TmGantt_HistoryClose"]">
                <TmIcon Name="x" />
            </button>
        </div>
        <div class="tm-gantt__history-drawer-body">
            <TmGanttHistoryList History="History" Tasks="Tasks" TimeZone="TimeZone" ShowActions="true"
                                TestIdPrefix="@TestIdPrefix"
                                OnTaskSelected="OnTaskSelected"
                                OnTimeTravelRequested="OnTimeTravelRequested"
                                OnRollbackRequested="RequestRollbackAsync" />
        </div>
    </div>

    @* A sibling of the drawer (not a child): the dialog's Escape must not also close the drawer. *@
    <TmDialog Show="@(_pendingRollback is not null)" Type="DialogType.Confirm" Variant="DialogVariant.Warning"
              Title="@Loc["TmGantt_RollbackConfirmTitle"]" Message="@RollbackMessage"
              OkButtonText="@Loc["TmGantt_Rollback"]"
              OnResult="ConfirmRollbackAsync" />
}