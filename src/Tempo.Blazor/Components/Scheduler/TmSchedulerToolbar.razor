@namespace Tempo.Blazor.Components.Scheduler
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Components.Dropdowns
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Components.Navigation
@using Tempo.Blazor.Components.Pickers
@using Tempo.Blazor.Models
@using System.Globalization
@inject IJSRuntime JS

@if (ShowHeader)
{
<div class="tm-scheduler-toolbar">
    @if (HeaderStart is not null)
    {
        <div class="tm-scheduler-toolbar-slot" data-tm-group="header-start">@HeaderStart</div>
    }

    <div class="tm-scheduler-toolbar-nav" data-tm-group="navigation">
        <button type="button" class="tm-scheduler-toolbar-nav-btn tm-scheduler-toolbar-today-btn"
                data-testid="@TestId("scheduler-today")"
                @onclick="OnToday">@Loc["TmScheduler_Today"]</button>
        <button type="button" class="tm-scheduler-toolbar-nav-btn" data-testid="@TestId("scheduler-prev")"
                aria-label="@Loc["TmScheduler_Prev"]" @onclick="OnPrev"><TmIcon Name="@IconNames.ChevronLeft" Size="IconSize.Sm" /></button>
        <button type="button" class="tm-scheduler-toolbar-nav-btn" data-testid="@TestId("scheduler-next")"
                aria-label="@Loc["TmScheduler_Next"]" @onclick="OnNext"><TmIcon Name="@IconNames.ChevronRight" Size="IconSize.Sm" /></button>
    </div>

    <div class="tm-scheduler-toolbar-title" data-tm-group="title" @ref="_titleRef">
        <span class="tm-sr-only" aria-live="polite" aria-atomic="true">@DisplayTitle</span>
        <TmPopover @ref="_datePopover" @bind-IsOpen="_dateOpen" ShowArrow="false"
                   Title="@Loc["TmScheduler_GoToDate"]" Role="dialog" TrapFocus="true"
                   TriggerAriaLabel="@GoToDateLabel" OnOpened="FocusCalendarDayAsync"
                   Class="tm-scheduler-toolbar-date">
            <TriggerContent>
                <span class="tm-scheduler-toolbar-title-btn">
                    <span aria-hidden="true"><TmIcon Name="@IconNames.Calendar" Size="IconSize.Sm" /></span>
                    <span class="tm-scheduler-toolbar-title-text">@DisplayTitle</span>
                    <span aria-hidden="true" class="tm-scheduler-toolbar-title-chevron"><TmIcon Name="@IconNames.ChevronDown" Size="IconSize.Sm" /></span>
                </span>
            </TriggerContent>
            <ChildContent>
                <TmCalendarView SelectedDate="@DisplayedDay"
                                Today="@Today"
                                OnDateClick="PickDateAsync" />
            </ChildContent>
        </TmPopover>
    </div>

    <div class="tm-scheduler-toolbar-views" data-tm-group="view">
        <TmTabs Variant="TabVariant.Pill" ActiveTabId="@ActiveTabId" ActiveTabIdChanged="SelectViewAsync"
                AriaLabel="@Loc["TmScheduler_ViewSwitcher"]">
            @foreach (var view in OfferedViews)
            {
                var v = view;
                <TmTabPanel Id="@TabId(v)" Title="@GetViewLabel(v)"
                            TabAttributes="@(new Dictionary<string, object> { ["data-view"] = v.ToString() })" />
            }
        </TmTabs>
    </div>

    @if (HeaderActions is not null)
    {
        <div class="tm-scheduler-toolbar-slot" data-tm-group="header-actions">@HeaderActions</div>
    }

    @if (OnAddClick.HasDelegate)
    {
        <div class="tm-scheduler-toolbar-primary" data-tm-group="primary">
            <button type="button" class="tm-scheduler-toolbar-add" data-testid="@TestId("scheduler-add")"
                    @onclick="OnAddClick">
                <TmIcon Name="@IconNames.Plus" Size="IconSize.Sm" />
                <span>@Loc["TmScheduler_AddEvent"]</span>
            </button>
        </div>
    }

    @if (ShowPrint)
    {
        <div class="tm-scheduler-toolbar-overflow" data-tm-group="overflow">
            <TmDropdown Icon="@IconNames.MoreHorizontal" Text="@Loc["Tm_More"]" AriaLabel="@Loc["Tm_More"]"
                        ShowChevron="false" OutlineTrigger="true" data-testid="@TestId("scheduler-more")"
                        OnSelect="HandleMoreAsync">
                <TmDropdownItem Value="print" Icon="@IconNames.Printer" aria-label="@Loc["TmScheduler_Print"]" data-testid="@TestId("scheduler-print")">@Loc["TmScheduler_Print"]</TmDropdownItem>
            </TmDropdown>
        </div>
    }
</div>
}

@code {
    private string Instance => string.IsNullOrEmpty(InstanceId) ? _fallbackId : InstanceId;
    private readonly string _fallbackId = "tm-sched-" + Guid.NewGuid().ToString("N");
    private TmPopover? _datePopover;
    private bool _dateOpen;
    private ElementReference _titleRef;

    private static readonly TmScheduleViewType[] _canonical =
        [TmScheduleViewType.Day, TmScheduleViewType.Week, TmScheduleViewType.Month, TmScheduleViewType.Agenda, TmScheduleViewType.Timeline];

    /// <summary>
    /// The offered views in the host's order. A view that is not offered is inserted at its
    /// canonical position, so the active view is always one of the tabs.
    /// </summary>
    private IReadOnlyList<TmScheduleViewType> OfferedViews
    {
        get
        {
            var offered = Views is { Count: > 0 }
                ? Views.Where(Enum.IsDefined).Distinct().ToList()
                : _canonical.ToList();
            if (!offered.Contains(View))
            {
                var at = offered.FindIndex(v => Array.IndexOf(_canonical, v) > Array.IndexOf(_canonical, View));
                offered.Insert(at < 0 ? offered.Count : at, View);
            }
            return offered;
        }
    }

    private string ActiveTabId => TabId(View);

    private string TabId(TmScheduleViewType view) => $"{Instance}-{view}";

    private DateOnly DisplayedDay
        => DateOnly.FromDateTime(CurrentDate == default ? Today.ToDateTime(TimeOnly.MinValue) : CurrentDate);

    private string GoToDateLabel => string.Format(Loc["TmScheduler_GoToDateLabel"], DisplayTitle);

    /// <summary>Current view type.</summary>
    [Parameter] public TmScheduleViewType View { get; set; }

    /// <summary>Currently displayed date. The Month title is this date's month.</summary>
    [Parameter] public DateTime CurrentDate { get; set; }

    /// <summary>
    /// Inclusive start of the range the title describes. The scheduler fills it from the same range
    /// it loads. Day and Timeline titles show this day; Week and Agenda titles start here.
    /// </summary>
    [Parameter] public DateTime RangeStart { get; set; }

    /// <summary>
    /// Exclusive end of the range the title describes. Week and Agenda titles cover
    /// <c>[RangeStart, RangeEnd − 1]</c>.
    /// </summary>
    [Parameter] public DateTime RangeEnd { get; set; }

    /// <summary>Fires when the user clicks a view button.</summary>
    [Parameter] public EventCallback<TmScheduleViewType> OnViewChange { get; set; }

    /// <summary>Fires when the user clicks Previous.</summary>
    [Parameter] public EventCallback OnPrev { get; set; }

    /// <summary>Fires when the user clicks Next.</summary>
    [Parameter] public EventCallback OnNext { get; set; }

    /// <summary>Fires when the user clicks Today.</summary>
    [Parameter] public EventCallback OnToday { get; set; }

    /// <summary>Whether to show the Print button.</summary>
    [Parameter] public bool ShowPrint { get; set; }

    /// <summary>Fires when the user clicks Print.</summary>
    [Parameter] public EventCallback OnPrint { get; set; }

    /// <summary>Views offered in the switcher, in the given order. Null offers every view.</summary>
    [Parameter] public IReadOnlyList<TmScheduleViewType>? Views { get; set; }

    /// <summary>Fires when the user clicks the add button. The button renders only when this has a delegate.</summary>
    [Parameter] public EventCallback OnAddClick { get; set; }

    /// <summary>Fires when the user picks a day in the title popover.</summary>
    [Parameter] public EventCallback<DateTime> OnDatePicked { get; set; }

    /// <summary>Host content rendered before the navigation group.</summary>
    [Parameter] public RenderFragment? HeaderStart { get; set; }

    /// <summary>Host content rendered after the view switcher, before the add button.</summary>
    [Parameter] public RenderFragment? HeaderActions { get; set; }

    /// <summary>When false, the toolbar renders nothing. Default true. For <c>TmScheduler</c> this row is the header.</summary>
    [Parameter] public bool ShowHeader { get; set; } = true;

    /// <summary>The day the calendar marks as today. The scheduler passes its display-zone today.</summary>
    [Parameter] public DateOnly Today { get; set; }

    /// <summary>Instance id shared with the scheduler body, so the body's tabpanel id matches the active tab.</summary>
    [Parameter] public string? InstanceId { get; set; }

    private string DisplayTitle
    {
        get
        {
            var culture = CultureInfo.CurrentUICulture;
            // No range handed in: title the same Monday-week / 30-day default the scheduler uses.
            var fallback = SchedulerRange.Visible(View, CurrentDate, new SchedulerRangeOptions(1, 30));
            var start = RangeStart == default ? fallback.Start : RangeStart.Date;
            var endInclusive = RangeEnd == default ? fallback.End.AddDays(-1) : RangeEnd.Date.AddDays(-1);
            return View switch
            {
                TmScheduleViewType.Day or TmScheduleViewType.Timeline => SchedulerRange.FormatDayTitle(start, culture),
                TmScheduleViewType.Week or TmScheduleViewType.Agenda => SchedulerRange.FormatRange(start, endInclusive, culture),
                TmScheduleViewType.Month => $"{culture.DateTimeFormat.GetMonthName(CurrentDate.Month)} {CurrentDate.Year}",
                _ => CurrentDate.ToString("MMMM yyyy", culture)
            };
        }
    }

    private Task SelectViewAsync(string tabId)
    {
        var view = OfferedViews.FirstOrDefault(v => TabId(v) == tabId);
        return OnViewChange.InvokeAsync(view);
    }

    private async Task PickDateAsync(DateOnly day)
    {
        _dateOpen = false;
        await OnDatePicked.InvokeAsync(day.ToDateTime(TimeOnly.MinValue));
        if (_datePopover is not null)
        {
            try { await _datePopover.FocusTriggerAsync(); }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
        }
    }

    private async Task FocusCalendarDayAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("TempoBlazor.Scheduler.focusCalendarDay", _titleRef);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
    }

    private Task HandleMoreAsync(string value)
        => value == "print" ? OnPrint.InvokeAsync() : Task.CompletedTask;

    private string GetViewLabel(TmScheduleViewType view) => view switch
    {
        TmScheduleViewType.Day => Loc["TmScheduler_Day"],
        TmScheduleViewType.Week => Loc["TmScheduler_Week"],
        TmScheduleViewType.Month => Loc["TmScheduler_Month"],
        TmScheduleViewType.Agenda => Loc["TmScheduler_Agenda"],
        TmScheduleViewType.Timeline => Loc["TmScheduler_Timeline"],
        _ => view.ToString()
    };
}
