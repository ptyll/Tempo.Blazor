@namespace Tempo.Blazor.Components.Scheduler
@inherits TmGanttPart
@using Tempo.Blazor.Abstractions.Models
@using Tempo.Blazor.Abstractions.Shared
@using Tempo.Blazor.Abstractions.WorkItems

@* The pan container is NOT a tab stop: the scrollable region of the axis is the body below (tabindex +
   role + label there), while the container keeps its pan cursor and the wheel handler. *@
<div class="tm-gantt__timeline"
     data-testid="@TestId("gantt-timeline")"
     @ref="Owner._timelineContainerRef"
     @onwheel="Owner.OnTimelineWheel">

    <!-- Two-row Timeline Header (ShowTimelineHeader=false hides the rows; the grid below stays,
         so the shared portfolio axis can render ONE header above the cards) -->
    @if (Owner.ShowTimelineHeader)
    {
        <div class="tm-gantt__timeline-header" style="width: @(F(Owner._totalTimelineWidth))px">
            <div class="tm-gantt__timeline-header--upper">
                @foreach (var h in Owner._upperHeaders)
                {
                    <div class="tm-gantt__timeline-header-cell tm-gantt__timeline-header-cell--upper"
                         style="left: @(F(h.Offset))px; width: @(F(h.Width))px">@h.Label</div>
                }
            </div>
            <div class="tm-gantt__timeline-header--lower">
                @foreach (var h in Owner._lowerHeaders)
                {
                    <div class="tm-gantt__timeline-header-cell tm-gantt__timeline-header-cell--lower"
                         style="left: @(F(h.Offset))px; width: @(F(h.Width))px">@h.Label</div>
                }
            </div>
            @if (Owner.ViewSettings.ShowTodayMarker)
            {
                <span class="tm-gantt__today-label" data-testid="@TestId("today-label")"
                      style="left: @(F(Owner._todayOffset))px">@Loc["TmGantt_Today"]</span>
            }
        </div>
    }
    else
    {
        @* ShowTimelineHeader=false (the shared portfolio axis renders ONE header above the cards): a
           zero-height carrier keeps the horizontal overflow — the header is what gives the scroller its
           scroll width (the body clips at overflow-x: hidden), so without it the card could not scroll
           with the shared axis. *@
        <div class="tm-gantt__timeline-header tm-gantt__timeline-header--carrier"
             style="width: @(F(Owner._totalTimelineWidth))px" aria-hidden="true"></div>
    }

    <!-- Timeline Body (the keyboard-reachable scroll region of the axis; the vertical scroll itself is the
         gantt.js session — no Blazor scroll binding) -->
    <div class="tm-gantt__timeline-body"
         @ref="Owner._timelineBodyRef"
         tabindex="0" role="region" aria-label="@Loc["TmGantt_TimelineAxis"]">
        <div class="tm-gantt__timeline-content"
             style="height: @(F(Owner._visibleNodes.Count * Owner.RowHeight))px; width: @(F(Owner._totalTimelineWidth))px">

            <!-- Non-working day overlays -->
            @if (Owner.ViewSettings.ShowDaysOff)
            {
                @foreach (var rect in Owner._nonWorkingRects)
                {
                    <div class="tm-gantt__nonworking-overlay"
                         data-testid="@TestId("nonworking-overlay")"
                         style="left: @(F(rect.Offset))px; width: @(F(rect.Width))px"></div>
                }
            }

            <!-- Grid lines -->
            <div class="tm-gantt__grid">
                @foreach (var header in Owner._timelineHeaders)
                {
                    <div class="tm-gantt__grid-line" style="left: @(F(header.Offset))px; width: @(F(header.Width))px"></div>
                }
            </div>

            <!-- Today marker -->
            @if (Owner.ViewSettings.ShowTodayMarker)
            {
                <div class="tm-gantt__today-marker"
                     data-testid="@TestId("today-marker")"
                     style="left: @(F(Owner._todayOffset))px"
                     title="@Loc["TmGantt_Today"]"></div>
            }

            <!-- Current time marker (Hours view only) -->
            @if (Owner.ZoomPreset == GanttZoomPreset.Hours)
            {
                <div class="tm-gantt__current-time-marker"
                     data-testid="@TestId("current-time-marker")"
                     style="left: @(F(Owner._currentTimeOffset))px"></div>
            }

            <!-- Dependency lines (SVG) -->
            <svg class="tm-gantt__dependencies" style="width: @(F(Owner._totalTimelineWidth))px; height: 100%">
                @foreach (var dep in Owner._visibleDependencies)
                {
                    @* Window virtualization: a line whose y-span crosses the window renders even with both of its
                       ends outside it, so a long dependency never vanishes while its middle row is on screen. *@
                    if (!Owner.IsDependencyInView(dep))
                    {
                        continue;
                    }
                    <line x1="@F(dep.X1)" y1="@F(dep.Y1)" x2="@F(dep.X2)" y2="@F(dep.Y2)"
                          class="@GetDepLineClass(dep)"
                          data-testid="@TestId($"dep-line-{dep.DependencyId}")"
                          @onclick:stopPropagation
                          @onclick="() => Owner.SelectDependency(dep.DependencyId)" />
                    <polygon points="@GetArrowPoints(dep.X2, dep.Y2)"
                             class="tm-gantt__dependency-arrow" />
                    @if (dep.LagDays != 0)
                    {
                        @((MarkupString)$"<text x=\"{F(dep.MidX)}\" y=\"{F(dep.MidY - 4)}\" class=\"tm-gantt__dep-lag-label\" data-testid=\"dep-lag-{dep.DependencyId}\" text-anchor=\"middle\">{(dep.LagDays > 0 ? "+" : "")}{dep.LagDays} d</text>")
                    }
                }
            </svg>

            <!-- Baseline ghost bars -->
            @if (Owner.ActiveBaselineId is not null)
            {
                @foreach (var bar in Owner._taskBars)
                {
                    if (!bar.BaselineLeft.HasValue || !Owner.IsBarInView(bar))
                    {
                        continue;
                    }
                    <div class="tm-gantt__bar tm-gantt__bar--baseline"
                         data-testid="@TestId($"ghost-bar-{bar.Task.Id}")"
                         style="left: @(F(bar.BaselineLeft!.Value))px; width: @(F(bar.BaselineWidth!.Value))px; top: @(F(bar.Top))px;"></div>
                }
            }

            <!-- Task bars (a bar clipped fully out of a pinned axis renders nothing: no ghost element to focus) -->
            @foreach (var bar in Owner._taskBars)
            {
                if (bar.Width <= 0)
                {
                    continue;
                }
                @* Window virtualization: only the bars of the rendered rows (plus a bar the keyboard asked to focus). *@
                if (!Owner.IsBarInView(bar))
                {
                    continue;
                }
                <div class="tm-gantt__task-row"
                     @key="bar.Task.Id"
                     style="top: @(F(bar.Top))px; height: @(Owner.RowHeight)px">
                    @if (bar.Task.IsMilestone)
                    {
                        <div class="tm-gantt__milestone"
                             @key="bar.Task.Id"
                             @ref="_barRefs[bar.Task.Id]"
                             role="button" tabindex="-1"
                             aria-label="@MilestoneLabel(bar)"
                             data-task-id="@bar.Task.Id"
                             style="left: @(F(bar.Left - 6))px"
                             title="@bar.Task.Title"
                             @onpointerup="e => Owner.NotePointerUp(e)"
                             @onclick="() => Owner.TapTaskAsync(bar.Task)"
                             @onkeydown="e => Owner.HandleBarKeyDownAsync(e, bar.Task)"
                             @onkeyup="e => Owner.HandleBarKeyUpAsync(e, bar.Task)">
                        </div>
                    }
                    else
                    {
                        <div class="tm-gantt__bar @GetBarClass(bar)"
                             @key="bar.Task.Id"
                             @ref="_barRefs[bar.Task.Id]"
                             role="button" tabindex="-1"
                             aria-label="@BarLabel(bar)"
                             data-testid="@TestId($"task-bar-{bar.Task.Id}")"
                             data-task-id="@bar.Task.Id"
                             style="left: @(F(bar.Left))px; width: @(F(bar.Width))px; @GetBarColorStyle(bar)"
                             title="@bar.Task.Title (@bar.Task.PercentComplete%)"
                             @onpointerup="e => Owner.NotePointerUp(e)"
                             @onclick="() => Owner.TapTaskAsync(bar.Task)"
                             @onkeydown="e => Owner.HandleBarKeyDownAsync(e, bar.Task)"
                             @onkeyup="e => Owner.HandleBarKeyUpAsync(e, bar.Task)">
                            <div class="tm-gantt__bar-progress" style="width: @(bar.Task.PercentComplete)%"></div>
                            @if (ShouldRenderBarLabel(bar))
                            {
                                <span class="tm-gantt__bar-label">@bar.Task.Title</span>
                            }

                            <!-- Assignee avatars (up to 3 + overflow) -->
                            @{
                                var assignees = bar.Task.Assignees ?? [];
                                var visibleAvatars = assignees.Take(3).ToList();
                                var overflowCount = assignees.Count - visibleAvatars.Count;
                            }
                            @if (visibleAvatars.Count > 0)
                            {
                                <div class="tm-gantt__bar-avatars">
                                    @foreach (var a in visibleAvatars)
                                    {
                                        @if (a.IsVirtual && string.IsNullOrEmpty(a.AvatarUrl))
                                        {
                                            <span class="tm-gantt__bar-avatar tm-gantt__bar-avatar--virtual"
                                                  data-testid="@($"bar-avatar-virtual-{a.Id}")"
                                                  title="@a.Name">
                                                <TmIcon Name="users" Size="IconSize.Xs" />
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="tm-gantt__bar-avatar"
                                                  style="@GetAvatarStyle(a)"
                                                  title="@a.Name">
                                                @if (string.IsNullOrEmpty(a.AvatarUrl))
                                                {
                                                    @GetAvatarInitial(a)
                                                }
                                            </span>
                                        }
                                    }
                                    @if (overflowCount > 0)
                                    {
                                        <span class="tm-gantt__bar-avatar-overflow">+@overflowCount</span>
                                    }
                                </div>
                            }

                            <!-- Dep creation handles -->
                            @if (Owner.AllowDependencyCreation && !Owner.IsMobileLayout)
                            {
                                @* Pointer sessions of gantt.js (core pointer-drag.js): the handle names its task and which end it starts from.
                                   Read-mostly (mobile): the linking drag is tablet+, so the handles do not render at all. *@
                                <span class="tm-gantt__dep-handle tm-gantt__dep-handle--start"
                                      data-task-id="@bar.Task.Id" data-dep-end="false"></span>
                                <span class="tm-gantt__dep-handle tm-gantt__dep-handle--end"
                                      data-task-id="@bar.Task.Id" data-dep-end="true"></span>
                            }

                            <!-- Hover tooltip -->
                            <div class="tm-gantt__bar-tooltip" data-testid="@TestId("bar-tooltip")">
                                <div class="tm-gantt__bar-tooltip-title">@bar.Task.Title</div>
                                <div class="tm-gantt__bar-tooltip-row">
                                    <span>@Loc["TmGantt_TooltipStart"]:</span>
                                    <span>@bar.Task.Start.ToString("dd.MM.yyyy")</span>
                                </div>
                                <div class="tm-gantt__bar-tooltip-row">
                                    <span>@Loc["TmGantt_TooltipEnd"]:</span>
                                    <span>@bar.Task.End.ToString("dd.MM.yyyy")</span>
                                </div>
                                <div class="tm-gantt__bar-tooltip-row">
                                    <span>@Loc["TmGantt_TooltipProgress"]:</span>
                                    <span>@bar.Task.PercentComplete%</span>
                                </div>
                            </div>
                            <!-- Deadline exceeded marker -->
                            @if (bar.IsDeadlineExceeded)
                            {
                                <span class="tm-gantt__bar-deadline" data-testid="@TestId("deadline-marker")" title="@Loc["GanttTask_DeadlineExceeded"]">
                                    <TmIcon Name="flame" Size="IconSize.Sm" />
                                </span>
                            }
                        </div>
                        @* A sibling of the bar, not a child: the completed bar is faded (opacity .6) and a
                           descendant label would be composited with it, so its contrast was measured against
                           a half-transparent ancestor. Placed from the geometry the bar already has. *@
                        @if (Owner.ShowBarProgressLabels)
                        {
                            <span class="tm-gantt__bar-progress-label @GetProgressLabelClass(bar)"
                                  data-testid="@TestId("bar-progress-label")"
                                  style="left: @(F(bar.Left + bar.Width))px">@(bar.Task.PercentComplete)%</span>
                        }
                    }
                </div>
            }
        </div>
    </div>
</div>
