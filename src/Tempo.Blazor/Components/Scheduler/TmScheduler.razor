@namespace Tempo.Blazor.Components.Scheduler
@implements IAsyncDisposable
@using Microsoft.Extensions.DependencyInjection
@using Tempo.Blazor.Interfaces
@using Tempo.Blazor.Models
@inject Microsoft.JSInterop.IJSRuntime JS

<div class="tm-scheduler @Class" @ref="_rootRef">
    <TmSchedulerToolbar View="@View"
                        CurrentDate="@CurrentDate"
                        RangeStart="@VisibleRange.Start"
                        RangeEnd="@VisibleRange.End"
                        OnViewChange="@HandleViewChange"
                        OnPrev="@NavigatePrev"
                        OnNext="@NavigateNext"
                        OnToday="@NavigateToday"
                        ShowPrint="@AllowPrint"
                        OnPrint="@PrintAsync" />

    <div class="tm-scheduler-body">
        @switch (View)
        {
            case TmScheduleViewType.Month:
                <TmSchedulerMonthView CurrentDate="@CurrentDate"
                                      Today="@TodayInDisplayZone()"
                                      Events="@_loadedEvents"
                                      MaxVisibleEvents="@MaxVisibleEvents"
                                      FirstDayOfWeek="@NormalizedFirstDay"
                                      ReadOnly="@ReadOnly"
                                      ShowAdjacentMonthEvents="@ShowAdjacentMonthEvents"
                                      HighlightWeekends="@HighlightWeekends"
                                      AllDayEventStyle="@AllDayEventStyle"
                                      OnSlotClick="@OnSlotClick"
                                      OnEventClick="@OnEventClick"
                                      OnEventChanged="@HandleEventChangedAsync"
                                      OnSlotContextMenu="@OnSlotContextMenu"
                                      OnEventContextMenu="@OnEventContextMenu"
                                      OnMoreClick="@HandleMoreClickAsync"
                                      CurrentDateChanged="@(CurrentDateChanged.HasDelegate ? HandleMonthKeyboardNavigateAsync : default)"
                                      EventTemplate="@EventTemplate" />
                break;

            case TmScheduleViewType.Day:
                <TmSchedulerDayView CurrentDate="@CurrentDate"
                                    Events="@_loadedEvents"
                                    Resources="@Resources"
                                    SlotDuration="@SlotDuration"
                                    ReadOnly="@ReadOnly"
                                    HideTimeGrid="@HideTimeGrid"
                                    Today="@DateOnly.FromDateTime(TodayInDisplayZone())"
                                    HighlightWeekends="@HighlightWeekends"
                                    AllDayEventStyle="@AllDayEventStyle"
                                    OnSlotClick="@OnSlotClick"
                                    OnEventClick="@OnEventClick"
                                    OnEventChanged="@HandleEventChangedAsync"
                                    OnSlotContextMenu="@OnSlotContextMenu"
                                    OnEventContextMenu="@OnEventContextMenu"
                                    EventTemplate="@EventTemplate" />
                break;

            case TmScheduleViewType.Week:
                <TmSchedulerWeekView CurrentDate="@CurrentDate"
                                     Events="@_loadedEvents"
                                     Resources="@Resources"
                                     FirstDayOfWeek="@NormalizedFirstDay"
                                     SlotDuration="@SlotDuration"
                                     ReadOnly="@ReadOnly"
                                     HideTimeGrid="@HideTimeGrid"
                                     Today="@DateOnly.FromDateTime(TodayInDisplayZone())"
                                     HighlightWeekends="@HighlightWeekends"
                                     AllDayEventStyle="@AllDayEventStyle"
                                     OnSlotClick="@OnSlotClick"
                                     OnEventClick="@OnEventClick"
                                     OnEventChanged="@HandleEventChangedAsync"
                                     OnSlotContextMenu="@OnSlotContextMenu"
                                     OnEventContextMenu="@OnEventContextMenu"
                                     EventTemplate="@EventTemplate" />
                break;

            case TmScheduleViewType.Agenda:
                <TmSchedulerAgendaView CurrentDate="@CurrentDate"
                                       AgendaDays="@NormalizedAgendaDays"
                                       Events="@_loadedEvents"
                                       OnEventClick="@OnEventClick"
                                       EventTemplate="@EventTemplate" />
                break;

            case TmScheduleViewType.Timeline:
                <TmSchedulerTimelineView CurrentDate="@CurrentDate"
                                         Events="@_loadedEvents"
                                         Resources="@Resources"
                                         SlotDuration="@SlotDuration"
                                         ReadOnly="@ReadOnly"
                                         OnSlotClick="@OnSlotClick"
                                         OnEventClick="@OnEventClick"
                                         OnEventChanged="@HandleEventChangedAsync"
                                         OnSlotContextMenu="@OnSlotContextMenu"
                                         OnEventContextMenu="@OnEventContextMenu"
                                         EventTemplate="@EventTemplate" />
                break;
        }
    </div>
</div>

@code {
    private IReadOnlyList<TmScheduleEvent> _loadedEvents = [];

    /// <summary>Service provider for the optional user-zone lookups (never a required dependency).</summary>
    [Inject] private IServiceProvider Services { get; set; } = default!;

    /// <summary>Client-side event list. Alternative to DataProvider.</summary>
    [Parameter] public IReadOnlyList<TmScheduleEvent>? Events { get; set; }

    /// <summary>Server-side calendar-event provider. Takes priority over Events if both are set.</summary>
    [Parameter] public IScheduleDataProvider? DataProvider { get; set; }

    /// <summary>
    /// Unified work-item source shared with other components (Gantt, Notion). When set (and no
    /// <see cref="DataProvider"/> is given), scheduled work items overlapping the visible range are
    /// loaded and shown as calendar events, and drag/resize changes are persisted back through it
    /// (when the provider declares the Update capability).
    /// </summary>
    [Parameter] public ITmWorkItemProvider? WorkItemSource { get; set; }

    /// <summary>Active view type.</summary>
    [Parameter] public TmScheduleViewType View { get; set; } = TmScheduleViewType.Month;

    /// <summary>Fires when the view type changes.</summary>
    [Parameter] public EventCallback<TmScheduleViewType> ViewChanged { get; set; }

    /// <summary>Currently displayed date (determines visible range).</summary>
    [Parameter] public DateTime CurrentDate { get; set; } = DateTime.Today;

    /// <summary>Fires when navigation changes the date.</summary>
    [Parameter] public EventCallback<DateTime> CurrentDateChanged { get; set; }

    /// <summary>Currently selected date.</summary>
    [Parameter] public DateTime? SelectedDate { get; set; }

    /// <summary>Fires when a date is selected.</summary>
    [Parameter] public EventCallback<DateTime?> SelectedDateChanged { get; set; }

    /// <summary>Fires when an event is clicked.</summary>
    [Parameter] public EventCallback<TmScheduleEvent> OnEventClick { get; set; }

    /// <summary>Fires when an empty time slot is clicked.</summary>
    [Parameter] public EventCallback<(DateTime Start, DateTime End)> OnSlotClick { get; set; }

    /// <summary>Fires after an event is moved or resized via drag and drop.</summary>
    [Parameter] public EventCallback<TmScheduleEvent> OnEventChanged { get; set; }

    /// <summary>Fires when right-clicking on an empty time slot.</summary>
    [Parameter] public EventCallback<SchedulerSlotContext> OnSlotContextMenu { get; set; }

    /// <summary>Fires when right-clicking on an event.</summary>
    [Parameter] public EventCallback<SchedulerEventContext> OnEventContextMenu { get; set; }

    /// <summary>Resources for grouping (timeline/resource views).</summary>
    [Parameter] public IReadOnlyList<TmScheduleResource>? Resources { get; set; }

    /// <summary>
    /// First day of the week (0 = Sunday, 1 = Monday, …, 6 = Saturday). Default: 1 (Monday).
    /// Drives the month grid, the week range and the week title together; values outside 0–6 wrap.
    /// </summary>
    [Parameter] public int FirstDayOfWeek { get; set; } = 1;

    /// <summary>Work day start time.</summary>
    [Parameter] public TimeOnly WorkDayStart { get; set; } = new(8, 0);

    /// <summary>Work day end time.</summary>
    [Parameter] public TimeOnly WorkDayEnd { get; set; } = new(17, 0);

    /// <summary>Slot duration in minutes for day/week views.</summary>
    [Parameter] public int SlotDuration { get; set; } = 30;

    /// <summary>Whether events are read-only (no drag/resize).</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>When true, hides the hourly time grid body in Day and Week views (only column headers and all-day row are shown).</summary>
    [Parameter] public bool HideTimeGrid { get; set; }

    /// <summary>When true, events are rendered in adjacent-month day cells visible in the month grid. Default: true.</summary>
    [Parameter] public bool ShowAdjacentMonthEvents { get; set; } = true;

    /// <summary>
    /// When true, Saturday and Sunday cells (month) and columns (day/week) get
    /// <c>tm-scheduler-month-day--weekend</c> / <c>tm-scheduler-timegrid-col--weekend</c>.
    /// Default false, so an existing host keeps the previous unmarked grid.
    /// </summary>
    [Parameter] public bool HighlightWeekends { get; set; }

    /// <summary>
    /// Paint of an all-day event. <see cref="TmAllDayEventStyle.Solid"/> (the default) keeps the
    /// historical solid fill. <see cref="TmAllDayEventStyle.Tinted"/> uses the shared tinted surface
    /// and adds <c>tm-scheduler-event--tinted</c>.
    /// </summary>
    [Parameter] public TmAllDayEventStyle AllDayEventStyle { get; set; } = TmAllDayEventStyle.Solid;

    /// <summary>Custom event template. Replaces the inner content of an event in every view (month, day, week, agenda, timeline); the positioning wrapper and resize handles stay.</summary>
    [Parameter] public RenderFragment<TmScheduleEvent>? EventTemplate { get; set; }

    /// <summary>Number of days the Agenda view loads, renders and navigates by. Default: 30.</summary>
    [Parameter] public int AgendaDays { get; set; } = 30;

    /// <summary>Maximum events shown in a month day cell before "+N more". Default: 3.</summary>
    [Parameter] public int MaxVisibleEvents { get; set; } = 3;

    /// <summary>
    /// Fires when the "+N more" button of a month day cell is activated, with that day's date.
    /// Without a delegate the scheduler opens that day in the Day view, but only when the host binds
    /// both <c>@bind-View</c> and <c>@bind-CurrentDate</c>; with either binding missing the click is inert.
    /// </summary>
    [Parameter] public EventCallback<DateTime> OnMoreClick { get; set; }

    /// <summary>Additional CSS class(es).</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Whether the toolbar shows a Print button (uses the browser print dialog with print CSS). Default: true.</summary>
    [Parameter] public bool AllowPrint { get; set; } = true;

    /// <summary>Opens the browser print dialog; the scheduler's print stylesheet lays out the current view for paper.</summary>
    public async Task PrintAsync()
    {
        try { await JS.InvokeVoidAsync("window.print"); }
        catch { /* JS unavailable (e.g. tests) */ }
    }

    /// <summary>
    /// Display timezone (IANA id such as <c>Europe/Prague</c>, or a Windows id). When set, event times
    /// are converted to this zone at the render boundary (DST-aware). When null, the machine-local
    /// timezone is used and non-recurring events are passed through unchanged for backward compatibility.
    /// </summary>
    [Parameter] public string? TimeZoneId { get; set; }

    /// <summary>
    /// Resolves the effective display timezone: an explicitly set <see cref="TimeZoneId"/> wins;
    /// otherwise the circuit's <see cref="ITmUserTimeZone"/> — the browser's zone (UTC on Blazor
    /// Server until the probe reports after the first interactive render, the runtime's zone on
    /// WebAssembly) — and the machine-local zone only when no <see cref="ITmUserTimeZone"/> is
    /// registered (a bare test context).
    /// </summary>
    public TimeZoneInfo ResolveTimeZone()
    {
        if (!string.IsNullOrWhiteSpace(TimeZoneId)
            && TimeZoneInfo.TryFindSystemTimeZoneById(TimeZoneId, out var tz))
        {
            return tz;
        }

        return Services.GetService<ITmUserTimeZone>()?.Zone ?? Clock.LocalTimeZone;
    }

    /// <summary>
    /// Clock behind "Today" and every other "now" computation. Resolved through
    /// <see cref="IServiceProvider"/> so a consumer that never registers a <see cref="TimeProvider"/>
    /// still gets <see cref="TimeProvider.System"/> — a bare <c>[Inject] TimeProvider</c> would throw
    /// for exactly those consumers. Tests register a FakeTimeProvider.
    /// </summary>
    private TimeProvider Clock
        => _clock ??= Services.GetService(typeof(TimeProvider)) as TimeProvider ?? TimeProvider.System;
    private TimeProvider? _clock;

    /// <summary>Today's date in the display zone ("Today" navigation), taken from <see cref="Clock"/>.</summary>
    private DateTime TodayInDisplayZone()
        => TimeZoneInfo.ConvertTime(Clock.GetUtcNow(), ResolveTimeZone()).Date;

    protected override async Task OnParametersSetAsync()
    {
        await LoadEventsAsync();
    }

    /// <summary>Re-renders once the user zone arrives (the browser probe is Server-only and one-shot).</summary>
    private TmUserZoneObserver? _userZoneObserver;

    /// <summary>Triggers the one-time browser zone probe after the first interactive render.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _userZoneObserver ??= TmUserZoneObserver.Subscribe(Services, RefreshAfterZoneChange);
            if (_userZoneObserver is not null)
            {
                await _userZoneObserver.ProbeAsync();
            }

            // One guard per scheduler, attached to the root. A later render reuses it.
            try
            {
                await JS.InvokeVoidAsync("TempoBlazor.Scheduler.attachScrollGuard", _rootRef);
                _scrollGuardAttached = true;
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
            {
                // Without the script the arrows still move; only the page scroll comes back.
            }
        }
    }

    private Task RefreshAfterZoneChange() => InvokeAsync(async () =>
    {
        // The zone only changes how LOCALLY-owned data renders: the plain Events list is
        // renormalized in process, so it reloads. The provider and work-item paths own their range
        // filtering server-side and (with no explicit TimeZoneId) are not normalized here —
        // re-querying them because the browser reported its zone would be a surprise extra call.
        if (string.IsNullOrWhiteSpace(TimeZoneId)
            && DataProvider is null
            && WorkItemSource is null
            && Events is not null)
        {
            await LoadEventsAsync();
        }

        StateHasChanged();
    });

    /// <summary>Unsubscribes from the user zone and removes the scroll guard.</summary>
    public async ValueTask DisposeAsync()
    {
        _userZoneObserver?.Dispose();
        if (!_scrollGuardAttached) return;
        try
        {
            await JS.InvokeVoidAsync("TempoBlazor.Scheduler.detachScrollGuard", _rootRef);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            // The circuit is already gone, so there is no listener left to remove.
        }
    }

    private ElementReference _rootRef;
    private bool _scrollGuardAttached;

    private async Task LoadEventsAsync()
    {
        var (rangeStart, rangeEnd) = VisibleRange;
        var tz = ResolveTimeZone();
        var normalize = !string.IsNullOrWhiteSpace(TimeZoneId);

        if (DataProvider is not null)
        {
            // The provider owns range filtering and recurrence expansion; only convert timezone here.
            var events = await DataProvider.GetEventsAsync(new TmScheduleQuery(rangeStart, rangeEnd));
            _loadedEvents = normalize ? events.Select(e => Normalize(e, tz)).ToList() : events;
        }
        else if (WorkItemSource is not null)
        {
            var result = await WorkItemSource.SearchAsync(new TmWorkItemQuery
            {
                RangeStart = rangeStart,
                RangeEnd = rangeEnd,
                IncludeCompleted = true,
                Take = 1000
            });
            var mapped = result.Items
                .Where(w => w.Start < rangeEnd && w.End > rangeStart)
                .Select(MapToEvent);
            _loadedEvents = normalize ? mapped.Select(e => Normalize(e, tz)).ToList() : mapped.ToList();
        }
        else if (Events is not null)
        {
            _loadedEvents = ProcessEvents(Events, tz, normalize, rangeStart, rangeEnd);
        }
        else
        {
            _loadedEvents = [];
        }
    }

    /// <summary>
    /// Normalizes plain client events to the display timezone and expands recurring events into
    /// occurrences within the visible range (the plain <see cref="Events"/> path expands recurrence).
    /// </summary>
    private List<TmScheduleEvent> ProcessEvents(
        IEnumerable<TmScheduleEvent> raw, TimeZoneInfo tz, bool normalize, DateTime rangeStart, DateTime rangeEnd)
    {
        var result = new List<TmScheduleEvent>();
        foreach (var e in raw)
        {
            if (!string.IsNullOrWhiteSpace(e.RecurrenceRule))
            {
                var source = normalize ? Normalize(e, tz) : e;
                result.AddRange(RecurrenceEngine.ExpandRecurrence(source, rangeStart, rangeEnd, tz));
            }
            else
            {
                var display = normalize ? Normalize(e, tz) : e;
                if (display.StartLocal < rangeEnd && display.EndLocal > rangeStart)
                {
                    result.Add(display);
                }
            }
        }

        return result;
    }

    private static TmScheduleEvent Normalize(TmScheduleEvent e, TimeZoneInfo tz) => new()
    {
        Id = e.Id,
        Title = e.Title,
        Description = e.Description,
        // All-day events are floating dates and must not shift across midnight on timezone conversion.
        Start = e.AllDay ? e.Start : TimeZoneInfo.ConvertTime(e.Start, tz),
        End = e.AllDay ? e.End : TimeZoneInfo.ConvertTime(e.End, tz),
        AllDay = e.AllDay,
        Color = e.Color,
        CssClass = e.CssClass,
        ResourceId = e.ResourceId,
        RecurrenceRule = e.RecurrenceRule,
        RecurrenceExceptions = e.RecurrenceExceptions,
        IsReadOnly = e.IsReadOnly,
        Metadata = e.Metadata
    };

    private static TmScheduleEvent MapToEvent(TmWorkItem item) => new()
    {
        Id = item.Id,
        Title = item.Title,
        Start = item.Start,
        End = item.End,
        Description = item.Description,
        Color = item.Color ?? item.StatusColor
    };

    private async Task HandleEventChangedAsync(TmScheduleEvent e)
    {
        if (WorkItemSource is not null && WorkItemSource.Capabilities.HasFlag(TmWorkItemCapabilities.Update))
        {
            var item = await WorkItemSource.GetByIdAsync(e.Id);
            if (item is not null)
            {
                item.Start = e.StartLocal;
                item.End = e.EndLocal;
                await WorkItemSource.UpdateAsync(item);
                await LoadEventsAsync();
            }
        }

        await OnEventChanged.InvokeAsync(e);
    }

    /// <summary>The week start normalized to 0..6, shared by the grid, the range and the title.</summary>
    private int NormalizedFirstDay => SchedulerRange.NormalizeFirstDay(FirstDayOfWeek);

    /// <summary>The agenda length clamped to at least one day, shared by the load, the view and the title.</summary>
    private int NormalizedAgendaDays => SchedulerRange.NormalizeAgendaDays(AgendaDays);

    /// <summary>The one range this render loads, titles and hands to the view.</summary>
    private SchedulerRangeOptions RangeOptions => new(NormalizedFirstDay, NormalizedAgendaDays);

    private (DateTime Start, DateTime End) VisibleRange
        => SchedulerRange.Visible(View, CurrentDate, RangeOptions);

    private async Task HandleViewChange(TmScheduleViewType newView)
    {
        await ViewChanged.InvokeAsync(newView);
    }

    private async Task NavigatePrev()
    {
        await CurrentDateChanged.InvokeAsync(SchedulerRange.Step(View, CurrentDate, -1, RangeOptions));
    }

    private async Task NavigateNext()
    {
        await CurrentDateChanged.InvokeAsync(SchedulerRange.Step(View, CurrentDate, 1, RangeOptions));
    }

    private Task HandleMonthKeyboardNavigateAsync(DateTime date)
        => CurrentDateChanged.InvokeAsync(date.Date);

    private async Task NavigateToday()
    {
        await CurrentDateChanged.InvokeAsync(TodayInDisplayZone());
    }

    /// <summary>
    /// "+N more": a host delegate wins; without one the scheduler opens that day in the Day view.
    /// </summary>
    private async Task HandleMoreClickAsync(DateTime day)
    {
        if (OnMoreClick.HasDelegate)
        {
            await OnMoreClick.InvokeAsync(day);
            return;
        }

        // The fallback only helps a host that bound both callbacks; with one missing the click is
        // inert, so the month stays put instead of half-switching.
        if (!CurrentDateChanged.HasDelegate || !ViewChanged.HasDelegate)
        {
            return;
        }

        // The date moves first, so a host that reloads on each callback never queries the old date
        // in the new view.
        await CurrentDateChanged.InvokeAsync(day.Date);
        await ViewChanged.InvokeAsync(TmScheduleViewType.Day);
    }
}
