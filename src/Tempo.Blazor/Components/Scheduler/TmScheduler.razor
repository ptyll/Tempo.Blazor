@namespace Tempo.Blazor.Components.Scheduler
@inherits Tempo.Blazor.Components.TmComponentBase
@implements IAsyncDisposable
@using Microsoft.Extensions.DependencyInjection
@using Tempo.Blazor.Abstractions.Layout
@using Tempo.Blazor.Components.Actions
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Inputs
@using Tempo.Blazor.Components.Layout
@using Tempo.Blazor.Components.Overlay
@using Tempo.Blazor.Interfaces
@using Tempo.Blazor.Models
@inject Microsoft.JSInterop.IJSRuntime JS

<TmLayoutObserver LayoutMode="EffectiveLayoutMode" IsContainer="false" Class="tm-scheduler-layout">
<LayoutContent Context="mode">
<div class="tm-scheduler @(mode.IsMobile ? "tm-scheduler--mobile" : mode.IsTablet ? "tm-scheduler--tablet" : "tm-scheduler--desktop") @Class" data-layout="@mode.CssModifier" @ref="_rootRef">
    <TmSchedulerToolbar @ref="_toolbar" View="@View"
                        Views="@Views"
                        CurrentDate="@EffectiveDate"
                        RangeStart="@VisibleRange.Start"
                        RangeEnd="@VisibleRange.End"
                        ShowHeader="@ShowHeader"
                        OnAddClick="@OnAddClick"
                        Today="@DateOnly.FromDateTime(TodayInDisplayZone())"
                        HeaderStart="@HeaderStart"
                        HeaderActions="@HeaderActions"
                        ResourceFilter="@ResourceFilter(mode)"
                        OnViewChange="@HandleViewChange"
                        OnPrev="@NavigatePrev"
                        OnNext="@NavigateNext"
                        OnToday="@NavigateToday"
                        OnDatePicked="@NavigateToPickedDate"
                        ShowPrint="@AllowPrint"
                        OnPrint="@PrintAsync"
                        InstanceId="@_instanceId"
                        LayoutMode="@mode.Resolved"
                        HasActionBar="@(MobileActionBar == TmSchedulerMobileActionBar.Auto && mode.IsMobile)" />

    @if (ShowTouchHint)
    {
        <p class="tm-scheduler-touch-hint">@Loc["TmScheduler_TouchHint"]</p>
    }

    @* The frame only exists to sit a docked panel beside the body. With both slots unset the body
       stays a direct child of the scheduler, which is the markup a host had before. *@
    @if (HasPanel)
    {
        <div class="tm-scheduler-frame">
            @SchedulerBody(mode)
            @if (PanelContent is not null)
            {
                @* Auto, never mode.Resolved. Passing the observer's resolved mode forces a layout, and a
                   forced ancestor wins over the panel's own measurement — a narrow container would stay
                   docked. The panel measures itself (container) and its sheet measures the viewport. *@
                <TmSidePanel Presentation="SidePanelPresentation.Auto"
                             Open="@PanelOpen"
                             OpenChanged="HandlePanelOpenChanged"
                             CloseOnEscape="true"
                             Side="SidePanelSide.Right"
                             Title="@PanelTitle"
                             RestoreFocusTargetId="@null"
                             Class="tm-scheduler-side-panel">
                    @PanelContent
                </TmSidePanel>
            }
        </div>
    }
    else
    {
        @SchedulerBody(mode)
    }
    <div class="tm-sr-only" role="status" aria-live="polite">@_announcement</div>
    @if (MobileActionBar == TmSchedulerMobileActionBar.Auto && mode.IsMobile)
    {
        <TmMobileActionBar Items="@ActionBarItems(mode)"
                           AriaLabel="@Loc["TmScheduler_ActionBar"]"
                           Placement="ActionBarPlacement.StickyContainer"
                           LayoutMode="TmLayoutMode.Mobile" />
    }
</div>
</LayoutContent>
</TmLayoutObserver>

@code {
    private IReadOnlyList<TmScheduleEvent> _loadedEvents = [];
    private string? _announcement;

    /// <summary>Service provider for the optional user-zone lookups (never a required dependency).</summary>
    [Inject] private IServiceProvider Services { get; set; } = default!;

    /// <summary>Client-side event list. Alternative to DataProvider.</summary>
    [Parameter] public IReadOnlyList<TmScheduleEvent>? Events { get; set; }

    /// <summary>Server-side calendar-event provider. Takes priority over Events if both are set.</summary>
    [Parameter] public IScheduleDataProvider? DataProvider { get; set; }

    /// <summary>
    /// Unified work-item source shared with other components (Gantt, Notion). When set (and no
    /// <see cref="DataProvider"/> is given), scheduled work items overlapping the visible range are
    /// loaded and shown as calendar events, and drag/resize changes are persisted back through it
    /// (when the provider declares the Update capability).
    /// </summary>
    [Parameter] public ITmWorkItemProvider? WorkItemSource { get; set; }

    /// <summary>Active view type.</summary>
    [Parameter] public TmScheduleViewType View { get; set; } = TmScheduleViewType.Month;

    /// <summary>Fires when the view type changes.</summary>
    [Parameter] public EventCallback<TmScheduleViewType> ViewChanged { get; set; }

    /// <summary>Currently displayed date (determines visible range). Defaults to today in the display zone.</summary>
    [Parameter] public DateTime CurrentDate { get; set; }

    /// <summary>Fires when navigation changes the date.</summary>
    [Parameter] public EventCallback<DateTime> CurrentDateChanged { get; set; }

    /// <summary>Currently selected date.</summary>
    [Parameter] public DateTime? SelectedDate { get; set; }

    /// <summary>Fires when a date is selected.</summary>
    [Parameter] public EventCallback<DateTime?> SelectedDateChanged { get; set; }

    /// <summary>Fires when an event is clicked.</summary>
    [Parameter] public EventCallback<TmScheduleEvent> OnEventClick { get; set; }

    /// <summary>
    /// The selected event, matched by <see cref="TmScheduleEvent.Id"/>. The matching event gets
    /// <c>aria-current="true"</c> and a <c>--selected</c> class. A day or slot click selects the day
    /// and does not clear this.
    /// </summary>
    [Parameter] public TmScheduleEvent? SelectedEvent { get; set; }

    /// <summary>Fires when the user selects an event.</summary>
    [Parameter] public EventCallback<TmScheduleEvent?> SelectedEventChanged { get; set; }

    /// <summary>
    /// Host content for the right-hand panel. Rendered through the core <c>TmSidePanel</c>
    /// (<c>Presentation = Auto</c>): docked on the right on desktop, a side sheet on tablet, a bottom
    /// sheet on mobile. Null renders nothing, so the default markup is unchanged.
    /// </summary>
    [Parameter] public RenderFragment? SidePanel { get; set; }

    /// <summary>
    /// Detail of the selected event, rendered in the same <c>TmSidePanel</c> as <see cref="SidePanel"/>.
    /// An event click opens it; Escape (or the panel close) closes it and returns focus to that event.
    /// The host supplies the body — the scheduler never invents attendees, RSVP or categories.
    /// </summary>
    [Parameter] public RenderFragment<TmScheduleEvent>? EventDetailTemplate { get; set; }

    /// <summary>
    /// Accessible title of the docked panel header when no event detail is showing. Null uses the
    /// localized default (<c>TmSidePanel_DefaultTitle</c>, "Side panel"), so the header is never just
    /// the close button. An open detail replaces it with <c>TmScheduler_EventDetail</c>.
    /// </summary>
    [Parameter] public string? SidePanelTitle { get; set; }

    /// <summary>
    /// Whether the side panel is open. Two-way with <see cref="SidePanelOpenChanged"/>. An event click
    /// opens it when <see cref="EventDetailTemplate"/> is set; closing it clears that detail.
    /// </summary>
    [Parameter] public bool SidePanelOpen { get; set; }

    /// <summary>Fires when the side panel opens or closes.</summary>
    [Parameter] public EventCallback<bool> SidePanelOpenChanged { get; set; }

    /// <summary>
    /// Resource ids the views keep. An empty list (the default) keeps every resource and every event.
    /// A non-empty list keeps Timeline rows, TimeGrid resource columns, and Month and Agenda events
    /// whose <see cref="TmScheduleEvent.ResourceId"/> is in the list. A list whose ids match no known
    /// resource is not a filter either: it keeps every event, so a stale selection hides nothing.
    /// </summary>
    [Parameter] public IReadOnlyList<string> SelectedResourceIds { get; set; } = [];

    /// <summary>Fires when the built-in resource filter changes the selection.</summary>
    [Parameter] public EventCallback<IReadOnlyList<string>> SelectedResourceIdsChanged { get; set; }

    /// <summary>
    /// When true, and <see cref="Resources"/> has entries, the toolbar offers the core resource filter
    /// ("Resources ▾", <c>data-tm-group="filter"</c>). On mobile the popup is the F3 bottom sheet.
    /// Default false, so an existing toolbar is unchanged.
    /// </summary>
    [Parameter] public bool ShowResourceFilter { get; set; }

    /// <summary>Fires when an empty time slot is clicked.</summary>
    [Parameter] public EventCallback<(DateTime Start, DateTime End)> OnSlotClick { get; set; }

    /// <summary>Fires after an event is moved or resized via drag and drop.</summary>
    [Parameter] public EventCallback<TmScheduleEvent> OnEventChanged { get; set; }

    /// <summary>Fires when right-clicking on an empty time slot.</summary>
    [Parameter] public EventCallback<SchedulerSlotContext> OnSlotContextMenu { get; set; }

    /// <summary>Fires when right-clicking on an event.</summary>
    [Parameter] public EventCallback<SchedulerEventContext> OnEventContextMenu { get; set; }

    /// <summary>Resources for grouping (timeline/resource views).</summary>
    [Parameter] public IReadOnlyList<TmScheduleResource>? Resources { get; set; }

    /// <summary>
    /// First day of the week (0 = Sunday, 1 = Monday, …, 6 = Saturday). Default: 1 (Monday).
    /// Drives the month grid, the week range and the week title together; values outside 0–6 wrap.
    /// </summary>
    [Parameter] public int FirstDayOfWeek { get; set; } = 1;

    /// <summary>Work day start time.</summary>
    [Parameter] public TimeOnly WorkDayStart { get; set; } = new(8, 0);

    /// <summary>Work day end time.</summary>
    [Parameter] public TimeOnly WorkDayEnd { get; set; } = new(17, 0);

    /// <summary>Slot duration in minutes for day/week views.</summary>
    [Parameter] public int SlotDuration { get; set; } = 30;

    /// <summary>Whether events are read-only (no drag/resize).</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>When true, hides the hourly time grid body in Day and Week views (only column headers and all-day row are shown).</summary>
    [Parameter] public bool HideTimeGrid { get; set; }

    /// <summary>When true, events are rendered in adjacent-month day cells visible in the month grid. Default: true.</summary>
    [Parameter] public bool ShowAdjacentMonthEvents { get; set; } = true;

    /// <summary>
    /// When true, Saturday and Sunday cells (month) and columns (day/week) get
    /// <c>tm-scheduler-month-day--weekend</c> / <c>tm-scheduler-timegrid-col--weekend</c>.
    /// Default false, so an existing host keeps the previous unmarked grid.
    /// </summary>
    [Parameter] public bool HighlightWeekends { get; set; }

    /// <summary>
    /// Paint of an all-day event. <see cref="TmAllDayEventStyle.Solid"/> (the default) keeps the
    /// historical solid fill. <see cref="TmAllDayEventStyle.Tinted"/> uses the shared tinted surface
    /// and adds <c>tm-scheduler-event--tinted</c>.
    /// </summary>
    [Parameter] public TmAllDayEventStyle AllDayEventStyle { get; set; } = TmAllDayEventStyle.Solid;

    /// <summary>Custom event template. Replaces the inner content of an event in every view (month, day, week, agenda, timeline); the positioning wrapper and resize handles stay.</summary>
    [Parameter] public RenderFragment<TmScheduleEvent>? EventTemplate { get; set; }

    /// <summary>Number of days the Agenda view loads, renders and navigates by. Default: 30.</summary>
    [Parameter] public int AgendaDays { get; set; } = 30;

    /// <summary>Maximum events shown in a month day cell before "+N more". Default: 3.</summary>
    [Parameter] public int MaxVisibleEvents { get; set; } = 3;

    /// <summary>
    /// Maximum events shown in a month day cell on a mobile layout. Default: 1, so a phone cell keeps
    /// one chip and the "+N more" link. Desktop and tablet keep <see cref="MaxVisibleEvents"/>.
    /// </summary>
    [Parameter] public int CompactMaxVisibleEvents { get; set; } = 1;

    /// <summary>The cap a mobile month cell uses. A negative host value clamps to zero.</summary>
    private int EffectiveCompactCap => Math.Max(0, CompactMaxVisibleEvents);

    /// <summary>
    /// Pins the scheduler's layout. <see cref="TmLayoutMode.Auto"/> measures the scheduler's own
    /// container; a forced value renders that layout without a DOM measurement, which is what a test uses.
    /// </summary>
    [Parameter] public TmLayoutMode LayoutMode { get; set; } = TmLayoutMode.Auto;

    /// <summary>
    /// The mobile action bar. <see cref="TmSchedulerMobileActionBar.None"/> (default) renders nothing,
    /// so an existing host is unchanged. <see cref="TmSchedulerMobileActionBar.Auto"/> renders the bar
    /// on a mobile layout only.
    /// </summary>
    [Parameter] public TmSchedulerMobileActionBar MobileActionBar { get; set; } = TmSchedulerMobileActionBar.None;

    /// <summary>
    /// Fires when the "+N more" button of a month day cell is activated, with that day's date.
    /// Without a delegate the scheduler opens that day in the Day view, but only when the host binds
    /// both <c>@bind-View</c> and <c>@bind-CurrentDate</c>; with either binding missing the click is inert.
    /// </summary>
    [Parameter] public EventCallback<DateTime> OnMoreClick { get; set; }

    /// <summary>Additional CSS class(es).</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Whether the toolbar shows a Print button (uses the browser print dialog with print CSS). Default: true.</summary>
    [Parameter] public bool AllowPrint { get; set; } = true;

    /// <summary>Views offered in the toolbar switcher. Null offers every view.</summary>
    [Parameter] public IReadOnlyList<TmScheduleViewType>? Views { get; set; }

    /// <summary>Host content rendered before the navigation group.</summary>
    [Parameter] public RenderFragment? HeaderStart { get; set; }

    /// <summary>Host content rendered after the view switcher, before the overflow menu.</summary>
    [Parameter] public RenderFragment? HeaderActions { get; set; }

    /// <summary>When false, the toolbar row — which is this component's header — is not rendered. Default true.</summary>
    [Parameter] public bool ShowHeader { get; set; } = true;

    /// <summary>Fires when the user clicks the add button. The button renders only when a delegate is bound.</summary>
    [Parameter] public EventCallback OnAddClick { get; set; }

    /// <summary>Which days the week view renders. <see cref="TmSchedulerWeekDays.WorkWeek"/> hides the weekend.</summary>
    [Parameter] public TmSchedulerWeekDays WeekDays { get; set; } = TmSchedulerWeekDays.FullWeek;

    /// <summary>How many weeks the month grid renders. <see cref="TmSchedulerMonthWeeks.Auto"/> drops an empty trailing week.</summary>
    [Parameter] public TmSchedulerMonthWeeks MonthWeeks { get; set; } = TmSchedulerMonthWeeks.Six;

    /// <summary>When false, Day, Week and Timeline render only the working hours. Default true, the full day.</summary>
    [Parameter] public bool ShowFullDay { get; set; } = true;

    /// <summary>When true, slots outside the working day are tinted. Default false, so a full day stays unmarked.</summary>
    [Parameter] public bool HighlightOffHours { get; set; }

    /// <summary>When set, Day, Week and Timeline scroll this time into view after the first render. Null does not scroll.</summary>
    [Parameter] public TimeSpan? ScrollToTime { get; set; }

    /// <summary>When true, today's column draws the current-time indicator. Default true.</summary>
    [Parameter] public bool ShowNowIndicator { get; set; } = true;

    /// <summary>Replaces the default resource header in the time grid and the timeline.</summary>
    [Parameter] public RenderFragment<TmScheduleResource>? ResourceHeaderTemplate { get; set; }

    /// <summary>When true, a timed event names its resource under the title.</summary>
    [Parameter] public bool ShowEventResource { get; set; }

    /// <summary>
    /// When true, a touch hint renders under the toolbar. It is visible only on a coarse pointer
    /// with no hover (<c>(hover: none) and (pointer: coarse)</c>). Default false: a host opts in.
    /// </summary>
    [Parameter] public bool ShowTouchHint { get; set; }

    /// <summary>
    /// Opens the browser print dialog. Print always lays out the desktop view, even from a phone:
    /// the observer is pinned to <see cref="TmLayoutMode.Desktop"/>, one render is awaited so the
    /// desktop markup is in the DOM, then <c>window.print</c> runs and the pin is released.
    /// </summary>
    public async Task PrintAsync()
    {
        _printing = true;
        var rendered = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        _printRendered = rendered;
        StateHasChanged();
        try
        {
            await rendered.Task.WaitAsync(TimeSpan.FromSeconds(2));
        }
        catch (TimeoutException)
        {
            // A test host, or a render that never reached OnAfterRender, must not hang the print.
        }

        try { await JS.InvokeVoidAsync("window.print"); }
        catch { /* JS unavailable (e.g. tests) */ }
        finally
        {
            _printing = false;
            _printRendered = null;
            StateHasChanged();
        }
    }

    private bool _printing;
    private TaskCompletionSource? _printRendered;
    private TmSchedulerToolbar? _toolbar;
    private DotNetObjectReference<TmScheduler>? _printRef;

    /// <summary>The layout the observer measures, unless a print is forcing the desktop view.</summary>
    private TmLayoutMode EffectiveLayoutMode => _printing ? TmLayoutMode.Desktop : LayoutMode;

    /// <summary>
    /// The browser's <c>beforeprint</c> / <c>afterprint</c> (wired by <c>scheduler.js</c>). Additive:
    /// existing <c>[JSInvokable]</c> signatures on the views are unchanged. A host that calls
    /// <see cref="PrintAsync"/> already pinned desktop, so this only covers Ctrl+P.
    /// </summary>
    [JSInvokable]
    public Task OnPrintMediaAsync(bool printing)
    {
        _printing = printing;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Display timezone (IANA id such as <c>Europe/Prague</c>, or a Windows id). When set, event times
    /// are converted to this zone at the render boundary (DST-aware). When null, the machine-local
    /// timezone is used and non-recurring events are passed through unchanged for backward compatibility.
    /// </summary>
    [Parameter] public string? TimeZoneId { get; set; }

    /// <summary>
    /// Resolves the effective display timezone: an explicitly set <see cref="TimeZoneId"/> wins;
    /// otherwise the circuit's <see cref="ITmUserTimeZone"/> — the browser's zone (UTC on Blazor
    /// Server until the probe reports after the first interactive render, the runtime's zone on
    /// WebAssembly) — and the machine-local zone only when no <see cref="ITmUserTimeZone"/> is
    /// registered (a bare test context).
    /// </summary>
    public TimeZoneInfo ResolveTimeZone()
    {
        if (!string.IsNullOrWhiteSpace(TimeZoneId)
            && TimeZoneInfo.TryFindSystemTimeZoneById(TimeZoneId, out var tz))
        {
            return tz;
        }

        return Services.GetService<ITmUserTimeZone>()?.Zone ?? Clock.LocalTimeZone;
    }

    /// <summary>
    /// Clock behind "Today" and every other "now" computation. Resolved through
    /// <see cref="IServiceProvider"/> so a consumer that never registers a <see cref="TimeProvider"/>
    /// still gets <see cref="TimeProvider.System"/> — a bare <c>[Inject] TimeProvider</c> would throw
    /// for exactly those consumers. Tests register a FakeTimeProvider.
    /// </summary>
    private TimeProvider Clock
        => _clock ??= Services.GetService(typeof(TimeProvider)) as TimeProvider ?? TimeProvider.System;
    private TimeProvider? _clock;

    /// <summary>Today's date in the display zone ("Today" navigation), taken from <see cref="Clock"/>.</summary>
    private DateTime TodayInDisplayZone()
        => TimeZoneInfo.ConvertTime(Clock.GetUtcNow(), ResolveTimeZone()).Date;

    /// <summary>
    /// The date every range, step and view reads. A default <see cref="CurrentDate"/> means today in
    /// the display zone, and it is never written back: a host that binds a default field keeps it.
    /// </summary>
    private DateTime EffectiveDate => CurrentDate == default ? TodayInDisplayZone() : CurrentDate.Date;

    protected override async Task OnParametersSetAsync()
    {
        await LoadEventsAsync();
        ReconcileDetail();
        ReconcileVisibleResource();
    }

    /// <summary>
    /// A detail whose event is no longer among the visible events has nothing to show, so it closes.
    /// The host panel stays: only the detail is cleared.
    /// </summary>
    private void ReconcileDetail()
    {
        if (_detailEventId is null) return;
        if (VisibleEvents.Any(e => e.Id == _detailEventId)) return;
        _detailOpen = false;
        _detailEventId = null;
    }

    /// <summary>
    /// A phone day shows one resource. When the filter drops the one it was showing, fall back to the
    /// first resource the filter still keeps, so the picker never names a column the grid cannot show.
    /// </summary>
    private void ReconcileVisibleResource()
    {
        if (_visibleResourceId is null || VisibleResources is not { } visible) return;
        if (visible.Any(r => r.Id == _visibleResourceId)) return;
        _visibleResourceId = visible.FirstOrDefault()?.Id;
    }

    /// <summary>Re-renders once the user zone arrives (the browser probe is Server-only and one-shot).</summary>
    private TmUserZoneObserver? _userZoneObserver;

    /// <summary>Triggers the one-time browser zone probe after the first interactive render.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _printRendered?.TrySetResult();

        if (firstRender)
        {
            _userZoneObserver ??= TmUserZoneObserver.Subscribe(Services, RefreshAfterZoneChange);
            try
            {
                _printRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("TempoBlazor.Scheduler.attachPrintListener", _rootRef, _printRef);
                await JS.InvokeVoidAsync("TempoBlazor.Scheduler.claimEscape", _rootRef);
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
            {
                // Without the script Ctrl+P still prints; only the desktop pin is missing.
            }
            if (_userZoneObserver is not null)
            {
                await _userZoneObserver.ProbeAsync();
            }

            // One guard per scheduler, attached to the root. A later render reuses it.
            try
            {
                await JS.InvokeVoidAsync("TempoBlazor.Scheduler.attachScrollGuard", _rootRef);
                _scrollGuardAttached = true;
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
            {
                // Without the script the arrows still move; only the page scroll comes back.
            }
        }
    }

    private Task RefreshAfterZoneChange() => InvokeAsync(async () =>
    {
        // The zone only changes how LOCALLY-owned data renders: the plain Events list is
        // renormalized in process, so it reloads. The provider and work-item paths own their range
        // filtering server-side and (with no explicit TimeZoneId) are not normalized here —
        // re-querying them because the browser reported its zone would be a surprise extra call.
        if (string.IsNullOrWhiteSpace(TimeZoneId)
            && DataProvider is null
            && WorkItemSource is null
            && Events is not null)
        {
            await LoadEventsAsync();
        }

        StateHasChanged();
    });

    /// <summary>Unsubscribes from the user zone and removes the scroll guard.</summary>
    public async ValueTask DisposeAsync()
    {
        _userZoneObserver?.Dispose();
        _printRef?.Dispose();
        try
        {
            await JS.InvokeVoidAsync("TempoBlazor.Scheduler.detachPrintListener", _rootRef);
            await JS.InvokeVoidAsync("TempoBlazor.Scheduler.releaseEscape", _rootRef);
            if (_scrollGuardAttached)
            {
                await JS.InvokeVoidAsync("TempoBlazor.Scheduler.detachScrollGuard", _rootRef);
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            // The circuit is already gone, so there is no listener left to remove.
        }
    }

    private readonly string _instanceId = "tm-sched-" + Guid.NewGuid().ToString("N");
    private string ToolbarTabId => $"{_instanceId}-{View}";

    private string BodyLabel => SchedulerViewLabel.Of(Loc, View);
    private ElementReference _rootRef;
    private bool _scrollGuardAttached;

    private IReadOnlyList<TmActionItem> ActionBarItems(TmLayoutContext mode)
    {
        var items = new List<TmActionItem>();
        if (OnAddClick.HasDelegate)
        {
            items.Add(new TmActionItem
            {
                Id = "scheduler-add",
                Label = Loc["TmScheduler_AddEvent"],
                Icon = IconNames.Plus,
                OnClick = OnAddClick,
            });
        }

        items.Add(new TmActionItem
        {
            Id = "scheduler-today",
            Label = Loc["TmScheduler_Today"],
            Icon = IconNames.Target,
            OnClick = EventCallback.Factory.Create(this, NavigateToday),
        });
        items.Add(new TmActionItem
        {
            Id = "scheduler-view",
            Label = Loc["TmScheduler_ViewSwitcher"],
            Icon = IconNames.Layers,
            KeepMenuOpen = true,
            OnClick = EventCallback.Factory.Create(this, OpenViewMenuAsync),
        });
        if (AllowPrint)
        {
            items.Add(new TmActionItem
            {
                Id = "scheduler-print",
                Label = Loc["TmScheduler_Print"],
                Icon = IconNames.Printer,
                Overflow = ActionOverflow.Always,
                Group = "more",
                OnClick = EventCallback.Factory.Create(this, PrintAsync),
            });
        }

        items.Add(new TmActionItem
        {
            Id = "scheduler-go-to-date",
            Label = Loc["TmScheduler_GoToDate"],
            Icon = IconNames.MapPin,
            Overflow = ActionOverflow.Always,
            Group = "more",
            OnClick = EventCallback.Factory.Create(this, OpenDatePickerAsync),
        });
        return items;
    }

    private DateOnly? _stripDay;
    private string? _visibleResourceId;
    private bool _detailOpen;
    private string? _detailEventId;

    private DateOnly StripDay => _stripDay ?? DateOnly.FromDateTime(EffectiveDate);

    private Task OpenViewMenuAsync() => _toolbar?.OpenViewMenuAsync() ?? Task.CompletedTask;

    private Task OpenDatePickerAsync() => _toolbar?.OpenDatePickerAsync() ?? Task.CompletedTask;

    private Task PickResourceAsync(string? id)
    {
        _visibleResourceId = id;
        return Task.CompletedTask;
    }

    private Task PickStripDayAsync(DateOnly day)
    {
        _stripDay = day;
        return SelectedDateChanged.InvokeAsync(day.ToDateTime(TimeOnly.MinValue));
    }

    private async Task LoadEventsAsync()
    {
        var (rangeStart, rangeEnd) = VisibleRange;
        var tz = ResolveTimeZone();
        var normalize = !string.IsNullOrWhiteSpace(TimeZoneId);

        if (DataProvider is not null)
        {
            // The provider owns range filtering and recurrence expansion; only convert timezone here.
            var events = await DataProvider.GetEventsAsync(new TmScheduleQuery(rangeStart, rangeEnd));
            _loadedEvents = normalize ? events.Select(e => Normalize(e, tz)).ToList() : events;
        }
        else if (WorkItemSource is not null)
        {
            var result = await WorkItemSource.SearchAsync(new TmWorkItemQuery
            {
                RangeStart = rangeStart,
                RangeEnd = rangeEnd,
                IncludeCompleted = true,
                Take = 1000
            });
            var mapped = result.Items
                .Where(w => w.Start < rangeEnd && w.End > rangeStart)
                .Select(MapToEvent);
            _loadedEvents = normalize ? mapped.Select(e => Normalize(e, tz)).ToList() : mapped.ToList();
        }
        else if (Events is not null)
        {
            _loadedEvents = ProcessEvents(Events, tz, normalize, rangeStart, rangeEnd);
        }
        else
        {
            _loadedEvents = [];
        }
    }

    /// <summary>
    /// Normalizes plain client events to the display timezone and expands recurring events into
    /// occurrences within the visible range (the plain <see cref="Events"/> path expands recurrence).
    /// </summary>
    private List<TmScheduleEvent> ProcessEvents(
        IEnumerable<TmScheduleEvent> raw, TimeZoneInfo tz, bool normalize, DateTime rangeStart, DateTime rangeEnd)
    {
        var result = new List<TmScheduleEvent>();
        foreach (var e in raw)
        {
            if (!string.IsNullOrWhiteSpace(e.RecurrenceRule))
            {
                var source = normalize ? Normalize(e, tz) : e;
                result.AddRange(RecurrenceEngine.ExpandRecurrence(source, rangeStart, rangeEnd, tz));
            }
            else
            {
                var display = normalize ? Normalize(e, tz) : e;
                if (display.StartLocal < rangeEnd && display.EndLocal > rangeStart)
                {
                    result.Add(display);
                }
            }
        }

        return result;
    }

    private static TmScheduleEvent Normalize(TmScheduleEvent e, TimeZoneInfo tz) => new()
    {
        Id = e.Id,
        Title = e.Title,
        Description = e.Description,
        // All-day events are floating dates and must not shift across midnight on timezone conversion.
        Start = e.AllDay ? e.Start : TimeZoneInfo.ConvertTime(e.Start, tz),
        End = e.AllDay ? e.End : TimeZoneInfo.ConvertTime(e.End, tz),
        AllDay = e.AllDay,
        Color = e.Color,
        CssClass = e.CssClass,
        ResourceId = e.ResourceId,
        RecurrenceRule = e.RecurrenceRule,
        RecurrenceExceptions = e.RecurrenceExceptions,
        IsReadOnly = e.IsReadOnly,
        Metadata = e.Metadata
    };

    private static TmScheduleEvent MapToEvent(TmWorkItem item) => new()
    {
        Id = item.Id,
        Title = item.Title,
        Start = item.Start,
        End = item.End,
        Description = item.Description,
        Color = item.Color ?? item.StatusColor
    };

    private async Task AnnounceAsync(string text)
    {
        // Clear first, so the same sentence announced twice is a new text node and is read again.
        if (!string.IsNullOrEmpty(_announcement))
        {
            _announcement = null;
            StateHasChanged();
            await Task.Yield();
        }
        _announcement = text;
        StateHasChanged();
    }

    private async Task HandleEventChangedAsync(TmScheduleEvent e)
    {
        if (WorkItemSource is not null && WorkItemSource.Capabilities.HasFlag(TmWorkItemCapabilities.Update))
        {
            var item = await WorkItemSource.GetByIdAsync(e.Id);
            if (item is not null)
            {
                item.Start = e.StartLocal;
                item.End = e.EndLocal;
                await WorkItemSource.UpdateAsync(item);
                await LoadEventsAsync();
            }
        }

        await OnEventChanged.InvokeAsync(e);
    }

    /// <summary>The week start normalized to 0..6, shared by the grid, the range and the title.</summary>
    private int NormalizedFirstDay => SchedulerRange.NormalizeFirstDay(FirstDayOfWeek);

    /// <summary>The agenda length clamped to at least one day, shared by the load, the view and the title.</summary>
    private int NormalizedAgendaDays => SchedulerRange.NormalizeAgendaDays(AgendaDays);

    /// <summary>The one range this render loads, titles and hands to the view.</summary>
    private SchedulerRangeOptions RangeOptions => new(NormalizedFirstDay, NormalizedAgendaDays, WeekDays, MonthWeeks);

    /// <summary>
    /// Events the views render. An empty <see cref="SelectedResourceIds"/> keeps every loaded event;
    /// so does a selection that names no known resource (a stale selection is not a filter). Otherwise
    /// a selection keeps only events whose resource is in it. An event with no resource stays, so a
    /// filter never hides an unassigned appointment.
    /// </summary>
    private bool ResourceFilterActive => SelectedResourceIds is { Count: > 0 }
        && Resources is { } known && known.Any(r => SelectedResourceIds.Contains(r.Id));

    private IReadOnlyList<TmScheduleEvent> VisibleEvents => ResourceFilterActive
        ? _loadedEvents.Where(e => e.ResourceId is null || SelectedResourceIds.Contains(e.ResourceId)).ToList()
        : _loadedEvents;

    /// <summary>
    /// Resources the resource views render. An empty selection keeps the host list (including null,
    /// which is what a view reads as "no resource grouping").
    /// </summary>
    private IReadOnlyList<TmScheduleResource>? VisibleResources => ResourceFilterActive && Resources is not null
        ? Resources.Where(r => SelectedResourceIds.Contains(r.Id)).ToList()
        : Resources;

    private (DateTime Start, DateTime End) VisibleRange
        => SchedulerRange.Visible(View, EffectiveDate, RangeOptions);

    private async Task HandleViewChange(TmScheduleViewType newView)
    {
        await ViewChanged.InvokeAsync(newView);
    }

    private async Task NavigatePrev()
    {
        await CurrentDateChanged.InvokeAsync(SchedulerRange.Step(View, EffectiveDate, -1, RangeOptions));
    }

    private async Task NavigateNext()
    {
        await CurrentDateChanged.InvokeAsync(SchedulerRange.Step(View, EffectiveDate, 1, RangeOptions));
    }

    private Task HandleMonthKeyboardNavigateAsync(DateTime date)
        => CurrentDateChanged.InvokeAsync(date.Date);

    private Task NavigateToPickedDate(DateTime day) => CurrentDateChanged.InvokeAsync(day.Date);

    /// <summary>A slot click also selects its day, then raises the host's slot callback.</summary>
    private async Task HandleSlotClickAsync((DateTime Start, DateTime End) slot)
    {
        await SelectedDateChanged.InvokeAsync(slot.Start.Date);
        await OnSlotClick.InvokeAsync(slot);
    }

    /// <summary>An event click selects it. The view already raised OnEventClick.</summary>
    private async Task HandleSelectedEventAsync(TmScheduleEvent? evt)
    {
        if (evt is not null && EventDetailTemplate is not null)
        {
            _detailEventId = evt.Id;
            _detailOpen = true;
            if (SidePanelOpenChanged.HasDelegate)
            {
                await SidePanelOpenChanged.InvokeAsync(true);
            }
        }

        await SelectedEventChanged.InvokeAsync(evt);
    }

    /// <summary>
    /// True once a slot is set, which is the only time the frame and the panel render.
    /// </summary>
    private bool HasPanel => SidePanel is not null || EventDetailTemplate is not null;

    private TmScheduleEvent? _detailEvent
        => _detailEventId is null ? null : VisibleEvents.FirstOrDefault(e => e.Id == _detailEventId);

    private bool PanelOpen => SidePanel is not null ? SidePanelOpen : _detailOpen && _detailEvent is not null;

    /// <summary>
    /// The docked header is never just the close button. An open detail names itself; otherwise the
    /// host's <see cref="SidePanelTitle"/> wins over the localized default.
    /// </summary>
    private string? PanelTitle => _detailEvent is not null && EventDetailTemplate is not null
        ? Loc["TmScheduler_EventDetail"]
        : SidePanel is not null ? (SidePanelTitle ?? Loc["TmSidePanel_DefaultTitle"]) : null;

    private RenderFragment SchedulerBody(TmLayoutContext mode) => @<div class="tm-scheduler-body"
         role="@(ShowHeader && !mode.IsMobile ? "tabpanel" : null)"
         id="@(ShowHeader && !mode.IsMobile ? $"tabpanel-{ToolbarTabId}" : null)"
         aria-labelledby="@(ShowHeader && !mode.IsMobile ? $"tab-{ToolbarTabId}" : null)"
         aria-label="@(mode.IsMobile ? BodyLabel : null)">
        @switch (View)
        {
            case TmScheduleViewType.Month:
                <TmSchedulerMonthView CurrentDate="@EffectiveDate"
                                      Today="@TodayInDisplayZone()"
                                      Events="@VisibleEvents"
                                      MaxVisibleEvents="@(mode.IsMobile ? EffectiveCompactCap : MaxVisibleEvents)"
                                      FirstDayOfWeek="@NormalizedFirstDay"
                                      MonthWeeks="@MonthWeeks"
                                      ReadOnly="@ReadOnly"
                                      ShowAdjacentMonthEvents="@ShowAdjacentMonthEvents"
                                      HighlightWeekends="@HighlightWeekends"
                                      AllDayEventStyle="@AllDayEventStyle"
                                      TimeZone="@ResolveTimeZone()"
                                      OnSlotClick="@HandleSlotClickAsync"
                                      SelectedDate="@SelectedDate"
                                      SelectedEvent="@SelectedEvent"
                                      SelectedEventChanged="@HandleSelectedEventAsync"
                                      OnEventClick="@OnEventClick"
                                      OnEventChanged="@HandleEventChangedAsync"
                                      OnAnnounced="@AnnounceAsync"
                                      OnSlotContextMenu="@OnSlotContextMenu"
                                      OnEventContextMenu="@OnEventContextMenu"
                                      OnMoreClick="@HandleMoreClickAsync"
                                      CurrentDateChanged="@(CurrentDateChanged.HasDelegate ? HandleMonthKeyboardNavigateAsync : default)"
                                      EventTemplate="@EventTemplate" />
                break;
            case TmScheduleViewType.Day:
                <TmSchedulerDayView CurrentDate="@EffectiveDate"
                                    Events="@VisibleEvents"
                                    Resources="@VisibleResources"
                                    VisibleResourceId="@_visibleResourceId"
                                    VisibleResourceIdChanged="PickResourceAsync"
                                    ShowResourcePicker="@mode.IsMobile"
                                    SlotDuration="@SlotDuration"
                                    ReadOnly="@ReadOnly"
                                    HideTimeGrid="@HideTimeGrid"
                                    Today="@DateOnly.FromDateTime(TodayInDisplayZone())"
                                    HighlightWeekends="@HighlightWeekends"
                                    AllDayEventStyle="@AllDayEventStyle"
                                    WorkDayStart="@WorkDayStart"
                                    WorkDayEnd="@WorkDayEnd"
                                    ShowFullDay="@ShowFullDay"
                                    HighlightOffHours="@HighlightOffHours"
                                    ScrollToTime="@ScrollToTime"
                                    ShowNowIndicator="@ShowNowIndicator"
                                    TimeZone="@ResolveTimeZone()"
                                    ResourceHeaderTemplate="@ResourceHeaderTemplate"
                                    ShowEventResource="@ShowEventResource"
                                    OnSlotClick="@HandleSlotClickAsync"
                                    SelectedDate="@SelectedDate"
                                    SelectedEvent="@SelectedEvent"
                                    SelectedEventChanged="@HandleSelectedEventAsync"
                                    OnEventClick="@OnEventClick"
                                    OnEventChanged="@HandleEventChangedAsync"
                                    OnAnnounced="@AnnounceAsync"
                                    OnSlotContextMenu="@OnSlotContextMenu"
                                    OnEventContextMenu="@OnEventContextMenu"
                                    EventTemplate="@EventTemplate" />
                break;
            case TmScheduleViewType.Week:
                <TmSchedulerWeekView CurrentDate="@EffectiveDate"
                                     Events="@VisibleEvents"
                                     Resources="@VisibleResources"
                                     ShowDateStrip="@mode.IsMobile"
                                     FocusedDay="@StripDay"
                                     FocusedDayChanged="PickStripDayAsync"
                                     FirstDayOfWeek="@NormalizedFirstDay"
                                     WeekDays="@WeekDays"
                                     SlotDuration="@SlotDuration"
                                     ReadOnly="@ReadOnly"
                                     HideTimeGrid="@HideTimeGrid"
                                     Today="@DateOnly.FromDateTime(TodayInDisplayZone())"
                                     HighlightWeekends="@HighlightWeekends"
                                     AllDayEventStyle="@AllDayEventStyle"
                                     WorkDayStart="@WorkDayStart"
                                     WorkDayEnd="@WorkDayEnd"
                                     ShowFullDay="@ShowFullDay"
                                     HighlightOffHours="@HighlightOffHours"
                                     ScrollToTime="@ScrollToTime"
                                     ShowNowIndicator="@ShowNowIndicator"
                                     TimeZone="@ResolveTimeZone()"
                                     ResourceHeaderTemplate="@ResourceHeaderTemplate"
                                     ShowEventResource="@ShowEventResource"
                                     OnSlotClick="@HandleSlotClickAsync"
                                     SelectedDate="@SelectedDate"
                                     SelectedEvent="@SelectedEvent"
                                     SelectedEventChanged="@HandleSelectedEventAsync"
                                     OnEventClick="@OnEventClick"
                                     OnEventChanged="@HandleEventChangedAsync"
                                     OnAnnounced="@AnnounceAsync"
                                     OnSlotContextMenu="@OnSlotContextMenu"
                                     OnEventContextMenu="@OnEventContextMenu"
                                     EventTemplate="@EventTemplate" />
                break;
            case TmScheduleViewType.Agenda:
                <TmSchedulerAgendaView CurrentDate="@EffectiveDate"
                                       AgendaDays="@NormalizedAgendaDays"
                                       Compact="@mode.IsMobile"
                                       Events="@VisibleEvents"
                                       SelectedEvent="@SelectedEvent"
                                       SelectedEventChanged="@HandleSelectedEventAsync"
                                       OnEventClick="@OnEventClick"
                                       EventTemplate="@EventTemplate" />
                break;
            case TmScheduleViewType.Timeline:
                <TmSchedulerTimelineView CurrentDate="@EffectiveDate"
                                         Events="@VisibleEvents"
                                         Resources="@VisibleResources"
                                         SlotDuration="@SlotDuration"
                                         ReadOnly="@ReadOnly"
                                         WorkDayStart="@WorkDayStart"
                                         WorkDayEnd="@WorkDayEnd"
                                         ShowFullDay="@ShowFullDay"
                                         HighlightOffHours="@HighlightOffHours"
                                         ScrollToTime="@ScrollToTime"
                                         ShowNowIndicator="@ShowNowIndicator"
                                         TimeZone="@ResolveTimeZone()"
                                         ResourceHeaderTemplate="@ResourceHeaderTemplate"
                                         OnSlotClick="@HandleSlotClickAsync"
                                         SelectedEvent="@SelectedEvent"
                                         SelectedEventChanged="@HandleSelectedEventAsync"
                                         OnEventClick="@OnEventClick"
                                         OnEventChanged="@HandleEventChangedAsync"
                                         OnAnnounced="@AnnounceAsync"
                                         OnSlotContextMenu="@OnSlotContextMenu"
                                         OnEventContextMenu="@OnEventContextMenu"
                                         EventTemplate="@EventTemplate" />
                break;
        }
    </div>;

    private RenderFragment? PanelContent
    {
        get
        {
            var detail = _detailEvent is { } shown && EventDetailTemplate is not null
                ? EventDetailTemplate(shown)
                : null;
            if (SidePanel is null && detail is null) return null;
            var closeId = TestId("scheduler-close-detail");
            return @<div @onkeydown="HandleDetailEscapeAsync">
                @SidePanel
                @if (detail is not null)
                {
                    @detail
                    <button type="button" class="tm-scheduler-close-detail" data-testid="@closeId"
                            @onclick="CloseDetailAsync">@Loc["TmScheduler_CloseDetail"]</button>
                }
            </div>;
        }
    }

    /// <summary>
    /// The detail's own close. It clears the detail and returns focus to the event. With a host
    /// <see cref="SidePanel"/> the panel stays open; without one the detail was the panel, so it closes.
    /// </summary>
    private async Task HandleDetailEscapeAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseDetailAsync();
    }

    private async Task CloseDetailAsync()
    {
        var returning = _detailEvent;
        _detailOpen = false;
        _detailEventId = null;
        if (returning is not null)
        {
            await ReturnFocusToEventAsync(returning);
        }

        if (SidePanel is null && SidePanelOpenChanged.HasDelegate)
        {
            await SidePanelOpenChanged.InvokeAsync(false);
        }
    }

    private async Task HandlePanelOpenChanged(bool open)
    {
        if (!open)
        {
            var returning = _detailEvent;
            _detailOpen = false;
            _detailEventId = null;
            if (returning is not null)
            {
                await ReturnFocusToEventAsync(returning);
            }
        }

        if (SidePanelOpenChanged.HasDelegate)
        {
            await SidePanelOpenChanged.InvokeAsync(open);
        }
    }

    private async Task ReturnFocusToEventAsync(TmScheduleEvent evt)
    {
        if (_rootRef.Context is null) return;
        try
        {
            await JS.InvokeVoidAsync(
                "TempoBlazor.Scheduler.focusRovingStop",
                _rootRef,
                $"[data-event-id=\"{evt.Id}\"]");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
        }
    }

    /// <summary>
    /// The toolbar's resource filter. Null unless the host asked for it and named some resources,
    /// so the default toolbar groups are unchanged. The popup is the multi-select's own overlay:
    /// anchored on desktop and tablet, the F3 bottom sheet on mobile.
    /// </summary>
    private RenderFragment? ResourceFilter(TmLayoutContext mode) => ShowResourceFilter && Resources is { Count: > 0 }
        ? BuildResourceFilter(mode)
        : null;

    private const string _resourceFilterTestId = "scheduler-resource-filter";

    private RenderFragment BuildResourceFilter(TmLayoutContext mode)
    {
        var resources = Resources ?? [];
        return @<text>
        <TmMultiSelect TItem="TmScheduleResource" TValue="string"
                       Items="@resources"
                       Values="@SelectedResourceIds"
                       ValuesChanged="HandleResourceFilterChanged"
                       DisplayField="@(r => r.Name)"
                       ValueField="@(r => r.Id)"
                       Mode="MultiSelectMode.CheckBox"
                       Placeholder="@ResourceFilterText"
                       Label="@Loc["TmScheduler_Resources"]"
                       HideLabel="true"
                       MobilePresentation="PanelPresentation.Auto"
                       LayoutMode="@mode.Resolved"
                       data-testid="@_resourceFilterTestId"
                       Class="tm-scheduler-resource-filter" />
        </text>;
    }

    private Task HandleResourceFilterChanged(IReadOnlyList<string> ids)
        => SelectedResourceIdsChanged.InvokeAsync(ids);

    /// <summary>The trigger text: every resource, or how many the host selected.</summary>
    private string ResourceFilterText => SelectedResourceIds is { Count: > 0 }
        ? Loc["TmScheduler_NSelected", SelectedResourceIds.Count]
        : Loc["TmScheduler_AllResources"];

    private async Task NavigateToday()
    {
        await CurrentDateChanged.InvokeAsync(TodayInDisplayZone());
    }

    /// <summary>
    /// "+N more": a host delegate wins; without one the scheduler opens that day in the Day view.
    /// </summary>
    private async Task HandleMoreClickAsync(DateTime day)
    {
        if (OnMoreClick.HasDelegate)
        {
            await OnMoreClick.InvokeAsync(day);
            return;
        }

        // The fallback only helps a host that bound both callbacks; with one missing the click is
        // inert, so the month stays put instead of half-switching.
        if (!CurrentDateChanged.HasDelegate || !ViewChanged.HasDelegate)
        {
            return;
        }

        // The date moves first, so a host that reloads on each callback never queries the old date
        // in the new view.
        await CurrentDateChanged.InvokeAsync(day.Date);
        await ViewChanged.InvokeAsync(TmScheduleViewType.Day);
    }
}
