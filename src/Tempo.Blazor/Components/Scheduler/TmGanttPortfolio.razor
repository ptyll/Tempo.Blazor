@namespace Tempo.Blazor.Components.Scheduler
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Abstractions.Models
@using Tempo.Blazor.Components.Feedback

<div class="tm-gantt-portfolio @Class" data-testid="@RootTestId()" @attributes="AdditionalAttributes">
    @foreach (var project in Projects)
    {
        var current = project;
        var expanded = IsExpanded(project);
        var range = Range(project);
        var progress = WeightedProgress(project);
        <div class="tm-gantt-portfolio__project" data-testid="@TestId($"portfolio-project-{project.Id}")">
            <div class="tm-gantt-portfolio__project-header">
                <button type="button" class="tm-gantt-portfolio__project-toggle"
                        aria-expanded="@(expanded ? "true" : "false")" aria-controls="@BodyId(project)"
                        aria-label="@Loc[expanded ? "TmGanttPortfolio_Collapse" : "TmGanttPortfolio_Expand", project.Name]"
                        data-testid="@TestId($"portfolio-toggle-{project.Id}")"
                        @onclick="() => Toggle(current)">
                    <TmIcon Name="@(expanded ? "chevron-down" : "chevron-right")" Size="IconSize.Sm" />
                </button>
                @if (OnProjectSelected.HasDelegate)
                {
                    <button type="button" class="tm-gantt-portfolio__project-name tm-gantt-portfolio__project-name--link"
                            @onclick="() => OnProjectSelected.InvokeAsync(current)">@project.Name</button>
                }
                else
                {
                    <span class="tm-gantt-portfolio__project-name">@project.Name</span>
                }
                <span class="tm-gantt-portfolio__project-meta">
                    @if (range is { } r)
                    {
                        <span class="tm-gantt-portfolio__project-range">@r.Start.ToString("d", Loc.Culture) – @r.End.ToString("d", Loc.Culture)</span>
                    }
                    <span class="tm-gantt-portfolio__project-count">@Loc["TmGanttPortfolio_TaskCount", project.Tasks.Count]</span>
                </span>
                <TmProgressBar Class="tm-gantt-portfolio__project-progress" Value="progress" ShowLabel="true" Size="ProgressBarSize.Sm" />
                @if (ProjectActions is not null)
                {
                    <span class="tm-gantt-portfolio__project-actions">@ProjectActions(project)</span>
                }
            </div>
            @if (expanded)
            {
                <div class="tm-gantt-portfolio__project-summary" id="@BodyId(project)" style="@SummaryStyle">
                    <TmGantt TestIdPrefix="@TestId($"gantt-{project.Id}")"
                             Items="project.Tasks"
                             DependencyItems="project.Dependencies"
                             ShowToolbar="false"
                             ShowSidebar="false" />
                </div>
            }
        </div>
    }
</div>