@namespace Tempo.Blazor.Components.Scheduler
@using Tempo.Blazor.Components.DataDisplay
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Models
@using System.Globalization

<div class="tm-scheduler-agenda">
    @if (_groupedEvents.Count == 0)
    {
        <div class="tm-scheduler-agenda-empty">
            <TmEmptyState Icon="@IconNames.Calendar"
                          Title="@Loc["TmScheduler_AgendaEmptyTitle"]"
                          Description="@Loc["TmScheduler_AgendaEmptyDescription"]" />
        </div>
    }
    else
    {
        <div class="tm-scheduler-agenda-card" role="list" aria-label="@Loc["TmScheduler_AgendaList"]">
        @foreach (var group in _groupedEvents)
        {
            var culture = CultureInfo.CurrentUICulture;
            <div class="tm-scheduler-agenda-group" role="listitem">
                <div class="tm-scheduler-agenda-group-body" role="group" aria-label="@group.Key.ToString("D", culture)">
                <div class="tm-scheduler-agenda-date @(Compact ? "tm-scheduler-agenda-date--sticky" : null)">
                    <span class="tm-scheduler-agenda-date-day">@group.Key.Day</span>
                    <span class="tm-scheduler-agenda-date-weekday">@group.Key.ToString("dddd", culture)</span>
                    <span class="tm-scheduler-agenda-date-month">@group.Key.ToString("MMMM yyyy", culture)</span>
                </div>
                <div class="tm-scheduler-agenda-events">
                    @foreach (var evt in group.Value)
                    {
                        var e = evt;
                        <button type="button" data-event-id="@e.Id" class="tm-scheduler-agenda-event @(Compact ? "tm-scheduler-agenda-event--card" : null) @(IsSelected(e) ? "tm-scheduler-agenda-event--selected" : "") @e.CssClass"
                                aria-current="@(IsSelected(e) ? "true" : null)"
                                aria-label="@(EventTemplate is null ? AgendaEventLabel(e) : null)"
                                @onclick="@(() => HandleEventClick(e))">
                            <span class="tm-scheduler-agenda-event-dot"
                                  style="@(e.Color is not null ? $"background-color: {e.Color};" : "")"></span>
                            @if (EventTemplate is not null)
                            {
                                <span class="tm-sr-only">@AgendaEventLabel(e)</span>
                                @EventTemplate(e)
                            }
                            else
                            {
                                <span class="tm-scheduler-agenda-event-time">
                                    @if (e.AllDay)
                                    {
                                        @Loc["TmScheduler_AllDay"]
                                    }
                                    else
                                    {
                                        @e.Start.ToString("t", culture)@(" – ")@e.End.ToString("t", culture)
                                    }
                                </span>
                                <span class="tm-scheduler-agenda-event-title">@e.Title</span>
                                @if (Compact)
                                {
                                    <span class="tm-scheduler-agenda-event-chevron" aria-hidden="true"><TmIcon Name="@IconNames.ChevronRight" Size="IconSize.Sm" /></span>
                                }
                                @if (!string.IsNullOrEmpty(e.Description))
                                {
                                    <span class="tm-scheduler-agenda-event-desc">@e.Description</span>
                                }
                            }
                        </button>
                    }
                </div>
                </div>
            </div>
        }
        </div>
    }
</div>

@code {
    private List<KeyValuePair<DateOnly, List<TmScheduleEvent>>> _groupedEvents = [];

    /// <summary>Currently displayed start date.</summary>
    [Parameter] public DateTime CurrentDate { get; set; }

    /// <summary>Number of days to show in the agenda. Values below 1 are treated as 1.</summary>
    [Parameter] public int AgendaDays { get; set; } = 30;

    /// <summary>Renders each event as a card with a chevron and sticks the day header. The mobile layout sets it.</summary>
    [Parameter] public bool Compact { get; set; }

    /// <summary>Events to display.</summary>
    [Parameter] public IReadOnlyList<TmScheduleEvent>? Events { get; set; }

    /// <summary>Fires when an event is clicked.</summary>
    [Parameter] public EventCallback<TmScheduleEvent> OnEventClick { get; set; }

    /// <summary>The selected event. The matching row gets <c>aria-current</c> and <c>tm-scheduler-agenda-event--selected</c>.</summary>
    [Parameter] public TmScheduleEvent? SelectedEvent { get; set; }

    /// <summary>Fires when the user selects an event.</summary>
    [Parameter] public EventCallback<TmScheduleEvent?> SelectedEventChanged { get; set; }

    /// <summary>
    /// Optional custom event renderer used inside each agenda row.
    /// The row chrome (the colour dot) stays; the time, title and description are replaced.
    /// </summary>
    [Parameter] public RenderFragment<TmScheduleEvent>? EventTemplate { get; set; }

    protected override void OnParametersSet()
    {
        BuildGroupedEvents();
    }

    private string AgendaEventLabel(TmScheduleEvent e)
        => SchedulerA11y.EventLabel(Loc, e, CultureInfo.CurrentUICulture);

    private bool IsSelected(TmScheduleEvent e) => SelectedEvent is not null && SelectedEvent.Id == e.Id;

    private async Task HandleEventClick(TmScheduleEvent e)
    {
        await SelectedEventChanged.InvokeAsync(e);
        await OnEventClick.InvokeAsync(e);
    }

    private void BuildGroupedEvents()
    {
        _groupedEvents.Clear();
        if (Events is null || Events.Count == 0) return;

        var range = SchedulerRange.Visible(TmScheduleViewType.Agenda, CurrentDate, new SchedulerRangeOptions(1, AgendaDays));
        var rangeStart = range.Start;
        var rangeEnd = range.End;

        var eventsInRange = Events
            .Where(e => e.Start < rangeEnd && e.End > rangeStart)
            .OrderBy(e => e.Start)
            .ToList();

        var grouped = new SortedDictionary<DateOnly, List<TmScheduleEvent>>();

        foreach (var evt in eventsInRange)
        {
            var date = DateOnly.FromDateTime(evt.StartLocal);
            if (date < DateOnly.FromDateTime(rangeStart))
                date = DateOnly.FromDateTime(rangeStart);

            if (!grouped.TryGetValue(date, out var list))
            {
                list = [];
                grouped[date] = list;
            }
            list.Add(evt);
        }

        _groupedEvents = grouped.ToList();
    }
}
