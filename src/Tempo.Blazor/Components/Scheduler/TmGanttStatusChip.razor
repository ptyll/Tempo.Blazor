@namespace Tempo.Blazor.Components.Scheduler
@using System.ComponentModel
@using Tempo.Blazor.Abstractions.WorkItems
@attribute [EditorBrowsable(EditorBrowsableState.Never)]

@* The status chip (glyph + text) shared by the tree, the Board column headers and the dashboard. It is a component, not
   a RenderFragment built in code: Blazor stamps the CSS-isolation scope attribute only on elements the Razor compiler
   emits for THIS component, so the chip owns its stylesheet (TmGanttStatusChip.razor.css) and no longer depends on
   which view draws it. The glyph is decorative (aria-hidden): the localized text names the status, so it is never
   conveyed by colour alone (WCAG 1.4.1). *@
<span class="tm-gantt__status-badge @BadgeClass" data-testid="@ChipTestId"><span class="tm-gantt__status-icon" aria-hidden="true">@Glyph</span>@Loc[$"GanttStatus_{Status}"]</span>

@code {
    /// <summary>The status the chip shows.</summary>
    [Parameter, EditorBrowsable(EditorBrowsableState.Never)] public TmWorkItemStatus Status { get; set; }

    /// <summary>Optional <c>data-testid</c> of the chip (already resolved through the owning Gantt's test-id prefix).</summary>
    [Parameter, EditorBrowsable(EditorBrowsableState.Never)] public string? ChipTestId { get; set; }

    private string Glyph => Status switch
    {
        TmWorkItemStatus.Done => "✓",
        TmWorkItemStatus.InProgress => "◉",
        TmWorkItemStatus.Closed => "⊘",
        _ => "○"
    };

    private string BadgeClass => Status switch
    {
        TmWorkItemStatus.Open => "tm-gantt__status-badge--open",
        TmWorkItemStatus.InProgress => "tm-gantt__status-badge--inprogress",
        TmWorkItemStatus.Done => "tm-gantt__status-badge--done",
        TmWorkItemStatus.Closed => "tm-gantt__status-badge--closed",
        _ => ""
    };
}