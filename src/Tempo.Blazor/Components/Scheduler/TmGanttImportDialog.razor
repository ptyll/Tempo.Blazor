@namespace Tempo.Blazor.Components.Scheduler
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Abstractions.Models
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Forms
@using Microsoft.AspNetCore.Components.Forms

@* G6: the dialog is the core TmModal (top layer, focus trap, Escape, focus return to the trigger). The per-dialog
   class rides the overlay root; the tm-gantt__import-* classes stay on the content. *@
<TmModal Show="IsOpen"
         Class="tm-gantt__import-dialog"
         Title="@Loc["TmGantt_Import"]"
         Size="ModalSize.Large"
         MobilePresentation="MobilePresentation.Auto"
         FooterLayout="FooterLayout.Inline"
         OnClose="OnClose">
    <ChildContent>
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <TmAlert Severity="AlertSeverity.Error" Class="tm-gantt-import__error" data-testid="@TestId("import-error")">
                @_errorMessage
            </TmAlert>
        }

        @* The finished import's warnings: the import itself succeeded and the data has already
           landed - the dialog stays open so the user can read (and expand) what to fix, then closes
           it with the single Close button in the footer. *@
        @if (_completedResult is { } completed && completed.Warnings.Count > 0)
        {
            <TmAlert Severity="AlertSeverity.Warning" Class="tm-gantt-import__warnings" data-testid="@TestId("import-warnings")">
                <strong>@Loc.Plural("TmGantt_ImportWarningsTitle", completed.Warnings.Count)</strong>
                <details class="tm-gantt-import__warning-list">
                    <summary>@Loc["TmGantt_ImportWarningsShowDetails"]</summary>
                    <ul>
                        @foreach (var warning in completed.Warnings)
                        {
                            <li>@WarningText(warning)</li>
                        }
                    </ul>
                </details>
            </TmAlert>
        }

        @* Import source tabs (ARIA tablist: roving tabindex; Left / Right wrap, Home / End jump; focus follows the selection). *@
        <div class="tm-gantt__import-tabs" role="tablist" aria-label="@Loc["TmGantt_ImportSource"]" @ref="_tabListRef" @onkeydown="HandleTabKeyDown">
            @foreach (var tab in Tabs)
            {
                var selected = _tab == tab;
                <button type="button" role="tab" @ref="_tabRefs[tab]"
                        id="@TabId(tab)" aria-controls="@PanelId"
                        class="tm-gantt__import-tab @(selected ? "tm-gantt__import-tab--active" : "")"
                        aria-selected="@(selected ? "true" : "false")"
                        tabindex="@(selected ? 0 : -1)"
                        data-testid="@TestId($"import-tab-{tab.ToString().ToLowerInvariant()}")"
                        @onclick="() => SelectTab(tab)">
                    <TmIcon Name="@TabIcon(tab)" Size="IconSize.Sm" />
                    <span>@Loc[TabLabelKey(tab)]</span>
                </button>
            }
        </div>

        <div class="tm-gantt__import-panel" role="tabpanel" id="@PanelId" aria-labelledby="@TabId(_tab)">
            @if (_tab == ImportTab.Excel || _tab == ImportTab.Mpp)
            {
                <div class="tm-gantt__import-file-area">
                    @* The InputFile stays in the DOM visually hidden - NOT display:none, so the JS-triggered
                       input.click() inside the button's native click listener reliably opens the native chooser in
                       every engine - including WebKit, which ignores input.click() issued after a Blazor interop
                       round-trip (N204). The label-for-input trick was unreachable from the keyboard: a <label> can
                       never take focus. The @key recreates the input after "Remove file" / a tab switch, which is the
                       only way to clear a native file input without JS (and lets the same file be chosen again). *@
                    <div class="tm-gantt__import-file-input-wrap" @ref="_fileInputWrap">
                        <InputFile @key="_inputKey" OnChange="OnFileChangedAsync" accept="@(_tab == ImportTab.Excel ? ".xlsx,.xls" : ".xml,.mpp")"
                                   class="tm-gantt__import-file-input" aria-hidden="true" tabindex="-1" />
                    </div>
                    @* An input group: the chooser, the chosen name (a persistent live region - assistive tech must
                       register it BEFORE a file lands, or the update would never be announced, N153) and Remove. *@
                    <div class="tm-gantt__import-file-group">
                        @* The native listener is wired by registerFilePickerTrigger, re-attempted on every render
                           while this element exists - the JS dedupes per element via a dataset marker, so a freshly
                           recreated button (tab round-trip, reopen) always ends up wired. There is deliberately NO
                           @onclick here: the whole C# interop path would sit between the click and input.click()
                           and sever the user-activation chain. *@
                        <div class="tm-gantt__import-trigger" @ref="_triggerWrapRef">
                            <TmButton Variant="ButtonVariant.Secondary" Icon="upload"
                                      data-testid="@TestId("import-choose-file")">
                                @Loc["TmGantt_ChooseFile"]
                            </TmButton>
                        </div>
                        <span class="tm-gantt__import-file-name @(_selectedFile is null ? "tm-gantt__import-file-name--empty" : "")"
                              aria-live="polite">@(_selectedFileName ?? Loc["TmGantt_ImportNoFile"])</span>
                        @if (_selectedFile is not null)
                        {
                            <button type="button" class="tm-gantt__import-file-remove"
                                    aria-label="@Loc["TmGantt_ImportRemoveFile"]" title="@Loc["TmGantt_ImportRemoveFile"]"
                                    data-testid="@TestId("import-remove-file")"
                                    @onclick="RemoveFile">
                                <TmIcon Name="x" Size="IconSize.Sm" />
                            </button>
                        }
                    </div>
                    <p class="tm-gantt__import-hint">@Loc["TmGantt_ImportSupportedFormats", SupportedFormats]</p>
                </div>
            }
            else
            {
                <div class="tm-gantt__import-jira-form">
                    <TmFormField Label="@Loc["TmGantt_ImportJiraUrl"]">
                        <TmTextInput @bind-Value="_jiraUrl" Placeholder="https://yourcompany.atlassian.net" />
                    </TmFormField>
                    <TmFormField Label="@Loc["TmGantt_ImportJiraToken"]">
                        <TmTextInput @bind-Value="_jiraToken" Type="password" />
                    </TmFormField>
                    <TmFormField Label="@Loc["TmGantt_ImportJiraProject"]">
                        <TmTextInput @bind-Value="_jiraProject" Placeholder="PROJ" />
                    </TmFormField>
                </div>
            }
        </div>
    </ChildContent>
    <Footer>
        @if (_completedResult is { } finished && finished.Warnings.Count > 0)
        {
            @* The import is done and its warnings are the only thing left to read: one primary
               Close, no Cancel (it would only close an already completed dialog) and no Import
               (the chosen file was dropped, so a second run cannot duplicate the tasks). *@
            <TmButton Variant="ButtonVariant.Primary" OnClick="OnClose" data-testid="@TestId("import-close")">
                @Loc["Tm_Close"]
            </TmButton>
        }
        else
        {
            <TmButton Variant="ButtonVariant.Ghost" OnClick="OnClose" data-testid="@TestId("import-cancel")">
                @Loc["Tm_Cancel"]
            </TmButton>
            <TmButton Variant="ButtonVariant.Primary" OnClick="ImportAsync" Disabled="@(!CanImport)"
                      IsLoading="_isImporting" data-testid="@TestId("import-submit")">
                @Loc["TmGantt_Import"]
            </TmButton>
        }
    </Footer>
</TmModal>

@* The mapping step renders as a SIBLING modal on top of the import dialog (both are core TmModals
   in the browser top layer): it lists the chosen file's headers pre-mapped by name, seeded by the
   host's ImportMappings. Cancelling returns to the file step with the file still chosen. *@
@if (IsOpen && _mappingDialogOpen)
{
    <TmGanttImportMappingDialog IsOpen="true"
                                SourceColumns="@_headers"
                                InitialMappings="@ImportMappings"
                                OnImport="ImportExcelResultAsync"
                                OnClose="() => _mappingDialogOpen = false" />
}
