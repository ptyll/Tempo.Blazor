@namespace Tempo.Blazor.Components.Scheduler
@using Tempo.Blazor.Models
@using System.Globalization
@using Microsoft.JSInterop
@using Microsoft.Extensions.DependencyInjection
@implements IAsyncDisposable
@inject IJSRuntime JS

<CascadingValue Value="_ticker" IsFixed="true">
<div class="tm-scheduler-timeline" @ref="_containerRef" data-slot-duration="@SlotDuration" data-tm-scroll="timeline"
     data-range-start="@RangeStartMinutes" data-range-minutes="@RangeMinutes"
     data-date="@CurrentDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
     data-time-culture="@CultureInfo.CurrentUICulture.Name"
     style="--tm-scheduler-visible-hours: @RangeHours.ToString(CultureInfo.InvariantCulture);">
    <span id="@_moveHintId" class="tm-sr-only">@Loc["TmScheduler_MoveHint_Timeline"]</span>
    @* Header: time columns *@
    <div class="tm-scheduler-timeline-header">
        <div class="tm-scheduler-timeline-resource-header tm-scheduler-timeline-resource-header--sticky">@Loc["TmScheduler_Resources"]</div>
        @for (var hour = RangeStartMinutes / 60; hour < (RangeStartMinutes + RangeMinutes) / 60; hour++)
        {
            var h = hour;
            <div class="tm-scheduler-timeline-time-header">@DateTime.Today.AddHours(h).ToString("t", CultureInfo.CurrentUICulture)</div>
        }
    </div>

    @* Resource rows *@
    <div class="tm-scheduler-timeline-body" role="grid"
         aria-label="@Loc["TmScheduler_TimelineGrid"]"
         aria-keyshortcuts="ArrowLeft ArrowRight ArrowUp ArrowDown">
    @foreach (var resource in _resources)
    {
        var r = resource;
        var rowEvents = GetEventsForResource(r.Id);

        <div class="tm-scheduler-timeline-row" role="row" data-resource="@r.Id">
            <div class="tm-scheduler-timeline-resource-label tm-scheduler-timeline-resource-label--sticky" role="rowheader"
                 style="@(r.Color is not null ? $"border-left-color: {r.Color};" : "")">
                @SchedulerResourceHeader.Render(r, ResourceHeaderTemplate, AvatarSize.Sm)
            </div>
            <div class="tm-scheduler-timeline-row-body" role="gridcell" style="@($"--tm-scheduler-lanes: {LaneCount(r.Id).ToString(CultureInfo.InvariantCulture)}")">
                @* Slots *@
                @for (var slotIndex = 0; slotIndex < _slotsPerDay; slotIndex++)
                {
                    @Slot(r.Id, slotIndex)
                }

                @if (ShowNowIndicator)
                {
                    @NowLine(r == _resources[0])
                }

                @* Events *@
                @foreach (var evt in rowEvents)
                {
                    @TimelineEvent(r, evt)
                }
            </div>
        </div>
    }
    </div>
</div>
</CascadingValue>

@code {
    private DotNetObjectReference<TmSchedulerTimelineView>? _dotNetRef;
    private bool _jsRegistered;
    private ElementReference _containerRef;

    private readonly Dictionary<string, ElementReference> _eventRefs = new();

    /// <summary>How many times this view itself rendered. A now-indicator tick must not raise it.</summary>
    internal int RenderCount { get; private set; }

    protected override void OnAfterRender(bool firstRender)
    {
        RenderCount++;
        base.OnAfterRender(firstRender);
    }

    
    private readonly string _rovingId = "tm-scheduler-roving-" + Guid.NewGuid().ToString("N");
    private int _activeResourceIndex;
    private bool _moveFocus;
    private string? _focusEventId;
    private readonly string _moveHintId = "tm-scheduler-move-hint-" + Guid.NewGuid().ToString("N");
    private int _activeSlotIndex;

    private int _slotsPerDay;
    private TimeSpan? _scrolledTo;
    private SchedulerNowTicker? _ticker;
    private readonly List<SchedulerNowIndicator> _indicators = [];
    private bool _disposed;

    private RenderFragment TimelineEvent(TmScheduleResource resource, TmScheduleEvent e) => builder =>
    {
        var lane = LaneOf(resource.Id, e);
        var sequence = 0;
        builder.OpenElement(sequence++, "div");
        builder.SetKey(e.Id);
        builder.AddAttribute(sequence++, "class",
            $"tm-scheduler-timeline-event tm-scheduler-event-surface {(IsSelectedEvent(e) ? "tm-scheduler-timeline-event--selected" : "")} {e.CssClass}");
        if (IsSelectedEvent(e)) builder.AddAttribute(sequence++, "aria-current", "true");
        builder.AddAttribute(sequence++, "role", "button");
        builder.AddAttribute(sequence++, "tabindex", IsEventStop(e, resource.Id) ? "0" : "-1");
        if (EventTemplate is null) builder.AddAttribute(sequence++, "aria-label", EventAriaLabel(e));
        builder.AddAttribute(sequence++, "data-tm-roving", _rovingId);
        builder.AddAttribute(sequence++, "style",
            $"--tm-scheduler-event-start: {(GetEventStartMinutes(e) - RangeStartMinutes).ToString(CultureInfo.InvariantCulture)}; --tm-scheduler-event-end: {(EventEndMinutes(e) - RangeStartMinutes).ToString(CultureInfo.InvariantCulture)}; --tm-scheduler-lane: {lane.Lane.ToString(CultureInfo.InvariantCulture)};{EventStyle(e.Color ?? resource.Color)}");
        builder.AddAttribute(sequence++, "title", e.Title);
        builder.AddAttribute(sequence++, "data-event-id", e.Id);
        builder.AddAttribute(sequence++, "draggable", !ReadOnly && !e.IsReadOnly ? "true" : "false");
        if (!ReadOnly && !e.IsReadOnly)
        {
            builder.AddAttribute(sequence++, "aria-describedby", _moveHintId);
            builder.AddAttribute(sequence++, "aria-keyshortcuts", "Alt+ArrowLeft Alt+ArrowRight Alt+ArrowUp Alt+ArrowDown Alt+Shift+ArrowLeft Alt+Shift+ArrowRight");
        }
        builder.AddAttribute(sequence++, "ondragstart", EventCallback.Factory.Create(this, () => HandleDragStart(e, resource.Id)));
        builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => HandleEventClick(e)));
        builder.AddEventStopPropagationAttribute(sequence++, "onclick", true);
        builder.AddAttribute(sequence++, "onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, k => HandleEventKeyDown(k, e)));
        builder.AddEventStopPropagationAttribute(sequence++, "onkeydown", true);
        builder.AddAttribute(sequence++, "onkeyup", EventCallback.Factory.Create<KeyboardEventArgs>(this, k => HandleEventKeyUp(k, e)));
        builder.AddEventStopPropagationAttribute(sequence++, "onkeyup", true);
        builder.AddAttribute(sequence++, "oncontextmenu", EventCallback.Factory.Create<MouseEventArgs>(this, args => HandleEventContextMenu(args, e)));
        builder.AddEventPreventDefaultAttribute(sequence++, "oncontextmenu", true);
        builder.AddEventStopPropagationAttribute(sequence++, "oncontextmenu", true);
        if (EventTemplate is not null)
        {
            // The template renders directly into the bar. The ellipsis wrapper clipped a multi-line
            // template to one line; a host that wants ellipsis puts it on its own markup.
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "tm-sr-only");
            builder.AddContent(sequence++, EventAriaLabel(e));
            builder.CloseElement();
            builder.AddContent(sequence++, EventTemplate(e));
        }
        else
        {
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "tm-scheduler-timeline-event-time");
            builder.AddContent(sequence++, $"{e.Start.ToString("t", CultureInfo.CurrentUICulture)} – {e.End.ToString("t", CultureInfo.CurrentUICulture)}");
            builder.CloseElement();
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "tm-scheduler-timeline-event-title");
            builder.AddContent(sequence++, e.Title);
            builder.CloseElement();
        }

        if (!ReadOnly && !e.IsReadOnly)
        {
            // Literal classes, not an interpolated suffix: the markup sweep counts those as stems.
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "tm-scheduler-event-resize-handle tm-scheduler-event-resize-handle--left");
            builder.AddAttribute(sequence++, "draggable", "false");
            builder.AddAttribute(sequence++, "data-resize-edge", "left");
            builder.AddAttribute(sequence++, "ondragstart", "event.preventDefault(); event.stopPropagation();");
            builder.CloseElement();

            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "tm-scheduler-event-resize-handle tm-scheduler-event-resize-handle--right");
            builder.AddAttribute(sequence++, "draggable", "false");
            builder.AddAttribute(sequence++, "data-resize-edge", "right");
            builder.AddAttribute(sequence++, "ondragstart", "event.preventDefault(); event.stopPropagation();");
            builder.CloseElement();
        }

        builder.AddElementReferenceCapture(sequence, r => _eventRefs[e.Id] = r);
        builder.CloseElement();
    };

    private RenderFragment NowLine(bool labelled) => builder =>
    {
        builder.OpenComponent<SchedulerNowIndicator>(0);
        builder.AddComponentParameter(1, nameof(SchedulerNowIndicator.Date), DateOnly.FromDateTime(CurrentDate));
        builder.AddComponentParameter(2, nameof(SchedulerNowIndicator.RangeStartMinutes), RangeStartMinutes);
        builder.AddComponentParameter(3, nameof(SchedulerNowIndicator.RangeMinutes), RangeMinutes);
        builder.AddComponentParameter(4, nameof(SchedulerNowIndicator.TimeZone), TimeZone);
        builder.AddComponentParameter(5, nameof(SchedulerNowIndicator.Axis), SchedulerNowAxis.Horizontal);
        builder.AddComponentParameter(6, nameof(SchedulerNowIndicator.Labelled), labelled);
        builder.AddComponentReferenceCapture(7, c => TrackIndicator((SchedulerNowIndicator)c));
        builder.CloseComponent();
    };

    private void TrackIndicator(SchedulerNowIndicator indicator)
    {
        if (_indicators.Contains(indicator)) return;
        indicator.OnDisposed = line => ReleaseIndicator(line);
        _indicators.Add(indicator);
    }

    private void ReleaseIndicator(SchedulerNowIndicator indicator) => _indicators.Remove(indicator);

    private List<TmScheduleResource> _resources = [];
    private Dictionary<string, List<TmScheduleEvent>> _resourceEventMap = new();
    private TmScheduleEvent? _draggedEvent;
    private string? _draggedEventOriginalResourceId;

    /// <summary>Currently displayed date.</summary>
    [Parameter] public DateTime CurrentDate { get; set; }

    /// <summary>Resources to display as rows.</summary>
    [Parameter] public IReadOnlyList<TmScheduleResource>? Resources { get; set; }

    /// <summary>Events to display.</summary>
    [Parameter] public IReadOnlyList<TmScheduleEvent>? Events { get; set; }

    /// <summary>Duration of each time slot in minutes.</summary>
    [Parameter] public int SlotDuration { get; set; } = 30;

    /// <summary>Fires when a time slot is clicked.</summary>
    [Parameter] public EventCallback<(DateTime Start, DateTime End)> OnSlotClick { get; set; }

    /// <summary>Fires when an event is clicked.</summary>
    [Parameter] public EventCallback<TmScheduleEvent> OnEventClick { get; set; }

    /// <summary>The selected event. The matching bar gets <c>aria-current</c> and <c>tm-scheduler-timeline-event--selected</c>.</summary>
    [Parameter] public TmScheduleEvent? SelectedEvent { get; set; }

    /// <summary>Fires when the user selects an event.</summary>
    [Parameter] public EventCallback<TmScheduleEvent?> SelectedEventChanged { get; set; }

    /// <summary>
    /// Optional custom event renderer used inside each positioned timeline bar.
    /// The bar's positioning and resize handles stay; only the inner content is replaced.
    /// </summary>
    [Parameter] public RenderFragment<TmScheduleEvent>? EventTemplate { get; set; }

    /// <summary>Whether events are read-only.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Fires when an event changes.</summary>
    [Parameter] public EventCallback<TmScheduleEvent> OnEventChanged { get; set; }

    /// <summary>Fires with the sentence a move or a resize should announce. The scheduler owns the one live region.</summary>
    [Parameter] public EventCallback<string> OnAnnounced { get; set; }

    /// <summary>Fires when right-clicking on a time slot.</summary>
    [Parameter] public EventCallback<SchedulerSlotContext> OnSlotContextMenu { get; set; }

    /// <summary>Fires when right-clicking on an event.</summary>
    [Parameter] public EventCallback<SchedulerEventContext> OnEventContextMenu { get; set; }

    /// <summary>First minute of the working day. With <see cref="ShowFullDay"/> false it is the first rendered hour.</summary>
    [Parameter] public TimeOnly WorkDayStart { get; set; } = new(8, 0);

    /// <summary>Last minute of the working day.</summary>
    [Parameter] public TimeOnly WorkDayEnd { get; set; } = new(17, 0);

    /// <summary>When false the timeline shows only the working hours. Default true.</summary>
    [Parameter] public bool ShowFullDay { get; set; } = true;

    /// <summary>When set, the timeline scrolls this time into view after the first render. Null does not scroll.</summary>
    [Parameter] public TimeSpan? ScrollToTime { get; set; }

    /// <summary>When true the current day draws the current-time indicator. Default true.</summary>
    [Parameter] public bool ShowNowIndicator { get; set; } = true;

    /// <summary>When true, slots outside the working day get <c>tm-scheduler-timeline-slot--offhours</c>. Default false.</summary>
    [Parameter] public bool HighlightOffHours { get; set; }



    /// <summary>Display zone for the current-time indicator.</summary>
    [Parameter] public TimeZoneInfo? TimeZone { get; set; }

    [Inject] private IServiceProvider Services { get; set; } = default!;

    private TimeProvider Clock
        => Services.GetService(typeof(TimeProvider)) as TimeProvider ?? TimeProvider.System;

    /// <summary>Replaces the default resource header.</summary>
    [Parameter] public RenderFragment<TmScheduleResource>? ResourceHeaderTemplate { get; set; }

    private int RangeStartMinutes => SchedulerRange.WorkingRange(WorkDayStart, WorkDayEnd, SlotDuration, ShowFullDay).Start;

    private int RangeMinutes
    {
        get
        {
            var (start, end) = SchedulerRange.WorkingRange(WorkDayStart, WorkDayEnd, SlotDuration, ShowFullDay);
            return Math.Max(SlotDuration, end - start);
        }
    }

    private double RangeHours => RangeMinutes / 60.0;

    private Dictionary<string, Dictionary<string, SchedulerLayout.PositionedEvent>> _lanes = new();

    protected override void OnParametersSet()
    {
        if (ShowNowIndicator)
            _ticker ??= new SchedulerNowTicker(Clock, TickIndicators);
        _slotsPerDay = RangeMinutes / Math.Max(1, SlotDuration);
        _resources = Resources?.ToList() ?? [new TmScheduleResource { Id = "_default", Name = Loc["TmScheduler_Timeline"] }];
        if (_activeResourceIndex >= _resources.Count) _activeResourceIndex = 0;
        if (_activeSlotIndex >= _slotsPerDay) _activeSlotIndex = 0;
        BuildResourceEventMap();
        BuildLanes();
    }

    private RenderFragment Slot(string resourceId, int slotIndex) => builder =>
    {
        {
            var si = slotIndex;
            var slotStart = CurrentDate.Date.AddMinutes(RangeStartMinutes + si * SlotDuration);
            var slotEnd = slotStart.AddMinutes(SlotDuration);
            var active = IsActiveSlot(resourceId, si);

            builder.OpenElement(0, "div");
            var offHours = IsOffHours(slotStart);
            builder.AddAttribute(1, "class", "tm-scheduler-timeline-slot" + (offHours ? " tm-scheduler-timeline-slot--offhours" : ""));
            builder.AddAttribute(2, "role", "button");
            builder.AddAttribute(3, "tabindex", active ? "0" : "-1");
            builder.AddAttribute(4, "aria-label", SchedulerA11y.SlotLabel(Loc, slotStart, slotEnd, CultureInfo.CurrentUICulture));
            builder.AddAttribute(5, "data-tm-roving", _rovingId);
            builder.AddAttribute(6, "data-start", slotStart.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture));
            builder.AddAttribute(7, "data-resource", resourceId);
            builder.AddAttribute(8, "style", $"left: {F(MinutePercent(RangeStartMinutes + si * SlotDuration))}%; width: {F(SlotWidthPercent())}%;");
            builder.AddAttribute(9, "ondrop", EventCallback.Factory.Create(this, () => HandleSlotDrop(slotStart, slotEnd, resourceId)));
            builder.AddEventPreventDefaultAttribute(10, "ondragover", true);
            builder.AddAttribute(11, "onclick", EventCallback.Factory.Create(this, () => OnSlotClick.InvokeAsync((slotStart, slotEnd))));
            builder.AddAttribute(12, "onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, e => HandleSlotKeyDown(e, resourceId, si)));
            builder.AddAttribute(13, "onkeyup", EventCallback.Factory.Create<KeyboardEventArgs>(this, e => HandleSlotKeyUp(e, slotStart, slotEnd)));
            builder.AddAttribute(14, "oncontextmenu", EventCallback.Factory.Create<MouseEventArgs>(this, e => HandleSlotContextMenu(e, slotStart, slotEnd, resourceId)));
            builder.AddEventPreventDefaultAttribute(15, "oncontextmenu", true);
            builder.CloseElement();
        }
    };

    private bool IsActiveSlot(string resourceId, int slotIndex)
        => _resources.Count > 0
           && resourceId == _resources[Math.Clamp(_activeResourceIndex, 0, _resources.Count - 1)].Id
           && slotIndex == _activeSlotIndex;

    private string EventAriaLabel(TmScheduleEvent e)
        => SchedulerA11y.EventLabel(Loc, e, CultureInfo.CurrentUICulture);

    private static string? EventStyle(string? color) => color is null ? null : $" --event-color: {color};";

    // Roving tabindex: Left/Right move a slot, Up/Down the resource row, Enter activates the slot.
    private async Task HandleSlotKeyDown(KeyboardEventArgs e, string resourceId, int slotIndex)
    {
        if (SchedulerA11y.HasModifier(e)) return;
        var index = ResourceIndex(resourceId) * _slotsPerDay + slotIndex;
        var target = RovingGrid.Move(index, e.Key, _slotsPerDay, _resources.Count * _slotsPerDay);
        if (target >= 0)
        {
            _activeResourceIndex = target / _slotsPerDay;
            _activeSlotIndex = target % _slotsPerDay;
            _moveFocus = true;
            return;
        }

        if (SchedulerA11y.IsEnterActivation(e))
        {
            var start = CurrentDate.Date.AddMinutes(RangeStartMinutes + slotIndex * SlotDuration);
            await OnSlotClick.InvokeAsync((start, start.AddMinutes(SlotDuration)));
        }
    }

    private Task HandleSlotKeyUp(KeyboardEventArgs e, DateTime slotStart, DateTime slotEnd)
        => SchedulerA11y.IsSpaceActivation(e) ? OnSlotClick.InvokeAsync((slotStart, slotEnd)) : Task.CompletedTask;

    private Task HandleEventKeyDown(KeyboardEventArgs e, TmScheduleEvent evt)
        => SchedulerA11y.IsEnterActivation(e) ? HandleEventClick(evt) : Task.CompletedTask;

    private Task HandleEventKeyUp(KeyboardEventArgs e, TmScheduleEvent evt)
        => SchedulerA11y.IsSpaceActivation(e) ? HandleEventClick(evt) : Task.CompletedTask;

    private bool IsSelectedEvent(TmScheduleEvent evt) => SelectedEvent is not null && SelectedEvent.Id == evt.Id;

    private async Task HandleEventClick(TmScheduleEvent evt)
    {
        await SelectedEventChanged.InvokeAsync(evt);
        await OnEventClick.InvokeAsync(evt);
    }

    private int ResourceIndex(string? resourceId)
    {
        for (var i = 0; i < _resources.Count; i++)
            if (_resources[i].Id == resourceId) return i;
        return 0;
    }

    /// <summary>The moved event is the one roving stop, even when it landed on another row.</summary>
    private bool IsEventStop(TmScheduleEvent evt, string resourceId)
        => _focusEventId == evt.Id || (_focusEventId is null && ResourceIndex(resourceId) == _activeResourceIndex);

    private string? ResourceName(string? resourceId)
        => _resources.FirstOrDefault(r => r.Id == resourceId)?.Name;

    private void BuildResourceEventMap()
    {
        _resourceEventMap.Clear();
        if (Events is null) return;

        foreach (var evt in Events)
        {
            var resourceId = evt.ResourceId ?? "_default";
            if (!_resourceEventMap.TryGetValue(resourceId, out var list))
            {
                list = [];
                _resourceEventMap[resourceId] = list;
            }
            list.Add(evt);
        }
    }

    private List<TmScheduleEvent> GetEventsForResource(string resourceId)
        => _resourceEventMap.TryGetValue(resourceId, out var list) ? list.Where(IntersectsRange).ToList() : [];

    /// <summary>An event outside the clipped range is not rendered, so it is not a focus stop either.</summary>
    private bool IntersectsRange(TmScheduleEvent evt)
    {
        var start = (int)(evt.StartLocal - CurrentDate.Date).TotalMinutes;
        var end = (int)(evt.EndLocal - CurrentDate.Date).TotalMinutes;
        if (evt.EndLocal.Date > evt.StartLocal.Date) end = 24 * 60;
        return end > RangeStartMinutes && start < RangeStartMinutes + RangeMinutes;
    }

    /// <summary>
    /// Overlapping bars of one resource stack into lanes instead of painting on top of each other.
    /// The same grouping the time grid uses, applied per resource row.
    /// </summary>
    private void BuildLanes()
    {
        _lanes = new Dictionary<string, Dictionary<string, SchedulerLayout.PositionedEvent>>();
        foreach (var (resourceId, events) in _resourceEventMap)
            _lanes[resourceId] = SchedulerLayout.Assign(events.Where(IntersectsRange).ToList()).ToDictionary(p => p.Event.Id);
    }

    private double MinutePercent(int minutes) => (minutes - RangeStartMinutes) / (double)RangeMinutes * 100;
    private double SlotWidthPercent() => SlotDuration / (double)RangeMinutes * 100;

    private int GetEventStartMinutes(TmScheduleEvent evt)
    {
        // Position by display wall-clock (StartLocal), so a display zone that differs from the
        // machine zone, and a DST day, land the bar on the hour the user sees.
        var minutes = (int)(evt.StartLocal - CurrentDate.Date).TotalMinutes;
        return Math.Clamp(minutes, RangeStartMinutes, RangeStartMinutes + RangeMinutes);
    }

    private int EventEndMinutes(TmScheduleEvent evt)
    {
        var startMin = GetEventStartMinutes(evt);
        var endMin = (int)(evt.EndLocal - CurrentDate.Date).TotalMinutes;
        return Math.Clamp(Math.Max(startMin + 1, endMin), RangeStartMinutes, RangeStartMinutes + RangeMinutes);
    }

    private SchedulerLayout.PositionedEvent LaneOf(string resourceId, TmScheduleEvent evt)
        => _lanes.TryGetValue(resourceId, out var lanes) && lanes.TryGetValue(evt.Id, out var lane)
            ? lane : new SchedulerLayout.PositionedEvent(evt, 0, 1);

    private int LaneCount(string resourceId)
        => _lanes.TryGetValue(resourceId, out var lanes) && lanes.Count > 0 ? lanes.Values.Max(l => l.TotalLanes) : 1;

    private bool IsOffHours(DateTime slotStart)
    {
        if (!HighlightOffHours) return false;
        var minute = slotStart.Hour * 60 + slotStart.Minute;
        return minute < WorkDayStart.Hour * 60 + WorkDayStart.Minute
            || minute >= WorkDayEnd.Hour * 60 + WorkDayEnd.Minute;
    }

    private void TickIndicators() => _ = InvokeAsync(() =>
    {
        if (_disposed) return;
        foreach (var indicator in _indicators.ToArray())
            indicator.Tick();
    });

    private static string F(double value) => value.ToString("F4", CultureInfo.InvariantCulture);

    private async Task HandleSlotContextMenu(MouseEventArgs e, DateTime slotStart, DateTime slotEnd, string resourceId)
    {
        if (OnSlotContextMenu.HasDelegate)
        {
            var (x, y) = await SchedulerA11y.SlotMenuPointAsync(JS, _containerRef, slotStart, resourceId, e);
            await OnSlotContextMenu.InvokeAsync(new SchedulerSlotContext
            {
                Start = slotStart,
                End = slotEnd,
                ResourceId = resourceId,
                ClientX = x,
                ClientY = y
            });
        }
    }

    private async Task HandleEventContextMenu(MouseEventArgs args, TmScheduleEvent evt)
    {
        if (OnEventContextMenu.HasDelegate)
        {
            var (x, y) = await SchedulerA11y.MenuPointAsync(JS, _eventRefs.GetValueOrDefault(evt.Id), args);
            await OnEventContextMenu.InvokeAsync(new SchedulerEventContext
            {
                Event = evt,
                ClientX = x,
                ClientY = y
            });
        }
    }

    // ── Drag & Drop ──

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("TempoBlazor.Scheduler.registerInstance", _containerRef, _dotNetRef);
                _jsRegistered = true;
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
            catch (InvalidOperationException) { }
            catch (TaskCanceledException) { }
        }

        if (_jsRegistered && ScrollToTime != _scrolledTo)
        {
            _scrolledTo = ScrollToTime;
            if (ScrollToTime is { } scrollTo)
            {
                try
                {
                    await JS.InvokeVoidAsync("TempoBlazor.Scheduler.scrollToTime", _containerRef, scrollTo.TotalMinutes);
                }
                catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
                {
                    // A dropped circuit only skips the scroll.
                }
            }
        }

        if (_moveFocus)
        {
            _moveFocus = false;
            var selector = _focusEventId is { } id
                ? $"[data-event-id=\"{id}\"]"
                : ".tm-scheduler-timeline-slot[tabindex='0']";
            try
            {
                await JS.InvokeVoidAsync("TempoBlazor.Scheduler.focusRovingStop", _containerRef, selector);
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
            {
                // The tabindex already moved; a missing circuit only skips the focus.
            }
            _focusEventId = null;
        }
    }

    private void HandleDragStart(TmScheduleEvent evt, string resourceId)
    {
        if (ReadOnly || evt.IsReadOnly) return;
        _draggedEvent = evt;
        _draggedEventOriginalResourceId = resourceId;
    }

    private async Task HandleSlotDrop(DateTime slotStart, DateTime slotEnd, string targetResourceId)
    {
        if (_draggedEvent is null) return;
        var date = DateOnly.FromDateTime(slotStart).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        var minute = (int)slotStart.TimeOfDay.TotalMinutes;
        if (await CommitMoveAsync(_draggedEvent, date, minute, targetResourceId))
        {
            _draggedEvent = null;
            _draggedEventOriginalResourceId = null;
        }
    }

    /// <summary>The one move commit: HTML5 drop, the touch gesture and the keyboard alternative.</summary>
    private async Task<bool> CommitMoveAsync(TmScheduleEvent evt, string date, int minuteOfDay, string? resourceId)
    {
        var day = DateOnly.FromDateTime(evt.StartLocal).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        if (!SchedulerMove.Move(evt, day, minuteOfDay, RealResource(resourceId), ReadOnly, TimeZone, RangeStartMinutes, RangeMinutes))
            return false;
        _focusEventId = evt.Id;
        _activeResourceIndex = ResourceIndex(evt.ResourceId);
        _moveFocus = true;
        await OnEventChanged.InvokeAsync(evt);
        await OnAnnounced.InvokeAsync(SchedulerMove.MovedText(Loc, evt, ResourceName(evt.ResourceId)));
        return true;
    }

    /// <summary>The synthetic row a timeline without resources renders. It is not a real resource.</summary>
    private string? RealResource(string? resourceId)
        => resourceId is null || resourceId == "_default" ? null : resourceId;

    /// <summary>Called by the touch move when the finger releases over a row.</summary>
    [JSInvokable]
    public Task NotifyMoveComplete(string eventId, string date, int minuteOfDay, string? resourceId)
    {
        var evt = Events?.FirstOrDefault(e => e.Id == eventId);
        return evt is null ? Task.CompletedTask : CommitMoveAsync(evt, date, minuteOfDay, resourceId);
    }

    /// <summary>Called by the Alt+Arrow keyboard alternative. A shifted chord resizes instead.</summary>
    [JSInvokable]
    public async Task NotifyKeyboardStep(string eventId, int x, int y, bool shift)
    {
        var evt = Events?.FirstOrDefault(e => e.Id == eventId);
        if (evt is null) return;
        if (shift)
        {
            if (!SchedulerMove.Step(evt, x, y, true, SlotDuration, ReadOnly, true, TimeZone, RangeStartMinutes, RangeMinutes, horizontalResize: true))
                return;
            await OnEventChanged.InvokeAsync(evt);
            await OnAnnounced.InvokeAsync(SchedulerMove.ResizedText(Loc, evt));
            return;
        }
        var minute = (int)evt.StartLocal.TimeOfDay.TotalMinutes + x * SlotDuration;
        var date = DateOnly.FromDateTime(evt.StartLocal).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        var resource = ResourceAt(evt, y);
        await CommitMoveAsync(evt, date, minute, resource);
    }

    /// <summary>The resource a vertical keyboard step lands on, or the event's own when it does not move.</summary>
    private string? ResourceAt(TmScheduleEvent evt, int delta)
    {
        if (delta == 0 || _resources.Count == 0) return evt.ResourceId;
        var index = _resources.FindIndex(r => r.Id == evt.ResourceId);
        if (index < 0) index = 0;
        var next = Math.Clamp(index + delta, 0, _resources.Count - 1);
        return _resources[next].Id;
    }

    // ── Resize ──

    /// <summary>
    /// Handles the completion of a resize operation from JavaScript.
    /// </summary>
    private async Task HandleResizeComplete(string eventId, int deltaMinutes, string resizeEdge = "right")
    {
        if (ReadOnly || string.IsNullOrEmpty(eventId)) return;

        // Find the event being resized
        var evt = Events?.FirstOrDefault(e => e.Id == eventId);
        if (evt is null || evt.IsReadOnly) return;

        if (resizeEdge == "left")
        {
            // Left resize: change start time
            var newStart = evt.Start.AddMinutes(deltaMinutes);
            
            // Ensure minimum duration (don't let start go past end)
            if (newStart >= evt.End.AddMinutes(-SlotDuration))
            {
                newStart = evt.End.AddMinutes(-SlotDuration);
            }
            
            evt.Start = newStart;
        }
        else
        {
            // Right resize: change end time (default)
            evt.End = evt.End.AddMinutes(deltaMinutes);

            // Ensure minimum duration
            if (evt.End <= evt.Start.AddMinutes(SlotDuration))
            {
                evt.End = evt.Start.AddMinutes(SlotDuration);
            }
        }

        // Notify parent about the change
        await OnEventChanged.InvokeAsync(evt);
        await OnAnnounced.InvokeAsync(SchedulerMove.ResizedText(Loc, evt));
    }

    /// <summary>
    /// Called by JavaScript when a resize operation is completed.
    /// </summary>
    [JSInvokable]
    public async Task NotifyResizeComplete(string eventId, int deltaMinutes, string resizeEdge = "right")
    {
        await HandleResizeComplete(eventId, deltaMinutes, resizeEdge);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _ticker?.Dispose();
        if (_jsRegistered)
        {
            try
            {
                await JS.InvokeVoidAsync("TempoBlazor.Scheduler.unregisterInstance", _containerRef);
            }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
            catch (TaskCanceledException) { }
        }
        _dotNetRef?.Dispose();
    }
}
