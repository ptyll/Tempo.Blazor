@namespace Tempo.Blazor.Components.Scheduler
@using Tempo.Blazor.Models
@using System.Globalization
@using Microsoft.JSInterop
@using Microsoft.Extensions.DependencyInjection
@implements IAsyncDisposable
@inject IJSRuntime JS

<!-- Event args class for resize completion from JavaScript -->
<script suppress-error="BL9992">
    // This will be used by the custom event
</script>

<CascadingValue Value="_ticker" IsFixed="true">
<div class="tm-scheduler-timegrid" @ref="_containerRef" data-slot-duration="@SlotDuration"
     data-range-start="@RangeStartMinutes" data-range-minutes="@RangeMinutes"
     data-time-culture="@CultureInfo.CurrentUICulture.Name"
     style="--tm-scheduler-visible-hours: @RangeHours.ToString(CultureInfo.InvariantCulture);">
    <span id="@_moveHintId" class="tm-sr-only">@Loc["TmScheduler_MoveHint_Grid"]</span>
    <div class="tm-scheduler-timegrid-scroll" data-tm-scroll="timegrid">
    @* One sticky head, so the all-day row follows the header without a hard-coded offset. *@
    <div class="tm-scheduler-timegrid-head">
    <div class="tm-scheduler-timegrid-header">
        <div class="tm-scheduler-timegrid-time-gutter-header"></div>
        @foreach (var date in Dates)
        {
            var d = date;
            var culture = CultureInfo.CurrentUICulture;

            @if (_hasResources)
            {
                <div class="tm-scheduler-timegrid-col-header-group">
                    @if (!HideDateHeaders)
                    {
                        <div class="tm-scheduler-timegrid-col-header @ColumnClass(d)"
                             aria-label="@(IsSelectedDate(d) ? SelectedColumnLabel(d) : null)">
                            <span class="tm-scheduler-timegrid-col-header-label">
                                <span class="tm-scheduler-timegrid-col-header-weekday">@SchedulerRange.FormatColumnHeader(d, culture).Weekday</span>
                                <span class="tm-scheduler-timegrid-col-header-date">@SchedulerRange.FormatColumnHeader(d, culture).Date</span>
                            </span>
                        </div>
                    }
                    <div class="tm-scheduler-timegrid-resource-labels">
                        @foreach (var r in Resources!)
                        {
                            var resource = r;
                            <div class="tm-scheduler-timegrid-resource-label"
                                 style="@(resource.Color is not null ? $"border-bottom-color: {resource.Color};" : "")">
                                @SchedulerResourceHeader.Render(resource, ResourceHeaderTemplate)
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="tm-scheduler-timegrid-col-header @ColumnClass(d)"
                     aria-label="@(IsSelectedDate(d) ? SelectedColumnLabel(d) : null)">
                    <span class="tm-scheduler-timegrid-col-header-label">
                        <span class="tm-scheduler-timegrid-col-header-weekday">@SchedulerRange.FormatColumnHeader(d, culture).Weekday</span>
                        <span class="tm-scheduler-timegrid-col-header-date">@SchedulerRange.FormatColumnHeader(d, culture).Date</span>
                    </span>
                </div>
            }
        }
    </div>

    @* AllDay row *@
    <div class="tm-scheduler-timegrid-allday">
        <div class="tm-scheduler-timegrid-time-gutter">
            <span class="tm-scheduler-timegrid-time-label">@Loc["TmScheduler_AllDay"]</span>
        </div>
        @foreach (var date in Dates)
        {
            var d = date;
            var allDayEvents = GetAllDayEventsForDate(d);
            <div class="tm-scheduler-timegrid-allday-col">
                @foreach (var evt in allDayEvents)
                {
                    var e = evt;
                    <div @key="e.Id" class="tm-scheduler-timegrid-allday-event @(AllDayEventStyle == TmAllDayEventStyle.Tinted ? "tm-scheduler-event-surface tm-scheduler-event--tinted" : "") @(IsSelectedEvent(e) ? "tm-scheduler-timegrid-event--selected" : "")"
                         aria-current="@(IsSelectedEvent(e) ? "true" : null)"
                         role="button" tabindex="@(IsActiveColumn(d) ? "0" : "-1")"
                         aria-label="@(EventTemplate is null ? EventAriaLabel(e) : null)"
                         data-tm-roving="@_rovingId"
                         style="@EventStyle(e)"
                         @onclick="@(() => HandleEventClick(e))"
                         @onclick:stopPropagation="true"
                         @onkeydown="@(k => HandleEventKeyDown(k, e))"
                         @onkeydown:stopPropagation="true"
                         @onkeyup="@(k => HandleEventKeyUp(k, e))"
                         @onkeyup:stopPropagation="true">
                        @if (EventTemplate is not null)
                        {
                            <span class="tm-sr-only">@EventAriaLabel(e)</span>
                            @EventTemplate(e)
                        }
                        else
                        {
                            @e.Title
                        }
                    </div>
                }
            </div>
        }
    </div>
    </div>

    @if (!HideTimeGrid)
    {
    @* The track is one hour-height per visible hour, so event geometry and resize math measure the same range. *@
    <div class="tm-scheduler-timegrid-body">
        <div class="tm-scheduler-timegrid-time-gutter">
            @for (var hour = RangeStartMinutes / 60; hour <= (RangeStartMinutes + RangeMinutes) / 60 && hour <= 24; hour++)
            {
                var h = hour;
                var closing = h * 60 == RangeStartMinutes + RangeMinutes;
                @* Two literal class attributes: an interpolated suffix is an unmeasurable stem. *@
                @if (closing)
                {
                    <div class="tm-scheduler-timegrid-time-label tm-scheduler-timegrid-time-label--last"
                         style="--tm-scheduler-label-offset: @(h * 60 - RangeStartMinutes);">
                        @HourLabel(h)
                    </div>
                }
                else
                {
                    <div class="tm-scheduler-timegrid-time-label"
                         style="--tm-scheduler-label-offset: @(h * 60 - RangeStartMinutes);">
                        @HourLabel(h)
                    </div>
                }
            }
        </div>
        @foreach (var date in Dates)
        {
            var d = date;

            @if (_hasResources)
            {
                @foreach (var resource in Resources!)
                {
                    var r = resource;
                    var resEvents = GetTimedEventsForDateAndResource(d, r.Id);
                    var positioned = LayoutOverlappingEvents(resEvents);

                    <div class="tm-scheduler-timegrid-resource-col" role="group"
                         aria-label="@($"{d.ToString("D", CultureInfo.CurrentUICulture)}, {r.Name}")" data-resource="@r.Id"
                         data-date="@d.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                        @for (var slotIndex = 0; slotIndex < _slotsPerDay; slotIndex++)
                        {
                            @Slot(d, slotIndex, r.Id)
                        }
                        @RenderPositionedEvents(d, positioned)
                        @if (ShowNowIndicator)
                        {
                            @NowLine(d)
                        }
                    </div>
                }
            }
            else
            {
                var dayEvents = GetTimedEventsForDate(d);
                var positioned = LayoutOverlappingEvents(dayEvents);

                <div class="tm-scheduler-timegrid-col @ColumnClass(d)" role="group" aria-label="@d.ToString("D", CultureInfo.CurrentUICulture)"
                     data-date="@d.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                    @for (var slotIndex = 0; slotIndex < _slotsPerDay; slotIndex++)
                    {
                        @Slot(d, slotIndex, null)
                    }
                    @RenderPositionedEvents(d, positioned)
                    @if (ShowNowIndicator)
                    {
                        @NowLine(d)
                    }
                </div>
            }
        }
    </div>
    }
    </div>
</div>
</CascadingValue>

@code {
    private DotNetObjectReference<TmSchedulerTimeGrid>? _dotNetRef;
    private bool _jsRegistered;

    private int _slotsPerDay;
    private TimeSpan? _scrolledTo;
    private SchedulerNowTicker? _ticker;

    /// <summary>How many times this grid itself rendered. A now-indicator tick must not raise it.</summary>
    internal int RenderCount { get; private set; }

    protected override void OnAfterRender(bool firstRender)
    {
        RenderCount++;
        base.OnAfterRender(firstRender);
    }
    private bool _hasResources;
    private Dictionary<DateOnly, List<TmScheduleEvent>> _timedMap = new();
    private Dictionary<DateOnly, List<TmScheduleEvent>> _allDayMap = new();
    private TmScheduleEvent? _draggedEvent;
    private ElementReference _containerRef;
    private readonly Dictionary<string, ElementReference> _eventRefs = new();
    private readonly List<SchedulerNowIndicator> _indicators = [];
    private bool _disposed;

    private RenderFragment NowLine(DateOnly date) => builder =>
    {
        builder.OpenComponent<SchedulerNowIndicator>(0);
        builder.AddComponentParameter(1, nameof(SchedulerNowIndicator.Date), date);
        builder.AddComponentParameter(2, nameof(SchedulerNowIndicator.RangeStartMinutes), RangeStartMinutes);
        builder.AddComponentParameter(3, nameof(SchedulerNowIndicator.RangeMinutes), RangeMinutes);
        builder.AddComponentParameter(4, nameof(SchedulerNowIndicator.TimeZone), TimeZone);
        builder.AddComponentReferenceCapture(5, c => TrackIndicator((SchedulerNowIndicator)c));
        builder.CloseComponent();
    };

    private void TrackIndicator(SchedulerNowIndicator indicator)
    {
        if (_indicators.Contains(indicator)) return;
        indicator.OnDisposed = line => ReleaseIndicator(line);
        _indicators.Add(indicator);
    }

    private void ReleaseIndicator(SchedulerNowIndicator indicator) => _indicators.Remove(indicator);
    private bool _focusAfterRender;
    private string? _focusEventId;
    private readonly string _moveHintId = "tm-scheduler-move-hint-" + Guid.NewGuid().ToString("N");
    private readonly string _rovingId = "tm-scheduler-roving-" + Guid.NewGuid().ToString("N");
    // Flat column index over Dates x Resources, so arrows cross a resource before the next day.
    private int _activeColumnIndex;
    private int _activeSlotIndex;

    /// <summary>Dates to display as columns.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<DateOnly> Dates { get; set; } = [];

    /// <summary>Events to display.</summary>
    [Parameter] public IReadOnlyList<TmScheduleEvent>? Events { get; set; }

    /// <summary>Resources for grouping columns.</summary>
    [Parameter] public IReadOnlyList<TmScheduleResource>? Resources { get; set; }

    /// <summary>Duration of each time slot in minutes.</summary>
    [Parameter] public int SlotDuration { get; set; } = 30;

    /// <summary>Whether events are read-only (no drag/resize).</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Fires when a time slot is clicked.</summary>
    [Parameter] public EventCallback<(DateTime Start, DateTime End)> OnSlotClick { get; set; }

    /// <summary>Fires when an event is clicked.</summary>
    [Parameter] public EventCallback<TmScheduleEvent> OnEventClick { get; set; }

    /// <summary>The selected day. The matching column gets <c>tm-scheduler-timegrid-col--selected</c>.</summary>
    [Parameter] public DateTime? SelectedDate { get; set; }

    /// <summary>The selected event. The matching event gets <c>aria-current</c> and the selected class.</summary>
    [Parameter] public TmScheduleEvent? SelectedEvent { get; set; }

    /// <summary>Fires when the user selects an event.</summary>
    [Parameter] public EventCallback<TmScheduleEvent?> SelectedEventChanged { get; set; }

    /// <summary>Fires when an event is moved or resized.</summary>
    [Parameter] public EventCallback<TmScheduleEvent> OnEventChanged { get; set; }

    /// <summary>Fires with the sentence a move or a resize should announce. The scheduler owns the one live region.</summary>
    [Parameter] public EventCallback<string> OnAnnounced { get; set; }

    /// <summary>Fires when right-clicking on a time slot.</summary>
    [Parameter] public EventCallback<SchedulerSlotContext> OnSlotContextMenu { get; set; }

    /// <summary>Fires when right-clicking on an event.</summary>
    [Parameter] public EventCallback<SchedulerEventContext> OnEventContextMenu { get; set; }

    /// <summary>Optional custom event template.</summary>
    [Parameter] public RenderFragment<TmScheduleEvent>? EventTemplate { get; set; }

    /// <summary>When true, hides the hourly time grid body (only header and all-day row are shown).</summary>
    [Parameter] public bool HideTimeGrid { get; set; }

    /// <summary>Today in the display zone. The matching column gets <c>tm-scheduler-timegrid-col--today</c>.</summary>
    [Parameter] public DateOnly Today { get; set; }

    /// <summary>When true, Saturday and Sunday columns get <c>tm-scheduler-timegrid-col--weekend</c>.</summary>
    [Parameter] public bool HighlightWeekends { get; set; }

    /// <summary>Paint of an all-day event. Tinted adds <c>tm-scheduler-event--tinted</c>.</summary>
    [Parameter] public TmAllDayEventStyle AllDayEventStyle { get; set; } = TmAllDayEventStyle.Solid;

    /// <summary>First minute of the working day, used to tint and, with <see cref="ShowFullDay"/> false, to clip the grid.</summary>
    [Parameter] public TimeOnly WorkDayStart { get; set; } = new(8, 0);

    /// <summary>Last minute of the working day.</summary>
    [Parameter] public TimeOnly WorkDayEnd { get; set; } = new(17, 0);

    /// <summary>When false the grid shows only <see cref="WorkDayStart"/> to <see cref="WorkDayEnd"/>. Default true.</summary>
    [Parameter] public bool ShowFullDay { get; set; } = true;

    /// <summary>When true, slots outside the working day get <c>tm-scheduler-timegrid-slot--offhours</c>. Default false.</summary>
    [Parameter] public bool HighlightOffHours { get; set; }

    /// <summary>When set, the grid scrolls this time to the top of the visible track after the first render. Null does not scroll.</summary>
    [Parameter] public TimeSpan? ScrollToTime { get; set; }

    /// <summary>When true, today's column draws the current-time indicator. Default true.</summary>
    [Parameter] public bool ShowNowIndicator { get; set; } = true;

    /// <summary>Display zone for the current-time indicator. Null uses the injected clock's local zone.</summary>
    [Parameter] public TimeZoneInfo? TimeZone { get; set; }

    /// <summary>When true, a Day view with resources hides the date header above them. The date is already the view.</summary>
    [Parameter] public bool HideDateHeaders { get; set; }

    /// <summary>Replaces the default resource header (avatar, name, type).</summary>
    [Parameter] public RenderFragment<TmScheduleResource>? ResourceHeaderTemplate { get; set; }

    /// <summary>When true, a timed event names its resource under the title.</summary>
    [Parameter] public bool ShowEventResource { get; set; }

    private int RangeStartMinutes => SchedulerRange.WorkingRange(WorkDayStart, WorkDayEnd, SlotDuration, ShowFullDay).Start;

    private int RangeMinutes
    {
        get
        {
            var (start, end) = SchedulerRange.WorkingRange(WorkDayStart, WorkDayEnd, SlotDuration, ShowFullDay);
            return Math.Max(SlotDuration, end - start);
        }
    }

    private double RangeHours => RangeMinutes / 60.0;

    [Inject] private IServiceProvider Services { get; set; } = default!;

    private TimeProvider Clock
        => _clock ??= Services.GetService(typeof(TimeProvider)) as TimeProvider ?? TimeProvider.System;
    private TimeProvider? _clock;

    private string SelectedColumnLabel(DateOnly date)
    {
        var header = SchedulerRange.FormatColumnHeader(date, CultureInfo.CurrentUICulture);
        return $"{header.Weekday} {header.Date}, {Loc["TmScheduler_SelectedDay"]}";
    }

    private string ColumnClass(DateOnly date)
    {
        var css = "";
        if (date == Today) css = "tm-scheduler-timegrid-col--today";
        if (HighlightWeekends && date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
            css += " tm-scheduler-timegrid-col--weekend";
        if (IsSelectedDate(date)) css += " tm-scheduler-timegrid-col--selected";
        return css;
    }

    private bool IsSelectedDate(DateOnly date)
        => SelectedDate.HasValue && date == DateOnly.FromDateTime(SelectedDate.Value);

    private bool IsSelectedEvent(TmScheduleEvent evt) => SelectedEvent is not null && SelectedEvent.Id == evt.Id;

    private async Task HandleEventClick(TmScheduleEvent evt)
    {
        await SelectedEventChanged.InvokeAsync(evt);
        await OnEventClick.InvokeAsync(evt);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("TempoBlazor.Scheduler.registerInstance", _containerRef, _dotNetRef);
                _jsRegistered = true;
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }

        if (_jsRegistered && ScrollToTime != _scrolledTo)
        {
            _scrolledTo = ScrollToTime;
            if (ScrollToTime is { } scrollTo)
            {
                try
                {
                    await JS.InvokeVoidAsync("TempoBlazor.Scheduler.scrollToTime", _containerRef, scrollTo.TotalMinutes);
                }
                catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
                {
                    // A dropped circuit only skips the scroll.
                }
            }
        }

        if (_focusAfterRender)
        {
            _focusAfterRender = false;
            var selector = _focusEventId is { } id
                ? $"[data-event-id=\"{id}\"]"
                : ".tm-scheduler-timegrid-slot[tabindex='0']";
            try
            {
                await JS.InvokeVoidAsync("TempoBlazor.Scheduler.focusRovingStop", _containerRef, selector);
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
            {
                // The tabindex already moved; a missing circuit only skips the focus.
            }
            _focusEventId = null;
        }
    }

    protected override void OnParametersSet()
    {
        if (ShowNowIndicator)
            _ticker ??= new SchedulerNowTicker(Clock, TickIndicators);
        // Ceiling, so a range that is not a whole number of slots still ends on its last minute.
        var slot = Math.Max(1, SlotDuration);
        _slotsPerDay = (RangeMinutes + slot - 1) / slot;
        _hasResources = Resources is { Count: > 0 };
        if (_activeColumnIndex >= ColumnCount) _activeColumnIndex = 0;
        if (_activeSlotIndex >= _slotsPerDay) _activeSlotIndex = 0;
        BuildEventMaps();
    }

    private int ResourceCount => _hasResources ? Resources!.Count : 1;

    private int ColumnCount => Dates.Count * ResourceCount;

    private bool IsActiveSlot(DateOnly date, int slotIndex, string? resourceId = null)
        => slotIndex == _activeSlotIndex && ColumnIndex(date, resourceId) == Math.Clamp(_activeColumnIndex, 0, Math.Max(0, ColumnCount - 1));

    private bool IsActiveColumn(DateOnly date)
        => DayIndex(date) == Math.Clamp(_activeColumnIndex, 0, Math.Max(0, ColumnCount - 1)) / ResourceCount;

    /// <summary>The moved event is the one roving stop, even when it landed in another column.</summary>
    private bool IsEventStop(TmScheduleEvent evt, DateOnly date)
        => _focusEventId == evt.Id || (_focusEventId is null && IsActiveColumn(date));

    private int ColumnIndex(DateOnly date, string? resourceId)
    {
        var day = DayIndex(date);
        if (!_hasResources) return day;
        var resource = 0;
        for (var i = 0; i < Resources!.Count; i++)
            if (Resources[i].Id == resourceId) { resource = i; break; }
        return day * ResourceCount + resource;
    }

    /// <summary>The gutter reads the same short time the events do, so a 12-hour culture shows "9:00 AM".</summary>
    private string HourLabel(int hour)
        => (hour == 24 ? DateTime.Today : DateTime.Today.AddHours(hour)).ToString("t", CultureInfo.CurrentUICulture);

    private string SlotAriaLabel(DateTime slotStart)
        => SchedulerA11y.SlotLabel(Loc, slotStart, slotStart.AddMinutes(SlotDuration), CultureInfo.CurrentUICulture);

    private string EventAriaLabel(TmScheduleEvent e)
    {
        var label = SchedulerA11y.EventLabel(Loc, e, CultureInfo.CurrentUICulture);
        return ShowEventResource && ResourceName(e.ResourceId) is { } name ? $"{label}, {name}" : label;
    }

    private void TickIndicators() => _ = InvokeAsync(() =>
    {
        if (_disposed) return;
        foreach (var indicator in _indicators.ToArray())
            indicator.Tick();
    });

    private string? EventStyle(TmScheduleEvent e)
    {
        if (e.Color is null) return null;
        // Only a solid all-day fill needs a readable text colour; a tinted event uses the theme text.
        var text = e.AllDay && AllDayEventStyle != TmAllDayEventStyle.Tinted
            ? SchedulerColor.ReadableText(e.Color) : "";
        return $"--event-color: {e.Color};{text}";
    }

    // Roving tabindex: Up/Down move a slot, Left/Right a day, Enter activates the slot.
    // Roving tabindex over the flat columns. Up/Down move a slot, Left/Right a column.
    private async Task HandleSlotKeyDown(KeyboardEventArgs e, DateOnly date, int slotIndex, string? resourceId = null)
    {
        if (SchedulerA11y.HasModifier(e)) return;
        // Slots stack down a column, so Up/Down stay in it and Left/Right cross columns.
        var column = ColumnIndex(date, resourceId);
        var index = slotIndex * ColumnCount + column;
        var target = RovingGrid.Move(index, e.Key, ColumnCount, ColumnCount * _slotsPerDay);
        if (target >= 0)
        {
            _activeColumnIndex = target % ColumnCount;
            _activeSlotIndex = target / ColumnCount;
            _focusAfterRender = true;
            return;
        }

        if (SchedulerA11y.IsEnterActivation(e))
        {
            var start = date.ToDateTime(TimeOnly.MinValue).AddMinutes(RangeStartMinutes + slotIndex * SlotDuration);
            await OnSlotClick.InvokeAsync((start, start.AddMinutes(SlotDuration)));
        }
    }

    private Task HandleSlotKeyUp(KeyboardEventArgs e, DateTime slotStart, DateTime slotEnd)
        => SchedulerA11y.IsSpaceActivation(e) ? OnSlotClick.InvokeAsync((slotStart, slotEnd)) : Task.CompletedTask;

    private Task HandleEventKeyDown(KeyboardEventArgs e, TmScheduleEvent evt)
        => SchedulerA11y.IsEnterActivation(e) ? HandleEventClick(evt) : Task.CompletedTask;

    private Task HandleEventKeyUp(KeyboardEventArgs e, TmScheduleEvent evt)
        => SchedulerA11y.IsSpaceActivation(e) ? HandleEventClick(evt) : Task.CompletedTask;

    private int DayIndex(DateOnly date)
    {
        for (var i = 0; i < Dates.Count; i++)
            if (Dates[i] == date) return i;
        return 0;
    }

    private RenderFragment Slot(DateOnly d, int slotIndex, string? resourceId) => builder =>
    {
        {
            var si = slotIndex;
            var slotStart = d.ToDateTime(TimeOnly.MinValue).AddMinutes(RangeStartMinutes + si * SlotDuration);
            var slotEnd = slotStart.AddMinutes(SlotDuration);

            var active = IsActiveSlot(d, si, resourceId);
            builder.OpenElement(0, "div");
            var half = slotEnd.Minute != 0;
            var offHours = IsOffHours(slotStart);
            builder.AddAttribute(1, "class",
                "tm-scheduler-timegrid-slot" + (half ? " tm-scheduler-timegrid-slot--half" : "") + (offHours ? " tm-scheduler-timegrid-slot--offhours" : ""));
            builder.AddAttribute(2, "style",
                $"--tm-scheduler-slot-start: {si * SlotDuration}; --tm-scheduler-slot-size: {SlotDuration};");
            builder.AddAttribute(3, "role", "button");
            builder.AddAttribute(4, "tabindex", active ? "0" : "-1");
            builder.AddAttribute(5, "aria-label", SlotAriaLabel(slotStart));
            builder.AddAttribute(6, "data-start", slotStart.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture));
            builder.AddAttribute(7, "data-tm-roving", _rovingId);
            if (resourceId is not null)
                builder.AddAttribute(8, "data-resource", resourceId);
            builder.AddAttribute(10, "ondragover", "event.preventDefault()");
            builder.AddAttribute(11, "ondrop", EventCallback.Factory.Create(this, () => HandleSlotDrop(slotStart, slotEnd)));
            builder.AddAttribute(12, "onclick", EventCallback.Factory.Create(this, () => OnSlotClick.InvokeAsync((slotStart, slotEnd))));
            builder.AddAttribute(13, "onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, e => HandleSlotKeyDown(e, d, si, resourceId)));
            builder.AddAttribute(14, "onkeyup", EventCallback.Factory.Create<KeyboardEventArgs>(this, e => HandleSlotKeyUp(e, slotStart, slotEnd)));
            builder.AddAttribute(15, "oncontextmenu", EventCallback.Factory.Create<MouseEventArgs>(this, e => HandleSlotContextMenu(e, slotStart, slotEnd, resourceId)));
            builder.AddEventPreventDefaultAttribute(16, "oncontextmenu", true);
            builder.CloseElement();
        }
    };

    private RenderFragment RenderPositionedEvents(DateOnly d, IReadOnlyList<SchedulerLayout.PositionedEvent> positioned) => builder =>
    {
        var sequence = 0;
        foreach (var pe in positioned)
        {
            var e = pe.Event;
            var startMin = GetEventStartMinutes(e, d);
            var endMin = EventEndMinutes(e, d);

            builder.OpenElement(sequence++, "div");
            builder.SetKey(e.Id);
            var compact = (e.End - e.Start).TotalMinutes < 45 ? "tm-scheduler-event--compact" : "";
            builder.AddAttribute(sequence++, "class", $"tm-scheduler-timegrid-event tm-scheduler-event-surface {compact} {(IsSelectedEvent(e) ? "tm-scheduler-timegrid-event--selected" : "")} {e.CssClass}");
            if (IsSelectedEvent(e)) builder.AddAttribute(sequence++, "aria-current", "true");
            builder.AddAttribute(sequence++, "style",
                $"--tm-scheduler-event-start: {startMin - RangeStartMinutes}; --tm-scheduler-event-end: {endMin - RangeStartMinutes}; --tm-scheduler-lane: {pe.Lane}; --tm-scheduler-lanes: {pe.TotalLanes};{EventStyle(e)}");
            builder.AddAttribute(sequence++, "role", "button");
            builder.AddAttribute(sequence++, "tabindex", IsEventStop(e, d) ? "0" : "-1");
            builder.AddAttribute(sequence++, "data-tm-roving", _rovingId);
            if (EventTemplate is null)
                builder.AddAttribute(sequence++, "aria-label", EventAriaLabel(e));
            builder.AddAttribute(sequence++, "title", e.Title);
            builder.AddAttribute(sequence++, "data-event-id", e.Id);
            builder.AddAttribute(sequence++, "draggable", !ReadOnly && !e.IsReadOnly ? "true" : "false");
            if (!ReadOnly && !e.IsReadOnly)
            {
                builder.AddAttribute(sequence++, "aria-describedby", _moveHintId);
                builder.AddAttribute(sequence++, "aria-keyshortcuts", "Alt+ArrowLeft Alt+ArrowRight Alt+ArrowUp Alt+ArrowDown Alt+Shift+ArrowUp Alt+Shift+ArrowDown");
            }
            builder.AddAttribute(sequence++, "ondragstart", EventCallback.Factory.Create(this, () => HandleDragStart(e)));
            builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => HandleEventClick(e)));
            builder.AddEventStopPropagationAttribute(sequence++, "onclick", true);
            builder.AddAttribute(sequence++, "onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, k => HandleEventKeyDown(k, e)));
            builder.AddEventStopPropagationAttribute(sequence++, "onkeydown", true);
            builder.AddAttribute(sequence++, "onkeyup", EventCallback.Factory.Create<KeyboardEventArgs>(this, k => HandleEventKeyUp(k, e)));
            builder.AddEventStopPropagationAttribute(sequence++, "onkeyup", true);
            builder.AddAttribute(sequence++, "oncontextmenu", EventCallback.Factory.Create<MouseEventArgs>(this, evt => HandleEventContextMenu(evt, e)));
            builder.AddEventStopPropagationAttribute(sequence++, "oncontextmenu", true);
            builder.AddEventPreventDefaultAttribute(sequence++, "oncontextmenu", true);

            if (EventTemplate is not null)
            {
                // The template renders directly into the card. The ellipsis wrapper clipped a
                // multi-line template to one line; a host that wants ellipsis puts it on its own markup.
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "tm-sr-only");
                builder.AddContent(sequence++, EventAriaLabel(e));
                builder.CloseElement();
                builder.AddContent(sequence++, EventTemplate(e));
            }
            else
            {
                // Time
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "tm-scheduler-timegrid-event-time");
                builder.AddContent(sequence++, $"{e.Start.ToString("t", CultureInfo.CurrentUICulture)} – {e.End.ToString("t", CultureInfo.CurrentUICulture)}");
                builder.CloseElement();

                // Title
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "tm-scheduler-timegrid-event-title");
                builder.AddContent(sequence++, e.Title);
                builder.CloseElement();

                if (ShowEventResource && ResourceName(e.ResourceId) is { } resourceName)
                {
                    builder.OpenElement(sequence++, "span");
                    builder.AddAttribute(sequence++, "class", "tm-scheduler-timegrid-event-resource");
                    builder.OpenComponent<Tempo.Blazor.Components.Icons.TmIcon>(sequence++);
                    builder.AddComponentParameter(sequence++, "Name", Tempo.Blazor.Components.Icons.IconNames.Users);
                    builder.AddComponentParameter(sequence++, "Size", Tempo.Blazor.Components.Icons.IconSize.Xs);
                    builder.CloseComponent();
                    builder.AddContent(sequence++, resourceName);
                    builder.CloseElement();
                }
            }

            // Resize handles - JS handles the mousedown automatically
            if (!ReadOnly && !e.IsReadOnly)
            {
                // Top resize handle (start time)
                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "tm-scheduler-event-resize-handle tm-scheduler-event-resize-handle--top");
                builder.AddAttribute(sequence++, "draggable", "false");
                builder.AddAttribute(sequence++, "data-resize-edge", "top");
                builder.AddAttribute(sequence++, "ondragstart", "event.preventDefault(); event.stopPropagation();");
                builder.CloseElement();

                // Bottom resize handle (end time)
                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "tm-scheduler-event-resize-handle tm-scheduler-event-resize-handle--bottom");
                builder.AddAttribute(sequence++, "draggable", "false");
                builder.AddAttribute(sequence++, "data-resize-edge", "bottom");
                builder.AddAttribute(sequence++, "ondragstart", "event.preventDefault(); event.stopPropagation();");
                builder.CloseElement();
            }

            builder.AddElementReferenceCapture(28, r => _eventRefs[e.Id] = r);
            builder.CloseElement();
        }
    };

    private void BuildEventMaps()
    {
        _timedMap.Clear();
        _allDayMap.Clear();
        if (Events is null) return;

        foreach (var evt in Events)
        {
            if (evt.AllDay)
            {
                var startDate = DateOnly.FromDateTime(evt.StartLocal);
                var endDate = DateOnly.FromDateTime(evt.EndLocal.AddDays(-1));
                if (endDate < startDate) endDate = startDate;

                for (var d = startDate; d <= endDate; d = d.AddDays(1))
                {
                    if (!_allDayMap.TryGetValue(d, out var list))
                    {
                        list = [];
                        _allDayMap[d] = list;
                    }
                    list.Add(evt);
                }
            }
            else
            {
                var date = DateOnly.FromDateTime(evt.StartLocal);
                if (!_timedMap.TryGetValue(date, out var list))
                {
                    list = [];
                    _timedMap[date] = list;
                }
                list.Add(evt);
            }
        }
    }

    private List<TmScheduleEvent> GetTimedEventsForDate(DateOnly date)
        => _timedMap.TryGetValue(date, out var list) ? list.Where(IntersectsRange).ToList() : [];

    /// <summary>
    /// An event outside the clipped range is not rendered, so it is not a focus stop either. One that
    /// straddles the edge stays and is clipped to the range by the geometry.
    /// </summary>
    private bool IntersectsRange(TmScheduleEvent evt)
    {
        var start = evt.StartLocal.Hour * 60 + evt.StartLocal.Minute;
        var end = evt.EndLocal.Hour * 60 + evt.EndLocal.Minute;
        if (evt.EndLocal.Date > evt.StartLocal.Date) end = 24 * 60;
        return end > RangeStartMinutes && start < RangeStartMinutes + RangeMinutes;
    }

    private List<TmScheduleEvent> GetTimedEventsForDateAndResource(DateOnly date, string resourceId)
    {
        return GetTimedEventsForDate(date)
            .Where(e => string.Equals(e.ResourceId, resourceId, StringComparison.Ordinal)).ToList();
    }

    private List<TmScheduleEvent> GetAllDayEventsForDate(DateOnly date)
        => _allDayMap.TryGetValue(date, out var list) ? list : [];

    private double MinutePercent(int minutes) => (minutes - RangeStartMinutes) / (double)RangeMinutes * 100;

    private double SlotHeightPercent() => SlotDuration / (double)RangeMinutes * 100;

    private bool IsOffHours(DateTime slotStart)
    {
        if (!HighlightOffHours) return false;
        var minute = slotStart.Hour * 60 + slotStart.Minute;
        var end = WorkDayEnd.Hour * 60 + WorkDayEnd.Minute;
        return minute < WorkDayStart.Hour * 60 + WorkDayStart.Minute || minute >= end;
    }

    private string? ResourceName(string? resourceId)
        => Resources?.FirstOrDefault(r => r.Id == resourceId)?.Name;

    private int GetEventStartMinutes(TmScheduleEvent evt, DateOnly date)
    {
        // Position by display wall-clock (StartLocal), not the offset-bearing instant.
        var dayStart = date.ToDateTime(TimeOnly.MinValue);
        var minutes = (int)(evt.StartLocal - dayStart).TotalMinutes;
        return Math.Clamp(minutes, RangeStartMinutes, RangeStartMinutes + RangeMinutes);
    }

    private int EventEndMinutes(TmScheduleEvent evt, DateOnly date)
    {
        var startMin = GetEventStartMinutes(evt, date);
        var endMin = (int)(evt.EndLocal - date.ToDateTime(TimeOnly.MinValue)).TotalMinutes;
        return Math.Clamp(Math.Max(startMin + 1, endMin), RangeStartMinutes, RangeStartMinutes + RangeMinutes);
    }

    private static string F(double value) => value.ToString("F4", CultureInfo.InvariantCulture);

    private static IReadOnlyList<SchedulerLayout.PositionedEvent> LayoutOverlappingEvents(List<TmScheduleEvent> events)
        => SchedulerLayout.Assign(events);


    // ── Drag & Drop ──

    private void HandleDragStart(TmScheduleEvent evt) => _draggedEvent = evt;

    private async Task HandleSlotDrop(DateTime slotStart, DateTime slotEnd)
    {
        if (_draggedEvent is null) return;
        var date = DateOnly.FromDateTime(slotStart).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        var minute = (int)slotStart.TimeOfDay.TotalMinutes;
        if (await CommitMoveAsync(_draggedEvent, date, minute, null))
            _draggedEvent = null;
    }

    /// <summary>The one move commit: HTML5 drop, the touch gesture and the keyboard alternative.</summary>
    private async Task<bool> CommitMoveAsync(TmScheduleEvent evt, string date, int minuteOfDay, string? resourceId)
    {
        if (!SchedulerMove.Move(evt, date, minuteOfDay, resourceId, ReadOnly, TimeZone, RangeStartMinutes, RangeMinutes))
            return false;
        RememberMovedEvent(evt);
        await OnEventChanged.InvokeAsync(evt);
        await AnnounceAsync(SchedulerMove.MovedText(Loc, evt, ResourceName(evt.ResourceId)));
        return true;
    }

    /// <summary>The moved event becomes the roving stop, so the next key still lands on it.</summary>
    private void RememberMovedEvent(TmScheduleEvent evt)
    {
        _focusEventId = evt.Id;
        _activeColumnIndex = ColumnIndex(DateOnly.FromDateTime(evt.StartLocal), evt.ResourceId);
        _activeSlotIndex = Math.Clamp(
            ((int)evt.StartLocal.TimeOfDay.TotalMinutes - RangeStartMinutes) / Math.Max(1, SlotDuration),
            0, Math.Max(0, _slotsPerDay - 1));
        _focusAfterRender = true;
        BuildEventMaps();
        StateHasChanged();
    }

    /// <summary>Called by the touch move when the finger releases over a column.</summary>
    [JSInvokable]
    public Task NotifyMoveComplete(string eventId, string date, int minuteOfDay, string? resourceId)
        => MoveByIdAsync(eventId, date, minuteOfDay, resourceId);

    /// <summary>Called by the Alt+Arrow keyboard alternative. A shifted chord resizes instead.</summary>
    [JSInvokable]
    public async Task NotifyKeyboardStep(string eventId, int x, int y, bool shift)
    {
        var evt = Events?.FirstOrDefault(e => e.Id == eventId);
        if (evt is null) return;
        if (shift)
        {
            if (x != 0 || y == 0) return;
            if (!SchedulerMove.Step(evt, x, y, true, SlotDuration, ReadOnly, true, TimeZone, RangeStartMinutes, RangeMinutes))
                return;
            await OnEventChanged.InvokeAsync(evt);
            await AnnounceAsync(SchedulerMove.ResizedText(Loc, evt));
            return;
        }
        var date = DateOnly.FromDateTime(evt.StartLocal.AddDays(x)).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        var current = (int)evt.StartLocal.TimeOfDay.TotalMinutes;
        var minute = current + y * SlotDuration;
        // A step that would leave the day is not a move. The clamp would otherwise pull a
        // midnight-crossing event an hour earlier to keep its length inside the day.
        if (minute < 0 || minute >= 24 * 60)
            minute = current;
        if (minute == current && x == 0) return;
        await MoveByIdAsync(eventId, date, minute, null);
    }

    private Task MoveByIdAsync(string eventId, string date, int minuteOfDay, string? resourceId)
    {
        var evt = Events?.FirstOrDefault(e => e.Id == eventId);
        return evt is null ? Task.CompletedTask : CommitMoveAsync(evt, date, minuteOfDay, resourceId);
    }

    private Task AnnounceAsync(string text) => OnAnnounced.InvokeAsync(text);

    /// <summary>
    /// Handles the completion of a resize operation from JavaScript.
    /// Called when user finishes dragging the resize handle.
    /// </summary>
    private async Task HandleResizeComplete(string eventId, int deltaMinutes, string resizeEdge = "bottom")
    {
        if (ReadOnly || string.IsNullOrEmpty(eventId)) return;

        // Find the event being resized
        var evt = Events?.FirstOrDefault(e => e.Id == eventId);
        if (evt is null || evt.IsReadOnly) return;

        if (resizeEdge == "top")
        {
            // Top resize: change start time
            var newStart = evt.Start.AddMinutes(deltaMinutes);

            // Ensure minimum duration (don't let start go past end)
            if (newStart >= evt.End.AddMinutes(-SlotDuration))
            {
                newStart = evt.End.AddMinutes(-SlotDuration);
            }

            evt.Start = newStart;
        }
        else
        {
            // Bottom resize: change end time
            evt.End = evt.End.AddMinutes(deltaMinutes);

            // Ensure minimum duration
            if (evt.End <= evt.Start.AddMinutes(SlotDuration))
            {
                evt.End = evt.Start.AddMinutes(SlotDuration);
            }
        }

        // Notify parent about the change
        await OnEventChanged.InvokeAsync(evt);
        await AnnounceAsync(SchedulerMove.ResizedText(Loc, evt));
    }

    /// <summary>
    /// Called by JavaScript when a resize operation is completed.
    /// </summary>
    [JSInvokable]
    public async Task NotifyResizeComplete(string eventId, int deltaMinutes, string resizeEdge = "bottom")
    {
        await HandleResizeComplete(eventId, deltaMinutes, resizeEdge);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _ticker?.Dispose();
        if (_jsRegistered)
        {
            try
            {
                await JS.InvokeVoidAsync("TempoBlazor.Scheduler.unregisterInstance", _containerRef);
            }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
            catch (TaskCanceledException) { }
        }
        _dotNetRef?.Dispose();
    }

    // ── Context Menu ──

    private async Task HandleSlotContextMenu(MouseEventArgs e, DateTime slotStart, DateTime slotEnd, string? resourceId = null)
    {
        if (OnSlotContextMenu.HasDelegate)
        {
            var (x, y) = await MenuPointAsync(e, slotStart, resourceId);
            await OnSlotContextMenu.InvokeAsync(new SchedulerSlotContext
            {
                Start = slotStart,
                End = slotEnd,
                ClientX = x,
                ClientY = y,
                ResourceId = resourceId
            });
        }
    }

    /// <summary>A keyboard context menu reports 0,0, so the slot's own box is the point the menu opens from.</summary>
    private Task<(double X, double Y)> MenuPointAsync(MouseEventArgs e, DateTime slotStart, string? resourceId)
        => SchedulerA11y.SlotMenuPointAsync(JS, _containerRef, slotStart, resourceId, e);

    private async Task HandleEventContextMenu(MouseEventArgs e, TmScheduleEvent evt)
    {
        if (OnEventContextMenu.HasDelegate)
        {
            var (x, y) = await SchedulerA11y.MenuPointAsync(JS, _eventRefs.GetValueOrDefault(evt.Id), e);
            await OnEventContextMenu.InvokeAsync(new SchedulerEventContext
            {
                Event = evt,
                ClientX = x,
                ClientY = y
            });
        }
    }
}
