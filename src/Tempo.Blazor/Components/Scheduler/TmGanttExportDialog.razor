@namespace Tempo.Blazor.Components.Scheduler
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Abstractions.Models
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Inputs
@using Tempo.Blazor.Models

@* G6: the dialog is the core TmModal (top layer, focus trap, Escape, focus return to the trigger). The per-dialog
   class rides the overlay root; the tm-gantt__export-* classes stay on the content. *@
<TmModal Show="IsOpen"
         Class="tm-gantt__export-dialog"
         Title="@Loc["TmGantt_Export"]"
         Size="ModalSize.Large"
         MobilePresentation="MobilePresentation.Auto"
         FooterLayout="FooterLayout.Inline"
         ResolvedLayoutChanged="OnModalLayoutResolved"
         OnClose="OnClose">
    <ChildContent>
        <div class="tm-gantt__export-section">
            <h4 id="@_formatLabelId" class="tm-gantt__export-heading">@Loc["TmGantt_ExportFormat"]</h4>
            <div class="tm-gantt__export-formats" role="radiogroup" aria-labelledby="@_formatLabelId">
                @foreach (var tile in Tiles)
                {
                    <label class="@FormatClass(tile.Format)" data-testid="@TestId($"export-format-{tile.Slug}")">
                        <input type="radio" class="tm-gantt__export-format-input" name="@_formatName" value="@tile.Format.ToString()"
                               checked="@(_format == tile.Format)"
                               @onchange="() => SelectFormat(tile.Format)" />
                        <span class="tm-gantt__export-format-ring" aria-hidden="true"></span>
                        <TmIcon Name="@tile.Icon" Size="IconSize.Lg" />
                        <span class="tm-gantt__export-format-name">@Loc[tile.LabelKey]</span>
                    </label>
                }
            </div>
        </div>

        @if (IsImage)
        {
            <div class="tm-gantt__export-section tm-gantt__export-options">
                <h4 class="tm-gantt__export-heading">@Loc["TmGantt_ExportOptions"]</h4>
                <div class="tm-gantt__export-paper-row">
                    <TmSelect TValue="string" Label="@Loc["TmGantt_PaperSize"]" Class="tm-gantt__export-select"
                              Value="_paperSize" ValueChanged="SetPaperSize" Options="PaperSizes"
                              data-testid="@TestId("export-paper-size")" />
                    <TmCheckbox Label="@Loc["TmGantt_Landscape"]" Value="_landscape" ValueChanged="SetLandscape"
                                Class="tm-gantt__export-checkbox" data-testid="@TestId("export-landscape")" />
                </div>
                <div class="tm-gantt__export-checks">
                    <TmCheckbox Label="@Loc["TmGantt_ExportIncludeCriticalPath"]" Value="_includeCriticalPath" ValueChanged="SetIncludeCriticalPath"
                                Class="tm-gantt__export-checkbox" data-testid="@TestId("export-include-critical-path")" />
                    <TmCheckbox Label="@Loc["TmGantt_ExportIncludeToday"]" Value="_includeToday" ValueChanged="SetIncludeToday"
                                Class="tm-gantt__export-checkbox" data-testid="@TestId("export-include-today")" />
                    <TmCheckbox Label="@Loc["TmGantt_ExportIncludeWorkload"]" Value="_includeWorkload" ValueChanged="SetIncludeWorkload"
                                Class="tm-gantt__export-checkbox" data-testid="@TestId("export-include-workload")" />
                </div>
                <TmSelect TValue="int?" Label="@Loc["TmGantt_ExportZoomLevel"]" Class="tm-gantt__export-select"
                          Value="_zoomLevel" ValueChanged="SetZoomLevel" Options="ZoomLevels"
                          data-testid="@TestId("export-zoom")" />
            </div>
        }
        else if (_format == GanttExportFormat.Xlsx)
        {
            <div class="tm-gantt__export-section tm-gantt__export-options">
                <h4 id="@_columnsLabelId" class="tm-gantt__export-heading">@Loc["TmGantt_ExportColumns"]</h4>
                <div class="tm-gantt__export-columns" role="group" aria-labelledby="@_columnsLabelId" data-testid="@TestId("export-columns")">
                    @foreach (var key in ExportableColumns)
                    {
                        var column = key;
                        <TmCheckbox Label="@GanttLabels.Column(Loc, column)" Value="IsColumnChecked(column)"
                                    ValueChanged="@(on => SetColumn(column, on))"
                                    Class="tm-gantt__export-checkbox" data-testid="@TestId($"export-column-{column}")" />
                    }
                </div>
            </div>
        }

        <div class="tm-gantt__export-section">
            <h4 class="tm-gantt__export-heading">@Loc["TmGantt_ExportPreview"]</h4>
            <div class="tm-gantt__export-preview" data-testid="@TestId("export-preview")">
                @if (PreviewContent is not null)
                {
                    @PreviewContent
                }
                else if (ShowBuiltIn)
                {
                    <TmGanttExportPreview Tasks="@PreviewTasks"
                                          Dependencies="@(PreviewDependencies ?? [])"
                                          CriticalPathIds="@PreviewCriticalPathIds"
                                          Options="@PreviewOptions()"
                                          Layout="@_modalLayout" />
                }
                else
                {
                    <TmIcon Name="gantt-chart" Size="IconSize.Lg" />
                    <span>@Loc["TmGantt_ExportPreview"]</span>
                }
            </div>
        </div>
    </ChildContent>
    <Footer>
        <TmButton Variant="ButtonVariant.Ghost" OnClick="OnClose" data-testid="@TestId("export-cancel")">
            @Loc["Tm_Cancel"]
        </TmButton>
        <TmButton Variant="ButtonVariant.Primary" OnClick="ExportAsync" data-testid="@TestId("export-submit")">
            @Loc["TmGantt_Export"]
        </TmButton>
    </Footer>
</TmModal>
