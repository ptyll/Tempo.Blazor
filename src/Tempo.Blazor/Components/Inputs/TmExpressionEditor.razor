@namespace Tempo.Blazor.Components.Inputs

<div class="tm-expression-editor @(Error is not null ? "tm-expression-editor--error" : "") @Class" @attributes="AdditionalAttributes">
    @if (Label is not null)
    {
        <label class="tm-expression-editor__label">@Label</label>
    }

    <div class="tm-expression-editor__body">
        <textarea class="tm-expression-editor__textarea"
                  value="@Value"
                  placeholder="@Placeholder"
                  disabled="@Disabled"
                  rows="4"
                  aria-invalid="@(Error is not null ? "true" : null)"
                  aria-describedby="@DescribedBy"
                  @oninput="HandleInput" />

        <div class="tm-expression-editor__panel">
            <div class="tm-expression-editor__panel-title">Variables</div>
            @if (Variables is not null)
            {
                @foreach (var v in Variables)
                {
                    <button type="button"
                            class="tm-expression-editor__var"
                            title="@v.Description"
                            disabled="@Disabled"
                            @onclick="@(() => InsertVariable(v))">
                        <span class="tm-expression-editor__var-name">@v.Name</span>
                        <span class="tm-expression-editor__var-desc">@v.Description</span>
                        <span class="tm-expression-editor__var-type">@v.Type</span>
                    </button>
                }
            }
        </div>
    </div>

    @if (Error is not null)
    {
        <div id="@ErrorId" class="tm-expression-editor__error" role="@(AnnounceError ? "alert" : null)">@Error</div>
    }
</div>

@code {
    /// <summary>Current expression text.</summary>
    [Parameter] public string Value { get; set; } = "";

    /// <summary>Fires when the expression changes.</summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Available variables for insertion.</summary>
    [Parameter] public IReadOnlyList<ExpressionVariable>? Variables { get; set; }

    /// <summary>Input placeholder text.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Label above the editor.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Disable the editor.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Error message to display.</summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>
    /// When <c>true</c> (default), the rendered <see cref="Error"/> message carries
    /// <c>role="alert"</c> so screen readers announce it assertively the moment it appears.
    /// Set <c>false</c> when the host moves focus to the invalid field itself (typically a modal
    /// submit that focuses the first invalid control): the error is then read through
    /// <c>aria-describedby</c> on the textarea, and the live region would announce the same text a
    /// second time. With <c>false</c> the message still renders, keeps its error styling and stays
    /// referenced by <c>aria-describedby</c>; only the <c>role</c> attribute is dropped.
    /// <para>
    /// Only safe when the same render that shows the error also moves focus to this control. Keep
    /// the default for validation on blur or on input, async/server validation, or when focus
    /// stays on the submit button — otherwise the error is not announced at all. With several
    /// invalid fields, pair it with a summary (e.g. TmValidationSummary) or focus the first
    /// invalid field.
    /// </para>
    /// </summary>
    [Parameter] public bool AnnounceError { get; set; } = true;

    /// <summary>Additional CSS class.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Additional attributes applied to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // ── Accessibility ────────────────────────────────────────────
    private readonly string _ariaId = Guid.NewGuid().ToString("n")[..8];
    private string ErrorId => $"{_ariaId}-error";

    /// <summary>
    /// Id of the error message a surrounding <c>TmFormField</c> currently renders (cascaded as
    /// <c>TmFormField.ErrorIdCascadingName</c>; null when the field shows no error). With no own
    /// <see cref="Error"/> the textarea describes the field-level message, so a single
    /// <c>TmFormField</c> error is reachable from the wrapped control too.
    /// </summary>
    [CascadingParameter(Name = Tempo.Blazor.Components.Forms.TmFormField.ErrorIdCascadingName)]
    private string? FormFieldErrorId { get; set; }

    private string? DescribedBy => Error is not null ? ErrorId : FormFieldErrorId;

    private async Task HandleInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? "";
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task InsertVariable(ExpressionVariable variable)
    {
        if (Disabled) return;
        var token = "{{" + variable.Name + "}}";
        Value = (Value ?? "") + token;
        await ValueChanged.InvokeAsync(Value);
    }
}
