@namespace Tempo.Blazor.Components.Inputs
@inherits Tempo.Blazor.Components.TmComponentBase

<div class="tm-input-wrapper @Class">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@Id" class="tm-input-label @(Required ? "tm-input-label-required" : "")">@Label</label>
    }
    <textarea id="@Id"
              placeholder="@Placeholder"
              rows="@Rows"
              maxlength="@MaxLength"
              disabled="@Disabled"
              required="@Required"
              tabindex="@TabIndex"
              autocomplete="@AutoComplete"
              aria-required="@(Required ? "true" : null)"
              aria-invalid="@(IsInvalid ? "true" : null)"
              aria-describedby="@DescribedBy"
              class="@InputCssClass"
              @attributes="AdditionalAttributes"
              @onchange="HandleOnChange"
              @oninput="HandleOnInput">@Value</textarea>
    @if (!string.IsNullOrEmpty(Error))
    {
        <div id="@ErrorId" data-testid="@TestId("error-message")" class="tm-input-error-message" role="@(AnnounceError ? "alert" : null)">@Error</div>
    }
</div>

@code {
    /// <summary>Current text value.</summary>
    [Parameter] public string Value { get; set; } = string.Empty;

    /// <summary>Fires when the value changes.</summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Label shown above the textarea.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Placeholder text.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Validation error message.</summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>
    /// When <c>true</c> (default), the rendered <see cref="Error"/> message carries
    /// <c>role="alert"</c> so screen readers announce it assertively the moment it appears.
    /// Set <c>false</c> when the host moves focus to the invalid field itself (typically a modal
    /// submit that focuses the first invalid control): the error is then read through
    /// <c>aria-describedby</c> on the textarea, and the live region would announce the same text a
    /// second time. With <c>false</c> the message still renders, keeps its error styling and stays
    /// referenced by <c>aria-describedby</c>; only the <c>role</c> attribute is dropped.
    /// <para>
    /// Only safe when the same render that shows the error also moves focus to this control. Keep
    /// the default for validation on blur or on input, async/server validation, or when focus
    /// stays on the submit button — otherwise the error is not announced at all. With several
    /// invalid fields, pair it with a summary (e.g. TmValidationSummary) or focus the first
    /// invalid field.
    /// </para>
    /// </summary>
    [Parameter] public bool AnnounceError { get; set; } = true;

    /// <summary>Number of visible rows. Defaults to 3.</summary>
    [Parameter] public int Rows { get; set; } = 3;

    /// <summary>Maximum character count.</summary>
    [Parameter] public int? MaxLength { get; set; }

    /// <summary>Disables the textarea.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Marks the textarea as required. Shows a required marker on the label and sets aria-required on the &lt;textarea&gt; element.</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>Tab index.</summary>
    [Parameter] public int TabIndex { get; set; } = 0;

    /// <summary>HTML id attribute.</summary>
    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString("n")[..8];

    /// <summary>HTML autocomplete attribute. Common values: "on", "off".</summary>
    [Parameter] public string? AutoComplete { get; set; }

    /// <summary>When true, fires ValueChanged on every keystroke instead of on blur.</summary>
    [Parameter] public bool Immediate { get; set; }

    /// <summary>Additional CSS class(es).</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Additional attributes to be applied to the textarea element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // ── Accessibility ────────────────────────────────────────────
    private bool IsInvalid => !string.IsNullOrEmpty(Error);
    private string ErrorId => $"{Id}-error";

    /// <summary>
    /// Id of the error message a surrounding <c>TmFormField</c> currently renders (cascaded as
    /// <c>TmFormField.ErrorIdCascadingName</c>; null when the field shows no error). With no own
    /// <see cref="Error"/> the textarea describes the field-level message, so a single
    /// <c>TmFormField</c> error is reachable from the wrapped control too.
    /// </summary>
    [CascadingParameter(Name = Tempo.Blazor.Components.Forms.TmFormField.ErrorIdCascadingName)]
    private string? FormFieldErrorId { get; set; }

    private string? DescribedBy => !string.IsNullOrEmpty(Error) ? ErrorId : FormFieldErrorId;

    private string InputCssClass =>
        $"tm-input tm-textarea{(string.IsNullOrEmpty(Error) ? "" : " tm-input-error")}{(Disabled ? " tm-input-disabled" : "")}";

    private async Task HandleOnChange(ChangeEventArgs e)
    {
        if (!Immediate)
            await ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
    }

    private async Task HandleOnInput(ChangeEventArgs e)
    {
        if (Immediate)
            await ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
    }
}
