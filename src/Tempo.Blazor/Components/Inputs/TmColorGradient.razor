@namespace Tempo.Blazor.Components.Inputs
@using Tempo.Blazor.Abstractions.Models
@inject ITmLocalizer Loc

<div class="tm-color-gradient @Class" @ref="_rootRef" @attributes="AdditionalAttributes">
    @* SV Gradient Area. The pointer gesture lives in tm-color-gradient.js (fractions of the real
       element size, rAF-throttled preview, single commit, cancel restores). All three sliders are
       keyboard-operable tab stops: arrows step 1% (Shift 10%), Home/End jump to a bound, and every
       key commits through the same NotifyChangedAsync path the RGBA inputs use. The axis keys'
       scroll default is cancelled in the JS module (a render-time @onkeydown:preventDefault would
       swallow Tab too). *@
    <div class="tm-color-gradient-area"
         role="slider"
         tabindex="0"
         aria-label="@Loc["TmColorGradient_Area"]"
         aria-valuemin="0"
         aria-valuemax="100"
         aria-valuenow="@((int)Math.Round(_saturation * 100))"
         aria-valuetext="@Loc["TmColorGradient_AreaValue", (int)Math.Round(_saturation * 100), (int)Math.Round(_value * 100)]"
         style="background-color: @(_hueColor);"
         @onkeydown="OnAreaKeyDownAsync">
        <div class="tm-color-gradient-saturation"></div>
        <div class="tm-color-gradient-value"></div>
        <div class="tm-color-gradient-thumb"
             style="left: @((_saturation * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; top: @((100 - _value * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;">
        </div>
    </div>

    @* Hue Slider *@
    <div class="tm-color-gradient-hue-track"
         role="slider"
         tabindex="0"
         aria-label="@Loc["TmColorGradient_Hue"]"
         aria-valuemin="0" aria-valuemax="360" aria-valuenow="@((int)Math.Round(_hue))"
         aria-valuetext="@Loc["TmColorGradient_HueValue", (int)Math.Round(_hue)]"
         @onkeydown="OnHueKeyDownAsync">
        <div class="tm-color-gradient-hue-fill" style="width: @((_hue / 360 * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
        <div class="tm-color-gradient-hue-thumb" style="left: @((_hue / 360 * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
    </div>

    @* Alpha Slider *@
    @if (ShowAlpha)
    {
        <div class="tm-color-gradient-alpha-track"
             role="slider"
             tabindex="0"
             aria-label="@Loc["TmColorGradient_Alpha"]"
             aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)Math.Round(_alpha * 100))"
             @onkeydown="OnAlphaKeyDownAsync">
            <div class="tm-color-gradient-alpha-bg"></div>
            <div class="tm-color-gradient-alpha-fill" style="width: @((_alpha * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; background: linear-gradient(to right, transparent, @ColorHelper.ToRgb(_r, _g, _b));"></div>
            <div class="tm-color-gradient-alpha-thumb" style="left: @((_alpha * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
        </div>
    }

    @* RGBA Inputs *@
    <div class="tm-color-gradient-inputs">
        <div class="tm-color-gradient-input-group">
            <label class="tm-color-gradient-input-label">R</label>
            <input type="number" min="0" max="255" aria-label="@Loc["TmColorGradient_Red"]" class="tm-color-gradient-input" value="@_r" @onchange="OnRedChanged" />
        </div>
        <div class="tm-color-gradient-input-group">
            <label class="tm-color-gradient-input-label">G</label>
            <input type="number" min="0" max="255" aria-label="@Loc["TmColorGradient_Green"]" class="tm-color-gradient-input" value="@_g" @onchange="OnGreenChanged" />
        </div>
        <div class="tm-color-gradient-input-group">
            <label class="tm-color-gradient-input-label">B</label>
            <input type="number" min="0" max="255" aria-label="@Loc["TmColorGradient_Blue"]" class="tm-color-gradient-input" value="@_b" @onchange="OnBlueChanged" />
        </div>
        @if (ShowAlpha)
        {
            <div class="tm-color-gradient-input-group">
                <label class="tm-color-gradient-input-label">A</label>
                <input type="number" min="0" max="1" step="0.01" aria-label="@Loc["TmColorGradient_Alpha"]" class="tm-color-gradient-input" value="@_alpha.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" @onchange="OnAlphaInputChanged" />
            </div>
        }
    </div>

    @* Preview *@
    <div class="tm-color-gradient-preview-row">
        <div class="tm-color-gradient-preview-bg">
            <div class="tm-color-gradient-preview" style="background: @ColorHelper.ToRgba(_r, _g, _b, _alpha);"></div>
        </div>
        <span class="tm-color-gradient-value-text">@FormatValue()</span>
    </div>
</div>
