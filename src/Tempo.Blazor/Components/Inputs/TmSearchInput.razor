@namespace Tempo.Blazor.Components.Inputs
@using Tempo.Blazor.Components.Icons
@implements IDisposable

<div class="tm-input-wrapper @Class">
    <div class="tm-input-container">
        <div class="tm-input-left-icon">
            <TmIcon Name="@IconNames.Search" Size="IconSize.Sm" />
        </div>
        <input type="search"
               aria-label="@(Placeholder ?? Loc["TmSearchInput_Placeholder"])"
               value="@Value"
               placeholder="@(Placeholder ?? Loc["TmSearchInput_Placeholder"])"
               disabled="@Disabled"
               autocomplete="@AutoComplete"
               class="@InputCssClass tm-input-with-right-icon"
               @attributes="AdditionalAttributes"
               @oninput="HandleInputAsync"
               @onchange="HandleChangeAsync" />
        @if (!string.IsNullOrEmpty(Value))
        {
            <button class="tm-search-clear"
                    type="button"
                    aria-label="@Loc["TmSearchInput_Clear"]"
                    @onclick="ClearValueAsync">
                <TmIcon Name="@IconNames.X" Size="IconSize.Xs" />
            </button>
        }
    </div>
</div>

@code {
    /// <summary>Current search text.</summary>
    [Parameter] public string Value { get; set; } = string.Empty;

    /// <summary>
    /// Fires when the search value changes. Raised at most once per change: the input element reports
    /// a single user edit as both an <c>input</c> and a <c>change</c> event, and the same value is
    /// never delivered twice in a row.
    /// </summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Placeholder text. When null, falls back to the localized default.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Disables the search input.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Debounce delay in milliseconds (0 = no debounce).</summary>
    [Parameter] public int DebounceMs { get; set; } = 0;

    /// <summary>HTML autocomplete attribute. Defaults to "off" for search inputs. Common values: "on", "off".</summary>
    [Parameter] public string? AutoComplete { get; set; } = "off";

    /// <summary>Additional CSS class(es).</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Additional attributes to be applied to the input element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string InputCssClass =>
        $"tm-input tm-input-search tm-input-with-left-icon{(Disabled ? " tm-input-disabled" : "")}";

    // volatile because the test-visible property below is polled off the renderer thread.
    private volatile System.Timers.Timer? _debounce;
    private bool _disposed;

    /// <summary>
    /// Test-visible state: is a debounce timer still armed? The "the pending debounce must not
    /// deliver" assertions wait on THIS — <see cref="CancelDebounce"/> disposes and clears the
    /// reference, so a still-armed timer means a delivery is still possible — instead of sleeping a
    /// fixed wall-clock margin past the deadline.
    /// </summary>
    internal bool HasPendingDebounce => _debounce is not null;

    // Last value handed to ValueChanged. Deliberately NOT compared against the Value parameter:
    // consumers may bind only ValueChanged and never supply Value, which would leave Value
    // permanently empty and defeat the duplicate suppression exactly where it is needed.
    // Only ever read/written on the renderer's synchronization context.
    private string? _lastDispatchedValue;

    // The Value seen on the previous render, so an external write can be told apart from the
    // consumer simply feeding our own dispatch back. Not a substitute for _lastDispatchedValue.
    private string? _previousValueParameter;
    private bool _hasSeenValueParameter;

    protected override void OnParametersSet()
    {
        // React to Value *changing*, never to what Value currently is: a consumer that binds only
        // ValueChanged leaves Value at string.Empty forever, so it never changes and this block stays
        // inert for exactly the bindings the duplicate suppression has to keep protecting.
        if (_hasSeenValueParameter && string.Equals(_previousValueParameter, Value, StringComparison.Ordinal))
        {
            return;
        }

        _previousValueParameter = Value;
        _hasSeenValueParameter = true;

        // Value moved to something other than what we last delivered, so the consumer set it itself
        // (a reset button, a restored saved search). The box no longer holds what we dispatched, so
        // forget it — otherwise retyping that same text would be suppressed and never searched for.
        if (!string.Equals(_lastDispatchedValue, Value, StringComparison.Ordinal))
        {
            _lastDispatchedValue = null;
        }
    }

    /// <summary>
    /// Hands <paramref name="value"/> to <see cref="ValueChanged"/> unless the very same value was
    /// already delivered. The input element raises both <c>input</c> and <c>change</c> for a single
    /// user edit, so without this guard every edit would be delivered twice.
    /// </summary>
    private Task DispatchAsync(string value)
    {
        if (string.Equals(_lastDispatchedValue, value, StringComparison.Ordinal))
        {
            return Task.CompletedTask;
        }

        _lastDispatchedValue = value;
        return ValueChanged.InvokeAsync(value);
    }

    /// <summary>Stops and discards a pending debounce timer so it can no longer deliver.</summary>
    private void CancelDebounce()
    {
        _debounce?.Stop();
        _debounce?.Dispose();
        _debounce = null;
    }

    private async Task HandleInputAsync(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        if (DebounceMs > 0)
        {
            CancelDebounce();

            var timer = new System.Timers.Timer(DebounceMs) { AutoReset = false };
            timer.Elapsed += async (_, _) =>
            {
                if (_disposed) return;
                // Elapsed runs on a thread-pool thread; hop to the renderer before touching
                // _lastDispatchedValue or _debounce.
                await InvokeAsync(() =>
                {
                    // A timer that was cancelled (change/clear) after Elapsed already fired must not deliver.
                    if (_disposed || !ReferenceEquals(_debounce, timer)) return Task.CompletedTask;
                    return DispatchAsync(value);
                });
            };
            _debounce = timer;
            timer.Start();
        }
        else
        {
            await DispatchAsync(value);
        }
    }

    private async Task HandleChangeAsync(ChangeEventArgs e)
    {
        // change follows input for the same edit (blur, Enter, autofill, the browser's native clear
        // cross). Drop the pending debounce so the edit is delivered once, now.
        CancelDebounce();
        await DispatchAsync(e.Value?.ToString() ?? string.Empty);
    }

    private async Task ClearValueAsync()
    {
        // An explicit click on the clear button always delivers: a pending debounce carrying the old
        // text must never overwrite the clear, and a consumer may have set Value externally after the
        // last dispatch.
        CancelDebounce();
        _lastDispatchedValue = string.Empty;
        await ValueChanged.InvokeAsync(string.Empty);
    }

    public void Dispose()
    {
        _disposed = true;
        _debounce?.Stop();
        _debounce?.Dispose();
        _debounce = null;
    }
}
