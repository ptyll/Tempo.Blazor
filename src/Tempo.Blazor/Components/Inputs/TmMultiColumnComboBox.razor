@namespace Tempo.Blazor.Components.Inputs
@using Tempo.Blazor.Abstractions.Models
@typeparam TItem
@typeparam TValue
@inject ITmLocalizer Loc

<div @ref="_rootRef" class="tm-multi-column-combo-box @(Disabled ? "tm-multi-column-combo-box--disabled" : "") @Class" @attributes="AdditionalAttributes">
    <div class="tm-multi-column-combo-box__trigger"
         role="combobox"
         tabindex="0"
         aria-expanded="@_isOpen.ToString().ToLowerInvariant()"
         aria-haspopup="grid"
         @onclick="ToggleAsync">
        @if (MultiSelect)
        {
            @if (SelectedValues.Count == 0)
            {
                <span class="tm-multi-column-combo-box__placeholder">@(Placeholder ?? Loc["TmMultiColumnComboBox_Placeholder"])</span>
            }
            else
            {
                <span class="tm-multi-column-combo-box__chips">
                    @foreach (var chip in GetSelectedChips())
                    {
                        <span class="tm-multi-column-combo-box__chip">
                            <span class="tm-multi-column-combo-box__chip-label">@chip.Text</span>
                            <button type="button"
                                    class="tm-multi-column-combo-box__chip-remove"
                                    aria-label="@(string.Format(Loc["TmMultiColumnComboBox_RemoveItem"], chip.Text))"
                                    @onclick="@(() => RemoveValueAsync(chip.Value))"
                                    @onclick:stopPropagation="true">
                                <TmIcon Name="x" />
                            </button>
                        </span>
                    }
                </span>
            }
        }
        else if (Value is null || IsEmptyValue(Value))
        {
            <span class="tm-multi-column-combo-box__placeholder">@(Placeholder ?? Loc["TmMultiColumnComboBox_Placeholder"])</span>
        }
        else
        {
            <span class="tm-multi-column-combo-box__value">@GetDisplayText(Value)</span>
        }
        @if (ShowClearButton && HasSelection)
        {
            <button type="button"
                    class="tm-multi-column-combo-box__clear"
                    aria-label="@Loc["TmMultiColumnComboBox_Clear"]"
                    @onclick="ClearValueAsync"
                    @onclick:stopPropagation="true">
                <TmIcon Name="x" />
            </button>
        }
        <TmIcon Name="chevron-down" Class="tm-multi-column-combo-box__arrow" />
    </div>

    @* The dropdown is a TmOverlayPanel: popover="manual" puts it in the browser top layer, so an
       ancestor's overflow/transform can no longer clip it. Bottom + Start + 4px + MatchAnchorWidth
       replaces the old top:calc(100%+4px);left:0;width:100% (min-width:320px stays in CSS).
       NOTE: this component's styles live in scoped CSS — the dropdown rules still apply because
       the panel is TmOverlayPanel's root element (parent scope) and its content is ChildContent
       rendered in THIS component's scope. *@
    <TmOverlayPanel Anchor="_rootRef"
                    IsOpen="_isOpen"
                    IsOpenChanged="SetOpen"
                    Placement="OverlayPlacement.Bottom"
                    Align="OverlayAlign.Start"
                    Offset="4"
                    MatchAnchorWidth="true"
                    ConstrainHeight="true"
                    Role="grid"
                    Class="tm-multi-column-combo-box__dropdown">
            @if (Filterable)
            {
                <div class="tm-multi-column-combo-box__filter">
                    <TmSearchInput Value="_filterText"
                                   ValueChanged="OnFilterChangedAsync"
                                   Placeholder="@(FilterPlaceholder ?? Loc["TmMultiColumnComboBox_FilterPlaceholder"])" />
                </div>
            }

            @if (RecentVisible)
            {
                <div class="tm-multi-column-combo-box__recent">
                    <div class="tm-multi-column-combo-box__group-label">@Loc["TmMultiColumnComboBox_Recent"]</div>
                    @foreach (var item in _recentItems)
                    {
                        <div class="tm-multi-column-combo-box__recent-item @(IsItemSelected(item) ? "tm-multi-column-combo-box__recent-item--selected" : "")"
                             @onclick="@(() => SelectItemAsync(item))">
                            @(TextField is not null ? TextField(item) : item?.ToString())
                        </div>
                    }
                </div>
            }

            <div class="tm-multi-column-combo-box__grid-wrapper">
                <table class="tm-multi-column-combo-box__grid" role="grid">
                    <thead>
                        <tr>
                            @foreach (var col in _columns)
                            {
                                <th class="tm-multi-column-combo-box__th" style="@(col.Width is not null ? $"width:{col.Width};" : "")">@col.Title</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (_filteredItems.Count == 0)
                        {
                            <tr>
                                <td class="tm-multi-column-combo-box__empty" colspan="@_columns.Count">
                                    @Loc["TmMultiColumnComboBox_NoResults"]
                                </td>
                            </tr>
                        }
                        else
                        {
                            @for (int i = 0; i < _filteredItems.Count; i++)
                            {
                                var item = _filteredItems[i];
                                var isSelected = IsItemSelected(item);
                                <tr class="tm-multi-column-combo-box__tr @(isSelected ? "tm-multi-column-combo-box__tr--selected" : "")"
                                    @key="GetItemKey(item)"
                                    @onclick="() => SelectItemAsync(item)">
                                    @foreach (var col in _columns)
                                    {
                                        <td class="tm-multi-column-combo-box__td">@col.Field(item)</td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (ShowCreateOption)
            {
                <div class="tm-multi-column-combo-box__create" @onclick="CreateNewAsync">
                    @(string.Format(Loc["TmMultiColumnComboBox_CreateNew"], _filterText))
                </div>
            }
    </TmOverlayPanel>
</div>
