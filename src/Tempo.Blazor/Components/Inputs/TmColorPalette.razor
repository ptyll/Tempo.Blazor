@namespace Tempo.Blazor.Components.Inputs
@inject ITmLocalizer Loc

<div class="tm-color-palette @Class" @ref="_rootElement" @attributes="AdditionalAttributes">
    <div class="tm-color-palette-grid"
         role="grid"
         aria-label="@Loc["TmColorPalette_SelectColor"]"
         style="grid-template-columns: repeat(@Columns, 1fr);">
        @for (var index = 0; index < _effectiveColors.Count; index++)
        {
            var color = _effectiveColors[index];
            var swatchIndex = index;
            <button type="button"
                    class="@GetSwatchClass(color, swatchIndex)"
                    style="background-color: @color;"
                    role="gridcell"
                    aria-label="@Loc["TmColorPalette_SelectColor"]"
                    aria-selected="@AriaBool(IsSelected(color))"
                    tabindex="@GetSwatchTabIndex(swatchIndex)"
                    data-palette-index="@swatchIndex"
                    @onclick="() => SelectColorAsync(color)"
                    @onfocus="() => SetKeyboardIndex(swatchIndex)"
                    @onkeydown="args => HandleSwatchKeyDown(args, swatchIndex)">
            </button>
        }
    </div>
    @if (ShowClearButton)
    {
        <button type="button" class="tm-color-palette-clear" @onclick="ClearAsync">
            @Loc["TmColorPalette_Clear"]
        </button>
    }
</div>
