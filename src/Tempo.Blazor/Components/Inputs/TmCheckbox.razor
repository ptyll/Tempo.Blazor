@namespace Tempo.Blazor.Components.Inputs
@inherits Tempo.Blazor.Components.TmComponentBase

<div class="tm-checkbox-wrapper @(Disabled ? "tm-checkbox-disabled" : "") @Class" @attributes="AdditionalAttributes">
    <label class="tm-checkbox-label">
        <input type="checkbox"
               checked="@Value"
               disabled="@Disabled"
               required="@Required"
               aria-required="@(Required ? "true" : null)"
               aria-checked="@(IsIndeterminate ? "mixed" : null)"
               class="tm-checkbox-input"
               @onchange="HandleChangeAsync"
               @attributes="InputAttributes"
               aria-describedby="@DescribedBy" />
        <span class="tm-checkbox-custom @(IsIndeterminate ? "tm-checkbox-custom-indeterminate" : "")">
            @if (Value)
            {
                <svg class="tm-checkbox-check" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12" />
                </svg>
            }
            else if (IsIndeterminate)
            {
                <svg class="tm-checkbox-indeterminate" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
            }
        </span>
        @if (!string.IsNullOrEmpty(Label))
        {
            <span class="tm-checkbox-text @(Required ? "tm-input-label-required" : "")">@Label</span>
        }
    </label>
    @if (!string.IsNullOrEmpty(HelpText))
    {
        <div id="@HelpId" data-testid="@TestId("checkbox-help")" class="tm-checkbox-help">@HelpText</div>
    }
</div>

@code {
    /// <summary>Checked state.</summary>
    [Parameter] public bool Value { get; set; }

    /// <summary>Fires when checked state changes.</summary>
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    /// <summary>Label text rendered next to the checkbox.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Help text shown below the checkbox.</summary>
    [Parameter] public string? HelpText { get; set; }

    /// <summary>Additional CSS class(es).</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Disables the checkbox.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Marks the checkbox as required. Shows a required marker on the label and sets aria-required on the checkbox input.</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>Additional attributes applied to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Shows an indeterminate (dash) state when true and Value is false.</summary>
    [Parameter] public bool Indeterminate { get; set; }

    /// <summary>
    /// Additional attributes splatted onto the NATIVE <c>&lt;input type="checkbox"&gt;</c> element
    /// (the wrapper splat <see cref="AdditionalAttributes"/> cannot reach it). Use it for the
    /// accessibility plumbing a host step owns — <c>aria-invalid</c>, <c>aria-describedby</c>,
    /// <c>aria-labelledby</c>. Entries win over the component's own attributes (the splat is
    /// applied last), except <c>aria-describedby</c>, which merges with the help text id. Additive:
    /// nothing existing changes.
    /// </summary>
    [Parameter] public Dictionary<string, object>? InputAttributes { get; set; }

    private readonly string _helpId = $"tm-checkbox-help-{Guid.NewGuid():N}";

    /// <summary>DOM id of the rendered <see cref="HelpText"/> block (referenced from the input's aria-describedby).</summary>
    private string HelpId => _helpId;

    /// <summary>
    /// The input's description: the <see cref="HelpText"/> id (when help text renders) plus any
    /// <c>aria-describedby</c> carried by <see cref="InputAttributes"/> — both stay reachable.
    /// </summary>
    private string? DescribedBy
    {
        get
        {
            var splatted = InputAttributes is not null
                && InputAttributes.TryGetValue("aria-describedby", out var value)
                && value is string text
                ? text
                : null;
            var parts = new List<string>(2);
            if (!string.IsNullOrEmpty(HelpText))
            {
                parts.Add(HelpId);
            }

            if (!string.IsNullOrWhiteSpace(splatted))
            {
                parts.Add(splatted);
            }

            return parts.Count == 0 ? null : string.Join(" ", parts);
        }
    }

    /// <summary>
    /// The mixed state as it is actually rendered: <see cref="Indeterminate"/> loses to a real
    /// check. The box carries a modifier class for it because the CSS cannot key off the
    /// <c>:indeterminate</c> pseudo-class — that DOM property is never set, so the dash used to be
    /// drawn on an unfilled box (invisible in the light theme). It also drives
    /// <c>aria-checked="mixed"</c>, without which the state is indistinguishable from unchecked
    /// for a screen reader.
    /// </summary>
    private bool IsIndeterminate => Indeterminate && !Value;

    private async Task HandleChangeAsync(ChangeEventArgs e)
    {
        if (Disabled) return;
        var newValue = e.Value is bool b && b;
        await ValueChanged.InvokeAsync(newValue);
    }
}
