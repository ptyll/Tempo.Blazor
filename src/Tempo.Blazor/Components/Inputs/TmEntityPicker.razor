@namespace Tempo.Blazor.Components.Inputs
@typeparam TItem
@typeparam TValue

<div class="tm-input-wrapper @Class" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="tm-input-label">@Label</label>
    }

    <div @ref="_rootRef" class="tm-entity-picker @(Disabled ? "tm-entity-picker--disabled" : "") @(MultiSelect ? "tm-entity-picker--multi" : "")">
        @if (MultiSelect && SelectedValues.Count > 0)
        {
            <div class="tm-entity-picker__chips">
                @foreach (var v in SelectedValues)
                {
                    var chipLabel = GetChipLabel(v);
                    <span class="tm-entity-picker__chip">
                        <span class="tm-entity-picker__chip-label">@chipLabel</span>
                        <button type="button"
                                class="tm-entity-picker__chip-remove"
                                aria-label="@(string.Format(Loc["TmEntityPicker_RemoveItem"], chipLabel))"
                                disabled="@Disabled"
                                @onclick="@(() => RemoveValueAsync(v))">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <line x1="18" y1="6" x2="6" y2="18" />
                                <line x1="6" y1="6" x2="18" y2="18" />
                            </svg>
                        </button>
                    </span>
                }
            </div>
        }

        <div class="tm-entity-picker__input-wrapper">
            <svg class="tm-entity-picker__search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input type="text"
                   value="@_searchText"
                   placeholder="@Placeholder"
                   disabled="@Disabled"
                   class="tm-entity-picker__input"
                   role="combobox"
                   aria-expanded="@(_showDropdown ? "true" : "false")"
                   aria-autocomplete="list"
                   aria-invalid="@(IsInvalid ? "true" : null)"
                   aria-describedby="@DescribedBy"
                   @oninput="HandleSearch"
                   @onfocus="HandleFocus"
                   @onblur="HandleBlur" />
            @if (_isLoading)
            {
                <div class="tm-entity-picker__loading">
                    <div class="tm-spinner tm-spinner--sm"></div>
                </div>
            }
        </div>

        @* The dropdown is a TmOverlayPanel: popover="manual" puts it in the browser top layer, so an
           ancestor's overflow/transform can no longer clip it. Bottom + Start + 4px +
           MatchAnchorWidth replaces the old top:calc(100%+4px);left:0;right:0. *@
        <TmOverlayPanel Anchor="_rootRef"
                        IsOpen="_showDropdown"
                        IsOpenChanged="SetShowDropdown"
                        Placement="OverlayPlacement.Bottom"
                        Align="OverlayAlign.Start"
                        Offset="4"
                        MatchAnchorWidth="true"
                        ConstrainHeight="true"
                        Role="listbox"
                        Class="tm-entity-picker__dropdown">
            @if (RecentVisible)
            {
                <div class="tm-entity-picker__recent">
                    <div class="tm-entity-picker__group-label">@Loc["TmEntityPicker_Recent"]</div>
                    @foreach (var item in _recentItems)
                    {
                        var recentValue = ValueSelector(item);
                        <div class="tm-entity-picker__option tm-entity-picker__recent-item @(IsSelected(recentValue) ? "tm-entity-picker__option--selected" : "")"
                             role="option"
                             aria-selected="@(IsSelected(recentValue) ? "true" : "false")"
                             @onclick="@(() => SelectItem(item))"
                             @onclick:preventDefault="true">
                            @DisplaySelector(item)
                        </div>
                    }
                </div>
            }

            @foreach (var item in _results)
            {
                var itemValue = ValueSelector(item);
                <div class="tm-entity-picker__option @(IsSelected(itemValue) ? "tm-entity-picker__option--selected" : "")"
                     role="option"
                     aria-selected="@(IsSelected(itemValue) ? "true" : "false")"
                     @onclick="@(() => SelectItem(item))"
                     @onclick:preventDefault="true">
                    @DisplaySelector(item)
                </div>
            }

            @if (ShowCreateOption)
            {
                <div class="tm-entity-picker__create"
                     role="option"
                     @onclick="CreateNewItemAsync"
                     @onclick:preventDefault="true">
                    @(string.Format(Loc["TmEntityPicker_CreateNew"], _searchText))
                </div>
            }

            @if (!HasAnyOptions && !_isLoading)
            {
                <div class="tm-entity-picker__no-results">
                    @Loc["TmEntityPicker_NoResults"]
                </div>
            }
        </TmOverlayPanel>
    </div>

    @if (!string.IsNullOrEmpty(Error))
    {
        <div id="@ErrorId" class="tm-input-error-message" role="alert">@Error</div>
    }
</div>

@code {
    private string _searchText = "";
    private bool _showDropdown;
    private bool _isLoading;
    private ElementReference _rootRef;
    private List<TItem> _results = [];
    private List<TItem> _recentItems = [];
    private readonly List<TItem> _cache = [];
    private CancellationTokenSource? _debounceToken;

    // ── Accessibility ────────────────────────────────────────────
    private readonly string _ariaId = Guid.NewGuid().ToString("n")[..8];
    private bool IsInvalid => !string.IsNullOrEmpty(Error);
    private string ErrorId => $"{_ariaId}-error";
    private string? DescribedBy => !string.IsNullOrEmpty(Error) ? ErrorId : null;

    /// <summary>Current selected value (single-select mode).</summary>
    [Parameter] public TValue? Value { get; set; }

    /// <summary>Fires when the single-select value changes.</summary>
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }

    /// <summary>Enables multi-select mode: selections are tracked via <see cref="SelectedValues"/> and rendered as chips. Default <c>false</c>.</summary>
    [Parameter] public bool MultiSelect { get; set; }

    /// <summary>The selected values in multi-select mode (source of truth when <see cref="MultiSelect"/> is <c>true</c>).</summary>
    [Parameter] public IReadOnlyList<TValue> SelectedValues { get; set; } = [];

    /// <summary>Fires when the multi-select selection changes.</summary>
    [Parameter] public EventCallback<IReadOnlyList<TValue>> SelectedValuesChanged { get; set; }

    /// <summary>Shows an inline "create new" row that calls <see cref="DataProvider"/>.CreateAsync. Requires <see cref="DataProvider"/>. Default <c>false</c>.</summary>
    [Parameter] public bool AllowCreateNew { get; set; }

    /// <summary>Shows a "recent" group loaded from <see cref="DataProvider"/>.GetRecentAsync when the picker opens. Requires <see cref="DataProvider"/>. Default <c>false</c>.</summary>
    [Parameter] public bool ShowRecent { get; set; }

    /// <summary>Optional data provider that powers the create-new and recent-items features (opt-in). The main search still flows through <see cref="SearchProvider"/>.</summary>
    [Parameter] public IDropdownDataProvider<TItem>? DataProvider { get; set; }

    /// <summary>Search provider function.</summary>
    [Parameter, EditorRequired] public Func<string, Task<IEnumerable<TItem>>> SearchProvider { get; set; } = default!;

    /// <summary>Extracts the value from an item.</summary>
    [Parameter, EditorRequired] public Func<TItem, TValue> ValueSelector { get; set; } = default!;

    /// <summary>Extracts the display text from an item.</summary>
    [Parameter, EditorRequired] public Func<TItem, string> DisplaySelector { get; set; } = default!;

    /// <summary>Field label.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Placeholder text.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Minimum characters before search triggers.</summary>
    [Parameter] public int MinSearchLength { get; set; } = 2;

    /// <summary>Debounce delay in ms.</summary>
    [Parameter] public int Debounce { get; set; } = 300;

    /// <summary>Error message.</summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>Additional CSS class(es).</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Disable the input.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Additional attributes applied to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // ── Derived render state ─────────────────────────────────────
    private bool RecentVisible => ShowRecent && _recentItems.Count > 0 && string.IsNullOrEmpty(_searchText);

    private bool ShowCreateOption => AllowCreateNew && DataProvider is not null
        && !string.IsNullOrWhiteSpace(_searchText) && _searchText.Length >= MinSearchLength;

    private bool HasAnyOptions => _results.Count > 0 || RecentVisible || ShowCreateOption;

    private bool IsSelected(TValue value) =>
        MultiSelect && SelectedValues.Any(v => EqualityComparer<TValue>.Default.Equals(v, value));

    private async Task HandleSearch(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";

        if (_searchText.Length < MinSearchLength)
        {
            _results.Clear();
            _showDropdown = RecentVisible;
            return;
        }

        _debounceToken?.Cancel();
        _debounceToken = new CancellationTokenSource();

        try
        {
            await Task.Delay(Debounce, _debounceToken.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        _isLoading = true;
        StateHasChanged();

        try
        {
            var results = await SearchProvider(_searchText);
            _results = results.ToList();
            foreach (var item in _results)
            {
                CacheItem(item);
            }
            _showDropdown = true;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SelectItem(TItem item)
    {
        CacheItem(item);
        var value = ValueSelector(item);

        if (MultiSelect)
        {
            var list = SelectedValues.ToList();
            var existing = list.FindIndex(v => EqualityComparer<TValue>.Default.Equals(v, value));
            if (existing >= 0)
            {
                list.RemoveAt(existing);
            }
            else
            {
                list.Add(value);
            }
            await SelectedValuesChanged.InvokeAsync(list);
            // Keep the dropdown open so the user can toggle multiple items.
        }
        else
        {
            _searchText = DisplaySelector(item);
            _showDropdown = false;
            _results.Clear();
            await ValueChanged.InvokeAsync(value);
        }
    }

    private async Task RemoveValueAsync(TValue value)
    {
        if (Disabled)
        {
            return;
        }
        var list = SelectedValues.Where(v => !EqualityComparer<TValue>.Default.Equals(v, value)).ToList();
        await SelectedValuesChanged.InvokeAsync(list);
    }

    private async Task CreateNewItemAsync()
    {
        if (DataProvider is null)
        {
            return;
        }

        var created = await DataProvider.CreateAsync(_searchText);
        if (created is null)
        {
            return;
        }

        await SelectItem(created);

        if (MultiSelect)
        {
            // Reset the query so the newly created chip is visible and the create row disappears.
            _searchText = string.Empty;
            _results.Clear();
        }
    }

    private async Task HandleFocus()
    {
        if (ShowRecent && DataProvider is not null && _recentItems.Count == 0 && string.IsNullOrEmpty(_searchText))
        {
            await LoadRecentAsync();
        }

        if (_results.Count > 0 || RecentVisible)
        {
            _showDropdown = true;
        }
        else if (_searchText.Length >= MinSearchLength)
        {
            _isLoading = true;
            StateHasChanged();

            try
            {
                var results = await SearchProvider(_searchText);
                _results = results.ToList();
                foreach (var item in _results)
                {
                    CacheItem(item);
                }
                _showDropdown = true;
            }
            finally
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task LoadRecentAsync()
    {
        try
        {
            var recent = await DataProvider!.GetRecentAsync();
            _recentItems = recent.ToList();
            foreach (var item in _recentItems)
            {
                CacheItem(item);
            }
            if (_recentItems.Count > 0)
            {
                _showDropdown = true;
            }
        }
        catch
        {
            _recentItems.Clear();
        }
        StateHasChanged();
    }

    private void HandleBlur()
    {
        // Delay to allow click on dropdown items
        _ = Task.Delay(200).ContinueWith(_ =>
        {
            _showDropdown = false;
            InvokeAsync(StateHasChanged);
        });
    }

    /// <summary>JS-driven dismissal (Escape or outside pointerdown from overlay.js).</summary>
    private void SetShowDropdown(bool open) => _showDropdown = open;

    private void CacheItem(TItem item)
    {
        var value = ValueSelector(item);
        _cache.RemoveAll(i => EqualityComparer<TValue>.Default.Equals(ValueSelector(i), value));
        _cache.Add(item);
    }

    private string GetChipLabel(TValue value)
    {
        foreach (var item in _cache)
        {
            if (EqualityComparer<TValue>.Default.Equals(ValueSelector(item), value))
            {
                return DisplaySelector(item);
            }
        }
        return value?.ToString() ?? string.Empty;
    }
}
