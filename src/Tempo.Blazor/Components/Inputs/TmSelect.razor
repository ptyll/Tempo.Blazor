@namespace Tempo.Blazor.Components.Inputs
@inherits Tempo.Blazor.Components.TmComponentBase
@using System.Globalization
@using Tempo.Blazor.Models
@typeparam TValue

<div class="tm-select-wrapper @Class" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@Id" class="tm-select-label @(Required ? "tm-input-label-required" : "")">@Label</label>
    }
    <div class="tm-select-container">
        @* `value` na <select> nechá Blazor promítnout předvybranou hodnotu do DOM i pro <option>
           dodané jako ChildContent (syrové <option>), kde komponenta nemůže přidat selected=".."
           na jednotlivé prvky. Bez toho ChildContent-selecty vždy ukázaly první možnost. *@
        <select id="@Id"
                value="@SelectedValueString"
                disabled="@Disabled"
                required="@Required"
                class="@SelectCssClass"
                aria-required="@(Required ? "true" : null)"
                aria-invalid="@(IsInvalid ? "true" : null)"
                aria-describedby="@DescribedBy"
                aria-label="@(AriaLabel ?? (string.IsNullOrEmpty(Label) && !string.IsNullOrEmpty(Placeholder) && !PlaceholderSelectable ? Placeholder : null))"
                @onchange="HandleChangeAsync"
                @attributes="SelectAttributes">
            @if (!string.IsNullOrEmpty(Placeholder))
            {
                <option value="" disabled="@(!PlaceholderSelectable)" selected="@IsDefaultSelection">@Placeholder</option>
            }
            @if (Options is not null)
            {
                @foreach (var opt in Options)
                {
                    <option value="@FormatOptionValue(opt.Value)" disabled="@opt.IsDisabled" selected="@IsSelected(opt.Value)">@opt.Label</option>
                }
            }
            @ChildContent
        </select>
        <div class="tm-select-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                <polyline points="6 9 12 15 18 9" />
            </svg>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(Error))
    {
        <div id="@ErrorId" data-testid="@TestId("select-error")" class="tm-select-error-message" role="@(AnnounceError ? "alert" : null)">@Error</div>
    }
    @if (!string.IsNullOrEmpty(HelpText) && string.IsNullOrEmpty(Error))
    {
        <div id="@HelpId" data-testid="@TestId("select-help")" class="tm-select-help-text">@HelpText</div>
    }
</div>

@code {
    /// <summary>Selected value.</summary>
    [Parameter] public TValue? Value { get; set; }

    /// <summary>Fires when the selection changes.</summary>
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }

    /// <summary>Label shown above the select.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Placeholder option shown when no value is selected. Rendered as <c>&lt;option value=""&gt;</c> mapped to <c>default(TValue)</c> when picked — for a non-nullable TValue that is <c>0</c>/<c>Guid.Empty</c>/..., which can collide with a real option, so use a nullable TValue when the user must be able to clear to empty. A nullable select whose bound <see cref="Value"/> may be null should include a null-valued option or set a Placeholder, otherwise the browser shows the first option.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>
    /// When <c>true</c> and <see cref="Placeholder"/> is set, the placeholder is rendered as a selectable
    /// (not disabled) <c>&lt;option value=""&gt;</c> mapped to <c>default(TValue)</c> — typically
    /// <c>null</c> for nullable types — so the user can explicitly clear the selection back to empty.
    /// When <c>false</c> (default), the placeholder is a disabled, purely decorative option.
    /// Accessibility: a selectable placeholder is a real empty choice, not a name for the control, so it
    /// is NOT used as the <c>&lt;select&gt;</c> aria-label. Set <see cref="Label"/> whenever this is
    /// <c>true</c> so the control keeps an accessible name.
    /// Validation: with <see cref="Required"/> set, picking the selectable placeholder submits the empty
    /// value, so native validation reports the field as missing ("please choose").
    /// </summary>
    [Parameter] public bool PlaceholderSelectable { get; set; }

    /// <summary>Validation error message.</summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>
    /// When <c>true</c> (default), the rendered <see cref="Error"/> message carries
    /// <c>role="alert"</c> so screen readers announce it assertively the moment it appears.
    /// Set <c>false</c> when the host moves focus to the invalid field itself (typically a modal
    /// submit that focuses the first invalid control): the error is then read through
    /// <c>aria-describedby</c> on the select, and the live region would announce the same text a
    /// second time. With <c>false</c> the message still renders, keeps its error styling and stays
    /// referenced by <c>aria-describedby</c>; only the <c>role</c> attribute is dropped.
    /// <para>
    /// Only safe when the same render that shows the error also moves focus to this control. Keep
    /// the default for validation on blur or on input, async/server validation, or when focus
    /// stays on the submit button — otherwise the error is not announced at all. With several
    /// invalid fields, pair it with a summary (e.g. TmValidationSummary) or focus the first
    /// invalid field.
    /// </para>
    /// </summary>
    [Parameter] public bool AnnounceError { get; set; } = true;

    /// <summary>Help text shown below the select when no error is present.</summary>
    [Parameter] public string? HelpText { get; set; }

    /// <summary>HTML id attribute.</summary>
    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString("n")[..8];

    /// <summary>Additional CSS class(es).</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Disables the select.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Marks the select as required. Shows a required marker on the label and sets aria-required on the &lt;select&gt; element. Caveat: every empty option (the placeholder — selectable or not — and any null-valued option) carries the empty wire value, so picking it counts as "no selection" and native validation reports the field as missing.</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>
    /// Accessible name of the &lt;select&gt; when the component has no visible <see cref="Label"/> of its own
    /// (e.g. the unit of a number + unit row, whose label names the whole row). When null the previous
    /// placeholder-derived name applies. Additive: nothing existing changes.
    /// </summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Additional attributes applied to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Additional attributes splatted onto the NATIVE <c>&lt;select&gt;</c> element (the wrapper
    /// splat <see cref="AdditionalAttributes"/> cannot reach it). Use it for the accessibility
    /// plumbing a host step owns — <c>aria-invalid</c>, <c>aria-describedby</c>,
    /// <c>aria-labelledby</c> — or any other select-level attribute. Entries win over the
    /// component's own attributes (the splat is applied last). Additive: nothing existing changes.
    /// </summary>
    [Parameter] public Dictionary<string, object>? SelectAttributes { get; set; }

    /// <summary>Typed option list. When provided, &lt;option&gt; elements are generated automatically.</summary>
    [Parameter] public IReadOnlyList<SelectOption<TValue>>? Options { get; set; }

    /// <summary>&lt;option&gt; elements for the select.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // ── Accessibility ────────────────────────────────────────────
    private bool IsInvalid => !string.IsNullOrEmpty(Error);
    private string ErrorId => $"{Id}-error";
    private string HelpId => $"{Id}-help";

    /// <summary>
    /// Id of the error message a surrounding <c>TmFormField</c> currently renders (cascaded as
    /// <c>TmFormField.ErrorIdCascadingName</c>; null when the field shows no error). With no own
    /// <see cref="Error"/> the control describes the field-level message (after its help text),
    /// so a single <c>TmFormField</c> error is reachable from the wrapped control too.
    /// </summary>
    [CascadingParameter(Name = Tempo.Blazor.Components.Forms.TmFormField.ErrorIdCascadingName)]
    private string? FormFieldErrorId { get; set; }

    private string? DescribedBy
    {
        get
        {
            if (!string.IsNullOrEmpty(Error)) return ErrorId;
            if (FormFieldErrorId is { Length: > 0 } fieldError)
                return !string.IsNullOrEmpty(HelpText) ? $"{HelpId} {fieldError}" : fieldError;
            return !string.IsNullOrEmpty(HelpText) ? HelpId : null;
        }
    }

    private bool IsSelected(TValue? optValue) =>
        EqualityComparer<TValue?>.Default.Equals(optValue, Value);

    /// <summary>True when <see cref="Value"/> is the type's default (null for reference and nullable types) and the empty option should carry the selection.</summary>
    private bool IsDefaultSelection =>
        Value is null || EqualityComparer<TValue?>.Default.Equals(Value, default);

    /// <summary>True when <c>TValue</c> is a nullable value type (<c>int?</c>, <c>decimal?</c>, <c>Guid?</c>, <c>enum?</c>, ...).</summary>
    private static bool IsNullableValueType => Nullable.GetUnderlyingType(typeof(TValue)) is not null;

    /// <summary>True when <see cref="Options"/> contains a null-valued entry — the empty option for reference types such as <c>string</c> as well.</summary>
    private bool HasNullValuedOption => Options?.Any(o => o.Value is null) ?? false;

    /// <summary>
    /// True when the rendered option list contains an <c>&lt;option value=""&gt;</c> the
    /// <c>&lt;select value=""&gt;</c> preselection can land on: the placeholder, a null-valued
    /// option from <see cref="Options"/>, or — for a nullable <c>TValue</c> — hand-written options
    /// from <see cref="ChildContent"/> (the component cannot mark raw options selected itself, so
    /// the <c>value=""</c> pin is what lands the preselection on the empty option there).
    /// </summary>
    private bool HasEmptyOptionValue =>
        !string.IsNullOrEmpty(Placeholder)
        || (Options?.Any(o => o.Value is null) ?? false)
        || (IsNullableValueType && ChildContent is not null);

    /// <summary>
    /// String form of <see cref="Value"/> for the <c>value</c> attribute on <c>&lt;select&gt;</c>. When the
    /// value is empty/default:
    /// <list type="bullet">
    /// <item>nullable value types (<c>int?</c>, <c>decimal?</c>, <c>Guid?</c>, <c>enum?</c>, ...) return
    /// <c>""</c> when an empty-valued option exists (placeholder, null-valued <see cref="Options"/> entry,
    /// or <see cref="ChildContent"/> options), so the preselection pins to that <c>&lt;option value=""&gt;</c>
    /// instead of drifting to the first option;</item>
    /// <item>reference types (<c>string</c>) return <c>""</c> only when <see cref="Options"/> contains a
    /// null-valued option — a bound null then pins to that <c>&lt;option value=""&gt;</c>; a null and an
    /// <c>""</c> option share the single empty wire value and must not be mixed;</item>
    /// <item>otherwise the attribute stays omitted — an empty string with nothing to land on would leave
    /// nothing selected (<c>selectedIndex = -1</c>), so the browser shows the first option or the option
    /// carrying the <c>selected</c> marker, exactly as before.</item>
    /// </list>
    /// Must match how <c>&lt;option&gt;</c> values are rendered (<see cref="FormatOptionValue"/>)
    /// or the preselection will not land on the matching option.
    /// </summary>
    private string? SelectedValueString
    {
        get
        {
            if (!IsDefaultSelection)
            {
                return FormatOptionValue(Value);
            }

            // A NON-nullable value type at its default (int 0 / an enum's 0 member / a struct) is a
            // real choice, not "nothing selected": emit its formatted value so the browser paints the
            // option the model actually holds. Omitting the attribute left the select blank after a
            // dialog switch back to Ascending / Any / Stop / General / column 0.
            if (typeof(TValue).IsValueType && !IsNullableValueType)
            {
                return FormatOptionValue(Value);
            }

            return (IsNullableValueType && HasEmptyOptionValue)
                || (!typeof(TValue).IsValueType && HasNullValuedOption)
                ? string.Empty
                : null;
        }
    }

    /// <summary>
    /// Culture-invariant string form of an option/selected value, used both for the rendered
    /// <c>&lt;option value&gt;</c> attribute and the <c>&lt;select value&gt;</c> preselection. A null value
    /// (the empty option) renders as <c>""</c> — never as a value-less <c>&lt;option&gt;</c>, whose value
    /// would silently become its text content. <see cref="IFormattable"/>
    /// types (numerics, <see cref="decimal"/>, ...) are formatted with <see cref="CultureInfo.InvariantCulture"/> so the
    /// rendered value never depends on the ambient thread culture (e.g. "1.5", never "1,5"); this must stay symmetric
    /// with the invariant parsing in <see cref="HandleChangeAsync"/>.
    /// </summary>
    private static string FormatOptionValue(TValue? value) =>
        value switch
        {
            null => string.Empty,
            IFormattable formattable => formattable.ToString(null, CultureInfo.InvariantCulture),
            _ => value.ToString() ?? string.Empty,
        };

    private string SelectCssClass =>
        $"tm-select{(string.IsNullOrEmpty(Error) ? "" : " tm-select-error")}{(Disabled ? " tm-select-disabled" : "")}";

    private async Task HandleChangeAsync(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();

        // An empty selection (the placeholder or a null-valued <option value="">) maps to
        // default(TValue) — null for nullable types (decimal?, int?, Guid?, enum?, string?).
        TValue? value = default;
        if (!string.IsNullOrEmpty(raw))
        {
            var targetType = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);

            const NumberStyles IntegerStyle = NumberStyles.Integer;
            const NumberStyles FloatStyle = NumberStyles.Float;

            if (targetType == typeof(string))
                value = (TValue?)(object?)raw;
            else if (targetType == typeof(int) && int.TryParse(raw, IntegerStyle, CultureInfo.InvariantCulture, out var i))
                value = (TValue?)(object?)i;
            else if (targetType == typeof(short) && short.TryParse(raw, IntegerStyle, CultureInfo.InvariantCulture, out var sh))
                value = (TValue?)(object?)sh;
            else if (targetType == typeof(ushort) && ushort.TryParse(raw, IntegerStyle, CultureInfo.InvariantCulture, out var ush))
                value = (TValue?)(object?)ush;
            else if (targetType == typeof(long) && long.TryParse(raw, IntegerStyle, CultureInfo.InvariantCulture, out var l))
                value = (TValue?)(object?)l;
            else if (targetType == typeof(ulong) && ulong.TryParse(raw, IntegerStyle, CultureInfo.InvariantCulture, out var ul))
                value = (TValue?)(object?)ul;
            else if (targetType == typeof(uint) && uint.TryParse(raw, IntegerStyle, CultureInfo.InvariantCulture, out var ui))
                value = (TValue?)(object?)ui;
            else if (targetType == typeof(byte) && byte.TryParse(raw, IntegerStyle, CultureInfo.InvariantCulture, out var by))
                value = (TValue?)(object?)by;
            else if (targetType == typeof(sbyte) && sbyte.TryParse(raw, IntegerStyle, CultureInfo.InvariantCulture, out var sb))
                value = (TValue?)(object?)sb;
            else if (targetType == typeof(decimal) && decimal.TryParse(raw, FloatStyle, CultureInfo.InvariantCulture, out var dec))
                value = (TValue?)(object?)dec;
            else if (targetType == typeof(double) && double.TryParse(raw, FloatStyle, CultureInfo.InvariantCulture, out var dbl))
                value = (TValue?)(object?)dbl;
            else if (targetType == typeof(float) && float.TryParse(raw, FloatStyle, CultureInfo.InvariantCulture, out var fl))
                value = (TValue?)(object?)fl;
            else if (targetType == typeof(Guid) && Guid.TryParse(raw, out var g))
                value = (TValue?)(object?)g;
            else if (targetType.IsEnum && Enum.TryParse(targetType, raw, out var en))
                value = (TValue?)en;
        }
        await ValueChanged.InvokeAsync(value);
    }
}
