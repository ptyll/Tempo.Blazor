@namespace Tempo.Blazor.Components.Inputs
@inherits Tempo.Blazor.Components.TmComponentBase
@typeparam TUser
@using Microsoft.AspNetCore.Components.Web
@using Tempo.Blazor.Components.Avatars
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="tm-user-picker @(Disabled ? "tm-user-picker--disabled" : "")" data-testid="@TestId("tm-user-picker")" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Label))
    {
        @* `for` only when the search box is on screen: once a user is picked the input is gone and a
           dangling `for` would point at nothing. The id is emitted unconditionally, because the chip
           that REPLACES the input borrows the very same label through `aria-labelledby`. *@
        <label id="@LabelId" for="@(ShowsSearchInput ? Id : null)" class="tm-input-label @(Required ? "tm-input-label-required" : "")">@Label</label>
    }

    @if (_selectedUser is not null)
    {
        @* Named group, not a bare div: once a user is picked the input (which carried the label through
           `for`) is gone, and a plain container cannot take an accessible name — a screen reader would
           read the picked person without ever saying WHOSE field it is. `group` is deliberate: it names a
           set of related nodes and promises no keyboard mechanism, unlike `toolbar`. No label, no role —
           a role whose only job is to carry a name is pointless when there is no name to carry. *@
        <div class="tm-user-picker__selected"
             role="@(HasLabel ? "group" : null)"
             aria-labelledby="@(HasLabel ? LabelId : null)"
             data-testid="@TestId("tm-user-picker-selected")">
            @if (SelectedTemplate is not null)
            {
                @SelectedTemplate(_selectedUser)
            }
            else
            {
                <TmAvatar Name="@AvatarName(_selectedUser)" Src="@AvatarSrc(_selectedUser)" Size="AvatarSize.Sm" />
                <span class="tm-user-picker__selected-display">@DisplaySelector(_selectedUser)</span>
                <span class="tm-user-picker__selected-login">[@ValueSelector(_selectedUser)]</span>
            }
            @if (!Disabled)
            {
                <button type="button" class="tm-user-picker__clear" @onclick="HandleClearAsync"
                        aria-label="@ClearLabel" data-testid="@TestId("tm-user-picker-clear")">&times;</button>
            }
        </div>
    }
    else if (_resolveState == TmPickerFetchState.Transient)
    {
        <div class="tm-user-picker__transient" role="alert" aria-live="polite" data-testid="@TestId("tm-user-picker-resolve-transient")">
            @if (TransientErrorTemplate is not null)
            {
                @TransientErrorTemplate(RetryResolveAsync)
            }
            else
            {
                <span>@TransientErrorText</span>
                <button type="button" class="tm-user-picker__retry" @onclick="RetryResolveAsync"
                        data-testid="@TestId("tm-user-picker-resolve-retry")">@RetryText</button>
            }
        </div>
    }
    else
    {
        <div class="tm-user-picker__search">
            <input type="text"
                   id="@Id"
                   @ref="_inputRef"
                   value="@_searchTerm"
                   placeholder="@Placeholder"
                   disabled="@Disabled"
                   required="@Required"
                   aria-required="@(Required ? "true" : null)"
                   class="tm-user-picker__input"
                   role="combobox"
                   aria-expanded="@(_showResults ? "true" : "false")"
                   aria-autocomplete="list"
                   aria-controls="@(_showResults && _results.Count > 0 ? ResultsId : null)"
                   aria-activedescendant="@ActiveDescendantId"
                   data-testid="@TestId("tm-user-picker-input")"
                   @oninput="HandleSearchInputAsync"
                   @onkeydown="HandleKeyDownAsync"
                   @onblur="HandleBlur" />

            @* PERSISTENT live region for "loading" and "no results". It is rendered even when it has
               nothing to say, and that is the whole mechanism: a live region that appears in the DOM
               together with its text is not reliably announced, because the screen reader was not
               watching the node when the text arrived. Only the MESSAGES are conditional; the region
               is not. Empty it has no box of its own — the padding lives on the messages inside.
               The transient error keeps its own `role="alert"` region: it is an interruption, not a
               progress report, and it carries a retry button that must not be announced politely. *@
            <div class="tm-user-picker__status" role="status" aria-live="polite"
                 data-testid="@TestId("tm-user-picker-status")">
                @if (_loading)
                {
                    <div class="tm-user-picker__loading" data-testid="@TestId("tm-user-picker-loading")">@LoadingText</div>
                }
                else if (_showResults && _searchState != TmPickerFetchState.Transient && _results.Count == 0)
                {
                    @if (EmptyTemplate is not null)
                    {
                        @EmptyTemplate
                    }
                    else
                    {
                        <div class="tm-user-picker__no-results" data-testid="@TestId("tm-user-picker-no-results")">@NoResultsText</div>
                    }
                }
            </div>

            @if (!_loading && _showResults && _searchState == TmPickerFetchState.Transient)
            {
                <div class="tm-user-picker__transient" role="alert" aria-live="polite" data-testid="@TestId("tm-user-picker-search-transient")">
                    @if (TransientErrorTemplate is not null)
                    {
                        @TransientErrorTemplate(RetrySearchAsync)
                    }
                    else
                    {
                        <span>@TransientErrorText</span>
                        <button type="button" class="tm-user-picker__retry" @onclick="RetrySearchAsync"
                                data-testid="@TestId("tm-user-picker-search-retry")">@RetryText</button>
                    }
                </div>
            }
            else if (!_loading && _showResults && _results.Count > 0)
            {
                <ul id="@ResultsId"
                    @ref="_menuRef"
                    class="tm-user-picker__results @(FloatingMenu ? "tm-user-picker__results--floating" : null)"
                    role="listbox" data-testid="@TestId("tm-user-picker-results")">
                    @for (var i = 0; i < _results.Count; i++)
                    {
                        var user = _results[i];
                        var active = i == _highlightedIndex;
                        <li id="@OptionId(i)"
                            class="tm-user-picker__result-item @(active ? "tm-user-picker__result-item--active" : null)"
                            role="option" aria-selected="@(active ? "true" : "false")" data-testid="@TestId("tm-user-picker-result-item")"
                            @onpointerdown="() => HandleSelectAsync(user)" @onpointerdown:preventDefault="true">
                            @if (ItemTemplate is not null)
                            {
                                @ItemTemplate(user)
                            }
                            else
                            {
                                <TmAvatar Name="@AvatarName(user)" Src="@AvatarSrc(user)" Size="AvatarSize.Xs" />
                                <span class="tm-user-picker__result-display">
                                    @if (HighlightMatches)
                                    {
                                        <TmHighlightedText Text="@DisplaySelector(user)" Query="@_searchTerm" />
                                    }
                                    else
                                    {
                                        @DisplaySelector(user)
                                    }
                                </span>
                                <span class="tm-user-picker__result-login">[@ValueSelector(user)]</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    }
</div>

@code {
    private const string ModulePath = "./_content/Tempo.Blazor/Components/Inputs/TmUserPicker.razor.js";

    private ElementReference _inputRef;
    private ElementReference _menuRef;
    private IJSObjectReference? _module;
    private bool _menuAnchored;

    private string _searchTerm = string.Empty;
    private bool _showResults;
    private bool _loading;
    private List<TUser> _results = [];
    private int _highlightedIndex = -1;
    private CancellationTokenSource? _debounceCts;
    private TUser? _selectedUser;
    private string? _loadedValue;
    private TmPickerFetchState _searchState = TmPickerFetchState.Ok;
    private TmPickerFetchState _resolveState = TmPickerFetchState.Ok;

    /// <summary>Selected user's identifying value (e.g. a login).</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Fires when the selection changes; <c>null</c> when cleared.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Debounced, cancellable search. Never bakes in retries — callers own that policy.</summary>
    [Parameter, EditorRequired] public Func<string, CancellationToken, Task<TmPickerSearchResult<TUser>>> SearchProvider { get; set; } = default!;

    /// <summary>Resolves <see cref="Value"/> into a full <typeparamref name="TUser"/> for display.</summary>
    [Parameter, EditorRequired] public Func<string, CancellationToken, Task<TmPickerResolveResult<TUser>>> ResolveProvider { get; set; } = default!;

    /// <summary>Extracts the identifying value (e.g. login) from an item.</summary>
    [Parameter, EditorRequired] public Func<TUser, string> ValueSelector { get; set; } = default!;

    /// <summary>Extracts the display text from an item.</summary>
    [Parameter, EditorRequired] public Func<TUser, string> DisplaySelector { get; set; } = default!;

    /// <summary>Extracts the name used to derive avatar initials. Falls back to <see cref="DisplaySelector"/>.</summary>
    [Parameter] public Func<TUser, string>? AvatarNameSelector { get; set; }

    /// <summary>Extracts an avatar image URL, if any.</summary>
    [Parameter] public Func<TUser, string?>? AvatarSrcSelector { get; set; }

    /// <summary>Minimum characters before a search fires. Default 3.</summary>
    [Parameter] public int MinChars { get; set; } = 3;

    /// <summary>Debounce delay in ms before a search fires. Default 300.</summary>
    [Parameter] public int DebounceMs { get; set; } = 300;

    /// <summary>Disables the input and hides the clear button.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Field label.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// Id of the search input, so the rendered <see cref="Label"/> can point at it with <c>for</c>.
    /// Defaults to a generated value; supply one when the page owns the label.
    /// </summary>
    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString("n")[..8];

    /// <summary>
    /// Marks the field required: the asterisk on the label (<c>tm-input-label-required</c>, the same
    /// marker the other inputs use) plus <c>required</c> and <c>aria-required</c> on the search input.
    /// </summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>
    /// Lifts the results list out of the normal flow so an ancestor with <c>overflow: auto</c> — a modal
    /// body, a scrolling form column — cannot clip it or scroll it away from its input. The list is then
    /// positioned against the input by script, flipping above it when there is not enough room below.
    /// Off by default: it costs a JS module import, and a picker that is not inside a scroll container
    /// does not need it.
    /// </summary>
    /// <remarks>
    /// This is a floating layer, not a DOM portal: the list stays where it is rendered and is positioned
    /// with <c>position: fixed</c>. That escapes every ancestor <c>overflow</c> up to the nearest ancestor
    /// that establishes a containing block for fixed elements (one with a <c>transform</c>, <c>filter</c>,
    /// <c>perspective</c>, <c>contain</c> or a <c>will-change</c> naming them — <c>.tm-modal</c> is one,
    /// because it animates with a transform). Inside such an ancestor the list is bounded by it instead of
    /// by the viewport, which is why the available space is measured against that box and the list flips
    /// and clamps its height to fit.
    /// </remarks>
    [Parameter] public bool FloatingMenu { get; set; }

    /// <summary>Search box placeholder.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Text shown while a search is in flight.</summary>
    [Parameter] public string LoadingText { get; set; } = "Loading...";

    /// <summary>Text shown when a search succeeds but finds nothing.</summary>
    [Parameter] public string NoResultsText { get; set; } = "No results found";

    /// <summary>Text shown when a search or resolve fails transiently.</summary>
    [Parameter] public string TransientErrorText { get; set; } = "Something went wrong. Please try again.";

    /// <summary>Retry button text for the transient-error state.</summary>
    [Parameter] public string RetryText { get; set; } = "Retry";

    /// <summary>Accessible label for the clear-selection button.</summary>
    [Parameter] public string ClearLabel { get; set; } = "Clear selection";

    /// <summary>Overrides rendering of a single result item. Defaults to avatar + display + [login].</summary>
    [Parameter] public RenderFragment<TUser>? ItemTemplate { get; set; }

    /// <summary>
    /// Wraps the part of each result's display name that matches the search term in <c>&lt;mark&gt;</c> so a
    /// reader sees where the term hit. Default <c>false</c>, so a result row keeps rendering its avatar, its
    /// full display name and its login exactly as before. The match ignores casing and diacritics and never
    /// changes the option's accessible name.
    /// </summary>
    [Parameter] public bool HighlightMatches { get; set; }

    /// <summary>Overrides the no-results message.</summary>
    [Parameter] public RenderFragment? EmptyTemplate { get; set; }

    /// <summary>
    /// Overrides the transient-error UI. Receives a retry callback that re-invokes whichever provider
    /// (search or resolve) just failed.
    /// </summary>
    [Parameter] public RenderFragment<Func<Task>>? TransientErrorTemplate { get; set; }

    /// <summary>Overrides rendering of the selected value's chip.</summary>
    [Parameter] public RenderFragment<TUser>? SelectedTemplate { get; set; }

    /// <summary>Additional HTML attributes applied to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string AvatarName(TUser user) => (AvatarNameSelector ?? DisplaySelector)(user);

    private string? AvatarSrc(TUser user) => AvatarSrcSelector?.Invoke(user);

    /// <summary>True while the combobox itself is on screen — not when a selection or a resolve error is.</summary>
    private bool ShowsSearchInput => _selectedUser is null && _resolveState != TmPickerFetchState.Transient;

    /// <summary>True when a <see cref="Label"/> is rendered and can therefore name the chip.</summary>
    private bool HasLabel => !string.IsNullOrEmpty(Label);

    /// <summary>
    /// Id of the rendered label. The search input reaches it through <c>for</c>, the selected chip
    /// through <c>aria-labelledby</c> — one label, both states.
    /// </summary>
    private string LabelId => $"{Id}-label";

    private string ResultsId => $"{Id}-results";

    private string OptionId(int index) => $"{Id}-option-{index.ToString(System.Globalization.CultureInfo.InvariantCulture)}";

    /// <summary>
    /// Id of the arrow-highlighted option, so a screen reader announces it while focus stays in the input.
    /// Null whenever no option is highlighted — an id pointing at nothing is worse than no attribute.
    /// </summary>
    private string? ActiveDescendantId =>
        _showResults && _highlightedIndex >= 0 && _highlightedIndex < _results.Count
            ? OptionId(_highlightedIndex)
            : null;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Value) && !string.Equals(_loadedValue, Value, StringComparison.Ordinal))
        {
            var requested = Value;
            var resolution = await ResolveProvider(requested, CancellationToken.None);

            // Guard against a stale resolution: Value may have changed (cleared, or re-picked) while the
            // resolve was in flight. Only apply the result if it still matches what we requested.
            if (!string.Equals(Value, requested, StringComparison.Ordinal))
            {
                return;
            }

            if (resolution.State == TmPickerFetchState.Transient)
            {
                _resolveState = TmPickerFetchState.Transient;
                _selectedUser = default;
                return;
            }

            _resolveState = TmPickerFetchState.Ok;
            _loadedValue = requested;
            _selectedUser = resolution.Item;
        }
        else if (string.IsNullOrEmpty(Value))
        {
            _selectedUser = default;
            _loadedValue = null;
            _resolveState = TmPickerFetchState.Ok;
        }
    }

    private async Task RetryResolveAsync()
    {
        if (string.IsNullOrEmpty(Value))
        {
            return;
        }

        var requested = Value;
        var resolution = await ResolveProvider(requested, CancellationToken.None);
        if (!string.Equals(Value, requested, StringComparison.Ordinal))
        {
            return;
        }

        if (resolution.State == TmPickerFetchState.Transient)
        {
            _resolveState = TmPickerFetchState.Transient;
            return;
        }

        _resolveState = TmPickerFetchState.Ok;
        _loadedValue = requested;
        _selectedUser = resolution.Item;
    }

    private async Task HandleSearchInputAsync(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        _searchState = TmPickerFetchState.Ok;

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        if (_searchTerm.Length < MinChars)
        {
            _showResults = false;
            _results = [];
            _highlightedIndex = -1;
            return;
        }

        try
        {
            await Task.Delay(DebounceMs, token);
            await SearchNowAsync(_searchTerm, token);
        }
        catch (TaskCanceledException)
        {
            // Superseded by a newer keystroke.
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SearchNowAsync(string term, CancellationToken token)
    {
        _loading = true;
        StateHasChanged();

        var result = await SearchProvider(term, token);
        if (token.IsCancellationRequested)
        {
            return;
        }

        _searchState = result.State;
        _results = result.State == TmPickerFetchState.Ok ? result.Items.ToList() : [];
        _showResults = true;
        _highlightedIndex = _results.Count > 0 ? 0 : -1;
    }

    private async Task RetrySearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm) || _searchTerm.Length < MinChars)
        {
            return;
        }

        using var cts = new CancellationTokenSource();
        await SearchNowAsync(_searchTerm, cts.Token);
        _loading = false;
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (!_showResults || _results.Count == 0)
        {
            if (string.Equals(e.Key, "Escape", StringComparison.Ordinal))
            {
                _showResults = false;
            }

            return;
        }

        switch (e.Key)
        {
            case "ArrowDown":
                _highlightedIndex = Math.Min(_highlightedIndex + 1, _results.Count - 1);
                break;
            case "ArrowUp":
                _highlightedIndex = Math.Max(_highlightedIndex - 1, 0);
                break;
            case "Enter" when _highlightedIndex >= 0 && _highlightedIndex < _results.Count:
                await HandleSelectAsync(_results[_highlightedIndex]);
                break;
            case "Escape":
                _showResults = false;
                break;
            default:
                break;
        }
    }

    private async Task HandleSelectAsync(TUser user)
    {
        _debounceCts?.Cancel();
        _showResults = false;
        _searchTerm = string.Empty;
        _results = [];
        _highlightedIndex = -1;
        _selectedUser = user;
        _resolveState = TmPickerFetchState.Ok;

        var newValue = ValueSelector(user);
        _loadedValue = newValue;
        Value = newValue;
        await ValueChanged.InvokeAsync(newValue);
    }

    private async Task HandleClearAsync()
    {
        _debounceCts?.Cancel();
        _selectedUser = default;
        _loadedValue = null;
        _searchTerm = string.Empty;
        _showResults = false;
        _results = [];
        _resolveState = TmPickerFetchState.Ok;
        Value = null;
        await ValueChanged.InvokeAsync(null);
    }

    private void HandleBlur()
    {
        // Delay so a pointerdown-triggered selection on a result item fires before the dropdown closes.
        _ = Task.Delay(200).ContinueWith(_ =>
        {
            _showResults = false;
            InvokeAsync(StateHasChanged);
        });
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The release branch must stay reachable when FloatingMenu is switched OFF at runtime, so this
        // deliberately does not start with an early return on FloatingMenu: otherwise the script would
        // go on writing inline left/top/width onto a list that is no longer floating.
        if (FloatingMenu && ShowsSearchInput && _showResults && _results.Count > 0)
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            _menuAnchored = true;

            // Anchoring is re-applied on every render while the list is up: the input can move under it
            // (a validation message appearing above, the form reflowing) with no scroll event firing.
            await _module.InvokeVoidAsync("anchor", _inputRef, _menuRef, ResultsId);
        }
        else if (_menuAnchored && _module is not null)
        {
            // Released BY ID, not by element reference. The list is already out of the DOM by the time
            // this runs, and Blazor resolves an ElementReference through a document query — a detached
            // element resolves to null, so passing the reference would silently release nothing and
            // leave the entry (and the shared scroll listener) behind.
            _menuAnchored = false;
            await _module.InvokeVoidAsync("release", ResultsId);
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();

        try
        {
            if (_module is not null)
            {
                if (_menuAnchored)
                {
                    _menuAnchored = false;
                    await _module.InvokeVoidAsync("release", ResultsId);
                }

                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone.
        }
    }
}
