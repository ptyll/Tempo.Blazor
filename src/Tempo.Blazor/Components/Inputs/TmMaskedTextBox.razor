@namespace Tempo.Blazor.Components.Inputs

<div class="tm-masked-text-box">
    @if (LabelTrailing is not null)
    {
        <span class="tm-input-label-row">
            @if (!string.IsNullOrEmpty(Label))
            {
                <label for="@Id" class="tm-masked-text-box__label">@Label</label>
            }
            <span class="tm-input-label-trailing">@LabelTrailing</span>
        </span>
    }
    else if (!string.IsNullOrEmpty(Label))
    {
        <label for="@Id" class="tm-masked-text-box__label">@Label</label>
    }
    <input id="@Id"
           type="text"
           value="@DisplayValue"
           placeholder="@Placeholder"
           aria-label="@(string.IsNullOrEmpty(Label) ? Placeholder : null)"
           disabled="@Disabled"
           readonly="@ReadOnly"
           class="tm-masked-text-box__input @AdditionalCssClass"
           @attributes="AdditionalAttributes"
           @oninput="HandleInputAsync"
           @onchange="HandleInputAsync"
           @onkeydown="HandleKeyDownAsync" />
</div>
