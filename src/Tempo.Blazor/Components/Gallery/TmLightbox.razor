@namespace Tempo.Blazor.Components.Gallery
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Helpers
@using Microsoft.AspNetCore.Components.Web
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (IsOpen)
{
    @* Round 3 (V2): the lightbox is a modal viewport-anchored surface. The TmFocusScope root is
       the promoted element (mirroring TmDrawer): popover="manual" rides the scope's root via
       AdditionalAttributes and the scope element is promoted after the opening render.
       Activate-after-promote (c51ddf81 #1): the trap may only activate once the promote
       interop completed. *@
    <TmFocusScope @ref="_scope"
                  Class="tm-lightbox"
                  popover="manual"
                  Active="@(_gate?.ScopeActive == true)"
                  NoteOpenerOnMount="true"
                  AriaLabel="@Loc["TmLightbox_Aria"]"
                  CloseOnEscape="true"
                  OnEscape="OnClose"
                  RestoreFocusTargetId="@RestoreFocusTargetId">
        <div class="tm-lightbox-backdrop" aria-hidden="true" @onclick="async () => await OnClose.InvokeAsync()"></div>

        <div class="tm-lightbox-content" @onkeydown="HandleKeyAsync" @onkeydown:stopPropagation="true">
            <button type="button"
                    class="tm-lightbox-close"
                    aria-label="@Loc["TmImageGallery_Close"]"
                    @onclick="async () => await OnClose.InvokeAsync()">
                <TmIcon Name="@IconNames.X" />
            </button>

            <button type="button"
                    class="tm-lightbox-prev"
                    aria-label="@Loc["TmImageGallery_PreviousImage"]"
                    disabled="@IsFirst"
                    @onclick="async () => await OnPrev.InvokeAsync()">
                <TmIcon Name="@IconNames.ChevronLeft" />
            </button>

            <div class="tm-lightbox-image-wrap">
                @if (string.IsNullOrEmpty(ImageUrl))
                {
                    <p class="tm-lightbox-loading">@Loc["TmImageGallery_LoadingImage"]</p>
                }
                else
                {
                    <img src="@ImageUrl" alt="@ImageAlt" class="tm-lightbox-img" />
                }
            </div>

            <button type="button"
                    class="tm-lightbox-next"
                    aria-label="@Loc["TmImageGallery_NextImage"]"
                    disabled="@IsLast"
                    @onclick="async () => await OnNext.InvokeAsync()">
                <TmIcon Name="@IconNames.ChevronRight" />
            </button>

            <div class="tm-lightbox-footer">
                <span class="tm-lightbox-counter">
                    @Loc["TmImageGallery_Counter", CurrentIndex + 1, TotalCount]
                </span>
                @if (CanDelete)
                {
                    <button type="button"
                            class="tm-lightbox-delete"
                            aria-label="@Loc["TmImageGallery_Delete"]"
                            @onclick="async () => await OnDelete.InvokeAsync()">
                        <TmIcon Name="@IconNames.Trash" />
                    </button>
                }
            </div>
        </div>
    </TmFocusScope>
}

@code {
    /// <summary>Controls lightbox visibility.</summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>Full-size image URL to display.</summary>
    [Parameter] public string? ImageUrl { get; set; }

    /// <summary>Alt text for the displayed image.</summary>
    [Parameter] public string? ImageAlt { get; set; }

    /// <summary>True when the current image is the first in the sequence.</summary>
    [Parameter] public bool IsFirst { get; set; }

    /// <summary>True when the current image is the last in the sequence.</summary>
    [Parameter] public bool IsLast { get; set; }

    /// <summary>0-based index of the currently displayed image.</summary>
    [Parameter] public int CurrentIndex { get; set; }

    /// <summary>Total number of images in the gallery.</summary>
    [Parameter] public int TotalCount { get; set; }

    /// <summary>When true, shows a delete button.</summary>
    [Parameter] public bool CanDelete { get; set; }

    /// <summary>
    /// Id of the element that receives focus when the lightbox closes. Null restores the element
    /// that held focus when it opened. TmImageGallery passes the thumbnail of the image on screen,
    /// so closing after browsing returns to where the user visually is.
    /// </summary>
    [Parameter] public string? RestoreFocusTargetId { get; set; }

    /// <summary>Fires when the lightbox should be closed.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Fires when the user navigates to the previous image.</summary>
    [Parameter] public EventCallback OnPrev { get; set; }

    /// <summary>Fires when the user navigates to the next image.</summary>
    [Parameter] public EventCallback OnNext { get; set; }

    /// <summary>Fires when the delete button is clicked.</summary>
    [Parameter] public EventCallback OnDelete { get; set; }

    private TmFocusScope? _scope;
    private PromotedScopeGate? _gate;
    private LazyJsModule? _rtlModule;
    // m3 (review): the direction is read ONCE per open, not on every arrow key press. Writing
    // direction cannot change while the modal is up (the host would have to flip dir under an
    // open lightbox), so the probe result is cached from the opening render and reset on close.
    private bool? _isRtlCached;
    private bool _rtlReadThisOpen;

    /// <summary>
    /// The lightbox's writing direction, read live from the scope root through the shared
    /// <c>tm-rtl.js</c> helper. In RTL the strip mirrors — the next image lies to the LEFT, where
    /// the buttons' logical insets already place it — so the physical arrow keys swap. Resolves
    /// to LTR wherever JS is unavailable (prerender, bUnit without a handler): the historical
    /// behaviour.
    /// </summary>
    private async Task<bool> IsRtlAsync()
    {
        try
        {
            _rtlModule ??= new LazyJsModule(JS, "./_content/Tempo.Blazor/js/tm-rtl.js");
            var (ok, direction) = await _rtlModule.TryInvokeAsync<string>("directionOf", _scope?.Element ?? default);
            return ok && string.Equals(direction, "rtl", StringComparison.OrdinalIgnoreCase);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException
                               or TaskCanceledException or ObjectDisposedException
                               or InvalidOperationException)
        {
            return false;
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Cold start: import the focus-trap module and install its document-level opener
            // records NOW, so the FIRST open of the session restores its opener.
            await FocusTrap.EnsureLoadedAsync(JS);
        }

        // The scope root is the promoted element. Closing unmounts the subtree; a detached
        // top-layer element is hidden by the browser automatically — promote only. The gate also
        // holds the trap back until the promote completed (c51ddf81 #1).
        _gate ??= new PromotedScopeGate(JS);
        if (await _gate.AfterRenderAsync(IsOpen, () => IsOpen, _scope?.Element))
        {
            StateHasChanged();
        }

        // m3: the direction probe runs once per open (the first render with IsOpen true), not per
        // key press — the arrow-key handler only reads the cache below.
        if (IsOpen && !_rtlReadThisOpen)
        {
            _rtlReadThisOpen = true;
            _isRtlCached = await IsRtlAsync();
        }
        else if (!IsOpen)
        {
            _rtlReadThisOpen = false;
            _isRtlCached = null;
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_scope is not null) await _scope.DisposeAsync();
        if (_gate is not null) await _gate.DisposeAsync();
        if (_rtlModule is not null) await _rtlModule.DisposeAsync();
    }

    private async Task HandleKeyAsync(KeyboardEventArgs e)
    {
        // Only the arrows need the direction — every other keydown skips the interop call.
        if (e.Key is not ("ArrowRight" or "ArrowLeft"))
        {
            return;
        }

        // In RTL the strip mirrors: the next image lies to the LEFT (the mirrored chevrons and the
        // buttons' logical insets say so), so the physical arrow keys swap with the direction.
        // m3: the probe ran once on the opening render; the cache is the per-press read.
        var rtl = _isRtlCached ?? await IsRtlAsync();
        switch (e.Key)
        {
            case "ArrowRight" when rtl ? !IsFirst : !IsLast:
                await (rtl ? OnPrev : OnNext).InvokeAsync();
                break;
            case "ArrowLeft" when rtl ? !IsLast : !IsFirst:
                await (rtl ? OnNext : OnPrev).InvokeAsync();
                break;
        }
    }
}
