@namespace Tempo.Blazor.Components.Gallery
@using Tempo.Blazor.Interfaces
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.DataDisplay

<div class="tm-image-gallery" tabindex="-1" @ref="_rootRef">
    @if (IsLoading)
    {
        <TmSpinner />
    }
    else if (!HasImages)
    {
        <TmEmptyState Title="@(!string.IsNullOrEmpty(EmptyTitle) ? EmptyTitle : Loc["TmImageGallery_NoImages"])" />
    }
    else
    {
        <div class="tm-gallery-grid">
            @foreach (var (img, idx) in _indexedImages)
            {
                var image = img;
                var i     = idx;
                @* A native <button> activates itself (keyboard-activation-convention.md): no
                   role/tabindex residue and no emulated key handlers — a keydown emulation would
                   double-fire on top of the browser's own click. *@
                <button type="button"
                        id="@ItemId(i)"
                        class="tm-gallery-item"
                        aria-label="@(string.IsNullOrWhiteSpace(image.Title) ? string.Format(Loc["TmImageGallery_OpenImage"], i + 1, _imageList.Count) : image.Title)"
                        @onclick="async () => await OpenLightboxAsync(image, i)"
                        @ref="_itemRefs[i]">
                    <img src="@(image.ThumbnailUrl ?? image.Url)"
                         alt=""
                         class="tm-gallery-item-img" />
                    @if (!string.IsNullOrWhiteSpace(image.Title))
                    {
                        <span class="tm-gallery-item-title" aria-hidden="true">@image.Title</span>
                    }
                </button>
            }
        </div>

        <TmLightbox IsOpen="@_lightboxIndex.HasValue"
                    ImageUrl="@_lightboxUrl"
                    ImageAlt="@LightboxAlt"
                    IsFirst="@(_lightboxIndex == 0)"
                    IsLast="@(_lightboxIndex == _imageList.Count - 1)"
                    CurrentIndex="@(_lightboxIndex ?? 0)"
                    TotalCount="@_imageList.Count"
                    CanDelete="@CanDelete"
                    RestoreFocusTargetId="@(_lightboxIndex is int shown ? ItemId(shown) : null)"
                    OnClose="CloseLightbox"
                    OnPrev="PrevImage"
                    OnNext="NextImage"
                    OnDelete="DeleteCurrentAsync" />
    }
</div>

@code {
    /// <summary>Images to display in the gallery grid.</summary>
    [Parameter] public IEnumerable<IGalleryImage>? Images { get; set; }

    /// <summary>When true, shows a loading spinner instead of the grid.</summary>
    [Parameter] public bool IsLoading { get; set; }

    /// <summary>Heading for the empty state when Images is empty.</summary>
    [Parameter] public string? EmptyTitle { get; set; }

    /// <summary>Fires when an image item is clicked (before lightbox opens).</summary>
    [Parameter] public EventCallback<IGalleryImage> OnImageClick { get; set; }

    /// <summary>Optional URL resolver for full-size images (ticket-based APIs, legacy).</summary>
    [Parameter] public IImageUrlResolver? UrlResolver { get; set; }

    /// <summary>Data provider for secure ticket URLs and delete operations.</summary>
    [Parameter] public IImageGalleryDataProvider? DataProvider { get; set; }

    /// <summary>When true, shows a delete button in the lightbox.</summary>
    [Parameter] public bool CanDelete { get; set; }

    private List<IGalleryImage>             _imageList     = [];
    private List<(IGalleryImage img, int)>  _indexedImages = [];
    private int?                             _lightboxIndex;
    private string?                          _lightboxUrl;
    private IGalleryImage?                   _currentImage;
    private readonly string                  _idPrefix = $"tm-gallery-{Guid.NewGuid():N}";
    private ElementReference[]               _itemRefs = [];
    private ElementReference                 _rootRef;
    private int?                             _focusAfterDeleteIndex;
    private bool                             _focusRootAfterDelete;

    private bool HasImages => _imageList.Count > 0;

    /// <summary>
    /// Alt text of the lightbox image: the image title, or a localized "Image {0} of {1}" when it
    /// has none — an untitled image still needs a name in the lightbox (WCAG 1.1.1).
    /// </summary>
    private string LightboxAlt =>
        !string.IsNullOrWhiteSpace(_currentImage?.Title)
            ? _currentImage!.Title
            : string.Format(Loc["TmImageGallery_ImageAlt"], (_lightboxIndex ?? 0) + 1, _imageList.Count);

    /// <summary>
    /// Per-instance id of a thumbnail. The lightbox restore target points at it, so closing the
    /// lightbox can focus the exact thumbnail of the image on screen — in every browser, including
    /// the ones that never focus a clicked button (Safari).
    /// </summary>
    private string ItemId(int index) => $"{_idPrefix}-item-{index}";

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Delete (cluster-D §3(3)): after removing the displayed image, the restore id of the
        // deleted position either names the NEXT image (trap restores to it) or, when the last
        // image was deleted, names nothing — and the opener fallback fails too, because the
        // opener was the deleted thumbnail (detached) or <body> (Safari). Focus the new last
        // thumbnail explicitly, after the DOM settled; with no thumbnail left, focus the
        // gallery root so it does not drop to <body>.
        if (_focusAfterDeleteIndex is int idx)
        {
            _focusAfterDeleteIndex = null;
            if (idx < _itemRefs.Length && !string.IsNullOrEmpty(_itemRefs[idx].Id))
            {
                await _itemRefs[idx].FocusAsync();
            }
        }
        else if (_focusRootAfterDelete)
        {
            _focusRootAfterDelete = false;
            if (!string.IsNullOrEmpty(_rootRef.Id))
            {
                await _rootRef.FocusAsync();
            }
        }
    }

    protected override void OnParametersSet()
    {
        _imageList     = Images?.ToList() ?? [];
        _indexedImages = _imageList.Select((img, i) => (img, i)).ToList();
        // @ref writes by index, so the capture targets must exist before the render runs. Grow
        // the array ONLY: re-creating it would wipe the references captured on earlier inserts
        // (Blazor captures a @ref when the element is inserted, never on a later re-render), and
        // the post-delete focus restore would die after any parent re-render.
        if (_itemRefs.Length < _imageList.Count)
        {
            Array.Resize(ref _itemRefs, _imageList.Count);
        }
    }

    private async Task OpenLightboxAsync(IGalleryImage image, int index)
    {
        _lightboxIndex = index;
        _currentImage  = image;
        _lightboxUrl   = image.Url;

        if (DataProvider is not null)
            _lightboxUrl = await DataProvider.GetImageTicketUrlAsync(image.Id);

        await OnImageClick.InvokeAsync(image);
    }

    private void CloseLightbox()
    {
        _lightboxIndex = null;
        _currentImage  = null;
        _lightboxUrl   = null;
    }

    private async Task NextImage()
    {
        if (_lightboxIndex.HasValue && _lightboxIndex < _imageList.Count - 1)
            await OpenLightboxAsync(_imageList[_lightboxIndex.Value + 1], _lightboxIndex.Value + 1);
    }

    private async Task PrevImage()
    {
        if (_lightboxIndex.HasValue && _lightboxIndex > 0)
            await OpenLightboxAsync(_imageList[_lightboxIndex.Value - 1], _lightboxIndex.Value - 1);
    }

    private async Task DeleteCurrentAsync()
    {
        if (_currentImage is not null && DataProvider is not null)
        {
            var deletedIndex = _lightboxIndex;
            await DataProvider.DeleteImageAsync(_currentImage.Id);
            _imageList.Remove(_currentImage);
            _indexedImages = _imageList.Select((img, i) => (img, i)).ToList();
            // Always focus the thumbnail now at the deleted position (the next image, or the new
            // last one); OnAfterRenderAsync moves focus there once the DOM settled. The restore
            // id of the deleted position names the NEXT image for the trap; only the
            // delete-the-last case loses it (detached opener / body). An empty gallery has no
            // thumbnail left, so focus moves to the gallery root instead.
            if (deletedIndex.HasValue)
            {
                if (_imageList.Count > 0)
                {
                    _focusAfterDeleteIndex = Math.Min(deletedIndex.Value, _imageList.Count - 1);
                }
                else
                {
                    _focusRootAfterDelete = true;
                }
            }
            CloseLightbox();
        }
    }
}
