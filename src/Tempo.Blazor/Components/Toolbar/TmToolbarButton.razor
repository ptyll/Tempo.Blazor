@namespace Tempo.Blazor.Components.Toolbar
@using Tempo.Blazor.Components.Actions
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Icons
@implements IDisposable
@implements IToolbarOverflowItem

@* Inside a TmToolbar the button registers with it: Overflow=Menu moves it into the More menu by
   Priority (rendered collapsed - out of flow, invisible, inert - so its width stays measurable),
   OverflowOnly buttons render only in the menu, and Labels decides the visible text. Standalone it
   behaves exactly like the pre-F4 button. *@
@if (OmittedFromBar)
{
    @* Zero-width, hidden, not a control: only its data-tm-toolbar-item id travels to tm-toolbar.js, which
       reports it in DOM order (data-pin=always: recorded, never measured), so the menu keeps the button's
       written slot instead of pushing it to the end. *@
    <span hidden data-tm-toolbar-item="@MenuId" data-pin="always"></span>
}
else
{
    <button type="button"
            class="tm-toolbar-btn tm-toolbar-btn--@Variant.ToString().ToLowerInvariant() @ModifierClasses"
            title="@EffectiveTitle"
            aria-label="@EffectiveAriaLabel"
            aria-pressed="@AriaPressed"
            disabled="@Disabled"
            inert="@Collapsed"
            aria-hidden="@(Collapsed ? "true" : null)"
            data-tm-toolbar-item="@(Registered ? MenuId : null)"
            data-rank="@(Registered ? Rank.ToString() : null)"
            data-pin="@(Registered ? (Priority == ToolbarButtonPriority.Pinned ? "never" : "auto") : null)"
            @attributes="AdditionalAttributes"
            @onclick="ClickAsync"
            @onpointerdown:preventDefault="PreserveFocus"
            @onmousedown:preventDefault="PreserveFocus">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <TmIcon Name="@Icon" Size="IconSize.Sm" />
        }
        @if (ShowText)
        {
            <span class="tm-toolbar-btn-text">@Text</span>
        }
    </button>
}

@code {
    private TmToolbar? _registeredWith;
    private (string?, string?, string?, ToolbarButtonPriority, bool, ButtonVariant, ToolbarLabelPosition, bool?, bool)? _snapshot;

    /// <summary>The toolbar this button sits in; null when used on its own.</summary>
    [CascadingParameter] private TmToolbar? Toolbar { get; set; }

    /// <summary>The <see cref="TmToolbarItem"/> this button is part of; a nested button never registers
    /// on its own — the item's wrapper is the single measured item.</summary>
    [CascadingParameter] private TmToolbarItem? ParentItem { get; set; }

    /// <summary>The <see cref="TmToolbarGroup"/> this button belongs to; null on the bare bar.</summary>
    [CascadingParameter] private TmToolbarGroup? Group { get; set; }

    /// <summary>Button label text. Omit for icon-only buttons.</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>Icon name from IconNames. Displayed before the text.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Tooltip text shown as the native title attribute.</summary>
    [Parameter] public string? Tooltip { get; set; }

    /// <summary>Fires when the button is clicked.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>When true, the button is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Visual style variant.</summary>
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Ghost;

    /// <summary>
    /// How important the button is when its <see cref="TmToolbar"/> runs out of room
    /// (<see cref="ToolbarOverflow.Menu"/>). An overflow rank only: buttons render in written order.
    /// </summary>
    [Parameter] public ToolbarButtonPriority Priority { get; set; }

    /// <summary>
    /// Where the <see cref="Text"/> label sits: next to the icon (default), under it, or hidden (the
    /// text then stays the accessible name). Only an icon button can hide its label.
    /// </summary>
    [Parameter] public ToolbarLabelPosition LabelPosition { get; set; }

    /// <summary>
    /// Makes the button a toggle: <see langword="null"/> (default) is a plain button with no
    /// <c>aria-pressed</c>; <see langword="true"/>/<see langword="false"/> render <c>aria-pressed</c>
    /// and the pressed look, and when the button sits in a <see cref="TmToolbar"/>'s "More" menu it
    /// becomes a <c>menuitemcheckbox</c> with the same state (<c>aria-checked</c>). The host owns the
    /// state: flip it in <see cref="OnClick"/>. A host-splatted <c>aria-pressed</c> (AdditionalAttributes)
    /// still wins on the bar button.
    /// </summary>
    [Parameter] public bool? Pressed { get; set; }

    /// <summary>
    /// Renders a toggle whose <see cref="Pressed"/> is <see langword="false"/> as partially on —
    /// <c>aria-pressed="mixed"</c> on the bar, <c>aria-checked="mixed"</c> in "More" (e.g. Bold over a
    /// partly bold selection). Ignored when <see cref="Pressed"/> is <see langword="null"/> or
    /// <see langword="true"/>.
    /// </summary>
    [Parameter] public bool PressedMixed { get; set; }

    /// <summary>
    /// When true, pressing the button with a mouse, pen or finger does not move focus to it (the
    /// <c>pointerdown</c> and <c>mousedown</c> defaults are prevented), so an editor's text selection
    /// survives a formatting command. Keyboard activation and the "More" entry are unchanged.
    /// Default <see langword="false"/>.
    /// </summary>
    [Parameter] public bool PreserveFocus { get; set; }

    /// <summary>Additional CSS class for the button element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Additional HTML attributes for the button element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Stable id of the button's entry in the More menu (internal: the contract is the
    /// internal <see cref="IToolbarOverflowItem"/>, implemented explicitly).</summary>
    internal string MenuId { get; } = $"tm-tb-{Guid.NewGuid():N}";

    /// <inheritdoc />
    string IToolbarOverflowItem.MenuId => MenuId;

    /// <summary>The group whose section the button's "More" entry joins (null when ungrouped).</summary>
    internal TmToolbarGroup? OwnerGroup => Group;

    /// <summary>The More menu entry's label.</summary>
    internal string MenuLabel => !string.IsNullOrEmpty(Text) ? Text : Tooltip ?? string.Empty;

    /// <summary>Registered with a toolbar that collapses (Overflow=Menu). A button nested in a
    /// <see cref="TmToolbarItem"/> is part of that item and never registers on its own.</summary>
    private bool Registered => Toolbar is { CollapsesButtons: true } && ParentItem is null && _registeredWith is not null;

    private bool Collapsed => Registered && Toolbar!.IsCollapsed(this) && Priority != ToolbarButtonPriority.OverflowOnly;

    private bool OmittedFromBar => Registered && Priority == ToolbarButtonPriority.OverflowOnly;

    private int Rank => Helpers.ToolbarOverflowLayout.Rank(Priority);

    private bool HasIcon => !string.IsNullOrEmpty(Icon);

    private bool HasText => !string.IsNullOrEmpty(Text);

    private ToolbarLabels EffectiveLabels => Toolbar?.EffectiveLabels ?? ToolbarLabels.IconsWithText;

    /// <summary>The label span renders for text-only buttons always; for icon buttons unless hidden by the button or the toolbar.</summary>
    private bool ShowText => HasText && (!HasIcon || (LabelPosition != ToolbarLabelPosition.Hidden && EffectiveLabels != ToolbarLabels.Icons));

    private string ModifierClasses => string.Join(' ', new[]
    {
        ShowText && HasIcon && LabelPosition == ToolbarLabelPosition.Below ? "tm-toolbar-btn--label-below" : null,
        HasIcon && !ShowText ? "tm-toolbar-btn--icon-only" : null,
        ShowText && HasIcon && EffectiveLabels == ToolbarLabels.Auto ? "tm-toolbar-btn--labels-auto" : null,
        Collapsed ? "tm-toolbar-item--collapsed" : null,
        Class,
    }.Where(static c => !string.IsNullOrWhiteSpace(c)));
    /// <summary>A button whose text is not visible keeps it as its name and tooltip.</summary>
    private string? EffectiveAriaLabel => HasIcon ? Tooltip ?? Text : Tooltip;

    private string? EffectiveTitle => !string.IsNullOrEmpty(Tooltip) ? Tooltip : HasIcon && !ShowText ? Text : null;

    /// <summary>null (a plain button), "true", "false" or "mixed" — a host splat wins (@attributes comes last).</summary>
    private string? AriaPressed => Pressed is null
        ? null
        : Pressed == true ? "true" : PressedMixed ? "mixed" : "false";

    protected override void OnParametersSet()
    {
        // Register once, with the toolbar the cascade handed us; tell it about a change only when
        // something it partitions or renders in the menu changed. OnClick is deliberately NOT part of
        // the snapshot (a fresh lambda per parent render would loop) - the menu reads it live. Pressed
        // IS: a flipped toggle must re-render its "More" menu entry (aria-checked). A button nested in
        // a TmToolbarItem never registers: the item's wrapper is the single measured item.
        if (ParentItem is null && Toolbar is not null && !ReferenceEquals(_registeredWith, Toolbar))
        {
            _registeredWith?.Unregister(this);
            _registeredWith = Toolbar;
            _snapshot = Snapshot();
            Toolbar.Register(this);
            return;
        }

        if (ParentItem is not null && _registeredWith is not null)
        {
            _registeredWith.Unregister(this);
            _registeredWith = null;
            _snapshot = null;
        }

        var snapshot = Snapshot();
        if (_registeredWith is not null && _snapshot != snapshot)
        {
            _snapshot = snapshot;
            _registeredWith.ItemChanged(this);
        }
    }

    private (string?, string?, string?, ToolbarButtonPriority, bool, ButtonVariant, ToolbarLabelPosition, bool?, bool) Snapshot()
        => (Text, Icon, Tooltip, Priority, Disabled, Variant, LabelPosition, Pressed, PressedMixed);

    /// <summary>The EFFECTIVE priority the partition ranks: the button's own <see cref="Priority"/>.</summary>
    ToolbarButtonPriority IToolbarOverflowItem.EffectivePriority => Priority;

    /// <summary>One More entry per button (C1: the per-button mapping moved here when the toolbar
    /// started ranking any <see cref="IToolbarOverflowItem"/>).</summary>
    void IToolbarOverflowItem.AppendMenuEntries(List<TmActionItem> target) => target.Add(new TmActionItem
    {
        Id = MenuId,
        Label = MenuLabel,
        Icon = Icon,
        Disabled = Disabled,
        Danger = Variant == ButtonVariant.Danger,
        // C2: a pressed toggle keeps its state in the menu — the entry becomes a
        // menuitemcheckbox with aria-checked (null Pressed stays a plain menuitem).
        Checked = Pressed,
        CheckedMixed = PressedMixed,
        // C3: the collapsed members of a TmToolbarGroup keep the group in the menu — one
        // labelled role=group section per contiguous run, separated by role=separator.
        Group = OwnerGroup?.GroupKey,
        GroupLabel = OwnerGroup?.EffectiveLabel,
        // The receiver is the BUTTON, so the button re-renders; the toolbar re-renders on Recompute.
        OnClick = EventCallback.Factory.Create(this, ClickAsync),
    });

    /// <summary>Re-render after the toolbar's partition or labels changed (internal: the contract is
    /// the internal <see cref="IToolbarOverflowItem"/>, implemented explicitly).</summary>
    internal void Refresh() => _ = InvokeAsync(StateHasChanged);

    /// <inheritdoc />
    void IToolbarOverflowItem.Refresh() => Refresh();

    /// <summary>The click handler, shared by the bar button and the More menu entry.</summary>
    internal async Task ClickAsync()
    {
        if (!Disabled)
        {
            await OnClick.InvokeAsync();
        }
    }

    /// <inheritdoc />
    public void Dispose()
    {
        _registeredWith?.Unregister(this);
        _registeredWith = null;
    }
}
