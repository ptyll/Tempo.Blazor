@namespace Tempo.Blazor.Components.DataDisplay
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Models

<div class="tm-change-diff @Class">
    @if (Changes is not null)
    {
        @foreach (var change in Changes)
        {
            <div class="tm-change-diff-row">
                <span class="tm-change-diff-property">@change.Property</span>
                <div class="tm-change-diff-values">
                    @* KG-008: the old/new pair is carried by colour + strikethrough for sighted
                       users, but a screen reader must hear WHICH value is which — the prefixed
                       span is the text alternative (the visible run is aria-hidden so the value
                       is announced exactly once). *@
                    <span class="tm-change-diff-old">
                        <span class="tm-sr-only">@Loc["TmChangeDiff_PreviousValue", change.OldValue ?? "—"]</span>
                        <span aria-hidden="true">@(change.OldValue ?? "—")</span>
                    </span>
                    <span class="tm-change-diff-arrow" aria-hidden="true">
                        <TmIcon Name="@IconNames.ArrowRight" Size="IconSize.Xs" />
                    </span>
                    <span class="tm-change-diff-new">
                        <span class="tm-sr-only">@Loc["TmChangeDiff_NewValue", change.NewValue ?? "—"]</span>
                        <span aria-hidden="true">@(change.NewValue ?? "—")</span>
                    </span>
                </div>
            </div>
        }
    }
</div>

@code {
    /// <summary>List of property changes to display.</summary>
    [Parameter] public IEnumerable<TmChangeInfo>? Changes { get; set; }

    /// <summary>Additional CSS class(es).</summary>
    [Parameter] public string? Class { get; set; }
}
