@namespace Tempo.Blazor.Components.DataDisplay

<div class="tm-stat-card">
    <span class="tm-stat-value">@Value</span>
    <span class="tm-stat-label">@Title</span>
    @if (!string.IsNullOrEmpty(SubValue))
    {
        <span class="tm-stat-subvalue"
              style="@(_validatedSubValueColor is not null ? $"--tm-stat-subvalue-color: {_validatedSubValueColor}" : null)">@SubValue</span>
    }
</div>

@code {
    /// <summary>Card label / metric name.</summary>
    [Parameter] public string Title { get; set; } = string.Empty;

    /// <summary>Alias for Title.</summary>
    [Parameter] public string Label { get => Title; set => Title = value; }

    /// <summary>Primary metric value (e.g. "1,234" or "$5,000").</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Secondary value or trend indicator (e.g. "+12% this month").</summary>
    [Parameter] public string? SubValue { get; set; }

    /// <summary>
    /// Colour for the SubValue, as a CSS colour value — a <c>var(--tm-*)</c> token reference, a hex
    /// literal (<c>#16a34a</c>), an <c>rgb</c>/<c>hsl</c>/<c>oklch</c>/<c>color-mix</c> function, or a
    /// named colour (<c>seagreen</c>). Rendered as the element's own
    /// <c>--tm-stat-subvalue-color</c> custom property, which the base
    /// <c>.tm-stat-subvalue</c> rule resolves with <c>var(--tm-stat-subvalue-color,
    /// var(--tm-text-secondary))</c>: the parameter therefore ALWAYS wins over the default colour,
    /// no matter where the consumer's stylesheet sits in source order. Only meaningful together with
    /// <see cref="SubValue"/>: without it there is nothing to colour and the card REFUSES to render
    /// (see <see cref="OnParametersSet"/>).
    /// </summary>
    /// <remarks>
    /// 2.9.0 BREAKING CHANGE: the value must be a CSS colour, validated before it reaches the
    /// attribute — a CSS class name such as <c>text-green-600</c> (previously accepted and silently
    /// dead) or any payload containing <c>;</c>, <c>{</c>, <c>}</c> or <c>url(</c> emits no
    /// <c>style</c> and logs a warning through the injected <c>ILoggerFactory</c>. Migration:
    /// <c>SubValueColor="text-green-600"</c> → <c>SubValueColor="var(--tm-color-success-text)"</c>
    /// or a literal <c>#16a34a</c>.
    /// </remarks>
    [Parameter] public string? SubValueColor { get; set; }

    /// <summary>
    /// Rejects <see cref="SubValueColor"/> without <see cref="SubValue"/> — an affordance without a
    /// mechanism: the call site states an intent ("this card has a coloured sub-value") that rendering
    /// silently denies, because the whole span is conditional on <see cref="SubValue"/>.
    /// </summary>
    /// <remarks>
    /// <para>
    /// This is a THROW, not a log or a test: the component owns the contract, so it covers every call
    /// path — markup, splatted <c>@attributes</c>, <c>DynamicComponent</c>, and consumers outside this
    /// repository — and it fails at the moment of misuse rather than at the next audit. A static scan of
    /// <c>.razor</c> markup is a legitimate second line for the release gate, but it cannot see the
    /// splatted paths, so it must carry its own denominator (see `DEC-STATIC-ANALYSIS-FAIL-CLOSED`).
    /// </para>
    /// <para>
    /// It cost eight call sites and several months to notice the first instance: the colour was live and
    /// the value was never passed, so the parameter did nothing and nothing said so.
    /// </para>
    /// </remarks>
    /// <exception cref="InvalidOperationException">
    /// <see cref="SubValueColor"/> is set while <see cref="SubValue"/> is null or empty.
    /// </exception>
    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(SubValueColor) && string.IsNullOrEmpty(SubValue))
        {
            throw new InvalidOperationException(
                $"{nameof(TmStatCard)}: {nameof(SubValueColor)}=\"{SubValueColor}\" was set without {nameof(SubValue)} " +
                $"(Title=\"{Title}\"). The sub-value span is only rendered when {nameof(SubValue)} is non-empty, so the " +
                $"colour would never reach the screen. Pass {nameof(SubValue)} as well, or drop {nameof(SubValueColor)}.");
        }

        _validatedSubValueColor = ValidateSubValueColor();
    }
}
