@namespace Tempo.Blazor.Components.DataDisplay
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Components.Charts

@* A statistic card. The root is the whole target: a <button> when the host passes OnClick, an <a>
   when it passes a SAFE Href, a plain <div> otherwise — one native focus stop, no JavaScript and no
   nested control. Every 2.10.0 part (icon, delta trend, comparison label, sparkline, skeleton,
   animated value) is opt-in, and the DEFAULT card still renders the 2.9.x markup byte for byte
   (pinned by TmStatCardTests.WithoutNewParameters_RendersTheExactPreTwoTenMarkup).

   CardBody is a template so the three roots share one body. Its indentation is LOAD-BEARING: the
   whitespace between the value span and the label span is part of the legacy markup, so those two
   lines sit at the same column they had inside the old <div>. Do not re-indent them. *@
@if (OnClick.HasDelegate)
{
    <button type="button"
            class="@CardClass"
            data-testid="@RootTestId()"
            aria-busy="@BusyAttribute"
            @onclick="HandleClickAsync">@CardBody</button>
}
else if (EffectiveHref is { } safeHref)
{
    <a class="@CardClass"
       href="@safeHref"
       data-testid="@RootTestId()"
       aria-busy="@BusyAttribute">@CardBody</a>
}
else
{
    <div class="@CardClass"
         data-testid="@RootTestId()"
         aria-busy="@BusyAttribute">@CardBody</div>
}

@code {
    /// <summary>Card label / metric name.</summary>
    [Parameter] public string Title { get; set; } = string.Empty;

    /// <summary>Alias for Title.</summary>
    [Parameter] public string Label { get => Title; set => Title = value; }

    /// <summary>Primary metric value (e.g. "1,234" or "$5,000"). Ignored when NumericValue is set.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Secondary value or trend indicator (e.g. "+12% this month").</summary>
    [Parameter] public string? SubValue { get; set; }

    /// <summary>
    /// Colour for the SubValue, as a CSS colour value — a <c>var(--tm-*)</c> token reference, a hex
    /// literal (<c>#16a34a</c>), an <c>rgb</c>/<c>hsl</c>/<c>oklch</c>/<c>color-mix</c> function, or a
    /// named colour (<c>seagreen</c>). Rendered as the element's own
    /// <c>--tm-stat-subvalue-color</c> custom property, which the base
    /// <c>.tm-stat-subvalue</c> rule resolves with <c>var(--tm-stat-subvalue-color,
    /// var(--tm-text-secondary))</c>: the parameter therefore ALWAYS wins over the default colour,
    /// no matter where the consumer's stylesheet sits in source order. Only meaningful together with
    /// <see cref="SubValue"/>: without it there is nothing to colour and the card REFUSES to render
    /// (see <see cref="OnParametersSet"/>).
    /// </summary>
    /// <remarks>
    /// 2.9.0 BREAKING CHANGE: the value must be a CSS colour, validated before it reaches the
    /// attribute — a CSS class name such as <c>text-green-600</c> (previously accepted and silently
    /// dead) or any payload containing <c>;</c>, <c>{</c>, <c>}</c> or <c>url(</c> emits no
    /// <c>style</c> and logs a warning through the injected <c>ILoggerFactory</c>. Migration:
    /// <c>SubValueColor="text-green-600"</c> → <c>SubValueColor="var(--tm-color-success-text)"</c>
    /// or a literal <c>#16a34a</c>.
    /// </remarks>
    [Parameter] public string? SubValueColor { get; set; }

    /// <summary>
    /// Rejects <see cref="SubValueColor"/> without <see cref="SubValue"/> — an affordance without a
    /// mechanism: the call site states an intent ("this card has a coloured sub-value") that rendering
    /// silently denies, because the whole span is conditional on <see cref="SubValue"/>.
    /// </summary>
    /// <remarks>
    /// <para>
    /// This is a THROW, not a log or a test: the component owns the contract, so it covers every call
    /// path — markup, splatted <c>@attributes</c>, <c>DynamicComponent</c>, and consumers outside this
    /// repository — and it fails at the moment of misuse rather than at the next audit. A static scan of
    /// <c>.razor</c> markup is a legitimate second line for the release gate, but it cannot see the
    /// splatted paths, so it must carry its own denominator (see `DEC-STATIC-ANALYSIS-FAIL-CLOSED`).
    /// </para>
    /// <para>
    /// It cost eight call sites and several months to notice the first instance: the colour was live and
    /// the value was never passed, so the parameter did nothing and nothing said so.
    /// </para>
    /// </remarks>
    /// <exception cref="InvalidOperationException">
    /// <see cref="SubValueColor"/> is set while <see cref="SubValue"/> is null or empty.
    /// </exception>
    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(SubValueColor) && string.IsNullOrEmpty(SubValue))
        {
            throw new InvalidOperationException(
                $"{nameof(TmStatCard)}: {nameof(SubValueColor)}=\"{SubValueColor}\" was set without {nameof(SubValue)} " +
                $"(Title=\"{Title}\"). The sub-value span is only rendered when {nameof(SubValue)} is non-empty, so the " +
                $"colour would never reach the screen. Pass {nameof(SubValue)} as well, or drop {nameof(SubValueColor)}.");
        }

        _validatedSubValueColor = ValidateSubValueColor();
    }

    /// <summary>
    /// The whitespace the pre-2.10.0 markup carried between the value span and the label span
    /// (<c>"\n    "</c>, the source indent of that pair). It is emitted EXPLICITLY because the value
    /// is now produced by an <c>@if</c>/<c>@else</c> chain and Razor trims the whitespace that follows
    /// a code block — the default card has to stay byte-identical (see
    /// <c>TmStatCardTests.WithoutNewParameters_RendersTheExactPreTwoTenMarkup</c>), so the separator
    /// cannot depend on source formatting any more.
    /// </summary>
    private const string ValueLabelSeparator = "\n    ";

    /// <summary>
    /// The card's inner markup, shared by the three possible roots. The value/label pair carries the
    /// legacy whitespace explicitly (see <see cref="ValueLabelSeparator"/>).
    /// </summary>
    private RenderFragment CardBody => @<text>
    @if (!IsLoading && !string.IsNullOrEmpty(Icon))
    {
        <span class="tm-stat-card__icon" data-testid="@TestId("stat-card-icon")" aria-hidden="true">
            <TmIcon Name="@Icon" Size="IconSize.Lg" />
        </span>
    }
    @if (IsLoading)
    {
        <span class="tm-stat-card__skeletons" aria-hidden="true">
            @* Span, not div: the whole-card target is a <button>/<a>, which holds phrasing content only. *@
            <TmSkeleton Element="TmRootElement.Span" Variant="SkeletonVariant.Text" Height="1.75rem" Width="60%" />
            <TmSkeleton Element="TmRootElement.Span" Variant="SkeletonVariant.Text" Width="75%" />
            <TmSkeleton Element="TmRootElement.Span" Variant="SkeletonVariant.Text" Width="45%" />
        </span><span class="tm-sr-only">@Loc["TmStatCard_Loading"]</span>
    }
    else if (HasNumericValue)
    {
        <span class="tm-stat-value"><TmAnimatedNumber Value="@NumericValue!.Value"
                                                     Format="@ValueFormat"
                                                     Culture="@Culture"
                                                     Animate="@AnimateValue"
                                                     Prefix="@ValuePrefix"
                                                     Suffix="@ValueSuffix"
                                                     DataTestId="@TestId("stat-card-value")" /></span>
    }
    else
    {
        <span class="tm-stat-value">@Value</span>
    }
    @ValueLabelSeparator<span class="tm-stat-label">@Title</span>
    @if (!string.IsNullOrEmpty(SubValue))
    {
        <span class="tm-stat-subvalue"
              style="@(_validatedSubValueColor is not null ? $"--tm-stat-subvalue-color: {_validatedSubValueColor}" : null)">@SubValue</span>
    }
    @if (!IsLoading && ResolvedTrend is { } trend)
    {
        <span class="tm-stat-card__trend tm-stat-card__trend--@trend.OutcomeClass"
              data-trend="@trend.Slug"
              data-testid="@TestId("stat-card-trend")">
            <TmIcon Name="@trend.Icon" Size="IconSize.Sm" />
            @* Colour is never the only carrier: the direction also travels as an arrow and as this
               visually hidden word. *@
            <span class="tm-sr-only">@Loc[trend.LabelKey]</span>
            @if (Delta is { } delta)
            {
                <span class="tm-stat-card__delta">@FormatDelta(delta)</span>
            }
            @if (!string.IsNullOrEmpty(ComparisonLabel))
            {
                <span class="tm-stat-card__comparison">@ComparisonLabel</span>
            }
        </span>
    }
    @if (!IsLoading && Sparkline is { Length: > 0 })
    {
        @* A whole-card target builds its accessible name from its content, so the chart's own
           role=img name ("… Sparkline") would be spliced into that name and read on every focus
           stop. Next to a labelled value the chart is decoration, so an INTERACTIVE card hides the
           subtree; a static card keeps the chart's role=img description. *@
        <span class="tm-stat-card__sparkline"
              data-testid="@TestId("stat-card-sparkline")"
              aria-hidden="@(IsInteractive ? "true" : null)">
            <TmSparkline Data="@Sparkline" Type="SparklineType.Line" Height="32px" Element="TmRootElement.Span" />
        </span>
    }
    </text>;
}
