@namespace Tempo.Blazor.Components.DataDisplay
@inherits Tempo.Blazor.Components.TmComponentBase
@typeparam TItem

@{
    var rootCss = "tm-kanban"
        + (SwimlanesEnabled ? " tm-kanban--swimlanes" : "")
        + (IsDragging ? " tm-kanban--dragging" : "")
        + (Disabled ? " tm-kanban-disabled" : "");
}

<div class="@rootCss @Class" data-focus-target="@(IsMoveMenuEnabled ? _focusTarget : null)" @ref="_rootElement" @attributes="AdditionalAttributes">
    @* The keyboard instructions and the ONE polite live region of the whole board sit outside the
       columns: a card's keys are described once, and a move is announced once instead of once per
       column. Both are visually hidden (position: absolute), so the flex layout is untouched, and both
       exist only while the non-drag path does. *@
    @if (IsMoveMenuEnabled)
    {
        <p class="tm-sr-only" id="@InstructionsId">@CardInstructions</p>
    }

    @if (Columns is not null && !SwimlanesEnabled)
    {
        @foreach (var col in Columns)
        {
            var colItems = GetColumnItems(col.Id);
            var isOverLimit = col.MaxItems.HasValue && colItems.Count > col.MaxItems.Value;
            var isCollapsed = IsColumnCollapsed(col.Id);
            var isDropTarget = IsCollapsedDropTarget(col.Id, null, isCollapsed);
            var colCss = "tm-kanban__column"
                + (isOverLimit ? " tm-kanban__column--over-limit" : "")
                + (isCollapsed ? " tm-kanban__column--collapsed" : "")
                + (isDropTarget ? " tm-kanban__column--drop-target" : "");
            var showIndicator = !Disabled && _draggedItem is not null && _dropTargetColumn == col.Id && _dropTargetSwimlane is null;

            <div class="@colCss"
                 @ref="ZoneHandle(col.Id, null).Ref"
                 data-testid="@TestId($"board-column-{col.Id}")"
                 data-tm-kanban-column="@col.Id"
                 data-tm-kanban-lane="@((string?)null)"
                 title="@(isCollapsed ? col.Title : null)"
                 role="@(isCollapsed ? "group" : null)"
                 aria-label="@(isCollapsed ? CollapsedColumnSummary(col, colItems.Count) : null)"
                 tabindex="@(IsMoveMenuEnabled ? "-1" : null)"
                 @ondragover="@(() => HandleColumnDragOver(col.Id, null))"
                 @ondragover:preventDefault="@(!Disabled)"
                 @ondrop="@(() => HandleDrop(col.Id, null))">

                <div class="tm-kanban__header" @onclick="@(() => HandleColumnHeaderClick(col))">
                    @if (ColumnsCollapsible)
                    {
                        <button type="button"
                                class="tm-kanban__column-toggle"
                                data-testid="@TestId($"column-toggle-{col.Id}")"
                                aria-expanded="@((!isCollapsed).ToString().ToLowerInvariant())"
                                aria-label="@(isCollapsed ? Loc["TmKanban_ExpandColumn", col.Title] : Loc["TmKanban_CollapseColumn", col.Title])"
                                @onclick="@(() => ToggleColumnAsync(col.Id))"
                                @onclick:stopPropagation="true"></button>
                    }
                    @if (ColumnHeaderTemplate is not null)
                    {
                        @ColumnHeaderTemplate(col)
                    }
                    else
                    {
                        @if (col.Color is not null)
                        {
                            <span class="tm-kanban__header-color" style="background-color: @col.Color;"></span>
                        }
                        <span class="tm-kanban__header-title">@col.Title</span>
                        <span class="tm-kanban__count">@colItems.Count</span>
                        @if (col.MaxItems.HasValue)
                        {
                            <span class="tm-kanban__wip-limit">/ @col.MaxItems</span>
                        }
                    }
                </div>

                @if (!isCollapsed)
                {
                    @if (VirtualizeCards)
                    {
                        <div class="tm-kanban__cards tm-kanban__cards--virtual" data-testid="@TestId($"cards-virtual-{col.Id}")">
                            @if (colItems.Count > 0)
                            {
                                <Virtualize TItem="TItem" Items="colItems" ItemSize="@((float)CardItemSize)" Context="item">
                                    @RenderVirtualCard(col.Id, null, colItems, item, showIndicator)
                                </Virtualize>
                                @if (showIndicator && _dropTargetIndex >= colItems.Count)
                                {
                                    <div class="tm-kanban__drop-indicator" @key="TrailingDropIndicatorKey"></div>
                                }
                            }
                            else
                            {
                                @RenderCells(col.Id, null, colItems, showIndicator)
                            }
                        </div>
                    }
                    else
                    {
                        <div class="tm-kanban__cards">
                            @RenderCells(col.Id, null, colItems, showIndicator)
                        </div>
                    }
                }
            </div>
        }
    }
    else if (Columns is not null)
    {
        var lanes = GetEffectiveLanes();

        <div class="tm-kanban__column-headers">
            @foreach (var col in Columns)
            {
                var colItems = GetColumnItems(col.Id);
                var isOverLimit = col.MaxItems.HasValue && colItems.Count > col.MaxItems.Value;
                var isCollapsed = IsColumnCollapsed(col.Id);
                var colCss = "tm-kanban__column tm-kanban__column--header-only"
                    + (isOverLimit ? " tm-kanban__column--over-limit" : "")
                    + (isCollapsed ? " tm-kanban__column--collapsed" : "");

                <div class="@colCss"
                     @ref="ZoneHandle(col.Id, null).Ref"
                     data-testid="@TestId($"colhead-{col.Id}")"
                     title="@(isCollapsed ? col.Title : null)"
                     role="@(isCollapsed ? "group" : null)"
                     aria-label="@(isCollapsed ? CollapsedColumnSummary(col, colItems.Count) : null)"
                     tabindex="@(IsMoveMenuEnabled ? "-1" : null)">
                    <div class="tm-kanban__header" @onclick="@(() => HandleColumnHeaderClick(col))">
                        @if (ColumnsCollapsible)
                        {
                            <button type="button"
                                    class="tm-kanban__column-toggle"
                                    data-testid="@TestId($"column-toggle-{col.Id}")"
                                    aria-expanded="@((!isCollapsed).ToString().ToLowerInvariant())"
                                    aria-label="@(isCollapsed ? Loc["TmKanban_ExpandColumn", col.Title] : Loc["TmKanban_CollapseColumn", col.Title])"
                                    @onclick="@(() => ToggleColumnAsync(col.Id))"
                                    @onclick:stopPropagation="true"></button>
                        }
                        @if (ColumnHeaderTemplate is not null)
                        {
                            @ColumnHeaderTemplate(col)
                        }
                        else
                        {
                            @if (col.Color is not null)
                            {
                                <span class="tm-kanban__header-color" style="background-color: @col.Color;"></span>
                            }
                            <span class="tm-kanban__header-title">@col.Title</span>
                            <span class="tm-kanban__count">@colItems.Count</span>
                            @if (col.MaxItems.HasValue)
                            {
                                <span class="tm-kanban__wip-limit">/ @col.MaxItems</span>
                            }
                        }
                    </div>
                </div>
            }
        </div>

        @foreach (var lane in lanes)
        {
            var laneKey = lane.Id;
            var laneTestId = LaneTestId(lane);
            var collapsed = IsLaneCollapsed(laneKey);
            var laneCount = GetLaneItemCount(lane);

            <div class="tm-kanban__swimlane@(collapsed ? " tm-kanban__swimlane--collapsed" : "")" data-testid="@TestId($"swimlane-{laneTestId}")">
                <div class="tm-kanban__swimlane-header">
                    @if (SwimlanesCollapsible)
                    {
                        <button type="button"
                                class="tm-kanban__swimlane-toggle"
                                aria-expanded="@((!collapsed).ToString().ToLowerInvariant())"
                                aria-label="@Loc["TmKanban_ToggleSwimlane"]"
                                @onclick="@(() => ToggleLaneAsync(laneKey))"></button>
                    }
                    @if (lane.Color is not null)
                    {
                        <span class="tm-kanban__swimlane-color" style="background-color: @lane.Color;"></span>
                    }
                    @if (SwimlaneHeaderTemplate is not null)
                    {
                        @SwimlaneHeaderTemplate(lane)
                    }
                    else
                    {
                        <span class="tm-kanban__swimlane-title">@lane.Title</span>
                    }
                    <span class="tm-kanban__swimlane-count">@laneCount</span>
                </div>

                @if (!collapsed)
                {
                    <div class="tm-kanban__swimlane-body">
                        @foreach (var col in Columns)
                        {
                            var cellItems = GetDropCellItems(col.Id, laneKey);
                            var colCollapsed = IsColumnCollapsed(col.Id);
                            var cellCss = "tm-kanban__column tm-kanban__column--lane-cell"
                                + (colCollapsed ? " tm-kanban__column--collapsed" : "")
                                + (IsCollapsedDropTarget(col.Id, laneKey, colCollapsed) ? " tm-kanban__column--drop-target" : "");
                            var showIndicator = !Disabled && _draggedItem is not null && _dropTargetColumn == col.Id && _dropTargetSwimlane == laneKey;

                            <div class="@cellCss"
                                 @ref="ZoneHandle(col.Id, laneKey).Ref"
                                 data-testid="@TestId($"cell-{col.Id}-{laneTestId}")"
                                 data-tm-kanban-column="@col.Id"
                                 data-tm-kanban-lane="@LaneDragValue(laneKey)"
                                 tabindex="@(IsMoveMenuEnabled ? "-1" : null)"
                                 @ondragover="@(() => HandleColumnDragOver(col.Id, laneKey))"
                                 @ondragover:preventDefault="@(!Disabled)"
                                 @ondrop="@(() => HandleDrop(col.Id, laneKey))">
                                @if (!colCollapsed)
                                {
                                    <div class="tm-kanban__cards">
                                        @RenderCells(col.Id, laneKey, cellItems, showIndicator)
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    @* D3: a collapsed lane keeps one drop slot per column instead of its body, so the column
                       grid stays aligned and every slot keeps catching a (column, lane) drop. *@
                    <div class="tm-kanban__swimlane-slots">
                        @foreach (var col in Columns)
                        {
                            var colCollapsed = IsColumnCollapsed(col.Id);
                            var slotTarget = Loc["TmKanban_LaneSlotTarget", col.Title, lane.Title];
                            var slotCss = "tm-kanban__lane-slot"
                                + (colCollapsed ? " tm-kanban__lane-slot--collapsed" : "")
                                + (IsActiveDropTarget(col.Id, laneKey) ? " tm-kanban__lane-slot--drop-target" : "");

                            <div class="@slotCss"
                                 @ref="ZoneHandle(col.Id, laneKey).Ref"
                                 data-testid="@TestId($"lane-slot-{col.Id}-{laneTestId}")"
                                 data-tm-kanban-column="@col.Id"
                                 data-tm-kanban-lane="@LaneDragValue(laneKey)"
                                 role="group"
                                 title="@slotTarget"
                                 aria-label="@slotTarget"
                                 tabindex="@(IsMoveMenuEnabled ? "-1" : null)"
                                 @ondragover="@(() => HandleColumnDragOver(col.Id, laneKey))"
                                 @ondragover:preventDefault="@(!Disabled)"
                                 @ondrop="@(() => HandleDrop(col.Id, laneKey))">
                                @if (col.Color is not null)
                                {
                                    <span class="tm-kanban__slot-color" style="background-color: @col.Color;"></span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }

    @if (IsMoveMenuEnabled)
    {
        <span class="tm-sr-only"
              role="status"
              aria-live="polite"
              aria-atomic="true"
              data-testid="@TestId("kanban-status")">@_announcement</span>
    }
</div>

@code {
    /// <summary>
    /// Reserved id that addresses the trailing "no value" swimlane (the lane holding every card whose
    /// <see cref="SwimlaneSelector"/> returns <see langword="null"/>) in <see cref="CollapsedLanes"/>.
    /// <see cref="KanbanMoveEvent{TItem}.ToSwimlane"/> still maps that lane to <see langword="null"/>, so the
    /// sentinel never leaves the component in a move event.
    /// </summary>
    public const string NoSwimlaneId = "__tm_kanban_no_swimlane__";

    // The lane id the board uses internally. The NUL prefix guarantees it can never collide with a host lane id,
    // and it is mapped to the public NoSwimlaneId before it reaches CollapsedLanes or CollapsedLanesChanged.
    private const string NoLaneId = "\0" + NoSwimlaneId;

    private TItem? _draggedItem;
    private string? _dragSourceColumn;
    private string? _dragSourceSwimlane;
    private string? _dropTargetColumn;
    private string? _dropTargetSwimlane;
    private int? _dropTargetIndex;
    private readonly HashSet<string> _collapsedColumns = new(StringComparer.Ordinal);
    private readonly HashSet<string> _collapsedLanes = new(StringComparer.Ordinal);

    /// <summary>Column definitions.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<KanbanColumn>? Columns { get; set; }

    /// <summary>All items on the board.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<TItem>? Items { get; set; }

    /// <summary>Function to determine which column an item belongs to.</summary>
    [Parameter, EditorRequired] public Func<TItem, string>? ColumnSelector { get; set; }

    /// <summary>Template for rendering a card.</summary>
    [Parameter, EditorRequired] public RenderFragment<TItem>? CardTemplate { get; set; }

    /// <summary>
    /// Optional function that groups cards into horizontal swimlanes. Returning <see langword="null"/> for an item
    /// places it in the trailing "no value" lane. When this is <see langword="null"/> the board renders without
    /// swimlanes (the classic layout) and behaviour is unchanged.
    /// </summary>
    [Parameter] public Func<TItem, string?>? SwimlaneSelector { get; set; }

    /// <summary>
    /// Explicit swimlane definitions (order and titles). When <see langword="null"/> the lanes are derived from
    /// <see cref="SwimlaneSelector"/> in order of first appearance. Ignored when <see cref="SwimlaneSelector"/> is null.
    /// </summary>
    [Parameter] public IReadOnlyList<KanbanSwimlane>? Swimlanes { get; set; }

    /// <summary>Custom swimlane header template.</summary>
    [Parameter] public RenderFragment<KanbanSwimlane>? SwimlaneHeaderTemplate { get; set; }

    /// <summary>Whether swimlanes can be collapsed/expanded via a toggle. Defaults to <see langword="true"/>.</summary>
    [Parameter] public bool SwimlanesCollapsible { get; set; } = true;

    /// <summary>
    /// Whether every column header renders a collapse/expand toggle. Defaults to <see langword="false"/>, which keeps
    /// the classic markup (no toggle, no collapsed strip). A collapsed column shrinks to a narrow strip showing the
    /// column title, card count and WIP badge, renders no cards, and stays a drop target that appends the dragged card.
    /// The toggle lives outside <see cref="ColumnHeaderTemplate"/>, so a custom header can never remove it.
    /// </summary>
    [Parameter] public bool ColumnsCollapsible { get; set; }

    /// <summary>
    /// Host-owned set of collapsed column ids. When <see langword="null"/> (the default) the board keeps the state
    /// itself and stays fully uncontrolled; when set, the host set wins and a toggle only raises
    /// <see cref="CollapsedColumnsChanged"/>.
    /// </summary>
    [Parameter] public IReadOnlyCollection<string>? CollapsedColumns { get; set; }

    /// <summary>
    /// Fires when a column toggle changes the collapsed set, carrying the complete new set (so
    /// <c>@bind-CollapsedColumns</c> round-trips). An uncontrolled board also applies the new set itself.
    /// </summary>
    [Parameter] public EventCallback<IReadOnlyCollection<string>> CollapsedColumnsChanged { get; set; }

    /// <summary>
    /// Host-owned set of collapsed swimlane ids, addressed by the lane id; the trailing "no value" lane uses
    /// <see cref="NoSwimlaneId"/>. When <see langword="null"/> (the default) the board keeps the state itself.
    /// </summary>
    [Parameter] public IReadOnlyCollection<string>? CollapsedLanes { get; set; }

    /// <summary>
    /// Fires when a swimlane toggle changes the collapsed set, carrying the complete new set (so
    /// <c>@bind-CollapsedLanes</c> round-trips). The "no value" lane is reported as <see cref="NoSwimlaneId"/>.
    /// </summary>
    [Parameter] public EventCallback<IReadOnlyCollection<string>> CollapsedLanesChanged { get; set; }

    /// <summary>Fires when a card is dragged to a different column or swimlane. Carries the target position (<c>TargetIndex</c>/<c>TargetBeforeItem</c>) and, when swimlanes are enabled, <c>FromSwimlane</c>/<c>ToSwimlane</c>.</summary>
    [Parameter] public EventCallback<KanbanMoveEvent<TItem>> OnItemMoved { get; set; }

    /// <summary>
    /// Fires when a card is dropped within the <em>same</em> cell (same column and, if swimlanes are enabled,
    /// same lane) to change its position. The event carries the target position. When no handler is
    /// attached, same-cell drops are a no-op — matching the legacy behaviour.
    /// </summary>
    [Parameter] public EventCallback<KanbanMoveEvent<TItem>> OnItemReordered { get; set; }

    /// <summary>Fires when a card is clicked.</summary>
    [Parameter] public EventCallback<TItem> OnCardClick { get; set; }

    /// <summary>Custom column header template. When supplied it replaces the default header content (title/count/WIP badge).</summary>
    [Parameter] public RenderFragment<KanbanColumn>? ColumnHeaderTemplate { get; set; }

    /// <summary>Template rendered inside an empty column/cell in place of the default "no items" text.</summary>
    [Parameter] public RenderFragment? EmptyColumnTemplate { get; set; }

    /// <summary>Additional CSS class.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Whether the kanban board is disabled (prevents drag).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Opt-in vertical card virtualization. When <see langword="true"/>, each (non-swimlane) column body
    /// becomes a fixed-height scroll container that renders only the visible window of cards through
    /// Blazor's built-in <c>&lt;Virtualize&gt;</c> — so a column holding thousands of cards stays fast.
    /// The card markup/template is unchanged. Defaults to <see langword="false"/>, which keeps the exact
    /// classic <c>@foreach</c> rendering (fully backward compatible).
    /// </summary>
    [Parameter] public bool VirtualizeCards { get; set; }

    /// <summary>
    /// Estimated card row height (px) handed to <c>&lt;Virtualize ItemSize&gt;</c> when
    /// <see cref="VirtualizeCards"/> is enabled. Defaults to 88.
    /// </summary>
    [Parameter] public double CardItemSize { get; set; } = 88;

    /// <summary>Additional HTML attributes to apply to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool SwimlanesEnabled => SwimlaneSelector is not null;

    // Effective collapse state: a host-supplied set wins, otherwise the board keeps its own state.
    private IReadOnlyCollection<string> EffectiveCollapsedColumns => CollapsedColumns ?? _collapsedColumns;

    private IReadOnlyCollection<string> EffectiveCollapsedLanes => CollapsedLanes ?? _collapsedLanes;

    // Collapsing is only a feature of a collapsible board: a host-supplied CollapsedColumns set is ignored
    // (and the board renders the classic, full-width columns) while ColumnsCollapsible is false, so the
    // feature's state can never do anything the feature itself is switched off for.
    private bool IsColumnCollapsed(string columnId) => ColumnsCollapsible && EffectiveCollapsedColumns.Contains(columnId);

    private bool IsLaneCollapsed(string laneId) => EffectiveCollapsedLanes.Contains(LaneSetValue(laneId));

    // The board root reports the in-flight gesture (tm-kanban--dragging) so the collapsed drop zones can
    // style themselves as targets for exactly as long as a card is actually being dragged.
    private bool IsDragging => !Disabled && _draggedItem is not null;

    // The zone currently under the drag: only a live, enabled gesture may advertise a drop target (D4/D6).
    private bool IsActiveDropTarget(string columnId, string? laneId)
        => !Disabled
           && _draggedItem is not null
           && _dropTargetColumn == columnId
           && _dropTargetSwimlane == laneId;

    // A collapsed zone only advertises itself as a drop target while a card is actually in flight (D4/D6).
    private bool IsCollapsedDropTarget(string columnId, string? laneId, bool isCollapsed)
        => isCollapsed && IsActiveDropTarget(columnId, laneId);

    // The strip's accessible name: title, count, then the WIP limit and the over-limit word when the
    // collapsed strip would otherwise hide the visible WIP badge from assistive technology.
    private string CollapsedColumnSummary(KanbanColumn column, int count)
    {
        var summary = Loc.Plural("TmKanban_CollapsedColumnSummary", count, column.Title);
        if (column.MaxItems is not int maxItems) return summary;

        summary += ", " + Loc["TmKanban_CollapsedColumnWip", maxItems];
        if (count > maxItems) summary += ", " + Loc["TmKanban_CollapsedColumnOverLimit"];
        return summary;
    }

    // Pointer-only affordance: a click anywhere on the collapsed header expands the column. It is deliberately
    // not a key emulation — the native toggle button in the same header is the keyboard path, and it fences
    // its own click with @onclick:stopPropagation so one gesture never toggles twice.
    private Task HandleColumnHeaderClick(KanbanColumn column)
        => IsColumnCollapsed(column.Id) ? ToggleColumnAsync(column.Id) : Task.CompletedTask;

    private Task ToggleColumnAsync(string columnId)
    {
        var next = new HashSet<string>(EffectiveCollapsedColumns, StringComparer.Ordinal);
        if (!next.Remove(columnId)) next.Add(columnId);

        if (CollapsedColumns is null)
        {
            _collapsedColumns.Clear();
            _collapsedColumns.UnionWith(next);
        }

        return CollapsedColumnsChanged.InvokeAsync(next);
    }

    private Task ToggleLaneAsync(string laneId)
    {
        var laneSetId = LaneSetValue(laneId);
        var next = new HashSet<string>(EffectiveCollapsedLanes, StringComparer.Ordinal);
        if (!next.Remove(laneSetId)) next.Add(laneSetId);

        if (CollapsedLanes is null)
        {
            _collapsedLanes.Clear();
            _collapsedLanes.UnionWith(next);
        }

        return CollapsedLanesChanged.InvokeAsync(next);
    }

    private List<TItem> GetColumnItems(string columnId)
    {
        if (Items is null || ColumnSelector is null) return [];
        return Items.Where(i => ColumnSelector(i) == columnId).ToList();
    }

    // Items in a given (column, lane) cell. A null lane (or swimlanes disabled) means the whole column.
    private List<TItem> GetDropCellItems(string columnId, string? laneId)
    {
        if (Items is null || ColumnSelector is null) return [];
        if (!SwimlanesEnabled || laneId is null)
            return Items.Where(i => ColumnSelector(i) == columnId).ToList();
        var known = KnownLaneIds();
        return Items.Where(i => ColumnSelector(i) == columnId && ItemInLane(i, laneId, known)).ToList();
    }

    private HashSet<string> KnownLaneIds()
    {
        if (Swimlanes is not null) return Swimlanes.Select(l => l.Id).ToHashSet();
        var set = new HashSet<string>();
        if (Items is not null && SwimlaneSelector is not null)
        {
            foreach (var i in Items)
            {
                var v = SwimlaneSelector(i);
                if (v is not null) set.Add(v);
            }
        }
        return set;
    }

    private List<KanbanSwimlane> GetEffectiveLanes()
    {
        var lanes = new List<KanbanSwimlane>();
        if (Swimlanes is not null)
        {
            lanes.AddRange(Swimlanes);
        }
        else if (Items is not null && SwimlaneSelector is not null)
        {
            var seen = new HashSet<string>();
            foreach (var i in Items)
            {
                var v = SwimlaneSelector(i);
                if (v is not null && seen.Add(v))
                    lanes.Add(new KanbanSwimlane(v, v));
            }
        }

        var known = lanes.Select(l => l.Id).ToHashSet();
        var hasNoValue = Items is not null && SwimlaneSelector is not null && Items.Any(i =>
        {
            var v = SwimlaneSelector(i);
            return v is null || !known.Contains(v);
        });
        if (hasNoValue)
            lanes.Add(new KanbanSwimlane(NoLaneId, Loc["TmKanban_NoSwimlane"]));

        return lanes;
    }

    private bool ItemInLane(TItem item, string laneId, HashSet<string> knownLaneIds)
    {
        var v = SwimlaneSelector!(item);
        if (laneId == NoLaneId) return v is null || !knownLaneIds.Contains(v);
        return v == laneId;
    }

    private int GetLaneItemCount(KanbanSwimlane lane)
    {
        if (Items is null || SwimlaneSelector is null) return 0;
        var known = KnownLaneIds();
        return Items.Count(i => ItemInLane(i, lane.Id, known));
    }

    private static string LaneTestId(KanbanSwimlane lane) => lane.Id == NoLaneId ? "none" : lane.Id;

    // The internal "no value" lane id (NoLaneId) is never surfaced: the public NoSwimlaneId addresses that lane in a
    // collapsed-lane set, while KanbanMoveEvent maps it to null.
    private static string LaneSetValue(string laneId) => laneId == NoLaneId ? NoSwimlaneId : laneId;

    // Rendered with fixed sequence numbers (mirroring the Razor @for compiler output) plus SetKey so
    // card DOM nodes keep their identity when the transient drop indicator is inserted/moved mid-drag —
    // otherwise the shifting subtree would recreate cards and cancel an in-flight drag.
    private RenderFragment RenderCells(string columnId, string? laneId, IReadOnlyList<TItem> items, bool showIndicator) => builder =>
    {
        if (items.Count == 0)
        {
            if (showIndicator)
            {
                builder.OpenElement(0, "div");
                builder.SetKey("tm-kanban-drop-indicator");
                builder.AddAttribute(1, "class", "tm-kanban__drop-indicator");
                builder.CloseElement();
            }
            if (EmptyColumnTemplate is not null)
            {
                builder.AddContent(2, EmptyColumnTemplate);
            }
            else
            {
                builder.OpenElement(3, "div");
                builder.AddAttribute(4, "class", "tm-kanban__empty");
                builder.AddContent(5, Loc["TmKanbanBoard_Empty"]);
                builder.CloseElement();
            }
            return;
        }

        var rovingIndex = RovingIndex(columnId, laneId, items);

        for (var i = 0; i < items.Count; i++)
        {
            if (showIndicator && _dropTargetIndex == i)
            {
                builder.OpenElement(6, "div");
                builder.SetKey("tm-kanban-drop-indicator");
                builder.AddAttribute(7, "class", "tm-kanban__drop-indicator");
                builder.CloseElement();
            }

            AddCard(builder, columnId, laneId, items[i], i, rovingIndex, keyed: true);
        }

        if (showIndicator && _dropTargetIndex >= items.Count)
        {
            builder.OpenElement(18, "div");
            builder.SetKey("tm-kanban-drop-indicator");
            builder.AddAttribute(19, "class", "tm-kanban__drop-indicator");
            builder.CloseElement();
        }
    };

    private const string TrailingDropIndicatorKey = "tm-kanban-drop-indicator";

    // A single card rendered inside <Virtualize>. Reuses the identical card markup (draggable + click +
    // CardTemplate + the non-drag move menu) as RenderCells so virtualization is a pure windowing
    // optimisation. The drop position index is resolved from the item's place in the current cell list
    // (dragging in huge columns is rare).
    private RenderFragment RenderVirtualCard(string columnId, string? laneId, IReadOnlyList<TItem> items, TItem item, bool showIndicator) => builder =>
    {
        var index = IndexOfItem(items, item);
        var rovingIndex = RovingIndex(columnId, laneId, items);

        if (showIndicator && _dropTargetIndex == index)
        {
            builder.OpenElement(0, "div");
            builder.SetKey("tm-kanban-drop-indicator");
            builder.AddAttribute(1, "class", "tm-kanban__drop-indicator");
            builder.CloseElement();
        }

        AddCard(builder, columnId, laneId, item, index, rovingIndex, keyed: false);
    };

    private static int IndexOfItem(IReadOnlyList<TItem> items, TItem item)
    {
        for (var i = 0; i < items.Count; i++)
        {
            if (EqualityComparer<TItem>.Default.Equals(items[i], item)) return i;
        }
        return -1;
    }

    // The module's STABLE card key: the card's index in the host's full Items list. Unlike the
    // cell index it survives a host refresh that moved the list under the gesture, so the release
    // report can be verified (a mismatch cancels the drop).
    private int KeyIndex(TItem item) => Items is null ? -1 : IndexOfItem(Items, item);

    private void HandleDragStart(TItem item, string fromColumn, string? fromLane)
    {
        if (Disabled) return;
        _draggedItem = item;
        _dragSourceColumn = fromColumn;
        _dragSourceSwimlane = fromLane;
        _dropTargetColumn = null;
        _dropTargetSwimlane = null;
        _dropTargetIndex = null;
    }

    // Dragging over the cell background (header / padding / empty area) targets the end of that cell.
    private void HandleColumnDragOver(string toColumn, string? toLane)
    {
        if (Disabled || _draggedItem is null) return;
        _dropTargetColumn = toColumn;
        _dropTargetSwimlane = toLane;
        _dropTargetIndex = GetDropCellItems(toColumn, toLane).Count;
    }

    // Dragging over a specific card. The top/bottom half is inferred purely from ordering (no JS measurement):
    // dragging a card downward past its current position drops it AFTER the hovered card, otherwise BEFORE it.
    private void HandleCardDragOver(string toColumn, string? toLane, int hoverIndex)
    {
        if (Disabled || _draggedItem is null) return;
        var items = GetDropCellItems(toColumn, toLane);
        var draggedIndex = items.FindIndex(x => EqualityComparer<TItem>.Default.Equals(x, _draggedItem));
        _dropTargetColumn = toColumn;
        _dropTargetSwimlane = toLane;
        _dropTargetIndex = draggedIndex >= 0 && draggedIndex < hoverIndex ? hoverIndex + 1 : hoverIndex;
    }

    private void HandleDragEnd() => ClearDrag();

    private async Task HandleDrop(string toColumn, string? toLane)
    {
        if (Disabled) { ClearDrag(); return; }
        if (_draggedItem is null || _dragSourceColumn is null) { ClearDrag(); return; }

        var fromColumn = _dragSourceColumn;
        var fromLane = _dragSourceSwimlane;
        var targetItems = GetDropCellItems(toColumn, toLane);
        var targetIndex = _dropTargetColumn == toColumn && _dropTargetSwimlane == toLane && _dropTargetIndex.HasValue
            ? Math.Clamp(_dropTargetIndex.Value, 0, targetItems.Count)
            : targetItems.Count;
        var beforeItem = targetIndex < targetItems.Count ? targetItems[targetIndex] : default;

        var moveEvent = new KanbanMoveEvent<TItem>(
            _draggedItem, fromColumn, toColumn, targetIndex, beforeItem,
            LaneEventValue(fromLane), LaneEventValue(toLane));
        ClearDrag();

        var sameCell = fromColumn == toColumn && fromLane == toLane;
        if (sameCell)
        {
            if (OnItemReordered.HasDelegate)
                await OnItemReordered.InvokeAsync(moveEvent);
        }
        else if (OnItemMoved.HasDelegate)
        {
            await OnItemMoved.InvokeAsync(moveEvent);
        }
    }

    // The internal "no value" sentinel is never surfaced to consumers — it maps to null.
    private static string? LaneEventValue(string? laneId) => laneId == NoLaneId ? null : laneId;

    private void ClearDrag()
    {
        _draggedItem = default;
        _dragSourceColumn = null;
        _dragSourceSwimlane = null;
        _dropTargetColumn = null;
        _dropTargetSwimlane = null;
        _dropTargetIndex = null;
    }

    private Task HandleCardClick(TItem item) => OnCardClick.InvokeAsync(item);
}
