@namespace Tempo.Blazor.Components.DataDisplay
@typeparam TItem
@using Tempo.Blazor.Interfaces
@using Tempo.Blazor.Models
@using Tempo.Blazor.Components.Filters
@using Tempo.Blazor.Components.DataTable
@using Tempo.Blazor.Components.Inputs
@using Tempo.Blazor.Services
@inject DragDropService DragDrop

<div class="tm-multi-view-list @Class" @attributes="AdditionalAttributes">

    @* ── Toolbar ─────────────────────────────────────────────── *@
    @if (ShowToolbar && HasVisibleToolbarControls())
    {
        <div class="tm-mvl-toolbar">
            @* Left: Search *@
            @if (ShouldRenderSearch())
            {
                <div class="tm-mvl-toolbar-left">
                    <TmSearchInput Value="@_searchText"
                                   ValueChanged="OnSearchChangedAsync"
                                   Placeholder="@Loc["TmDataTable_SearchPlaceholder"]" />
                </div>
            }

            @* Right: Group picker, View switcher, View manager *@
            <div class="tm-mvl-toolbar-right">
                @if (ShouldRenderGroupPicker())
                {
                    <div class="tm-mvl-group-picker">
                        <button type="button" class="tm-mvl-group-btn" @onclick="ToggleGroupPicker">
                            @Loc["TmMvl_GroupBy"]
                        </button>
                        @if (_groupPickerOpen)
                        {
                            <div class="tm-mvl-group-dropdown">
                                @foreach (var field in GroupableFields)
                                {
                                    <label class="tm-mvl-group-option">
                                        <input type="checkbox"
                                               checked="@_activeGroupFields.Contains(field.FieldName)"
                                               @onchange="e => ToggleGroupField(field.FieldName, (bool)e.Value!)" />
                                        @field.Label
                                    </label>
                                }
                            </div>
                        }
                    </div>
                }
                @if (ShouldRenderViewSwitcher())
                {
                    <div class="tm-mvl-switcher">
                        <button type="button"
                                class="tm-mvl-switch-table @(_viewMode == ListViewMode.Table ? "tm-mvl-switch--active" : "")"
                                aria-label="@Loc["TmMvl_TableView"]"
                                @onclick="() => SwitchView(ListViewMode.Table)">
                            <span>&#9783;</span>
                        </button>
                        <button type="button"
                                class="tm-mvl-switch-card @(_viewMode == ListViewMode.Card ? "tm-mvl-switch--active" : "")"
                                aria-label="@Loc["TmMvl_CardView"]"
                                @onclick="() => SwitchView(ListViewMode.Card)">
                            <span>&#9645;</span>
                        </button>
                        <button type="button"
                                class="tm-mvl-switch-list @(_viewMode == ListViewMode.List ? "tm-mvl-switch--active" : "")"
                                aria-label="@Loc["TmMvl_ListView"]"
                                @onclick="() => SwitchView(ListViewMode.List)">
                            <span>&#9776;</span>
                        </button>
                    </div>
                }
                @if (ShouldRenderViewManager())
                {
                    <TmViewManager Provider="ViewProvider"
                                   ViewContext="@ViewContext"
                                   OnViewApplied="ApplyViewAsync"
                                   GetCurrentView="GetCurrentView"
                                   GetCurrentFilters="() => _externalFilters"
                                   AvailableColumns="GetAvailableColumns()"
                                   FilterDefinitions="ViewFilterDefinitions"
                                   DisplayResolver="DisplayResolver"
                                   CanCreateTenantViews="ViewCanCreateTenantViews"
                                   CurrentUserId="CurrentUserId"
                                   CurrentTenantId="CurrentTenantId" />
                }
            </div>
        </div>
    }

    @* ── External Filter Builder ────────────────────────────── *@
    @if (ShouldRenderExternalFilterBuilder())
    {
        <div class="tm-mvl-external-filters" @key="_activeViewId">
            <TmFilterBuilder FilterDefinitions="ExternalFilterDefinitions"
                             ActiveFilters="_externalFilters"
                             OnFiltersChanged="OnExternalFiltersChanged"
                             DisplayResolver="DisplayResolver"
                             ShowClearAll="true" />
        </div>
    }

    @* ── Content ─────────────────────────────────────────────── *@
    @if (_isLoading)
    {
        <div class="tm-mvl-loading">
            <TmSpinner Size="SpinnerSize.Md" />
        </div>
    }
    else if (!HasItems)
    {
        <TmEmptyState Title="@(!string.IsNullOrEmpty(EmptyTitle) ? EmptyTitle : Loc["Tm_NoResults"])" />
    }
    else
    {
        <div class="@GetMvlScrollContainerClass()" style="@GetMvlScrollContainerStyle()">
            @if (_viewMode == ListViewMode.Table)
            {
                <table class="tm-mvl-table">
                    <thead>
                        <tr>
                            @if (AllowSelection)
                            {
                                <th class="tm-mvl-col-select">
                                    <input type="checkbox"
                                           class="tm-mvl-checkbox"
                                           checked="@AreAllVisibleSelected()"
                                           @onchange="_ => ToggleSelectAllAsync()" />
                                </th>
                            }
                            @if (_visibleColumns.Contains(ColumnKeys.Title)) { <th>@Loc["TmMvl_ColTitle"]</th> }
                            @if (_visibleColumns.Contains(ColumnKeys.SubTitle)) { <th>@Loc["TmMvl_ColSubTitle"]</th> }
                            @if (_visibleColumns.Contains(ColumnKeys.Status)) { <th>@Loc["TmMvl_ColStatus"]</th> }
                            @if (_visibleColumns.Contains(ColumnKeys.Date)) { <th>@Loc["TmMvl_ColDate"]</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsGrouped)
                        {
                            @RenderTableGroupRows(_groupedData!, 0)
                        }
                        else if (IsVirtualized)
                        {
                            <Virtualize Items="FilteredItems" Context="item" ItemSize="VirtualItemSize">
                                @RenderTableDataRow(item)
                            </Virtualize>
                        }
                        else
                        {
                            @foreach (var item in FilteredItems!)
                            {
                                @RenderTableDataRow(item)
                            }
                        }
                    </tbody>
                </table>
            }
            else if (_viewMode == ListViewMode.Card)
            {
                @if (IsGrouped)
                {
                    @RenderGroupSections(_groupedData!, 0, "card")
                }
                else if (IsVirtualized)
                {
                    <div class="tm-mvl-card-grid">
                        <Virtualize Items="FilteredItems" Context="item" ItemSize="VirtualCardHeight">
                            @RenderCardItem(item)
                        </Virtualize>
                    </div>
                }
                else
                {
                    <div class="tm-mvl-card-grid">
                        @foreach (var item in FilteredItems!)
                        {
                            @RenderCardItem(item)
                        }
                    </div>
                }
            }
            else if (_viewMode == ListViewMode.List)
            {
                @if (IsGrouped)
                {
                    @RenderGroupSections(_groupedData!, 0, "list")
                }
                else if (IsVirtualized)
                {
                    <ul class="tm-mvl-list">
                        <Virtualize Items="FilteredItems" Context="item" ItemSize="VirtualListItemHeight">
                            @RenderListItem(item)
                        </Virtualize>
                    </ul>
                }
                else
                {
                    <ul class="tm-mvl-list">
                        @foreach (var item in FilteredItems!)
                        {
                            @RenderListItem(item)
                        }
                    </ul>
                }
            }
        </div>
    }

    @* ── Pagination ───────────────────────────────────────────── *@
    @if (ShowPagination && _totalPages > 1 && ScrollMode == DataTableScrollMode.Pagination && !IsGrouped)
    {
        <div class="tm-pagination-container">
            @if (PaginationInfoPlacement == DataTablePaginationInfoPlacement.Summary)
            {
                <div class="tm-pagination-info">
                    @Loc["TmDataTable_ShowingItems", ((_currentPage - 1) * _pageSize) + 1, Math.Min(_currentPage * _pageSize, _totalCount), _totalCount]
                </div>
            }
            <div class="tm-pagination-center">
                <TmPagination CurrentPage="@_currentPage"
                              TotalPages="@_totalPages"
                              TotalCount="@_totalCount"
                              PageSize="@_pageSize"
                              ShowInfo="@(PaginationInfoPlacement == DataTablePaginationInfoPlacement.Pagination)"
                              OnPageChange="GoToPageAsync"
                              OnPageSizeChange="ChangePageSizeAsync" />
            </div>
        </div>
    }
</div>

@code {
    // ── Parameters: data ─────────────────────────────────────────

    /// <summary>Items to display in the list (client-side mode).</summary>
    [Parameter] public IReadOnlyList<TItem>? Items { get; set; }

    /// <summary>Server-side data provider. When set, data is loaded via this provider.</summary>
    [Parameter] public IDataTableDataProvider<TItem>? DataProvider { get; set; }

    /// <summary>When true, shows pagination bar when more than one page. Default: true.</summary>
    [Parameter] public bool ShowPagination { get; set; } = true;

    /// <summary>
    /// Which of the two item-range labels in the paging footer is rendered — the list's own summary or the
    /// one inside the embedded <see cref="TmPagination"/>. Showing both prints the count twice.
    /// Default: <see cref="DataTablePaginationInfoPlacement.Summary"/>.
    /// Per-group mini-pagers are unaffected; they have no sibling summary and always state their own range.
    /// </summary>
    [Parameter] public DataTablePaginationInfoPlacement PaginationInfoPlacement { get; set; }
        = DataTablePaginationInfoPlacement.Summary;

    /// <summary>Default page size for pagination. Default: 25.</summary>
    [Parameter] public int DefaultPageSize { get; set; } = 25;

    // ── Parameters: mapping (quick setup) ────────────────────────

    /// <summary>Maps an item to its display title.</summary>
    [Parameter] public Func<TItem, string>? TitleField { get; set; }

    /// <summary>Maps an item to its secondary text.</summary>
    [Parameter] public Func<TItem, string?>? SubTitleField { get; set; }

    /// <summary>Maps an item to its avatar/thumbnail URL.</summary>
    [Parameter] public Func<TItem, string?>? AvatarUrlField { get; set; }

    /// <summary>Maps an item to its status label text.</summary>
    [Parameter] public Func<TItem, string?>? StatusLabelField { get; set; }

    /// <summary>Maps an item to its status badge CSS color.</summary>
    [Parameter] public Func<TItem, string?>? StatusColorField { get; set; }

    /// <summary>Maps an item to its date value.</summary>
    [Parameter] public Func<TItem, DateTimeOffset?>? DateField { get; set; }

    /// <summary>Maps an item to its unique identifier.</summary>
    [Parameter] public Func<TItem, string>? IdField { get; set; }

    // ── Parameters: template overrides ───────────────────────────

    /// <summary>Custom card template. When set, overrides default card rendering.</summary>
    [Parameter] public RenderFragment<TItem>? CardTemplate { get; set; }

    /// <summary>Custom list item template. When set, overrides default list rendering.</summary>
    [Parameter] public RenderFragment<TItem>? ListItemTemplate { get; set; }

    /// <summary>Custom table row template. When set, overrides default table row rendering.</summary>
    [Parameter] public RenderFragment<TItem>? TableRowTemplate { get; set; }

    // ── Parameters: grouping ─────────────────────────────────────

    /// <summary>Fields available for grouping in the dropdown picker.</summary>
    [Parameter] public IReadOnlyList<GroupFieldDefinition<TItem>>? GroupableFields { get; set; }

    /// <summary>Whether groups are collapsed by default.</summary>
    [Parameter] public bool GroupsCollapsedByDefault { get; set; } = true;

    /// <summary>Fires when grouping configuration changes.</summary>
    [Parameter] public EventCallback<IReadOnlyList<string>> OnGroupingChanged { get; set; }

    // ── Parameters: virtualization ────────────────────────────────

    /// <summary>Scroll mode: Pagination (default) or Virtualized.</summary>
    [Parameter] public DataTableScrollMode ScrollMode { get; set; } = DataTableScrollMode.Pagination;

    /// <summary>Height of the virtual scroll container. Default: "600px".</summary>
    [Parameter] public string? VirtualScrollHeight { get; set; }

    /// <summary>Estimated item height for table row virtualization.</summary>
    [Parameter] public float VirtualItemSize { get; set; } = 48f;

    /// <summary>Estimated card height for card view virtualization.</summary>
    [Parameter] public float VirtualCardHeight { get; set; } = 180f;

    /// <summary>Estimated list item height for list view virtualization.</summary>
    [Parameter] public float VirtualListItemHeight { get; set; } = 56f;

    // ── Parameters: display ──────────────────────────────────────

    /// <summary>Current display mode (Table/Card/List). Two-way bindable.</summary>
    [Parameter] public ListViewMode ViewMode { get; set; } = ListViewMode.Table;

    /// <summary>Fires when the user switches the view mode.</summary>
    [Parameter] public EventCallback<ListViewMode> ViewModeChanged { get; set; }

    /// <summary>Fires when an item row/card is clicked.</summary>
    [Parameter] public EventCallback<TItem> OnItemClick { get; set; }

    /// <summary>When true, shows the view-mode switcher buttons above the list.</summary>
    [Parameter] public bool ShowViewSwitcher { get; set; } = true;

    /// <summary>When true, shows the global search input.</summary>
    [Parameter] public bool ShowSearch { get; set; } = true;

    /// <summary>Controlled search text. When set, the component uses this value instead of its internal state.</summary>
    [Parameter] public string? SearchText { get; set; }

    /// <summary>Fires when the search text changes.</summary>
    [Parameter] public EventCallback<string> SearchTextChanged { get; set; }

    /// <summary>
    /// When true, renders the toolbar container with search, view switcher, group picker, and view manager. Default: true.
    /// The toolbar is not rendered when no visible control would be shown (see <see cref="ToolbarMode"/>).
    /// For a page-owned filter surface, set <see cref="ToolbarMode"/> to <see cref="DataToolbarMode.ContentOnly"/>
    /// and supply filtered data via <see cref="Items"/> or <see cref="DataProvider"/>.
    /// </summary>
    [Parameter] public bool ShowToolbar { get; set; } = true;

    /// <summary>
    /// High-level preset that controls which toolbar chrome elements are rendered.
    /// <list type="bullet">
    ///   <item><see cref="DataToolbarMode.Full"/> — respects the individual <c>Show*</c> booleans.</item>
    ///   <item><see cref="DataToolbarMode.SearchOnly"/> — renders only the global search input.</item>
    ///   <item><see cref="DataToolbarMode.ActionsOnly"/> — renders only the view switcher, group picker, and view manager.</item>
    ///   <item><see cref="DataToolbarMode.ContentOnly"/> — hides all toolbar chrome and the external filter builder; use when the owning page provides its own filters.</item>
    /// </list>
    /// Default is <see cref="DataToolbarMode.Full"/>. Modes other than Full override the <c>Show*</c> booleans for the elements they affect.
    /// </summary>
    [Parameter] public DataToolbarMode ToolbarMode { get; set; } = DataToolbarMode.Full;

    /// <summary>
    /// When true and a <see cref="ViewProvider"/> is set, renders the TmViewManager. Default: true.
    /// </summary>
    [Parameter] public bool ShowViewManager { get; set; } = true;

    /// <summary>Title for the empty state when Items is empty.</summary>
    [Parameter] public string? EmptyTitle { get; set; }

    /// <summary>Additional CSS class for the root element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Additional HTML attributes to apply to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // ── Parameters: selection ────────────────────────────────────

    /// <summary>When true, shows checkboxes and enables multi-select mode.</summary>
    [Parameter] public bool AllowSelection { get; set; }

    /// <summary>Currently selected item IDs. Two-way bindable.</summary>
    [Parameter] public HashSet<string>? SelectedIds { get; set; }

    /// <summary>Fires when the selection changes.</summary>
    [Parameter] public EventCallback<HashSet<string>> SelectedIdsChanged { get; set; }

    /// <summary>
    /// Maps an item to its selection ID. Falls back to <see cref="IdField"/>,
    /// then to <see cref="IMultiViewListItem.Id"/>.
    /// </summary>
    [Parameter] public Func<TItem, string>? SelectionIdField { get; set; }

    // ── Parameters: drag source ──────────────────────────────────

    /// <summary>
    /// When true, items can be dragged. Works best together with <see cref="AllowSelection"/>:
    /// dragging a selected item drags all selected items; dragging an unselected item drags
    /// only that one item.
    /// </summary>
    [Parameter] public bool AllowDrag { get; set; }

    /// <summary>Fires when a drag operation starts. Receives the items being dragged.</summary>
    [Parameter] public EventCallback<IReadOnlyList<TItem>> OnDragStart { get; set; }

    // ── View Manager Parameters ───────────────────────────────────

    /// <summary>
    /// Unique identifier for this list instance.
    /// Used to scope saved views to specific lists (e.g., "team-members", "projects").
    /// </summary>
    [Parameter, EditorRequired] public string ViewContext { get; set; } = default!;

    /// <summary>
    /// Optional view persistence provider. When set, enables saved views and (by default) the external filter builder.
    /// Use <see cref="ShowExternalFilterBuilder"/> = false to keep saved views without rendering the inline filter builder,
    /// or <see cref="ToolbarMode"/> = <see cref="DataToolbarMode.ContentOnly"/> when the page owns the filtering UI.
    /// </summary>
    [Parameter] public IDataTableViewProvider? ViewProvider { get; set; }

    /// <summary>Filter definitions used by the view manager filter builder when creating or editing saved views.</summary>
    [Parameter] public List<FilterDefinition> ViewFilterDefinitions { get; set; } = [];

    /// <summary>
    /// When true and a <see cref="ViewProvider"/> is set, shows the inline FilterBuilder for external filtering. Default: true.
    /// Set to false when the surrounding page owns the filtering UI to avoid duplicate filters.
    /// </summary>
    [Parameter] public bool ShowExternalFilterBuilder { get; set; } = true;

    /// <summary>
    /// Filter definitions for the inline external filter builder (shown above the list when <see cref="ViewProvider"/> is set).
    /// When the page owns filtering, leave this empty and set <see cref="ShowExternalFilterBuilder"/> to false
    /// or use <see cref="ToolbarMode"/> = <see cref="DataToolbarMode.ContentOnly"/>.
    /// </summary>
    [Parameter] public List<FilterDefinition> ExternalFilterDefinitions { get; set; } = [];

    /// <summary>
    /// Universal display resolver for field labels and filter values.
    /// <list type="bullet">
    ///   <item><c>DisplayResolver(fieldName, null)</c> → localized field/column label (e.g., "Status" → "Stav")</item>
    ///   <item><c>DisplayResolver(fieldName, rawValue)</c> → localized value (e.g., ("Status","Active") → "Aktivní")</item>
    /// </list>
    /// Return null to use defaults (FilterDefinition.FieldLabel, column Title, or raw value).
    /// Set once on the component — flows to ViewManager, FilterBuilder, and ColumnPicker.
    /// </summary>
    [Parameter] public Func<string, string?, string?>? DisplayResolver { get; set; }

    /// <summary>Whether the user can create tenant-wide views.</summary>
    [Parameter] public bool ViewCanCreateTenantViews { get; set; }

    /// <summary>Current user ID for personal view scoping.</summary>
    [Parameter] public string? CurrentUserId { get; set; }

    /// <summary>Current tenant ID for tenant view scoping.</summary>
    [Parameter] public string? CurrentTenantId { get; set; }

    // ── Column key constants ─────────────────────────────────────
    private static class ColumnKeys
    {
        public const string Title = "Title";
        public const string SubTitle = "SubTitle";
        public const string Status = "Status";
        public const string Date = "Date";
        public const string Avatar = "Avatar";
    }

    // ── State ─────────────────────────────────────────────────────
    private ListViewMode _viewMode = ListViewMode.Table;
    private string _searchText = string.Empty;
    private string? _lastSearchTextParam;
    private HashSet<string> _selectedIds = [];
    private List<ActiveFilter> _externalFilters = [];
    private string? _activeViewId;
    private HashSet<string> _visibleColumns = [ColumnKeys.Title, ColumnKeys.SubTitle, ColumnKeys.Status, ColumnKeys.Date];

    // ── Server-side state ─────────────────────────────────────────
    private List<TItem> _serverItems = [];
    private bool _isLoading;
    private int _currentPage = 1;
    private int _pageSize = 25;
    private int _totalCount;
    private int _totalPages;

    // ── Grouping state ───────────────────────────────────────────
    private readonly List<string> _activeGroupFields = [];
    private readonly HashSet<string> _expandedGroups = new();
    private IReadOnlyList<DataGroup<TItem>>? _groupedData;
    private bool _groupPickerOpen;
    private bool IsGrouped => _activeGroupFields.Count > 0 && _groupedData is not null;
    private IReadOnlyDictionary<string, GroupPagination>? _serverGroupPaging;
    private readonly Dictionary<string, int> _groupPageRequests = new();
    private bool IsVirtualized => ScrollMode == DataTableScrollMode.Virtualized;

    private bool HasItems => (IsGrouped ? _groupedData?.Count > 0 : FilteredItems?.Count > 0) == true;

    private List<TItem>? FilteredItems
    {
        get
        {
            // Server-side: use loaded items directly
            if (DataProvider is not null)
                return _serverItems.Count > 0 ? _serverItems : null;

            if (Items == null) return null;

            var query = Items.AsEnumerable();

            // Apply search
            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                var term = _searchText.Trim();
                query = query.Where(item =>
                    (GetTitle(item)?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (GetSubTitle(item)?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (GetStatusLabel(item)?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            // Apply filters
            foreach (var filter in _externalFilters)
            {
                query = ApplyFilter(query, filter);
            }

            return query.ToList();
        }
    }

    // ── Field accessors (Hybrid: mapping > IMultiViewListItem > null) ──

    private string? GetTitle(TItem item) =>
        TitleField is not null ? TitleField(item) :
        item is IMultiViewListItem mvl ? mvl.Title : null;

    private string? GetSubTitle(TItem item) =>
        SubTitleField is not null ? SubTitleField(item) :
        item is IMultiViewListItem mvl ? mvl.SubTitle : null;

    private string? GetAvatarUrl(TItem item) =>
        AvatarUrlField is not null ? AvatarUrlField(item) :
        item is IMultiViewListItem mvl ? mvl.AvatarUrl : null;

    private string? GetStatusLabel(TItem item) =>
        StatusLabelField is not null ? StatusLabelField(item) :
        item is IMultiViewListItem mvl ? mvl.StatusLabel : null;

    private string? GetStatusColor(TItem item) =>
        StatusColorField is not null ? StatusColorField(item) :
        item is IMultiViewListItem mvl ? mvl.StatusColor : null;

    private DateTimeOffset? GetDate(TItem item) =>
        DateField is not null ? DateField(item) :
        item is IMultiViewListItem mvl ? mvl.Date : null;

    // ── Selection ─────────────────────────────────────────────────

    private string? GetSelectionId(TItem item) =>
        SelectionIdField is not null ? SelectionIdField(item) :
        IdField is not null ? IdField(item) :
        item is IMultiViewListItem mvl ? mvl.Id : null;

    private bool IsSelected(TItem item) =>
        GetSelectionId(item) is { } id && _selectedIds.Contains(id);

    private async Task ToggleSelectionAsync(TItem item)
    {
        var id = GetSelectionId(item);
        if (id is null) return;

        if (!_selectedIds.Remove(id))
            _selectedIds.Add(id);

        await SelectedIdsChanged.InvokeAsync(_selectedIds);
    }

    private async Task ToggleSelectAllAsync()
    {
        var visibleIds = (FilteredItems ?? [])
            .Select(GetSelectionId)
            .Where(id => id is not null)
            .Cast<string>()
            .ToList();

        if (visibleIds.All(id => _selectedIds.Contains(id)))
        {
            foreach (var id in visibleIds)
                _selectedIds.Remove(id);
        }
        else
        {
            foreach (var id in visibleIds)
                _selectedIds.Add(id);
        }

        await SelectedIdsChanged.InvokeAsync(_selectedIds);
    }

    private bool AreAllVisibleSelected()
    {
        var items = FilteredItems;
        if (items is null || items.Count == 0) return false;
        return items.All(IsSelected);
    }

    // ── Drag source ───────────────────────────────────────────────

    private List<TItem> _draggedItems = [];

    private bool IsDragging(TItem item) =>
        AllowDrag && _draggedItems.Contains(item);

    private async Task HandleDragStartAsync(TItem item)
    {
        // If the item is already selected, drag all selected items.
        // Otherwise drag only the single touched item (no selection change).
        var id = GetSelectionId(item);
        List<TItem> allItems = FilteredItems ?? _serverItems;

        if (id is not null && _selectedIds.Contains(id))
        {
            _draggedItems = allItems
                .Where(i => GetSelectionId(i) is { } sid && _selectedIds.Contains(sid))
                .ToList();
        }
        else
        {
            _draggedItems = [item];
        }

        var dragIds = _draggedItems
            .Select(GetSelectionId)
            .Where(i => i is not null)
            .Cast<string>();

        DragDrop.StartDrag(dragIds);
        await OnDragStart.InvokeAsync(_draggedItems);
        StateHasChanged();
    }

    private void HandleDragEnd()
    {
        _draggedItems = [];
        DragDrop.EndDrag();
        StateHasChanged();
    }

    // ── Filter logic ─────────────────────────────────────────────

    private static readonly Dictionary<string, System.Reflection.PropertyInfo> _propertyCache = new(StringComparer.OrdinalIgnoreCase);

    private Func<TItem, object?>? GetFieldAccessor(string fieldName)
    {
        // Primary: resolve from TItem model via reflection
        if (!_propertyCache.TryGetValue(fieldName, out var prop))
        {
            prop = typeof(TItem).GetProperty(fieldName, System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.IgnoreCase);
            if (prop is not null)
                _propertyCache[fieldName] = prop;
        }

        if (prop is not null)
            return item => prop.GetValue(item);

        // Fallback: IMultiViewListItem interface fields (for non-POCO items)
        if (typeof(IMultiViewListItem).IsAssignableFrom(typeof(TItem)))
        {
            return fieldName.ToLowerInvariant() switch
            {
                "title"       => i => GetTitle(i),
                "subtitle"    => i => GetSubTitle(i),
                "status" or "statuslabel" => i => GetStatusLabel(i),
                "date"        => i => GetDate(i),
                _             => null,
            };
        }

        return null;
    }

    private IEnumerable<TItem> ApplyFilter(IEnumerable<TItem> query, ActiveFilter filter)
    {
        var accessor = GetFieldAccessor(filter.FieldName);
        if (accessor is null) return query;

        var filterValue = filter.Value?.ToString() ?? filter.DisplayValue ?? "";
        var op = filter.Operator;

        return op switch
        {
            FilterOperator.Contains      => query.Where(i => accessor(i)?.ToString()?.Contains(filterValue, StringComparison.OrdinalIgnoreCase) == true),
            FilterOperator.NotContains   => query.Where(i => accessor(i)?.ToString()?.Contains(filterValue, StringComparison.OrdinalIgnoreCase) != true),
            FilterOperator.Equals        => query.Where(i => string.Equals(accessor(i)?.ToString(), filterValue, StringComparison.OrdinalIgnoreCase)),
            FilterOperator.NotEquals     => query.Where(i => !string.Equals(accessor(i)?.ToString(), filterValue, StringComparison.OrdinalIgnoreCase)),
            FilterOperator.GreaterThan   => query.Where(i => CompareValues(accessor(i), filterValue) > 0),
            FilterOperator.LessThan      => query.Where(i => CompareValues(accessor(i), filterValue) < 0),
            FilterOperator.GreaterOrEqual=> query.Where(i => CompareValues(accessor(i), filterValue) >= 0),
            FilterOperator.LessOrEqual   => query.Where(i => CompareValues(accessor(i), filterValue) <= 0),
            FilterOperator.IsEmpty       => query.Where(i => string.IsNullOrEmpty(accessor(i)?.ToString())),
            FilterOperator.IsNotEmpty    => query.Where(i => !string.IsNullOrEmpty(accessor(i)?.ToString())),
            _                            => query,
        };
    }

    private static int CompareValues(object? fieldValue, string filterValue)
    {
        if (fieldValue is null) return -1;

        // If field value is already IComparable, use typed comparison
        if (fieldValue is IComparable comparable)
        {
            try
            {
                var converted = Convert.ChangeType(filterValue, fieldValue.GetType(), System.Globalization.CultureInfo.InvariantCulture);
                return comparable.CompareTo(converted);
            }
            catch { /* fall through to string comparison */ }
        }

        // Fallback: string comparison
        return string.Compare(fieldValue.ToString(), filterValue, StringComparison.OrdinalIgnoreCase);
    }

    // ── Lifecycle ─────────────────────────────────────────────────

    private bool _dataLoaded;

    protected override async Task OnInitializedAsync()
    {
        if (_dataLoaded) return;

        _pageSize = DefaultPageSize;
        _searchText = SearchText ?? string.Empty;
        _lastSearchTextParam = SearchText;

        if (DataProvider is not null)
            await LoadFromProviderAsync();

        _dataLoaded = true;
    }

    private ListViewMode _lastViewModeParam = ListViewMode.Table;

    protected override async Task OnParametersSetAsync()
    {
        // Only sync _viewMode from the parameter when the parameter actually changes.
        // Without this guard, every StateHasChanged() call (e.g. checkbox toggle) would
        // re-run OnParametersSet and reset the view to the default Table value.
        if (ViewMode != _lastViewModeParam)
        {
            _viewMode = ViewMode;
            _lastViewModeParam = ViewMode;
        }

        // Sync externally supplied SearchText into internal state.
        // When SearchText is null the component is uncontrolled; internal state is preserved.
        if (SearchText != _lastSearchTextParam && SearchText is not null)
        {
            _lastSearchTextParam = SearchText;
            _searchText = SearchText;
            _currentPage = 1;
            _groupPageRequests.Clear();
            if (DataProvider is not null)
                await LoadFromProviderAsync();
            else
                RefreshGroupedData();
        }

        // Track transition from controlled back to uncontrolled without overwriting internal state.
        if (SearchText is null && _lastSearchTextParam is not null)
            _lastSearchTextParam = null;

        // Sync externally supplied SelectedIds into internal state
        if (SelectedIds is not null)
            _selectedIds = SelectedIds;
    }

    // ── Server-side data loading ─────────────────────────────────

    private async Task LoadFromProviderAsync()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var filters = _externalFilters.Select(f => new DataTableFilter(f.FieldName, f.Operator.ToString(), f.Value)).ToList();

            // Try server-side grouping when groups are active
            if (_activeGroupFields.Count > 0)
            {
                var groupQuery = new DataTableQuery
                {
                    Page = _currentPage,
                    PageSize = _pageSize,
                    SearchText = _searchText,
                    Filters = filters,
                    GroupByColumns = _activeGroupFields.ToList(),
                    GroupPageRequests = _groupPageRequests.Count > 0 ? _groupPageRequests : null,
                };
                var grouped = await DataProvider!.GetGroupedDataAsync(groupQuery);
                if (grouped is not null)
                {
                    _groupedData = grouped.Groups;
                    _totalCount = grouped.TotalCount;
                    _serverGroupPaging = grouped.GroupPaging;
                    _serverItems = []; // items are inside groups
                    return;
                }
                // Fall through: server doesn't support grouping → load flat + client-side group
            }

            _serverGroupPaging = null;

            var query = new DataTableQuery
            {
                Page = _currentPage,
                PageSize = _pageSize,
                SearchText = _searchText,
                Filters = filters,
            };
            var result = await DataProvider!.GetDataAsync(query);
            _serverItems = result.Items.ToList();
            _totalCount = result.TotalCount;
            _currentPage = result.Page;
            _pageSize = result.PageSize;
            _totalPages = result.TotalPages;

            // Client-side grouping fallback when server doesn't support it
            if (_activeGroupFields.Count > 0)
                RefreshGroupedData();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task GoToPageAsync(int page)
    {
        _currentPage = page;
        if (DataProvider is not null)
            await LoadFromProviderAsync();
    }

    private async Task ChangePageSizeAsync(int size)
    {
        _pageSize = size;
        _currentPage = 1;
        if (DataProvider is not null)
            await LoadFromProviderAsync();
    }

    private async Task SwitchView(ListViewMode mode)
    {
        _viewMode = mode;
        await ViewModeChanged.InvokeAsync(mode);
    }

    private async Task OnSearchChangedAsync(string? value)
    {
        _searchText = value ?? string.Empty;
        _groupPageRequests.Clear();

        // In controlled mode, advance the last-seen parameter so the upcoming
        // parent rerender from @bind-SearchText does not trigger a duplicate reload.
        if (SearchText is not null)
            _lastSearchTextParam = _searchText;

        if (DataProvider is not null)
        {
            _currentPage = 1;
            await LoadFromProviderAsync();
        }
        await SearchTextChanged.InvokeAsync(_searchText);
    }

    private async Task OnExternalFiltersChanged(IEnumerable<ActiveFilter> filters)
    {
        _externalFilters = filters.ToList();
        _groupPageRequests.Clear();
        if (DataProvider is not null)
        {
            _currentPage = 1;
            await LoadFromProviderAsync();
        }
    }

    private async Task ApplyViewAsync(DataTableView view)
    {
        _activeViewId = view.Id;

        // Update visible columns
        if (view.VisibleColumns?.Count > 0)
        {
            _visibleColumns = new HashSet<string>(view.VisibleColumns);
        }

        // Update filters
        _externalFilters = view.Filters?.Where(f => !string.IsNullOrEmpty(f.Value)).Select(f =>
        {
            var fieldLabel = DisplayResolver?.Invoke(f.FieldName, null)
                ?? ExternalFilterDefinitions.FirstOrDefault(d => d.FieldName == f.FieldName)?.FieldLabel
                ?? f.FieldName;
            var displayValue = DisplayResolver?.Invoke(f.FieldName, f.Value) ?? f.Value;
            return new ActiveFilter(f.FieldName, fieldLabel, ParseFilterOperator(f.Operator), f.Value, displayValue);
        }).ToList() ?? [];

        // Apply grouping
        _activeGroupFields.Clear();
        if (view.GroupByColumns?.Count > 0)
        {
            _activeGroupFields.AddRange(view.GroupByColumns);
            _expandedGroups.Clear();
            RefreshGroupedData();
        }
        else
        {
            _groupedData = null;
        }

        // Reload data with new filters applied
        _currentPage = 1;
        if (DataProvider is not null)
            await LoadFromProviderAsync();
    }

    private DataTableView GetCurrentView() => new()
    {
        Name = Loc["TmMvl_CurrentViewName"],
        VisibleColumns = _visibleColumns.ToList(),
        Filters = _externalFilters.Select(f => new FilterConfig
        {
            FieldName = f.FieldName,
            Operator = f.Operator.ToString(),
            Value = f.Value?.ToString() ?? ""
        }).ToList()
    };

    private List<ViewColumnInfo> GetAvailableColumns() =>
    [
        new ViewColumnInfo { Key = ColumnKeys.Title, Title = Loc["TmMvl_ColTitle"], Visible = _visibleColumns.Contains(ColumnKeys.Title) },
        new ViewColumnInfo { Key = ColumnKeys.SubTitle, Title = Loc["TmMvl_ColSubTitle"], Visible = _visibleColumns.Contains(ColumnKeys.SubTitle) },
        new ViewColumnInfo { Key = ColumnKeys.Status, Title = Loc["TmMvl_ColStatus"], Visible = _visibleColumns.Contains(ColumnKeys.Status) },
        new ViewColumnInfo { Key = ColumnKeys.Date, Title = Loc["TmMvl_ColDate"], Visible = _visibleColumns.Contains(ColumnKeys.Date) },
        new ViewColumnInfo { Key = ColumnKeys.Avatar, Title = Loc["TmMvl_ColAvatar"], Visible = _visibleColumns.Contains(ColumnKeys.Avatar) }
    ];

    private static FilterOperator ParseFilterOperator(string? op) => Helpers.FilterOperatorParser.Parse(op);

    // ── Grouping ─────────────────────────────────────────────────

    private void ToggleGroupPicker()
    {
        _groupPickerOpen = !_groupPickerOpen;
    }

    private async Task ToggleGroupField(string fieldName, bool enabled)
    {
        if (enabled && !_activeGroupFields.Contains(fieldName))
        {
            _activeGroupFields.Add(fieldName);
        }
        else if (!enabled)
        {
            _activeGroupFields.Remove(fieldName);
        }

        _groupPickerOpen = false;
        _expandedGroups.Clear();
        _groupPageRequests.Clear();
        _serverGroupPaging = null;

        if (DataProvider is not null)
        {
            await LoadFromProviderAsync();
        }
        else
        {
            RefreshGroupedData();
        }

        if (_activeGroupFields.Count == 0)
            _groupedData = null;

        await OnGroupingChanged.InvokeAsync(_activeGroupFields.ToList());
    }

    private async Task NavigateGroupPageAsync(string groupKey, int page)
    {
        _groupPageRequests[groupKey] = page;
        if (DataProvider is not null)
            await LoadFromProviderAsync();
    }

    private void RefreshGroupedData()
    {
        if (_activeGroupFields.Count == 0 || GroupableFields is null)
        {
            _groupedData = null;
            return;
        }

        var items = FilteredItems ?? [];

        var levels = _activeGroupFields.Select(fieldName =>
        {
            var def = GroupableFields.FirstOrDefault(f => f.FieldName == fieldName);
            return def is not null
                ? new GroupingLevel<TItem>(
                    fieldName,
                    def.FieldAccessor,
                    def.DisplayFormatter)
                : null;
        }).Where(l => l is not null).Cast<GroupingLevel<TItem>>().ToList();

        _groupedData = DataGroupingService.GroupItems(items, levels);
    }

    private void ToggleGroupExpansion(string groupKey)
    {
        if (!_expandedGroups.Remove(groupKey))
            _expandedGroups.Add(groupKey);
    }

    private bool IsGroupExpanded(DataGroup<TItem> group)
    {
        var key = $"{group.FieldName}:{group.Key}";
        return GroupsCollapsedByDefault ? _expandedGroups.Contains(key) : !_expandedGroups.Contains(key);
    }

    private string GetGroupKey(DataGroup<TItem> group) => $"{group.FieldName}:{group.Key}";

    private int MvlColSpan => _visibleColumns.Count;

    private string GetMvlScrollContainerClass() =>
        IsVirtualized ? "tm-mvl-virtual-scroll" : "";

    private string GetMvlScrollContainerStyle() =>
        IsVirtualized ? $"height: {VirtualScrollHeight ?? "600px"}; overflow-y: auto;" : "";

    // ── Render fragments ──────────────────────────────────────────

    private RenderFragment RenderTableGroupRows(IReadOnlyList<DataGroup<TItem>> groups, int level) => __builder =>
    {
        foreach (var group in groups)
        {
            var groupKey = GetGroupKey(group);
            var expanded = IsGroupExpanded(group);

            <tr class="tm-mvl-group-row tm-mvl-group-level-@level">
                <td colspan="@MvlColSpan">
                    <button type="button" class="tm-mvl-group-toggle" @onclick="() => ToggleGroupExpansion(groupKey)">
                        @(expanded ? "▼" : "►")
                    </button>
                    <span class="tm-mvl-group-label">@(group.DisplayValue ?? group.Key)</span>
                    <span class="tm-mvl-group-count">(@group.Count)</span>
                </td>
            </tr>

            if (expanded)
            {
                if (group.SubGroups is { Count: > 0 })
                {
                    @RenderTableGroupRows(group.SubGroups, level + 1)
                }
                else
                {
                    foreach (var item in group.Items)
                    {
                        @RenderTableDataRow(item)
                    }

                    @RenderGroupMiniPager(group, "table")
                }
            }
        }
    };

    // Keyboard emulation is REQUIRED here (unlike on TmButton): the clickable
    // rows/cards/items are <tr>/<div>/<li> elements, not native <button>, so
    // the browser never produces a click for Enter/Space on its own.
    private Task HandleItemKeyDownAsync(KeyboardEventArgs e, TItem item)
    {
        if (e.Key is "Enter" or " ")
            return OnItemClick.InvokeAsync(item);
        return Task.CompletedTask;
    }

    private RenderFragment RenderTableDataRow(TItem item) => __builder =>
    {
        var selected = AllowSelection && IsSelected(item);
        var dragging = IsDragging(item);
        <tr class="tm-mvl-row @(selected ? "tm-mvl-row--selected" : "") @(dragging ? "tm-mvl-item--dragging" : "")"
            tabindex="0"
            draggable="@(AllowDrag ? "true" : "false")"
            @onclick="() => OnItemClick.InvokeAsync(item)"
            @onkeydown="e => HandleItemKeyDownAsync(e, item)"
            @ondragstart="() => HandleDragStartAsync(item)"
            @ondragend="HandleDragEnd">
            @if (AllowSelection)
            {
                <td class="tm-mvl-col-select" @onclick:stopPropagation>
                    <input type="checkbox"
                           class="tm-mvl-checkbox"
                           checked="@selected"
                           @onchange="_ => ToggleSelectionAsync(item)" />
                </td>
            }
            @if (TableRowTemplate is not null)
            {
                @TableRowTemplate(item)
            }
            else
            {
                if (_visibleColumns.Contains(ColumnKeys.Title)) { <td>@GetTitle(item)</td> }
                if (_visibleColumns.Contains(ColumnKeys.SubTitle)) { <td>@GetSubTitle(item)</td> }
                if (_visibleColumns.Contains(ColumnKeys.Status))
                {
                    <td>
                        @if (!string.IsNullOrEmpty(GetStatusLabel(item)))
                        {
                            <span class="tm-mvl-status" style="@(GetStatusColor(item) is { } c ? $"background:{c}" : "")">
                                @GetStatusLabel(item)
                            </span>
                        }
                    </td>
                }
                if (_visibleColumns.Contains(ColumnKeys.Date)) { <td>@GetDate(item)?.ToString("d")</td> }
            }
        </tr>
    };

    private RenderFragment RenderGroupSections(IReadOnlyList<DataGroup<TItem>> groups, int level, string viewType) => __builder =>
    {
        foreach (var group in groups)
        {
            var groupKey = GetGroupKey(group);
            var expanded = IsGroupExpanded(group);

            <div class="tm-mvl-group-section tm-mvl-group-level-@level">
                <div class="tm-mvl-group-header">
                    <button type="button" class="tm-mvl-group-toggle" @onclick="() => ToggleGroupExpansion(groupKey)">
                        @(expanded ? "▼" : "►")
                    </button>
                    <span class="tm-mvl-group-label">@(group.DisplayValue ?? group.Key)</span>
                    <span class="tm-mvl-group-count">(@group.Count)</span>
                </div>

                @if (expanded)
                {
                    if (group.SubGroups is { Count: > 0 })
                    {
                        @RenderGroupSections(group.SubGroups, level + 1, viewType)
                    }
                    else if (viewType == "card")
                    {
                        <div class="tm-mvl-card-grid">
                            @foreach (var item in group.Items)
                            {
                                @RenderCardItem(item)
                            }
                        </div>
                        @RenderGroupMiniPager(group, "div")
                    }
                    else
                    {
                        <ul class="tm-mvl-list">
                            @foreach (var item in group.Items)
                            {
                                @RenderListItem(item)
                            }
                        </ul>
                        @RenderGroupMiniPager(group, "div")
                    }
                }
            </div>
        }
    };

    private RenderFragment RenderGroupMiniPager(DataGroup<TItem> group, string wrapperType) => __builder =>
    {
        var groupKeyStr = group.Key?.ToString() ?? "";
        if (_serverGroupPaging is not null
            && _serverGroupPaging.TryGetValue(groupKeyStr, out var paging)
            && paging.TotalPages > 1)
        {
            var capturedKey = groupKeyStr;
            if (wrapperType == "table")
            {
                <tr class="tm-mvl-group-pagination">
                    <td colspan="@MvlColSpan">
                        <TmPagination CurrentPage="@paging.Page"
                                      TotalPages="@paging.TotalPages"
                                      TotalCount="@paging.TotalCount"
                                      PageSize="@paging.PageSize"
                                      PageSizeOptions="@((IReadOnlyList<int>?)null)"
                                      Class="tm-pagination-compact"
                                      OnPageChange="page => NavigateGroupPageAsync(capturedKey, page)" />
                    </td>
                </tr>
            }
            else
            {
                <div class="tm-mvl-group-pagination">
                    <TmPagination CurrentPage="@paging.Page"
                                  TotalPages="@paging.TotalPages"
                                  TotalCount="@paging.TotalCount"
                                  PageSize="@paging.PageSize"
                                  PageSizeOptions="@((IReadOnlyList<int>?)null)"
                                  Class="tm-pagination-compact"
                                  OnPageChange="page => NavigateGroupPageAsync(capturedKey, page)" />
                </div>
            }
        }
    };

    private RenderFragment RenderCardItem(TItem item) => __builder =>
    {
        var selected = AllowSelection && IsSelected(item);
        var dragging = IsDragging(item);
        <div class="tm-mvl-card @(selected ? "tm-mvl-card--selected" : "") @(dragging ? "tm-mvl-item--dragging" : "")"
             role="button" tabindex="0"
             draggable="@(AllowDrag ? "true" : "false")"
             @onclick="() => OnItemClick.InvokeAsync(item)"
             @onkeydown="e => HandleItemKeyDownAsync(e, item)"
             @ondragstart="() => HandleDragStartAsync(item)"
             @ondragend="HandleDragEnd">
            @if (CardTemplate is not null)
            {
                @if (AllowSelection)
                {
                    <div class="tm-mvl-card-select-row" @onclick:stopPropagation>
                        <input type="checkbox"
                               class="tm-mvl-checkbox"
                               checked="@selected"
                               @onchange="_ => ToggleSelectionAsync(item)" />
                    </div>
                }
                @CardTemplate(item)
            }
            else
            {
                @if (AllowSelection)
                {
                    <div class="tm-mvl-card-select-row" @onclick:stopPropagation>
                        <input type="checkbox"
                               class="tm-mvl-checkbox"
                               checked="@selected"
                               @onchange="_ => ToggleSelectionAsync(item)" />
                        @if (!string.IsNullOrEmpty(GetTitle(item)))
                        {
                            <div class="tm-mvl-card-title">@GetTitle(item)</div>
                        }
                    </div>
                }
                else if (!string.IsNullOrEmpty(GetAvatarUrl(item)))
                {
                    <img class="tm-mvl-card-avatar" src="@GetAvatarUrl(item)" alt="" />
                }
                <div class="tm-mvl-card-body">
                    @if (!AllowSelection)
                    {
                        <div class="tm-mvl-card-title">@GetTitle(item)</div>
                    }
                    @if (!string.IsNullOrEmpty(GetSubTitle(item)))
                    {
                        <div class="tm-mvl-card-subtitle">@GetSubTitle(item)</div>
                    }
                    @if (!string.IsNullOrEmpty(GetStatusLabel(item)))
                    {
                        <span class="tm-mvl-status" style="@(GetStatusColor(item) is { } c ? $"background:{c}" : "")">
                            @GetStatusLabel(item)
                        </span>
                    }
                </div>
            }
        </div>
    };

    private RenderFragment RenderListItem(TItem item) => __builder =>
    {
        var selected = AllowSelection && IsSelected(item);
        var dragging = IsDragging(item);
        <li class="tm-mvl-list-item @(selected ? "tm-mvl-list-item--selected" : "") @(dragging ? "tm-mvl-item--dragging" : "")"
            tabindex="0"
            draggable="@(AllowDrag ? "true" : "false")"
            @onclick="() => OnItemClick.InvokeAsync(item)"
            @onkeydown="e => HandleItemKeyDownAsync(e, item)"
            @ondragstart="() => HandleDragStartAsync(item)"
            @ondragend="HandleDragEnd">
            @if (AllowSelection)
            {
                <div class="tm-mvl-list-select" @onclick:stopPropagation>
                    <input type="checkbox"
                           class="tm-mvl-checkbox"
                           checked="@selected"
                           @onchange="_ => ToggleSelectionAsync(item)" />
                </div>
            }
            @if (ListItemTemplate is not null)
            {
                @ListItemTemplate(item)
            }
            else
            {
                @if (!string.IsNullOrEmpty(GetAvatarUrl(item)))
                {
                    <img class="tm-mvl-list-avatar" src="@GetAvatarUrl(item)" alt="" />
                }
                <div class="tm-mvl-list-content">
                    <span class="tm-mvl-list-title">@GetTitle(item)</span>
                    @if (!string.IsNullOrEmpty(GetSubTitle(item)))
                    {
                        <span class="tm-mvl-list-subtitle">@GetSubTitle(item)</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(GetStatusLabel(item)))
                {
                    <span class="tm-mvl-status" style="@(GetStatusColor(item) is { } c ? $"background:{c}" : "")">
                        @GetStatusLabel(item)
                    </span>
                }
            }
        </li>
    };

    private bool IsFullToolbarMode => ToolbarMode == DataToolbarMode.Full;
    private bool IsSearchToolbarMode => ToolbarMode == DataToolbarMode.SearchOnly;
    private bool IsActionsToolbarMode => ToolbarMode == DataToolbarMode.ActionsOnly;
    private bool IsContentToolbarMode => ToolbarMode == DataToolbarMode.ContentOnly;

    /// <summary>True when the global search input should be rendered.</summary>
    private bool ShouldRenderSearch() =>
        !IsContentToolbarMode && (IsSearchToolbarMode || (IsFullToolbarMode && ShowSearch));

    /// <summary>True when the view-mode switcher should be rendered.</summary>
    private bool ShouldRenderViewSwitcher() =>
        !IsContentToolbarMode &&
        !IsSearchToolbarMode &&
        (IsActionsToolbarMode || (IsFullToolbarMode && ShowViewSwitcher));

    /// <summary>True when the view manager should be rendered.</summary>
    private bool ShouldRenderViewManager() =>
        !IsContentToolbarMode &&
        !IsSearchToolbarMode &&
        ViewProvider is not null &&
        (IsActionsToolbarMode || (IsFullToolbarMode && ShowViewManager));

    /// <summary>True when the group picker should be rendered.</summary>
    private bool ShouldRenderGroupPicker() =>
        !IsContentToolbarMode &&
        !IsSearchToolbarMode &&
        GroupableFields is not null &&
        GroupableFields.Count > 0 &&
        (IsActionsToolbarMode || IsFullToolbarMode);

    /// <summary>True when the external filter builder should be rendered.</summary>
    private bool ShouldRenderExternalFilterBuilder() =>
        IsFullToolbarMode &&
        ShowExternalFilterBuilder &&
        ViewProvider is not null &&
        ExternalFilterDefinitions?.Any() == true;

    /// <summary>Determines whether any toolbar control should be rendered.</summary>
    private bool HasVisibleToolbarControls() =>
        ShouldRenderSearch() ||
        ShouldRenderGroupPicker() ||
        ShouldRenderViewSwitcher() ||
        ShouldRenderViewManager();
}
