@namespace Tempo.Blazor.Components.DataDisplay
@typeparam TItem
@using Tempo.Blazor.Interfaces
@using Tempo.Blazor.Models
@using Tempo.Blazor.Components.Filters
@using Tempo.Blazor.Components.DataTable
@using Tempo.Blazor.Components.Inputs
@using Tempo.Blazor.Components.Overlay
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Components.Avatars
@using Tempo.Blazor.Services
@inject DragDropService DragDrop
@inject IJSRuntime JS

<div class="@RootCssClass" @attributes="AdditionalAttributes">

    @* ── Toolbar ─────────────────────────────────────────────── *@
    @if (ShowToolbar && HasVisibleToolbarControls())
    {
        <div class="tm-mvl-toolbar">
            @* Left: Search *@
            @if (ShouldRenderSearch())
            {
                <div class="tm-mvl-toolbar-left @(Responsive ? "tm-mvl-toolbar-left--responsive" : null)">
                    <TmSearchInput Value="@_searchText"
                                   ValueChanged="OnSearchChangedAsync"
                                   Placeholder="@Loc["TmDataTable_SearchPlaceholder"]" />
                </div>
            }

            @* Right: Group picker, View switcher, View manager *@
            <div class="tm-mvl-toolbar-right">
                @if (ShouldRenderGroupPicker())
                {
                    <div class="tm-mvl-group-picker">
                        <button type="button" id="@_groupPickerId" class="tm-mvl-group-btn" @ref="_groupPickerRef"
                                aria-expanded="@(_groupPickerOpen ? "true" : "false")" aria-haspopup="dialog"
                                @onclick="ToggleGroupPicker">
                            @Loc["TmMvl_GroupBy"]
                        </button>
                        <TmOverlayPanel Anchor="_groupPickerRef"
                                        IsOpen="_groupPickerOpen"
                                        IsOpenChanged="v => _groupPickerOpen = v"
                                        Role="dialog"
                                        Title="@Loc["TmMvl_GroupBy"]"
                                        MobilePresentation="@(Responsive ? PanelPresentation.Auto : PanelPresentation.Popover)"
                                        Class="tm-mvl-group-dropdown">
                            @foreach (var field in GroupableFields)
                            {
                                <label class="tm-mvl-group-option">
                                    <input type="checkbox"
                                           checked="@_activeGroupFields.Contains(field.FieldName)"
                                           @onchange="e => ToggleGroupField(field.FieldName, (bool)e.Value!)" />
                                    @field.Label
                                </label>
                            }
                        </TmOverlayPanel>
                    </div>
                }
                @if (ShouldRenderViewSwitcher())
                {
                    <div class="tm-mvl-switcher" role="radiogroup" aria-label="@Loc["TmMvl_ViewSwitcher"]" @ref="_viewSwitcherRef">
                        <button type="button"
                                class="tm-mvl-switch-table @(Responsive ? "tm-mvl-switch--responsive" : null) @(_viewMode == ListViewMode.Table ? "tm-mvl-switch--active" : "")"
                                role="radio"
                                aria-checked="@(_viewMode == ListViewMode.Table ? "true" : "false")"
                                aria-label="@Loc["TmMvl_TableView"]"
                                tabindex="@(_viewMode == ListViewMode.Table ? "0" : "-1")"
                                @key="@($"table-{_viewMode == ListViewMode.Table}")"
                                @ref="TableViewRef"
                                @onclick="() => SwitchView(ListViewMode.Table)"
                                @onkeydown="OnViewSwitcherKey">
                            <span>&#9783;</span>
                            @if (ViewSwitcherLabels == ViewSwitcherLabels.IconsAndText)
                            {
                                <span>@Loc["TmMvl_TableView"]</span>
                            }
                        </button>
                        <button type="button"
                                class="tm-mvl-switch-card @(Responsive ? "tm-mvl-switch--responsive" : null) @(_viewMode == ListViewMode.Card ? "tm-mvl-switch--active" : "")"
                                role="radio"
                                aria-checked="@(_viewMode == ListViewMode.Card ? "true" : "false")"
                                aria-label="@Loc["TmMvl_CardView"]"
                                tabindex="@(_viewMode == ListViewMode.Card ? "0" : "-1")"
                                @key="@($"card-{_viewMode == ListViewMode.Card}")"
                                @ref="CardViewRef"
                                @onclick="() => SwitchView(ListViewMode.Card)"
                                @onkeydown="OnViewSwitcherKey">
                            <span>&#9645;</span>
                            @if (ViewSwitcherLabels == ViewSwitcherLabels.IconsAndText)
                            {
                                <span>@Loc["TmMvl_CardView"]</span>
                            }
                        </button>
                        <button type="button"
                                class="tm-mvl-switch-list @(Responsive ? "tm-mvl-switch--responsive" : null) @(_viewMode == ListViewMode.List ? "tm-mvl-switch--active" : "")"
                                role="radio"
                                aria-checked="@(_viewMode == ListViewMode.List ? "true" : "false")"
                                aria-label="@Loc["TmMvl_ListView"]"
                                tabindex="@(_viewMode == ListViewMode.List ? "0" : "-1")"
                                @key="@($"list-{_viewMode == ListViewMode.List}")"
                                @ref="ListViewRef"
                                @onclick="() => SwitchView(ListViewMode.List)"
                                @onkeydown="OnViewSwitcherKey">
                            <span>&#9776;</span>
                            @if (ViewSwitcherLabels == ViewSwitcherLabels.IconsAndText)
                            {
                                <span>@Loc["TmMvl_ListView"]</span>
                            }
                        </button>
                    </div>
                }
                @if (ShowItemCount)
                {
                    <span class="tm-mvl-item-count">@Loc["TmMvl_ItemCount", FilteredItems?.Count ?? _totalCount]</span>
                }
                @if (ShouldRenderViewManager())
                {
                    <TmViewManager Provider="ViewProvider"
                                   ViewContext="@ViewContext"
                                   OnViewApplied="ApplyViewAsync"
                                   GetCurrentView="GetCurrentView"
                                   GetCurrentFilters="() => _externalFilters"
                                   AvailableColumns="GetAvailableColumns()"
                                    AvailableGroupableColumns="GetAvailableGroupableColumns()"
                                   FilterDefinitions="ViewFilterDefinitions"
                                   DisplayResolver="DisplayResolver"
                                   CanCreateTenantViews="ViewCanCreateTenantViews"
                                   CurrentUserId="CurrentUserId"
                                   CurrentTenantId="CurrentTenantId" />
                }
            </div>
        </div>
    }

    @* ── External Filter Builder ────────────────────────────── *@
    @if (ShouldRenderExternalFilterBuilder())
    {
        <div class="tm-mvl-external-filters" @key="_activeViewId">
            <TmFilterBuilder FilterDefinitions="ExternalFilterDefinitions"
                             ActiveFilters="_externalFilters"
                             OnFiltersChanged="OnExternalFiltersChanged"
                             DisplayResolver="DisplayResolver"
                             ShowResultPreview="ShowFilterResultPreview"
                             ResultCountProvider="ResultCountProvider"
                             ShowClearAll="true" />
        </div>
    }

    @* ── Content ─────────────────────────────────────────────── *@
    @if (_isLoading)
    {
        <div class="tm-mvl-loading">
            <TmSpinner Size="SpinnerSize.Md" />
        </div>
    }
    else if (!HasItems)
    {
        <TmEmptyState Title="@(!string.IsNullOrEmpty(EmptyTitle) ? EmptyTitle : Loc["Tm_NoResults"])" />
    }
    else
    {
        <div class="@GetMvlScrollContainerClass() @(Responsive && _viewMode == ListViewMode.Table ? "tm-mvl-table-scroll" : null)" style="@GetMvlScrollContainerStyle()">
            @if (_viewMode == ListViewMode.Table)
            {
                <table class="tm-mvl-table">
                    <thead>
                        <tr>
                            @if (AllowSelection)
                            {
                                <th class="tm-mvl-col-select">
                                    <input type="checkbox"
                                           class="tm-mvl-checkbox"
                                           @ref="_selectAllRef"
                                           aria-label="@Loc["TmDataTable_SelectAll"]"
                                           checked="@AreAllVisibleSelected()"
                                           @onchange="_ => ToggleSelectAllAsync()" />
                                </th>
                            }
                            @if (_visibleColumns.Contains(ColumnKeys.Title)) { <th class="@(Responsive ? "tm-mvl-title-column" : null)">@Loc["TmMvl_ColTitle"]</th> }
                            @if (_visibleColumns.Contains(ColumnKeys.SubTitle)) { <th>@Loc["TmMvl_ColSubTitle"]</th> }
                            @if (_visibleColumns.Contains(ColumnKeys.Status)) { <th>@Loc["TmMvl_ColStatus"]</th> }
                            @if (_visibleColumns.Contains(ColumnKeys.Date)) { <th>@Loc["TmMvl_ColDate"]</th> }
                            @if (_visibleColumns.Contains(ColumnKeys.Avatar)) { <th>@Loc["TmMvl_ColAvatar"]</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsGrouped)
                        {
                            @RenderTableGroupRows(_groupedData!, 0)
                        }
                        else if (IsVirtualized)
                        {
                            <Virtualize Items="FilteredItems" Context="item" ItemSize="VirtualItemSize">
                                @RenderTableDataRow(item)
                            </Virtualize>
                        }
                        else
                        {
                            @foreach (var item in FilteredItems!)
                            {
                                @RenderTableDataRow(item)
                            }
                        }
                    </tbody>
                </table>
            }
            else if (_viewMode == ListViewMode.Card)
            {
                @if (IsGrouped)
                {
                    @RenderGroupSections(_groupedData!, 0, "card")
                }
                else if (IsVirtualized)
                {
                    <div class="@CardGridClass" style="@CardGridStyle">
                        <Virtualize Items="FilteredItems" Context="item" ItemSize="VirtualCardHeight">
                            @RenderCardItem(item)
                        </Virtualize>
                    </div>
                }
                else
                {
                    <div class="@CardGridClass" style="@CardGridStyle">
                        @foreach (var item in FilteredItems!)
                        {
                            @RenderCardItem(item)
                        }
                    </div>
                }
            }
            else if (_viewMode == ListViewMode.List)
            {
                @if (IsGrouped)
                {
                    @RenderGroupSections(_groupedData!, 0, "list")
                }
                else if (IsVirtualized)
                {
                    <ul class="tm-mvl-list" role="listbox" aria-label="@Loc["TmMvl_ListOptions"]" aria-multiselectable="@AllowSelection.ToString().ToLowerInvariant()">
                        <Virtualize Items="FilteredItems" Context="item" ItemSize="VirtualListItemHeight">
                            @RenderListItem(item)
                        </Virtualize>
                    </ul>
                }
                else
                {
                    <ul class="tm-mvl-list" role="listbox" aria-label="@Loc["TmMvl_ListOptions"]" aria-multiselectable="@AllowSelection.ToString().ToLowerInvariant()">
                        @foreach (var item in FilteredItems!)
                        {
                            @RenderListItem(item)
                        }
                    </ul>
                }
            }
        </div>
    }

    @* ── Pagination ───────────────────────────────────────────── *@
    @if (ShowPagination && _totalPages > 1 && ScrollMode == DataTableScrollMode.Pagination && !IsGrouped)
    {
        <div class="tm-pagination-container">
            @if (PaginationInfoPlacement == DataTablePaginationInfoPlacement.Summary)
            {
                <div class="tm-pagination-info">
                    @Loc["TmDataTable_ShowingItems", ((_currentPage - 1) * _pageSize) + 1, Math.Min(_currentPage * _pageSize, _totalCount), _totalCount]
                </div>
            }
            <div class="tm-pagination-center">
                <TmPagination CurrentPage="@_currentPage"
                              TotalPages="@_totalPages"
                              TotalCount="@_totalCount"
                              PageSize="@_pageSize"
                              ShowInfo="@(PaginationInfoPlacement == DataTablePaginationInfoPlacement.Pagination)"
                              OnPageChange="GoToPageAsync"
                              OnPageSizeChange="ChangePageSizeAsync" />
            </div>
        </div>
    }
</div>

@code {
    // ── Parameters: data ─────────────────────────────────────────

    /// <summary>Items to display in the list (client-side mode).</summary>
    [Parameter] public IReadOnlyList<TItem>? Items { get; set; }

    /// <summary>Server-side data provider. When set, data is loaded via this provider.</summary>
    [Parameter] public IDataTableDataProvider<TItem>? DataProvider { get; set; }

    /// <summary>When true, shows pagination bar when more than one page. Default: true.</summary>
    [Parameter] public bool ShowPagination { get; set; } = true;

    /// <summary>
    /// Which of the two item-range labels in the paging footer is rendered — the list's own summary or the
    /// one inside the embedded <see cref="TmPagination"/>. Showing both prints the count twice.
    /// Default: <see cref="DataTablePaginationInfoPlacement.Summary"/>.
    /// Per-group mini-pagers are unaffected; they have no sibling summary and always state their own range.
    /// </summary>
    [Parameter] public DataTablePaginationInfoPlacement PaginationInfoPlacement { get; set; }
        = DataTablePaginationInfoPlacement.Summary;

    /// <summary>Default page size for pagination. Default: 25.</summary>
    [Parameter] public int DefaultPageSize { get; set; } = 25;

    // ── Parameters: mapping (quick setup) ────────────────────────

    /// <summary>Maps an item to its display title.</summary>
    [Parameter] public Func<TItem, string>? TitleField { get; set; }

    /// <summary>Maps an item to its secondary text.</summary>
    [Parameter] public Func<TItem, string?>? SubTitleField { get; set; }

    /// <summary>Maps an item to its avatar/thumbnail URL.</summary>
    [Parameter] public Func<TItem, string?>? AvatarUrlField { get; set; }

    /// <summary>Maps an item to its status label text.</summary>
    [Parameter] public Func<TItem, string?>? StatusLabelField { get; set; }

    /// <summary>Maps an item to its status badge CSS color.</summary>
    [Parameter] public Func<TItem, string?>? StatusColorField { get; set; }

    /// <summary>Maps an item to a badge variant when no explicit status color is supplied.</summary>
    [Parameter] public Func<TItem, Tempo.Blazor.Components.DataDisplay.BadgeVariant>? StatusVariantField { get; set; }

    /// <summary>Cell layout in table mode. Inline preserves current markup.</summary>
    [Parameter] public TableCellLayout TableCellLayout { get; set; } = TableCellLayout.Inline;

    /// <summary>Group header content; null preserves the existing group label.</summary>
    [Parameter] public RenderFragment<DataGroup<TItem>>? GroupHeaderTemplate { get; set; }

    /// <summary>Card activation semantics. Defaults to Button.</summary>
    [Parameter] public CardActivation CardActivation { get; set; } = CardActivation.Button;

    /// <summary>
    /// Href of a card when <see cref="CardActivation"/> is <see cref="DataTable.CardActivation.StretchedLink"/>.
    /// A non-empty result renders an anchor; null or empty renders a button that raises
    /// <see cref="OnItemClick"/>. Ignored for <see cref="DataTable.CardActivation.Button"/>.
    /// </summary>
    [Parameter] public Func<TItem, string?>? ItemHref { get; set; }

    /// <summary>Maps an item to its date value.</summary>
    [Parameter] public Func<TItem, DateTimeOffset?>? DateField { get; set; }

    /// <summary>Maps an item to its unique identifier.</summary>
    [Parameter] public Func<TItem, string>? IdField { get; set; }

    // ── Parameters: template overrides ───────────────────────────

    /// <summary>Custom card template. When set, overrides default card rendering.</summary>
    [Parameter] public RenderFragment<TItem>? CardTemplate { get; set; }

    /// <summary>Custom list item template. When set, overrides default list rendering.</summary>
    [Parameter] public RenderFragment<TItem>? ListItemTemplate { get; set; }

    /// <summary>Custom table row template. When set, overrides default table row rendering.</summary>
    [Parameter] public RenderFragment<TItem>? TableRowTemplate { get; set; }

    // ── Parameters: grouping ─────────────────────────────────────

    /// <summary>Fields available for grouping in the dropdown picker.</summary>
    [Parameter] public IReadOnlyList<GroupFieldDefinition<TItem>>? GroupableFields { get; set; }

    /// <summary>Whether groups are collapsed by default.</summary>
    [Parameter] public bool GroupsCollapsedByDefault { get; set; } = true;

    /// <summary>Fires when grouping configuration changes.</summary>
    [Parameter] public EventCallback<IReadOnlyList<string>> OnGroupingChanged { get; set; }

    // ── Parameters: virtualization ────────────────────────────────

    /// <summary>Scroll mode: Pagination (default) or Virtualized.</summary>
    [Parameter] public DataTableScrollMode ScrollMode { get; set; } = DataTableScrollMode.Pagination;

    /// <summary>Height of the virtual scroll container. Default: "600px".</summary>
    [Parameter] public string? VirtualScrollHeight { get; set; }

    /// <summary>Estimated item height for table row virtualization.</summary>
    [Parameter] public float VirtualItemSize { get; set; } = 48f;

    /// <summary>Estimated card height for card view virtualization.</summary>
    [Parameter] public float VirtualCardHeight { get; set; } = 180f;

    /// <summary>
    /// Maximum number of card columns. Null (default) keeps auto-fill with the minimum card width.
    /// Values below 1 are ignored.
    /// </summary>
    [Parameter] public int? MaxCardColumns { get; set; }

    private bool HasCardColumnCap => MaxCardColumns is >= 1;

    private string RootCssClass => string.Join(" ", new[]
    {
        "tm-multi-view-list",
        Responsive ? "tm-multi-view-list--responsive" : null,
        Appearance == DataTableAppearance.Plain ? "tm-multi-view-list--plain" : null,
        Class,
    }.Where(part => !string.IsNullOrEmpty(part)));

    private string CardGridClass => string.Join(" ", new[]
    {
        "tm-mvl-card-grid",
        IsVirtualized ? "tm-mvl-card-grid--virtualized" : null,
        HasCardColumnCap ? "tm-mvl-card-grid--capped" : null,
    }.Where(part => part is not null));

    private string? CardGridStyle => HasCardColumnCap
        ? $"--tm-mvl-card-columns-max: {MaxCardColumns!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)};"
        : null;

    /// <summary>Estimated list item height for list view virtualization.</summary>
    [Parameter] public float VirtualListItemHeight { get; set; } = 56f;

    // ── Parameters: display ──────────────────────────────────────

    /// <summary>When true, allows horizontal scrolling for the table view. Defaults to false.</summary>
    [Parameter] public bool Responsive { get; set; }

    /// <summary>Surface appearance. Defaults to Card to preserve the current framed look.</summary>
    [Parameter] public DataTableAppearance Appearance { get; set; } = DataTableAppearance.Card;

    /// <summary>Current display mode (Table/Card/List). Two-way bindable.</summary>
    [Parameter] public ListViewMode ViewMode { get; set; } = ListViewMode.Table;

    /// <summary>Fires when the user switches the view mode.</summary>
    [Parameter] public EventCallback<ListViewMode> ViewModeChanged { get; set; }

    /// <summary>Fires when an item row/card is clicked.</summary>
    [Parameter] public EventCallback<TItem> OnItemClick { get; set; }

    /// <summary>When true, shows the view-mode switcher buttons above the list.</summary>
    [Parameter] public bool ShowViewSwitcher { get; set; } = true;

    /// <summary>When true, shows the item count in the toolbar. Defaults to false.</summary>
    [Parameter] public bool ShowItemCount { get; set; }

    /// <summary>When true, shows the global search input.</summary>
    [Parameter] public bool ShowSearch { get; set; } = true;

    /// <summary>Controlled search text. When set, the component uses this value instead of its internal state.</summary>
    [Parameter] public string? SearchText { get; set; }

    /// <summary>Fires when the search text changes.</summary>
    [Parameter] public EventCallback<string> SearchTextChanged { get; set; }

    /// <summary>
    /// When true, renders the toolbar container with search, view switcher, group picker, and view manager. Default: true.
    /// The toolbar is not rendered when no visible control would be shown (see <see cref="ToolbarMode"/>).
    /// For a page-owned filter surface, set <see cref="ToolbarMode"/> to <see cref="DataToolbarMode.ContentOnly"/>
    /// and supply filtered data via <see cref="Items"/> or <see cref="DataProvider"/>.
    /// </summary>
    [Parameter] public bool ShowToolbar { get; set; } = true;

    /// <summary>
    /// High-level preset that controls which toolbar chrome elements are rendered.
    /// <list type="bullet">
    ///   <item><see cref="DataToolbarMode.Full"/> — respects the individual <c>Show*</c> booleans.</item>
    ///   <item><see cref="DataToolbarMode.SearchOnly"/> — renders only the global search input.</item>
    ///   <item><see cref="DataToolbarMode.ActionsOnly"/> — renders only the view switcher, group picker, and view manager.</item>
    ///   <item><see cref="DataToolbarMode.ContentOnly"/> — hides all toolbar chrome and the external filter builder; use when the owning page provides its own filters.</item>
    /// </list>
    /// Default is <see cref="DataToolbarMode.Full"/>. Modes other than Full override the <c>Show*</c> booleans for the elements they affect.
    /// </summary>
    [Parameter] public DataToolbarMode ToolbarMode { get; set; } = DataToolbarMode.Full;

    /// <summary>
    /// When true and a <see cref="ViewProvider"/> is set, renders the TmViewManager. Default: true.
    /// </summary>
    [Parameter] public bool ShowViewManager { get; set; } = true;

    /// <summary>Title for the empty state when Items is empty.</summary>
    [Parameter] public string? EmptyTitle { get; set; }

    /// <summary>Additional CSS class for the root element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Additional HTML attributes to apply to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // ── Parameters: selection ────────────────────────────────────

    /// <summary>
    /// View switcher labels. <see cref="ViewSwitcherLabels.IconsOnly"/> (default) keeps today's buttons.
    /// <see cref="ViewSwitcherLabels.IconsAndText"/> adds the localized names.
    /// </summary>
    [Parameter] public ViewSwitcherLabels ViewSwitcherLabels { get; set; } = ViewSwitcherLabels.IconsOnly;

    /// <summary>Fallback for missing avatar URLs in cards. Defaults to None.</summary>
    [Parameter] public AvatarFallback AvatarFallback { get; set; } = AvatarFallback.None;

    /// <summary>When true, shows checkboxes and enables multi-select mode.</summary>
    [Parameter] public bool AllowSelection { get; set; }

    /// <summary>Currently selected item IDs. Two-way bindable.</summary>
    [Parameter] public HashSet<string>? SelectedIds { get; set; }

    /// <summary>Fires when the selection changes.</summary>
    [Parameter] public EventCallback<HashSet<string>> SelectedIdsChanged { get; set; }

    /// <summary>
    /// Maps an item to its selection ID. Falls back to <see cref="IdField"/>,
    /// then to <see cref="IMultiViewListItem.Id"/>.
    /// </summary>
    [Parameter] public Func<TItem, string>? SelectionIdField { get; set; }

    // ── Parameters: drag source ──────────────────────────────────

    /// <summary>
    /// When true, items can be dragged. Works best together with <see cref="AllowSelection"/>:
    /// dragging a selected item drags all selected items; dragging an unselected item drags
    /// only that one item.
    /// </summary>
    [Parameter] public bool AllowDrag { get; set; }

    /// <summary>Fires when a drag operation starts. Receives the items being dragged.</summary>
    [Parameter] public EventCallback<IReadOnlyList<TItem>> OnDragStart { get; set; }

    // ── View Manager Parameters ───────────────────────────────────

    /// <summary>
    /// Unique identifier for this list instance.
    /// Used to scope saved views to specific lists (e.g., "team-members", "projects").
    /// </summary>
    [Parameter, EditorRequired] public string ViewContext { get; set; } = default!;

    /// <summary>
    /// Optional view persistence provider. When set, enables saved views and (by default) the external filter builder.
    /// Use <see cref="ShowExternalFilterBuilder"/> = false to keep saved views without rendering the inline filter builder,
    /// or <see cref="ToolbarMode"/> = <see cref="DataToolbarMode.ContentOnly"/> when the page owns the filtering UI.
    /// </summary>
    [Parameter] public IDataTableViewProvider? ViewProvider { get; set; }

    /// <summary>Filter definitions used by the view manager filter builder when creating or editing saved views.</summary>
    [Parameter] public List<FilterDefinition> ViewFilterDefinitions { get; set; } = [];

    /// <summary>
    /// When true and a <see cref="ViewProvider"/> is set, shows the inline FilterBuilder for external filtering. Default: true.
    /// Set to false when the surrounding page owns the filtering UI to avoid duplicate filters.
    /// </summary>
    [Parameter] public bool ShowExternalFilterBuilder { get; set; } = true;

    /// <summary>
    /// Filter definitions for the inline external filter builder (shown above the list when <see cref="ViewProvider"/> is set).
    /// When the page owns filtering, leave this empty and set <see cref="ShowExternalFilterBuilder"/> to false
    /// or use <see cref="ToolbarMode"/> = <see cref="DataToolbarMode.ContentOnly"/>.
    /// </summary>
    [Parameter] public List<FilterDefinition> ExternalFilterDefinitions { get; set; } = [];

    /// <summary>
    /// When true, the inline filter builder shows how many records match the current filters.
    /// A <see cref="DataProvider"/> is asked with <see cref="DataTableQuery.PageSize"/> of 1 and the
    /// preview reads <see cref="PagedResult{T}.TotalCount"/>; without one the in-memory items are counted
    /// with the same rules as the list. Default: false.
    /// </summary>
    [Parameter] public bool ShowFilterResultPreview { get; set; }

    /// <summary>The count source handed to the inline filter builder, or null when the preview is off.</summary>
    private Func<IReadOnlyList<ActiveFilter>, CancellationToken, Task<int?>>? ResultCountProvider =>
        ShowFilterResultPreview && ShouldRenderExternalFilterBuilder() ? _countDelegate : null;

    private readonly MultiViewListResultCountProvider _resultCountProvider = new();

    // One delegate for the lifetime of the list. A method group would be a new instance on every
    // render, and the builder would treat that as a new provider and count again.
    private readonly Func<IReadOnlyList<ActiveFilter>, CancellationToken, Task<int?>> _countDelegate;

    /// <summary>Initializes the stable count delegate the inline filter builder receives.</summary>
    public TmMultiViewList()
    {
        _countDelegate = _resultCountProvider.CountAsync;
    }

    /// <summary>
    /// Universal display resolver for field labels and filter values.
    /// <list type="bullet">
    ///   <item><c>DisplayResolver(fieldName, null)</c> → localized field/column label (e.g., "Status" → "Stav")</item>
    ///   <item><c>DisplayResolver(fieldName, rawValue)</c> → localized value (e.g., ("Status","Active") → "Aktivní")</item>
    /// </list>
    /// Return null to use defaults (FilterDefinition.FieldLabel, column Title, or raw value).
    /// Set once on the component — flows to ViewManager, FilterBuilder, and ColumnPicker.
    /// </summary>
    [Parameter] public Func<string, string?, string?>? DisplayResolver { get; set; }

    /// <summary>Whether the user can create tenant-wide views.</summary>
    [Parameter] public bool ViewCanCreateTenantViews { get; set; }

    /// <summary>Current user ID for personal view scoping.</summary>
    [Parameter] public string? CurrentUserId { get; set; }

