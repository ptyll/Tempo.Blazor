@namespace Tempo.Blazor.Components.Forms
@using Microsoft.AspNetCore.Components.Forms
@using System.Linq.Expressions
@using Tempo.Blazor.Components.Inputs
@implements IDisposable

<div class="tm-validated-field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="tm-input-label" for="@Id">
            @Label
            @if (Required)
            {
                <span class="tm-input-label-required"></span>
            }
        </label>
    }
    
    <TmTextInput
        Id="@Id"
        Value="@Value"
        ValueChanged="@ValueChanged"
        Placeholder="@Placeholder"
        Type="@Type"
        Required="@Required"
        Error="@ErrorMessage"
        ShowValidationIcons="true"
        IsValid="@IsValid"
        LeftIcon="@LeftIcon"
        RightIcon="@RightIcon"
        Disabled="@Disabled"
        ReadOnly="@ReadOnly"
        TabIndex="@TabIndex"
        AutoFocus="@AutoFocus"
        AutoComplete="@AutoComplete"
        Class="@Class"
        AdditionalAttributes="@AdditionalAttributes"
        OnKeyDown="@OnKeyDown"
        OnKeyUp="@OnKeyUp"
        OnKeyPress="@OnKeyPress"
        OnFocus="@OnFocus"
        OnBlur="@OnBlur" />
    
    @if (!string.IsNullOrEmpty(HelpText) && string.IsNullOrEmpty(ErrorMessage))
    {
        <p class="tm-input-help-text">@HelpText</p>
    }
</div>

@code {
    [CascadingParameter] private EditContext? EditContext { get; set; }
    
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? HelpText { get; set; }
    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString("n")[..8];
    [Parameter] public string? LeftIcon { get; set; }
    [Parameter] public string? RightIcon { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public int TabIndex { get; set; }
    [Parameter] public bool AutoFocus { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? AutoComplete { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyUp { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyPress { get; set; }
    [Parameter] public EventCallback<FocusEventArgs> OnFocus { get; set; }
    [Parameter] public EventCallback<FocusEventArgs> OnBlur { get; set; }

    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    // This is automatically set by @bind-Value
    [Parameter] public Expression<Func<string>>? ValueExpression { get; set; }
    
    private FieldIdentifier? _fieldIdentifier;
    private Expression<Func<string>>? _seenValueExpression;
    
    private FieldIdentifier FieldIdentifier 
    { 
        get 
        {
            if (_fieldIdentifier == null && ValueExpression != null)
            {
                _fieldIdentifier = FieldIdentifier.Create(ValueExpression);
            }
            return _fieldIdentifier ?? new FieldIdentifier(this, nameof(Value));
        }
    }
    
    private string? ErrorMessage 
    { 
        get 
        {
            if (EditContext == null) return null;
            var messages = EditContext.GetValidationMessages(FieldIdentifier);
            return messages.FirstOrDefault();
        }
    }
    
    // N320: "_validationRan" was context-global — a pass triggered by editing ANY field painted
    // this field valid. The state must be field-scoped: "_fieldValidationRequested" marks that a
    // pass including THIS field was kicked off (its own OnFieldChanged, or a whole-form
    // OnValidationRequested), and "_fieldValidated" that such a pass COMPLETED — set in
    // OnValidationStateChanged, which a real validator raises only after producing messages
    // (incl. async passes, so no green→red flicker while a request is in flight, N151).
    private bool _fieldValidationRequested;
    private bool _fieldValidated;

    // "Valid" means the field PASSED validation, not that it contains text: the green frame and
    // check icon must not appear on a field nobody validated (application gap register #10). We
    // therefore report true only once a validation pass that covered THIS field completed and
    // the field has no messages. Without an EditContext there is no validation at all, so the
    // field stays neutral.
    private bool? IsValid
    {
        get
        {
            if (EditContext == null)
            {
                return null;
            }

            if (EditContext.GetValidationMessages(FieldIdentifier).Any())
            {
                return false;
            }

            return _fieldValidated ? true : null;
        }
    }

    private EditContext? _subscribedEditContext;

    protected override void OnParametersSet()
    {
        // N152: the host EditForm may cascade a NEW EditContext when its Model instance changes —
        // re-subscribe to the current context and drop the delegate on the discarded one.
        if (!ReferenceEquals(EditContext, _subscribedEditContext))
        {
            if (_subscribedEditContext is not null)
            {
                _subscribedEditContext.OnFieldChanged -= HandleFieldChanged;
                _subscribedEditContext.OnValidationRequested -= HandleValidationRequested;
                _subscribedEditContext.OnValidationStateChanged -= HandleValidationStateChanged;
            }

            _subscribedEditContext = EditContext;

            if (_subscribedEditContext is not null)
            {
                _subscribedEditContext.OnFieldChanged += HandleFieldChanged;
                _subscribedEditContext.OnValidationRequested += HandleValidationRequested;
                _subscribedEditContext.OnValidationStateChanged += HandleValidationStateChanged;
            }

            // 20D carry-forward: the flags measured a pass on the DISCARDED context — carrying
            // them over would paint tm-input-valid on a context that never validated
            // (N151 reversed).
            _fieldValidationRequested = false;
            _fieldValidated = false;
        }

        // The cached FieldIdentifier captures the model instance inside ValueExpression; when the
        // expression (and its captured model) changes, the identifier must be rebuilt or messages
        // stored under the NEW model would never be found.
        if (!ReferenceEquals(ValueExpression, _seenValueExpression))
        {
            _seenValueExpression = ValueExpression;
            _fieldIdentifier = null;
        }
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (e.FieldIdentifier.Equals(FieldIdentifier))
        {
            _fieldValidationRequested = true;
        }
    }

    // A whole-form request covers every field, touched or not — submit must paint untouched
    // fields too.
    private void HandleValidationRequested(object? sender, ValidationRequestedEventArgs e)
        => _fieldValidationRequested = true;

    private void HandleValidationStateChanged(object? sender, ValidationStateChangedEventArgs e)
    {
        // The notification only completes a pass that included this field; a pass triggered by
        // another field leaves it untouched (N320).
        if (_fieldValidationRequested)
        {
            _fieldValidated = true;
        }

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (_subscribedEditContext is not null)
        {
            _subscribedEditContext.OnFieldChanged -= HandleFieldChanged;
            _subscribedEditContext.OnValidationRequested -= HandleValidationRequested;
            _subscribedEditContext.OnValidationStateChanged -= HandleValidationStateChanged;
        }
    }
}
