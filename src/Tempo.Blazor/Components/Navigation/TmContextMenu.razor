@namespace Tempo.Blazor.Components.Navigation
@using Tempo.Blazor.Components.Overlay
@using Tempo.Blazor.Helpers
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div @ref="_wrapperRef" class="tm-context-menu-wrapper @Class" @attributes="AdditionalAttributes">
    @if (!AsChild)
    {
        <div class="tm-context-menu__trigger"
             @ref="_triggerRef"
             role="button"
             tabindex="@TriggerTabIndexText"
             aria-haspopup="menu"
             aria-expanded="@BoolText(_isOpen)"
             aria-label="@TriggerAriaLabel"
             @onclick="ToggleMenu"
             @onkeydown="HandleTriggerKeyDown"
             @onkeyup="HandleTriggerKeyUp">
            @* Fence: the Trigger fragment may contain a native control (e.g. a <button>)
               whose Enter keydown / Space keyup would otherwise bubble into this emulating
               container and fire ToggleMenu on top of the child's own click. Both barriers
               are required — Space activation lives on keyup (N162), so a keydown-only fence
               would still leak the release (keyboard-activation-convention; TmPopover is the
               reference implementation). *@
            <span class="tm-context-menu__trigger-content"
                  @onkeydown:stopPropagation="true"
                  @onkeyup:stopPropagation="true">@Trigger</span>
        </div>
    }
    else
    {
        @* AsChild: the wrapper is presentational and carries NO role, NO tab stop and NO
           handlers — the host's own trigger element (usually a <button> inside @Trigger) gets
           aria-haspopup/aria-expanded and the activation from the cascaded
           ContextMenuTriggerContext. This removes the nested-interactive-element defect the
           emulating div produced whenever the trigger fragment held a real control. *@
        <CascadingValue Value="TriggerContext" IsFixed="false">
            @Trigger
        </CascadingValue>
    }

    @* The menu is a TmOverlayPanel: popover="manual" puts it in the browser top layer, so an
       ancestor's overflow (modal body, scrolling region) can no longer clip it, and overlay.js
       repositions it on scroll/resize, flipping when the space below runs out. Bottom + End +
       4px keep the historical "under the trigger, right edge aligned" look. F11: the menu opts
       into the shared bottom sheet on a mobile viewport through MobilePresentation (default
       Popover keeps the anchored popover at every width); the sheet header is titled with
       SheetTitle or the localized TmContextMenu_SheetTitle default. *@
    <TmOverlayPanel Anchor="AnchorRef"
                    IsOpen="_isOpen"
                    IsOpenChanged="SetOpenAsync"
                    OnOpened="FocusFirstItemAsync"
                    Placement="OverlayPlacement.Bottom"
                    Align="OverlayAlign.End"
                    Offset="4"
                    Role="menu"
                    Title="@EffectiveSheetTitle"
                    MobilePresentation="MobilePresentation"
                    Class="tm-context-menu">
        <CascadingValue Value="this" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </TmOverlayPanel>
</div>

@code {
    private bool _isOpen;
    private ElementReference _triggerRef;
    private ElementReference _wrapperRef;
    private MenuNavInterop? _menuNav;
    private bool _disposed;
    private bool _focusTriggerAfterClose;

    /// <summary>
    /// Applies the open state, then raises <see cref="IsOpenChanged"/>. The callback runs after the
    /// state has changed, and it is awaited, so a host that drops the menu on close cannot race a
    /// render that still sees it open. Toggle, <see cref="Open"/>, <see cref="CloseMenu"/> and the
    /// overlay's own dismiss all come through here.
    /// </summary>
    private Task SetOpenAsync(bool open)
    {
        if (_isOpen == open)
        {
            return Task.CompletedTask;
        }

        _isOpen = open;
        return IsOpenChanged.InvokeAsync(open);
    }

    /// <summary>The trigger element that opens the menu.</summary>
    [Parameter] public RenderFragment? Trigger { get; set; }

    /// <summary>Menu item children (TmContextMenuItem).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// How the menu presents on a narrow viewport. Default
    /// <see cref="PanelPresentation.Popover"/>: the anchored popover at every width.
    /// <see cref="PanelPresentation.Auto"/> opts into the shared bottom sheet on a mobile
    /// viewport (the anchored popover otherwise) — the choice resolves from the viewport scope.
    /// A forced value renders that presentation without measuring.
    /// </summary>
    [Parameter] public PanelPresentation MobilePresentation { get; set; } = PanelPresentation.Popover;

    /// <summary>
    /// Title of the sheet header when the menu presents as a bottom sheet. When
    /// <see langword="null"/> (default), the localized <c>TmContextMenu_SheetTitle</c> default
    /// is used. The value also names the popover (<c>aria-label</c>) — the menu carries no other
    /// accessible name, so a <c>role="menu"</c> popover is not unnamed.
    /// </summary>
    [Parameter] public string? SheetTitle { get; set; }

    /// <summary>
    /// Raised when the menu opens or closes, including a close that came from the overlay
    /// (Escape, outside click) rather than from an item. A host that mounts the menu only while
    /// it is open uses this to drop that mount, so a later render cannot reopen it.
    /// </summary>
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>
    /// Tab index of the trigger. Defaults to <c>0</c>: the trigger is the menu's own tab stop.
    /// <c>-1</c> takes the trigger out of the tab order while keeping it pointer-activatable — what a
    /// host needs when the trigger sits INSIDE another focusable element that already owns the tab
    /// stop (a Kanban card owns one roving stop per cell and opens this menu with M / Alt+ArrowDown,
    /// so a second stop would double the cell's tab stops). <see langword="null"/> omits the attribute
    /// entirely.
    /// </summary>
    [Parameter] public int? TriggerTabIndex { get; set; } = 0;

    /// <summary>
    /// Accessible name of the emulating trigger. <c>null</c> (default) keeps the trigger unnamed —
    /// use it when the trigger fragment itself carries a visible or accessible label; a nameless
    /// <c>role="button"</c> div with an icon-only fragment is unnamed to a reader.
    /// IGNORED in AsChild mode — the host's own trigger element carries its own name.
    /// </summary>
    [Parameter] public string? TriggerAriaLabel { get; set; }

    /// <summary>
    /// Renders NO emulating trigger at all: the wrapper becomes presentational and the host's own
    /// trigger element inside the <see cref="Trigger"/> fragment receives the menu-button semantics
    /// from the cascaded <see cref="ContextMenuTriggerContext"/> (<c>aria-haspopup</c>,
    /// <c>aria-expanded</c> via <see cref="ContextMenuTriggerContext.IsOpen"/>, activation via
    /// <see cref="ContextMenuTriggerContext.ToggleAsync"/>). Use it whenever the trigger fragment
    /// holds a real interactive control — a div[role=button] wrapped around a button is a nested
    /// interactive element. The keyboard emulation (Enter keydown / Space keyup) stays the host
    /// button's native contract; the wrapper keeps the anchor the popover positions against, and
    /// after an item activation focus returns to the host's own trigger element.
    /// </summary>
    [Parameter] public bool AsChild { get; set; }

    /// <summary>Additional CSS class for the root element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Additional HTML attributes.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // SheetTitle=null falls back to the localized per-component default; the value also names
    // the popover (TmOverlayPanel emits Title as its aria-label when nothing else names it).
    private string EffectiveSheetTitle => string.IsNullOrEmpty(SheetTitle) ? Loc["TmContextMenu_SheetTitle"] : SheetTitle!;

    private void ToggleMenu() => _ = InvokeAsync(async () =>
    {
        await SetOpenAsync(!_isOpen);
        StateHasChanged();
    });

    /// <summary>Whether the menu is currently open. In AsChild mode the host's trigger reads this for <c>aria-expanded</c>.</summary>
    public bool IsOpen => _isOpen;

    /// <summary>The element the popover positions against: the built-in trigger, or in AsChild mode the
    /// wrapper (the built-in trigger is not rendered there and the host's own element lives in the wrapper).</summary>
    private ElementReference AnchorRef => AsChild ? _wrapperRef : _triggerRef;

    /// <summary>
    /// The public toggle for the AsChild trigger contract: the host's own button calls this from
    /// its click handler and binds <see cref="IsOpen"/> to <c>aria-expanded</c>. Same state path
    /// as the built-in trigger (<see cref="SetOpenAsync"/>, so <see cref="IsOpenChanged"/> fires).
    /// </summary>
    public Task ToggleAsync() => InvokeAsync(async () =>
    {
        await SetOpenAsync(!_isOpen);
        StateHasChanged();
    });

    /// <summary>The AsChild context handed to the host through a CascadingValue. Cached: a new
    /// instance per render (with <c>IsFixed="false"</c>) would re-render every consumer on every
    /// menu render. Safe because <see cref="ContextMenuTriggerContext.IsOpen"/> reads the live
    /// state and the menu's own re-render repaints the fragment when <c>_isOpen</c> changes.</summary>
    private ContextMenuTriggerContext? _triggerContext;
    private ContextMenuTriggerContext TriggerContext => _triggerContext ??= new(this);

    /// <summary>
    /// Opens the menu. A host that owns a pointer position uses this after it has decided which
    /// actions apply. The open is applied on the renderer, and <see cref="IsOpenChanged"/> is
    /// awaited before the menu paints, so the callback always observes the new state.
    /// </summary>
    public void Open() => _ = InvokeAsync(OpenAsync);

    /// <summary>
    /// The trigger-context open path: the same <see cref="OpenAsync"/> state transition, but the
    /// <c>_isOpen</c> test runs INSIDE <see cref="InvokeAsync"/>, so a host calling
    /// <see cref="ContextMenuTriggerContext.OpenAsync"/> from outside the dispatcher cannot race
    /// the state read. Internal: the context class is the only caller.
    /// </summary>
    internal Task OpenFromTriggerAsync() => InvokeAsync(OpenAsync);

    private async Task OpenAsync()
    {
        if (_isOpen)
        {
            return;
        }

        await SetOpenAsync(true);
        StateHasChanged();
    }

    internal void CloseMenu() => _ = InvokeAsync(CloseMenuAsync);

    /// <summary>
    /// Closes the menu and AWAITS the full state transition (including <see cref="IsOpenChanged"/>).
    /// Internal because <see cref="TmContextMenuItem"/> awaits it before its own handler — the
    /// deterministic close (2.12.0): the menu is down and re-rendered before the item's
    /// <c>OnClick</c> runs, with no <c>Task.Yield</c> race in between.
    /// </summary>
    internal Task CloseMenuAsync() => InvokeAsync(CloseMenuCoreAsync);

    private async Task CloseMenuCoreAsync()
    {
        if (!_isOpen)
        {
            return;
        }

        await SetOpenAsync(false);
        // docs/overlays.md rule 4: an item activation closes without overlay.js's focus restore - return focus
        // to the trigger (the TmDropdown.SelectItemAsync pattern), or a keyboard activation leaves focus on <body>.
        // In AsChild mode the trigger is the HOST's own element (the wrapper keeps the anchor), so the hand-back
        // focuses the first focusable descendant of the wrapper that is not inside the menu panel.
        _focusTriggerAfterClose = true;
        StateHasChanged();
    }

    /// <summary>A keyboard-opened menu hands focus to its first enabled item (shared owner: MenuNavInterop).</summary>
    private Task FocusFirstItemAsync() => _disposed ? Task.CompletedTask : (_menuNav ??= new MenuNavInterop(JS)).FocusFirstAsync(_wrapperRef);

    /// <summary>
    /// Moves focus to the menu trigger — in AsChild mode to the HOST's own trigger element (the first
    /// focusable descendant of the wrapper that is not inside the menu panel, via tm-menu-nav's
    /// <c>focusHostTrigger</c>). Safe to call after an action replaced or removed the
    /// row the trigger lives on — a trigger that left the DOM is a no-op, not an exception.
    /// Hosts use it where the built-in close-focus-restore cannot run, e.g. the diagram layers
    /// panel focusing the moved row's "⋯" trigger after a menu-driven reorder.
    /// </summary>
    public async ValueTask FocusTriggerAsync()
    {
        if (_disposed) return;
        try
        {
            if (AsChild)
            {
                await (_menuNav ??= new MenuNavInterop(JS)).FocusHostTriggerAsync(_wrapperRef);
            }
            else
            {
                await _triggerRef.FocusAsync(preventScroll: true);
            }
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException)
        {
            // The trigger left the DOM with the close (a conditional host): nothing to focus.
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusTriggerAfterClose) return;
        _focusTriggerAfterClose = false;
        await FocusTriggerAsync();
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        var menuNav = _menuNav;
        _menuNav = null;
        if (menuNav is not null) await menuNav.DisposeAsync();
    }

    // No wrapper-level Escape handler: overlay.js consumes Escape in the window capture phase
    // (CloseOnEscape is always true) and routes it through NotifyDismissedAsync — a bubbling
    // handler on this div could never run in a real browser (N169).

    // Keyboard emulation is REQUIRED here (unlike on TmButton): the trigger is a div[role=button],
    // not a native <button>, so the browser never produces a click for Enter/Space on its own.
    // Enter fires on KEYDOWN (native buttons do the same, including auto-repeat while held — the
    // e.Repeat guard keeps a held key from re-toggling on every repeat event) — Space fires on
    // KEYUP ONLY, matching the native <button> contract exactly
    // (docs/keyboard-activation-convention.md). Splitting them this way also kills the held-Space
    // double-toggle: a keydown auto-repeat burst never reaches the keyup handler, only the single
    // release does (N162).
    private void HandleTriggerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.Repeat)
        {
            ToggleMenu();
        }
    }

    private void HandleTriggerKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == " ")
        {
            ToggleMenu();
        }
    }

    private static string BoolText(bool value) => value ? "true" : "false";

    // The attribute is a raw number (or absent), never a culture-formatted value.
    private string? TriggerTabIndexText
        => TriggerTabIndex?.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
