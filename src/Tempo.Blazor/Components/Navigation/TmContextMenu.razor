@namespace Tempo.Blazor.Components.Navigation
@using Tempo.Blazor.Components.Overlay

<div class="tm-context-menu-wrapper @Class" @attributes="AdditionalAttributes">
    <div class="tm-context-menu__trigger"
         @ref="_triggerRef"
         role="button"
         tabindex="0"
         aria-haspopup="menu"
         aria-expanded="@BoolText(_isOpen)"
         @onclick="ToggleMenu"
         @onkeydown="HandleTriggerKeyDown">
        @Trigger
    </div>

    @* The menu is a TmOverlayPanel: popover="manual" puts it in the browser top layer, so an
       ancestor's overflow (modal body, scrolling region) can no longer clip it, and overlay.js
       repositions it on scroll/resize, flipping when the space below runs out. Bottom + End +
       4px keep the historical "under the trigger, right edge aligned" look. *@
    <TmOverlayPanel Anchor="_triggerRef"
                    IsOpen="_isOpen"
                    IsOpenChanged="SetOpen"
                    Placement="OverlayPlacement.Bottom"
                    Align="OverlayAlign.End"
                    Offset="4"
                    Role="menu"
                    Class="tm-context-menu">
        <CascadingValue Value="this" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </TmOverlayPanel>
</div>

@code {
    private bool _isOpen;
    private ElementReference _triggerRef;

    private void SetOpen(bool open)
    {
        _isOpen = open;
    }

    /// <summary>The trigger element that opens the menu.</summary>
    [Parameter] public RenderFragment? Trigger { get; set; }

    /// <summary>Menu item children (TmContextMenuItem).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Additional CSS class for the root element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Additional HTML attributes.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private void ToggleMenu()
    {
        _isOpen = !_isOpen;
    }

    internal void CloseMenu()
    {
        _isOpen = false;
        StateHasChanged();
    }

    // No wrapper-level Escape handler: overlay.js consumes Escape in the window capture phase
    // (CloseOnEscape is always true) and routes it through NotifyDismissedAsync — a bubbling
    // handler on this div could never run in a real browser (N169).

    // Keyboard emulation is REQUIRED here (unlike on TmButton): the trigger is
    // a div[role=button], not a native <button>, so the browser never produces
    // a click for Enter/Space on its own.
    private void HandleTriggerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
        {
            ToggleMenu();
        }
    }

    private static string BoolText(bool value) => value ? "true" : "false";
}
