@namespace Tempo.Blazor.Components.Navigation
@using Tempo.Blazor.Components.Icons

<div class="tm-tabs @VariantClass @Class" @attributes="AdditionalAttributes">
    @HeaderContent

    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>

    @{
        var activePanel = _panels.FirstOrDefault(p => p.Id == ActiveTabId);
    }
    @if (activePanel?.ChildContent is not null)
    {
        <div class="tm-tabs__panel"
             role="tabpanel"
             id="@($"tabpanel-{activePanel.Id}")"
             aria-labelledby="@($"tab-{activePanel.Id}")"
             tabindex="0">
            @activePanel.ChildContent
        </div>
    }
</div>

@code {
    private readonly List<TmTabPanel> _panels = [];

    /// <summary>
    /// Live element handles of the tab buttons, keyed by panel id. They exist for ONE reason: the
    /// roving tabindex is only half a roving tabindex without them. Moving <c>aria-selected</c> and
    /// the <c>tabindex</c> 0/-1 pair leaves the real DOM focus sitting on the tab the user just left
    /// — which now carries <c>tabindex="-1"</c> — so a screen reader announces nothing, the focus
    /// ring stays behind, and the next Tab keypress leaves from the wrong place.
    /// </summary>
    private readonly Dictionary<string, ElementReference> _tabElements = [];

    /// <summary>
    /// Set by EITHER path that changes the selection — a navigation key or a click — to claim a
    /// focus move for the render that follows it. It records only THAT one was asked for, never
    /// WHICH tab asked: the target is read back off <see cref="ActiveTabId"/> after the render, so
    /// focus follows the CONFIRMED selection. Both paths claim it because the invariant it exists
    /// to hold — the focused tab IS the selected tab — is not about the keyboard; a click whose
    /// change is refused leaves the browser's native focus on the refused tab just as squarely.
    /// <para>
    /// Focusing the requested tab directly would re-introduce the very divergence this component
    /// was fixed for, only mirrored: a consumer that ignores or vetoes
    /// <see cref="ActiveTabIdChanged"/> would get the focus ring on a tab that is not
    /// <c>aria-selected</c> and carries <c>tabindex="-1"</c>. Resolved this way, a veto degrades to
    /// re-focusing the tab that is still selected — which is where the focus already was, so it
    /// costs nothing and the invariant "the focused tab IS the selected tab" holds on both paths.
    /// </para>
    /// <para>
    /// BOUND: the claim is resolved on the FIRST render after the interaction and not carried
    /// further. A consumer that resolves the change asynchronously past that render still gets a
    /// focus move — but resolved against the selection as it stood then, i.e. onto the tab that is
    /// still selected, which is a no-op rather than "nothing happens". When its update finally
    /// arrives, the selection moves and the focus does not follow. Holding the claim open instead
    /// would let the strip steal focus an arbitrary number of renders later, no longer attributable
    /// to the interaction that asked for it. A gap, not a regression: before this, no arrow key
    /// moved focus at all.
    /// </para>
    /// </summary>
    private bool _focusSelectedTabAfterRender;

    private bool HasHeaderSlots => HeaderLeading is not null || HeaderTrailing is not null;

    // The wrapper row is emitted ONLY when a slot is in use. That conditionality is not an
    // optimisation: it is the reason this component can gain slots without touching a single
    // existing consumer, because with no slot the emitted markup stays byte-identical (the
    // strip remains a DIRECT child of .tm-tabs, so `.tm-tabs > .tm-tabs__header` still matches).
    private RenderFragment HeaderContent => HasHeaderSlots ? HeaderRow : HeaderStrip;

    private RenderFragment HeaderRow => @<div class="tm-tabs__header-row">
        @if (HeaderLeading is not null)
        {
            <div class="tm-tabs__header-leading">@HeaderLeading</div>
        }
        @HeaderStrip
        @if (HeaderTrailing is not null)
        {
            <div class="tm-tabs__header-trailing">@HeaderTrailing</div>
        }
    </div>;

    private RenderFragment HeaderStrip => @<div class="tm-tabs__header" role="tablist" aria-label="@AriaLabel" @onkeydown="HandleKeyDown">
        @{ _renderedHeaderInputs = CaptureHeaderInputs(); }
        @foreach (var panel in _panels)
        {
            var isActive = panel.Id == ActiveTabId;
            var tabClass = "tm-tab" +
                (isActive ? " tm-tab--active" : "") +
                (panel.Disabled ? " tm-tab--disabled" : "");

            <button type="button"
                    @ref="_tabElements[panel.Id]"
                    role="tab"
                    id="@($"tab-{panel.Id}")"
                    class="@tabClass"
                    aria-selected="@(isActive ? "true" : "false")"
                    aria-disabled="@(panel.Disabled ? "true" : null)"
                    aria-controls="@($"tabpanel-{panel.Id}")"
                    tabindex="@(isActive ? 0 : -1)"
                    @attributes="panel.TabAttributes"
                    @onclick="@(() => SelectTab(panel))">
                @if (!string.IsNullOrEmpty(panel.Icon))
                {
                    <span class="tm-tab__icon">
                        <TmIcon Name="@panel.Icon" Size="IconSize.Sm" />
                    </span>
                }
                <span class="tm-tab__label">@panel.Title</span>
                @if (!string.IsNullOrEmpty(panel.Badge))
                {
                    <span class="tm-tab__badge">@panel.Badge</span>
                }
            </button>
        }
    </div>;

    /// <summary>ID of the currently active tab.</summary>
    [Parameter] public string ActiveTabId { get; set; } = default!;

    /// <summary>Fires when the active tab changes.</summary>
    [Parameter] public EventCallback<string> ActiveTabIdChanged { get; set; }

    /// <summary>Visual variant of the tab strip.</summary>
    [Parameter] public TabVariant Variant { get; set; } = TabVariant.Line;

    /// <summary>
    /// When <c>true</c>, the tab strip wraps onto multiple rows to fit the available width instead of
    /// scrolling horizontally. Use when many tabs would otherwise overflow/truncate in a narrow container.
    /// </summary>
    [Parameter] public bool Wrap { get; set; }

    /// <summary>
    /// Optional content rendered immediately BEFORE the tab strip, as a SIBLING of the
    /// <c>role="tablist"</c> element — never inside it. The tab strip owns a roving tabindex
    /// (Arrow/Home/End, <c>tabindex</c> 0/-1, <c>aria-selected</c> AND the DOM focus, which moves
    /// with the selection); an element that can never be selected would misreport that contract to
    /// assistive technology and would be reachable with the arrow keys as if it were a tab.
    /// <para>
    /// Setting this (or <see cref="HeaderTrailing"/>) wraps the strip in an extra
    /// <c>.tm-tabs__header-row</c> flex row. The wrapper is emitted ONLY when at least one slot
    /// is supplied; with neither slot the rendered markup is byte-identical to a tab strip that
    /// has no slots at all, so existing CSS and tests that rely on
    /// <c>.tm-tabs &gt; .tm-tabs__header</c> keep working.
    /// </para>
    /// <para>
    /// CONTRACT FOR STICKY CONSUMERS: when the slots are in use, a sticky tab strip must stick
    /// the ROW (<c>.tm-tabs__header-row</c>), not the header (<c>.tm-tabs__header</c>). Sticking
    /// the header alone pins only the strip and lets the slot content scroll away.
    /// </para>
    /// </summary>
    [Parameter] public RenderFragment? HeaderLeading { get; set; }

    /// <summary>
    /// Optional content rendered immediately AFTER the tab strip, as a SIBLING of the
    /// <c>role="tablist"</c> element — never inside it, for the same roving-focus reason as
    /// <see cref="HeaderLeading"/>.
    /// <para>
    /// Setting this (or <see cref="HeaderLeading"/>) wraps the strip in an extra
    /// <c>.tm-tabs__header-row</c> flex row. The wrapper is emitted ONLY when at least one slot
    /// is supplied; with neither slot the rendered markup is byte-identical to a tab strip that
    /// has no slots at all.
    /// </para>
    /// <para>
    /// CONTRACT FOR STICKY CONSUMERS: when the slots are in use, stick the ROW
    /// (<c>.tm-tabs__header-row</c>), not the header (<c>.tm-tabs__header</c>), otherwise the
    /// slot content scrolls away from under the pinned strip.
    /// </para>
    /// </summary>
    [Parameter] public RenderFragment? HeaderTrailing { get; set; }

    /// <summary>Tab panel children.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Accessible name of the tablist. Null leaves the strip unnamed, as before.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Additional CSS class.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Additional HTML attributes.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string VariantClass
    {
        get
        {
            var variant = Variant switch
            {
                TabVariant.Pill => "tm-tabs--pill",
                TabVariant.Enclosed => "tm-tabs--enclosed",
                _ => "tm-tabs--line"
            };

            return Wrap ? $"{variant} tm-tabs--wrap" : variant;
        }
    }

    internal void RegisterPanel(TmTabPanel panel)
    {
        if (!_panels.Any(p => p.Id == panel.Id))
        {
            _panels.Add(panel);
            StateHasChanged();
        }
    }

    /// <summary>
    /// The header inputs (title, icon, badge, disabled) AS the strip last rendered them, plus the
    /// current values of the registered panels. The strip is built from the panel INSTANCES, so a
    /// dynamic header input (a badge count that follows a selection) can lag one render pass
    /// behind the panels' parameters (the panel SetParametersAsync runs after the strip of the
    /// same pass built) — <see cref="OnAfterRenderAsync"/> compares the two snapshots and
    /// re-renders ONCE when they disagree. A static strip settles after the single
    /// registered-panels render it always did, so the frozen no-slot markup hash is untouched.
    /// </summary>
    private (string? Title, string? Icon, string? Badge, bool Disabled)[]? _renderedHeaderInputs;

    /// <summary>
    /// The ONE-extra-render bound of the header resync above. The extra render is allowed ONCE
    /// per OUTSIDE render pass; while the flag is set, a still-diverging comparison records the
    /// snapshot but renders no further. This is what keeps a NON-IDEMPOTENT header input (a
    /// title or badge re-evaluated per fragment execution) from rendering forever: the strip is
    /// rebuilt from the panel INSTANCES before their parameters of the same pass land, so such
    /// an input diverges on EVERY render — bounded, it costs exactly one resync per outside
    /// render; unbounded, the resync would feed itself (<c>TmTabsTests.Non_idempotent_title_does_not_render_loop</c>).
    /// A render that compares EQUAL clears the flag, so the next outside render may resync again.
    /// </summary>
    private bool _headerResyncRendered;

    private (string? Title, string? Icon, string? Badge, bool Disabled)[] CaptureHeaderInputs()
        => _panels.Select(panel => (panel.Title, panel.Icon, panel.Badge, panel.Disabled)).ToArray();

    internal void UnregisterPanel(TmTabPanel panel)
    {
        _panels.RemoveAll(p => p.Id == panel.Id);
        _tabElements.Remove(panel.Id);
        StateHasChanged();
    }

    /// <summary>
    /// Pointer path into the same selection change the keyboard makes — and it claims the same
    /// focus move, for the same reason.
    /// <para>
    /// The browser has already focused the clicked button by the time this runs, so on the
    /// ACCEPTING path the claim is a no-op: it re-focuses the tab that is now both clicked and
    /// selected. It earns its keep on the REJECTED path. There the browser's native focus has moved
    /// to a tab the consumer refuses to select, and nothing would pull it back: the focus ring would
    /// sit on a tab that is not <c>aria-selected</c> and carries <c>tabindex="-1"</c> — measured
    /// before this line existed: <c>activeElement=#tab-veto-second, selected=[tab-veto-first],
    /// tabindex0=[tab-veto-first]</c>. That is the same divergence the arrow keys were fixed for,
    /// arriving through the pointer instead, so the invariant "the focused tab IS the selected tab"
    /// has to be claimed here too or it is a claim about the keyboard only.
    /// </para>
    /// </summary>
    private async Task SelectTab(TmTabPanel panel)
    {
        if (panel.Disabled || panel.Id == ActiveTabId)
            return;

        _focusSelectedTabAfterRender = true;
        await ActiveTabIdChanged.InvokeAsync(panel.Id);
    }

    /// <summary>
    /// Keyboard contract of the tab strip, per the ARIA APG tablist pattern: Left/Right move by one
    /// (wrapping, skipping disabled tabs), Home/End jump to the first/last selectable tab.
    /// <para>
    /// TWO DELIBERATE DEPARTURES from the APG pattern, both left out rather than overlooked.
    /// </para>
    /// <para>
    /// (1) NOT MIRRORED IN RTL. The comparison is against the physical key names, so in a
    /// right-to-left strip ArrowRight still moves towards the END of the panel list rather than
    /// towards the tab drawn to its right. There is no direction to mirror AGAINST: no Tempo Blazor
    /// component reads <c>dir</c> for its own markup, and no stylesheet carries an RTL rule, so a
    /// strip that mirrored its keys would be guessing at a direction nothing sets.
    /// </para>
    /// <para>
    /// Bidi machinery DOES exist inside the Blazor packages — the document editor's canvas ships a
    /// Unicode bidi resolver (<c>document-editor/layout/bidi.mjs</c>) and stamps
    /// <c>dir="rtl"</c> on the spans it renders (<c>render/atomic-renderer.mjs</c>) — but that is
    /// the editor laying out its OWN canvas text, not a direction context another component can
    /// read. Nothing hands a direction to a tab strip.
    /// </para>
    /// <para>
    /// (2) THE DEFAULT SCROLL IS NOT SUPPRESSED. Home/End scroll the page as usual, so on a long
    /// page the viewport jumps before <c>FocusAsync</c> brings the strip back. Bounded by
    /// <c>HomeScrollsThePage_ButLeavesTheFocusedTabInsideTheViewport</c>, which reproduces the
    /// settled scroll position (2437) and the focused tab's rectangle (top=429/bottom=471 in a
    /// 900px viewport); the positions on the way there vary run to run and are logged, not
    /// asserted. Transient jank, not a lost strip.
    /// <para>
    /// Suppressing the scroll needs <c>@onkeydown:preventDefault</c>. That directive DOES take a
    /// bool expression — six places in Tempo use it that way, e.g. <c>TmRichEditorFull</c>'s
    /// <c>_suppressKeyDown</c> and <c>TmDocumentPageViewer</c>'s
    /// <c>ShouldPreventCommentPointerDefault</c> — but the expression is evaluated at RENDER time,
    /// so it cannot depend on which key was pressed. It would therefore have to be on for every
    /// keydown on the tablist, which also swallows Tab and traps focus inside the strip: a worse
    /// accessibility defect than the scroll it fixes.
    /// </para>
    /// </summary>
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (_panels.Count == 0) return;

        var currentIndex = _panels.FindIndex(p => p.Id == ActiveTabId);
        if (currentIndex < 0) currentIndex = 0;

        var newIndex = e.Key switch
        {
            // Wrap around the strip, skipping disabled tabs.
            "ArrowRight" => Step(currentIndex, +1, currentIndex),
            "ArrowLeft" => Step(currentIndex, -1, currentIndex),
            // Scan inwards from the edge, so a disabled first/last tab is stepped over rather than
            // swallowing the key — the same "disabled tabs are not stops" rule the arrows follow.
            "Home" => Step(-1, +1, currentIndex),
            "End" => Step(_panels.Count, -1, currentIndex),
            _ => currentIndex
        };

        if (newIndex == currentIndex) return;

        // Selection and DOM focus move TOGETHER. Either one alone is a broken roving tabindex, and
        // the focus half is the half that is invisible to any assertion phrased over aria-selected.
        // Note what is NOT stored here: the requested id. See _focusSelectedTabAfterRender.
        _focusSelectedTabAfterRender = true;
        await ActiveTabIdChanged.InvokeAsync(_panels[newIndex].Id);
    }

    /// <summary>
    /// First selectable tab strictly after <paramref name="from"/> in direction
    /// <paramref name="delta"/>, wrapping at most once around the strip; <paramref name="fallback"/>
    /// when every other tab is disabled. Callers pass an out-of-range <paramref name="from"/>
    /// (<c>-1</c> / <c>Count</c>) to scan from an edge inwards without wrapping past it.
    /// </summary>
    private int Step(int from, int delta, int fallback)
    {
        for (var i = 1; i <= _panels.Count; i++)
        {
            var candidate = ((from + (delta * i)) % _panels.Count + _panels.Count) % _panels.Count;
            if (!_panels[candidate].Disabled) return candidate;
        }

        return fallback;
    }

    /// <summary>
    /// Resolves a claimed focus move against the selection the consumer actually accepted. The
    /// target is <see cref="ActiveTabId"/> as of THIS render — never the tab the key asked for.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Dynamic header inputs (see _renderedHeaderInputs): the panels' parameters landed AFTER
        // the strip of this pass was built, so a changed badge/title would otherwise lag one
        // interaction. One extra render shows it — ONCE per outside render pass (see
        // _headerResyncRendered); the next pass sees equal snapshots and the compare never
        // re-arms (a strip whose inputs are static stays a single render).
        var current = CaptureHeaderInputs();
        if (_renderedHeaderInputs is null || !current.SequenceEqual(_renderedHeaderInputs))
        {
            if (!_headerResyncRendered)
            {
                _headerResyncRendered = true;
                _renderedHeaderInputs = current;
                StateHasChanged();
            }
            else
            {
                // Still diverging after the one allowed resync render: a non-idempotent header
                // input. Record the snapshot without rendering again — the NEXT outside render
                // gets its own resync budget (the flag clears on the first equal comparison).
                _renderedHeaderInputs = current;
            }
        }
        else
        {
            _headerResyncRendered = false;
        }

        if (!_focusSelectedTabAfterRender) return;

        _focusSelectedTabAfterRender = false;

        if (ActiveTabId is not null && _tabElements.TryGetValue(ActiveTabId, out var element))
        {
            await element.FocusAsync();
        }
    }
}
