@namespace Tempo.Blazor.Components.Navigation
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Feedback
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (Enabled)
{
    @if (OnSaveAndLeave is not null)
    {
        @* Three-choice variant: Stay / Save and leave / Leave.
           OnResult wires Escape (TmDialog cancel) to "stay", matching the two-choice variant. *@
        <TmDialog Show="@_showConfirm"
                  Type="DialogType.Custom"
                  Title="@ConfirmTitle"
                  Message="@ConfirmMessage"
                  OnResult="HandleDialogResultAsync">
            <FooterContent>
                @* The whole footer is inert while a save is in flight (20C review carry-forward):
                   Leave would abandon the pending write, Stay would dismiss the dialog the save
                   still reports through. *@
                <TmButton Variant="ButtonVariant.Ghost" Disabled="@_saving" OnClick="() => HandleDialogResultAsync(false)">
                    @CancelText
                </TmButton>
                <TmButton Variant="ButtonVariant.Primary" Disabled="@_saving" OnClick="HandleSaveAndLeaveAsync">
                    @SaveAndLeaveText
                </TmButton>
                <TmButton Variant="ButtonVariant.Danger" Disabled="@_saving" OnClick="() => HandleDialogResultAsync(true)">
                    @ConfirmLeaveText
                </TmButton>
            </FooterContent>
        </TmDialog>
    }
    else
    {
        <TmDialog Show="@_showConfirm"
                  Type="DialogType.Confirm"
                  Title="@ConfirmTitle"
                  Message="@ConfirmMessage"
                  OkButtonText="@ConfirmLeaveText"
                  CancelButtonText="@CancelText"
                  OnResult="HandleDialogResultAsync" />
    }
}

@code {
    private const string ModulePath = "./_content/Tempo.Blazor/Components/Navigation/TmNavigationGuard.razor.js";

    private IDisposable? _locationChangingRegistration;
    private IJSObjectReference? _module;
    private bool _showConfirm;
    private bool _saving;
    private bool _suppressNext;
    private string? _pendingTargetLocation;
    private bool? _lastPushedDirty;

    /// <summary>Whether the host currently has unsaved work. Ignored when <see cref="IsDirtyCallback"/> is set.</summary>
    [Parameter] public bool IsDirty { get; set; }

    /// <summary>
    /// Optional callback evaluated on every check instead of <see cref="IsDirty"/>. Useful when dirty state is
    /// derived (e.g. from a working copy) rather than tracked as a simple flag.
    /// </summary>
    [Parameter] public Func<bool>? IsDirtyCallback { get; set; }

    /// <summary>When false, the guard never blocks navigation or the browser unload prompt.</summary>
    [Parameter] public bool Enabled { get; set; } = true;

    /// <summary>Title shown in the leave-confirmation dialog.</summary>
    [Parameter] public string ConfirmTitle { get; set; } = "Unsaved changes";

    /// <summary>Message shown in the leave-confirmation dialog.</summary>
    [Parameter] public string ConfirmMessage { get; set; } = "You have unsaved changes. If you leave now, they will be lost.";

    /// <summary>Text for the button that confirms leaving (discarding unsaved work).</summary>
    [Parameter] public string ConfirmLeaveText { get; set; } = "Leave";

    /// <summary>Text for the button that cancels navigation and stays on the page.</summary>
    [Parameter] public string CancelText { get; set; } = "Stay";

    /// <summary>
    /// Text for the optional third button that saves the pending work and then leaves. The button is only
    /// rendered when <see cref="OnSaveAndLeave"/> is set, so existing two-choice usages are unchanged.
    /// </summary>
    [Parameter] public string SaveAndLeaveText { get; set; } = "Save and leave";

    /// <summary>
    /// Optional callback that persists the pending work before navigation continues. When set, the
    /// confirmation dialog shows a third "save and leave" button. Leave unset for the classic
    /// Leave/Stay behavior.
    /// <para>
    /// <b>Return <c>true</c> only when the work is actually persisted.</b> On <c>true</c> the guard
    /// re-issues the blocked navigation; on <c>false</c> it navigates nowhere, closes the dialog
    /// (see <see cref="OnSaveAndLeaveFailed"/>) and clears the blocked destination — a retry means
    /// the host triggers a fresh navigation attempt, not a second click in the same dialog.
    /// A thrown exception takes the SAME failure path (dialog closes, destination forgotten,
    /// <see cref="OnSaveAndLeaveFailed"/> fires) and then propagates normally to the host's
    /// error boundary.
    /// </para>
    /// </summary>
    /// <remarks>
    /// <para>
    /// Until 2.8.16 this was an <see cref="EventCallback"/> and the guard navigated as soon as it
    /// completed — regardless of what it did. A save that failed (HTTP error, server-side validation)
    /// therefore DISCARDED the changes: exactly the loss the guard exists to prevent, triggered by the
    /// button that promises to prevent it. The type change is deliberate and source-breaking: a delegate
    /// with no result cannot express "the save failed", and leaving a data-losing API alive under a
    /// familiar name is worse than making callers pick a return value.
    /// </para>
    /// <para>
    /// Not inferred from <see cref="IsDirty"/> after the callback: that parameter is pushed by the parent
    /// render, which has not necessarily happened by the time the awaited callback returns, so the guard
    /// would be reading a value that is stale for reasons it cannot see. The host knows whether the save
    /// succeeded; it says so.
    /// </para>
    /// </remarks>
    [Parameter] public Func<Task<bool>>? OnSaveAndLeave { get; set; }

    /// <summary>
    /// Optional predicate over the target URI deciding whether a navigation should be guarded at all.
    /// Return false to let a navigation through without prompting even when the host is dirty (e.g. moving
    /// between URL tabs or the detail↔sub-page of the same document). When null, every navigation is guarded.
    /// </summary>
    [Parameter] public Func<string, bool>? ShouldGuard { get; set; }

    /// <summary>When true, also registers a browser `beforeunload` prompt for tab close/refresh.</summary>
    [Parameter] public bool BeforeUnloadPrompt { get; set; } = true;

    /// <summary>Raised after the user confirms leaving, right before navigation is re-issued.</summary>
    [Parameter] public EventCallback OnConfirmLeave { get; set; }

    /// <summary>Raised after the user cancels and stays on the page.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>
    /// Raised after a failed <see cref="OnSaveAndLeave"/> closes the dialog (F10,
    /// DEC-SAVE-AND-LEAVE-FAILURE). The guard does not know what error surface the host has — no
    /// default focus target, no assumed toast — so the host wires this to move focus to its own
    /// error area or first invalid field and announce it (e.g. <c>aria-live</c>). Navigation stays
    /// cancelled: the guard does not remember the blocked destination past this point, so leaving
    /// again means the host triggers a fresh navigation attempt.
    /// </summary>
    [Parameter] public EventCallback OnSaveAndLeaveFailed { get; set; }

    private bool EffectiveDirty => IsDirtyCallback?.Invoke() ?? IsDirty;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _locationChangingRegistration = Navigation.RegisterLocationChangingHandler(OnLocationChangingAsync);
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Enabled || !BeforeUnloadPrompt)
        {
            return;
        }

        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            await _module.InvokeVoidAsync("register", EffectiveDirty);
            _lastPushedDirty = EffectiveDirty;
            return;
        }

        if (_module is not null && _lastPushedDirty != EffectiveDirty)
        {
            _lastPushedDirty = EffectiveDirty;
            await _module.InvokeVoidAsync("setDirty", EffectiveDirty);
        }
    }

    private ValueTask OnLocationChangingAsync(LocationChangingContext context)
    {
        if (!Enabled)
        {
            return ValueTask.CompletedTask;
        }

        if (_suppressNext)
        {
            _suppressNext = false;
            return ValueTask.CompletedTask;
        }

        if (!EffectiveDirty)
        {
            return ValueTask.CompletedTask;
        }

        if (ShouldGuard is not null && !ShouldGuard(context.TargetLocation))
        {
            // Host opted this destination out of guarding (e.g. same-document URL tab / sub-page).
            return ValueTask.CompletedTask;
        }

        context.PreventNavigation();
        _pendingTargetLocation = context.TargetLocation;
        _showConfirm = true;
        StateHasChanged();
        return ValueTask.CompletedTask;
    }

    private async Task HandleDialogResultAsync(bool? confirmed)
    {
        _showConfirm = false;
        var targetLocation = _pendingTargetLocation;
        _pendingTargetLocation = null;

        if (confirmed == true)
        {
            if (OnConfirmLeave.HasDelegate)
            {
                await OnConfirmLeave.InvokeAsync();
            }

            if (targetLocation is not null)
            {
                _suppressNext = true;
                Navigation.NavigateTo(targetLocation);
            }
        }
        else if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }

    /// <summary>
    /// Saves, and leaves ONLY if the save reported success. The pending target and the open dialog are
    /// released after the callback, not before it: a failed save must leave the user exactly where the
    /// guard stopped them — on the page, navigation still cancelled — while the host's own error
    /// surface (signalled through <see cref="OnSaveAndLeaveFailed"/>) takes over the messaging (F10).
    /// </summary>
    private async Task HandleSaveAndLeaveAsync()
    {
        if (_saving || OnSaveAndLeave is null)
        {
            // Re-entrancy: the dialog stays up during the save, so the button stays clickable in every
            // renderer that ignores `disabled` (and during the render gap before it is applied).
            return;
        }

        _saving = true;
        bool saved;
        try
        {
            saved = await OnSaveAndLeave();
        }
        catch
        {
            // A thrown save is still a FAILED save for the dialog contract: run the same
            // close-on-failure path a `false` return runs — the pre-carry-forward code left the
            // dialog open here, inconsistent with F10 (20C UX review). The exception then keeps
            // propagating: an escaped exception is the error boundary's report, not this
            // component's to swallow.
            await FailSaveAndLeaveAsync();
            throw;
        }
        finally
        {
            _saving = false;
        }

        if (!saved)
        {
            await FailSaveAndLeaveAsync();
            return;
        }

        _showConfirm = false;
        var targetLocation = _pendingTargetLocation;
        _pendingTargetLocation = null;

        if (targetLocation is not null)
        {
            _suppressNext = true;
            Navigation.NavigateTo(targetLocation);
        }
    }

    /// <summary>
    /// F10 (DEC-SAVE-AND-LEAVE-FAILURE): close the dialog and leave navigation cancelled — the
    /// host's own error surface takes over, with its own focus management and aria-live. Until
    /// 2.9.0 the dialog stayed open "so a retry is one click away"; the owner decision retired
    /// that because the guard cannot know what actually failed or where the host wants focus —
    /// only the host does. Shared by the <c>false</c> return and the thrown-exception paths so
    /// both fail identically.
    /// </summary>
    private async Task FailSaveAndLeaveAsync()
    {
        _showConfirm = false;
        _pendingTargetLocation = null;
        StateHasChanged();

        if (OnSaveAndLeaveFailed.HasDelegate)
        {
            await OnSaveAndLeaveFailed.InvokeAsync();
        }
    }

    /// <summary>
    /// Bypasses the guard for the single navigation that immediately follows this call. Hosts should call this
    /// before a post-commit programmatic navigation (e.g. after a successful save) so the guard does not
    /// re-prompt for work that was just persisted.
    /// </summary>
    public void Suppress() => _suppressNext = true;

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _locationChangingRegistration?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone; nothing left to clean up client-side.
            }

            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
