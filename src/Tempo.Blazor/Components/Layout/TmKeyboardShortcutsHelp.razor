@namespace Tempo.Blazor.Components.Layout
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Helpers
@using Tempo.Blazor.Models
@using Microsoft.AspNetCore.Components.Web
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (IsVisible)
{
    @* Round 3 (V2): a viewport-fixed overlay with a focus trap is a modal viewport-anchored
       surface — its root carries popover="manual" and promotes after the opening render, like
       TmModal, so a sheet or dialog opened before it can never cover it. *@
    <div class="tm-keyboard-shortcuts-overlay @Class" popover="manual" data-tm-backdrop @ref="_root" @onpointerdown="() => _pressOnBackdrop = true" @onclick="HandleBackdropClickAsync">
        @* The panel click fence is a REAL element (2.9.1, the phase-7 palette pattern): the old
           tag-level @onclick:stopPropagation on <TmFocusScope> reached the renderer as a splatted
           attribute it ignores — a runtime no-op — and a click anywhere inside the dialog bubbled
           to the backdrop's close handler. As an element the directive is applied, so clicks inside
           the panel stay off the backdrop. The wrapper carries no class so the flex child is
           exactly the panel it wraps. m7 (review): the fence also tracks the PRESS origin, the
           TmCommandPalette pattern — a drag that starts inside the panel and releases over the
           backdrop delivers only the CLICK there (the common ancestor), so the backdrop closes
           only when its own pointerdown armed the flag. *@
        <div @onpointerdown="() => _pressOnBackdrop = false" @onpointerdown:stopPropagation @onclick:stopPropagation>
            @* Activate-after-promote (c51ddf81 #1): the trap may only activate once the promote
               interop completed — an unpromoted popover root can be display:none and the
               initial-focus move would land on <body>. *@
            <TmFocusScope Active="@(_gate?.ScopeActive == true)"
                          Class="tm-keyboard-shortcuts-modal"
                          CloseOnEscape="true"
                          OnEscape="OnClose"
                          AriaLabelledBy="@TitleId">
                <div class="tm-keyboard-shortcuts-header">
                    @if (!string.IsNullOrEmpty(Description))
                    {
                        <div class="tm-keyboard-shortcuts-heading">
                            <h2 id="@TitleId" class="tm-keyboard-shortcuts-title">@DisplayTitle</h2>
                            <p class="tm-keyboard-shortcuts-subtitle">@Description</p>
                        </div>
                    }
                    else
                    {
                        @* No subtitle, so no wrapper: the title stays a direct child of the header, the
                           historical shape. The id is what aria-labelledby points at, so it stays. *@
                        <h2 id="@TitleId" class="tm-keyboard-shortcuts-title">@DisplayTitle</h2>
                    }
                    <button type="button" class="tm-keyboard-shortcuts-close" @onclick="OnClose" aria-label="@Loc["Tm_Close"]">
                        <TmIcon Name="@IconNames.X" Size="IconSize.Sm" />
                    </button>
                </div>
                <div class="tm-keyboard-shortcuts-content">
                    @if (Categories is not null)
                    {
                        @foreach (var category in Categories)
                        {
                            <div class="tm-keyboard-shortcuts-category">
                                <h3 class="tm-keyboard-shortcuts-category-title">@category.Title</h3>
                                <div class="tm-keyboard-shortcuts-list">
                                    @foreach (var shortcut in category.Shortcuts)
                                    {
                                        <div class="tm-keyboard-shortcuts-item">
                                            <span class="tm-keyboard-shortcuts-key">
                                                @{ var parts = SplitKeys(shortcut); }
                                                @for (var i = 0; i < parts.Count; i++)
                                                {
                                                    if (i > 0 && !IsChord(shortcut))
                                                    {
                                                        @* A separator other than '+' joins alternatives, not a chord.
                                                           The joiner must be read by screen readers, unlike a bare gap. *@
                                                        <span class="tm-keyboard-shortcuts-or">@Loc["TmKeyboardShortcutsHelp_Or"]</span>
                                                    }
                                                    <kbd>@parts[i]</kbd>
                                                }
                                            </span>
                                            <span class="tm-keyboard-shortcuts-description">@shortcut.Description</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </TmFocusScope>
        </div>
    </div>
}

@code {
    /// <summary>Shortcut categories to display.</summary>
    [Parameter] public IEnumerable<TmShortcutCategory>? Categories { get; set; }

    /// <summary>Whether the overlay is visible.</summary>
    [Parameter] public bool IsVisible { get; set; }

    /// <summary>Fires when the overlay should close.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Optional title. Falls back to localized default.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>
    /// Optional subtitle under the title, for a note such as "shortcuts work with an external
    /// keyboard". Null renders nothing, which is the historical markup.
    /// </summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Additional CSS class(es).</summary>
    [Parameter] public string? Class { get; set; }

    // An empty title is not a name: aria-labelledby would point at a blank heading, so fall back.
    private string DisplayTitle => string.IsNullOrEmpty(Title) ? Loc["TmKeyboardShortcutsHelp_Title"] : Title;

    // Stable for the instance so aria-labelledby keeps pointing at the title across renders.
    private readonly string TitleId = $"tm-shortcuts-title-{Guid.NewGuid():N}";

    private static List<string> SplitKeys(TmKeyboardShortcut shortcut)
    {
        var separator = string.IsNullOrEmpty(shortcut.KeySeparator) ? "+" : shortcut.KeySeparator;
        return shortcut.Keys.Split(separator).Select(part => part.Trim()).Where(part => part.Length > 0).ToList();
    }

    // '+' (the default) is a chord and keeps the historical bare-<kbd> markup. Anything else joins
    // alternatives, so the keys need a readable joiner between them.
    private static bool IsChord(TmKeyboardShortcut shortcut) =>
        string.IsNullOrEmpty(shortcut.KeySeparator) || shortcut.KeySeparator == "+";

    private ElementReference _root;
    private PromotedScopeGate? _gate;

    // Where the active press started. The backdrop sets it on its own pointerdown; the element
    // fence resets it and stops the propagation, so a press inside the panel can never arm it
    // (the TmCommandPalette pattern, m7).
    private bool _pressOnBackdrop;

    // The click-to-dismiss path. A click lands on the backdrop both for a plain outside click AND
    // for a drag-select that started inside the panel and released over the backdrop; only the
    // former may close, and the flag says which one this is.
    private Task HandleBackdropClickAsync()
    {
        if (!_pressOnBackdrop)
        {
            return Task.CompletedTask;
        }

        _pressOnBackdrop = false;
        return OnClose.InvokeAsync();
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The overlay unmounts when IsVisible goes false; a detached top-layer element is hidden
        // by the browser automatically, so closing needs no demote — promote only. The gate also
        // holds the trap back until the promote completed (c51ddf81 #1) and drops a promote that
        // finished after the close (c51ddf81 #2).
        _gate ??= new PromotedScopeGate(JS);
        if (await _gate.AfterRenderAsync(IsVisible, () => IsVisible, _root))
        {
            StateHasChanged();
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_gate is not null)
        {
            await _gate.DisposeAsync();
        }
    }
}
