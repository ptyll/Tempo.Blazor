@namespace Tempo.Blazor.Components.Layout
@inherits Tempo.Blazor.Components.TmComponentBase
@using Microsoft.JSInterop
@using Tempo.Blazor.Abstractions.Layout
@implements IAsyncDisposable
@inject IJSRuntime JS

@* The root is what this component measures. Blazor owns data-layout and the modifier class; the
   observer script only reports a width. Children read the cascaded context. *@
<div @ref="_root"
     id="@_id"
     class="tm-layout tm-layout--@Context.CssModifier @(IsContainer ? null : "tm-layout--no-container") @Class"
     data-layout="@Context.CssModifier"
     data-testid="@RootTestId("tm-layout")"
     style="@Style"
     @attributes="AdditionalAttributes">
    <CascadingValue Value="Context" IsFixed="false">
        @if (IsViewportScope)
        {
            <CascadingValue Value="Context" Name="@TmLayoutScopes.Viewport" IsFixed="false">
                @RenderContent
            </CascadingValue>
        }
        else
        {
            @RenderContent
        }
    </CascadingValue>
</div>

@code {
    private const string ModulePath = "./_content/Tempo.Blazor/js/layout-observer.js";

    private readonly string _id = $"tm-layout-{Guid.NewGuid():n}";
    private ElementReference _root;
    private bool _attaching;
    private IJSObjectReference? _module;
    private DotNetObjectReference<TmLayoutObserver>? _dotNetRef;
    private bool _observing;
    private TmLayoutBreakpoints _observedBreakpoints = TmLayoutBreakpoints.Default;
    private bool _disposed;
    private TmLayoutMode? _measured;
    private TmLayoutMode _resolved;
    private bool _resolvedInitialised;
    private TmLayoutContext? _context;

    /// <summary>The layout cascaded by an ancestor observer, when this one is nested.</summary>
    [CascadingParameter] public TmLayoutContext? Parent { get; set; }

    /// <summary>
    /// The layout to render. <see cref="TmLayoutMode.Auto"/> measures this component's own root
    /// unless a forced ancestor has already decided; any other value forces that layout and never
    /// imports the observer, so a test can render a mode without a DOM.
    /// </summary>
    [Parameter] public TmLayoutMode LayoutMode { get; set; } = TmLayoutMode.Auto;

    /// <summary>
    /// Raised when the rendered layout changes. The initial value is not a change. Never pair
    /// <see cref="LayoutMode"/> with this callback: it reports the resolved mode, and a two-way bind
    /// would pin that mode.
    /// </summary>
    [Parameter] public EventCallback<TmLayoutMode> ResolvedLayoutChanged { get; set; }

    /// <summary>Content that receives the resolved layout; use instead of ChildContent when the owner must branch its own markup.</summary>
    [Parameter] public RenderFragment<TmLayoutContext>? LayoutContent { get; set; }

    /// <summary>
    /// Also cascades the context under <see cref="TmLayoutScopes.Viewport"/>, so an overlay can ask
    /// for the viewport's layout rather than the container the trigger sits in.
    /// </summary>
    [Parameter] public bool IsViewportScope { get; set; }

    /// <summary>Content rendered inside the observed container. Plain child content does not receive the context.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra CSS classes appended to the root.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Inline style appended to the root. Use it to give the container a width in a demo.</summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>
    /// Whether the root is a container. Shrink-to-fit hosts such as a popover pass false so the
    /// root does not establish a containment context.
    /// </summary>
    [Parameter] public bool IsContainer { get; set; } = true;

    /// <summary>
    /// The mode rendered before the first measurement: static SSR, prerender, and the first frame.
    /// A cascaded app-level context beats it; see <see cref="TmLayout.Resolve"/>.
    /// </summary>
    [Parameter] public TmLayoutMode InitialMode { get; set; } = TmLayoutMode.Desktop;

    /// <summary>
    /// The thresholds this observer classifies its width with. Null (default) uses
    /// <see cref="TmLayoutBreakpoints.Default"/> — <see cref="TmBreakpoints.Sm"/> and
    /// <see cref="TmBreakpoints.Lg"/> — so nothing changes for existing hosts. A component whose
    /// content needs other steps (an editor shell that goes desktop from 1200) passes its own pair.
    /// A stylesheet keeps the shared literals; only the markup branch moves.
    /// </summary>
    [Parameter] public TmLayoutBreakpoints? Breakpoints { get; set; }

    /// <summary>Unmatched attributes forwarded to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>The layout currently rendered. Never <see cref="TmLayoutMode.Auto"/>.</summary>
    public TmLayoutMode Resolved => Context.Resolved;

    /// <summary>
    /// The cascaded context. CascadingValue treats any record as possibly changed
    /// (ChangeDetection.MayHaveChanged), so every subscriber is notified whenever the observer
    /// re-renders; the cache only keeps one instance per render.
    /// </summary>
    private TmLayoutContext Context
    {
        get
        {
            var resolved = Current();
            if (_context is null || _context.Mode != LayoutMode || _context.Resolved != resolved)
                _context = new TmLayoutContext(LayoutMode, resolved);
            return _context;
        }
    }

    private TmLayoutMode Current() => TmLayout.Resolve(LayoutMode, Parent, _measured, InitialMode);

    private RenderFragment RenderContent => builder =>
    {
        if (LayoutContent is not null)
            LayoutContent(Context)(builder);
        else
            ChildContent?.Invoke(builder);
    };

    protected override void OnParametersSet()
    {
        if (ChildContent is not null && LayoutContent is not null)
            throw new InvalidOperationException("Set ChildContent or LayoutContent, not both. LayoutContent is how an owner branches its own markup on the resolved layout.");
    }

    protected override async Task OnParametersSetAsync()
    {
        var resolved = Current();
        if (!_resolvedInitialised)
        {
            _resolved = resolved;
            _resolvedInitialised = true;
            return;
        }

        if (resolved == _resolved) return;

        _resolved = resolved;
        await ResolvedLayoutChanged.InvokeAsync(resolved);
    }

    /// <summary>True when this observer measures its own root. A forced mode, or Auto under a forced ancestor, does not.</summary>
    private bool Measures => LayoutMode == TmLayoutMode.Auto && Parent is not { Mode: not TmLayoutMode.Auto };

    private TmLayoutBreakpoints EffectiveBreakpoints => Breakpoints ?? TmLayoutBreakpoints.Default;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Re-register when the thresholds changed: the module classifies with what it was given, so
        // the same width must be re-evaluated against the new pair (it reports on the next frame).
        if (_observing && !_disposed && _module is not null && EffectiveBreakpoints != _observedBreakpoints)
        {
            _observedBreakpoints = EffectiveBreakpoints;
            await _module.InvokeVoidAsync("observe", _root, _dotNetRef, _id, ObserveOptions(_observedBreakpoints));
            return;
        }

        if (!Measures || _observing || _attaching || _disposed) return;

        // Set before the first await, so a second render during the import cannot start another one.
        _attaching = true;
        _dotNetRef ??= DotNetObjectReference.Create(this);
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
        // Dispose may have run while the import was awaiting. Release what it could not see.
        if (_disposed)
        {
            await ReleaseAsync();
            return;
        }

        // A loose or substituted runtime (bUnit's default) resolves the import to null. There is
        // nothing to observe then, and nothing to leak on dispose.
        if (_module is null) return;

        _observing = true;
        _attaching = false;
        _observedBreakpoints = EffectiveBreakpoints;
        await _module.InvokeVoidAsync("observe", _root, _dotNetRef, _id, ObserveOptions(_observedBreakpoints));
        if (_disposed) await ReleaseAsync();
    }

    private static object ObserveOptions(TmLayoutBreakpoints breakpoints) => new
    {
        breakpoints = new { sm = breakpoints.Sm, md = TmBreakpoints.Md, lg = breakpoints.Lg },
    };

    /// <summary>Called by layout-observer.js when the measured mode changes. An unchanged mode is ignored.</summary>
    /// <param name="mode">One of <c>desktop</c>, <c>tablet</c>, <c>mobile</c>.</param>
    [JSInvokable]
    public Task OnLayoutModeChanged(string mode)
    {
        var measured = mode switch
        {
            "mobile" => TmLayoutMode.Mobile,
            "tablet" => TmLayoutMode.Tablet,
            "desktop" => TmLayoutMode.Desktop,
            _ => throw new ArgumentException($"'{mode}' is not a layout mode. Expected desktop, tablet or mobile.", nameof(mode)),
        };

        // The measurement is recorded even while a forced mode hides it, so returning to Auto
        // restores the mode the container actually has.
        return InvokeAsync(async () =>
        {
            _measured = measured;
            var resolved = Current();
            if (resolved == _resolved) return;

            _resolved = resolved;
            await ResolvedLayoutChanged.InvokeAsync(resolved);
            StateHasChanged();
        });
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        await ReleaseAsync();
    }

    private async Task ReleaseAsync()
    {
        var module = _module;
        var observing = _observing;
        _module = null;
        _observing = false;
        _dotNetRef?.Dispose();
        _dotNetRef = null;
        if (module is null) return;

        try
        {
            if (observing) await module.InvokeVoidAsync("disconnect", _id);
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
    }
}
