@namespace Tempo.Blazor.Components.Layout
@inherits Tempo.Blazor.Components.TmComponentBase
@using Microsoft.JSInterop
@using Tempo.Blazor.Abstractions.Layout
@implements IAsyncDisposable
@inject IJSRuntime JS

@* The root is the container. Children read the cascaded TmLayoutContext and branch in markup;
   the modifier class and data-layout let CSS do the same without a .NET round-trip. *@
<div @ref="_root"
     id="@_id"
     class="tm-layout tm-layout--@Context.CssModifier @Class"
     data-layout="@Context.CssModifier"
     data-testid="@RootTestId("tm-layout")"
     style="@Style"
     @attributes="AdditionalAttributes">
    <CascadingValue Value="Context" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    private const string ModulePath = "./_content/Tempo.Blazor/js/layout-observer.js";

    private readonly string _id = $"tm-layout-{Guid.NewGuid():n}";
    private readonly SemaphoreSlim _jsSync = new(1, 1);
    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<TmLayoutObserver>? _dotNetRef;
    private bool _observing;
    private bool _disposed;
    private TmLayoutMode _rendered = TmLayoutMode.Desktop;

    /// <summary>
    /// The layout to render. <see cref="TmLayoutMode.Auto"/> measures this component's own root;
    /// any other value forces that layout and never imports the observer, so a test can render a
    /// mode without a DOM.
    /// </summary>
    [Parameter] public TmLayoutMode LayoutMode { get; set; } = TmLayoutMode.Auto;

    /// <summary>Raised when the rendered layout changes. The initial value is not a change.</summary>
    [Parameter] public EventCallback<TmLayoutMode> LayoutModeChanged { get; set; }

    /// <summary>Content rendered inside the observed container.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra CSS classes appended to the root.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Inline style appended to the root. Use it to give the container a width in a demo.</summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>Unmatched attributes forwarded to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>The layout currently rendered. Never <see cref="TmLayoutMode.Auto"/>.</summary>
    public TmLayoutMode Resolved => _rendered;

    private TmLayoutContext Context => new(LayoutMode, _rendered);

    protected override async Task OnParametersSetAsync()
    {
        if (LayoutMode == TmLayoutMode.Auto) return;
        if (LayoutMode == _rendered) return;

        var previous = _rendered;
        _rendered = LayoutMode;
        if (previous != _rendered)
            await LayoutModeChanged.InvokeAsync(_rendered);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (LayoutMode != TmLayoutMode.Auto || _observing || _disposed) return;

        await _jsSync.WaitAsync();
        try
        {
            if (LayoutMode != TmLayoutMode.Auto || _observing || _disposed) return;

            _dotNetRef ??= DotNetObjectReference.Create(this);
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            // Dispose may have run while the import was awaiting. Release what it could not see.
            if (_disposed)
            {
                ReleaseObserver();
                return;
            }
            // A loose or substituted runtime (bUnit's default, a prerender) resolves the import to
            // null. There is nothing to observe then, and nothing to leak on dispose.
            if (_module is null) return;
            _observing = true;
            await _module.InvokeVoidAsync("observe", _root, _dotNetRef, _id);
            if (_disposed) ReleaseObserver();
        }
        catch (JSDisconnectedException)
        {
            // The circuit went away between render and attach; dispose owns the cleanup.
        }
        finally
        {
            _jsSync.Release();
        }
    }

    /// <summary>Called by layout-observer.js when the measured mode changes. An unchanged mode is ignored.</summary>
    /// <param name="mode">One of <c>desktop</c>, <c>tablet</c>, <c>mobile</c>.</param>
    [JSInvokable]
    public Task OnLayoutModeChanged(string mode)
    {
        var resolved = mode switch
        {
            "mobile" => TmLayoutMode.Mobile,
            "tablet" => TmLayoutMode.Tablet,
            "desktop" => TmLayoutMode.Desktop,
            _ => throw new ArgumentException($"'{mode}' is not a layout mode. Expected desktop, tablet or mobile.", nameof(mode)),
        };

        if (LayoutMode != TmLayoutMode.Auto || resolved == _rendered) return Task.CompletedTask;

        _rendered = resolved;
        return InvokeAsync(async () =>
        {
            await LayoutModeChanged.InvokeAsync(resolved);
            StateHasChanged();
        });
    }

    /// <inheritdoc />
    public ValueTask DisposeAsync()
    {
        if (_disposed) return ValueTask.CompletedTask;
        _disposed = true;

        // Synchronous on purpose. Waiting for the attach lock deadlocks: that lock is held by the
        // render that is itself waiting for this dispose to finish. When dispose wins that race the
        // resumed render sees _disposed and releases the module it imported.
        ReleaseObserver();
        return ValueTask.CompletedTask;
    }

    private void ReleaseObserver()
    {
        if (_module is not null && _observing)
        {
            try { _ = _module.InvokeVoidAsync("disconnect", _id); }
            catch (JSDisconnectedException) { }
        }

        _dotNetRef?.Dispose();
        _dotNetRef = null;
        if (_module is not null)
        {
            try { _ = _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            _module = null;
        }
    }

}
