@namespace Tempo.Blazor.Components.Layout
@using Tempo.Blazor.Interfaces
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.DataDisplay
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Helpers
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JS

@if (IsOpen)
{
    @* U1/round 3: the palette is a modal viewport-anchored surface — its backdrop root carries
       popover="manual" and is promoted after the opening render, so opened from inside a promoted
       drawer or sheet it paints above it instead of staying focused but invisible underneath.
       The backdrop is a click-to-dismiss surface (cluster-B §4): the handlers sit BEFORE
       @attributes so a consumer onclick in AdditionalAttributes keeps today's precedence. The
       dismissal requires the PRESS to start on the backdrop (review, phase 7): a drag-select from
       the input that ends over the backdrop fires only the click there, so the panel fence below
       keeps the press off the backdrop's tracking while the backdrop sets it. *@
    <div class="tm-command-palette-backdrop @Class" popover="manual" data-tm-backdrop @ref="_backdrop" @onpointerdown="() => _pressOnBackdrop = true" @onclick="HandleBackdropClickAsync" @attributes="AdditionalAttributes">
        @* Activate-after-promote (c51ddf81 #1): the trap may only activate once the promote
           interop completed — an unpromoted popover root can be display:none and the
           initial-focus move would land on <body>. The fence is a REAL element on purpose
           (review, phase 7): Blazor applies element-level :stopPropagation directives, but the
           same directives routed through a component's CaptureUnmatchedValues reach the renderer
           as plain splatted attributes it ignores — the palette then dismissed on an input click
           (proven by Palette_BackdropClick_Closes_AndPanelClickDoesNot). As an element, the pair
           keeps presses AND clicks inside the panel off the backdrop's press tracking and close
           handler (unlike TmKeyboardShortcutsHelp, which still uses the tag-level form). The wrapper carries no
           class so the flex child is exactly the panel it wraps. *@
        <div @onpointerdown="() => _pressOnBackdrop = false" @onpointerdown:stopPropagation @onclick:stopPropagation>
            <TmFocusScope @ref="_scope"
                          Class="tm-command-palette"
                          Active="@(_gate?.ScopeActive == true)"
                          NoteOpenerOnMount="true"
                          CloseOnEscape="true"
                          OnEscape="CloseAsync"
                          AriaLabel="@Loc["TmCommandPalette_Aria"]">
            <div class="tm-command-palette-header">
                <input class="tm-command-palette-input"
                       @ref="_input"
                       value="@_query"
                       @oninput="HandleInputAsync"
                       @onkeydown="HandleInputKeyDownAsync"
                       placeholder="@Loc["TmCommandPalette_Placeholder"]"
                       aria-label="@Loc["TmCommandPalette_SearchAria"]"
                       role="combobox"
                       aria-expanded="@(_filtered.Count > 0 ? "true" : "false")"
                       aria-controls="@(_filtered.Count > 0 ? _listId : null)"
                       aria-autocomplete="list"
                       aria-activedescendant="@(_filtered.Count > 0 ? OptionId(_highlightedIndex) : null)"
                       autocomplete="off" />
                <button class="tm-command-palette-close" aria-label="@Loc["TmCommandPalette_Close"]" @onclick="CloseAsync">×</button>
            </div>
            @if (_fetchState == CommandPaletteFetchState.Transient)
            {
                @* The search itself failed (not "no matches"): the list/empty state is replaced by
                   an inline alert with a retry. The retry is a native button — Tab reaches it and
                   Enter/Space are its own native activation, so it sits OUTSIDE the arrow-key
                   navigation (docs/keyboard-activation-convention.md). *@
                <div class="tm-command-palette-error" role="alert">
                    @if (TransientErrorTemplate is not null)
                    {
                        @TransientErrorTemplate(RetrySearchAsync)
                    }
                    else
                    {
                        <span class="tm-command-palette-error-text">@Loc["TmCommandPalette_SearchError"]</span>
                        <button type="button" class="tm-command-palette-retry" @onclick="RetrySearchAsync">@Loc["TmCommandPalette_Retry"]</button>
                    }
                </div>
            }
            else
            {
                @if (_filtered.Count == 0)
                {
                    if (Loading)
                    {
                        @RenderLoading()
                    }
                    else if (EmptyTemplate is not null)
                    {
                        @* The host owns the whole empty state — the wrapper deliberately carries no
                           tm-command-palette-empty class so default-empty styling/selector never
                           reaches the custom content. *@
                        <div class="tm-command-palette-empty-slot">@EmptyTemplate(_query)</div>
                    }
                    else
                    {
                        <div class="tm-command-palette-empty">@Loc["TmCommandPalette_NoResults"]</div>
                    }
                }
                else
                {
                    <ul class="tm-command-palette-list" role="listbox" id="@_listId" aria-label="@Loc["TmCommandPalette_Aria"]"
                        aria-busy="@(Loading ? "true" : null)">
                        @if (GroupByCategory)
                        {
                            @* A listbox's children must be options or groups. `group` is not an allowed
                               role for `li` (ec0299b9 #1), so each category is a presentational row
                               hosting a named div group; the divider is a border, not a role=separator,
                               which a listbox may not contain. A group must be NAMED: a null/empty
                               category renders no group wrapper at all — its options sit directly in
                               the presentational row instead of an unnamed group. *@
                            var groupNumber = 0;
                            @foreach (var group in GroupedActions())
                            {
                                var labelId = $"{_groupLabelPrefix}-{groupNumber++}";
                                <li role="none" class="tm-command-palette-group-item">
                                    @if (string.IsNullOrEmpty(group.Label))
                                    {
                                        <ul role="none">
                                            @foreach (var index in group.Indexes)
                                            {
                                                @RenderItem(index)
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <div class="tm-command-palette-group" role="group"
                                             aria-labelledby="@labelId">
                                            <span id="@labelId" class="tm-command-palette-group-label">@group.Label</span>
                                            <ul role="none">
                                                @foreach (var index in group.Indexes)
                                                {
                                                    @RenderItem(index)
                                                }
                                            </ul>
                                        </div>
                                    }
                                </li>
                            }
                        }
                        else
                        {
                            @for (var i = 0; i < _filtered.Count; i++)
                            {
                                @RenderItem(i)
                            }
                        }
                    </ul>
                    @* Loading keeps the visible results in place (no flicker) and appends the
                       skeleton block below them; the block is aria-hidden so the busy listbox does
                       not own non-option children. *@
                    @if (Loading)
                    {
                        @RenderLoading()
                    }
                }
            }
            @if (ShowFooter || FooterTemplate is not null)
            {
                @* Keyboard hint strip. Purely visual help — NOT a live region — and hidden on a
                   coarse pointer via CSS, where arrows/Enter are not the input model. *@
                <footer class="tm-command-palette-footer">
                    @if (FooterTemplate is not null)
                    {
                        @FooterTemplate
                    }
                    else
                    {
                        <span class="tm-command-palette-footer-hint"><kbd>↑</kbd><kbd>↓</kbd> @Loc["TmCommandPalette_FooterNavigate"]</span>
                        <span class="tm-command-palette-footer-hint"><kbd>↵</kbd> @Loc["TmCommandPalette_FooterSelect"]</span>
                        <span class="tm-command-palette-footer-hint"><kbd>Esc</kbd> @Loc["TmCommandPalette_FooterClose"]</span>
                    }
                </footer>
            }
            @* One polite live region for the whole search lifecycle: "searching" while a fetch
               runs, then the result count. Rendered EMPTY from the moment the palette opens (a
               region that is inserted together with its text is not announced reliably) and only
               its text is set at fetch boundaries, so it is inherently debounced — never per
               keystroke. *@
            <div class="tm-sr-only tm-command-palette-status" role="status" aria-live="polite" aria-atomic="true">@_liveMessage</div>
        </TmFocusScope>
        </div>
    </div>
}

@code {
    // The item template stays in the razor file (it IS markup); all state, parameters and the
    // async search pipeline live in TmCommandPalette.razor.cs.
    private string ItemClass(int index) => index == _highlightedIndex
        ? "tm-command-palette-item tm-command-palette-item-focused"
        : "tm-command-palette-item";

    private RenderFragment RenderItem(int index) => @<li class="@ItemClass(index)"
                                                         id="@OptionId(index)"
                                                         role="option"
                                                         aria-selected="@(index == _highlightedIndex ? "true" : "false")"
                                                         @onclick="() => ExecuteAsync(_filtered[index])">
        @{
            var action = _filtered[index];
        }
        @if (ItemTemplate is not null)
        {
            @* The host owns the content only; the li, role=option, id, aria-selected and the
               click-to-execute wiring stay the component's. *@
            @ItemTemplate(action)
        }
        else
        {
            @* ShowIcons (default true, DEC-CMDPALETTE-ASYNC O2) renders the model's Icon. While
               at least one visible item has an icon every item carries the slot — an item without
               one gets an empty span of the same width so the titles line up; when no visible
               item has an icon the slot is dropped altogether (no dead gutter). The slot is aria-hidden: the icon decorates, it does
               not name the option (title + description + badge + code do). *@
            @if (ShowIcons && _anyIcon)
            {
                <span class="tm-command-palette-icon" aria-hidden="true">
                    @if (!string.IsNullOrEmpty(action.Icon))
                    {
                        <TmIcon Name="@action.Icon" Size="IconSize.Sm" />
                    }
                </span>
            }
            <span class="tm-command-palette-title">
                @if (HighlightMatches)
                {
                    <TmHighlightedText Text="@action.Title" Query="@_query" />
                }
                else
                {
                    @action.Title
                }
            </span>
            @if (!string.IsNullOrEmpty(action.Description))
            {
                <span class="tm-command-palette-description">@action.Description</span>
            }
            @* The trailing slot holds the entity badge + code (default, O4) or the host's
               ItemTrailingTemplate. It renders before the shortcut, which keeps its end
               alignment through the auto margin. *@
            <span class="tm-command-palette-trailing">
                @if (ItemTrailingTemplate is not null)
                {
                    @ItemTrailingTemplate(action)
                }
                else
                {
                    @if (!string.IsNullOrEmpty(action.Badge))
                    {
                        <TmBadge Variant="@BadgeVariantFor(action.BadgeTone)" BadgeStyle="BadgeStyle.Subtle" Size="BadgeSize.Sm">@action.Badge</TmBadge>
                    }
                    @if (!string.IsNullOrEmpty(action.Code))
                    {
                        <code class="tm-command-palette-code">
                            @if (HighlightMatches)
                            {
                                <TmHighlightedText Text="@action.Code" Query="@_query" />
                            }
                            else
                            {
                                @action.Code
                            }
                        </code>
                    }
                }
            </span>
            @if (!string.IsNullOrEmpty(action.Shortcut))
            {
                if (SplitShortcuts)
                {
                    <span class="tm-command-palette-shortcut">
                        @foreach (var part in SplitShortcut(action.Shortcut!))
                        {
                            <kbd>@part</kbd>
                        }
                    </span>
                }
                else
                {
                    <kbd class="tm-command-palette-shortcut">@action.Shortcut</kbd>
                }
            }
        }
    </li>;

    private RenderFragment RenderLoading() => @<div class="tm-command-palette-loading" aria-hidden="true">
        @if (LoadingTemplate is not null)
        {
            @LoadingTemplate
        }
        else
        {
            @for (var i = 0; i < 3; i++)
            {
                <div class="tm-command-palette-loading-row tm-skeleton"></div>
            }
        }
    </div>;
}
