@namespace Tempo.Blazor.Components.Layout
@using Tempo.Blazor.Abstractions.Layout
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Helpers
@using Microsoft.Extensions.Logging
@inherits Tempo.Blazor.Components.TmComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<TmDrawer> Logger
@inject ILogger<OverlayLayout> LayoutLogger


@if (IsOpen && Modal && Viewport is null && LayoutMode == TmLayoutMode.Auto)
{
    @* No viewport scope: the modal sheet measures the viewport itself. The probe is an internal
       component, so it is opened from C# — a tag in markup would compile to a literal element. *@
    @Probe
}
@if (IsOpen)
{
    <TmFocusScope @ref="_scope"
                  Active="true"
                  Modal="Modal"
                  Class="@RootClass"
                  AriaLabelledBy="@LabelledBy"
                  AriaLabel="@AriaLabel"
                  CloseOnEscape="CloseOnEscape"
                  OnEscape="HandleEscape"
                  RestoreFocusTarget="RestoreFocusTarget"
                  RestoreFocusTargetId="@RestoreFocusTargetId"
                  InitialFocusSelector="@InitialFocusSelector"
                  DataTestId="@DataTestId"
                  AdditionalAttributes="RootAttributes">
        @* The overlay is a child of the trapped root. A sibling gets marked inert, and an inert
           backdrop swallows the click that should close the drawer. *@
        @if (ShowOverlay && Modal)
        {
            <div class="tm-drawer__overlay" data-tm-backdrop @onclick="HandleOverlayClick"></div>
        }

        <div @ref="_panel" class="tm-drawer__panel tm-sheet__panel" style="@PanelStyle">
            @if (IsSheet && ShowHandle)
            {
                @* A content-height sheet (no snap points) has nothing for the keyboard to slide
                   between: the handle is a pure swipe grabber, decorative like TmModal's. *@
                <TmSheetHandle @ref="_handle"
                               Decorative="@(_snaps.Length == 0)"
                               SnapCount="_snaps.Length"
                               SnapIndex="_snapIndex"
                               SnapValue="@(_snaps.Length == 0 ? 0 : _snaps[Math.Clamp(_snapIndex, 0, _snaps.Length - 1)])"
                               SnapIndexChanged="SetSnapAsync"
                               OnDismiss="Close" />
            }

            <div @ref="_header" class="tm-drawer__header">
                @if (HeaderContent is not null)
                {
                    @HeaderContent
                }
                else if (!string.IsNullOrEmpty(Title))
                {
                    <h2 id="@_titleId" class="tm-drawer__title">@Title</h2>
                }

                @if (ShowCloseButton)
                {
                    <button type="button"
                            class="tm-drawer__close"
                            aria-label="@Loc["TmDrawer_Close"]"
                            @onclick="Close">
                        <TmIcon Name="x" Size="IconSize.Sm" />
                    </button>
                }
            </div>

            <div class="tm-drawer__body">
                @ChildContent
            </div>

            @if (FooterContent is not null)
            {
                <div class="tm-drawer__footer @(IsSheet ? "tm-drawer__footer--sticky" : null)">
                    @FooterContent
                </div>
            }
        </div>
    </TmFocusScope>
}

@code {
    private static readonly double[] DefaultSnaps = [0.5, 1.0];

    /// <summary>Whether the drawer is open.</summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>Fires when the drawer should open or close.</summary>
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>Side from which the drawer slides in.</summary>
    [Parameter] public DrawerPosition Position { get; set; } = DrawerPosition.Right;

    /// <summary>Width of the drawer panel. Ignored by a bottom sheet, which sizes from its snap point.</summary>
    [Parameter] public string Width { get; set; } = "400px";

    /// <summary>Title shown in the header.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>
    /// An accessible name for the drawer when neither <see cref="Title"/> nor
    /// <see cref="HeaderContent"/> names it (a header rendered through HeaderContent carries no
    /// automatic label). Emitted as <c>aria-label</c> on the focus-scope root.
    /// </summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Show a semi-transparent backdrop behind the drawer.</summary>
    [Parameter] public bool ShowOverlay { get; set; } = true;

    /// <summary>Close the drawer when clicking the overlay.</summary>
    [Parameter] public bool CloseOnOverlayClick { get; set; } = true;

    /// <summary>Close the drawer when pressing Escape.</summary>
    [Parameter] public bool CloseOnEscape { get; set; } = true;

    /// <summary>Show the X close button in the header.</summary>
    [Parameter] public bool ShowCloseButton { get; set; } = true;

    /// <summary>
    /// Whether the drawer is modal. A non-modal drawer renders inside its container with no overlay
    /// and no inert background, so the page behind it stays usable.
    /// </summary>
    [Parameter] public bool Modal { get; set; } = true;

    /// <summary>
    /// Fractions of the viewport height a bottom sheet snaps to, in ascending order. Defaults to a
    /// half-height sheet and a full-height one. A sheet needs at least one.
    /// </summary>
    [Parameter] public IReadOnlyList<double> SnapPoints { get; set; } = DefaultSnaps;

    /// <summary>
    /// Whether a downward swipe past the lowest snap dismisses the sheet. The gesture itself lives in
    /// the drawer module; this flag is what the stylesheet and the tests read.
    /// </summary>
    [Parameter] public bool SwipeToDismiss { get; set; } = true;

    /// <summary>
    /// Whether a bottom sheet renders its drag handle. The handle is also the keyboard control for the
    /// snap points, so turning it off removes both. A side drawer never renders one.
    /// </summary>
    [Parameter] public bool ShowHandle { get; set; } = true;

    /// <summary>
    /// The layout the sheet renders. <see cref="TmLayoutMode.Auto"/> follows the viewport scope; a
    /// forced value never measures, so a test can render a mode without a DOM.
    /// </summary>
    [Parameter] public TmLayoutMode LayoutMode { get; set; } = TmLayoutMode.Auto;

    /// <summary>
    /// The layout rendered before the first measurement. Desktop unless the host says otherwise, so a
    /// phone host can avoid flashing the desktop sheet.
    /// </summary>
    [Parameter] public TmLayoutMode InitialMode { get; set; } = TmLayoutMode.Desktop;

    /// <summary>
    /// Raised when the rendered layout changes. The initial value is not a change. Never pair
    /// <see cref="LayoutMode"/> with this callback: it reports the resolved mode, and a two-way bind
    /// would pin that mode.
    /// </summary>
    [Parameter] public EventCallback<TmLayoutMode> ResolvedLayoutChanged { get; set; }

    /// <summary>Custom header content (replaces Title).</summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    /// <summary>Main body content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Optional footer with action buttons.</summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>Additional CSS class for the root element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Additional HTML attributes for the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>The element focus returns to when the drawer closes.</summary>
    [Parameter] public ElementReference? RestoreFocusTarget { get; set; }

    /// <summary>The id of the restore target, for a target rendered outside this drawer.</summary>
    [Parameter] public string? RestoreFocusTargetId { get; set; }

    /// <summary>
    /// A CSS selector resolved inside the scope for the element that receives focus when the
    /// drawer opens (e.g. the first menuitem of a menu sheet, so a menu sheet lands on its
    /// content instead of the header's close action). Null keeps the scope default — the first
    /// focusable element.
    /// </summary>
    [Parameter] public string? InitialFocusSelector { get; set; }

    /// <summary>The snap the sheet renders. Two-way with <see cref="SnapIndexChanged"/>.</summary>
    [Parameter] public int SnapIndex { get; set; }

    /// <summary>Raised when the rendered snap changes.</summary>
    [Parameter] public EventCallback<int> SnapIndexChanged { get; set; }

    /// <summary>
    /// The tallest fraction of the viewport a sheet may cover. Between 0 and 1; the default leaves a
    /// sliver of the content behind the sheet visible.
    /// </summary>
    [Parameter] public double MaxHeight { get; set; } = 0.85;

    /// <summary>The viewport's layout. A modal sheet is positioned against the viewport, not its container.</summary>
    [CascadingParameter(Name = TmLayoutScopes.Viewport)] public TmLayoutContext? Viewport { get; set; }

    /// <summary>The container's layout. A non-modal sheet is positioned against its container.</summary>
    [CascadingParameter] public TmLayoutContext? Container { get; set; }

    private readonly string _titleId = $"tm-drawer-title-{Guid.NewGuid():N}";
    private TmSheetHandle? _handle;
    private ElementReference _panel;
    private ElementReference _header;
    private SheetInterop? _sheet;
    private DotNetObjectReference<TmDrawer>? _dotNetRef;
    private bool _gestureAttached;
    private bool _promoted;
    private string? _gestureKey;
    private bool _disposed;
    private TmFocusScope? _scope;
    private TopLayerInterop? _topLayer;
    private readonly OverlayLayout _layout = new();
    private int _snapIndex;
    private int _snapIndexParam = int.MinValue;
    private int? _snapBeforeKeyboard;
    private double[] _sortedSnaps = DefaultSnaps;

    private bool IsSheet => Position == DrawerPosition.Bottom;

    private double[] _snaps => _sortedSnaps;

    private string SnapList => string.Join(",", _snaps.Select(s => s.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)));

    private string? LabelledBy => !string.IsNullOrEmpty(Title) && HeaderContent is null ? _titleId : null;

    private TmLayoutContext Context => _layout.Resolve(LayoutMode, Modal ? Viewport : Container, InitialMode);

    /// <summary>
    /// The internal viewport probe, opened from C# because a Razor tag binds only to public
    /// components (an internal tag compiles to a literal element under a suppressed RZ10012).
    /// </summary>
    private RenderFragment Probe => builder =>
    {
        builder.OpenComponent<ViewportProbe>(0);
        builder.AddComponentParameter(1, nameof(ViewportProbe.OnMeasured),
            EventCallback.Factory.Create<TmLayoutMode>(this, OnProbed));
        builder.CloseComponent();
    };

    private Dictionary<string, object> RootAttributes
    {
        get
        {
            var attributes = new Dictionary<string, object>
            {
                ["data-layout"] = Context.CssModifier,
                ["data-snap-points"] = SnapList,
                ["data-snap-index"] = _snapIndex
            };

            if (Modal)
            {
                // U1: a MODAL drawer at EVERY position is a viewport-anchored overlay, so its root
                // is promoted to the browser top layer (showPopover in OnAfterRenderAsync) — a
                // sticky app bar (TmTopBar under TmBottomNavigation) or a transformed ancestor can
                // then neither confine nor cover it, and nothing opened from inside it paints
                // invisible under it. An inline drawer anchors to its container and stays put.
                attributes["popover"] = "manual";
            }

            if (AdditionalAttributes is not null)
            {
                foreach (var pair in AdditionalAttributes)
                {
                    attributes[pair.Key] = pair.Value;
                }
            }

            return attributes;
        }
    }

    private string RootClass
    {
        get
        {
            var classes = new List<string> { "tm-drawer", PositionClass };
            if (IsSheet)
            {
                classes.Add("tm-sheet");
                if (Modal) classes.Add("tm-sheet--anchored");
                if (_snaps.Length == 0) classes.Add("tm-sheet--content");
            }
            if (!Modal) classes.Add("tm-drawer--inline");
            if (!string.IsNullOrEmpty(Class)) classes.Add(Class);
            return string.Join(" ", classes);
        }
    }

    private string PositionClass => Position switch
    {
        DrawerPosition.Left => "tm-drawer--left",
        DrawerPosition.Bottom => "tm-drawer--bottom",
        _ => "tm-drawer--right"
    };

    private string PanelStyle
    {
        get
        {
            if (!IsSheet) return $"--tm-drawer-width: {Width}";
            var max = Math.Clamp(MaxHeight, 0.01, 1).ToString(System.Globalization.CultureInfo.InvariantCulture);
            if (_snaps.Length == 0) return $"--tm-sheet-max: {max}";
            var height = _snaps[Math.Clamp(_snapIndex, 0, _snaps.Length - 1)].ToString(System.Globalization.CultureInfo.InvariantCulture);
            return $"--tm-sheet-height: {height}; --tm-sheet-max: {max}";
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var gestureKey = $"{ShowHandle}:{SnapList}";
        if (IsOpen && IsSheet && (!_gestureAttached || _gestureKey != gestureKey))
        {
            _gestureAttached = true;
            _gestureKey = gestureKey;
            await AttachGestureAsync();
        }
        else if ((!IsOpen || !IsSheet) && _gestureAttached)
        {
            _gestureAttached = false;
            await DetachGestureAsync();
        }

        // U1: promote a MODAL drawer root (every position) to the top layer right after the render
        // that inserted it. Closing unmounts the whole subtree, and a detached top-layer element
        // is hidden by the browser automatically — no demote call is needed.
        if (IsOpen && Modal && !_promoted)
        {
            _promoted = true;
            _topLayer ??= new TopLayerInterop(JS);
            if (_scope is not null)
            {
                await _topLayer.PromoteAsync(_scope.Element);
            }
        }
        else if ((!IsOpen || !Modal) && _promoted)
        {
            _promoted = false;
        }
    }

    private async Task AttachGestureAsync()
    {
        if (_disposed) return;
        _sheet ??= new SheetInterop(JS);
        _dotNetRef ??= DotNetObjectReference.Create(this);
        // The handle is the gesture target when there is one. Without it the header follows the
        // finger — never the scrolling body, which has to keep scrolling.
        ElementReference? target = ShowHandle && _handle is not null ? _handle.Element : _header;
        await _sheet.AttachAsync(target, _panel, _snaps, SwipeToDismiss, _dotNetRef, trackViewport: Modal);
        if (_disposed) await _sheet.DetachAsync();
    }

    private async Task DetachGestureAsync()
    {
        if (_sheet is null) return;
        await _sheet.DetachAsync();
    }

    /// <summary>Invoked by the sheet module when a downward swipe passes the lowest snap.</summary>
    [JSInvokable]
    public Task HandleSheetDismissedAsync() => InvokeAsync(Close);

    /// <summary>Invoked by the sheet module when a gesture settles on a snap. C# owns the index.</summary>
    [JSInvokable]
    public Task HandleSheetSnappedAsync(int index) => InvokeAsync(() => SetSnapAsync(index));

    /// <summary>Invoked when the keyboard opens or closes. An open keyboard uses the highest snap.</summary>
    [JSInvokable]
    public Task HandleSheetKeyboardAsync(bool open) => InvokeAsync(() =>
    {
        if (!IsSheet || _snaps.Length == 0) return Task.CompletedTask;
        if (open)
        {
            _snapBeforeKeyboard ??= _snapIndex;
            return SetSnapAsync(_snaps.Length - 1);
        }
        var restore = _snapBeforeKeyboard ?? _snapIndex;
        _snapBeforeKeyboard = null;
        return SetSnapAsync(restore);
    });

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        var cap = Math.Clamp(MaxHeight, 0.01, 1);
        _sortedSnaps = SnapPoints
            .Where(s => s > 0)
            .Select(s => Math.Min(s, cap))
            .Distinct()
            .OrderBy(s => s)
            .ToArray();
        if (SnapIndex != _snapIndexParam)
        {
            _snapIndexParam = SnapIndex;
            _snapIndex = Math.Clamp(SnapIndex, 0, Math.Max(0, _sortedSnaps.Length - 1));
        }
        await ReportResolved();
    }

    private Task OnProbed(TmLayoutMode mode)
    {
        _layout.Measured(mode);
        OverlayLayout.HintOnce(LayoutLogger);
        return ReportResolved();
    }

    private Task ReportResolved() => _layout.ReportAsync(
        Context.Resolved, mode => ResolvedLayoutChanged.InvokeAsync(mode));

    private async Task SetSnapAsync(int index)
    {
        if (_snaps.Length == 0) return;
        _snapIndex = Math.Clamp(index, 0, _snaps.Length - 1);
        StateHasChanged();
        await SnapIndexChanged.InvokeAsync(_snapIndex);
    }

    private Task HandleEscape() => CloseOnEscape ? Close() : Task.CompletedTask;

    private async Task Close()
    {
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleOverlayClick()
    {
        if (CloseOnOverlayClick)
            await Close();
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        if (_sheet is not null) await _sheet.DisposeAsync();
        if (_topLayer is not null) await _topLayer.DisposeAsync();
        _dotNetRef?.Dispose();
        if (_scope is not null) await _scope.DisposeAsync();
    }
}
