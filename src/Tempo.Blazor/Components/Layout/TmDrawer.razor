@namespace Tempo.Blazor.Components.Layout
@using Tempo.Blazor.Abstractions.Layout
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Icons
@inherits Tempo.Blazor.Components.TmComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (IsOpen)
{
    @if (ShowOverlay && Modal)
    {
        <div class="tm-drawer__overlay" @onclick="HandleOverlayClick"></div>
    }

    <TmFocusScope @ref="_scope"
                  Active="true"
                  Modal="Modal"
                  Class="@RootClass"
                  AriaLabelledBy="@LabelledBy"
                  CloseOnEscape="CloseOnEscape"
                  OnEscape="HandleEscape"
                  AdditionalAttributes="RootAttributes">

        <div @ref="_panel" class="tm-drawer__panel" style="@PanelStyle">
            @if (IsSheet && ShowHandle)
            {
                <button type="button"
                        @ref="_handle"
                        class="tm-drawer__handle"
                        role="slider"
                        aria-label="@Loc["TmDrawer_DragHandle"]"
                        aria-valuemin="0"
                        aria-valuemax="@(_snaps.Length - 1)"
                        aria-valuenow="@_snapIndex"
                        aria-orientation="vertical"
                        @onkeydown="HandleHandleKey">
                    <span class="tm-drawer__handle-bar"></span>
                </button>
            }

            <div class="tm-drawer__header">
                @if (HeaderContent is not null)
                {
                    @HeaderContent
                }
                else if (!string.IsNullOrEmpty(Title))
                {
                    <h2 id="@_titleId" class="tm-drawer__title">@Title</h2>
                }

                @if (ShowCloseButton)
                {
                    <button type="button"
                            class="tm-drawer__close"
                            aria-label="@Loc["TmDrawer_Close"]"
                            @onclick="Close">
                        <TmIcon Name="x" Size="IconSize.Sm" />
                    </button>
                }
            </div>

            <div class="tm-drawer__body">
                @ChildContent
            </div>

            @if (FooterContent is not null)
            {
                <div class="tm-drawer__footer @(IsSheet ? "tm-drawer__footer--sticky" : null)">
                    @FooterContent
                </div>
            }
        </div>
    </TmFocusScope>
}

@code {
    private static readonly double[] DefaultSnaps = [0.5, 1.0];

    /// <summary>Whether the drawer is open.</summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>Fires when the drawer should open or close.</summary>
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>Side from which the drawer slides in.</summary>
    [Parameter] public DrawerPosition Position { get; set; } = DrawerPosition.Right;

    /// <summary>Width of the drawer panel. Ignored by a bottom sheet, which sizes from its snap point.</summary>
    [Parameter] public string Width { get; set; } = "400px";

    /// <summary>Title shown in the header.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Show a semi-transparent backdrop behind the drawer.</summary>
    [Parameter] public bool ShowOverlay { get; set; } = true;

    /// <summary>Close the drawer when clicking the overlay.</summary>
    [Parameter] public bool CloseOnOverlayClick { get; set; } = true;

    /// <summary>Close the drawer when pressing Escape.</summary>
    [Parameter] public bool CloseOnEscape { get; set; } = true;

    /// <summary>Show the X close button in the header.</summary>
    [Parameter] public bool ShowCloseButton { get; set; } = true;

    /// <summary>
    /// Whether the drawer is modal. A non-modal drawer renders inside its container with no overlay
    /// and no inert background, so the page behind it stays usable.
    /// </summary>
    [Parameter] public bool Modal { get; set; } = true;

    /// <summary>
    /// Fractions of the viewport height a bottom sheet snaps to, in ascending order. Defaults to a
    /// half-height sheet and a full-height one. A sheet needs at least one.
    /// </summary>
    [Parameter] public IReadOnlyList<double> SnapPoints { get; set; } = DefaultSnaps;

    /// <summary>
    /// Whether a downward swipe past the lowest snap dismisses the sheet. The gesture itself lives in
    /// the drawer module; this flag is what the stylesheet and the tests read.
    /// </summary>
    [Parameter] public bool SwipeToDismiss { get; set; } = true;

    /// <summary>
    /// Whether a bottom sheet renders its drag handle. The handle is also the keyboard control for the
    /// snap points, so turning it off removes both. A side drawer never renders one.
    /// </summary>
    [Parameter] public bool ShowHandle { get; set; } = true;

    /// <summary>
    /// The layout the sheet renders. <see cref="TmLayoutMode.Auto"/> follows the viewport scope; a
    /// forced value never measures, so a test can render a mode without a DOM.
    /// </summary>
    [Parameter] public TmLayoutMode LayoutMode { get; set; } = TmLayoutMode.Auto;

    /// <summary>
    /// The layout rendered before the first measurement. Desktop unless the host says otherwise, so a
    /// phone host can avoid flashing the desktop sheet.
    /// </summary>
    [Parameter] public TmLayoutMode InitialMode { get; set; } = TmLayoutMode.Desktop;

    /// <summary>
    /// Raised when the rendered layout changes. The initial value is not a change. Never pair
    /// <see cref="LayoutMode"/> with this callback: it reports the resolved mode, and a two-way bind
    /// would pin that mode.
    /// </summary>
    [Parameter] public EventCallback<TmLayoutMode> ResolvedLayoutChanged { get; set; }

    /// <summary>Custom header content (replaces Title).</summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    /// <summary>Main body content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Optional footer with action buttons.</summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>Additional CSS class for the root element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Additional HTML attributes for the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>The viewport's layout. A sheet is positioned against the viewport, not its container.</summary>
    [CascadingParameter(Name = TmLayoutScopes.Viewport)] public TmLayoutContext? Viewport { get; set; }

    private const string SheetModulePath = "./_content/Tempo.Blazor/js/tm-sheet.js";

    private readonly string _titleId = $"tm-drawer-title-{Guid.NewGuid():N}";
    private readonly string _sheetId = Guid.NewGuid().ToString("N");
    private ElementReference _handle;
    private ElementReference _panel;
    private IJSObjectReference? _sheetModule;
    private DotNetObjectReference<TmDrawer>? _dotNetRef;
    private bool _gestureAttached;
    private TmFocusScope? _scope;
    private TmLayoutMode? _lastReported;
    private int _snapIndex;

    private bool IsSheet => Position == DrawerPosition.Bottom;

    private double[] _snaps => SnapPoints.Count > 0
        ? SnapPoints.OrderBy(s => s).ToArray()
        : throw new ArgumentException("A sheet needs at least one snap point.", nameof(SnapPoints));

    private string SnapList => string.Join(",", _snaps.Select(s => s.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)));

    private string SwipeFlag => SwipeToDismiss ? "true" : "false";

    private string? LabelledBy => !string.IsNullOrEmpty(Title) && HeaderContent is null ? _titleId : null;

    private TmLayoutContext Context
    {
        get
        {
            var resolved = TmLayout.Resolve(LayoutMode, Viewport, null, InitialMode);
            return new TmLayoutContext(LayoutMode, resolved);
        }
    }

    private Dictionary<string, object> RootAttributes
    {
        get
        {
            var attributes = new Dictionary<string, object>
            {
                ["data-layout"] = Context.CssModifier,
                ["data-snap-points"] = SnapList,
                ["data-snap-index"] = _snapIndex,
                ["data-swipe-to-dismiss"] = SwipeFlag,
                ["data-max-height"] = "85"
            };

            if (AdditionalAttributes is not null)
            {
                foreach (var pair in AdditionalAttributes)
                {
                    attributes[pair.Key] = pair.Value;
                }
            }

            return attributes;
        }
    }

    private string RootClass
    {
        get
        {
            var classes = new List<string> { "tm-drawer", PositionClass };
            if (!Modal) classes.Add("tm-drawer--inline");
            if (!string.IsNullOrEmpty(Class)) classes.Add(Class);
            return string.Join(" ", classes);
        }
    }

    private string PositionClass => Position switch
    {
        DrawerPosition.Left => "tm-drawer--left",
        DrawerPosition.Bottom => "tm-drawer--bottom",
        _ => "tm-drawer--right"
    };

    private string PanelStyle => IsSheet
        ? $"--tm-sheet-height: {_snaps[Math.Clamp(_snapIndex, 0, _snaps.Length - 1)].ToString(System.Globalization.CultureInfo.InvariantCulture)}"
        : $"width: {Width}";

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && IsSheet && !_gestureAttached)
        {
            _gestureAttached = true;
            await AttachGestureAsync();
        }
        else if ((!IsOpen || !IsSheet) && _gestureAttached)
        {
            _gestureAttached = false;
            await DetachGestureAsync();
        }
    }

    private async Task AttachGestureAsync()
    {
        try
        {
            _sheetModule ??= await JS.InvokeAsync<IJSObjectReference>("import", SheetModulePath);
            _dotNetRef ??= DotNetObjectReference.Create(this);
            // The handle is the gesture target when there is one; without it the panel itself follows
            // the finger, so a sheet that hides its grabber still tracks the keyboard.
            var target = ShowHandle ? _handle : _panel;
            await _sheetModule.InvokeVoidAsync("attach", target, _panel, _snaps, SwipeToDismiss, _dotNetRef, _sheetId);
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }

    private async Task DetachGestureAsync()
    {
        if (_sheetModule is null) return;
        try
        {
            await _sheetModule.InvokeVoidAsync("detach", _sheetId);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    /// <summary>Invoked by the sheet module when a downward swipe passes the lowest snap.</summary>
    [JSInvokable]
    public Task HandleSheetDismissedAsync() => Close();

    /// <summary>Invoked by the sheet module when a gesture settles on a snap. Not implemented yet.</summary>
    [JSInvokable]
    public Task HandleSheetSnappedAsync(int index) => Task.CompletedTask;

    /// <summary>The snap the sheet renders. Two-way with <see cref="SnapIndexChanged"/>.</summary>
    [Parameter] public int SnapIndex { get; set; }

    /// <summary>Raised when the rendered snap changes.</summary>
    [Parameter] public EventCallback<int> SnapIndexChanged { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (IsSheet && SnapPoints.Count == 0)
        {
            throw new ArgumentException("A sheet needs at least one snap point.", nameof(SnapPoints));
        }

        ReportResolved();
    }

    private void ReportResolved()
    {
        var resolved = Context.Resolved;
        if (_lastReported == resolved) return;

        var first = _lastReported is null;
        _lastReported = resolved;
        if (!first)
        {
            _ = ResolvedLayoutChanged.InvokeAsync(resolved);
        }
    }

    private async Task HandleHandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowUp")
        {
            _snapIndex = Math.Min(_snapIndex + 1, _snaps.Length - 1);
        }
        else if (e.Key == "ArrowDown")
        {
            if (_snapIndex == 0)
            {
                await Close();
                return;
            }

            _snapIndex--;
        }
    }

    private Task HandleEscape() => HandleFocusTrapEscapeAsync();

    /// <summary>
    /// Invoked when Escape is pressed at the document level. Kept on the drawer so a host that wired
    /// the old JSInvokable keeps working; the scope is what the module actually calls.
    /// </summary>
    [JSInvokable]
    public async Task HandleFocusTrapEscapeAsync()
    {
        if (CloseOnEscape)
        {
            await Close();
        }
    }

    private async Task Close()
    {
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleOverlayClick()
    {
        if (CloseOnOverlayClick)
            await Close();
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        await DetachGestureAsync();
        if (_sheetModule is not null)
        {
            try { await _sheetModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
        }

        _dotNetRef?.Dispose();
        if (_scope is not null)
        {
            await _scope.DisposeAsync();
        }
    }
}
