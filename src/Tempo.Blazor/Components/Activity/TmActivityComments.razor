@namespace Tempo.Blazor.Components.Activity
@implements IDisposable
@using Tempo.Blazor.Components.Avatars
@using Tempo.Blazor.Components.DataDisplay
@using Tempo.Blazor.Abstractions.Shared
@using Microsoft.AspNetCore.Components

<div class="tm-comments">
    @if (!Comments.Any() && !_showEditor)
    {
        <div class="tm-comments-empty">
            <TmEmptyState Title="@Loc["TmActivityComments_Empty"]" />
        </div>
    }
    else
    {
        <ul class="tm-comment-list">
            @foreach (var comment in Comments)
            {
                var c = comment;
                var authorName = GetAuthorName(c);
                <li class="tm-comment-item">
                    <div class="tm-comment-avatar">
                        @if (!string.IsNullOrEmpty(c.Author.AvatarUrl))
                        {
                            <TmAvatar Src="@c.Author.AvatarUrl" Name="@authorName" Size="AvatarSize.Sm" />
                        }
                        else
                        {
                            <TmAvatar Name="@authorName" Size="AvatarSize.Sm" />
                        }
                    </div>
                    <div class="tm-comment-body">
                        <div class="tm-comment-meta">
                            <span class="tm-comment-author">@authorName</span>
                            <time class="tm-comment-time" datetime="@c.CreatedAt.UtcDateTime.ToString("yyyy-MM-ddTHH:mm:ssZ", CultureInfo.InvariantCulture)" title="@AbsoluteTime(c.CreatedAt)">
                                @FormatRelativeTime(c.CreatedAt)
                            </time>
                            @if (c.EditedAt.HasValue)
                            {
                                <span class="tm-comment-edited">(@Loc["TmActivityComments_Edited"])</span>
                            }
                        </div>
                        @if (_editingCommentId == c.Id)
                        {
                            <div class="tm-comment-editor">
                                <TmRichEditorSimple @bind-Value="_editorContent" />
                                <div class="tm-comment-editor-actions">
                                    <button class="tm-btn tm-btn-primary tm-btn-sm tm-comment-submit-btn"
                                            type="button"
                                            @onclick="() => SubmitEditAsync(c.Id)">
                                        @Loc["Tm_Save"]
                                    </button>
                                    <button class="tm-link-button tm-comment-cancel-btn"
                                            type="button"
                                            @onclick="CancelEdit">
                                        @Loc["Tm_Cancel"]
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="tm-comment-content">
                                @if (c.BodyFormat == TmCommentBodyFormat.Html)
                                {
                                    @((MarkupString)c.Body)
                                }
                                else
                                {
                                    @c.Body
                                }
                            </div>
                            <div class="tm-comment-actions">
                                @if (c.CanEdit)
                                {
                                    <button class="tm-link-button tm-comment-edit-btn"
                                            type="button"
                                            @onclick="() => StartEdit(c)">
                                        @Loc["Tm_Edit"]
                                    </button>
                                }
                                @if (c.CanDelete)
                                {
                                    <button class="tm-link-button tm-comment-delete-btn"
                                            type="button"
                                            @onclick="() => DeleteCommentAsync(c.Id)">
                                        @Loc["Tm_Delete"]
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </li>
            }
        </ul>
    }

    @if (ShowAddButton && !_showEditor)
    {
        <button class="tm-btn tm-btn-outline tm-btn-sm tm-comments-add-btn"
                type="button"
                @onclick="ShowEditor">
            @Loc["TmActivityComments_AddComment"]
        </button>
    }

    @if (_showEditor && _editingCommentId is null)
    {
        <div class="tm-comment-editor">
            <TmRichEditorSimple @bind-Value="_editorContent" 
                              Placeholder="@Loc["TmActivityComments_AddComment"]" />
            <div class="tm-comment-editor-actions">
                <button class="tm-btn tm-btn-primary tm-btn-sm tm-comment-submit-btn"
                        type="button"
                        @onclick="SubmitNewCommentAsync">
                    @Loc["TmActivityComments_SubmitComment"]
                </button>
                <button class="tm-link-button tm-comment-cancel-btn"
                        type="button"
                        @onclick="CancelEditor">
                    @Loc["Tm_Cancel"]
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<TmCommentEntry> Comments { get; set; } = [];
    [Parameter] public EventCallback<string> OnCommentAdded { get; set; }
    [Parameter] public EventCallback<string> OnCommentDeleted { get; set; }
    [Parameter] public EventCallback<(string Id, string Html)> OnCommentEdited { get; set; }
    [Parameter] public bool ShowAddButton { get; set; } = true;

    private bool _showEditor;
    private string? _editingCommentId;
    private string _editorContent = string.Empty;

    /// <summary>Public refresh hook – parents can await this after updating <see cref="Comments"/>.</summary>
    public Task RefreshAsync()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Used by tests to inject content into the editor without JS.</summary>
    public void SetEditorContentForTest(string html)
    {
        _editorContent = html;
        StateHasChanged();
    }

    private void ShowEditor()
    {
        _editorContent = string.Empty;
        _showEditor = true;
    }

    private void CancelEditor()
    {
        _showEditor = false;
        _editorContent = string.Empty;
    }

    private void StartEdit(TmCommentEntry comment)
    {
        _editingCommentId = comment.Id;
        _editorContent = comment.Body;
    }

    private void CancelEdit()
    {
        _editingCommentId = null;
        _editorContent = string.Empty;
    }

    private async Task SubmitNewCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(_editorContent)) return;
        await OnCommentAdded.InvokeAsync(_editorContent);
        CancelEditor();
    }

    private async Task SubmitEditAsync(string commentId)
    {
        if (string.IsNullOrWhiteSpace(_editorContent)) return;
        await OnCommentEdited.InvokeAsync((commentId, _editorContent));
        _editingCommentId = null;
        _editorContent = string.Empty;
    }

    private async Task DeleteCommentAsync(string commentId)
    {
        await OnCommentDeleted.InvokeAsync(commentId);
    }

    [Inject] private IServiceProvider Services { get; set; } = default!;

    private ITmRelativeTimeFormatter? _relativeTime;

    /// <summary>Re-renders the stamps once the user zone arrives (the default registration via AddTempoBlazor()).</summary>
    private TmUserZoneObserver? _userZoneObserver;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // After the first INTERACTIVE render: prerender has no JS interop, and the probe runs once
        // per circuit. No-op unless the host registered ITmUserTimeZone (AddTempoBlazor does).
        _userZoneObserver ??= TmUserZoneObserver.Subscribe(Services, () => InvokeAsync(StateHasChanged));
        if (_userZoneObserver is not null)
        {
            await _userZoneObserver.ProbeAsync();
        }
    }

    public void Dispose() => _userZoneObserver?.Dispose();

    /// <summary>The shared relative-time formatter (B19) - this component used to carry its own copy.</summary>
    private string FormatRelativeTime(DateTimeOffset dt)
        => (_relativeTime ??= TmRelativeTime.Resolve(Services, Loc)).Format(dt);

    private string AbsoluteTime(DateTimeOffset dt)
        => (_relativeTime ??= TmRelativeTime.Resolve(Services, Loc)).Absolute(dt);

    private static string GetAuthorName(TmCommentEntry comment)
        => !string.IsNullOrWhiteSpace(comment.Author.DisplayName)
            ? comment.Author.DisplayName
            : comment.Author.Id;
}
