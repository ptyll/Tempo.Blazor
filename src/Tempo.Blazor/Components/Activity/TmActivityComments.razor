@namespace Tempo.Blazor.Components.Activity
@implements IDisposable
@implements ITmDraftGuard
@using Tempo.Blazor.Components.Avatars
@using Tempo.Blazor.Components.DataDisplay
@using Tempo.Blazor.Abstractions.Shared
@using Microsoft.AspNetCore.Components

<div class="tm-comments">
    @if (!Comments.Any() && !_showEditor)
    {
        <div class="tm-comments-empty">
            <TmEmptyState Title="@Loc["TmActivityComments_Empty"]" />
        </div>
    }
    else
    {
        <ul class="tm-comment-list">
            @foreach (var comment in Comments)
            {
                var c = comment;
                var authorName = GetAuthorName(c);
                <li class="tm-comment-item@(c.IsInternal ? " tm-comment-item--internal" : "")"
                    data-comment-id="@c.Id"
                    data-internal="@(c.IsInternal ? "true" : "false")">
                    <div class="tm-comment-avatar">
                        @if (!string.IsNullOrEmpty(c.Author.AvatarUrl))
                        {
                            <TmAvatar Src="@c.Author.AvatarUrl" Name="@authorName" Size="AvatarSize.Sm" />
                        }
                        else
                        {
                            <TmAvatar Name="@authorName" Size="AvatarSize.Sm" />
                        }
                    </div>
                    <div class="tm-comment-body">
                        <div class="tm-comment-meta">
                            <span class="tm-comment-author">@authorName</span>
                            <time class="tm-comment-time" datetime="@c.CreatedAt.UtcDateTime.ToString("yyyy-MM-ddTHH:mm:ssZ", CultureInfo.InvariantCulture)" title="@AbsoluteTime(c.CreatedAt)">
                                @FormatRelativeTime(c.CreatedAt)
                            </time>
                            @if (c.EditedAt.HasValue)
                            {
                                <span class="tm-comment-edited">(@Loc["TmActivityComments_Edited"])</span>
                            }
                            @if (c.IsInternal)
                            {
                                <TmBadge Variant="BadgeVariant.Warning"
                                         Size="BadgeSize.Sm"
                                         BadgeStyle="BadgeStyle.Subtle"
                                         Pill="true"
                                         Icon="@IconNames.Lock"
                                         Class="tm-comment-internal-label"
                                         title="@Loc["TmActivityComments_InternalBadgeTitle"]">
                                    @Loc["TmActivityComments_InternalBadge"]<span class="tm-sr-only">: @Loc["TmActivityComments_InternalBadgeTitle"]</span>
                                </TmBadge>
                            }
                            @foreach (var badge in c.Badges ?? [])
                            {
                                if (!badge.IsValid)
                                {
                                    continue;
                                }

                                var tone = badge.Tone.ToString().ToLowerInvariant();
                                <TmBadge Variant="@MapBadgeVariant(badge.Tone)"
                                         Size="BadgeSize.Sm"
                                         BadgeStyle="BadgeStyle.Subtle"
                                         Pill="true"
                                         Icon="@badge.Icon"
                                         Class="tm-comment-badge"
                                         title="@badge.Title"
                                         data-badge-tone="@tone">
                                    @badge.Text@if (!string.IsNullOrWhiteSpace(badge.Title))
                                    {
                                        <span class="tm-sr-only">: @badge.Title</span>
                                    }
                                </TmBadge>
                            }
                        </div>
                        @if (_editingCommentId == c.Id)
                        {
                            <div class="tm-comment-editor">
                                <span class="tm-sr-only" role="status" aria-live="polite">@_editLive</span>
                                <TmRichEditorSimple @ref="_editEditor"
                                                    @bind-Value="_editorContent"
                                                    @bind-Value:after="NotifyDraftChangedAsync"
                                                    IsDisabled="@_isSubmitting"
                                                    SupportsMentions="@MentionsEnabled"
                                                    MentionProvider="@MentionProvider" />
                                <div class="tm-comment-editor-actions">
                                    <button class="tm-btn tm-btn-primary tm-btn-sm tm-comment-submit-btn"
                                            type="button"
                                            aria-disabled="@(_isSubmitting ? "true" : null)"
                                            @onclick="() => SubmitEditAsync(c.Id)">
                                        @Loc["Tm_Save"]
                                    </button>
                                    <button class="tm-link-button tm-comment-cancel-btn"
                                            type="button"
                                            @onclick="CancelEdit">
                                        @Loc["Tm_Cancel"]
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="tm-comment-content">
                                @if (c.BodyFormat == TmCommentBodyFormat.Html)
                                {
                                    @((MarkupString)c.Body)
                                }
                                else
                                {
                                    @c.Body
                                }
                            </div>
                            @if (c.CanEdit || c.CanDelete || CommentActions is not null)
                            {
                                <div class="tm-comment-actions">
                                    @if (c.CanEdit)
                                    {
                                        <button class="tm-link-button tm-comment-edit-btn"
                                                type="button"
                                                @onclick="() => StartEdit(c)">
                                            @Loc["Tm_Edit"]
                                        </button>
                                    }
                                    @if (c.CanDelete)
                                    {
                                        <button class="tm-link-button tm-comment-delete-btn"
                                                type="button"
                                                @onclick="() => DeleteCommentAsync(c.Id)">
                                            @Loc["Tm_Delete"]
                                        </button>
                                    }
                                    @if (CommentActions is not null)
                                    {
                                        @* Consumer content only. No key handler and no tabindex here:
                                           native buttons activate themselves; a non-native control
                                           inside the fragment must emulate Enter/Space on its own
                                           (docs/keyboard-activation-convention.md). *@
                                        <span class="tm-comment-actions__custom">
                                            @CommentActions(c)
                                        </span>
                                    }
                                </div>
                            }
                        }
                    </div>
                </li>
            }
        </ul>
    }

    @if (ShowAddButton && !_showEditor && _editingCommentId is null)
    {
        <button class="tm-btn tm-btn-outline tm-btn-sm tm-comments-add-btn"
                type="button"
                @onclick="ShowEditor">
            @Loc["TmActivityComments_AddComment"]
        </button>
    }

    @if (_showEditor && _editingCommentId is null)
    {
        <div class="tm-comment-editor@(_composerInternal ? " tm-comment-editor--internal" : "")">
            <span class="tm-sr-only" role="status" aria-live="polite">@_composerLive</span>
            <TmRichEditorSimple @ref="_composerEditor"
                                @bind-Value="_editorContent"
                                @bind-Value:after="NotifyDraftChangedAsync"
                                Placeholder="@Loc["TmActivityComments_AddComment"]"
                                IsDisabled="@_isSubmitting"
                                SupportsMentions="@MentionsEnabled"
                                MentionProvider="@MentionProvider" />
            <div class="tm-comment-editor-actions">
                @if (ShowInternalToggle)
                {
                    @* Native switch (role=switch on TmToggle's checkbox). Space flips it;
                       no keydown emulation. The hint is the accessible description, not a
                       second name. Colour is not the only cue: the label stays visible. *@
                    <TmToggle Class="tm-comment-internal-toggle"
                              Value="@_composerInternal"
                              ValueChanged="SetComposerInternalAsync"
                              Disabled="@_isSubmitting"
                              Label="@Loc["TmActivityComments_InternalToggle"]"
                              AriaDescribedBy="@_internalToggleHintId" />
                    <span id="@_internalToggleHintId" class="tm-sr-only tm-comment-internal-toggle-hint">@Loc["TmActivityComments_InternalToggleHint"]</span>
                }
                <button class="tm-btn tm-btn-primary tm-btn-sm tm-comment-submit-btn"
                        type="button"
                        aria-disabled="@(_isSubmitting ? "true" : null)"
                        @onclick="SubmitNewCommentAsync">
                    @Loc["TmActivityComments_SubmitComment"]
                </button>
                <button class="tm-link-button tm-comment-cancel-btn"
                        type="button"
                        @onclick="CancelEditor">
                    @Loc["Tm_Cancel"]
                </button>
            </div>
        </div>
    }
</div>

@code {
    /// <summary>
    /// Comments to render. An entry with <see cref="TmCommentEntry.IsInternal"/> is painted with
    /// the internal wash, <see cref="IconNames.Lock"/> and the localized "Internal" label; it is never hidden —
    /// the consumer or server filters visibility. Valid <see cref="TmCommentEntry.Badges"/> render
    /// in the meta row. Defaults to an empty list.
    /// </summary>
    [Parameter] public IReadOnlyList<TmCommentEntry> Comments { get; set; } = [];

    /// <summary>
    /// Optional save handler for a NEW comment. When set, it runs INSTEAD of
    /// <see cref="OnCommentSubmitted"/> and <see cref="OnCommentAdded"/>. Return
    /// <see langword="true"/> when the comment was saved: the editor closes and clears, and the
    /// internal switch resets. Return <see langword="false"/> when the save failed: the editor
    /// stays open with the typed text and the internal-switch state preserved, the component
    /// announces the non-save through its aria-live status (the consumer presents the actual
    /// reason), and no draft transition is reported. The handler is expected to convert its own
    /// failures to <see langword="false"/> — an exception propagates like an exception from the
    /// legacy callbacks (the in-flight flag still clears in <c>finally</c> and the editor stays
    /// open). Null (default) keeps the legacy callbacks, order unchanged.
    /// </summary>
    [Parameter] public Func<TmCommentSubmission, Task<bool>>? CommentSubmitHandler { get; set; }

    /// <summary>
    /// Raised with the submitted HTML when the user posts a new comment. Stays for hosts that
    /// only need the body. Prefer <see cref="OnCommentSubmitted"/> when the host must also know
    /// whether the composer was in internal mode — that callback fires first, then this one, with
    /// the same HTML. Both stay; neither replaces the other. Neither runs when
    /// <see cref="CommentSubmitHandler"/> is set — the handler replaces them.
    /// </summary>
    [Parameter] public EventCallback<string> OnCommentAdded { get; set; }

    /// <summary>
    /// Raised when the user posts a NEW comment, before <see cref="OnCommentAdded"/>, with the
    /// HTML and the composer internal flag. Document order is fixed: this callback, then
    /// <see cref="OnCommentAdded"/>. An edit does not raise it — changing an existing comment's
    /// visibility is the consumer's job (see <see cref="CommentActions"/>). An effectively empty
    /// composer raises neither callback. When this callback has no delegate, only
    /// <see cref="OnCommentAdded"/> runs. Neither runs when <see cref="CommentSubmitHandler"/> is
    /// set — the handler replaces them.
    /// </summary>
    [Parameter] public EventCallback<TmCommentSubmission> OnCommentSubmitted { get; set; }

    /// <summary>
    /// Passes mention autocomplete through to the new-comment composer and the inline editor.
    /// Without <see cref="MentionProvider"/> the editor stays off even when this is true — no
    /// exception, no empty picker. Defaults to false.
    /// </summary>
    [Parameter] public bool SupportsMentions { get; set; }

    /// <summary>
    /// People source for the composer and inline-editor mention picker. Null (or
    /// <see cref="SupportsMentions"/> false) leaves autocomplete off.
    /// </summary>
    [Parameter] public ITmPeopleProvider? MentionProvider { get; set; }

    /// <summary>
    /// Shows the internal switch in the new-comment composer footer. Off by default. The inline
    /// editor never shows it. After a successful post, cancel, or <see cref="DiscardDraftAsync"/>
    /// the switch returns to off. It is disabled while the post is in flight.
    /// </summary>
    [Parameter] public bool ShowInternalToggle { get; set; }

    /// <summary>Raised with the comment id when the user deletes a comment.</summary>
    [Parameter] public EventCallback<string> OnCommentDeleted { get; set; }

    /// <summary>
    /// Optional save handler for an inline edit. When set, it runs INSTEAD of
    /// <see cref="OnCommentEdited"/>, with the same data in a named <see cref="TmCommentEdit"/>
    /// record. Return <see langword="true"/> when the save succeeded: the inline editor closes.
    /// Return <see langword="false"/> when it failed: the inline editor stays open with the
    /// edited text and the dirty draft state is preserved; the consumer presents the reason.
    /// The handler is expected to convert its own failures to <see langword="false"/> — an
    /// exception propagates like an exception from <see cref="OnCommentEdited"/> (the in-flight
    /// flag still clears in <c>finally</c> and the editor stays open). Null (default) keeps
    /// <see cref="OnCommentEdited"/>, behavior unchanged.
    /// </summary>
    [Parameter] public Func<TmCommentEdit, Task<bool>>? CommentEditHandler { get; set; }

    /// <summary>
    /// Raised with the comment id and the new HTML when the user saves an edit. Does not run
    /// when <see cref="CommentEditHandler"/> is set — the handler replaces it.
    /// </summary>
    [Parameter] public EventCallback<(string Id, string Html)> OnCommentEdited { get; set; }

    /// <summary>Shows the Add comment button when no editor is open. Defaults to true.</summary>
    [Parameter] public bool ShowAddButton { get; set; } = true;

    /// <summary>
    /// Consumer actions rendered after the built-in Edit and Delete buttons, inside
    /// <c>.tm-comment-actions</c> wrapped by <c>.tm-comment-actions__custom</c>, once per comment
    /// with that comment's <see cref="TmCommentEntry"/>. The component does not interpret the
    /// fragment: the consumer supplies its own button and any confirmation dialog (for example an
    /// admin toggle between internal and public). The component never hides an internal comment —
    /// flipping <see cref="TmCommentEntry.IsInternal"/> is the consumer's job.
    /// <para>
    /// The actions row renders when the comment can be edited or deleted, or when this fragment is
    /// set; it is omitted entirely when none of those apply, so an empty row is never painted.
    /// While that comment is being edited inline the row (built-in buttons and this fragment) is
    /// hidden; other comments keep theirs.
    /// </para>
    /// <para>
    /// The wrapper is not focusable and does not handle keys, so it does not change tab order.
    /// Put a native <c>&lt;button&gt;</c> (or <c>TmButton</c>) in the fragment — the browser
    /// activates it. A non-native focusable must emulate Enter and Space itself; see
    /// <c>docs/keyboard-activation-convention.md</c>.
    /// </para>
    /// </summary>
    [Parameter] public RenderFragment<TmCommentEntry>? CommentActions { get; set; }

    /// <summary>
    /// Notifies the parent that the comment draft state changed. Fires ONLY when the
    /// <see cref="TmCommentDraftState"/> value actually changes (value-equality dedup), never on
    /// every keystroke — the record carries flags only, and repeated identical states are
    /// suppressed so parents are not re-rendered while the user types. Members:
    /// <see cref="TmCommentDraftState.IsEditorOpen"/> (an editor is visible),
    /// <see cref="TmCommentDraftState.EditingCommentId"/> (which comment is being edited, null
    /// for a new comment) and <see cref="TmCommentDraftState.HasUnsavedContent"/>.
    /// <para>
    /// Clicking Edit while a dirty new-comment draft exists discards that draft: both editors
    /// share one content slot, so starting the edit replaces the new-comment content with the
    /// comment's original body. The consumer observes this as a state transition (for example
    /// <c>(true, null, true)</c> → <c>(true, "c1", false)</c>), not as a separate event — treat
    /// any transition away from a dirty new-comment state as a discard. The inverse holds too:
    /// while an inline edit is open the Add button is hidden, and opening the new-comment editor
    /// by other means ends the edit and discards its content the same way (for example
    /// <c>(true, "c1", true)</c> → <c>(true, null, false)</c>).
    /// </para>
    /// <para>
    /// The edit comparison is against the body as supplied (no HTML normalization): browser
    /// HTML normalization may keep the flag set after the user types and reverts.
    /// </para>
    /// </summary>
    [Parameter] public EventCallback<TmCommentDraftState> OnDraftChanged { get; set; }

    /// <summary>Per-instance hint id — two composers on one page must not share it.</summary>
    private readonly string _internalToggleHintId = "tm-comment-internal-hint-" + Guid.NewGuid().ToString("N")[..8];

    private bool _showEditor;
    private string? _editingCommentId;
    private string _editorContent = string.Empty;
    private bool _composerInternal;
    private bool _isSubmitting;
    private string _composerLive = string.Empty;

    /// <summary>
    /// Polite live-region text of the INLINE editor. Empty unless the last edit save reported
    /// <see langword="false"/> — the not-saved announcement — cleared again by
    /// <see cref="StartEdit"/>, <see cref="CancelEdit"/> and <see cref="DiscardDraftAsync"/>.
    /// </summary>
    private string _editLive = string.Empty;

    /// <summary>
    /// Bumped by every editor open/close/target change (<see cref="ShowEditor"/>,
    /// <see cref="CancelEditor"/>, <see cref="StartEdit"/>, <see cref="CancelEdit"/>,
    /// <see cref="DiscardDraftAsync"/>). A submit that was in flight while the target changed
    /// must not close the NEW target: the generation captured before the await is compared
    /// after it, and the shared close is skipped on mismatch.
    /// </summary>
    private int _draftGeneration;

    /// <summary>Autocomplete is on only when the host asked for it AND supplied a provider.</summary>
    private bool MentionsEnabled => SupportsMentions && MentionProvider is not null;

    private TmRichEditorSimple? _composerEditor;
    private TmRichEditorSimple? _editEditor;

    /// <summary>
    /// Body of the comment as it was when its edit started — the baseline for the
    /// differs-from-original semantics of <see cref="TmCommentDraftState.HasUnsavedContent"/>
    /// on the edit path (opening an edit without changes is not an unsaved draft).
    /// </summary>
    private string _editorOriginalContent = string.Empty;

    /// <summary>Last draft state handed to the parent — used to dedup <see cref="OnDraftChanged"/> notifications.</summary>
    private TmCommentDraftState _lastDraftState = new(false, null, false);

    /// <summary>Public refresh hook – parents can await this after updating <see cref="Comments"/>.</summary>
    public Task RefreshAsync()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Whether the component currently holds an unsaved comment draft — the SAME value carried
    /// by the <see cref="TmCommentDraftState.HasUnsavedContent"/> flag that
    /// <see cref="OnDraftChanged"/> reports. Read live from the current editor state (not from
    /// the last notification), so consumers can poll it at any time, for example before a page
    /// refresh or retry that would silently discard the draft.
    /// <para>
    /// Read it on the component's dispatcher (e.g. from an event handler or via
    /// <c>InvokeAsync</c>) when called from a background thread.
    /// </para>
    /// </summary>
    public bool HasUnsavedDraft => BuildDraftState().HasUnsavedContent;

    /// <summary>
    /// Closes the open editor (new comment or inline edit) and clears its content. Intended for
    /// the consumer AFTER the user confirmed the discard in the consumer's OWN confirmation
    /// dialog — the component never shows a confirmation itself; that is deliberately the
    /// consumer's responsibility. Typical flow: <see cref="HasUnsavedDraft"/> reports a draft,
    /// the consumer asks, and on confirmation calls this method so the editor does not stay
    /// open with the old text and the next reload does not ask again.
    /// <para>
    /// Doubles as recovery when the comment being edited was removed from <see cref="Comments"/>
    /// by a parent refresh: the inline editor closes and the draft state resets, as if the user
    /// had cancelled.
    /// </para>
    /// <para>
    /// When nothing is open the call is a no-op — the state does not change and the
    /// value-equality dedup suppresses any <see cref="OnDraftChanged"/> notification.
    /// Safe to call from outside the render cycle; the reset, re-render and notification are
    /// dispatched through <c>InvokeAsync</c>.
    /// </para>
    /// </summary>
    public Task DiscardDraftAsync()
        => InvokeAsync(async () =>
        {
            _showEditor = false;
            _editingCommentId = null;
            _editorContent = string.Empty;
            _editorOriginalContent = string.Empty;
            _composerInternal = false;
            _composerLive = string.Empty;
            _editLive = string.Empty;
            _draftGeneration++;
            StateHasChanged();
            await NotifyDraftChangedAsync();
        });

    /// <summary>Used by tests to inject content into the editor without JS.</summary>
    /// <remarks>
    /// Kept for compatibility with existing callers of the original <see langword="void"/> API.
    /// The draft-changed notification runs fire-and-forget; callers that must observe the
    /// notification before continuing should prefer <see cref="SetEditorContentForTestAsync"/>.
    /// </remarks>
    public void SetEditorContentForTest(string html) => _ = SetEditorContentForTestAsync(html);

    /// <summary>Used by tests to inject content into the editor without JS.</summary>
    /// <remarks>
    /// Returns a <see cref="Task"/> so the draft notification can be awaited before the caller
    /// continues. Call sites of the form
    /// <c>await cut.InvokeAsync(() => cut.Instance.SetEditorContentForTestAsync(html))</c>
    /// bind the lambda to the <c>Func&lt;Task&gt;</c> overload of <c>InvokeAsync</c> and await the
    /// returned task, exactly mirroring the real user-typing path where <c>ValueChanged</c>
    /// flows through <see cref="NotifyDraftChangedAsync"/>.
    /// </remarks>
    public Task SetEditorContentForTestAsync(string html)
    {
        _editorContent = html;
        StateHasChanged();
        return NotifyDraftChangedAsync();
    }

    /// <summary>
    /// Whether the currently open editor holds content that would be lost on discard. Two
    /// branches, deliberately different:
    /// <para>
    /// <b>Edit of an existing comment</b> (<c>_editingCommentId</c> set): the editor opens
    /// pre-filled with the comment's original body, so "has content" would report an unsaved
    /// draft the moment the edit opens. The draft only exists once the content differs from
    /// that original body — compared ordinally, exactly as the component holds it, without HTML
    /// trimming. Reverting the content back to the original body therefore clears the flag
    /// again; the comparison is stateless, not a "changed once" latch.
    /// </para>
    /// <para>
    /// <b>New comment</b> (editor open, no comment being edited): the editor starts empty, so
    /// any content that is not effectively empty (see <see cref="IsEffectivelyEmpty"/>) is
    /// already an unsaved draft — markup-only artifacts such as a bare <c>&lt;br&gt;</c> left
    /// behind by the browser do not count.
    /// </para>
    /// </summary>
    private bool HasUnsavedContent
        => _editingCommentId is not null
            ? !string.Equals(_editorContent, _editorOriginalContent, StringComparison.Ordinal)
            : _showEditor && !IsEffectivelyEmpty(_editorContent);

    /// <summary>
    /// Empty detection for the draft and submit guards. Uses the same set as
    /// <see cref="TmRichEditorSimple"/>'s placeholder logic (whitespace-only values and the
    /// bare-break / empty-container markup browsers leave behind when the editor is emptied),
    /// extended with <c>&lt;p&gt;&lt;br&gt;&lt;/p&gt;</c>, so markup that would render the
    /// editor's placeholder also does not surface as an unsaved draft.
    /// </summary>
    private static bool IsEffectivelyEmpty(string? html)
        => string.IsNullOrWhiteSpace(html)
            || html == "<br>"
            || html == "<br/>"
            || html == "<br />"
            || html == "<div><br></div>"
            || html == "<p><br></p>";

    /// <summary>
    /// Builds the current draft snapshot. <see cref="TmCommentDraftState.IsEditorOpen"/> is
    /// <see langword="true"/> while either editor is visible;
    /// <see cref="TmCommentDraftState.EditingCommentId"/> identifies the comment under edit;
    /// <see cref="TmCommentDraftState.HasUnsavedContent"/> follows
    /// <see cref="HasUnsavedContent"/> — any content beyond effectively-empty markup for a new
    /// comment, content differing from the original body for an edit (see the remarks on
    /// <see cref="HasUnsavedContent"/>).
    /// </summary>
    private TmCommentDraftState BuildDraftState()
        => new(
            _showEditor || _editingCommentId is not null,
            _editingCommentId,
            HasUnsavedContent,
            _composerInternal && _editingCommentId is null);

    private async Task SetComposerInternalAsync(bool value)
    {
        if (_isSubmitting) return;
        _composerInternal = value;
        _composerLive = value ? Loc["TmActivityComments_InternalModeOn"] : string.Empty;
        await NotifyDraftChangedAsync();
    }

    /// <summary>
    /// Notifies <see cref="OnDraftChanged"/> only when the draft state actually changed. The dedup
    /// is mandatory: both editors report content changes into this method (via
    /// the editors' bind after-hook, i.e. per keystroke in real usage), and without the value-equality
    /// check each keystroke would invoke the callback and re-render the parent; the record's value
    /// equality makes the comparison cheap and exact.
    /// </summary>
    private async Task NotifyDraftChangedAsync()
    {
        var state = BuildDraftState();
        if (state == _lastDraftState)
        {
            return;
        }

        _lastDraftState = state;
        await OnDraftChanged.InvokeAsync(state);
    }

    private async Task ShowEditor()
    {
        // Only one draft at a time — mirror of StartEdit, which closes the new-comment editor.
        // Opening the new-comment editor during an active inline edit must END the edit first;
        // both editors share _editorContent, so without this the edit's text would be wiped
        // silently while the edit stayed visibly open.
        _editingCommentId = null;
        _editorContent = string.Empty;
        _editorOriginalContent = string.Empty;
        _composerInternal = false;
        _composerLive = string.Empty;
        _editLive = string.Empty;
        _draftGeneration++;
        _showEditor = true;
        await NotifyDraftChangedAsync();
    }

    private async Task CancelEditor()
    {
        _showEditor = false;
        _editorContent = string.Empty;
        _editorOriginalContent = string.Empty;
        _composerInternal = false;
        _composerLive = string.Empty;
        _draftGeneration++;
        await NotifyDraftChangedAsync();
    }

    private async Task StartEdit(TmCommentEntry comment)
    {
        // Only one draft at a time: both editors share _editorContent, so a new-comment
        // draft must not survive starting an edit of an existing comment.
        _showEditor = false;
        _composerInternal = false;
        _composerLive = string.Empty;
        _editLive = string.Empty;
        _editingCommentId = comment.Id;
        _editorContent = comment.Body;
        _editorOriginalContent = comment.Body;
        _draftGeneration++;
        await NotifyDraftChangedAsync();
    }

    private async Task CancelEdit()
    {
        _editingCommentId = null;
        _editorContent = string.Empty;
        _editorOriginalContent = string.Empty;
        _editLive = string.Empty;
        _draftGeneration++;
        await NotifyDraftChangedAsync();
    }

    private async Task SubmitNewCommentAsync()
    {
        if (_isSubmitting || IsEffectivelyEmpty(_editorContent)) return;

        var html = _editorContent;
        var isInternal = _composerInternal;
        var generation = _draftGeneration;
        var submittingText = Loc["TmActivityComments_Submitting"];
        _isSubmitting = true;
        _composerLive = submittingText;
        StateHasChanged();
        try
        {
            if (CommentSubmitHandler is not null)
            {
                // Handler replaces both legacy callbacks. false keeps the editor open with the
                // typed text and the internal-switch state; the aria-live status announces the
                // non-save while the consumer presents the actual reason.
                if (!await CommentSubmitHandler(new TmCommentSubmission(html, isInternal)))
                {
                    _composerLive = Loc["TmActivityComments_SubmitNotSaved"];
                    StateHasChanged();
                    return;
                }
            }
            else
            {
                // Document order, pinned: OnCommentSubmitted, then OnCommentAdded. Same HTML.
                if (OnCommentSubmitted.HasDelegate)
                {
                    await OnCommentSubmitted.InvokeAsync(new TmCommentSubmission(html, isInternal));
                }

                await OnCommentAdded.InvokeAsync(html);
            }
        }
        finally
        {
            _isSubmitting = false;
            // An exception left the in-flight status up — reset it (the false path already
            // replaced it with the not-saved announcement, and a success closes via CancelEditor,
            // so only reset when nobody else touched the text).
            if (_composerLive == submittingText) _composerLive = string.Empty;
        }

        // Close through the shared CancelEditor only when THIS submit still owns the open
        // composer: the user may have cancelled it (or started an edit) while the save was
        // in flight, and a blind CancelEditor would wipe the new draft.
        if (_draftGeneration == generation)
        {
            await CancelEditor();
        }
    }

    private async Task SubmitEditAsync(string commentId)
    {
        // Deliberately IsNullOrWhiteSpace, not IsEffectivelyEmpty — the edit-submit guard stays unchanged to preserve existing edit behaviour.
        if (_isSubmitting || string.IsNullOrWhiteSpace(_editorContent)) return;
        _isSubmitting = true;
        StateHasChanged();
        try
        {
            if (CommentEditHandler is not null)
            {
                // Handler replaces OnCommentEdited. false keeps the inline editor open with the
                // edited text and announces the non-save through the inline editor's aria-live
                // status; the consumer presents the failure reason.
                if (!await CommentEditHandler(new TmCommentEdit(commentId, _editorContent)))
                {
                    _editLive = Loc["TmActivityComments_SubmitNotSaved"];
                    StateHasChanged();
                    return;
                }
            }
            else
            {
                await OnCommentEdited.InvokeAsync((commentId, _editorContent));
            }
        }
        finally
        {
            _isSubmitting = false;
        }

        // Close through the shared CancelEdit only when the SAME comment is still being
        // edited — the user may have switched to another comment's edit while the save was
        // in flight, and a blind CancelEdit would close that editor and wipe its content.
        if (_editingCommentId == commentId)
        {
            await CancelEdit();
        }
    }

    private async Task DeleteCommentAsync(string commentId)
    {
        await OnCommentDeleted.InvokeAsync(commentId);
    }

    [Inject] private IServiceProvider Services { get; set; } = default!;

    private ITmRelativeTimeFormatter? _relativeTime;

    /// <summary>Re-renders the stamps once the user zone arrives (the default registration via AddTempoBlazor()).</summary>
    private TmUserZoneObserver? _userZoneObserver;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // After the first INTERACTIVE render: prerender has no JS interop, and the probe runs once
        // per circuit. No-op unless the host registered ITmUserTimeZone (AddTempoBlazor does).
        _userZoneObserver ??= TmUserZoneObserver.Subscribe(Services, () => InvokeAsync(StateHasChanged));
        if (_userZoneObserver is not null)
        {
            await _userZoneObserver.ProbeAsync();
        }
    }

    public void Dispose() => _userZoneObserver?.Dispose();

    /// <summary>The shared relative-time formatter (B19) - this component used to carry its own copy.</summary>
    private string FormatRelativeTime(DateTimeOffset dt)
        => (_relativeTime ??= TmRelativeTime.Resolve(Services, Loc)).Format(dt);

    private string AbsoluteTime(DateTimeOffset dt)
        => (_relativeTime ??= TmRelativeTime.Resolve(Services, Loc)).Absolute(dt);

    private static string GetAuthorName(TmCommentEntry comment)
        => !string.IsNullOrWhiteSpace(comment.Author.DisplayName)
            ? comment.Author.DisplayName
            : comment.Author.Id;

    /// <summary>
    /// Maps a comment-badge tone onto <see cref="BadgeVariant"/>. Neutral → Default and
    /// Accent → Primary: <c>TmBadge</c> has no Accent variant, and Primary is the library's
    /// emphasis colour (not a status). The other tones match by name.
    /// </summary>
    private static BadgeVariant MapBadgeVariant(TmCommentBadgeTone tone) => tone switch
    {
        TmCommentBadgeTone.Info => BadgeVariant.Info,
        TmCommentBadgeTone.Success => BadgeVariant.Success,
        TmCommentBadgeTone.Warning => BadgeVariant.Warning,
        TmCommentBadgeTone.Danger => BadgeVariant.Danger,
        TmCommentBadgeTone.Accent => BadgeVariant.Primary,
        _ => BadgeVariant.Default
    };
}
