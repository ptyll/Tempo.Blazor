@namespace Tempo.Blazor.Components.Activity
@using Tempo.Blazor.Abstractions.Shared

<div class="tm-activity-log">
    <div class="tm-activity-tabs" role="tablist">
        @if (ShowTimeline)
        {
            <button class="tm-activity-tab @ActiveClass(ActivityTab.Timeline)"
                    type="button"
                    role="tab"
                    id="tm-activity-tab-timeline"
                    aria-selected="@(_activeTab == ActivityTab.Timeline)"
                    @onclick="() => _activeTab = ActivityTab.Timeline">
                @Loc["TmActivityLog_TimelineTab"]
            </button>
        }
        @if (ShowComments)
        {
            <button class="tm-activity-tab @ActiveClass(ActivityTab.Comments)"
                    type="button"
                    role="tab"
                    id="tm-activity-tab-comments"
                    aria-selected="@(_activeTab == ActivityTab.Comments)"
                    @onclick="() => _activeTab = ActivityTab.Comments">
                @Loc["TmActivityLog_CommentsTab"]
                @if (Comments.Count > 0)
                {
                    <span class="tm-tab-badge">@Comments.Count</span>
                }
            </button>
        }
        @if (ShowAttachments)
        {
            <button class="tm-activity-tab @ActiveClass(ActivityTab.Attachments)"
                    type="button"
                    role="tab"
                    id="tm-activity-tab-attachments"
                    aria-selected="@(_activeTab == ActivityTab.Attachments)"
                    @onclick="() => _activeTab = ActivityTab.Attachments">
                @Loc["TmActivityLog_AttachmentsTab"]
                @if (Attachments.Count > 0)
                {
                    <span class="tm-tab-badge">@Attachments.Count</span>
                }
            </button>
        }
    </div>

    <div class="tm-activity-content" role="tabpanel" aria-labelledby="@GetActiveTabId()">
        @switch (_activeTab)
        {
            case ActivityTab.Timeline:
                <TmActivityTimeline @ref="_timelineRef"
                                    Entries="TimelineEntries"
                                    Filter="@TimelineFilter"
                                    EntryTypeFilter="@TimelineEntryTypeFilter"
                                    EntryTypeFilterOptions="TimelineEntryTypeFilterOptions"
                                    PageSize="TimelinePageSize"
                                    ShowFilterBar="ShowTimelineFilterBar"
                                    DataProvider="TimelineDataProvider" />
                break;
            case ActivityTab.Comments:
                <TmActivityComments @ref="_commentsRef"
                                    Comments="Comments"
                                    OnCommentAdded="OnCommentAdded"
                                    OnCommentSubmitted="OnCommentSubmitted"
                                    OnCommentDeleted="OnCommentDeleted"
                                    CommentSubmitHandler="CommentSubmitHandler"
                                    CommentEditHandler="CommentEditHandler"
                                    CommentActions="CommentActions"
                                    SupportsMentions="SupportsMentions"
                                    MentionProvider="MentionProvider"
                                    ShowInternalToggle="ShowInternalToggle" />
                break;
            case ActivityTab.Attachments:
                <TmActivityAttachments @ref="_attachmentsRef"
                                       Attachments="Attachments"
                                       AttachmentProvider="AttachmentProvider"
                                       FileProvider="FileProvider"
                                       EntityId="EntityId"
                                       EntityType="EntityType" />
                break;
        }
    </div>
</div>

@code {
    private enum ActivityTab { Timeline, Comments, Attachments }

    // ── Parameters ────────────────────────────────────────────────
    [Parameter] public string? EntityId { get; set; }
    [Parameter] public string EntityType { get; set; } = "activity-entity";
    [Parameter] public IReadOnlyList<ITimelineEntry> TimelineEntries { get; set; } = [];
    [Parameter] public IReadOnlyList<TmCommentEntry> Comments { get; set; } = [];
    [Parameter] public IReadOnlyList<TmAttachment> Attachments { get; set; } = [];
    [Parameter] public ITmAttachmentProvider? AttachmentProvider { get; set; }
    [Parameter] public ITmFileProvider? FileProvider { get; set; }
    [Parameter] public bool ShowTimeline { get; set; } = true;
    [Parameter] public bool ShowComments { get; set; } = true;
    [Parameter] public bool ShowAttachments { get; set; } = true;
    /// <summary>Raised with the submitted HTML when the user posts a new comment. Stays for hosts that only need the body; prefer <see cref="OnCommentSubmitted"/> when the internal flag matters. Forwarded to <c>TmActivityComments</c>.</summary>
    [Parameter] public EventCallback<string> OnCommentAdded { get; set; }

    /// <summary>Raised before <see cref="OnCommentAdded"/> with the HTML and the composer internal flag. Forwarded unchanged; the log does not interpret or filter internal comments.</summary>
    [Parameter] public EventCallback<TmCommentSubmission> OnCommentSubmitted { get; set; }

    /// <summary>Optional save handler for a NEW comment, forwarded to <c>TmActivityComments</c>. When set it replaces <see cref="OnCommentSubmitted"/> and <see cref="OnCommentAdded"/> there: return <see langword="true"/> to close the editor, <see langword="false"/> to keep the draft open. Null (default) keeps the legacy callbacks, order unchanged.</summary>
    [Parameter] public Func<TmCommentSubmission, Task<bool>>? CommentSubmitHandler { get; set; }

    /// <summary>Optional save handler for an inline edit, forwarded to <c>TmActivityComments</c>. When set it replaces <c>OnCommentEdited</c> there: return <see langword="true"/> to close the inline editor, <see langword="false"/> to keep the edited text. Null (default) keeps the legacy callback.</summary>
    [Parameter] public Func<TmCommentEdit, Task<bool>>? CommentEditHandler { get; set; }

    /// <summary>Raised with the comment id when the user deletes a comment. Forwarded to <c>TmActivityComments</c>.</summary>
    [Parameter] public EventCallback<string> OnCommentDeleted { get; set; }

    /// <summary>Consumer actions rendered after the built-in Edit and Delete buttons, once per comment. Forwarded; the log does not interpret the fragment.</summary>
    [Parameter] public RenderFragment<TmCommentEntry>? CommentActions { get; set; }

    /// <summary>Passes mention autocomplete through to the comments tab. Without <see cref="MentionProvider"/> the editor stays off even when this is true. Defaults to false.</summary>
    [Parameter] public bool SupportsMentions { get; set; }

    /// <summary>People source for the comments-tab mention picker. Null (or <see cref="SupportsMentions"/> false) leaves autocomplete off.</summary>
    [Parameter] public ITmPeopleProvider? MentionProvider { get; set; }

    /// <summary>Shows the internal switch in the new-comment composer. Off by default. The log never hides the resulting comment — the consumer filters visibility.</summary>
    [Parameter] public bool ShowInternalToggle { get; set; }

    // ── Timeline filtering + pagination (K10, additive) ───────────
    /// <summary>Optional free-text filter forwarded to the timeline tab (author, content, entry type).</summary>
    [Parameter] public string? TimelineFilter { get; set; }
    /// <summary>Optional entry-type filter forwarded to the timeline tab; null/empty shows all types.</summary>
    [Parameter] public string? TimelineEntryTypeFilter { get; set; }
    /// <summary>Optional explicit entry-type options for the timeline filter bar.</summary>
    [Parameter] public IReadOnlyList<string>? TimelineEntryTypeFilterOptions { get; set; }
    /// <summary>Page size for the timeline tab's incremental "load more" paging. <c>null</c> (default) shows every entry.</summary>
    [Parameter] public int? TimelinePageSize { get; set; }
    /// <summary>When true, the timeline tab renders a built-in search + type filter bar (default: false).</summary>
    [Parameter] public bool ShowTimelineFilterBar { get; set; }
    /// <summary>Optional async data provider for the timeline tab (server-side filtering + pagination).</summary>
    [Parameter] public ITimelineDataProvider? TimelineDataProvider { get; set; }

    // ── State ─────────────────────────────────────────────────────
    private ActivityTab _activeTab = ActivityTab.Timeline;
    private TmActivityTimeline? _timelineRef;
    private TmActivityComments? _commentsRef;
    private TmActivityAttachments? _attachmentsRef;

    protected override void OnParametersSet()
    {
        // Default to Timeline; if hidden, use first visible tab
        if (!ShowTimeline && _activeTab == ActivityTab.Timeline)
            _activeTab = ShowComments ? ActivityTab.Comments : ActivityTab.Attachments;
    }

    /// <summary>Re-renders all child tabs; call after external data updates.</summary>
    public async Task RefreshAsync()
    {
        if (_timelineRef is not null) await _timelineRef.RefreshAsync();
        if (_commentsRef is not null) await _commentsRef.RefreshAsync();
        if (_attachmentsRef is not null) await _attachmentsRef.RefreshAsync();
    }

    private string ActiveClass(ActivityTab tab) =>
        _activeTab == tab ? "tm-activity-tab-active" : string.Empty;

    private string GetActiveTabId() => _activeTab switch
    {
        ActivityTab.Timeline => "tm-activity-tab-timeline",
        ActivityTab.Comments => "tm-activity-tab-comments",
        ActivityTab.Attachments => "tm-activity-tab-attachments",
        _ => "tm-activity-tab-timeline"
    };
}
