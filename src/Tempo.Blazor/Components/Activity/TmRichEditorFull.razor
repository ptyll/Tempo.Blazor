@namespace Tempo.Blazor.Components.Activity
@using Tempo.Blazor.Abstractions.Shared
@using Tempo.Blazor.Interfaces
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="tm-rich-editor-full @(IsDisabled ? "tm-rte-disabled" : "") @(Class)"
     style="@GetHeightStyle()"
     @attributes="AdditionalAttributes">
    
    <EditorToolbar
        Mode="ToolbarMode.Full"
        IsDisabled="@IsDisabled"
        OnFormat="@HandleFormat"
        OnEmojiSelected="@HandleEmojiSelected"
        ActiveFormats="@_activeFormats"
        SupportsTokens="@SupportsTokens"
        OnTokenButtonClicked="@HandleTokenButtonClicked" />
    
    <div class="tm-rte-editor-content-wrapper">
        <div class="tm-rte-editor-content"
             id="@_editorId"
             @ref="_editorRef"
             contenteditable="@(!IsDisabled)"
             @oninput="@HandleInput"
             @onfocus="@HandleFocus"
             @onblur="@HandleBlur"
             @onkeydown="@HandleKeyDown"
             @onkeydown:preventDefault="@_suppressKeyDown"
             data-placeholder="@Placeholder">
        </div>
        
        @if (_isEmpty && !string.IsNullOrEmpty(Placeholder))
        {
            <div class="tm-rte-placeholder">@Placeholder</div>
        }
    </div>
    
    @if (MaxLength > 0 || ShowWordCount)
    {
        <div class="tm-rte-footer">
            @if (ShowWordCount)
            {
                <span class="tm-rte-word-count">
                    @_wordCount words
                </span>
            }
            @if (MaxLength > 0)
            {
                <span class="tm-rte-char-count @(IsOverLimit ? "tm-rte-char-count-over" : "")">
                    @_charCount / @MaxLength characters
                </span>
            }
        </div>
    }

    @* Dialogs — FZE-10: each one is a TmModal (top layer, Escape, focus trap); on close focus
       returns to the editor surface via RestoreFocusTargetId and the host replays the saved
       caret/selection (saveCursorPosition/restoreCursorPosition in richEditor.js). *@
    @if (_showLinkDialog)
    {
        <LinkDialog
            IsVisible="true"
            PreselectedText="@_selectedText"
            RestoreFocusTargetId="@_editorId"
            OnConfirm="@OnLinkConfirm"
            OnCancel="@OnLinkCancel" />
    }

    @* Image Dialog *@
    @if (_showImageDialog)
    {
        <ImageDialog
            IsVisible="true"
            RestoreFocusTargetId="@_editorId"
            OnConfirm="@OnImageConfirm"
            OnCancel="@OnImageCancel" />
    }

    @* Table Dialog *@
    @if (_showTableDialog)
    {
        <TableDialog
            IsVisible="true"
            RestoreFocusTargetId="@_editorId"
            OnConfirm="@OnTableConfirm"
            OnCancel="@OnTableCancel" />
    }

    @* Video Dialog *@
    @if (_showVideoDialog)
    {
        <VideoDialog
            IsVisible="true"
            RestoreFocusTargetId="@_editorId"
            OnConfirm="@OnVideoConfirm"
            OnCancel="@OnVideoCancel" />
    }

    @* Find/Replace Dialog — top-anchored, stays open across replaces; the host passes the real
       replacement counts (from tmRichEditor.findAndReplace) back for the result line. *@
    @if (_showFindReplaceDialog)
    {
        <FindReplaceDialog
            IsVisible="true"
            RestoreFocusTargetId="@_editorId"
            OnReplace="@OnReplace"
            OnReplaceAll="@OnReplaceAll"
            OnCancel="@OnFindReplaceCancel" />
    }

    @* Mention Dropdown *@
    @if (_showMentionDropdown && SupportsMentions)
    {
        <MentionAutocomplete
            IsVisible="true"
            Users="@_mentionUsers"
            Query="@_mentionQuery"
            HighlightedIndex="@_highlightedMentionIndex"
            OnUserSelected="@OnMentionSelected"
            OnHighlightedIndexChanged="@OnMentionIndexChanged" />
    }

    @* Token Dropdown *@
    @if (_showTokenDropdown && SupportsTokens)
    {
        <TokenAutocomplete
            IsVisible="true"
            Tokens="@_availableTokens"
            Query="@_tokenQuery"
            HighlightedIndex="@_tokenHighlightedIndex"
            IsLoading="@_isLoadingTokens"
            SupportsCreation="@(TokenProvider?.SupportsCreation ?? false)"
            OnTokenSelected="@OnTokenSelected"
            OnCreateRequested="@OnTokenCreateFromDropdown"
            OnHighlightedIndexChanged="@OnTokenIndexChanged" />
    }
</div>

