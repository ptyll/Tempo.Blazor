@namespace Tempo.Blazor.Components.Activity
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Buttons

@* FZE-10: rendered on the core TmModal primitive — top layer, role="dialog", named title,
   Escape and the shared focus trap. The fields sit in a real <form>: Enter in a number field
   submits it through the footer's type=submit button. The grid preview is mouse-only, so it is
   aria-hidden; the live size label carries the same information for assistive technology. *@
<TmModal Show="@IsVisible"
         Title="@Loc["TmRichEditor_TableDialog_Title"]"
         Size="ModalSize.Small"
         Class="tm-rte-table-dialog tm-rte-dialog"
         CloseOnOverlayClick="@CloseOnBackdropClick"
         CloseOnEscape="true"
         ShowCloseButton="true"
         RestoreFocusTargetId="@RestoreFocusTargetId"
         InitialFocusTargetId="@_rowsInputId"
         OnClose="HandleClose">

    <ChildContent>
    <form id="@_formId" @onsubmit="InsertTable" @onsubmit:preventDefault novalidate>
        <div class="tm-rte-form-row">
            <div class="tm-rte-form-group">
                <label for="@_rowsInputId">@Loc["TmRichEditor_TableDialog_Rows"]</label>
                <input type="number"
                       id="@_rowsInputId"
                       class="tm-rte-table-rows-input"
                       min="1"
                       max="20"
                       @bind="_rows" />
            </div>
            <div class="tm-rte-form-group">
                <label for="@_colsInputId">@Loc["TmRichEditor_TableDialog_Cols"]</label>
                <input type="number"
                       id="@_colsInputId"
                       class="tm-rte-table-cols-input"
                       min="1"
                       max="10"
                       @bind="_cols" />
            </div>
        </div>
    </form>

    @* Visual grid preview — pointer-only sizing aid, hidden from the accessibility tree; the
       aria-live label below announces the same choice. *@
    <div class="tm-rte-table-preview">
        <div class="tm-rte-table-preview-label" aria-hidden="true">@Loc["TmRichEditor_TableDialog_Preview"]</div>
        <div class="tm-rte-table-grid" aria-hidden="true" @onmouseleave="ClearHover">
            @for (int r = 1; r <= 8; r++)
            {
                <div class="tm-rte-table-grid-row">
                    @for (int c = 1; c <= 6; c++)
                    {
                        var row = r;
                        var col = c;
                        <div class="tm-rte-table-grid-cell @GetCellClass(row, col)"
                             @onmouseover="() => OnCellHover(row, col)"
                             @onclick="() => SelectGridSize(row, col)">
                        </div>
                    }
                </div>
            }
        </div>
        <div class="tm-rte-table-size-label" aria-live="polite">@_rows × @_cols</div>
    </div>

    </ChildContent>

    <Footer>
        <TmButton Variant="ButtonVariant.Ghost"
                  OnClick="HandleClose"
                  Class="tm-rte-btn-cancel">
            @Loc["Tm_Cancel"]
        </TmButton>
        <TmButton Variant="ButtonVariant.Primary"
                  Type="ButtonType.Submit"
                  Disabled="@(!IsValid())"
                  Class="tm-rte-btn-insert"
                  AdditionalAttributes="@(new Dictionary<string, object> { ["form"] = _formId })">
            @Loc["TmRichEditor_TableDialog_Insert"]
        </TmButton>
    </Footer>
</TmModal>

@code {
    /// <summary>
    /// Whether the dialog is visible.
    /// </summary>
    [Parameter] public bool IsVisible { get; set; }

    /// <summary>
    /// Whether to close on backdrop click.
    /// </summary>
    [Parameter] public bool CloseOnBackdropClick { get; set; } = true;

    /// <summary>
    /// Callback when table is confirmed.
    /// </summary>
    [Parameter] public EventCallback<(int Rows, int Cols)> OnConfirm { get; set; }

    /// <summary>
    /// Callback when dialog is cancelled (Escape, backdrop, close or cancel button).
    /// </summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>
    /// The id of the element focus returns to when the dialog closes — the host editor's
    /// content surface, so the caret that opened the dialog is not lost.
    /// </summary>
    [Parameter] public string? RestoreFocusTargetId { get; set; }

    private int _rows = 3;
    private int _cols = 3;
    private int _hoverRow = 0;
    private int _hoverCol = 0;

    // Per-instance ids: the input ids stay unique when a page hosts several editors.
    private string _idSuffix { get; } = Guid.NewGuid().ToString("N")[..8];
    private string _rowsInputId => $"tm-rte-table-rows-{_idSuffix}";
    private string _colsInputId => $"tm-rte-table-cols-{_idSuffix}";
    private string _formId => $"tm-rte-table-form-{_idSuffix}";

    private bool IsValid() => _rows > 0 && _rows <= 20 && _cols > 0 && _cols <= 10;

    private void OnCellHover(int row, int col)
    {
        _hoverRow = row;
        _hoverCol = col;
    }

    private void ClearHover()
    {
        _hoverRow = 0;
        _hoverCol = 0;
    }

    private string GetCellClass(int row, int col)
    {
        var isSelected = row <= _rows && col <= _cols;
        var isHovered = row <= _hoverRow && col <= _hoverCol;

        if (isHovered && _hoverRow > 0) return "hovered";
        if (isSelected) return "selected";
        return "";
    }

    private void SelectGridSize(int row, int col)
    {
        _rows = row;
        _cols = col;
    }

    private async Task InsertTable()
    {
        // Re-validate on submit: Enter in a number field runs this path too.
        if (!IsValid()) return;

        await OnConfirm.InvokeAsync((_rows, _cols));
        Reset();
    }

    private async Task HandleClose()
    {
        await OnCancel.InvokeAsync();
    }

    private void Reset()
    {
        _rows = 3;
        _cols = 3;
        _hoverRow = 0;
        _hoverCol = 0;
    }
}
