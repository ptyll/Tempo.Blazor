@namespace Tempo.Blazor.Components.Activity
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="tm-markdown-editor @(_isFocused ? "tm-mde-focused" : "") @(IsDisabled ? "tm-mde-disabled" : "") @(Class ?? "")"
     @attributes="AdditionalAttributes">

    <MarkdownToolbar
        IsDisabled="@IsDisabled"
        ActiveFormats="@_activeFormats"
        OnFormat="@HandleFormat" />

    <div class="tm-mde-content-wrapper">
        <div class="tm-mde-content"
             id="@_editorId"
             @ref="_editorRef"
             contenteditable="@(!IsDisabled ? "true" : "false")"
             @oninput="@HandleInput"
             @onfocus="@HandleFocus"
             @onblur="@HandleBlur"
             @onkeydown="@HandleKeyDown"
             @onkeydown:preventDefault="@_suppressKeyDown"
             spellcheck="true"
             data-placeholder="@Placeholder">
        </div>

        @if (_isEmpty && !string.IsNullOrEmpty(Placeholder))
        {
            <div class="tm-mde-placeholder">@Placeholder</div>
        }
    </div>

    @if (MaxLength > 0)
    {
        <div class="tm-mde-footer">
            <span class="tm-mde-char-count @(IsOverLimit ? "tm-mde-char-count-over" : "")">
                @_charCount / @MaxLength
            </span>
        </div>
    }

    @if (_showLinkDialog)
    {
        // FZE-10: the link dialog is a TmModal; on close focus returns to the editor surface and
        // the host replays the saved caret/selection.
        <LinkDialog
            IsVisible="true"
            PreselectedText="@_linkPreselectedText"
            RestoreFocusTargetId="@_editorId"
            OnConfirm="@OnLinkConfirm"
            OnCancel="@OnLinkCancel" />
    }

    @if (_showTableDialog)
    {
        <TableDialog
            IsVisible="true"
            RestoreFocusTargetId="@_editorId"
            OnConfirm="@OnTableConfirm"
            OnCancel="@OnTableCancel" />
    }
</div>

@code {
    /// <summary>
    /// The markdown content of the editor. Binding this parameter gives you raw markdown — no HTML.
    /// </summary>
    [Parameter] public string Value { get; set; } = string.Empty;

    /// <summary>
    /// Callback fired whenever the markdown content changes.
    /// </summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>
    /// Placeholder text displayed when the editor is empty.
    /// </summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>
    /// Maximum number of characters allowed. 0 = unlimited.
    /// </summary>
    [Parameter] public int MaxLength { get; set; }

    /// <summary>
    /// Disables the editor and toolbar.
    /// </summary>
    [Parameter] public bool IsDisabled { get; set; }

    /// <summary>
    /// Callback fired when the user submits content with Ctrl+Enter.
    /// </summary>
    [Parameter] public EventCallback OnSubmit { get; set; }

    /// <summary>
    /// Additional CSS class applied to the root container.
    /// </summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Additional HTML attributes applied to the root container.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // ── Private state ──────────────────────────────────────────────────────────

    private ElementReference _editorRef;

    /// <summary>Stable per-instance id of the content surface; the dialogs restore focus to it.</summary>
    private string _editorId { get; } = $"tm-mde-editor-{Guid.NewGuid().ToString("N")[..8]}";

    private List<string> _activeFormats = new();
    private bool _isFocused;
    private bool _isEmpty = true;
    private int _charCount;
    private bool _showLinkDialog;
    private string? _linkPreselectedText;
    private bool _showTableDialog;
    private bool _suppressKeyDown;
    private bool _isInitialized;
    private bool _isUpdatingFromJs;     // guards OnAfterRenderAsync sync loop
    private string _lastSyncedValue = string.Empty;

    // FZE-10 review: the dialog UNMOUNTS before the caret bookmark is replayed and the insert
    // runs (the TmModal focus trap owns inert/focus while rendered). The confirm/cancel
    // handlers only close the dialog and stash what happens next; OnAfterRenderAsync replays
    // it once the render WITHOUT the dialog completed.
    private Func<Task>? _pendingAfterDialogClose;
    private bool _restoreCaretAfterDialogClose;

    /// <summary>
    /// True while a dialog is open. The OnAfterRenderAsync sync must not run then — the parent's
    /// Value may be stale relative to the live editor DOM and an external setValue would clobber
    /// the user's content (the same guard <c>_isUpdatingFromJs</c> provides for input sync).
    /// </summary>
    private bool AnyDialogOpen => _showLinkDialog || _showTableDialog;

    private bool IsOverLimit => MaxLength > 0 && _charCount > MaxLength;

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override void OnParametersSet()
    {
        UpdateEmptyState();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                if (!string.IsNullOrEmpty(Value))
                {
                    await JS.InvokeVoidAsync("tmMarkdownEditor.setValue", _editorRef, Value);
                }
                await JS.InvokeVoidAsync("tmMarkdownEditor.init", _editorRef);
                _lastSyncedValue = Value;
                _isInitialized = true;
            }
            catch { /* JS not available in SSR / tests */ }
        }
        else if (!AnyDialogOpen && (_pendingAfterDialogClose is not null || _restoreCaretAfterDialogClose))
        {
            // The dialog just unmounted — the focus trap released the editor, so the caret
            // bookmark can be replayed and the stashed insert can run. Both interop calls are
            // best-effort: a JSException/JSDisconnectedException here runs on the render
            // pipeline and would kill a Blazor Server circuit.
            var restore = _restoreCaretAfterDialogClose;
            var insert = _pendingAfterDialogClose;
            _restoreCaretAfterDialogClose = false;
            _pendingAfterDialogClose = null;
            if (restore)
            {
                await RestoreCursorBookmarkAsync();
            }
            if (insert is not null)
            {
                try
                {
                    await insert();
                }
                catch (JSException) { }
                catch (JSDisconnectedException) { }
                catch (TaskCanceledException) { }
            }
        }
        else if (_isInitialized && !_isUpdatingFromJs && !AnyDialogOpen)
        {
            // Sync externally-changed Value into the editor DOM
            if (Value != _lastSyncedValue)
            {
                try
                {
                    await JS.InvokeVoidAsync("tmMarkdownEditor.setValue", _editorRef, Value ?? "");
                    _lastSyncedValue = Value;
                }
                catch { }
            }
        }
    }

    // ── Input handling ─────────────────────────────────────────────────────────

    private async Task HandleInput()
    {
        _isUpdatingFromJs = true;
        try
        {
            var markdown = await JS.InvokeAsync<string>("tmMarkdownEditor.getValue", _editorRef);
            Value = markdown ?? string.Empty;
            _lastSyncedValue = Value;
            UpdateEmptyState();
            await ValueChanged.InvokeAsync(Value);

            // Update toolbar active-format indicators
            await UpdateActiveFormatsAsync();

            await InvokeAsync(StateHasChanged);
        }
        catch { /* JS not available in SSR / tests */ }
        finally
        {
            _isUpdatingFromJs = false;
        }
    }

    // ── Focus / blur ───────────────────────────────────────────────────────────

    private void HandleFocus()
    {
        _isFocused = true;
    }

    private void HandleBlur()
    {
        _isFocused = false;
    }

    // ── Keyboard ───────────────────────────────────────────────────────────────

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        _suppressKeyDown = false;

        if (e.CtrlKey && e.Key == "Enter")
        {
            _suppressKeyDown = true;
            await Submit();
        }
    }

    // ── Format dispatch ────────────────────────────────────────────────────────

    private async Task HandleFormat(string format)
    {
        if (IsDisabled) return;

        try
        {
            switch (format)
            {
                // Inline formats — toggle on/off
                case "bold":
                case "italic":
                case "strikethrough":
                case "code":
                    await JS.InvokeVoidAsync("tmMarkdownEditor.toggleFormat", _editorRef, format);
                    break;

                // Block types — toggle (same type → paragraph)
                case "h1":
                case "h2":
                case "h3":
                case "ul":
                case "ol":
                    await JS.InvokeVoidAsync("tmMarkdownEditor.setBlockType", _editorRef, format);
                    break;
                case "blockquote":
                    await JS.InvokeVoidAsync("tmMarkdownEditor.setBlockType", _editorRef, "bq");
                    break;

                // Block inserts
                case "codeblock":
                    await JS.InvokeVoidAsync("tmMarkdownEditor.insertCodeBlock", _editorRef);
                    break;
                case "hr":
                    await JS.InvokeVoidAsync("tmMarkdownEditor.insertHr", _editorRef);
                    break;

                // Table — open dialog
                case "table":
                    await SaveCursorBookmarkAsync();
                    _showTableDialog = true;
                    await InvokeAsync(StateHasChanged);
                    return;

                // Link — open dialog, capture selected text as preset
                case "link":
                    _linkPreselectedText = await JS.InvokeAsync<string>("tmMarkdownEditor.getSelectedText", _editorRef);
                    await SaveCursorBookmarkAsync();
                    _showLinkDialog = true;
                    await InvokeAsync(StateHasChanged);
                    return; // skip value sync below — dialog handles it
            }

            await SyncValueFromEditorAsync();
        }
        catch { /* JS not available in SSR / tests */ }
    }

    // ── Link dialog ────────────────────────────────────────────────────────────

    private async Task OnLinkConfirm((string Url, string Text) link)
    {
        // Close first — the trap must release before the caret bookmark is replayed; the
        // insert itself runs from OnAfterRenderAsync once the dialog is not rendered.
        _showLinkDialog = false;
        _restoreCaretAfterDialogClose = true;
        _pendingAfterDialogClose = async () =>
        {
            await JS.InvokeVoidAsync("tmMarkdownEditor.insertLink", _editorRef, link.Url, link.Text);
            await SyncValueFromEditorAsync();
        };
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnLinkCancel()
    {
        _showLinkDialog = false;
        _restoreCaretAfterDialogClose = true;
        _pendingAfterDialogClose = null;
        await InvokeAsync(StateHasChanged);
    }

    // ── Table dialog ───────────────────────────────────────────────────────────

    private async Task OnTableConfirm((int Rows, int Cols) table)
    {
        _showTableDialog = false;
        _restoreCaretAfterDialogClose = true;
        _pendingAfterDialogClose = async () =>
        {
            await JS.InvokeVoidAsync("tmMarkdownEditor.insertTable", _editorRef, table.Rows, table.Cols);
            await SyncValueFromEditorAsync();
        };
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnTableCancel()
    {
        _showTableDialog = false;
        _restoreCaretAfterDialogClose = true;
        _pendingAfterDialogClose = null;
        await InvokeAsync(StateHasChanged);
    }

    // ── Caret bookmark across the dialog ───────────────────────────────────────

    /// <summary>
    /// Saves the caret/selection as a bookmark (markdownEditor.js) before the modal dialog takes
    /// the focus, so the insertion or the caret can land at the same spot after it closes.
    /// </summary>
    private async Task SaveCursorBookmarkAsync()
    {
        try { await JS.InvokeVoidAsync("tmMarkdownEditor.saveCursorBookmark", _editorRef); }
        catch { /* JS not available in SSR / tests */ }
    }

    /// <summary>Restores focus into the editor and replays the saved caret/selection.</summary>
    private async Task RestoreCursorBookmarkAsync()
    {
        try { await JS.InvokeVoidAsync("tmMarkdownEditor.restoreCursorBookmark", _editorRef); }
        catch { /* JS not available in SSR / tests */ }
    }

    // ── Value sync helper ──────────────────────────────────────────────────────

    private async Task SyncValueFromEditorAsync()
    {
        _isUpdatingFromJs = true;
        try
        {
            var markdown = await JS.InvokeAsync<string>("tmMarkdownEditor.getValue", _editorRef);
            Value = markdown ?? string.Empty;
            _lastSyncedValue = Value;
            UpdateEmptyState();
            await ValueChanged.InvokeAsync(Value);
            await UpdateActiveFormatsAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch { }
        finally
        {
            _isUpdatingFromJs = false;
        }
    }

    private async Task UpdateActiveFormatsAsync()
    {
        try
        {
            var formats = await JS.InvokeAsync<string[]?>("tmMarkdownEditor.getActiveFormats", _editorRef);
            _activeFormats = formats?.ToList() ?? new List<string>();
        }
        catch { }
    }

    // ── Empty state / char count ───────────────────────────────────────────────

    private void UpdateEmptyState()
    {
        _isEmpty = string.IsNullOrWhiteSpace(Value);
        _charCount = Value?.Length ?? 0;
    }

    // ── Public API ─────────────────────────────────────────────────────────────

    /// <summary>
    /// Returns the current markdown value.
    /// </summary>
    public string GetMarkdown() => Value ?? string.Empty;

    /// <summary>
    /// Clears the editor content.
    /// </summary>
    public async Task Clear()
    {
        Value = string.Empty;
        _lastSyncedValue = string.Empty;
        try
        {
            await JS.InvokeVoidAsync("tmMarkdownEditor.setValue", _editorRef, "");
        }
        catch { }
        UpdateEmptyState();
        _activeFormats.Clear();
        await ValueChanged.InvokeAsync(Value);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Programmatically submits the current content (same as Ctrl+Enter).
    /// Only fires OnSubmit when content is non-empty and within MaxLength.
    /// </summary>
    public async Task Submit()
    {
        if (!string.IsNullOrWhiteSpace(Value) && !IsOverLimit)
        {
            await OnSubmit.InvokeAsync();
        }
    }

    // ── IAsyncDisposable ───────────────────────────────────────────────────────

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("tmMarkdownEditor.destroy", _editorRef); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        catch (TaskCanceledException) { }
    }
}
