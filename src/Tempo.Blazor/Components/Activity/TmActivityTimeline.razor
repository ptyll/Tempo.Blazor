@namespace Tempo.Blazor.Components.Activity
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Components.Avatars
@using Tempo.Blazor.Components.DataDisplay
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Timeline
@using Tempo.Blazor.Interfaces

<div class="tm-timeline">
    @if (ShowFilterBar)
    {
        <div class="tm-timeline-filter">
            <input type="search"
                   class="tm-timeline-search"
                   data-testid="@TestId("timeline-search")"
                   placeholder="@Loc["TmTimeline_FilterPlaceholder"]"
                   aria-label="@Loc["TmTimeline_FilterLabel"]"
                   value="@_searchText"
                   @oninput="OnSearchChangedAsync" />
            @if (_typeOptions.Count > 0)
            {
                <select class="tm-timeline-type-filter"
                        data-testid="@TestId("timeline-type-filter")"
                        aria-label="@Loc["TmTimeline_TypeFilterLabel"]"
                        value="@_typeFilter"
                        @onchange="OnTypeChangedAsync">
                    <option value="">@Loc["TmTimeline_TypeFilterAll"]</option>
                    @foreach (var type in _typeOptions)
                    {
                        <option value="@type" selected="@string.Equals(type, _typeFilter, StringComparison.OrdinalIgnoreCase)">@type</option>
                    }
                </select>
            }
        </div>
    }

    @if (IsLoading)
    {
        <div class="tm-timeline-loading">
            <TmSpinner Size="SpinnerSize.Sm" />
            <span>@Loc["TmTimeline_Loading"]</span>
        </div>
    }
    else if (_pager.Items.Count == 0)
    {
        @* tm-activity-timeline-empty carries this component's own padding — the bare
           tm-timeline-empty name is shared with TmTimeline, so two owners used to race the
           same declarations. The shared class stays for the common empty-state base. *@
        <div class="tm-timeline-empty tm-activity-timeline-empty">
            <TmEmptyState Title="@Loc["TmTimeline_Empty"]" />
        </div>
    }
    else
    {
        <ul class="tm-timeline-list">
            @foreach (var entry in _pager.Items)
            {
                <li class="tm-timeline-item tm-timeline-@entry.EntryType.ToLowerInvariant().Replace(" ", "_")">
                    <div class="tm-timeline-connector" aria-hidden="true"></div>
                    <div class="tm-timeline-avatar">
                        @if (!string.IsNullOrEmpty(entry.AuthorAvatarUrl))
                        {
                            <TmAvatar Src="@entry.AuthorAvatarUrl" Name="@entry.AuthorName" Size="AvatarSize.Sm" />
                        }
                        else
                        {
                            <TmAvatar Name="@entry.AuthorName" Size="AvatarSize.Sm" />
                        }
                    </div>
                    <div class="tm-timeline-body">
                        <div class="tm-timeline-meta">
                            <span class="tm-timeline-author">@entry.AuthorName</span>
                            <span class="tm-timeline-time" title="@entry.CreatedAt.ToString("g")">
                                @FormatRelativeTime(entry.CreatedAt)
                            </span>
                        </div>
                        @if (!string.IsNullOrEmpty(entry.HtmlContent))
                        {
                            <div class="tm-timeline-content">@((MarkupString)entry.HtmlContent)</div>
                        }
                        else if (!string.IsNullOrEmpty(entry.PlainContent))
                        {
                            <div class="tm-timeline-content">@entry.PlainContent</div>
                        }
                    </div>
                </li>
            }
        </ul>

        @if (PageSize.HasValue && _pager.TotalCount > 0)
        {
            <div class="tm-timeline-footer">
                <span class="tm-timeline-count" data-testid="@TestId("timeline-count")">
                    @(string.Format(Loc["TmTimeline_ShowingCount"], _pager.ShownCount, _pager.TotalCount))
                </span>
                @if (_pager.HasMore)
                {
                    <button type="button"
                            class="tm-timeline-load-more"
                            data-testid="@TestId("timeline-load-more")"
                            @onclick="OnLoadMoreAsync">
                        @Loc["TmTimeline_LoadMore"]
                    </button>
                }
            </div>
        }
    }
</div>

@code {
    /// <summary>Timeline entries to display. Sorted newest-first. Ignored when <see cref="DataProvider"/> is set.</summary>
    [Parameter] public IEnumerable<ITimelineEntry> Entries { get; set; } = [];

    /// <summary>Whether the timeline is loading data.</summary>
    [Parameter] public bool IsLoading { get; set; }

    /// <summary>Whether internal entries are included (default: true — the activity timeline shows everything).</summary>
    [Parameter] public bool ShowInternal { get; set; } = true;

    /// <summary>Optional free-text filter applied to author, content, and entry type (additive, default: none).</summary>
    [Parameter] public string? Filter { get; set; }

    /// <summary>Optional entry-type filter (e.g. "comment"); null/empty shows all types (additive, default: none).</summary>
    [Parameter] public string? EntryTypeFilter { get; set; }

    /// <summary>Page size for incremental "load more" paging. <c>null</c> (default) shows every entry — backward compatible.</summary>
    [Parameter] public int? PageSize { get; set; }

    /// <summary>Optional explicit set of entry-type options for the filter bar. When null, distinct types are derived from <see cref="Entries"/>.</summary>
    [Parameter] public IReadOnlyList<string>? EntryTypeFilterOptions { get; set; }

    /// <summary>When true, renders a built-in search + type filter bar (default: false).</summary>
    [Parameter] public bool ShowFilterBar { get; set; }

    /// <summary>Optional async data provider. When set, entries are fetched (filtered + paged) from it instead of <see cref="Entries"/>.</summary>
    [Parameter] public ITimelineDataProvider? DataProvider { get; set; }

    private readonly TimelinePager _pager = new();
    private string? _searchText;
    private string? _typeFilter;
    private string? _lastFilterParam;
    private string? _lastTypeParam;
    private string _lastSignature = string.Empty;
    private IReadOnlyList<string> _typeOptions = [];

    protected override void OnParametersSet()
    {
        ApplyParameters();

        // The in-memory path is resolved synchronously so items are present on first
        // render, including when this component is embedded inside TmActivityLog.
        if (DataProvider is null)
        {
            _pager.ReloadSync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (DataProvider is not null)
        {
            await _pager.ReloadAsync();
        }
    }

    private void ApplyParameters()
    {
        if (!string.Equals(_lastFilterParam, Filter, StringComparison.Ordinal))
        {
            _lastFilterParam = Filter;
            _searchText = Filter;
        }
        if (!string.Equals(_lastTypeParam, EntryTypeFilter, StringComparison.Ordinal))
        {
            _lastTypeParam = EntryTypeFilter;
            _typeFilter = EntryTypeFilter;
        }

        _typeOptions = EntryTypeFilterOptions
            ?? (DataProvider is null
                ? TimelineFilter.DistinctTypes(Entries)
                : []);

        ConfigurePager();

        var signature = string.Join("\u0001", _searchText, _typeFilter, ShowInternal, PageSize);
        if (!string.Equals(signature, _lastSignature, StringComparison.Ordinal))
        {
            _lastSignature = signature;
            _pager.ResetWindow();
        }
    }

    /// <summary>Re-renders the component – call from a parent after new entries are fetched.</summary>
    public async Task RefreshAsync()
    {
        ConfigurePager();
        if (DataProvider is null)
        {
            _pager.ReloadSync();
        }
        else
        {
            await _pager.ReloadAsync();
        }
        StateHasChanged();
    }

    private void ConfigurePager()
    {
        _pager.Source = Entries;
        _pager.Provider = DataProvider;
        _pager.SearchText = _searchText;
        _pager.EntryType = _typeFilter;
        _pager.IncludeInternal = ShowInternal;
        _pager.PageSize = PageSize;
        _pager.Order = static items => items.OrderByDescending(e => e.CreatedAt);
    }

    private async Task OnSearchChangedAsync(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString();
        _pager.SearchText = _searchText;
        _pager.ResetWindow();
        _lastSignature = string.Join("\u0001", _searchText, _typeFilter, ShowInternal, PageSize);
        await _pager.ReloadAsync();
    }

    private async Task OnTypeChangedAsync(ChangeEventArgs e)
    {
        _typeFilter = e.Value?.ToString();
        _pager.EntryType = _typeFilter;
        _pager.ResetWindow();
        _lastSignature = string.Join("\u0001", _searchText, _typeFilter, ShowInternal, PageSize);
        await _pager.ReloadAsync();
    }

    private Task OnLoadMoreAsync() => _pager.LoadMoreAsync();

    private string FormatRelativeTime(DateTimeOffset dt)
    {
        var diff = DateTimeOffset.Now - dt;
        if (diff.TotalMinutes < 1) return Loc["TmTimeline_JustNow"];
        if (diff.TotalHours   < 1) return Loc["TmTimeline_MinutesAgo", (int)diff.TotalMinutes];
        if (diff.TotalDays    < 1) return Loc["TmTimeline_HoursAgo",   (int)diff.TotalHours];
        return Loc["TmTimeline_DaysAgo", (int)diff.TotalDays];
    }
}
