@namespace Tempo.Blazor.Components.Activity
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Buttons

@* FZE-10: rendered on the core TmModal primitive — top layer, role="dialog", named title,
   Escape and the shared focus trap. Anchored to the TOP of the viewport and immune to overlay
   clicks: it behaves like a search surface over the editor, not a blocking form. The fields sit
   in a real <form>; Enter submits it. Enter runs REPLACE (single) — not Replace All, which is
   too destructive for the accidental Enter, and find-next does not exist yet (recorded as a
   follow-up: a non-modal find bar with find-next and match highlighting). *@
<TmModal Show="@IsVisible"
         Title="@Loc["TmRichEditor_FindReplaceDialog_Title"]"
         Size="ModalSize.Small"
         Position="ModalPosition.Top"
         Class="tm-rte-findreplace-dialog tm-rte-dialog"
         CloseOnOverlayClick="false"
         CloseOnEscape="true"
         ShowCloseButton="true"
         RestoreFocusTargetId="@RestoreFocusTargetId"
         InitialFocusTargetId="@_findInputId"
         OnClose="HandleClose">

    <ChildContent>
    <form id="@_formId" @onsubmit="Replace" @onsubmit:preventDefault novalidate>
        <div class="tm-rte-form-group">
            <label for="@_findInputId">@Loc["TmRichEditor_FindReplaceDialog_Find"]</label>
            <input type="text"
                   id="@_findInputId"
                   class="tm-rte-findreplace-find-input"
                   placeholder="@Loc["TmRichEditor_FindReplaceDialog_FindPlaceholder"]"
                   @bind="_findText"
                   @bind:event="oninput" />
        </div>
        <div class="tm-rte-form-group">
            <label for="@_replaceInputId">@Loc["TmRichEditor_FindReplaceDialog_Replace"]</label>
            <input type="text"
                   id="@_replaceInputId"
                   class="tm-rte-findreplace-replace-input"
                   placeholder="@Loc["TmRichEditor_FindReplaceDialog_ReplacePlaceholder"]"
                   @bind="_replaceText"
                   @bind:event="oninput" />
        </div>
    </form>

    @if (_replaceCount is not null)
    {
        <div class="tm-rte-findreplace-result" role="status">
            @(_replaceCount > 0
                ? Loc["TmRichEditor_FindReplaceDialog_Replaced", _replaceCount.Value]
                : Loc["TmRichEditor_FindReplace_NoMatches"])
        </div>
    }

    </ChildContent>

    <Footer>
        <TmButton Variant="ButtonVariant.Ghost"
                  OnClick="HandleClose"
                  Class="tm-rte-btn-cancel">
            @Loc["Tm_Close"]
        </TmButton>
        @* Replace is the form's submit (Enter), styled secondary — Replace All is the primary,
           destructive action and is never what an accidental Enter should do. *@
        <TmButton Variant="ButtonVariant.Secondary"
                  Type="ButtonType.Submit"
                  Disabled="@(!HasFindText())"
                  Class="tm-rte-btn-replace"
                  AdditionalAttributes="@(new Dictionary<string, object> { ["form"] = _formId })">
            @Loc["TmRichEditor_FindReplaceDialog_Replace"]
        </TmButton>
        <TmButton Variant="ButtonVariant.Primary"
                  Disabled="@(!HasFindText())"
                  OnClick="ReplaceAll"
                  Class="tm-rte-btn-replaceall">
            @Loc["TmRichEditor_FindReplaceDialog_ReplaceAll"]
        </TmButton>
    </Footer>
</TmModal>

@code {
    /// <summary>
    /// Whether the dialog is visible.
    /// </summary>
    [Parameter] public bool IsVisible { get; set; }

    /// <summary>
    /// Ignored: the find/replace dialog never closes on backdrop click (an accidental click
    /// would lose the typed query).
    /// </summary>
    [Obsolete("Ignored; the find/replace dialog never closes on backdrop click.")]
    [Parameter] public bool CloseOnBackdropClick { get; set; } = true;

    /// <summary>
    /// Replaces the first occurrence of the find text. Must return the REAL number of
    /// replacements made (the host reads it from <c>tmRichEditor.findAndReplace</c>) so the
    /// dialog can report the true outcome — including "no matches".
    /// </summary>
    [Parameter] public Func<(string Find, string Replace), Task<int>>? OnReplace { get; set; }

    /// <summary>
    /// Replaces every occurrence of the find text. Must return the REAL number of
    /// replacements made (the host reads it from <c>tmRichEditor.findAndReplace</c>) so the
    /// dialog can report the true outcome — including "no matches".
    /// </summary>
    [Parameter] public Func<(string Find, string Replace), Task<int>>? OnReplaceAll { get; set; }

    /// <summary>
    /// Callback when dialog is cancelled (Escape, close button).
    /// </summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>
    /// The id of the element focus returns to when the dialog closes — the host editor's
    /// content surface, so focus lands back in the saved selection.
    /// </summary>
    [Parameter] public string? RestoreFocusTargetId { get; set; }

    private string _findText = string.Empty;
    private string _replaceText = string.Empty;

    /// <summary>Null until a replace actually ran; 0 then means "no matches", not "untouched".</summary>
    private int? _replaceCount;

    // Per-instance ids: the input ids stay unique when a page hosts several editors.
    private string _idSuffix { get; } = Guid.NewGuid().ToString("N")[..8];
    private string _findInputId => $"tm-rte-find-{_idSuffix}";
    private string _replaceInputId => $"tm-rte-replace-{_idSuffix}";
    private string _formId => $"tm-rte-findreplace-form-{_idSuffix}";

    private bool HasFindText() => !string.IsNullOrWhiteSpace(_findText);

    private async Task Replace()
    {
        // Re-validate on submit: Enter in a field runs this path too.
        if (!HasFindText() || OnReplace is null) return;
        _replaceCount = await OnReplace((_findText, _replaceText));
    }

    private async Task ReplaceAll()
    {
        if (!HasFindText() || OnReplaceAll is null) return;
        _replaceCount = await OnReplaceAll((_findText, _replaceText));
    }

    private async Task HandleClose()
    {
        Reset();
        await OnCancel.InvokeAsync();
    }

    private void Reset()
    {
        _findText = string.Empty;
        _replaceText = string.Empty;
        _replaceCount = null;
    }
}
