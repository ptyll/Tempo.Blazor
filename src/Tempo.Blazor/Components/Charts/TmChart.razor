    // ── Stacked charts (Fáze 18 / C5) ──
    // Each category's datasets accumulate on a shared baseline. The value domain is the
    // largest STACK total (sum of the positive dataset values in a category). Non-positive
    // values contribute nothing to a stack. A whole dataset can be toggled off via the
    // interactive series legend (IsSegmentHidden(di, -1)).

    private (double Min, double Max) StackedDomain()
    {
        var lc = Data.Labels.Length;
        double max = 0;
        for (int i = 0; i < lc; i++)
        {
            double sum = 0;
            for (int di = 0; di < Data.Datasets.Length; di++)
            {
                if (IsSegmentHidden(di, -1)) continue;
                var vs = Data.Datasets[di].Values;
                if (i < vs.Length && !double.IsNaN(vs[i]) && vs[i] > 0) sum += vs[i];
            }
            if (sum > max) max = sum;
        }
        return (0, max <= 0 ? 1 : max);
    }

    private void BuildStackedGrid(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b)
    {
        if (!ShowGrid) return;
        var (min, max) = StackedDomain();
        for (int i = 0; i <= 5; i++)
        {
            var value = min + (max - min) * i / 5.0;
            var y = PT + CH - ((value - min) / (max - min)) * CH;
            SvgLine(b, "tm-chart__grid-line", PL, y, PL + CW, y);
            SvgText(b, "tm-chart__axis-label", PL - 8, y + 4, F(value), "end");
        }
    }

    private void BuildStackedBarChart(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b)
    {
        var (_, max) = StackedDomain();
        var lc = Data.Labels.Length;
        var gw = CW / (double)lc;
        var gp = gw * 0.15;
        var bw = gw * 0.7;

        for (int i = 0; i < lc; i++)
        {
            double cum = 0;
            var x = PL + i * gw + gp;
            for (int di = 0; di < Data.Datasets.Length; di++)
            {
                if (IsSegmentHidden(di, -1)) continue;
                var ds = Data.Datasets[di];
                if (i >= ds.Values.Length) continue;
                var val = ds.Values[i];
                if (double.IsNaN(val) || val <= 0) continue;

                var segH = (val / max) * CH;
                var yTop = PT + CH - ((cum + val) / max) * CH;
                var fill = ResolveFillColor(ds, i, ds.BackgroundColor ?? ds.Color);
                SvgRect(b, x, yTop, bw, segH, fill, ds.Color, di, i, x + bw / 2, yTop);
                if (ShowValues && segH >= MinStackedValueLabelHeight)
                    SvgText(b, "tm-chart__value", x + bw / 2, yTop + segH / 2 + 4, F(val), "middle");
                cum += val;
            }
        }

        var labelStep = lc > 24 ? (int)Math.Ceiling(lc / 12.0) : 1;
        for (int i = 0; i < lc; i += labelStep)
        {
            var cx = PL + i * gw + gw / 2.0;
            SvgText(b, "tm-chart__label", cx, PT + CH + 24, Data.Labels[i], "middle");
        }
    }

    private void BuildStackedHorizontalBarChart(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b)
    {
        var (_, max) = StackedDomain();
        var lc = Data.Labels.Length;
        var gh = CH / (double)lc;
        var gp = gh * 0.15;
        var bh = gh * 0.7;

        for (int i = 0; i < lc; i++)
        {
            double cum = 0;
            var y = PT + i * gh + gp;
            for (int di = 0; di < Data.Datasets.Length; di++)
            {
                if (IsSegmentHidden(di, -1)) continue;
                var ds = Data.Datasets[di];
                if (i >= ds.Values.Length) continue;
                var val = ds.Values[i];
                if (double.IsNaN(val) || val <= 0) continue;

                var segW = (val / max) * CW;
                var x = PL + (cum / max) * CW;
                var fill = ResolveFillColor(ds, i, ds.BackgroundColor ?? ds.Color);
                SvgRect(b, x, y, segW, bh, fill, ds.Color, di, i, x + segW / 2, y + bh / 2);
                if (ShowValues && segW >= MinStackedValueLabelWidth)
                    SvgText(b, "tm-chart__value", x + segW / 2, y + bh / 2 + 4, F(val), "middle");
                cum += val;
            }
        }

        for (int i = 0; i < lc; i++)
        {
            var cy = PT + i * gh + gh / 2.0;
            SvgText(b, "tm-chart__label", PL - 8, cy + 4, Data.Labels[i], "end");
        }
    }

    private void BuildStackedAreaChart(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b)
    {
        var (_, max) = StackedDomain();
        var lc = Data.Labels.Length;
        if (lc == 0) return;
        var sx = CW / (double)Math.Max(lc - 1, 1);
        var cumulative = new double[lc];

        for (int di = 0; di < Data.Datasets.Length; di++)
        {
            if (IsSegmentHidden(di, -1)) continue;
            var ds = Data.Datasets[di];

            var top = new (double X, double Y)[lc];
            var baseline = new (double X, double Y)[lc];
            for (int i = 0; i < lc; i++)
            {
                var val = i < ds.Values.Length && !double.IsNaN(ds.Values[i]) && ds.Values[i] > 0 ? ds.Values[i] : 0;
                var baseH = cumulative[i];
                var topH = baseH + val;
                var x = PL + i * sx;
                top[i] = (x, PT + CH - (topH / max) * CH);
                baseline[i] = (x, PT + CH - (baseH / max) * CH);
                cumulative[i] = topH;
            }

            var path = new System.Text.StringBuilder();
            for (int i = 0; i < lc; i++)
                path.Append(i == 0 ? "M" : " L").Append(' ').Append(F(top[i].X)).Append(' ').Append(F(top[i].Y));
            for (int i = lc - 1; i >= 0; i--)
                path.Append(" L ").Append(F(baseline[i].X)).Append(' ').Append(F(baseline[i].Y));
            path.Append(" Z");

            var fill = ds.BackgroundColor ?? ds.Color;
            b.OpenElement(0, "path");
            b.AddAttribute(1, "class", "tm-chart__stacked-area");
            b.AddAttribute(2, "d", path.ToString());
            b.AddAttribute(3, "fill", fill);
            b.AddAttribute(4, "fill-opacity", "0.85");
            b.AddAttribute(5, "stroke", ds.Color);
            b.AddAttribute(6, "stroke-width", "1.5");
            b.CloseElement();
        }

        for (int i = 0; i < lc; i++)
        {
            var cx = PL + i * sx;
            SvgText(b, "tm-chart__label", cx, PT + CH + 24, Data.Labels[i], "middle");
        }
    }

    // ── Heatmap ──

    private void BuildHeatmap(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b)
    {
        var cols = Data.Labels.Length;
        var rows = new List<int>();
        for (int di = 0; di < Data.Datasets.Length; di++)
        {
            if (!_hidden.Contains(di)) rows.Add(di);
        }
        if (rows.Count == 0 || cols == 0) return;

        double min = double.MaxValue, max = double.MinValue;
        foreach (var di in rows)
        {
            var values = Data.Datasets[di].Values;
            for (int c = 0; c < cols && c < values.Length; c++)
            {
                if (values[c] < min) min = values[c];
                if (values[c] > max) max = values[c];
            }
        }
        if (min > max) return;
        var range = max - min;

        var cw2 = CW / (double)cols;
        var ch2 = CH / (double)rows.Count;

        for (int r = 0; r < rows.Count; r++)
        {
            var di = rows[r];
            var ds = Data.Datasets[di];
            var y = PT + r * ch2;
            SvgText(b, "tm-chart__axis-label", PL - 8, y + ch2 / 2 + 4, ds.Label, "end");

            for (int c = 0; c < cols && c < ds.Values.Length; c++)
            {
                var val = ds.Values[c];
                var norm = range > 0 ? (val - min) / range : 1;
                var x = PL + c * cw2;
                var cdi = di;
                var cc = c;
                var fill = ResolveFillColor(ds, c, ds.BackgroundColor ?? ds.Color);

                b.OpenElement(0, "rect");
                b.AddAttribute(1, "class", "tm-chart__heatmap-cell");
                b.AddAttribute(2, "x", F(x + 1));
                b.AddAttribute(3, "y", F(y + 1));
                b.AddAttribute(4, "width", F(Math.Max(cw2 - 2, 0)));
                b.AddAttribute(5, "height", F(Math.Max(ch2 - 2, 0)));
                b.AddAttribute(6, "rx", "2");
                b.AddAttribute(7, "fill", fill);
                b.AddAttribute(8, "fill-opacity", F(0.08 + 0.92 * norm));
                b.AddAttribute(9, "data-row", cdi.ToString(CultureInfo.InvariantCulture));
                b.AddAttribute(10, "data-col", cc.ToString(CultureInfo.InvariantCulture));
                b.AddAttribute(11, "data-value", F(val));
                b.AddAttribute(12, "onclick",
                    EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(
                        this, () => HandleClick(cdi, cc)));
                b.AddAttribute(13, "onmouseover",
                    EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(
                        this, () => ShowTip(cdi, cc, x + cw2 / 2, y)));
                b.AddAttribute(14, "onmouseout",
                    EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, HideTip));
                b.CloseElement();

                if (ShowValues && cw2 > 26 && ch2 > 16)
                {
                    // SvgTextColored sets pointer-events:none so the label never steals the cell's
                    // hover; the ink is picked from the FILL (see HeatmapValueInk), never from the
                    // theme alone — --tm-text-inverse is dark in dark mode, which would read
                    // dark-on-dark on a caller colour like #1d4ed8.
                    SvgTextColored(b, "tm-chart__heatmap-value", x + cw2 / 2, y + ch2 / 2 + 4, F(val),
                        "middle", HeatmapValueInk(fill, norm), 11);
                }
            }
        }

        for (int c = 0; c < cols; c++)
        {
            SvgText(b, "tm-chart__axis-label", PL + c * cw2 + cw2 / 2, PT + CH + 16, Data.Labels[c], "middle");
        }
    }

    /// <summary>
    /// The ink of one heatmap value label, picked from the cell's FILL — never from the theme alone.
    /// A built-in series fill takes the fill's PAIRED ink token (<see cref="ChartSeriesTokens.SeriesInk"/>,
    /// theme-relative since TG-002); a caller colour keeps the norm-and-lightness decision: a strong
    /// cell (<paramref name="norm"/> &gt; 0.55) on a DARK fill takes the light inside ink, everything
    /// else the ordinary primary text token. The old norm-only rule emitted
    /// <c>var(--tm-text-inverse)</c>, which resolves DARK in dark mode — dark-on-dark on a caller
    /// colour like <c>#1d4ed8</c>.
    /// </summary>
    private static string HeatmapValueInk(string fill, double norm)
    {
        if (ChartSeriesTokens.IndexOf(fill) is { } series)
        {
            return ChartSeriesTokens.SeriesInk(series);
        }

        return norm > 0.55 && !ChartColorContrast.IsLight(fill)
            ? "var(--tm-chart-funnel-label-inside)"
            : "var(--tm-text-primary)";
    }

    // ── Treemap (squarified; flat from Data or hierarchical from TreeNodes) ──

    private sealed record TreeLeaf(string Path, string TopLabel, double Value, string Fill);

    private readonly List<TreeLeaf> _treeLeaves = [];

    private static double NodeWeight(ChartTreeNode node)
        => node.Children is { Count: > 0 } ? node.Children.Sum(NodeWeight) : Math.Max(node.Value, 0);

    private void BuildTreemap(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b)
    {
        _treeLeaves.Clear();

        if (TreeNodes is { Count: > 0 })
        {
            var visible = new List<(int Index, ChartTreeNode Node)>();
            for (int i = 0; i < TreeNodes.Count; i++)
            {
                if (!_hidden.Contains(i) && NodeWeight(TreeNodes[i]) > 0) visible.Add((i, TreeNodes[i]));
            }
            if (visible.Count == 0) return;

            var rects = Squarify(visible.Select(v => NodeWeight(v.Node)).ToList(), PL, PT, CW, CH);
            for (int g = 0; g < visible.Count; g++)
            {
                var (topIndex, node) = visible[g];
                var (gx, gy, gw, gh) = rects[g];
                if (gw <= 0 || gh <= 0) continue;
                var color = node.Color ?? PaletteColor(topIndex);

                b.OpenElement(0, "rect");
                b.AddAttribute(1, "class", "tm-chart__treemap-group");
                b.AddAttribute(2, "x", F(gx));
                b.AddAttribute(3, "y", F(gy));
                b.AddAttribute(4, "width", F(gw));
                b.AddAttribute(5, "height", F(gh));
                b.AddAttribute(6, "fill", color);
                b.AddAttribute(7, "fill-opacity", "0.16");
                b.AddAttribute(8, "stroke", color);
                b.CloseElement();

                var header = Math.Min(16d, gh);
                if (gw > 40)
                {
                    SvgTextColored(b, "tm-chart__treemap-group-label", gx + 4, gy + 12, node.Label, "start", color, 10);
                }

                var children = node.Children is { Count: > 0 }
                    ? node.Children
                    : [new ChartTreeNode { Label = node.Label, Value = node.Value }];
                var inner = (X: gx + 2, Y: gy + header, W: gw - 4, H: gh - header - 2);
                if (inner.W <= 0 || inner.H <= 0) continue;

                var childRects = Squarify(children.Select(NodeWeight).ToList(), inner.X, inner.Y, inner.W, inner.H);
                var maxChild = children.Max(NodeWeight);
                for (int c = 0; c < children.Count; c++)
                {
                    var child = children[c];
                    var path = node.Children is { Count: > 0 } ? $"{node.Label} / {child.Label}" : node.Label;
                    var opacity = maxChild > 0 ? 0.5 + 0.45 * (NodeWeight(child) / maxChild) : 0.95;
                    EmitTreemapTile(b, childRects[c], path, node.Label, NodeWeight(child), color, opacity, child.Label);
                }
            }
            return;
        }

        // Flat treemap from ChartData: one tile per label/value.
        var ds = Data.Datasets[0];
        var items = new List<(int Index, double Value)>();
        var count = Math.Min(Data.Labels.Length, ds.Values.Length);
        for (int i = 0; i < count; i++)
        {
            if (!IsSegmentHidden(0, i) && ds.Values[i] > 0) items.Add((i, ds.Values[i]));
        }
        if (items.Count == 0) return;

        var flatRects = Squarify(items.Select(t => t.Value).ToList(), PL, PT, CW, CH);
        for (int t = 0; t < items.Count; t++)
        {
            var (index, value) = items[t];
            var fill = ResolveFillColor(ds, index, PaletteColor(index));
            EmitTreemapTile(b, flatRects[t], Data.Labels[index], ds.Label, value, fill, 1, Data.Labels[index], index);
        }
    }

    private void EmitTreemapTile(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b,
        (double X, double Y, double W, double H) rect,
        string path, string topLabel, double value, string fill, double opacity, string shortLabel,
        int? dataIndex = null)
    {
        if (rect.W <= 0 || rect.H <= 0) return;
        var leafIndex = _treeLeaves.Count;
        _treeLeaves.Add(new TreeLeaf(path, topLabel, value, fill));
        var anchorX = rect.X + rect.W / 2;
        var anchorY = rect.Y;

        b.OpenElement(0, "rect");
        b.AddAttribute(1, "class", "tm-chart__treemap-tile");
        b.AddAttribute(2, "x", F(rect.X));
        b.AddAttribute(3, "y", F(rect.Y));
        b.AddAttribute(4, "width", F(rect.W));
        b.AddAttribute(5, "height", F(rect.H));
        b.AddAttribute(6, "fill", fill);
        b.AddAttribute(7, "fill-opacity", F(opacity));
        b.AddAttribute(8, "stroke", "var(--tm-bg-surface)");
        b.AddAttribute(9, "data-path", path);
        b.AddAttribute(10, "data-value", F(value));
        if (dataIndex is { } di)
        {
            b.AddAttribute(11, "data-index", di.ToString(CultureInfo.InvariantCulture));
        }
        b.AddAttribute(12, "onclick",
            EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(
                this, () => HandleTreeClickAsync(leafIndex)));
        b.AddAttribute(13, "onmouseover",
            EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(
                this, () => ShowTreeTip(leafIndex, anchorX, anchorY)));
        b.AddAttribute(14, "onmouseout",
            EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, HideTip));
        b.CloseElement();

        if (rect.W > 56 && rect.H > 20)
        {
            // A series fill takes its PAIRED theme ink (dark on a light 400-tone in dark mode, dark on
            // the dark 500-tones in light mode); a host's own colour keeps the historical white label.
            var ink = TreemapLabelInk(fill);
            SvgTextColored(b, "tm-chart__treemap-label", rect.X + rect.W / 2, rect.Y + rect.H / 2 + 4,
                shortLabel, "middle", ink, 10);
            if (ShowValues && rect.H > 36)
            {
                SvgTextColored(b, "tm-chart__treemap-value", rect.X + rect.W / 2, rect.Y + rect.H / 2 + 18,
                    F(value), "middle", ink, 9);
            }
        }
    }

    /// <summary>
    /// The ink a treemap label takes on <paramref name="fill"/>: the paired series ink for a built-in
    /// series token (theme-correct in both themes), white for a host colour (the pre-TG-002 behavior).
    /// </summary>
    private static string TreemapLabelInk(string fill) =>
        ChartSeriesTokens.IndexOf(fill) is { } series ? ChartSeriesTokens.SeriesInk(series) : "var(--tm-color-white)";

    private async Task HandleTreeClickAsync(int leafIndex)
    {
        if (!OnSegmentClick.HasDelegate || leafIndex >= _treeLeaves.Count) return;
        var leaf = _treeLeaves[leafIndex];
        await OnSegmentClick.InvokeAsync(new ChartSegment(0, leafIndex, leaf.Path, leaf.Value));
    }

    private void ShowTreeTip(int leafIndex, double anchorX, double anchorY)
    {
        if (!ShowTooltip || leafIndex >= _treeLeaves.Count) return;
        var leaf = _treeLeaves[leafIndex];
        _tip = new ChartTooltipContext(0, leafIndex, leaf.Path, leaf.Value, leaf.TopLabel, leaf.Fill);
        _tipX = anchorX;
        _tipY = anchorY;
    }

    /// <summary>
    /// Squarified treemap layout (Bruls et al.): lays the weights into the rect keeping
    /// tiles close to square. Result rects are returned in the input order; areas are
    /// exactly proportional to the weights.
    /// </summary>
    private static (double X, double Y, double W, double H)[] Squarify(
        IReadOnlyList<double> weights, double x, double y, double w, double h)
    {
        var result = new (double X, double Y, double W, double H)[weights.Count];
        var total = weights.Sum();
        if (total <= 0 || w <= 0 || h <= 0) return result;

        var scale = w * h / total;
        var items = new List<(int Index, double Area)>();
        for (int i = 0; i < weights.Count; i++)
        {
            if (weights[i] > 0) items.Add((i, weights[i] * scale));
        }
        items.Sort((a, bb) => bb.Area.CompareTo(a.Area));

        var row = new List<(int Index, double Area)>();
        var rx = x; var ry = y; var rw = w; var rh = h;

        static double Worst(List<(int Index, double Area)> currentRow, double side)
        {
            var sum = currentRow.Sum(r => r.Area);
            if (sum <= 0) return double.MaxValue;
            var maxA = currentRow.Max(r => r.Area);
            var minA = currentRow.Min(r => r.Area);
            var s2 = sum * sum;
            var side2 = side * side;
            return Math.Max(side2 * maxA / s2, s2 / (side2 * minA));
        }

        void LayoutRow(List<(int Index, double Area)> currentRow)
        {
            var sum = currentRow.Sum(r => r.Area);
            if (sum <= 0) return;
            if (rw >= rh)
            {
                var colW = sum / rh;
                var cy = ry;
                foreach (var (index, area) in currentRow)
                {
                    var tileH = area / colW;
                    result[index] = (rx, cy, colW, tileH);
                    cy += tileH;
                }
                rx += colW;
                rw -= colW;
            }
            else
            {
                var rowH = sum / rw;
                var cx2 = rx;
                foreach (var (index, area) in currentRow)
                {
                    var tileW = area / rowH;
                    result[index] = (cx2, ry, tileW, rowH);
                    cx2 += tileW;
                }
                ry += rowH;
                rh -= rowH;
            }
        }

        foreach (var item in items)
        {
            var side = Math.Min(rw, rh);
            if (row.Count == 0)
            {
                row.Add(item);
                continue;
            }

            var withItem = new List<(int Index, double Area)>(row) { item };
            if (Worst(withItem, side) <= Worst(row, side))
            {
                row.Add(item);
            }
            else
            {
                LayoutRow(row);
                row.Clear();
                row.Add(item);
            }
        }

        if (row.Count > 0) LayoutRow(row);
        return result;
    }

    private void SvgTextColored(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b,
        string cls, double x, double y, string content, string anchor, string fill, int fontSize)
    {
        b.OpenElement(0, "text");
        b.AddAttribute(1, "class", cls);
        b.AddAttribute(2, "x", F(x));
        b.AddAttribute(3, "y", F(y));
        b.AddAttribute(4, "text-anchor", anchor);
        b.AddAttribute(5, "font-size", fontSize.ToString(CultureInfo.InvariantCulture));
        b.AddAttribute(6, "fill", fill);
        b.AddAttribute(7, "style", "pointer-events:none;");
        b.AddContent(8, content);
        b.CloseElement();
    }
}
