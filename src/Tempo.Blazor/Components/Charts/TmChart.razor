@namespace Tempo.Blazor.Components.Charts
@inherits Tempo.Blazor.Components.TmComponentBase
@using System.Globalization

<div class="tm-chart @(Animated ? "tm-chart--animated" : "") @(Type == ChartType.Funnel ? "tm-chart--funnel" : "") @Class"
     style="width: @Width; height: @Height;"
     data-testid="@RootTestId("tm-chart")"
     data-tooltip-mode="@TooltipMode.ToString().ToLowerInvariant()"
     data-index-ordinal="@ActiveIndexOrdinal">

    @if (!HasRenderableData)
    {
        <div class="tm-chart__empty">@Loc["TmChart_NoData"]</div>
    }
    else
    {
        @* The plot box is the funnel's SIZE container: its width and height are the box the SVG meets
           into, which is the scale the label type has to compensate (_chart.css). Every other chart type
           gets the same box without the containment. *@
        <div class="tm-chart__plot">
            <svg viewBox="0 0 @SvgW @SvgH"
                 preserveAspectRatio="xMidYMid meet"
                 aria-label="@ChartAriaLabel"
                 role="img"
                 width="100%"
                 height="100%"
                 tabindex="@IndexTabIndex"
                 aria-keyshortcuts="@IndexKeyshortcuts"
                 aria-describedby="@IndexDescribedBy"
                 @onkeydown="HandleChartKeyDown"
                 @onblur="HandleChartBlur">
                @ChartContent
                @IndexOverlayContent
                @TooltipContent
                @IndexTooltipContent
            </svg>
        </div>

        @if (IndexTooltipActive)
        {
            @* The keyboard hint the focusable SVG points at, and the ONE live region of the chart:
               the tooltip itself lives inside the role="img" SVG, so it is not exposed to a reader —
               the announcement is the only text a screen reader meets. *@
            <span class="tm-sr-only"
                  id="@IndexHintId"
                  data-testid="@TestId("chart-index-hint")">@Loc["TmChart_IndexKeyboardHint"]</span>
            <span class="tm-sr-only"
                  role="status"
                  aria-live="polite"
                  aria-atomic="true"
                  data-testid="@TestId("chart-index-live")">@IndexLiveText</span>
        }

        @if (ShowLegend && LegendItemList.Count > 0)
        {
            <div class="tm-chart__legend">
                @for (var li = 0; li < LegendItemList.Count; li++)
                {
                    var i = li;
                    var item = LegendItemList[i];
                    var hidden = _hidden.Contains(i);
                    var cls = "tm-chart__legend-item"
                        + (InteractiveLegend ? " tm-chart__legend-item--interactive" : "")
                        + (hidden ? " tm-chart__legend-item--hidden" : "");

                    @if (InteractiveLegend)
                    {
                        <button type="button"
                                class="@cls"
                                data-testid="@TestId($"chart-legend-{i}")"
                                aria-pressed="@((!hidden).ToString().ToLowerInvariant())"
                                aria-label="@string.Format(Loc["TmChart_ToggleSeries"], item.Label)"
                                @onclick="() => ToggleSeriesAsync(i)">
                            <span class="tm-chart__legend-color" style="background-color: @item.Color;"></span>
                            <span class="tm-chart__legend-label">@item.Label</span>
                        </button>
                    }
                    else
                    {
                        <div class="@cls">
                            <span class="tm-chart__legend-color" style="background-color: @item.Color;"></span>
                            <span class="tm-chart__legend-label">@item.Label</span>
                        </div>
                    }
                }
            </div>
        }

        @if (Type == ChartType.Funnel)
        {
            @* The SVG is role="img", so a reader hears only the chart's type. The funnel's stages and
               their conversions are the data a reader needs, so it gets a real (visually hidden) table
               of exactly the stages that are drawn — an accessible name instead of a picture. *@
            var funnelRows = FunnelTableRows();
            if (funnelRows.Count > 0)
            {
                <table class="tm-sr-only" data-testid="@TestId("chart-funnel-table")">
                    <caption>@Loc["TmChart_FunnelTableCaption"]</caption>
                    <thead>
                        <tr>
                            <th scope="col">@Loc["TmChart_FunnelStageColumn"]</th>
                            <th scope="col">@Loc["TmChart_FunnelValueColumn"]</th>
                            <th scope="col">@Loc["TmChart_FunnelConversionColumn"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in funnelRows)
                        {
                            <tr>
                                <th scope="row">@row.Label</th>
                                <td>@row.Value</td>
                                <td>@row.Conversion</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    }
</div>

@code {
    private const int SvgW = 600;
    private const int SvgH = 400;
    private const int PL = 50;  // pad-left
    private const int PR = 20;  // pad-right
    private const int PT = 20;  // pad-top
    private const int PB = 40;  // pad-bottom
    private const int MinStackedValueLabelHeight = 16;
    private const int MinStackedValueLabelWidth = 24;
    private int CW => SvgW - PL - PR;  // chart width
    private int CH => SvgH - PT - PB;  // chart height

    [Parameter, EditorRequired] public ChartType Type { get; set; }
    [Parameter, EditorRequired] public ChartData Data { get; set; } = default!;
    [Parameter] public string Width { get; set; } = "100%";
    [Parameter] public string Height { get; set; } = "300px";
    [Parameter] public bool ShowLegend { get; set; } = true;
    [Parameter] public bool ShowGrid { get; set; } = true;
    [Parameter] public bool ShowValues { get; set; }
    [Parameter] public bool Animated { get; set; } = true;
    [Parameter] public EventCallback<ChartSegment> OnSegmentClick { get; set; }
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Accessible name of the plot, set as the SVG's <c>aria-label</c>. Null (default) keeps the
    /// localized text alternative built from <see cref="Type"/> ("Line chart"), so a page that shows
    /// one chart needs nothing and a page that shows several can name each of them without wrapping
    /// the component in a <c>&lt;figure aria-labelledby&gt;</c>. A blank value is treated as absent.
    /// </summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>
    /// When true, legend items become buttons that toggle the visibility of their series
    /// (multi-dataset legend) or single value (per-value legend). The component owns the
    /// hidden state; <see cref="OnSeriesToggle"/> reports each change. Default false keeps
    /// the legend non-interactive (backward compatible).
    /// </summary>
    [Parameter] public bool InteractiveLegend { get; set; }

    /// <summary>Raised whenever a legend series/value is toggled.</summary>
    [Parameter] public EventCallback<ChartSeriesToggle> OnSeriesToggle { get; set; }

    /// <summary>Shows a tooltip when hovering a bar, point or slice. Default true.</summary>
    [Parameter] public bool ShowTooltip { get; set; } = true;

    /// <summary>
    /// Area charts only: fills each series with a vertical gradient fading from the series
    /// color to transparent instead of the flat token-driven fill. Default false.
    /// </summary>
    [Parameter] public bool AreaGradient { get; set; }

    /// <summary>
    /// Area charts only: optional opacity override for solid area fills, clamped to 0–1.
    /// Null (default) keeps the light/dark value from the <c>--tm-chart-area-fill-opacity</c>
    /// design token. Gradient areas keep their stop-based opacity.
    /// </summary>
    [Parameter] public double? AreaOpacity { get; set; }

    /// <summary>
    /// Waterfall charts only: appends a calculated total bar after the input values.
    /// Defaults to false.
    /// </summary>
    [Parameter] public bool WaterfallShowTotal { get; set; }

    /// <summary>
    /// Waterfall charts only: draws dashed cumulative-level connectors between adjacent bars.
    /// Defaults to false.
    /// </summary>
    [Parameter] public bool WaterfallShowConnectors { get; set; }

    /// <summary>
    /// Time axis only: custom .NET date format string for the X-axis labels (e.g. "yyyy-MM").
    /// Null picks the format automatically from the axis range (hours/days/months/years).
    /// </summary>
    [Parameter] public string? TimeLabelFormat { get; set; }

    /// <summary>Time axis only: lower bound of the X axis. Null uses the earliest data point.</summary>
    [Parameter] public DateTime? TimeAxisMin { get; set; }

    /// <summary>Time axis only: upper bound of the X axis. Null uses the latest data point.</summary>
    [Parameter] public DateTime? TimeAxisMax { get; set; }

    /// <summary>Optional custom tooltip content; when null a rich default tooltip is used.</summary>
    [Parameter] public RenderFragment<ChartTooltipContext>? TooltipTemplate { get; set; }

    /// <summary>
    /// Hierarchical data for <see cref="ChartType.Treemap"/>: top-level nodes render as
    /// groups with header strips, their children as tiles. When null, a treemap renders
    /// flat from <see cref="Data"/> (one tile per label/value).
    /// </summary>
    [Parameter] public IReadOnlyList<ChartTreeNode>? TreeNodes { get; set; }

    private bool HasRenderableData
        => Type == ChartType.Treemap && TreeNodes is { Count: > 0 }
           || Data is not null && Data.Datasets.Length > 0
              && (Data.Labels.Length > 0 || Data.TimePoints is { Length: > 0 });

    // The type name stays as the data says it ("StackedBar"); only the noun is localized, so English
    // output is byte-identical to the pre-2.9.1 hardcoded string. A host-supplied AriaLabel wins, and a
    // blank one is treated as absent: `aria-label=""` would erase the accessible name altogether.
    private string ChartAriaLabel => string.IsNullOrWhiteSpace(AriaLabel)
        ? string.Format(CultureInfo.CurrentCulture, Loc["TmChart_AriaLabel"], Type)
        : AriaLabel;

    private record LegendItem(string Label, string Color);

    // Hidden legend-item indices (meaning depends on per-value vs per-dataset legend).
    private readonly HashSet<int> _hidden = [];

    // Hovered tooltip state (pure Blazor; rendered as an in-SVG foreignObject).
    private ChartTooltipContext? _tip;
    private double _tipX, _tipY;

    // Reset toggle/tooltip state when the parent swaps in a different Data instance so hidden
    // legend indices don't leak across unrelated datasets (ChartData is an immutable record).
    private ChartData? _lastData;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_lastData, Data))
        {
            _hidden.Clear();
            _tip = null;
            ResetIndexState();
            _lastData = Data;
        }
    }

    private bool PerValue => UsesPerValueLegend();

    private bool IsSegmentHidden(int datasetIndex, int valueIndex)
        => PerValue ? _hidden.Contains(valueIndex) : _hidden.Contains(datasetIndex);

    private async Task ToggleSeriesAsync(int legendIndex)
    {
        bool hidden;
        if (_hidden.Contains(legendIndex))
        {
            _hidden.Remove(legendIndex);
            hidden = false;
        }
        else
        {
            _hidden.Add(legendIndex);
            hidden = true;
        }

        _tip = null; // avoid a stale tooltip after the layout changes
        var label = legendIndex < LegendItemList.Count ? LegendItemList[legendIndex].Label : "";
        if (OnSeriesToggle.HasDelegate)
        {
            await OnSeriesToggle.InvokeAsync(new ChartSeriesToggle(legendIndex, label, hidden));
        }
    }

    private void ShowTip(int datasetIndex, int valueIndex, double anchorX, double anchorY)
    {
        // Index mode owns the tooltip: a per-point card would fight the crosshair card.
        if (!ShowTooltip || IndexTooltipActive) return;
        _tip = TipContext(datasetIndex, valueIndex);
        _tipX = anchorX;
        _tipY = anchorY;
    }

    private void HideTip() => _tip = null;

    private ChartTooltipContext TipContext(int datasetIndex, int valueIndex)
    {
        var ds = Data.Datasets[datasetIndex];
        var label = XValueLabel(valueIndex);
        var value = valueIndex < ds.Values.Length ? ds.Values[valueIndex] : 0;
        return new ChartTooltipContext(datasetIndex, valueIndex, label, value, ds.Label, SegmentColor(datasetIndex, valueIndex));
    }

    // X label for a data index: the full date on a time axis, otherwise the category label.
    private string XValueLabel(int valueIndex)
    {
        if (IsTimeAxis && valueIndex < Data.TimePoints!.Length)
        {
            var tp = Data.TimePoints;
            var subDay = tp.Length > 1 && (tp.Max() - tp.Min()).TotalDays <= 2;
            return tp[valueIndex].ToString(subDay ? "g" : "d", CultureInfo.CurrentCulture);
        }

        return valueIndex < Data.Labels.Length ? Data.Labels[valueIndex] : "";
    }

    private string SegmentColor(int datasetIndex, int valueIndex)
    {
        var ds = Data.Datasets[datasetIndex];
        return Type is ChartType.Pie or ChartType.Donut
            ? ResolveFillColor(ds, valueIndex, PaletteColor(valueIndex))
            : ResolveFillColor(ds, valueIndex, ds.BackgroundColor ?? ds.Color);
    }

    private double MaxVal
    {
        get
        {
            double m = 0;
            if (PerValue)
            {
                var ds = Data.Datasets[0];
                for (int i = 0; i < ds.Values.Length; i++)
                    if (!IsSegmentHidden(0, i) && ds.Values[i] > m) m = ds.Values[i];
            }
            else
            {
                for (int di = 0; di < Data.Datasets.Length; di++)
                {
                    if (IsSegmentHidden(di, -1)) continue;
                    foreach (var v in Data.Datasets[di].Values)
                        if (v > m) m = v;
                }
            }
            return m == 0 ? 1 : m;
        }
    }

    private static string F(double v) =>
        v.ToString("0.##", CultureInfo.InvariantCulture);

    private static string PaletteColor(int index) => ChartSeriesTokens.Series(index);

    private List<LegendItem> LegendItemList
    {
        get
        {
            var list = new List<LegendItem>();
            if (Type == ChartType.Treemap && TreeNodes is { Count: > 0 })
            {
                for (int i = 0; i < TreeNodes.Count; i++)
                {
                    list.Add(new LegendItem(TreeNodes[i].Label, TreeNodes[i].Color ?? PaletteColor(i)));
                }
                return list;
            }

            if (Data is null)
            {
                return list;
            }

            if (Type == ChartType.Waterfall)
            {
                list.Add(new LegendItem(Loc["TmChart_Increase"], "var(--tm-color-success)"));
                list.Add(new LegendItem(Loc["TmChart_Decrease"], "var(--tm-color-danger)"));
                list.Add(new LegendItem(Loc["TmChart_Total"], "var(--tm-color-primary)"));
                return list;
            }

            if (UsesPerValueLegend())
            {
                var dataset = Data.Datasets[0];
                var count = Math.Min(Data.Labels.Length, dataset.Values.Length);
                for (int i = 0; i < count; i++)
                {
                    list.Add(new LegendItem(Data.Labels[i], ResolveLegendFillColor(dataset, i)));
                }
                return list;
            }

            foreach (var dataset in Data.Datasets)
            {
                list.Add(new LegendItem(dataset.Label, dataset.Color));
            }
            return list;
        }
    }

    private async Task HandleClick(int di, int idx)
    {
        if (!OnSegmentClick.HasDelegate) return;
        var label = XValueLabel(idx);
        var value = di < Data.Datasets.Length && idx < Data.Datasets[di].Values.Length
            ? Data.Datasets[di].Values[idx] : 0;
        await OnSegmentClick.InvokeAsync(new ChartSegment(di, idx, label, value));
    }

    // ── All chart rendering via RenderTreeBuilder to avoid SVG <text> / Razor @<text> conflict ──

    private RenderFragment ChartContent => builder =>
    {
        switch (Type)
        {
            case ChartType.Bar:
                BuildGrid(builder);
                BuildBarChart(builder);
                BuildComboLineOverlay(builder);
                break;
            case ChartType.Line:
                BuildGrid(builder);
                BuildLineChart(builder);
                break;
            case ChartType.Pie:
                BuildPieDonut(builder, false);
                break;
            case ChartType.Donut:
                BuildPieDonut(builder, true);
                break;
            case ChartType.HorizontalBar:
                BuildHorizontalGrid(builder);
                BuildHorizontalBarChart(builder);
                break;
            case ChartType.Area:
                BuildAreaGrid(builder);
                BuildAreaChart(builder);
                break;
            case ChartType.Funnel:
                BuildFunnel(builder);
                break;
            case ChartType.Heatmap:
                BuildHeatmap(builder);
                break;
            case ChartType.Treemap:
                BuildTreemap(builder);
                break;
            case ChartType.StackedBar:
                BuildStackedGrid(builder);
                BuildStackedBarChart(builder);
                break;
            case ChartType.StackedHorizontalBar:
                BuildHorizontalGrid(builder);
                BuildStackedHorizontalBarChart(builder);
                break;
            case ChartType.StackedArea:
                BuildStackedGrid(builder);
                BuildStackedAreaChart(builder);
                break;
            case ChartType.Waterfall:
                BuildWaterfallGrid(builder);
                BuildWaterfallChart(builder);
                break;
        }
    };

    // ── Signed value domain for vertical Bar (incl. combo overlays) ──
    // 0-based when every visible value is non-negative (existing behavior); extends below
    // zero when any value is negative (e.g. cashflow), with an emphasized zero axis.

    private (double Min, double Max) BarValueDomain()
    {
        double min = 0, max = 0;
        if (PerValue)
        {
            var ds = Data.Datasets[0];
            for (int i = 0; i < ds.Values.Length; i++)
            {
                if (IsSegmentHidden(0, i) || double.IsNaN(ds.Values[i])) continue;
                if (ds.Values[i] < min) min = ds.Values[i];
                if (ds.Values[i] > max) max = ds.Values[i];
            }
        }
        else
        {
            for (int di = 0; di < Data.Datasets.Length; di++)
            {
                if (IsSegmentHidden(di, -1)) continue;
                foreach (var v in Data.Datasets[di].Values)
                {
                    if (double.IsNaN(v)) continue;
                    if (v < min) min = v;
                    if (v > max) max = v;
                }
            }
        }

        if (max == min) max = min + 1; // flat/empty — avoid a zero-height domain
        return (min, max);
    }

    private double BarDomainY(double value, double min, double max)
        => PT + CH - ((value - min) / (max - min)) * CH;

    private void BuildGrid(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b)
    {
        if (!ShowGrid) return;
        var (min, max) = BarValueDomain();
        for (int i = 0; i <= 5; i++)
        {
            var value = min + (max - min) * i / 5.0;
            var y = BarDomainY(value, min, max);
            SvgLine(b, "tm-chart__grid-line", PL, y, PL + CW, y);
            SvgText(b, "tm-chart__axis-label", PL - 8, y + 4, F(value), "end");
        }

        // Emphasized zero axis when the domain crosses zero (parity with Area charts).
        if (min < 0)
        {
            var zeroY = BarDomainY(0, min, max);
            b.OpenElement(0, "line");
            b.AddAttribute(1, "class", "tm-chart__axis-zero");
            b.AddAttribute(2, "x1", F(PL));
            b.AddAttribute(3, "y1", F(zeroY));
            b.AddAttribute(4, "x2", F(PL + CW));
            b.AddAttribute(5, "y2", F(zeroY));
            b.AddAttribute(6, "stroke", "var(--tm-color-gray-400)");
            b.AddAttribute(7, "stroke-width", "1");
            b.CloseElement();
        }
    }

    private void BuildHorizontalGrid(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b)
    {
        if (!ShowGrid) return;
        for (int s = 0; s <= 5; s++)
        {
            var x = PL + (CW * s / 5.0);
            SvgLine(b, "tm-chart__grid-line", x, PT, x, PT + CH);
        }
    }

    // Original dataset indices that render as bars (RenderAs != Line) — combo charts keep
    // click/tooltip payloads on the ORIGINAL index while bar slots are packed positionally.
    private int[] BarDatasetIndices()
    {
        var result = new List<int>(Data.Datasets.Length);
        for (int di = 0; di < Data.Datasets.Length; di++)
        {
            if (Data.Datasets[di].RenderAs != ChartDatasetRenderAs.Line)
                result.Add(di);
        }
        return result.ToArray();
    }

    private void BuildBarChart(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b)
    {
        var (min, max) = BarValueDomain();
        var zeroY = BarDomainY(0, min, max);
        var lc = Data.Labels.Length;
        var barIndices = BarDatasetIndices();
        var dc = barIndices.Length;
        var gw = CW / (double)lc;
        var gp = gw * 0.15;

        if (dc > 0)
        {
            var bw = (gw * 0.7) / dc;
            for (int slot = 0; slot < dc; slot++)
            {
                var di = barIndices[slot];
                var ds = Data.Datasets[di];
                for (int i = 0; i < ds.Values.Length && i < lc; i++)
                {
                    if (IsSegmentHidden(di, i)) continue;
                    var val = ds.Values[i];
                    // Bars grow from the ZERO baseline: up for positive, down for negative values.
                    var valY = BarDomainY(val, min, max);
                    var y = Math.Min(valY, zeroY);
                    var bh = Math.Abs(zeroY - valY);
                    var x = PL + i * gw + gp + slot * bw;
                    var fill = ResolveFillColor(ds, i, ds.BackgroundColor ?? ds.Color);
                    SvgRect(b, x, y, bw, bh, fill, ds.Color, di, i, x + bw / 2, y);
                    if (ShowValues)
                        SvgText(b, "tm-chart__value", x + bw / 2, val < 0 ? y + bh + 12 : y - 4, F(val), "middle");
                }
            }
        }

        // Dense categorical axes thin their labels (every n-th) so they never overlap;
        // charts with up to 24 categories keep every label (existing behavior).
        var labelStep = lc > 24 ? (int)Math.Ceiling(lc / 12.0) : 1;
        for (int i = 0; i < lc; i += labelStep)
        {
            var cx = PL + i * gw + gw / 2.0;
            SvgText(b, "tm-chart__label", cx, PT + CH + 24, Data.Labels[i], "middle");
        }
    }

    /// <summary>
    /// Combo chart: datasets with <see cref="ChartDatasetRenderAs.Line"/> render as a line
    /// overlay (polyline + clickable points) over the bars, centered on each category and
    /// sharing the bars' Y scale.
    /// </summary>
    private void BuildComboLineOverlay(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b)
    {
        var lc = Data.Labels.Length;
        if (lc == 0) return;
        var (min, max) = BarValueDomain();
        var gw = CW / (double)lc;

        for (int di = 0; di < Data.Datasets.Length; di++)
        {
            var ds = Data.Datasets[di];
            if (ds.RenderAs != ChartDatasetRenderAs.Line) continue;
            if (IsSegmentHidden(di, -1)) continue;

            var sb = new System.Text.StringBuilder();
            for (int i = 0; i < ds.Values.Length && i < lc; i++)
            {
                if (double.IsNaN(ds.Values[i])) continue;
                var x = PL + i * gw + gw / 2.0;
                var y = BarDomainY(ds.Values[i], min, max);
                if (sb.Length > 0) sb.Append(' ');
                sb.Append(F(x)).Append(',').Append(F(y));
            }

            b.OpenElement(0, "polyline");
            b.AddAttribute(1, "class", "tm-chart__line");
            b.AddAttribute(2, "points", sb.ToString());
            b.AddAttribute(3, "fill", "none");
            b.AddAttribute(4, "stroke", ds.Color);
            b.AddAttribute(5, "stroke-width", "2");
            b.AddAttribute(6, "stroke-linejoin", "round");
            b.CloseElement();

            // Dense series thin their point markers (overlapping white-stroked circles would
            // make the line look dotted); the polyline itself always stays complete.
            var markerStep = Math.Max(1, (int)Math.Ceiling(24.0 / gw));
            for (int i = 0; i < ds.Values.Length && i < lc; i++)
            {
                if (double.IsNaN(ds.Values[i]) || i % markerStep != 0) continue;
                var x = PL + i * gw + gw / 2.0;
                var y = BarDomainY(ds.Values[i], min, max);
                var cdi = di;
                var ci = i;
                var tipX = x;

                b.OpenElement(0, "circle");
                b.AddAttribute(1, "class", "tm-chart__point");
                b.AddAttribute(2, "cx", F(x));
                b.AddAttribute(3, "cy", F(y));
                b.AddAttribute(4, "r", "4");
                b.AddAttribute(5, "fill", ds.Color);
                b.AddAttribute(6, "stroke", "var(--tm-bg-surface)");
                b.AddAttribute(7, "stroke-width", "2");
                b.AddAttribute(8, "onclick",
                    EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(
                        this, () => HandleClick(cdi, ci)));
                b.AddAttribute(9, "onmouseover",
                    EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(
                        this, () => ShowTip(cdi, ci, tipX, y)));
                b.AddAttribute(10, "onmouseout",
                    EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, HideTip));
                b.CloseElement();

                if (ShowValues)
                    SvgText(b, "tm-chart__value", x, y - 10, F(ds.Values[i]), "middle");
            }
        }
    }

    private void BuildHorizontalBarChart(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b)
    {
        var max = MaxVal;
        var lc = Data.Labels.Length;
        var dc = Data.Datasets.Length;
        var gh = CH / (double)lc;
        var bh = (gh * 0.7) / dc;
        var gp = gh * 0.15;

        for (int di = 0; di < dc; di++)
        {
            var ds = Data.Datasets[di];
            for (int i = 0; i < ds.Values.Length && i < lc; i++)
            {
                if (IsSegmentHidden(di, i)) continue;
                var val = ds.Values[i];
                var bw = (val / max) * CW;
                var y = PT + i * gh + gp + di * bh;
                var fill = ResolveFillColor(ds, i, ds.BackgroundColor ?? ds.Color);
                SvgRect(b, PL, y, bw, bh, fill, ds.Color, di, i, PL + bw + 6, y + bh / 2);
                if (ShowValues)
                    SvgText(b, "tm-chart__value", PL + bw + 6, y + bh / 2 + 4, F(val), "start");
            }
        }
        for (int i = 0; i < lc; i++)
        {
            var cy = PT + i * gh + gh / 2.0;
            SvgText(b, "tm-chart__label", PL - 8, cy + 4, Data.Labels[i], "end");
        }
    }

    private void BuildLineChart(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b)
    {
        var (min, max) = BarValueDomain();
        var plan = XPlan();

        for (int di = 0; di < Data.Datasets.Length; di++)
        {
            if (IsSegmentHidden(di, -1)) continue;
            var ds = Data.Datasets[di];
            var sb = new System.Text.StringBuilder();
            foreach (var (i, x) in plan)
            {
                if (i >= ds.Values.Length || double.IsNaN(ds.Values[i])) continue;
                var y = BarDomainY(ds.Values[i], min, max);
                if (sb.Length > 0) sb.Append(' ');
                sb.Append(F(x)).Append(',').Append(F(y));
            }

            // Polyline
            b.OpenElement(0, "polyline");
            b.AddAttribute(1, "class", "tm-chart__line");
            b.AddAttribute(2, "points", sb.ToString());
            b.AddAttribute(3, "fill", "none");
            b.AddAttribute(4, "stroke", ds.Color);
            b.AddAttribute(5, "stroke-width", "2");
            b.AddAttribute(6, "stroke-linejoin", "round");
            b.CloseElement();

            // Data points (dense series thin the markers; the polyline stays complete)
            var lineMarkerStep = Math.Max(1, (int)Math.Ceiling(plan.Length * 24.0 / CW));
            var planOrdinal = -1;
            foreach (var (i, x) in plan)
            {
                planOrdinal++;
                if (i >= ds.Values.Length || double.IsNaN(ds.Values[i]) || planOrdinal % lineMarkerStep != 0) continue;
                var y = BarDomainY(ds.Values[i], min, max);
                var cdi = di;
                var ci = i;
                var tipX = x;

                b.OpenElement(0, "circle");
                b.AddAttribute(1, "class", "tm-chart__point");
                b.AddAttribute(2, "cx", F(x));
                b.AddAttribute(3, "cy", F(y));
                b.AddAttribute(4, "r", "4");
                b.AddAttribute(5, "fill", ds.Color);
                b.AddAttribute(6, "stroke", "var(--tm-bg-surface)");
                b.AddAttribute(7, "stroke-width", "2");
                b.AddAttribute(8, "onclick",
                    EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(
                        this, () => HandleClick(cdi, ci)));
                b.AddAttribute(9, "onmouseover",
                    EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(
                        this, () => ShowTip(cdi, ci, tipX, y)));
                b.AddAttribute(10, "onmouseout",
                    EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, HideTip));
                b.CloseElement();

                if (ShowValues)
                    SvgText(b, "tm-chart__value", x, y - 10, F(ds.Values[i]), "middle");
            }
        }

        BuildXAxisLabels(b);
    }

    // ── DateTime X axis (TMPO-004) ──
    // A proportional time axis for Line/Area: unsorted input is sorted internally, duplicate
    // timestamps keep the last value, and labels are generated at nice unit boundaries
    // (hours/days/months/years by range) and thinned so they never overlap.

    private bool IsTimeAxis => Data.TimePoints is { Length: > 0 } && Type is ChartType.Line or ChartType.Area;

    // Data indices ordered by timestamp; duplicate timestamps keep the LAST input occurrence.
    private int[] TimeOrderedIndices()
    {
        var tp = Data.TimePoints!;
        var order = Enumerable.Range(0, tp.Length).OrderBy(i => tp[i]).ToArray(); // stable sort
        var result = new List<int>(order.Length);
        for (int k = 0; k < order.Length; k++)
        {
            if (k + 1 < order.Length && tp[order[k]] == tp[order[k + 1]])
            {
                System.Diagnostics.Debug.WriteLine(
                    $"TmChart: duplicate TimePoints value {tp[order[k]]:O} — keeping the last occurrence.");
                continue;
            }
            result.Add(order[k]);
        }
        return [.. result];
    }

    private (DateTime Min, DateTime Max) TimeRange(int[] orderedIndices)
    {
        var tp = Data.TimePoints!;
        var min = TimeAxisMin ?? tp[orderedIndices[0]];
        var max = TimeAxisMax ?? tp[orderedIndices[^1]];
        if (max < min) (min, max) = (max, min);
        return (min, max);
    }

    private double TimeX(DateTime t, DateTime min, DateTime max)
    {
        var span = (max - min).Ticks;
        return span == 0 ? PL + CW / 2.0 : PL + (t - min).Ticks / (double)span * CW;
    }

    // The X layout shared by Line and Area: (data index, x) pairs in render order.
    private (int Index, double X)[] XPlan()
    {
        if (IsTimeAxis)
        {
            var ordered = TimeOrderedIndices();
            var (min, max) = TimeRange(ordered);
            return [.. ordered.Select(i => (i, TimeX(Data.TimePoints![i], min, max)))];
        }

        var lc = Data.Labels.Length;
        var sx = CW / (double)Math.Max(lc - 1, 1);
        return [.. Enumerable.Range(0, lc).Select(i => (i, PL + i * sx))];
    }

    private void BuildXAxisLabels(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b)
    {
        if (IsTimeAxis)
        {
            var ordered = TimeOrderedIndices();
            var (min, max) = TimeRange(ordered);
            BuildTimeAxisLabels(b, min, max);
            return;
        }

        var lc = Data.Labels.Length;
        var sx = CW / (double)Math.Max(lc - 1, 1);
        for (int i = 0; i < lc; i++)
        {
            SvgText(b, "tm-chart__label", PL + i * sx, PT + CH + 24, Data.Labels[i], "middle");
        }
    }

    private void BuildTimeAxisLabels(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b, DateTime min, DateTime max)
    {
        var range = max - min;
        var ticks = new List<DateTime>();
        string format;

        if (range == TimeSpan.Zero)
        {
            format = TimeLabelFormat ?? "d";
            ticks.Add(min);
        }
        else if (range.TotalDays <= 2)
        {
            format = TimeLabelFormat ?? "t";
            var t = new DateTime(min.Year, min.Month, min.Day, min.Hour, 0, 0, min.Kind);
            if (t < min) t = t.AddHours(1);
            for (; t <= max; t = t.AddHours(1)) ticks.Add(t);
        }
        else if (range.TotalDays <= 92)
        {
            format = TimeLabelFormat ?? "d";
            var t = min.Date;
            if (t < min) t = t.AddDays(1);
            for (; t <= max; t = t.AddDays(1)) ticks.Add(t);
        }
        else if (range.TotalDays <= 365.25 * 4)
        {
            format = TimeLabelFormat ?? "MMM yyyy";
            var t = new DateTime(min.Year, min.Month, 1, 0, 0, 0, min.Kind);
            if (t < min) t = t.AddMonths(1);
            for (; t <= max; t = t.AddMonths(1)) ticks.Add(t);
        }
        else
        {
            format = TimeLabelFormat ?? "yyyy";
            var t = new DateTime(min.Year, 1, 1, 0, 0, 0, min.Kind);
            if (t < min) t = t.AddYears(1);
            for (; t <= max; t = t.AddYears(1)) ticks.Add(t);
        }

        // Thin the ticks so at most 8 labels render — labels must never overlap.
        const int maxLabels = 8;
        var step = Math.Max(1, (int)Math.Ceiling(ticks.Count / (double)maxLabels));
        var culture = CultureInfo.CurrentCulture;
        for (int k = 0; k < ticks.Count; k += step)
        {
            var x = TimeX(ticks[k], min, max);
            SvgText(b, "tm-chart__label", x, PT + CH + 24, ticks[k].ToString(format, culture), "middle");
        }
    }

    // ── Area chart (TMPO-003) ──
    // Supports negative values (fill closes on the ZERO baseline, never the chart bottom),
    // gaps (NaN breaks the area into segments), and a single point (dot + stem to the axis).

    private readonly string _areaGradientUid = Guid.NewGuid().ToString("N");

    private (double Min, double Max) AreaDomain()
    {
        double min = 0, max = 0;
        for (int di = 0; di < Data.Datasets.Length; di++)
        {
            if (IsSegmentHidden(di, -1)) continue;
            foreach (var v in Data.Datasets[di].Values)
            {
                if (double.IsNaN(v)) continue;
                if (v < min) min = v;
                if (v > max) max = v;
            }
        }
        if (max == min) max = min + 1; // flat/empty series — avoid a zero-height domain
        return (min, max);
    }

    private double AreaY(double value, double min, double max)
        => PT + CH - ((value - min) / (max - min)) * CH;

    private void BuildAreaGrid(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b)
    {
        if (!ShowGrid) return;
        var (min, max) = AreaDomain();
        for (int i = 0; i <= 5; i++)
        {
            var value = min + (max - min) * i / 5.0;
            var y = AreaY(value, min, max);
            SvgLine(b, "tm-chart__grid-line", PL, y, PL + CW, y);
            SvgText(b, "tm-chart__axis-label", PL - 8, y + 4, F(value), "end");
        }

        // Emphasized zero axis when the domain crosses zero.
        if (min < 0)
        {
            var zeroY = AreaY(0, min, max);
            b.OpenElement(0, "line");
            b.AddAttribute(1, "class", "tm-chart__axis-zero");
            b.AddAttribute(2, "x1", F(PL));
            b.AddAttribute(3, "y1", F(zeroY));
            b.AddAttribute(4, "x2", F(PL + CW));
            b.AddAttribute(5, "y2", F(zeroY));
            b.AddAttribute(6, "stroke", "var(--tm-color-gray-400)");
            b.AddAttribute(7, "stroke-width", "1");
            b.CloseElement();
        }
    }

    private void BuildAreaChart(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b)
    {
        var (min, max) = AreaDomain();
        var plan = XPlan();
        var zeroY = AreaY(0, min, max);

        if (AreaGradient)
        {
            b.OpenElement(0, "defs");
            for (int di = 0; di < Data.Datasets.Length; di++)
            {
                if (IsSegmentHidden(di, -1)) continue;
                var ds = Data.Datasets[di];
                b.OpenElement(1, "linearGradient");
                b.AddAttribute(2, "id", $"tm-area-grad-{_areaGradientUid}-{di}");
                b.AddAttribute(3, "x1", "0");
                b.AddAttribute(4, "y1", "0");
                b.AddAttribute(5, "x2", "0");
                b.AddAttribute(6, "y2", "1");
                b.OpenElement(7, "stop");
                b.AddAttribute(8, "offset", "0%");
                b.AddAttribute(9, "stop-color", ds.BackgroundColor ?? ds.Color);
                b.AddAttribute(10, "stop-opacity", "0.5");
                b.CloseElement();
                b.OpenElement(11, "stop");
                b.AddAttribute(12, "offset", "100%");
                b.AddAttribute(13, "stop-color", ds.BackgroundColor ?? ds.Color);
                b.AddAttribute(14, "stop-opacity", "0");
                b.CloseElement();
                b.CloseElement(); // linearGradient
            }
            b.CloseElement(); // defs
        }

        for (int di = 0; di < Data.Datasets.Length; di++)
        {
            if (IsSegmentHidden(di, -1)) continue;
            var ds = Data.Datasets[di];

            // Split the series into contiguous runs of non-NaN values (NaN = gap in the area).
            var runs = new List<List<(int Index, double X, double Y)>>();
            List<(int Index, double X, double Y)>? current = null;
            foreach (var (i, x) in plan)
            {
                if (i >= ds.Values.Length || double.IsNaN(ds.Values[i]))
                {
                    current = null;
                    continue;
                }
                if (current is null)
                {
                    current = [];
                    runs.Add(current);
                }
                current.Add((i, x, AreaY(ds.Values[i], min, max)));
            }

            var fill = AreaGradient
                ? $"url(#tm-area-grad-{_areaGradientUid}-{di})"
                : ds.BackgroundColor ?? ds.Color;

            foreach (var run in runs)
            {
                if (run.Count == 1)
                {
                    // Degenerate area: a lone point renders as a dot with a stem to the zero axis.
                    var (_, x, y) = run[0];
                    b.OpenElement(0, "line");
                    b.AddAttribute(1, "class", "tm-chart__area-stem");
                    b.AddAttribute(2, "x1", F(x));
                    b.AddAttribute(3, "y1", F(y));
                    b.AddAttribute(4, "x2", F(x));
                    b.AddAttribute(5, "y2", F(zeroY));
                    b.AddAttribute(6, "stroke", ds.Color);
                    b.AddAttribute(7, "stroke-width", "2");
                    b.CloseElement();
                    continue;
                }

                // Closed area path: along the values, then back along the zero baseline.
                var sb = new System.Text.StringBuilder();
                sb.Append("M ").Append(F(run[0].X)).Append(',').Append(F(run[0].Y));
                for (int p = 1; p < run.Count; p++)
                    sb.Append(" L ").Append(F(run[p].X)).Append(',').Append(F(run[p].Y));
                sb.Append(" L ").Append(F(run[^1].X)).Append(',').Append(F(zeroY));
                sb.Append(" L ").Append(F(run[0].X)).Append(',').Append(F(zeroY));
                sb.Append(" Z");

                b.OpenElement(0, "path");
                b.AddAttribute(1, "class", AreaGradient ? "tm-chart__area tm-chart__area--gradient" : "tm-chart__area");
                b.AddAttribute(2, "d", sb.ToString());
                b.AddAttribute(3, "fill", fill);
                b.AddAttribute(4, "stroke", "none");
                if (!AreaGradient && AreaOpacity is { } requestedOpacity)
                {
                    var opacity = Math.Clamp(requestedOpacity, 0, 1);
                    b.AddAttribute(5, "fill-opacity", F(opacity));
                    b.AddAttribute(6, "style", $"--tm-chart-area-opacity:{F(opacity)};");
                }
                b.CloseElement();

                // Top line over the run (visual consistency with the Line type).
                var pts = new System.Text.StringBuilder();
                foreach (var (_, x, y) in run)
                {
                    if (pts.Length > 0) pts.Append(' ');
                    pts.Append(F(x)).Append(',').Append(F(y));
                }
                b.OpenElement(0, "polyline");
                b.AddAttribute(1, "class", "tm-chart__line");
                b.AddAttribute(2, "points", pts.ToString());
                b.AddAttribute(3, "fill", "none");
                b.AddAttribute(4, "stroke", ds.Color);
                b.AddAttribute(5, "stroke-width", "2");
                b.AddAttribute(6, "stroke-linejoin", "round");
                b.CloseElement();
            }

            // Interactive data points for every non-NaN value.
            foreach (var run in runs)
            {
                foreach (var (i, x, y) in run)
                {
                    var cdi = di;
                    var ci = i;
                    b.OpenElement(0, "circle");
                    b.AddAttribute(1, "class", "tm-chart__point");
                    b.AddAttribute(2, "cx", F(x));
                    b.AddAttribute(3, "cy", F(y));
                    b.AddAttribute(4, "r", "4");
                    b.AddAttribute(5, "fill", ds.Color);
                    b.AddAttribute(6, "stroke", "var(--tm-bg-surface)");
                    b.AddAttribute(7, "stroke-width", "2");
                    b.AddAttribute(8, "onclick",
                        EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(
                            this, () => HandleClick(cdi, ci)));
                    b.AddAttribute(9, "onmouseover",
                        EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(
                            this, () => ShowTip(cdi, ci, x, y)));
                    b.AddAttribute(10, "onmouseout",
                        EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, HideTip));
                    b.CloseElement();

                    if (ShowValues)
                        SvgText(b, "tm-chart__value", x, y - 10, F(ds.Values[i]), "middle");
                }
            }
        }

        BuildXAxisLabels(b);
    }

    private void BuildPieDonut(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b, bool isDonut)
    {
        if (Data.Datasets.Length == 0) return;
        var ds = Data.Datasets[0];
        double total = 0;
        for (int i = 0; i < ds.Values.Length; i++)
            if (!IsSegmentHidden(0, i)) total += ds.Values[i];
        if (total == 0) return;

        var cx = SvgW / 2.0;
        var cy = SvgH / 2.0;
        var outerR = Math.Min(SvgW, SvgH) / 2.0 - 20;
        var innerR = isDonut ? outerR * 0.55 : 0.0;

        double startAngle = -Math.PI / 2;

        for (int i = 0; i < ds.Values.Length; i++)
        {
            if (IsSegmentHidden(0, i)) continue;
            var val = ds.Values[i];
            var sliceAngle = (val / total) * 2 * Math.PI;
            var endAngle = startAngle + sliceAngle;
            var largeArc = sliceAngle > Math.PI ? 1 : 0;
            var midAngle = startAngle + sliceAngle / 2;

            var x1o = cx + outerR * Math.Cos(startAngle);
            var y1o = cy + outerR * Math.Sin(startAngle);
            var x2o = cx + outerR * Math.Cos(endAngle);
            var y2o = cy + outerR * Math.Sin(endAngle);

            string path;
            if (isDonut)
            {
                var x1i = cx + innerR * Math.Cos(startAngle);
                var y1i = cy + innerR * Math.Sin(startAngle);
                var x2i = cx + innerR * Math.Cos(endAngle);
                var y2i = cy + innerR * Math.Sin(endAngle);
                path = $"M {F(x1o)},{F(y1o)} " +
                       $"A {F(outerR)},{F(outerR)} 0 {largeArc},1 {F(x2o)},{F(y2o)} " +
                       $"L {F(x2i)},{F(y2i)} " +
                       $"A {F(innerR)},{F(innerR)} 0 {largeArc},0 {F(x1i)},{F(y1i)} Z";
            }
            else
            {
                path = $"M {F(cx)},{F(cy)} " +
                       $"L {F(x1o)},{F(y1o)} " +
                       $"A {F(outerR)},{F(outerR)} 0 {largeArc},1 {F(x2o)},{F(y2o)} Z";
            }

            var capturedI = i;
            var labelR = (outerR + innerR) / 2;
            var tipX = cx + labelR * Math.Cos(midAngle);
            var tipY = cy + labelR * Math.Sin(midAngle);

            b.OpenElement(0, "path");
            b.AddAttribute(1, "class", "tm-chart__slice");
            b.AddAttribute(2, "d", path);
            b.AddAttribute(3, "fill", ResolveFillColor(ds, i, PaletteColor(i)));
            b.AddAttribute(4, "stroke", "var(--tm-bg-surface)");
            b.AddAttribute(5, "stroke-width", "2");
            b.AddAttribute(6, "onclick",
                EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(
                    this, () => HandleClick(0, capturedI)));
            b.AddAttribute(7, "onmouseover",
                EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(
                    this, () => ShowTip(0, capturedI, tipX, tipY)));
            b.AddAttribute(8, "onmouseout",
                EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, HideTip));
            b.CloseElement();

            startAngle = endAngle;
        }
    }

    // ── Tooltip (rendered inside the SVG as a foreignObject so it scales with the chart; no JS) ──

    private RenderFragment TooltipContent => builder =>
    {
        if (!ShowTooltip || _tip is null) return;

        const double boxW = 160, boxH = 50;
        var fx = Math.Clamp(_tipX - boxW / 2, 0, SvgW - boxW);
        var fy = Math.Clamp(_tipY - boxH - 8, 0, SvgH - boxH);

        builder.OpenElement(0, "foreignObject");
        builder.AddAttribute(1, "class", "tm-chart__tooltip-fo");
        builder.AddAttribute(2, "x", F(fx));
        builder.AddAttribute(3, "y", F(fy));
        builder.AddAttribute(4, "width", F(boxW));
        builder.AddAttribute(5, "height", F(boxH));
        builder.AddAttribute(6, "style", "pointer-events:none;overflow:visible;");

        builder.OpenElement(7, "div");
        builder.AddAttribute(8, "xmlns", "http://www.w3.org/1999/xhtml");
        builder.AddAttribute(9, "class", "tm-chart__tooltip");
        builder.AddAttribute(10, "data-testid", TestId("chart-tooltip"));

        if (TooltipTemplate is not null)
        {
            builder.AddContent(11, TooltipTemplate(_tip));
        }
        else
        {
            builder.OpenElement(12, "span");
            builder.AddAttribute(13, "class", "tm-chart__tooltip-label");
            builder.AddContent(14, _tip.Label);
            builder.CloseElement();

            builder.OpenElement(15, "span");
            builder.AddAttribute(16, "class", "tm-chart__tooltip-value");
            builder.OpenElement(17, "span");
            builder.AddAttribute(18, "class", "tm-chart__tooltip-dot");
            builder.AddAttribute(19, "style", $"background-color:{_tip.Color};");
            builder.CloseElement();
            var text = Data is { Datasets.Length: > 1 } ? $"{_tip.DatasetLabel}: {F(_tip.Value)}" : F(_tip.Value);
            builder.AddContent(20, text);
            builder.CloseElement();
        }

        builder.CloseElement(); // div
        builder.CloseElement(); // foreignObject
    };

    // ── Waterfall chart ──

    private sealed record WaterfallBar(
        int Index,
        string Label,
        double Delta,
        double Start,
        double End,
        bool IsTotal);

    private List<WaterfallBar> WaterfallBars()
    {
        var bars = new List<WaterfallBar>();
        if (Data is null || Data.Datasets.Length == 0) return bars;

        var values = Data.Datasets[0].Values;
        var count = Math.Min(Data.Labels.Length, values.Length);
        double cumulative = 0;
        for (int i = 0; i < count; i++)
        {
            var delta = double.IsNaN(values[i]) ? 0 : values[i];
            var start = i == 0 ? 0 : cumulative;
            var end = i == 0 ? delta : cumulative + delta;
            bars.Add(new WaterfallBar(i, Data.Labels[i], delta, start, end, false));
            cumulative = end;
        }

        if (WaterfallShowTotal && bars.Count > 0)
        {
            bars.Add(new WaterfallBar(
                count,
                Loc["TmChart_Total"],
                cumulative,
                0,
                cumulative,
                true));
        }

        return bars;
    }

    private (double Min, double Max) WaterfallDomain(IReadOnlyList<WaterfallBar> bars)
    {
        double min = 0, max = 0;
        foreach (var bar in bars)
        {
            min = Math.Min(min, Math.Min(bar.Start, bar.End));
            max = Math.Max(max, Math.Max(bar.Start, bar.End));
        }

        if (min == max) max = min + 1;
        return (min, max);
    }

    private void BuildWaterfallGrid(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b)
    {
        if (!ShowGrid) return;
        var bars = WaterfallBars();
        var (min, max) = WaterfallDomain(bars);
        for (int i = 0; i <= 5; i++)
        {
            var value = min + (max - min) * i / 5.0;
            var y = BarDomainY(value, min, max);
            SvgLine(b, "tm-chart__grid-line", PL, y, PL + CW, y);
            SvgText(b, "tm-chart__axis-label", PL - 8, y + 4, F(value), "end");
        }

        if (min < 0)
        {
            var zeroY = BarDomainY(0, min, max);
            b.OpenElement(0, "line");
            b.AddAttribute(1, "class", "tm-chart__axis-zero");
            b.AddAttribute(2, "x1", F(PL));
            b.AddAttribute(3, "y1", F(zeroY));
            b.AddAttribute(4, "x2", F(PL + CW));
            b.AddAttribute(5, "y2", F(zeroY));
            b.CloseElement();
        }
    }

    private void BuildWaterfallChart(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b)
    {
        var bars = WaterfallBars();
        if (bars.Count == 0) return;

        var (min, max) = WaterfallDomain(bars);
        var gw = CW / (double)bars.Count;
        var gp = gw * 0.15;
        var bw = gw * 0.7;

        if (WaterfallShowConnectors)
        {
            for (int i = 0; i < bars.Count - 1; i++)
            {
                var y = BarDomainY(bars[i].End, min, max);
                var x1 = PL + i * gw + gp + bw;
                var x2 = PL + (i + 1) * gw + gp;
                b.OpenElement(0, "line");
                b.AddAttribute(1, "class", "tm-chart__waterfall-connector");
                b.AddAttribute(2, "x1", F(x1));
                b.AddAttribute(3, "y1", F(y));
                b.AddAttribute(4, "x2", F(x2));
                b.AddAttribute(5, "y2", F(y));
                b.CloseElement();
            }
        }

        for (int i = 0; i < bars.Count; i++)
        {
            var bar = bars[i];
            var x = PL + i * gw + gp;
            var startY = BarDomainY(bar.Start, min, max);
            var endY = BarDomainY(bar.End, min, max);
            var y = Math.Min(startY, endY);
            var height = Math.Abs(startY - endY);
            var semanticIndex = bar.IsTotal ? 2 : bar.Delta < 0 ? 1 : 0;

            if (!_hidden.Contains(semanticIndex))
            {
                BuildWaterfallRect(b, bar, x, y, bw, height);
                if (ShowValues)
                {
                    var text = bar.IsTotal || bar.Index == 0
                        ? F(bar.End)
                        : bar.Delta > 0 ? $"+{F(bar.Delta)}" : F(bar.Delta);
                    var valueY = bar.End < bar.Start ? y + height + 12 : y - 4;
                    SvgText(b, "tm-chart__value", x + bw / 2, valueY, text, "middle");
                }
            }

            SvgText(b, "tm-chart__label", x + bw / 2, PT + CH + 24, bar.Label, "middle");
        }
    }

    private void BuildWaterfallRect(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b,
        WaterfallBar bar,
        double x,
        double y,
        double width,
        double height)
    {
        var modifier = bar.IsTotal
            ? "tm-chart__bar--total"
            : bar.Delta < 0 ? "tm-chart__bar--negative" : "tm-chart__bar--positive";
        var color = bar.IsTotal
            ? "var(--tm-color-primary)"
            : bar.Delta < 0 ? "var(--tm-color-danger)" : "var(--tm-color-success)";
        var tipX = x + width / 2;
        var index = bar.Index;
        var label = bar.Label;
        var value = bar.IsTotal ? bar.End : bar.Delta;

        b.OpenElement(0, "rect");
        b.AddAttribute(1, "class", $"tm-chart__bar {modifier}");
        b.AddAttribute(2, "x", F(x));
        b.AddAttribute(3, "y", F(y));
        b.AddAttribute(4, "width", F(width));
        b.AddAttribute(5, "height", F(height));
        b.AddAttribute(6, "onclick",
            EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(
                this, () => HandleWaterfallClick(index, label, value)));
        b.AddAttribute(7, "onmouseover",
            EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(
                this, () => ShowWaterfallTip(index, label, value, color, tipX, y)));
        b.AddAttribute(8, "onmouseout",
            EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, HideTip));
        b.CloseElement();
    }

    private async Task HandleWaterfallClick(int index, string label, double value)
    {
        if (OnSegmentClick.HasDelegate)
        {
            await OnSegmentClick.InvokeAsync(new ChartSegment(0, index, label, value));
        }
    }

    private void ShowWaterfallTip(
        int index,
        string label,
        double value,
        string color,
        double anchorX,
        double anchorY)
    {
        if (!ShowTooltip) return;
        _tip = new ChartTooltipContext(0, index, label, value, Data.Datasets[0].Label, color);
        _tipX = anchorX;
        _tipY = anchorY;
    }

    // ── SVG element helpers ──

    private bool UsesPerValueLegend()
    {
        if (Data is null || Data.Datasets.Length != 1 || Data.Datasets[0].BackgroundColors is null)
        {
            return false;
        }

        return Type is ChartType.Bar or ChartType.HorizontalBar or ChartType.Pie or ChartType.Donut
            or ChartType.Funnel or ChartType.Treemap;
    }

    private string ResolveLegendFillColor(ChartDataset dataset, int index)
    {
        return Type is ChartType.Pie or ChartType.Donut or ChartType.Funnel or ChartType.Treemap
            ? ResolveFillColor(dataset, index, PaletteColor(index))
            : ResolveFillColor(dataset, index, dataset.BackgroundColor ?? dataset.Color);
    }

    private static string ResolveFillColor(ChartDataset dataset, int index, string fallback)
    {
        return dataset.BackgroundColors?.Count > index
            ? dataset.BackgroundColors[index]
            : fallback;
    }

