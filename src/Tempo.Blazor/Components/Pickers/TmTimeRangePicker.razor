@namespace Tempo.Blazor.Components.Pickers

<div class="tm-time-range-picker @Class @(IsInvalid ? "tm-time-range--invalid" : "")" @attributes="RootAttributes">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label id="@_labelId" class="tm-picker-label" for="@_startInputId">@Label</label>
    }

    @* Composite control: `for` targets the start-hours segment; the body is a named group. *@
    <div class="tm-time-range-body"
         role="group"
         aria-labelledby="@(string.IsNullOrEmpty(Label) ? null : _labelId)"
         @attributes="AriaAttributes">
        @* Each end of the range is a named sub-group (same pattern as TmDateTimeRangePicker) so
           assistive tech announces "From"/"To" instead of identical bare Hours/Minutes (N149). *@
        <div class="tm-time-range-section tm-time-range-from"
             role="group"
             aria-labelledby="@_fromLabelId">
            <span id="@_fromLabelId" class="tm-time-range-label">@Loc["TmTimeRangePicker_From"]</span>
            <TmTimeInput Value="@Value.Start"
                         ValueChanged="OnStartChanged"
                         InputId="@_startInputId"
                         ShowSeconds="@ShowSeconds"
                         Disabled="@Disabled" />
        </div>

        <span class="tm-time-range-sep" aria-hidden="true">–</span>

        <div class="tm-time-range-section tm-time-range-to"
             role="group"
             aria-labelledby="@_toLabelId">
            <span id="@_toLabelId" class="tm-time-range-label">@Loc["TmTimeRangePicker_To"]</span>
            <TmTimeInput Value="@Value.End"
                         ValueChanged="OnEndChanged"
                         ShowSeconds="@ShowSeconds"
                         Disabled="@Disabled" />
        </div>

        @if (ShowSwapButton && !Disabled)
        {
            <button type="button"
                    class="tm-time-range-swap-btn tm-btn-icon"
                    aria-label="@Loc["TmTimeRangePicker_Swap"]"
                    title="@Loc["TmTimeRangePicker_Swap"]"
                    @onclick="SwapValues">
                &#8597;
            </button>
        }
    </div>

    @if (IsInvalid)
    {
        <span class="tm-field-error" role="alert">@Loc["TmTimeRangePicker_InvalidRange"]</span>
    }

    @if (ShowDuration && Value.Start.HasValue && Value.End.HasValue && !IsInvalid)
    {
        <span class="tm-time-range-duration">
            @Loc["TmTimeRangePicker_Duration"]: @FormatDuration()
        </span>
    }
</div>

@code {
    [Parameter] public (TimeOnly? Start, TimeOnly? End) Value        { get; set; }
    [Parameter] public EventCallback<(TimeOnly? Start, TimeOnly? End)> ValueChanged { get; set; }
    [Parameter] public bool    ShowDuration   { get; set; }
    [Parameter] public bool    ShowSwapButton { get; set; }
    [Parameter] public bool    ShowSeconds    { get; set; }
    [Parameter] public string? Label          { get; set; }
    [Parameter] public bool    Disabled       { get; set; }
    [Parameter] public string? Class          { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string _labelId      = $"tm-time-range-label-{Guid.NewGuid():N}";
    private readonly string _startInputId = $"tm-time-range-start-{Guid.NewGuid():N}";
    private readonly string _fromLabelId  = $"tm-time-range-from-label-{Guid.NewGuid():N}";
    private readonly string _toLabelId    = $"tm-time-range-to-label-{Guid.NewGuid():N}";

    private bool IsInvalid =>
        Value.Start.HasValue && Value.End.HasValue && Value.End.Value < Value.Start.Value;

    /// <summary>Consumer <c>aria-*</c> attributes target the input group; everything else the root.</summary>
    private IReadOnlyDictionary<string, object>? AriaAttributes =>
        AdditionalAttributes is null
            ? null
            : AdditionalAttributes
                .Where(kv => kv.Key.StartsWith("aria-", StringComparison.OrdinalIgnoreCase))
                .ToDictionary(kv => kv.Key, kv => kv.Value);

    private IReadOnlyDictionary<string, object>? RootAttributes =>
        AdditionalAttributes is null
            ? null
            : AdditionalAttributes
                .Where(kv => !kv.Key.StartsWith("aria-", StringComparison.OrdinalIgnoreCase))
                .ToDictionary(kv => kv.Key, kv => kv.Value);

    private async Task OnStartChanged(TimeOnly? t)
        => await ValueChanged.InvokeAsync((t, Value.End));

    private async Task OnEndChanged(TimeOnly? t)
        => await ValueChanged.InvokeAsync((Value.Start, t));

    private async Task SwapValues()
        => await ValueChanged.InvokeAsync((Value.End, Value.Start));

    private string FormatDuration()
    {
        if (!Value.Start.HasValue || !Value.End.HasValue) return string.Empty;
        var span = Value.End.Value - Value.Start.Value;
        if (span.Hours > 0)
            return $"{span.Hours}h {span.Minutes:D2}m";
        return $"{span.Minutes}m";
    }
}
