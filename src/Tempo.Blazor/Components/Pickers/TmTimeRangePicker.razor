@namespace Tempo.Blazor.Components.Pickers
@using System.Globalization
@using Tempo.Blazor.Abstractions.Layout

<div class="tm-time-range-picker @Class @(IsInvalid ? "tm-time-range--invalid" : "")"
     data-tm-overnight="@(IsOvernight ? "true" : null)"
     @attributes="RootAttributes">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label id="@_labelId" class="tm-picker-label" for="@(UsesOverlay ? null : _startInputId)">@Label</label>
    }

    @* Composite control: `for` targets the start-hours segment in Segments; overlay mode drops
       `for` because Auto on mobile hides the segments and the group is already named by
       aria-labelledby. *@
    <div class="tm-time-range-body"
         role="group"
         aria-labelledby="@(string.IsNullOrEmpty(Label) ? null : _labelId)"
         @attributes="AriaAttributes">
        @* Each end of the range is a named sub-group (same pattern as TmDateTimeRangePicker) so
           assistive tech announces "From"/"To" instead of identical bare Hours/Minutes (N149). *@
        <div class="tm-time-range-section tm-time-range-from"
             role="group"
             aria-labelledby="@_fromLabelId">
            <span id="@_fromLabelId" class="tm-time-range-label">@ResolvedStartLabel</span>
            @if (UsesOverlay)
            {
                <TmTimePicker Value="@Value.Start"
                              ValueChanged="OnStartChanged"
                              InputId="@_startInputId"
                              TriggerId="@_startTriggerId"
                              Presentation="@Presentation"
                              CommitMode="@CommitMode"
                              MinuteStep="@MinuteStep"
                              EnforceStep="@EnforceStep"
                              ShowSeconds="@ShowSeconds"
                              Disabled="@Disabled"
                              ReadOnly="@ReadOnly"
                              HourCycle="@HourCycle"
                              Culture="@Culture"
                              LayoutMode="@LayoutMode"
                              AriaLabelledBy="@_fromLabelId"
                              EnableSwipe="@EnableSwipe" />
            }
            else
            {
                <TmTimeInput Value="@Value.Start"
                             ValueChanged="OnStartChanged"
                             InputId="@_startInputId"
                             ShowSeconds="@ShowSeconds"
                             Disabled="@Disabled"
                             ReadOnly="@ReadOnly"
                             HourCycle="@HourCycle"
                             Culture="@Culture" />
            }
        </div>

        <span class="tm-time-range-sep" aria-hidden="true">–</span>

        <div class="tm-time-range-section tm-time-range-to"
             role="group"
             aria-labelledby="@_toLabelId">
            <span id="@_toLabelId" class="tm-time-range-label">@ResolvedEndLabel</span>
            @if (UsesOverlay)
            {
                <TmTimePicker Value="@Value.End"
                              ValueChanged="OnEndChanged"
                              InputId="@_endInputId"
                              TriggerId="@_endTriggerId"
                              Presentation="@Presentation"
                              CommitMode="@CommitMode"
                              MinuteStep="@MinuteStep"
                              EnforceStep="@EnforceStep"
                              ShowSeconds="@ShowSeconds"
                              Disabled="@Disabled"
                              ReadOnly="@ReadOnly"
                              HourCycle="@HourCycle"
                              Culture="@Culture"
                              LayoutMode="@LayoutMode"
                              AriaLabelledBy="@_toLabelId"
                              EnableSwipe="@EnableSwipe" />
            }
            else
            {
                <TmTimeInput Value="@Value.End"
                             ValueChanged="OnEndChanged"
                             InputId="@_endInputId"
                             ShowSeconds="@ShowSeconds"
                             Disabled="@Disabled"
                             ReadOnly="@ReadOnly"
                             HourCycle="@HourCycle"
                             Culture="@Culture" />
            }
        </div>

        @if (ShowSwapButton && !Disabled && !ReadOnly)
        {
            <button type="button"
                    class="tm-time-range-swap-btn tm-btn-icon"
                    aria-label="@Loc["TmTimeRangePicker_Swap"]"
                    title="@Loc["TmTimeRangePicker_Swap"]"
                    @onclick="SwapValues">
                &#8597;
            </button>
        }
    </div>

    @if (IsInvalid)
    {
        <span class="tm-field-error" role="alert">@Loc["TmTimeRangePicker_InvalidRange"]</span>
    }

    @if (ShowDuration && Value.Start.HasValue && Value.End.HasValue && !IsInvalid)
    {
        <span class="tm-time-range-duration">
            @Loc["TmTimeRangePicker_Duration"]: @FormatDuration()
            @if (IsOvernight)
            {
                <span class="tm-time-range-overnight">@Loc["TmTimeRangePicker_Overnight"]</span>
            }
        </span>
    }
</div>

@code {
    /// <summary>The bound start and end times of day.</summary>
    [Parameter] public (TimeOnly? Start, TimeOnly? End) Value { get; set; }

    /// <summary>Fires when either end of the range changes.</summary>
    [Parameter] public EventCallback<(TimeOnly? Start, TimeOnly? End)> ValueChanged { get; set; }

    /// <summary>When true, a localized duration is rendered below the range. Defaults to false.</summary>
    [Parameter] public bool ShowDuration { get; set; }

    /// <summary>When true, a swap button exchanges start and end. Hidden while Disabled or ReadOnly.</summary>
    [Parameter] public bool ShowSwapButton { get; set; }

    /// <summary>When true, a seconds segment is rendered on both ends. Defaults to false.</summary>
    [Parameter] public bool ShowSeconds { get; set; }

    /// <summary>Visible label that names the composite group.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Disables both ends and the swap button. Distinct from <see cref="ReadOnly"/>.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// 12-hour versus 24-hour clock forwarded to both ends (<c>TmTimeInput</c> in Segments,
    /// <c>TmTimePicker</c> in Popup/Auto). Default
    /// <see cref="TimeHourCycle.Auto"/> follows <see cref="Culture"/>.
    /// </summary>
    [Parameter] public TimeHourCycle HourCycle { get; set; } = TimeHourCycle.Auto;

    /// <summary>
    /// Culture used to resolve <see cref="HourCycle"/>.<see cref="TimeHourCycle.Auto"/>.
    /// Null uses <see cref="CultureInfo.CurrentCulture"/>.
    /// </summary>
    [Parameter] public CultureInfo? Culture { get; set; }

    /// <summary>Additional CSS class(es) for the root element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// When true, <c>End &lt; Start</c> is a valid range that crosses midnight (night shifts).
    /// Defaults to false so today's same-day comparison is unchanged.
    /// </summary>
    [Parameter] public bool AllowOvernightRange { get; set; }

    /// <summary>
    /// How each end presents. Default <see cref="TimePickerPresentation.Segments"/> keeps today's
    /// two <c>TmTimeInput</c> DOM with no overlay. Popup/Auto render two <c>TmTimePicker</c>s that
    /// open <c>TmTimeSelector</c> in a dialog (sheet on a mobile viewport).
    /// </summary>
    [Parameter] public TimePickerPresentation Presentation { get; set; } = TimePickerPresentation.Segments;

    /// <summary>
    /// Shared commit mode for both ends when Presentation is Popup or Auto; ignored by Segments.
    /// Default <see cref="TimeCommitMode.Auto"/>: a sheet holds a draft until Done; a popover
    /// commits live.
    /// </summary>
    [Parameter] public TimeCommitMode CommitMode { get; set; } = TimeCommitMode.Auto;

    /// <summary>
    /// Minute step forwarded to both ends when Presentation is Popup or Auto; ignored by Segments.
    /// Defaults to 1.
    /// </summary>
    [Parameter] public int MinuteStep { get; set; } = 1;

    /// <summary>
    /// Forwards <c>TmTimePicker.EnableSwipe</c> to both overlay ends when Presentation is Popup
    /// or Auto; ignored by Segments. Defaults to false.
    /// </summary>
    [Parameter] public bool EnableSwipe { get; set; }

    /// <summary>
    /// When true, an off-step bound value is marked invalid and never rewritten. Popup/Auto only;
    /// ignored by Segments. Defaults to false.
    /// </summary>
    [Parameter] public bool EnforceStep { get; set; }

    /// <summary>
    /// Renders both ends read-only and hides the swap button. Never assigned inside the component.
    /// Defaults to false.
    /// </summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>
    /// Layout forwarded to both overlay pickers. Auto follows the viewport cascade.
    /// </summary>
    [Parameter] public TmLayoutMode LayoutMode { get; set; } = TmLayoutMode.Auto;

    /// <summary>
    /// Visible label of the start group. Falls back to localized <c>TmTimeRangePicker_From</c>.
    /// </summary>
    [Parameter] public string? StartLabel { get; set; }

    /// <summary>
    /// Visible label of the end group. Falls back to localized <c>TmTimeRangePicker_To</c>.
    /// </summary>
    [Parameter] public string? EndLabel { get; set; }

    /// <summary>
    /// Unmatched attributes. <c>aria-*</c> land on the named group; everything else on the root.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string _labelId        = $"tm-time-range-label-{Guid.NewGuid():N}";
    private readonly string _startInputId   = $"tm-time-range-start-{Guid.NewGuid():N}";
    private readonly string _endInputId     = $"tm-time-range-end-{Guid.NewGuid():N}";
    private readonly string _startTriggerId = $"tm-time-range-start-trigger-{Guid.NewGuid():N}";
    private readonly string _endTriggerId   = $"tm-time-range-end-trigger-{Guid.NewGuid():N}";
    private readonly string _fromLabelId    = $"tm-time-range-from-label-{Guid.NewGuid():N}";
    private readonly string _toLabelId      = $"tm-time-range-to-label-{Guid.NewGuid():N}";

    private bool UsesOverlay => Presentation is TimePickerPresentation.Popup or TimePickerPresentation.Auto;

    private bool IsInvalid =>
        Value.Start.HasValue && Value.End.HasValue
        && !AllowOvernightRange && Value.End.Value < Value.Start.Value;

    private bool IsOvernight =>
        AllowOvernightRange
        && Value.Start.HasValue && Value.End.HasValue
        && Value.End.Value < Value.Start.Value;

    private string ResolvedStartLabel => string.IsNullOrEmpty(StartLabel) ? Loc["TmTimeRangePicker_From"] : StartLabel!;

    private string ResolvedEndLabel => string.IsNullOrEmpty(EndLabel) ? Loc["TmTimeRangePicker_To"] : EndLabel!;

    /// <summary>Consumer <c>aria-*</c> attributes target the input group; everything else the root.</summary>
    private IReadOnlyDictionary<string, object>? AriaAttributes =>
        AdditionalAttributes is null
            ? null
            : AdditionalAttributes
                .Where(kv => kv.Key.StartsWith("aria-", StringComparison.OrdinalIgnoreCase))
                .ToDictionary(kv => kv.Key, kv => kv.Value);

    private IReadOnlyDictionary<string, object>? RootAttributes =>
        AdditionalAttributes is null
            ? null
            : AdditionalAttributes
                .Where(kv => !kv.Key.StartsWith("aria-", StringComparison.OrdinalIgnoreCase))
                .ToDictionary(kv => kv.Key, kv => kv.Value);

    private async Task OnStartChanged(TimeOnly? t)
        => await ValueChanged.InvokeAsync((t, Value.End));

    private async Task OnEndChanged(TimeOnly? t)
        => await ValueChanged.InvokeAsync((Value.Start, t));

    private async Task SwapValues()
        => await ValueChanged.InvokeAsync((Value.End, Value.Start));

    private string FormatDuration()
    {
        if (!Value.Start.HasValue || !Value.End.HasValue)
        {
            return string.Empty;
        }

        var span = TimeOfDayFormat.Duration(Value.Start.Value, Value.End.Value, AllowOvernightRange);
        if (span < TimeSpan.Zero)
        {
            return string.Empty;
        }

        if (span.Hours > 0)
        {
            return Loc["TmTimeRangePicker_DurationHoursMinutes", span.Hours, span.Minutes];
        }

        return Loc["TmTimeRangePicker_DurationMinutes", span.Minutes];
    }
}
