@namespace Tempo.Blazor.Components.Pickers
@using Tempo.Blazor.Components.Icons

@* The label belongs to the TRIGGER, not to the wrapper: a bare <label> with neither `for` nor a
   wrapped control names nothing, so the button had to be named by luck of its content. The label gets
   `for` (native click → focus+activate the trigger) and the trigger gets `aria-labelledby` pointing
   at BOTH the label and the displayed value, so the announced name is "{label}, {value-or-placeholder}".
   `aria-*` keys in AdditionalAttributes are splatted onto the trigger (the element assistive tech
   names and operates); `data-*` and everything else stays on the root, where test ids live. *@
<div class="tm-date-picker @Class" @onkeydown="OnKeyDown" @attributes="RootAttributes">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label id="@_labelId"
               class="tm-picker-label @(Required ? "tm-input-label-required" : "")"
               for="@_triggerId">@Label</label>
    }

    <div class="tm-date-picker-input-row">
        @* No aria-required here: it is not a permitted attribute on a native <button> (ARIA 1.2 /
           HTML-AAM). Requiredness is announced by the tm-input-label-required marker on the label
           and enforced by form validation (N147). *@
        <button type="button"
                @ref="_triggerRef"
                id="@_triggerId"
                class="tm-date-picker-trigger"
                disabled="@Disabled"
                aria-haspopup="true"
                aria-expanded="@_isOpen"
                aria-labelledby="@TriggerLabelledBy"
                @attributes="AriaAttributes"
                @onclick="ToggleCalendar">
            <span id="@_valueId">
                @if (Value.HasValue)
                {
                    @Value.Value.ToString(DateFormat)
                }
                else
                {
                    <span class="tm-picker-placeholder">@(Placeholder ?? Loc["TmDatePicker_Placeholder"])</span>
                }
            </span>
            <span class="tm-date-picker-icon" aria-hidden="true">
                <TmIcon Name="@IconNames.Calendar" Size="IconSize.Sm" />
            </span>
        </button>

        @if (Value.HasValue && !Disabled)
        {
            <button type="button"
                    class="tm-picker-clear"
                    aria-label="@Loc["TmDatePicker_Clear"]"
                    @onclick="ClearValue">
                &#x2715;
            </button>
        }
    </div>

    @* The calendar popup is a TmOverlayPanel: popover="manual" puts it in the browser top layer,
       so a modal's overflow/transform can no longer clip it (the original defect — a date field
       near the end of a scrolling modal body opened its calendar below the fold), and overlay.js
       flips it above the trigger when the space below runs out. Bottom + Start + 4px keeps the
       historical "under the trigger, left-aligned" look (the old top:calc(100%+space-1);left:0). *@
    <TmOverlayPanel Anchor="_triggerRef"
                    IsOpen="_isOpen"
                    IsOpenChanged="SetOpen"
                    Placement="OverlayPlacement.Bottom"
                    Align="OverlayAlign.Start"
                    Offset="4"
                    Role="dialog"
                    Class="tm-date-picker-popup"
                    aria-modal="true">
        <TmCalendarGrid DisplayYear="@_displayYear"
                        DisplayMonth="@_displayMonth"
                        SelectedDate="@Value"
                        MinDate="@MinDate"
                        MaxDate="@MaxDate"
                        OnDateSelected="OnDateSelected"
                        OnNavigate="OnNavigate" />

        <div class="tm-date-picker-footer">
            <button type="button"
                    class="tm-link-button tm-date-today-btn"
                    @onclick="SelectToday">
                @Loc["TmDatePicker_Today"]
            </button>
        </div>
    </TmOverlayPanel>
</div>

@code {
    [Parameter] public DateOnly?  Value        { get; set; }
    [Parameter] public EventCallback<DateOnly?> ValueChanged { get; set; }
    [Parameter] public DateOnly?  MinDate      { get; set; }
    [Parameter] public DateOnly?  MaxDate      { get; set; }
    [Parameter] public string     DateFormat   { get; set; } = "dd.MM.yyyy";
    [Parameter] public string?    Placeholder  { get; set; }
    [Parameter] public bool       Disabled     { get; set; }
    [Parameter] public bool       Required     { get; set; }
    [Parameter] public string?    Label        { get; set; }
    [Parameter] public string?    Class        { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool _isOpen;
    private ElementReference _triggerRef;
    private int  _displayYear  = DateTime.Today.Year;
    private int  _displayMonth = DateTime.Today.Month;

    private readonly string _labelId   = $"tm-date-picker-label-{Guid.NewGuid():N}";
    private readonly string _triggerId = $"tm-date-picker-trigger-{Guid.NewGuid():N}";
    private readonly string _valueId   = $"tm-date-picker-value-{Guid.NewGuid():N}";

    /// <summary>
    /// The trigger's accessible name is the label followed by the shown value (or placeholder). With
    /// no <see cref="Label"/> the value span alone names the button — identical to the text content,
    /// so nothing regresses when the consumer renders the picker unlabelled.
    /// A consumer <c>aria-label</c> passed through <see cref="AdditionalAttributes"/> is overridden
    /// by this <c>aria-labelledby</c> in the accessible-name algorithm — set <see cref="Label"/>
    /// instead of <c>aria-label</c> to name the trigger (N159).
    /// </summary>
    private string TriggerLabelledBy =>
        string.IsNullOrEmpty(Label) ? _valueId : $"{_labelId} {_valueId}";

    /// <summary>Consumer <c>aria-*</c> attributes target the trigger; everything else the root.</summary>
    private IReadOnlyDictionary<string, object>? AriaAttributes =>
        AdditionalAttributes is null
            ? null
            : AdditionalAttributes
                .Where(kv => kv.Key.StartsWith("aria-", StringComparison.OrdinalIgnoreCase))
                .ToDictionary(kv => kv.Key, kv => kv.Value);

    private IReadOnlyDictionary<string, object>? RootAttributes =>
        AdditionalAttributes is null
            ? null
            : AdditionalAttributes
                .Where(kv => !kv.Key.StartsWith("aria-", StringComparison.OrdinalIgnoreCase))
                .ToDictionary(kv => kv.Key, kv => kv.Value);

    protected override void OnParametersSet()
    {
        if (Value.HasValue)
        {
            _displayYear  = Value.Value.Year;
            _displayMonth = Value.Value.Month;
        }
    }

    private void ToggleCalendar()
    {
        if (!Disabled) _isOpen = !_isOpen;
    }

    private void SetOpen(bool open)
    {
        _isOpen = open;
    }

    private async Task OnDateSelected(DateOnly d)
    {
        _isOpen = false;
        await ValueChanged.InvokeAsync(d);
    }

    private void OnNavigate((int Year, int Month) nav)
    {
        _displayYear  = nav.Year;
        _displayMonth = nav.Month;
    }

    private async Task ClearValue()
    {
        _isOpen = false;
        await ValueChanged.InvokeAsync(null);
    }

    private async Task SelectToday()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        _isOpen = false;
        await ValueChanged.InvokeAsync(today);
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _isOpen = false;
    }
}
