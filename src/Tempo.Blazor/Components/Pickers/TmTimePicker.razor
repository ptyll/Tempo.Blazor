@namespace Tempo.Blazor.Components.Pickers
@using Tempo.Blazor.Abstractions.Layout
@using Tempo.Blazor.Components.Icons

<div class="tm-time-picker @Class @(IsInvalidState ? "tm-time-picker--invalid" : "") @(IsMobileAuto ? "tm-time-picker--trigger-only" : null) @(ReadOnly ? "tm-time-picker--readonly" : null)"
     id="@Id"
     @attributes="RootAttributes">

    @if (LabelTrailing is not null)
    {
        <span class="tm-input-label-row">
            @if (!string.IsNullOrEmpty(Label))
            {
                <label id="@_labelId"
                       class="tm-picker-label @(Required ? "tm-input-label-required" : "")"
                       for="@LabelFor">@Label</label>
            }
            <span class="tm-input-label-trailing">@LabelTrailing</span>
        </span>
    }
    else if (!string.IsNullOrEmpty(Label))
    {
        <label id="@_labelId"
               class="tm-picker-label @(Required ? "tm-input-label-required" : "")"
               for="@LabelFor">@Label</label>
    }

    @* Composite control (hours/minutes/seconds + clear / clock trigger): the label's `for`
       targets the first segment (or the trigger in Auto-mobile), and the body is a named group
       so assistive tech announces "{label}, group". No aria-readonly here: ARIA 1.2 does not
       support it on role=group (axe aria-allowed-attr), and the lock is already announced on
       the readonly segments — and, with Popup/Auto on a phone (the only locked layout that
       still renders a trigger), by aria-disabled on the trigger. N148: no aria-disabled for
       out-of-range values either — the segments stay editable, so "disabled" was the wrong
       signal; the invalid state is announced via aria-invalid on the segments
       (Invalid=@IsOutOfRange below) and painted by the --invalid class on the wrapper. *@
    <div class="tm-time-picker-body"
         role="group"
         aria-labelledby="@GroupLabelledBy"
         @attributes="AriaAttributes">
        @if (ShowSegments)
        {
            <TmTimeInput Value="@Value"
                         ValueChanged="OnTimeChanged"
                         ValueExpression="ValueExpression"
                         InputId="@EffectiveInputId"
                         ShowSeconds="@ShowSeconds"
                         Disabled="@Disabled"
                         ReadOnly="@ReadOnly"
                         MinTime="@MinTime"
                         MaxTime="@MaxTime"
                         AllowOvernightRange="@AllowOvernightRange"
                         Invalid="@IsOutOfRange"
                         HourCycle="@HourCycle"
                         Culture="@Culture"
                         AriaDescribedBy="@AriaDescribedBy" />

            @if (Value.HasValue && !Disabled && !ReadOnly && !HideClear)
            {
                <button type="button"
                        class="tm-picker-clear"
                        aria-label="@Loc["TmTimePicker_Clear"]"
                        @onclick="ClearValue">
                    &#x2715;
                </button>
            }
        }

        @if (UsesOverlay && !(ReadOnly && ShowSegments))
        {
            @* ReadOnly on a layout WITH segments renders no trigger at all — the read-only
               segments already carry the value and the lock (readonly + aria-readonly), so a
               button that opens nothing would be a dead tab stop. On a phone (Auto) the segments
               are hidden, so the trigger STAYS as the value's carrier: it announces the lock as
               aria-disabled="true" with aria-haspopup="false", no aria-expanded/aria-controls
               (aria-readonly is not a supported attribute on role=button) and no opening icon —
               nothing on it advertises a popup that can never open. It keeps its natural tab stop
               and ToggleOverlayAsync refuses every activation. TriggerDescribedBy reaches the locked
               trigger too — the host's AriaDescribedBy joined with the TmFormField help/error
               cascade — so a host can describe WHY the field is locked. The editable trigger
               is unchanged. *@
            <button type="button"
                    @ref="_triggerRef"
                    id="@EffectiveTriggerId"
                    class="tm-time-picker__trigger"
                    disabled="@Disabled"
                    aria-haspopup="@(ReadOnly ? "false" : "dialog")"
                    aria-expanded="@(ReadOnly ? null : _isOpen ? "true" : "false")"
                    aria-controls="@(ReadOnly ? null : _overlayId)"
                    aria-disabled="@(ReadOnly ? "true" : null)"
                    aria-describedby="@TriggerDescribedBy"
                    aria-label="@TriggerAriaLabel"
                    aria-labelledby="@TriggerLabelledBy"
                    @onclick="ToggleOverlayAsync">
                @if (IsMobileAuto)
                {
                    <span id="@_valueId" class="tm-time-picker__value">@DisplayedValue</span>
                }
                @if (!ReadOnly)
                {
                    <span class="tm-time-picker__icon" aria-hidden="true">
                        <TmIcon Name="@IconNames.Clock" Size="IconSize.Sm" />
                    </span>
                }
            </button>
        }
    </div>

    @if (UsesOverlay && _isOpen)
    {
        <TmOverlayPanel Id="@_overlayId"
                        Anchor="_triggerRef"
                        IsOpen="_isOpen"
                        IsOpenChanged="OnOverlayOpenChanged"
                        Placement="OverlayPlacement.Bottom"
                        Align="OverlayAlign.Start"
                        Offset="4"
                        Role="dialog"
                        TrapFocus="true"
                        Title="@EffectiveSheetTitle"
                        SheetTitle="@EffectiveSheetTitle"
                        AriaLabelledBy="@GroupLabelledBy"
                        AriaLabel="@(string.IsNullOrEmpty(GroupLabelledBy) ? EffectiveSheetTitle : null)"
                        MobilePresentation="PanelPresentation.Auto"
                        LayoutMode="LayoutMode"
                        SheetInitialFocusSelector="[data-tm-time-segment='hours']"
                        OnSheetDone="OnSheetDoneAsync"
                        Class="tm-time-picker__popup">
            <TmTimeSelector Value="@SelectorValue"
                            ValueChanged="OnSelectorChanged"
                            MinTime="@MinTime"
                            MaxTime="@MaxTime"
                            AllowOvernightRange="@AllowOvernightRange"
                            ShowSeconds="@ShowSeconds"
                            HourCycle="@HourCycle"
                            Culture="@Culture"
                            Disabled="@Disabled"
                            ReadOnly="@ReadOnly"
                            MinuteStep="@MinuteStep"
                            EnforceStep="@EnforceStep"
                            ReferenceDate="@ReferenceDate"
                            TimeZone="@TimeZone"
                            AmbiguousTimeResolution="@AmbiguousTimeResolution"
                            AmbiguousOffsetChanged="@AmbiguousOffsetChanged"
                            AriaDescribedBy="@AriaDescribedBy"
                            AriaLabelledBy="@GroupLabelledBy"
                            LayoutMode="ResolvedLayout"
                            EnableSwipe="@EnableSwipe" />
            @if (UsesOnConfirm && !IsSheetPresentation)
            {
                <div class="tm-time-picker__footer">
                    <button type="button"
                            class="tm-time-picker__done"
                            @onclick="ConfirmPopoverAsync">
                        @Loc["Tm_Done"]
                    </button>
                </div>
            }
        </TmOverlayPanel>
    }

    @if (ShowSegments && !Value.HasValue)
    {
        <span class="tm-picker-placeholder" aria-hidden="true">
            @(Placeholder ?? (ShowSeconds ? Loc["TmTimePicker_PlaceholderSeconds"] : Loc["TmTimePicker_Placeholder"]))
        </span>
    }
</div>
