@namespace Tempo.Blazor.Components.Pickers

<div class="tm-time-picker @Class @(IsOutOfRange ? "tm-time-picker--invalid" : "")"
     @attributes="RootAttributes">

    @if (!string.IsNullOrEmpty(Label))
    {
        <label id="@_labelId"
               class="tm-picker-label @(Required ? "tm-input-label-required" : "")"
               for="@_inputId">@Label</label>
    }

    @* Composite control (hours/minutes/seconds + clear): the label's `for` targets the first
       segment, and the body is a named group so assistive tech announces "{label}, group".
       N148: no aria-disabled for out-of-range values — the segments stay editable, so "disabled"
       was the wrong signal; the invalid state is announced via aria-invalid on the segments
       (Invalid=@IsOutOfRange below) and painted by the --invalid class on the wrapper. *@
    <div class="tm-time-picker-body"
         role="group"
         aria-labelledby="@(string.IsNullOrEmpty(Label) ? null : _labelId)"
         @attributes="AriaAttributes">
        <TmTimeInput Value="@Value"
                     ValueChanged="OnTimeChanged"
                     InputId="@_inputId"
                     ShowSeconds="@ShowSeconds"
                     Disabled="@Disabled"
                     MinTime="@MinTime"
                     MaxTime="@MaxTime"
                     Invalid="@IsOutOfRange" />

        @if (Value.HasValue && !Disabled)
        {
            <button type="button"
                    class="tm-picker-clear"
                    aria-label="@Loc["TmTimePicker_Clear"]"
                    @onclick="ClearValue">
                &#x2715;
            </button>
        }
    </div>

    @if (!Value.HasValue)
    {
        <span class="tm-picker-placeholder" aria-hidden="true">
            @(Placeholder ?? (ShowSeconds ? Loc["TmTimePicker_PlaceholderSeconds"] : Loc["TmTimePicker_Placeholder"]))
        </span>
    }
</div>

@code {
    [Parameter] public TimeOnly?  Value        { get; set; }
    [Parameter] public EventCallback<TimeOnly?> ValueChanged { get; set; }
    [Parameter] public TimeOnly?  MinTime      { get; set; }
    [Parameter] public TimeOnly?  MaxTime      { get; set; }
    [Parameter] public bool       ShowSeconds  { get; set; }
    [Parameter] public string?    Placeholder  { get; set; }
    [Parameter] public bool       Disabled     { get; set; }
    [Parameter] public bool       Required     { get; set; }
    [Parameter] public string?    Label        { get; set; }
    [Parameter] public string?    Class        { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string _labelId = $"tm-time-picker-label-{Guid.NewGuid():N}";
    private readonly string _inputId = $"tm-time-picker-input-{Guid.NewGuid():N}";

    private bool IsOutOfRange =>
        Value.HasValue &&
        ((MinTime.HasValue && Value.Value < MinTime.Value) ||
         (MaxTime.HasValue && Value.Value > MaxTime.Value));

    /// <summary>Consumer <c>aria-*</c> attributes target the input group; everything else the root.</summary>
    private IReadOnlyDictionary<string, object>? AriaAttributes =>
        AdditionalAttributes is null
            ? null
            : AdditionalAttributes
                .Where(kv => kv.Key.StartsWith("aria-", StringComparison.OrdinalIgnoreCase))
                .ToDictionary(kv => kv.Key, kv => kv.Value);

    private IReadOnlyDictionary<string, object>? RootAttributes =>
        AdditionalAttributes is null
            ? null
            : AdditionalAttributes
                .Where(kv => !kv.Key.StartsWith("aria-", StringComparison.OrdinalIgnoreCase))
                .ToDictionary(kv => kv.Key, kv => kv.Value);

    private async Task OnTimeChanged(TimeOnly? t) => await ValueChanged.InvokeAsync(t);

    private async Task ClearValue() => await ValueChanged.InvokeAsync(null);
}
