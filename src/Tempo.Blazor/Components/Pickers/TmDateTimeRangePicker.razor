@namespace Tempo.Blazor.Components.Pickers
@using Tempo.Blazor.Models

<div class="tm-datetime-range-picker @Class @(IsInvalid ? "tm-datetime-range--invalid" : "")" @attributes="RootAttributes">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label id="@_labelId" class="tm-picker-label" for="@_startTriggerId">@Label</label>
    }

    @* Composite of two TmDateTimePickers: the label's `for` targets the start picker's trigger
       (via its TriggerId pass-through); the body is a named group and each section is a named
       sub-group so assistive tech announces "Label > Start|End > trigger". *@
    <div class="tm-datetime-range-body"
         role="group"
         aria-labelledby="@(string.IsNullOrEmpty(Label) ? null : _labelId)"
         @attributes="AriaAttributes">
        <!-- Start -->
        <div class="tm-datetime-range-section tm-datetime-range-start"
             role="group"
             aria-labelledby="@_startLabelId">
            <span id="@_startLabelId" class="tm-datetime-range-label">@Loc["TmDateTimeRangePicker_StartLabel"]</span>
            <TmDateTimePicker Value="@Value.Start"
                              ValueChanged="OnStartChanged"
                              TriggerId="@_startTriggerId"
                              MinValue="@MinValue"
                              MaxValue="@Value.End"
                              ShowSeconds="@ShowSeconds"
                              Disabled="@Disabled"
                              HideClear="true" />
        </div>

        <span class="tm-datetime-range-sep" aria-hidden="true">–</span>

        <!-- End -->
        <div class="tm-datetime-range-section tm-datetime-range-end"
             role="group"
             aria-labelledby="@_endLabelId">
            <span id="@_endLabelId" class="tm-datetime-range-label">@Loc["TmDateTimeRangePicker_EndLabel"]</span>
            <TmDateTimePicker Value="@Value.End"
                              ValueChanged="OnEndChanged"
                              MinValue="@Value.Start"
                              MaxValue="@MaxValue"
                              ShowSeconds="@ShowSeconds"
                              Disabled="@Disabled"
                              HideClear="true" />
        </div>

        @if ((Value.Start.HasValue || Value.End.HasValue) && !Disabled)
        {
            <button type="button"
                    class="tm-picker-clear"
                    aria-label="@Loc["TmDateTimeRangePicker_Clear"]"
                    @onclick="ClearValues">
                &#x2715;
            </button>
        }
    </div>

    @if (IsInvalid)
    {
        <span class="tm-field-error" role="alert">@Loc["TmDateTimeRangePicker_ValidationError"]</span>
    }
</div>

@code {
    [Parameter] public (DateTime? Start, DateTime? End) Value        { get; set; }
    [Parameter] public EventCallback<(DateTime? Start, DateTime? End)> ValueChanged { get; set; }
    [Parameter] public DateTime?                  MinValue     { get; set; }
    [Parameter] public DateTime?                  MaxValue     { get; set; }
    [Parameter] public IReadOnlyList<DateRangePreset>? Presets  { get; set; }
    [Parameter] public bool    ShowSeconds  { get; set; }
    [Parameter] public bool    Disabled     { get; set; }
    [Parameter] public string? Label        { get; set; }
    [Parameter] public string? Class        { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string _labelId        = $"tm-datetime-range-label-{Guid.NewGuid():N}";
    private readonly string _startLabelId   = $"tm-datetime-range-start-label-{Guid.NewGuid():N}";
    private readonly string _endLabelId     = $"tm-datetime-range-end-label-{Guid.NewGuid():N}";
    private readonly string _startTriggerId = $"tm-datetime-range-start-trigger-{Guid.NewGuid():N}";

    private bool IsInvalid =>
        Value.Start.HasValue && Value.End.HasValue && Value.End.Value < Value.Start.Value;

    /// <summary>Consumer <c>aria-*</c> attributes target the input group; everything else the root.</summary>
    private IReadOnlyDictionary<string, object>? AriaAttributes =>
        AdditionalAttributes is null
            ? null
            : AdditionalAttributes
                .Where(kv => kv.Key.StartsWith("aria-", StringComparison.OrdinalIgnoreCase))
                .ToDictionary(kv => kv.Key, kv => kv.Value);

    private IReadOnlyDictionary<string, object>? RootAttributes =>
        AdditionalAttributes is null
            ? null
            : AdditionalAttributes
                .Where(kv => !kv.Key.StartsWith("aria-", StringComparison.OrdinalIgnoreCase))
                .ToDictionary(kv => kv.Key, kv => kv.Value);

    private async Task OnStartChanged(DateTime? dt)
        => await ValueChanged.InvokeAsync((dt, Value.End));

    private async Task OnEndChanged(DateTime? dt)
        => await ValueChanged.InvokeAsync((Value.Start, dt));

    private async Task ClearValues()
        => await ValueChanged.InvokeAsync((null, null));
}
