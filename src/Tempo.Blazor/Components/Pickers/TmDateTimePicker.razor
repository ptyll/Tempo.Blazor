@namespace Tempo.Blazor.Components.Pickers
@using System.Globalization
@using Tempo.Blazor.Components.Forms
@inject IServiceProvider Services

<div class="tm-datetime-picker @(ReadOnly ? "tm-datetime-picker--readonly tm-date-picker--readonly" : "") @Class @(IsOutOfRange || _typedDateInvalid ? "tm-datetime-picker--invalid" : "")" @attributes="RootAttributes">
    @if (LabelTrailing is not null)
    {
        <span class="tm-input-label-row">
            @if (!string.IsNullOrEmpty(Label))
            {
                <label id="@_labelId"
                       class="tm-picker-label @(Required ? "tm-input-label-required" : "")"
                       for="@EffectiveTriggerId">@Label</label>
            }
            <span class="tm-input-label-trailing">@LabelTrailing</span>
        </span>
    }
    else if (!string.IsNullOrEmpty(Label))
    {
        <label id="@_labelId"
               class="tm-picker-label @(Required ? "tm-input-label-required" : "")"
               for="@EffectiveTriggerId">@Label</label>
    }

    <div class="tm-datetime-picker-body">
        <!-- Date section -->
        <div class="tm-datetime-date-section">
            <div class="tm-date-picker-input-row">
                @* No aria-required here: it is not a permitted attribute on a native <button>
                   (ARIA 1.2 / HTML-AAM). Requiredness is announced by the tm-input-label-required
                   marker on the label and enforced by form validation (N147). *@
                <button type="button"
                        @ref="_triggerRef"
                        id="@EffectiveTriggerId"
                        class="tm-date-picker-trigger"
                        disabled="@Disabled"
                        aria-haspopup="@(ReadOnly ? "false" : "true")"
                        aria-expanded="@(ReadOnly ? null : _isOpen ? "true" : "false")"
                        aria-disabled="@(ReadOnly ? "true" : null)"
                        aria-labelledby="@TriggerLabelledBy"
                        aria-describedby="@DescribedBy"
                        aria-invalid="@((IsOutOfRange || _typedDateInvalid) ? "true" : null)"
                        @attributes="AriaAttributes"
                        @onclick="ToggleCalendar">
                    <span id="@_valueId">
                        @if (_date.HasValue)
                        {
                            @_date.Value.ToString(DateFormat)
                        }
                        else
                        {
                            <span class="tm-picker-placeholder">@(Placeholder ?? Loc["TmDateTimePicker_Placeholder"])</span>
                        }
                    </span>
                    @* The calendar icon advertises the popup; a locked trigger has none to offer,
                       so it is not rendered at all (the surface tint names the lock, never an icon). *@
                    @if (!ReadOnly)
                    {
                        <span class="tm-date-picker-icon" aria-hidden="true"></span>
                    }
                </button>
                @if (AllowTypedDate && !Disabled && !ReadOnly)
                {
                    <input type="text"
                           class="tm-date-picker-typed"
                           value="@TypedDateText"
                           aria-invalid="@(_typedDateInvalid ? "true" : null)"
                           aria-describedby="@DescribedBy"
                           aria-labelledby="@(string.IsNullOrEmpty(Label) ? null : _labelId)"
                           aria-label="@(string.IsNullOrEmpty(Label) ? (Placeholder ?? Loc["TmDateTimePicker_Placeholder"]) : null)"
                           @onchange="OnTypedDateChanged" />
                }

                <span class="tm-picker-clear-slot">
                    @if (Value.HasValue && !Disabled && !ReadOnly && !HideClear)
                    {
                        <button type="button"
                                class="tm-picker-clear"
                                aria-label="@Loc["TmDateTimePicker_Clear"]"
                                @onclick="ClearValue">
                            &#x2715;
                        </button>
                    }
                </span>
            </div>

            @* The calendar popup is a TmOverlayPanel: popover="manual" puts it in the browser top
               layer, so a modal's overflow/transform can no longer clip it, and overlay.js flips
               it above the trigger when the space below runs out. Bottom + Start + 4px keeps the
               historical "under the trigger, left-aligned" look. *@
            <TmOverlayPanel Anchor="_triggerRef"
                            IsOpen="_isOpen"
                            IsOpenChanged="SetOpen"
                            Placement="OverlayPlacement.Bottom"
                            Align="OverlayAlign.Start"
                            Offset="4"
                            Role="dialog"
                            TrapFocus="true"
                            Title="@(string.IsNullOrEmpty(Label) ? Loc["TmDateTimePicker_Title"] : Label)"
                            AriaLabelledBy="@(string.IsNullOrEmpty(Label) ? null : _labelId)"
                            AriaLabel="@(string.IsNullOrEmpty(Label) ? (Placeholder ?? Loc["TmDateTimePicker_Placeholder"]) : null)"
                            MobilePresentation="PanelPresentation.Auto"
                            Class="tm-date-picker-popup">
                <TmCalendarGrid DisplayYear="@_displayYear"
                                DisplayMonth="@_displayMonth"
                                SelectedDate="@_date"
                                MinDate="@(_minDate)"
                                MaxDate="@(_maxDate)"
                                OnDateSelected="OnDateSelected"
                                OnNavigate="OnNavigate" />
            </TmOverlayPanel>
        </div>

        <!-- Time section: composite input, labelled via role=group + label `for` on first segment -->
        <div class="tm-datetime-time-section"
             role="group"
             aria-labelledby="@(string.IsNullOrEmpty(TimeLabel) ? null : _timeLabelId)">
            @if (!string.IsNullOrEmpty(TimeLabel))
            {
                <label id="@_timeLabelId" class="tm-picker-label" for="@_timeInputId">@TimeLabel</label>
            }
            <TmTimeInput Value="@_time"
                         ValueChanged="OnTimeChanged"
                         InputId="@_timeInputId"
                         ShowSeconds="@ShowSeconds"
                         Disabled="@Disabled"
                         ReadOnly="@ReadOnly"
                         EmptyAsPlaceholder="true"
                         MinTime="@_minTime"
                         MaxTime="@_maxTime"
                         HourCycle="@HourCycle"
                         Culture="@Culture" />
        </div>
    </div>
</div>

@code {
    [Parameter] public DateTime?  Value        { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public DateTime?  MinValue     { get; set; }
    [Parameter] public DateTime?  MaxValue     { get; set; }
    [Parameter] public string     DateFormat   { get; set; } = "dd.MM.yyyy";
    [Parameter] public bool       ShowSeconds  { get; set; }
    [Parameter] public string?    Placeholder  { get; set; }
    [Parameter] public bool       Disabled     { get; set; }
    /// <summary>
    /// Keeps the date trigger focusable but closed, hides the clear button and the calendar icon,
    /// and tints the trigger surface like the other read-only inputs (<c>--tm-bg-surface-secondary</c>,
    /// never the disabled colours); the nested time field is read-only too. The trigger announces
    /// the lock as <c>aria-disabled="true"</c> with <c>aria-haspopup="false"</c> and no
    /// <c>aria-expanded</c> — it is a button that opens nothing, and <c>aria-readonly</c> is not a
    /// supported attribute on <c>role=button</c>. Distinct from <see cref="Disabled"/>. Defaults
    /// to false.
    /// </summary>
    [Parameter] public bool       ReadOnly     { get; set; }
    /// <summary>
    /// Extra ids referenced from the date trigger's <c>aria-describedby</c>. Joined with the
    /// surrounding <c>TmFormField</c> cascade (help and error).
    /// </summary>
    [Parameter] public string?    AriaDescribedBy { get; set; }
    /// <summary>
    /// Content rendered at the END of the label row. Rendered only with the slot set; without it
    /// the label markup is unchanged.
    /// </summary>
    [Parameter] public RenderFragment? LabelTrailing { get; set; }
    /// <summary>
    /// When true, a typed date is parsed with <see cref="CultureInfo.CurrentCulture"/> short date
    /// format. A failed parse marks the field invalid instead of silently resetting. Defaults to false.
    /// </summary>
    [Parameter] public bool       AllowTypedDate { get; set; }
    /// <summary>
    /// Time applied when the user first picks a date on an empty picker.
    /// <see cref="DateTimePickerDefaultTime.Midnight"/> (default) keeps today's 00:00;
    /// <see cref="DateTimePickerDefaultTime.Now"/> uses the injected <see cref="TimeProvider"/>
    /// (fallback <see cref="TimeProvider.System"/>).
    /// </summary>
    [Parameter] public DateTimePickerDefaultTime DefaultTime { get; set; } = DateTimePickerDefaultTime.Midnight;
    /// <summary>
    /// 12-hour versus 24-hour clock forwarded to the nested <c>TmTimeInput</c>. Default
    /// <see cref="TimeHourCycle.Auto"/> follows <see cref="Culture"/>.
    /// </summary>
    [Parameter] public TimeHourCycle HourCycle { get; set; } = TimeHourCycle.Auto;
    /// <summary>
    /// Culture used to resolve <see cref="HourCycle"/>.<see cref="TimeHourCycle.Auto"/>.
    /// Null uses <see cref="CultureInfo.CurrentCulture"/>.
    /// </summary>
    [Parameter] public CultureInfo? Culture { get; set; }
    [Parameter] public bool       Required     { get; set; }
    [Parameter] public bool       HideClear    { get; set; }
    [Parameter] public string?    Label        { get; set; }
    /// <summary>Optional label rendered above the time (HH:mm) sub-field. Null = no label (backward compatible).</summary>
    [Parameter] public string?    TimeLabel    { get; set; }
    /// <summary>Optional explicit id for the date trigger so a parent component's label can target it.</summary>
    [Parameter] public string?    TriggerId    { get; set; }
    [Parameter] public string?    Class        { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [CascadingParameter(Name = TmFormField.ErrorIdCascadingName)]
    private string? FormFieldErrorId { get; set; }

    [CascadingParameter(Name = TmFormField.DescribedByIdsCascadingName)]
    private string? FormFieldDescribedByIds { get; set; }

    private readonly string _labelId      = $"tm-datetime-label-{Guid.NewGuid():N}";
    private readonly string _triggerId    = $"tm-datetime-trigger-{Guid.NewGuid():N}";
    private readonly string _valueId      = $"tm-datetime-value-{Guid.NewGuid():N}";
    private readonly string _timeLabelId  = $"tm-datetime-time-label-{Guid.NewGuid():N}";
    private readonly string _timeInputId  = $"tm-datetime-time-input-{Guid.NewGuid():N}";

    private string EffectiveTriggerId => TriggerId ?? _triggerId;

    /// <summary>
    /// Accessible name = label + shown value/placeholder; falls back to the value alone.
    /// A consumer <c>aria-label</c> passed through <see cref="AdditionalAttributes"/> is overridden
    /// by this <c>aria-labelledby</c> in the accessible-name algorithm — set <see cref="Label"/>
    /// instead of <c>aria-label</c> to name the trigger (N159).
    /// </summary>
    private string TriggerLabelledBy =>
        string.IsNullOrEmpty(Label) ? _valueId : $"{_labelId} {_valueId}";

    private string? DescribedBy => TmDescribedBy.Join(
        FormFieldErrorId,
        FormFieldDescribedByIds,
        AriaDescribedBy);

    private TimeProvider Clock
        => _clock ??= Services.GetService(typeof(TimeProvider)) as TimeProvider ?? TimeProvider.System;

    private TimeProvider? _clock;
    private bool _typedDateInvalid;

    private string TypedDateText =>
        _date?.ToString(CultureInfo.CurrentCulture.DateTimeFormat.ShortDatePattern, CultureInfo.CurrentCulture) ?? string.Empty;

    /// <summary>Consumer <c>aria-*</c> attributes target the date trigger; everything else the root.</summary>
    private IReadOnlyDictionary<string, object>? AriaAttributes =>
        AdditionalAttributes is null
            ? null
            : AdditionalAttributes
                .Where(kv => kv.Key.StartsWith("aria-", StringComparison.OrdinalIgnoreCase))
                .ToDictionary(kv => kv.Key, kv => kv.Value);

    private IReadOnlyDictionary<string, object>? RootAttributes =>
        AdditionalAttributes is null
            ? null
            : AdditionalAttributes
                .Where(kv => !kv.Key.StartsWith("aria-", StringComparison.OrdinalIgnoreCase))
                .ToDictionary(kv => kv.Key, kv => kv.Value);

    private bool      _isOpen;
    private ElementReference _triggerRef;
    private int       _displayYear  = DateTime.Today.Year;
    private int       _displayMonth = DateTime.Today.Month;
    private DateOnly? _date;
    private TimeOnly? _time;

    // Derived min/max for the time component
    private TimeOnly? _minTime;
    private TimeOnly? _maxTime;
    private DateOnly? _minDate;
    private DateOnly? _maxDate;

    private bool IsOutOfRange =>
        Value.HasValue &&
        ((MinValue.HasValue && Value.Value < MinValue.Value) ||
         (MaxValue.HasValue && Value.Value > MaxValue.Value));

    protected override void OnParametersSet()
    {
        if (Value.HasValue)
        {
            _date = DateOnly.FromDateTime(Value.Value);
            _time = TimeOnly.FromDateTime(Value.Value);
            _displayYear  = _date.Value.Year;
            _displayMonth = _date.Value.Month;
        }
        else
        {
            _date = null;
            _time = null;
        }

        _minDate = MinValue.HasValue ? DateOnly.FromDateTime(MinValue.Value) : null;
        _maxDate = MaxValue.HasValue ? DateOnly.FromDateTime(MaxValue.Value) : null;

        // Min/max time is only relevant when the selected date equals the limit date
        _minTime = (MinValue.HasValue && _date == _minDate)
            ? TimeOnly.FromDateTime(MinValue.Value) : null;
        _maxTime = (MaxValue.HasValue && _date == _maxDate)
            ? TimeOnly.FromDateTime(MaxValue.Value) : null;
    }

    private void ToggleCalendar()
    {
        if (!Disabled && !ReadOnly) _isOpen = !_isOpen;
    }

    private void SetOpen(bool open)
    {
        if (ReadOnly || Disabled)
        {
            _isOpen = false;
            return;
        }

        _isOpen = open;
    }

    private async Task OnDateSelected(DateOnly d)
    {
        if (ReadOnly) return;
        _isOpen = false;
        _date   = d;
        _typedDateInvalid = false;
        if (!_time.HasValue)
        {
            _time = ResolveDefaultTime();
        }
        await Emit();
    }

    private void OnNavigate((int Year, int Month) nav)
    {
        _displayYear  = nav.Year;
        _displayMonth = nav.Month;
    }

    private async Task OnTimeChanged(TimeOnly? t)
    {
        if (ReadOnly) return;
        _time = t;
        await Emit();
    }

    private async Task ClearValue()
    {
        if (ReadOnly) return;
        _date   = null;
        _time   = null;
        _typedDateInvalid = false;
        _isOpen = false;
        await ValueChanged.InvokeAsync(null);
    }

    private async Task OnTypedDateChanged(ChangeEventArgs e)
    {
        if (ReadOnly || Disabled) return;
        var raw = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(raw))
        {
            _typedDateInvalid = false;
            _date = null;
            _time = null;
            await ValueChanged.InvokeAsync(null);
            return;
        }

        if (DateOnly.TryParse(raw, CultureInfo.CurrentCulture, DateTimeStyles.None, out var parsed))
        {
            _typedDateInvalid = false;
            _date = parsed;
            _time ??= ResolveDefaultTime();
            await Emit();
            return;
        }

        _typedDateInvalid = true;
    }

    private TimeOnly ResolveDefaultTime()
    {
        if (DefaultTime == DateTimePickerDefaultTime.Now)
        {
            var now = Clock.GetLocalNow();
            return TimeOnly.FromTimeSpan(now.TimeOfDay);
        }

        return TimeOnly.MinValue;
    }

    private async Task Emit()
    {
        if (_date.HasValue)
        {
            var t   = _time ?? TimeOnly.MinValue;
            var dt  = _date.Value.ToDateTime(t);
            await ValueChanged.InvokeAsync(dt);
        }
    }
}
