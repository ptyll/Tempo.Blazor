@namespace Tempo.Blazor.Components.Pickers

<div class="tm-datetime-picker @Class @(IsOutOfRange ? "tm-datetime-picker--invalid" : "")" @attributes="RootAttributes">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label id="@_labelId"
               class="tm-picker-label @(Required ? "tm-input-label-required" : "")"
               for="@EffectiveTriggerId">@Label</label>
    }

    <div class="tm-datetime-picker-body">
        <!-- Date section -->
        <div class="tm-datetime-date-section">
            <div class="tm-date-picker-input-row">
                @* No aria-required here: it is not a permitted attribute on a native <button>
                   (ARIA 1.2 / HTML-AAM). Requiredness is announced by the tm-input-label-required
                   marker on the label and enforced by form validation (N147). *@
                <button type="button"
                        @ref="_triggerRef"
                        id="@EffectiveTriggerId"
                        class="tm-date-picker-trigger"
                        disabled="@Disabled"
                        aria-haspopup="true"
                        aria-expanded="@_isOpen"
                        aria-labelledby="@TriggerLabelledBy"
                        @attributes="AriaAttributes"
                        @onclick="ToggleCalendar">
                    <span id="@_valueId">
                        @if (_date.HasValue)
                        {
                            @_date.Value.ToString(DateFormat)
                        }
                        else
                        {
                            <span class="tm-picker-placeholder">@(Placeholder ?? Loc["TmDateTimePicker_Placeholder"])</span>
                        }
                    </span>
                    <span class="tm-date-picker-icon" aria-hidden="true"></span>
                </button>

                @if (Value.HasValue && !Disabled && !HideClear)
                {
                    <button type="button"
                            class="tm-picker-clear"
                            aria-label="@Loc["TmDateTimePicker_Clear"]"
                            @onclick="ClearValue">
                        &#x2715;
                    </button>
                }
            </div>

            @* The calendar popup is a TmOverlayPanel: popover="manual" puts it in the browser top
               layer, so a modal's overflow/transform can no longer clip it, and overlay.js flips
               it above the trigger when the space below runs out. Bottom + Start + 4px keeps the
               historical "under the trigger, left-aligned" look. *@
            <TmOverlayPanel Anchor="_triggerRef"
                            IsOpen="_isOpen"
                            IsOpenChanged="SetOpen"
                            Placement="OverlayPlacement.Bottom"
                            Align="OverlayAlign.Start"
                            Offset="4"
                            Role="dialog"
                            Class="tm-date-picker-popup"
                            aria-modal="true">
                <TmCalendarGrid DisplayYear="@_displayYear"
                                DisplayMonth="@_displayMonth"
                                SelectedDate="@_date"
                                MinDate="@(_minDate)"
                                MaxDate="@(_maxDate)"
                                OnDateSelected="OnDateSelected"
                                OnNavigate="OnNavigate" />
            </TmOverlayPanel>
        </div>

        <!-- Time section: composite input, labelled via role=group + label `for` on first segment -->
        <div class="tm-datetime-time-section"
             role="group"
             aria-labelledby="@(string.IsNullOrEmpty(TimeLabel) ? null : _timeLabelId)">
            @if (!string.IsNullOrEmpty(TimeLabel))
            {
                <label id="@_timeLabelId" class="tm-picker-label" for="@_timeInputId">@TimeLabel</label>
            }
            <TmTimeInput Value="@_time"
                         ValueChanged="OnTimeChanged"
                         InputId="@_timeInputId"
                         ShowSeconds="@ShowSeconds"
                         Disabled="@Disabled"
                         MinTime="@_minTime"
                         MaxTime="@_maxTime" />
        </div>
    </div>
</div>

@code {
    [Parameter] public DateTime?  Value        { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public DateTime?  MinValue     { get; set; }
    [Parameter] public DateTime?  MaxValue     { get; set; }
    [Parameter] public string     DateFormat   { get; set; } = "dd.MM.yyyy";
    [Parameter] public bool       ShowSeconds  { get; set; }
    [Parameter] public string?    Placeholder  { get; set; }
    [Parameter] public bool       Disabled     { get; set; }
    [Parameter] public bool       Required     { get; set; }
    [Parameter] public bool       HideClear    { get; set; }
    [Parameter] public string?    Label        { get; set; }
    /// <summary>Optional label rendered above the time (HH:mm) sub-field. Null = no label (backward compatible).</summary>
    [Parameter] public string?    TimeLabel    { get; set; }
    /// <summary>Optional explicit id for the date trigger so a parent component's label can target it.</summary>
    [Parameter] public string?    TriggerId    { get; set; }
    [Parameter] public string?    Class        { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string _labelId      = $"tm-datetime-label-{Guid.NewGuid():N}";
    private readonly string _triggerId    = $"tm-datetime-trigger-{Guid.NewGuid():N}";
    private readonly string _valueId      = $"tm-datetime-value-{Guid.NewGuid():N}";
    private readonly string _timeLabelId  = $"tm-datetime-time-label-{Guid.NewGuid():N}";
    private readonly string _timeInputId  = $"tm-datetime-time-input-{Guid.NewGuid():N}";

    private string EffectiveTriggerId => TriggerId ?? _triggerId;

    /// <summary>
    /// Accessible name = label + shown value/placeholder; falls back to the value alone.
    /// A consumer <c>aria-label</c> passed through <see cref="AdditionalAttributes"/> is overridden
    /// by this <c>aria-labelledby</c> in the accessible-name algorithm — set <see cref="Label"/>
    /// instead of <c>aria-label</c> to name the trigger (N159).
    /// </summary>
    private string TriggerLabelledBy =>
        string.IsNullOrEmpty(Label) ? _valueId : $"{_labelId} {_valueId}";

    /// <summary>Consumer <c>aria-*</c> attributes target the date trigger; everything else the root.</summary>
    private IReadOnlyDictionary<string, object>? AriaAttributes =>
        AdditionalAttributes is null
            ? null
            : AdditionalAttributes
                .Where(kv => kv.Key.StartsWith("aria-", StringComparison.OrdinalIgnoreCase))
                .ToDictionary(kv => kv.Key, kv => kv.Value);

    private IReadOnlyDictionary<string, object>? RootAttributes =>
        AdditionalAttributes is null
            ? null
            : AdditionalAttributes
                .Where(kv => !kv.Key.StartsWith("aria-", StringComparison.OrdinalIgnoreCase))
                .ToDictionary(kv => kv.Key, kv => kv.Value);

    private bool      _isOpen;
    private ElementReference _triggerRef;
    private int       _displayYear  = DateTime.Today.Year;
    private int       _displayMonth = DateTime.Today.Month;
    private DateOnly? _date;
    private TimeOnly? _time;

    // Derived min/max for the time component
    private TimeOnly? _minTime;
    private TimeOnly? _maxTime;
    private DateOnly? _minDate;
    private DateOnly? _maxDate;

    private bool IsOutOfRange =>
        Value.HasValue &&
        ((MinValue.HasValue && Value.Value < MinValue.Value) ||
         (MaxValue.HasValue && Value.Value > MaxValue.Value));

    protected override void OnParametersSet()
    {
        if (Value.HasValue)
        {
            _date = DateOnly.FromDateTime(Value.Value);
            _time = TimeOnly.FromDateTime(Value.Value);
            _displayYear  = _date.Value.Year;
            _displayMonth = _date.Value.Month;
        }
        else
        {
            _date = null;
            _time = null;
        }

        _minDate = MinValue.HasValue ? DateOnly.FromDateTime(MinValue.Value) : null;
        _maxDate = MaxValue.HasValue ? DateOnly.FromDateTime(MaxValue.Value) : null;

        // Min/max time is only relevant when the selected date equals the limit date
        _minTime = (MinValue.HasValue && _date == _minDate)
            ? TimeOnly.FromDateTime(MinValue.Value) : null;
        _maxTime = (MaxValue.HasValue && _date == _maxDate)
            ? TimeOnly.FromDateTime(MaxValue.Value) : null;
    }

    private void ToggleCalendar()
    {
        if (!Disabled) _isOpen = !_isOpen;
    }

    private void SetOpen(bool open)
    {
        _isOpen = open;
    }

    private async Task OnDateSelected(DateOnly d)
    {
        _isOpen = false;
        _date   = d;
        await Emit();
    }

    private void OnNavigate((int Year, int Month) nav)
    {
        _displayYear  = nav.Year;
        _displayMonth = nav.Month;
    }

    private async Task OnTimeChanged(TimeOnly? t)
    {
        _time = t;
        await Emit();
    }

    private async Task ClearValue()
    {
        _date   = null;
        _time   = null;
        _isOpen = false;
        await ValueChanged.InvokeAsync(null);
    }

    private async Task Emit()
    {
        if (_date.HasValue)
        {
            var t   = _time ?? TimeOnly.MinValue;
            var dt  = _date.Value.ToDateTime(t);
            await ValueChanged.InvokeAsync(dt);
        }
    }
}
