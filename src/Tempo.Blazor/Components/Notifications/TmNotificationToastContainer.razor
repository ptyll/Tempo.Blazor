@namespace Tempo.Blazor.Components.Notifications
@using Tempo.Blazor.Abstractions.Shared
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Helpers
@using Microsoft.AspNetCore.Components.Web
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Round 3 (V2): the container is pinned-on-top status UI like TmToastContainer — its root carries
   popover="manual", it registers in the pinned-on-top registry while it holds toasts, and it
   re-raises on every push, so no modal surface opened before or after it can cover it. *@
<div class="tm-notification-toast-container" popover="manual" data-tm-inert-exempt @ref="_root">
    @foreach (var toast in _toasts)
    {
        <div class="tm-notification-toast"
             role="alert"
             aria-live="polite"
             aria-atomic="true"
             @key="toast.Id"
            @onclick="() => OnToastClickAsync(toast)">
            <div class="tm-notification-toast__icon">
                <TmIcon Name="@TypeIcon(toast.Notification.Type)" Size="IconSize.Sm" />
            </div>
            <div class="tm-notification-toast__content">
                <span class="tm-notification-toast__message">@toast.Notification.Title</span>
                <span class="tm-notification-toast__sender">@toast.Notification.Actor?.DisplayName</span>
            </div>
            <button type="button"
                    class="tm-notification-toast__close"
                    @onclick:stopPropagation="true"
                    @onclick="() => RemoveToast(toast.Id)">
                <TmIcon Name="@IconNames.X" Size="IconSize.Xs" />
            </button>
            <div class="tm-notification-toast__progress"></div>
        </div>
    }
</div>

@code {
    [Inject] private ITmNotificationService NotificationService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    [Parameter] public string CurrentUserId { get; set; } = "demo";
    [Parameter] public bool IsPanelOpen { get; set; }

    private readonly List<ToastModel> _toasts = new();
    private readonly Queue<ToastModel> _queue = new();
    private int _lastUnreadCount;
    private ElementReference _root;
    private TopLayerInterop? _topLayer;
    private string? _lastNewestId;
    private bool _promoted;
    private bool _pinned;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        _lastUnreadCount = await NotificationService.GetUnreadCountAsync(CurrentUserId);
        NotificationService.OnChanged += OnNotificationsChanged;
    }

    private async void OnNotificationsChanged()
    {
        await InvokeAsync(async () =>
        {
            var newCount = await NotificationService.GetUnreadCountAsync(CurrentUserId);
            if (newCount > _lastUnreadCount && !IsPanelOpen)
            {
                var notes = await NotificationService.GetNotificationsAsync(new TmNotificationQuery
                {
                    RecipientUserId = CurrentUserId,
                    Take = 1
                });
                if (notes.FirstOrDefault() is { } n)
                    EnqueueToast(n);
            }
            _lastUnreadCount = newCount;
            StateHasChanged();
        });
    }

    private void EnqueueToast(TmNotification notification)
    {
        var toast = new ToastModel
        {
            Id = Guid.NewGuid().ToString(),
            Notification = notification
        };

        if (_toasts.Count >= 3)
        {
            _queue.Enqueue(toast);
        }
        else
        {
            _toasts.Add(toast);
            _ = StartDismissTimerAsync(toast.Id);
        }
    }

    private async Task StartDismissTimerAsync(string toastId)
    {
        await Task.Delay(4000);
        await InvokeAsync(() => RemoveToast(toastId));
    }

    private void RemoveToast(string toastId)
    {
        _toasts.RemoveAll(t => t.Id == toastId);
        while (_toasts.Count < 3 && _queue.TryDequeue(out var queued))
        {
            _toasts.Add(queued);
            _ = StartDismissTimerAsync(queued.Id);
        }
        StateHasChanged();
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Pinned-on-top status UI (V2): promote on the first toast, re-raise on every push (keyed
        // on the newest id — the visible count can stay unchanged at the cap), demote and unpin
        // when the last toast leaves. Mirrors TmToastContainer.
        if (_toasts.Count > 0)
        {
            var newestId = _toasts[^1].Id;
            if (!_promoted || newestId != _lastNewestId)
            {
                _topLayer ??= new TopLayerInterop(JS);
                if (!_pinned)
                {
                    _pinned = true;
                    await _topLayer.PinAsync(_root);
                }
                await _topLayer.RaiseAsync(_root);
                _promoted = true;
                _lastNewestId = newestId;
            }
        }
        else if (_promoted)
        {
            _promoted = false;
            _lastNewestId = null;
            if (_topLayer is not null)
            {
                await _topLayer.DemoteAsync(_root);
                if (_pinned)
                {
                    _pinned = false;
                    await _topLayer.UnpinAsync(_root);
                }
            }
        }
    }

    private async Task OnToastClickAsync(ToastModel toast)
    {
        RemoveToast(toast.Id);
        if (!string.IsNullOrEmpty(toast.Notification.ActionUrl))
            Navigation.NavigateTo(toast.Notification.ActionUrl);
    }

    private static string TypeIcon(string type) => type switch
    {
        TmNotificationTypes.Mention => IconNames.AtSign,
        TmNotificationTypes.Reply => IconNames.MessageSquare,
        TmNotificationTypes.Reaction => IconNames.ThumbsUp,
        TmNotificationTypes.ThreadResolved => IconNames.CheckCircle,
        TmNotificationTypes.NewThread => IconNames.PlusCircle,
        _ => IconNames.Bell
    };

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        NotificationService.OnChanged -= OnNotificationsChanged;
        if (_topLayer is not null)
        {
            if (_pinned)
            {
                _pinned = false;
                await _topLayer.UnpinAsync(_root);
            }
            await _topLayer.DisposeAsync();
        }
    }

    private class ToastModel
    {
        public string Id { get; set; } = string.Empty;
        public TmNotification Notification { get; set; } = default!;
    }
}
