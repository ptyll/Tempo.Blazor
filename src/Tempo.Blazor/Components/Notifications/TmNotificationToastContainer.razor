@namespace Tempo.Blazor.Components.Notifications
@using Tempo.Blazor.Abstractions.Shared
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Helpers
@using Microsoft.AspNetCore.Components.Web
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Round 3 (V2): the container is pinned-on-top status UI like TmToastContainer — its root carries
   popover="manual", it registers in the pinned-on-top registry while it holds toasts, and it
   re-raises on every push, so no modal surface opened before or after it can cover it. *@
<div class="tm-notification-toast-container" popover="manual" data-tm-inert-exempt @ref="_root">
    @foreach (var toast in _toasts)
    {
        <div class="tm-notification-toast"
             role="alert"
             aria-live="polite"
             aria-atomic="true"
             @key="toast.Id"
            @onclick="() => OnToastClickAsync(toast)">
            <div class="tm-notification-toast__icon">
                <TmIcon Name="@TypeIcon(toast.Notification.Type)" Size="IconSize.Sm" />
            </div>
            <div class="tm-notification-toast__content">
                <span class="tm-notification-toast__message">@toast.Notification.Title</span>
                <span class="tm-notification-toast__sender">@toast.Notification.Actor?.DisplayName</span>
            </div>
            <button type="button"
                    class="tm-notification-toast__close"
                    aria-label="@Loc["TmToast_Close"]"
                    @onclick:stopPropagation="true"
                    @onclick="() => RemoveToast(toast.Id)">
                <TmIcon Name="@IconNames.X" Size="IconSize.Xs" />
            </button>
            <div class="tm-notification-toast__progress"></div>
        </div>
    }
</div>

@code {
    [Inject] private ITmNotificationService NotificationService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    [Parameter] public string CurrentUserId { get; set; } = "demo";
    [Parameter] public bool IsPanelOpen { get; set; }

    private readonly List<ToastModel> _toasts = new();
    private readonly Queue<ToastModel> _queue = new();
    private int _lastUnreadCount;
    private HashSet<string> _lastIds = new();
    private ElementReference _root;
    private TopLayerInterop? _topLayer;
    private FocusIfLostInterop? _focusIfLost;
    private string? _lastNewestId;
    private bool _promoted;
    private bool _pinned;
    private bool _disposed;
    /// <summary>True while an <see cref="OnAfterRenderAsync"/> pass is awaiting JS (single-flight guard).</summary>
    private bool _afterRenderRunning;
    /// <summary>A render arrived while a pass was in flight: the running pass repeats once more.</summary>
    private bool _afterRenderRerun;

    protected override async Task OnInitializedAsync()
    {
        // A failed unread-count must not take down the host page. The demo editor mounts this
        // container inside the canvas; an HTTP/seed miss was surfacing as the fixed Blazor
        // error bar over the database table.
        try
        {
            _lastUnreadCount = await NotificationService.GetUnreadCountAsync(CurrentUserId);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Notification unread count failed: {ex.Message}");
        }

        NotificationService.OnChanged += OnNotificationsChanged;
    }

    private async void OnNotificationsChanged()
    {
        await InvokeAsync(async () =>
        {
            int newCount;
            try
            {
                newCount = await NotificationService.GetUnreadCountAsync(CurrentUserId);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Notification unread count failed: {ex.Message}");
                return;
            }
            if (newCount > _lastUnreadCount && !IsPanelOpen)
            {
                try
                {
                    var notes = await NotificationService.GetNotificationsAsync(new TmNotificationQuery
                    {
                        RecipientUserId = CurrentUserId,
                        Take = 1
                    });
                    if (notes.FirstOrDefault() is { } n)
                        EnqueueToast(n);
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine($"Notification toast load failed: {ex.Message}");
                }
            }
            _lastUnreadCount = newCount;
            StateHasChanged();
        });
    }

    private void EnqueueToast(TmNotification notification)
    {
        var toast = new ToastModel
        {
            Id = Guid.NewGuid().ToString(),
            Notification = notification
        };

        if (_toasts.Count >= 3)
        {
            _queue.Enqueue(toast);
        }
        else
        {
            _toasts.Add(toast);
            _ = StartDismissTimerAsync(toast.Id);
        }
    }

    private async Task StartDismissTimerAsync(string toastId)
    {
        await Task.Delay(4000);
        await InvokeAsync(() => RemoveToast(toastId));
    }

    private void RemoveToast(string toastId)
    {
        _toasts.RemoveAll(t => t.Id == toastId);
        while (_toasts.Count < 3 && _queue.TryDequeue(out var queued))
        {
            _toasts.Add(queued);
            _ = StartDismissTimerAsync(queued.Id);
        }
        StateHasChanged();
    }

    /// <inheritdoc />
    /// <remarks>
    /// SINGLE-FLIGHT, mirroring TmToastContainer 2.11.1 (plan 4ce1b994 phase 2). This method awaits
    /// JS round trips, and the render it follows can be followed by ANOTHER render while they are
    /// pending. Two interleaved passes pinned and raised twice over the same fields. A render that
    /// arrives while a pass is in flight only asks for one more pass, and the running pass repeats
    /// until no request is left.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_afterRenderRunning)
        {
            _afterRenderRerun = true;
            return;
        }

        _afterRenderRunning = true;
        try
        {
            do
            {
                _afterRenderRerun = false;
                await RunAfterRenderAsync();
            }
            while (_afterRenderRerun && !_disposed);
        }
        finally
        {
            _afterRenderRunning = false;
        }
    }

    private async Task RunAfterRenderAsync()
    {
        if (_disposed)
            return;

        // Pinned-on-top status UI (V2): promote on the first toast, re-raise on every push (keyed
        // on the newest id — the visible count can stay unchanged at the cap), demote and unpin
        // when the last toast leaves. Mirrors TmToastContainer.
        if (_toasts.Count > 0)
        {
            var newestId = _toasts[^1].Id;
            if (!_promoted || newestId != _lastNewestId)
            {
                _topLayer ??= new TopLayerInterop(JS);
                if (!_pinned)
                {
                    _pinned = true;
                    await _topLayer.PinAsync(_root);
                    if (_disposed)
                        return;
                }
                await _topLayer.RaiseAsync(_root);
                if (_disposed)
                    return;
                _promoted = true;
                _lastNewestId = newestId;
            }
        }
        else if (_promoted)
        {
            _promoted = false;
            _lastNewestId = null;
            if (_topLayer is not null)
            {
                await _topLayer.DemoteAsync(_root);
                if (_pinned)
                {
                    _pinned = false;
                    await _topLayer.UnpinAsync(_root);
                }
            }
        }

        if (_disposed)
            return;

        // F6 follow-up (c51ddf81 #4), review round: keyed on the VISIBLE ID SET, not the count —
        // the cap-3 queue refill closes one toast and dequeues the next in one render, so the
        // count never drops while the closed card (possibly holding focus) leaves the DOM. The
        // id set drops it, so the container asks the trap to recover; restoreTrapFocusIfLost acts
        // only when an inert-exempt surface actually held focus. Mirrors TmToastContainer.
        var ids = new HashSet<string>(_toasts.Select(t => t.Id));
        if (_lastIds.Any(id => !ids.Contains(id)))
        {
            _focusIfLost ??= new FocusIfLostInterop(JS);
            await _focusIfLost.RestoreTrapFocusIfLostAsync();
        }
        _lastIds = ids;
    }

    private async Task OnToastClickAsync(ToastModel toast)
    {
        RemoveToast(toast.Id);
        if (!string.IsNullOrEmpty(toast.Notification.ActionUrl))
            Navigation.NavigateTo(toast.Notification.ActionUrl);
    }

    private static string TypeIcon(string type) => type switch
    {
        TmNotificationTypes.Mention => IconNames.AtSign,
        TmNotificationTypes.Reply => IconNames.MessageSquare,
        TmNotificationTypes.Reaction => IconNames.ThumbsUp,
        TmNotificationTypes.ThreadResolved => IconNames.CheckCircle,
        TmNotificationTypes.NewThread => IconNames.PlusCircle,
        _ => IconNames.Bell
    };

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        NotificationService.OnChanged -= OnNotificationsChanged;
        if (_focusIfLost is not null)
        {
            await _focusIfLost.DisposeAsync();
            _focusIfLost = null;
        }
        if (_topLayer is not null)
        {
            if (_pinned)
            {
                _pinned = false;
                await _topLayer.UnpinAsync(_root);
            }
            await _topLayer.DisposeAsync();
        }
    }

    private class ToastModel
    {
        public string Id { get; set; } = string.Empty;
        public TmNotification Notification { get; set; } = default!;
    }
}
