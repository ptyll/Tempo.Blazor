@namespace Tempo.Blazor.Components.Notifications
@using Tempo.Blazor.Abstractions.Shared
@using Tempo.Blazor.Components.Icons
@implements IDisposable

<div class="tm-notification-bell @Class @(_hasNew ? "tm-notification-bell--pulse" : "")"
     @attributes="AdditionalAttributes"
     @ref="_rootRef">
    <button type="button"
            class="tm-notification-bell__button"
            aria-label="@AriaLabelText"
            title="@AriaLabelText"
            @ref="_buttonRef"
            @onclick="ToggleAsync">
        <TmIcon Name="@IconNames.Bell" Size="IconSize.Sm" />
        @if (UnreadCount > 0)
        {
            <span class="tm-notification-bell__badge">@UnreadCount</span>
        }
    </button>

    @* The dropdown is a TmOverlayPanel: popover="manual" puts it in the browser top layer, so an
       ancestor's overflow/transform can no longer clip it. Bottom + End + 8px replaces the old
       top:calc(100%+0.5rem);right:0; the fixed 360px width stays in CSS. The anchor is the BUTTON
       (Align.End keeps the dropdown's right edge identical to the old root anchor) so overlay.js's
       Escape focus restore lands on a natively focusable element — the wrapper div cannot take it. *@
    <TmOverlayPanel Anchor="_buttonRef"
                    IsOpen="_isOpen"
                    IsOpenChanged="SetOpenFromJsAsync"
                    Placement="OverlayPlacement.Bottom"
                    Align="OverlayAlign.End"
                    Offset="8"
                    Role="dialog"
                    Class="tm-notification-bell__dropdown">
            <div class="tm-notification-bell__header">
                <span class="tm-notification-bell__title">@Loc["TmNotificationBell_AriaLabel"]</span>
                <div class="tm-notification-bell__actions">
                    <button type="button"
                            class="tm-notification-bell__filter"
                            @onclick="() => _showOnlyUnread = !_showOnlyUnread">
                        @(_showOnlyUnread ? Loc["TmNotificationBell_ShowAll"] : Loc["TmNotificationBell_ShowOnlyUnread"])
                    </button>
                    @if (UnreadCount > 0)
                    {
                        <button type="button"
                                class="tm-notification-bell__mark-all"
                                @onclick="MarkAllReadAsync">
                            @Loc["TmNotificationBell_MarkAllRead"]
                        </button>
                    }
                </div>
            </div>

            <div class="tm-notification-bell__list">
                @if (VisibleNotifications.Any())
                {
                    @foreach (var n in VisibleNotifications)
                    {
                        <div class="tm-notification-bell__item @(n.IsRead ? "" : "tm-notification-bell__item--unread")"
                             @onclick="() => OnItemClickAsync(n)">
                            <div class="tm-notification-bell__avatar">
                                @if (!string.IsNullOrEmpty(n.Actor?.AvatarUrl))
                                {
                                    <img src="@n.Actor.AvatarUrl" alt="" />
                                }
                                else
                                {
                                    <TmIcon Name="@TypeIcon(n.Type)" Size="IconSize.Sm" />
                                }
                            </div>
                            <div class="tm-notification-bell__content">
                                <span class="tm-notification-bell__message">@n.Title</span>
                                <span class="tm-notification-bell__time">@FormatTime(n.CreatedAt)</span>
                            </div>
                            @if (!n.IsRead)
                            {
                                <span class="tm-notification-bell__dot" aria-hidden="true"></span>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="tm-notification-bell__empty">@Loc["TmNotificationBell_NoNotifications"]</div>
                }
            </div>
    </TmOverlayPanel>
</div>

@code {
    [Inject] private ITmNotificationService NotificationService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    [Parameter] public string? Class { get; set; }
    [Parameter] public string CurrentUserId { get; set; } = "demo";
    [Parameter] public EventCallback<bool> OnDropdownOpenChanged { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool _isOpen;
    private bool _hasNew;
    private bool _showOnlyUnread;
    private int _serviceUnreadCount;
    private List<TmNotification> _notifications = new();
    private ElementReference _rootRef;
    private ElementReference _buttonRef;

    private int UnreadCount => _serviceUnreadCount;

    private string AriaLabelText => UnreadCount > 0
        ? Loc["TmNotificationBell_NewCount", UnreadCount]
        : Loc["TmNotificationBell_AriaLabel"];

    private IEnumerable<TmNotification> VisibleNotifications =>
        _showOnlyUnread ? _notifications.Where(n => !n.IsRead) : _notifications;

    protected override async Task OnInitializedAsync()
    {
        NotificationService.OnChanged += OnNotificationsChanged;
        await LoadUnreadCountAsync();
    }

    private async void OnNotificationsChanged()
    {
        await InvokeAsync(async () =>
        {
            _hasNew = true;
            await LoadUnreadCountAsync();
            if (_isOpen)
                await LoadNotificationsAsync();
            StateHasChanged();
        });
    }

    private async Task ToggleAsync()
    {
        _isOpen = !_isOpen;
        if (_isOpen)
        {
            _hasNew = false;
            await LoadNotificationsAsync();
        }
        else
        {
            _showOnlyUnread = false;
        }
        await OnDropdownOpenChanged.InvokeAsync(_isOpen);
    }

    /// <summary>
    /// JS-driven dismissal (Escape or outside pointerdown from overlay.js) — same state effects as
    /// the toggle path (reset the unread-only filter, notify OnDropdownOpenChanged).
    /// </summary>
    private async Task SetOpenFromJsAsync(bool open)
    {
        if (open == _isOpen)
            return;
        _isOpen = open;
        if (open)
        {
            _hasNew = false;
            await LoadNotificationsAsync();
        }
        else
        {
            _showOnlyUnread = false;
        }
        await OnDropdownOpenChanged.InvokeAsync(_isOpen);
    }

    private async Task LoadNotificationsAsync()
    {
        _notifications = (await NotificationService.GetNotificationsAsync(new TmNotificationQuery
        {
            RecipientUserId = CurrentUserId,
            Take = 50
        })).ToList();
        _serviceUnreadCount = _notifications.Count(n => !n.IsRead);
    }

    private async Task LoadUnreadCountAsync()
    {
        _serviceUnreadCount = await NotificationService.GetUnreadCountAsync(CurrentUserId);
    }

    private async Task MarkAllReadAsync()
    {
        await NotificationService.MarkAllAsReadAsync(CurrentUserId);
        await LoadNotificationsAsync();
    }

    private async Task OnItemClickAsync(TmNotification notification)
    {
        if (!notification.IsRead)
            await NotificationService.MarkAsReadAsync(notification.Id, CurrentUserId);

        if (!string.IsNullOrEmpty(notification.ActionUrl))
            Navigation.NavigateTo(notification.ActionUrl);

        await LoadNotificationsAsync();
    }

    private static string FormatTime(DateTimeOffset dt)
    {
        var diff = DateTimeOffset.UtcNow - dt.ToUniversalTime();
        if (diff.TotalMinutes < 1) return "just now";
        if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalDays < 1) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return dt.ToLocalTime().ToString("MMM d");
    }

    private static string TypeIcon(string type) => type switch
    {
        TmNotificationTypes.Mention => IconNames.AtSign,
        TmNotificationTypes.Reply => IconNames.MessageSquare,
        TmNotificationTypes.Reaction => IconNames.ThumbsUp,
        TmNotificationTypes.ThreadResolved => IconNames.CheckCircle,
        TmNotificationTypes.NewThread => IconNames.PlusCircle,
        _ => IconNames.Bell
    };

    public void Dispose()
    {
        NotificationService.OnChanged -= OnNotificationsChanged;
    }
}
