@namespace Tempo.Blazor.Components.Buttons
@using Microsoft.JSInterop
@inject IJSRuntime JS

<button type="button"
        class="tm-copy-button @(_copied ? "tm-copy-button--copied" : "") @(ShowLabel ? "tm-copy-button--labelled" : "") @Class"
        disabled="@Disabled"
        aria-label="@AccessibleName"
        @onclick="HandleCopy"
        @attributes="AdditionalAttributes">
    @if (_copied)
    {
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12" />
        </svg>
    }
    else
    {
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
        </svg>
    }
    @if (ShowLabel)
    {
        @* Both labels occupy the same grid cell, so Copy and Copied reserve each other's width and
           the button does not jump. The hidden one stays out of the accessibility tree. *@
        <span class="tm-copy-button-labels">
            <span class="tm-copy-button-label @(_copied ? "tm-sr-only" : "")" aria-hidden="@(_copied ? "true" : null)">@Loc["TmCopyButton_Copy"]</span>
            <span class="tm-copy-button-label @(_copied ? "" : "tm-sr-only")" aria-hidden="@(_copied ? null : "true")">@Loc["TmCopyButton_Copied"]</span>
        </span>
        <span class="tm-sr-only" role="status">@(_copied ? Loc["TmCopyButton_Copied"] : "")</span>
    }
</button>

@code {
    private bool _copied;

    /// <summary>Text to copy to clipboard.</summary>
    [Parameter, EditorRequired] public string Text { get; set; } = default!;

    /// <summary>Additional CSS class.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Disables the button.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Renders the localized copy/copied label next to the icon. Defaults to false, which keeps the
    /// historical icon-only button; the same text stays the accessible name either way.
    /// </summary>
    [Parameter] public bool ShowLabel { get; set; }

    // The accessible name keeps its historical wording ("Copy to clipboard") whether or not the
    // short label is shown, so a screen reader announces exactly what the button did before.
    private string AccessibleName => _copied ? Loc["TmCopyButton_Copied"] : Loc["TmCopyButton_CopyToClipboard"];

    private string VisibleLabel => _copied ? Loc["TmCopyButton_Copied"] : Loc["TmCopyButton_Copy"];

    /// <summary>Additional HTML attributes to apply to the button element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task HandleCopy()
    {
        if (Disabled) return;

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Text);
            _copied = true;
            StateHasChanged();

            await Task.Delay(2000);
            _copied = false;
            StateHasChanged();
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        catch (TaskCanceledException) { }
    }
}
