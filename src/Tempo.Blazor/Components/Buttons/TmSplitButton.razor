@namespace Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Components.Overlay
@using Tempo.Blazor.Helpers
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div @ref="_wrapperRef" class="tm-split-button @SizeClass @VariantClass @(Disabled ? "tm-split-button--disabled" : "") @Class" @attributes="AdditionalAttributes">
    <button type="button"
            class="tm-split-button__primary"
            disabled="@Disabled"
            data-tm-toolbar-control="@(Toolbar is not null ? string.Empty : null)"
            @attributes="PrimaryAttributes"
            @onclick="HandlePrimaryClick">
        @if (IsLoading)
        {
            <span class="tm-split-button__spinner"></span>
        }
        @if (!string.IsNullOrEmpty(Icon))
        {
            <TmIcon Name="@Icon" Size="IconSize.Sm" />
        }
        <span class="tm-split-button__text">@Text</span>
    </button>

    <button type="button"
            class="tm-split-button__toggle"
            disabled="@Disabled"
            aria-haspopup="true"
            aria-expanded="@(_isOpen ? "true" : "false")"
            aria-label="@ToggleAriaLabel"
            data-tm-toolbar-control="@(Toolbar is not null ? string.Empty : null)"
            @ref="_toggleRef"
            @onclick="ToggleDropdown">
        <TmIcon Name="chevron-down" Size="IconSize.Xs" />
    </button>

    @* The dropdown is a TmOverlayPanel: popover="manual" puts it in the browser top layer, so an
       ancestor's overflow (modal body, scrolling column) can no longer clip it, and overlay.js
       repositions it on scroll/resize. Bottom + End + 4px keep the historical
       "under the button row, right edge aligned" look (the old top:100%;right:0;margin-top:4px).
       The anchor is the TOGGLE button (Align.End keeps the right edge identical to the old root
       anchor) so overlay.js's Escape focus restore lands on a natively focusable element — the
       wrapper div cannot take it. F11: the dropdown opts into the shared bottom sheet on a mobile
       viewport through MobilePresentation (default Popover keeps the anchored popover at every
       width); the sheet header is titled with SheetTitle or the localized
       TmSplitButton_SheetTitle default. *@
    <TmOverlayPanel Anchor="_toggleRef"
                    IsOpen="_isOpen"
                    IsOpenChanged="SetOpen"
                    OnOpened="FocusFirstItemAsync"
                    Placement="OverlayPlacement.Bottom"
                    Align="OverlayAlign.End"
                    Offset="4"
                    Role="menu"
                    Title="@EffectiveSheetTitle"
                    MobilePresentation="MobilePresentation"
                    Class="tm-split-button__dropdown"
                    @onclick="CloseMenu">
        @ChildContent
    </TmOverlayPanel>
</div>

@code {
    private bool _isOpen;
    private bool _focusToggleAfterClose;
    private ElementReference _toggleRef;
    private ElementReference _wrapperRef;
    private MenuNavInterop? _menuNav;
    private bool _disposed;

    /// <summary>Text label on the primary button.</summary>
    [Parameter, EditorRequired] public string Text { get; set; } = default!;

    /// <summary>Fires when the primary button is clicked.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>Visual style variant.</summary>
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;

    /// <summary>Button size.</summary>
    [Parameter] public ButtonSize? Size { get; set; }

    /// <summary>Disables both the primary and dropdown buttons.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Shows a loading spinner on the primary button.</summary>
    [Parameter] public bool IsLoading { get; set; }

    /// <summary>Dropdown menu items (e.g. TmDropdownItem or TmContextMenuItem).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// How the dropdown presents on a narrow viewport. Default
    /// <see cref="PanelPresentation.Popover"/>: the anchored popover at every width.
    /// <see cref="PanelPresentation.Auto"/> opts into the shared bottom sheet on a mobile
    /// viewport (the anchored popover otherwise) — the choice resolves from the viewport scope.
    /// A forced value renders that presentation without measuring.
    /// </summary>
    [Parameter] public PanelPresentation MobilePresentation { get; set; } = PanelPresentation.Popover;

    /// <summary>
    /// Title of the sheet header when the dropdown presents as a bottom sheet. When
    /// <see langword="null"/> (default), the localized <c>TmSplitButton_SheetTitle</c> default
    /// is used. The value also names the popover (<c>aria-label</c>) — the menu carries no other
    /// accessible name, so a <c>role="menu"</c> popover is not unnamed.
    /// </summary>
    [Parameter] public string? SheetTitle { get; set; }

    /// <summary>Optional icon (an <c>IconNames</c> value) shown before the text of the primary button.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>
    /// Accessible name of the chevron button that opens the menu. When <see langword="null"/> (default) the
    /// attribute is omitted (the pre-existing markup); set it so the icon-only toggle has a name.
    /// </summary>
    [Parameter] public string? ToggleAriaLabel { get; set; }

    /// <summary>
    /// Additional HTML attributes for the primary action button (a <c>data-testid</c>, an <c>aria-label</c>);
    /// <see cref="AdditionalAttributes"/> still lands on the root element.
    /// </summary>
    [Parameter] public Dictionary<string, object>? PrimaryAttributes { get; set; }

    /// <summary>Additional CSS class(es) to apply to the root element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Additional HTML attributes to apply to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>The toolbar the split button sits in, if any: BOTH its buttons (the primary action
    /// and the menu toggle) then join the toolbar's roving tab stop (C6) — two arrow stops, one Tab
    /// stop — instead of being two separate Tab stops.</summary>
    [CascadingParameter] private Tempo.Blazor.Components.Toolbar.TmToolbar? Toolbar { get; set; }

    // SheetTitle=null falls back to the localized per-component default; the value also names
    // the popover (TmOverlayPanel emits Title as its aria-label when nothing else names it).
    private string EffectiveSheetTitle => string.IsNullOrEmpty(SheetTitle) ? Loc["TmSplitButton_SheetTitle"] : SheetTitle!;

    private string VariantClass => $"tm-split-button--{Variant.ToString().ToLowerInvariant()}";

    private string SizeClass => Size switch
    {
        ButtonSize.Xs => "tm-split-button--xs",
        ButtonSize.Sm => "tm-split-button--sm",
        ButtonSize.Lg => "tm-split-button--lg",
        _ => ""
    };

    private async Task HandlePrimaryClick()
    {
        if (Disabled || IsLoading)
            return;
        // The overlay anchor is _toggleRef, so the primary button sits OUTSIDE the anchor's
        // exemption zone: an open menu reaches the JS outside-dismiss on this click too — but
        // only after the interop round-trip. The synchronous close here guarantees the menu
        // can never outlive the primary action it floated over.
        _isOpen = false;
        await OnClick.InvokeAsync();
    }

    private void ToggleDropdown()
    {
        if (!Disabled)
            _isOpen = !_isOpen;
    }

    private void SetOpen(bool open)
    {
        _isOpen = open;
    }

    // N319: any click inside the menu is an item activation — the menu must close, or a dialog
    // the item handler opens would render under the still-open top-layer popover. This bubbles
    // after the item's own onclick; the batched render then applies menu-closed + dialog-open
    // together (and the first Escape reaches the dialog, not the stale menu).
    private void CloseMenu()
    {
        _isOpen = false;
        // docs/overlays.md rule 4 (UX review round 2, m2): a click close does not route through
        // overlay.js's focus restore — the dropdown pattern (TmDropdown.SelectItemAsync): put
        // focus back on the toggle, or a keyboard activation leaves focus on <body>. FocusAsync
        // lands in OnAfterRenderAsync, after the close re-render.
        _focusToggleAfterClose = true;
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusToggleAfterClose)
        {
            return;
        }
        _focusToggleAfterClose = false;
        try
        {
            await _toggleRef.FocusAsync(preventScroll: true);
        }
        catch (InvalidOperationException)
        {
            // The toggle left the DOM with the close (a conditional host): nothing to focus.
        }
    }

    /// <summary>A keyboard-opened menu hands focus to its first enabled item (shared owner: MenuNavInterop).</summary>
    private Task FocusFirstItemAsync() => _disposed ? Task.CompletedTask : (_menuNav ??= new MenuNavInterop(JS)).FocusFirstAsync(_wrapperRef);

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        var menuNav = _menuNav;
        _menuNav = null;
        if (menuNav is not null) await menuNav.DisposeAsync();
    }

    // No wrapper-level Escape handler: overlay.js consumes Escape in the window capture phase
    // and routes it through TmOverlayPanel.NotifyDismissedAsync — a bubbling handler on this
    // div could never run in a real browser (dead-branch sweep, N169 follow-up).
}
