@namespace Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Icons

<div @ref="_rootRef" class="tm-split-button @SizeClass @VariantClass @(Disabled ? "tm-split-button--disabled" : "") @Class" @onkeydown="HandleKeyDown" @attributes="AdditionalAttributes">
    <button type="button"
            class="tm-split-button__primary"
            disabled="@Disabled"
            @onclick="HandlePrimaryClick">
        @if (IsLoading)
        {
            <span class="tm-split-button__spinner"></span>
        }
        <span class="tm-split-button__text">@Text</span>
    </button>

    <button type="button"
            class="tm-split-button__toggle"
            disabled="@Disabled"
            aria-haspopup="true"
            aria-expanded="@(_isOpen ? "true" : "false")"
            @ref="_toggleRef"
            @onclick="ToggleDropdown">
        <TmIcon Name="chevron-down" Size="IconSize.Xs" />
    </button>

    @* The dropdown is a TmOverlayPanel: popover="manual" puts it in the browser top layer, so an
       ancestor's overflow (modal body, scrolling column) can no longer clip it, and overlay.js
       repositions it on scroll/resize. Bottom + End + 4px keep the historical
       "under the button row, right edge aligned" look (the old top:100%;right:0;margin-top:4px).
       The anchor is the TOGGLE button (Align.End keeps the right edge identical to the old root
       anchor) so overlay.js's Escape focus restore lands on a natively focusable element — the
       wrapper div cannot take it. *@
    <TmOverlayPanel Anchor="_toggleRef"
                    IsOpen="_isOpen"
                    IsOpenChanged="SetOpen"
                    Placement="OverlayPlacement.Bottom"
                    Align="OverlayAlign.End"
                    Offset="4"
                    Role="menu"
                    Class="tm-split-button__dropdown">
        @ChildContent
    </TmOverlayPanel>
</div>

@code {
    private bool _isOpen;
    private ElementReference _rootRef;
    private ElementReference _toggleRef;

    /// <summary>Text label on the primary button.</summary>
    [Parameter, EditorRequired] public string Text { get; set; } = default!;

    /// <summary>Fires when the primary button is clicked.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>Visual style variant.</summary>
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;

    /// <summary>Button size.</summary>
    [Parameter] public ButtonSize? Size { get; set; }

    /// <summary>Disables both the primary and dropdown buttons.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Shows a loading spinner on the primary button.</summary>
    [Parameter] public bool IsLoading { get; set; }

    /// <summary>Dropdown menu items (e.g. TmDropdownItem or TmContextMenuItem).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Additional CSS class(es) to apply to the root element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Additional HTML attributes to apply to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string VariantClass => $"tm-split-button--{Variant.ToString().ToLowerInvariant()}";

    private string SizeClass => Size switch
    {
        ButtonSize.Xs => "tm-split-button--xs",
        ButtonSize.Sm => "tm-split-button--sm",
        ButtonSize.Lg => "tm-split-button--lg",
        _ => ""
    };

    private async Task HandlePrimaryClick()
    {
        if (Disabled || IsLoading)
            return;
        // The primary button sits inside the anchor's exemption zone, so an open menu survives
        // this click unless we close it ourselves — a running primary action must not leave the
        // menu floating.
        _isOpen = false;
        await OnClick.InvokeAsync();
    }

    private void ToggleDropdown()
    {
        if (!Disabled)
            _isOpen = !_isOpen;
    }

    private void SetOpen(bool open)
    {
        _isOpen = open;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            _isOpen = false;
    }
}
