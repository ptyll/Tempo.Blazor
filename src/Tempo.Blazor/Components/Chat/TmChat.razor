@namespace Tempo.Blazor.Components.Chat
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Models

<div class="tm-chat @Class" @attributes="AdditionalAttributes">

    @if (HeaderContent is not null)
    {
        @HeaderContent
    }

    @if (BannerContent is not null)
    {
        @* Deliberately NOT a live region — see the BannerContent XML doc. *@
        @BannerContent
    }

    <!-- Messages -->
    <div class="tm-chat__messages" @ref="_messagesContainer">
        @if (Messages.Count == 0)
        {
            @if (EmptyContent is not null)
            {
                @EmptyContent
            }
            else
            {
                <div class="tm-chat__empty">
                    <TmIcon Name="message-circle" Size="IconSize.Xl" />
                    <p>@Loc["TmChat_EmptyTitle"]</p>
                    <span>@Loc["TmChat_EmptySubtitle"]</span>
                </div>
            }
        }
        else
        {
            @foreach (var (message, index, isFirstInGroup) in RootEntries())
            {
                @RenderMessage(message, inThread: false, index, isFirstInGroup)
            }
        }

        <!-- Typing indicator -->
        @if (ShowTypingIndicator)
        {
            @if (TypingTemplate is not null)
            {
                @TypingTemplate(TypingUsers)
            }
            else
            {
                <div class="tm-chat__typing-indicator" aria-hidden="@(TypingAriaHidden ? "true" : null)">
                    <div class="tm-chat__typing-dots" aria-hidden="true">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                    <span class="tm-chat__typing-text">@GetTypingText()</span>
                </div>
            }
        }
    </div>

    <!-- Input area -->
    @if (ShowComposer)
    {
        var custom = ComposerTemplate is not null;
        var stacked = !custom && (ComposerAddon is not null || ComposerFooter is not null);
        <div class="@ComposerAreaClass(stacked, custom)">
            @if (ComposerTemplate is not null)
            {
                @ComposerTemplate(ComposerContext)
            }
            else if (stacked)
            {
                @if (ComposerAddon is not null)
                {
                    @ComposerAddon
                }
                <div class="tm-chat__input-row">@BuiltInComposerInput</div>
                @if (ComposerFooter is not null)
                {
                    @ComposerFooter
                }
            }
            else
            {
                @BuiltInComposerInput
            }
        </div>
    }

    <!-- Thread panel -->
    @if (EnableThreads && ActiveThreadRoot is { } threadRoot)
    {
        <aside class="tm-chat__thread-panel" data-testid="@TestId("chat-thread-panel")">
            <div class="tm-chat__thread-header">
                <span class="tm-chat__thread-title">@Loc["TmChat_ThreadTitle"]</span>
                <button type="button"
                        class="tm-chat__thread-close"
                        data-testid="@TestId("chat-thread-close")"
                        aria-label="@Loc["TmChat_ThreadClose"]"
                        @onclick="CloseThreadAsync">
                    <TmIcon Name="x" Size="IconSize.Sm" />
                </button>
            </div>
            <div class="tm-chat__thread-messages">
                @foreach (var (threadMessage, threadIndex, isFirstInGroup) in ThreadEntries(threadRoot))
                {
                    @RenderMessage(threadMessage, inThread: true, threadIndex, isFirstInGroup)
                    @if (threadIndex == 0)
                    {
                        <div class="tm-chat__thread-divider">
                            <span>@Loc.Plural("TmChat_ReplyCount", ReplyCountOf(threadRoot))</span>
                        </div>
                    }
                }
            </div>
            <div class="tm-chat__thread-input-area">
                <textarea class="tm-chat__input tm-chat__thread-input"
                          rows="1"
                          data-testid="@TestId("chat-thread-input")"
                          placeholder="@Loc["TmChat_ReplyPlaceholder"]"
                          disabled="@Disabled"
                          @bind="_threadInput"
                          @bind:event="oninput"
                          @bind:after="NotifyDraftChangedAsync"
                          @onkeydown="HandleThreadKeyDownAsync"></textarea>
                <button type="button"
                        class="tm-chat__send-btn"
                        data-testid="@TestId("chat-thread-send")"
                        disabled="@(Disabled || string.IsNullOrWhiteSpace(_threadInput))"
                        aria-label="@Loc["TmChat_Send"]"
                        @onclick="SendThreadReplyAsync">
                    <TmIcon Name="send" Size="IconSize.Sm" />
                </button>
            </div>
        </aside>
    }

</div>

@code {
    // The composer area is a flex row by default; when a ComposerAddon (above) or ComposerFooter
    // (below) surrounds the built-in input, the area stacks vertically and the input row keeps the
    // horizontal textarea + send layout (see .tm-chat__input-area--stacked in TmChat.razor.css).
    // A ComposerTemplate replaces the whole composer — the wrapper (padding, border) stays and
    // stacks the host's markup vertically via .tm-chat__input-area--custom.
    private static string ComposerAreaClass(bool stacked, bool custom)
        => custom
            ? "tm-chat__input-area tm-chat__input-area--custom"
            : stacked ? "tm-chat__input-area tm-chat__input-area--stacked" : "tm-chat__input-area";

    // The built-in composer input row (textarea + send button), shared by the flat and the stacked
    // composer layout. A ComposerTemplate replaces it entirely.
    private RenderFragment BuiltInComposerInput => @<text>
        <textarea class="tm-chat__input"
                  id="@_composerInputId"
                  rows="1"
                  placeholder="@PlaceholderText"
                  disabled="@Disabled"
                  aria-describedby="@ComposerDescribedBy"
                  @ref="_composerInput"
                  @bind="_inputText"
                  @bind:event="oninput"
                  @bind:after="NotifyDraftChangedAsync"
                  @onkeydown="HandleKeyDownAsync"></textarea>
        <button type="button"
                class="tm-chat__send-btn"
                disabled="@IsSendDisabled"
                aria-label="@Loc["TmChat_Send"]"
                @onclick="HandleSendAsync">
            <TmIcon Name="send" Size="IconSize.Sm" />
        </button>
    </text>;

    // Every message renders inside a neutral wrapper carrying the data-message-id anchor
    // (scroll positioning + read receipts) and data-kind when the message carries a Kind.
    // Inside the wrapper, either the host's MessageTemplate or the built-in message row.
    private RenderFragment RenderMessage(ChatMessage message, bool inThread, int index, bool isFirstInGroup) => @<div class="tm-chat__item" data-message-id="@message.Id" data-kind="@message.Kind">
        @if (UsesTemplate(message))
        {
            @TemplateFor(message, inThread, index, isFirstInGroup)
        }
        else
        {
            @RenderBuiltInMessage(message, inThread)
        }
    </div>;

    private RenderFragment TemplateFor(ChatMessage message, bool inThread, int index, bool isFirstInGroup)
        => MessageTemplate!(CreateTemplateContext(message, inThread, index, isFirstInGroup));

    private RenderFragment RenderBuiltInMessage(ChatMessage message, bool inThread) => @<div class="@GetMessageCssClass(message)">
        @if (message.Type == ChatMessageType.System)
        {
            <span class="tm-chat__system-text">@message.Text</span>
        }
        else
        {
            @if (ShowAvatars)
            {
                @if (message.Type == ChatMessageType.Incoming || !IsCurrentUser(message.Author))
                {
                    <div class="tm-chat__avatar tm-chat__avatar--incoming">
                        @if (!string.IsNullOrEmpty(message.Author?.Avatar))
                        {
                            <span>@message.Author.Avatar</span>
                        }
                        else
                        {
                            <TmIcon Name="user" Size="IconSize.Sm" />
                        }
                    </div>
                }
                else
                {
                    <div class="tm-chat__avatar tm-chat__avatar--outgoing">
                        @if (!string.IsNullOrEmpty(CurrentUser.Avatar))
                        {
                            <span>@CurrentUser.Avatar</span>
                        }
                        else
                        {
                            <TmIcon Name="user" Size="IconSize.Sm" />
                        }
                    </div>
                }
            }

            <div class="tm-chat__bubble">
                <div class="tm-chat__meta">
                    <span class="tm-chat__author">@(message.Author?.Name ?? CurrentUser.Name)</span>
                    <span class="tm-chat__message-time">@FormatTimestamp(message.Timestamp)</span>
                    @if (message.IsEdited && !message.IsDeleted)
                    {
                        <span class="tm-chat__edited" data-testid="@TestId($"chat-edited-{message.Id}")">@Loc["TmChat_Edited"]</span>
                    }
                </div>

                @if (message.IsDeleted)
                {
                    <div class="tm-chat__text tm-chat__text--deleted" data-testid="@TestId($"chat-deleted-{message.Id}")">
                        <TmIcon Name="slash" Size="IconSize.Sm" />
                        <span>@Loc["TmChat_Deleted"]</span>
                    </div>
                }
                else if (_editingId == message.Id)
                {
                    <div class="tm-chat__edit">
                        <textarea class="tm-chat__input tm-chat__edit-input"
                                  rows="1"
                                  data-testid="@TestId("chat-edit-input")"
                                  @bind="_editText"
                                  @bind:event="oninput"
                                  @bind:after="NotifyDraftChangedAsync"
                                  @onkeydown="HandleEditKeyDownAsync"></textarea>
                        <div class="tm-chat__edit-actions">
                            <button type="button" class="tm-chat__edit-save" data-testid="@TestId("chat-edit-save")" @onclick="CommitEditAsync">@Loc["TmChat_Save"]</button>
                            <button type="button" class="tm-chat__edit-cancel" data-testid="@TestId("chat-edit-cancel")" @onclick="CancelEdit">@Loc["TmChat_Cancel"]</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="tm-chat__text">
                        @if (message.IsError)
                        {
                            <span class="tm-chat__error-text">@message.Text</span>
                        }
                        else if (message.IsSending)
                        {
                            <span>@message.Text</span>
                            <span class="tm-chat__sending-dots" aria-hidden="true"></span>
                        }
                        else
                        {
                            <span>@message.Text</span>
                        }
                    </div>

                    @if (message.Attachments.Count > 0)
                    {
                        <div class="tm-chat__attachments">
                            @foreach (var attachment in message.Attachments)
                            {
                                <button type="button"
                                        class="tm-chat__attachment"
                                        @onclick="() => HandleAttachmentClick(attachment)"
                                        title="@attachment.Name">
                                    <TmIcon Name="file" Size="IconSize.Sm" />
                                    <span class="tm-chat__attachment-name">@attachment.Name</span>
                                    @if (attachment.Size.HasValue)
                                    {
                                        <span class="tm-chat__attachment-size">@FormatFileSize(attachment.Size)</span>
                                    }
                                </button>
                            }
                        </div>
                    }
                }

                @if (EnableReactions && message.Reactions.Count > 0 && !message.IsDeleted)
                {
                    <div class="tm-chat__reactions">
                        @foreach (var reaction in message.Reactions.Where(r => r.Count > 0))
                        {
                            var r = reaction;
                            <button type="button"
                                    class="@GetReactionChipClass(r)"
                                    data-testid="@TestId($"chat-reaction-{message.Id}")"
                                    data-emoji="@r.Emoji"
                                    @onclick="() => ToggleReactionAsync(message.Id, r.Emoji)">
                                <span class="tm-chat__reaction-emoji">@r.Emoji</span>
                                <span class="tm-chat__reaction-count">@r.Count</span>
                            </button>
                        }
                    </div>
                }

                @if (!inThread && EnableThreads && ReplyCountOf(message) > 0)
                {
                    <button type="button"
                            class="tm-chat__thread-badge"
                            data-testid="@TestId($"chat-thread-open-{message.Id}")"
                            @onclick="() => OpenThreadAsync(message)">
                        <TmIcon Name="message-circle" Size="IconSize.Sm" />
                        <span>@Loc.Plural("TmChat_ReplyCount", ReplyCountOf(message))</span>
                    </button>
                }

                @if (ShowReadReceipts && IsCurrentUser(message.Author) && !message.IsDeleted && OtherReaders(message).Count > 0)
                {
                    <div class="tm-chat__receipts" data-testid="@TestId($"chat-receipts-{message.Id}")" title="@GetReceiptsText(message)">
                        <TmIcon Name="check-check" Size="IconSize.Sm" />
                        <span class="tm-chat__receipts-text">@GetReceiptsText(message)</span>
                    </div>
                }

                @if (!message.IsDeleted && _editingId != message.Id && HasMessageActions(message, inThread))
                {
                    <div class="tm-chat__actions">
                        @if (CanReact)
                        {
                            <button type="button" class="tm-chat__action" data-testid="@TestId($"chat-react-{message.Id}")"
                                    aria-label="@Loc["TmChat_React"]" @onclick="() => TogglePicker(message.Id)">
                                <TmIcon Name="smile" Size="IconSize.Sm" />
                            </button>
                        }
                        @if (!inThread && CanReplyInThread)
                        {
                            <button type="button" class="tm-chat__action" data-testid="@TestId($"chat-reply-{message.Id}")"
                                    aria-label="@Loc["TmChat_Reply"]" @onclick="() => OpenThreadAsync(message)">
                                <TmIcon Name="message-circle" Size="IconSize.Sm" />
                            </button>
                        }
                        @if (CanEditMessage(message))
                        {
                            <button type="button" class="tm-chat__action" data-testid="@TestId($"chat-edit-{message.Id}")"
                                    aria-label="@Loc["TmChat_Edit"]" @onclick="() => StartEdit(message)">
                                <TmIcon Name="pencil" Size="IconSize.Sm" />
                            </button>
                        }
                        @if (CanDeleteMessage(message))
                        {
                            <button type="button" class="tm-chat__action tm-chat__action--danger" data-testid="@TestId($"chat-delete-{message.Id}")"
                                    aria-label="@Loc["TmChat_Delete"]" @onclick="() => DeleteAsync(message)">
                                <TmIcon Name="trash" Size="IconSize.Sm" />
                            </button>
                        }
                    </div>

                    @if (_pickerForId == message.Id)
                    {
                        <div class="tm-chat__emoji-picker" data-testid="@TestId("chat-emoji-picker")">
                            @for (var i = 0; i < ReactionEmojis.Count; i++)
                            {
                                var emoji = ReactionEmojis[i];
                                var idx = i;
                                <button type="button" class="tm-chat__emoji" data-testid="@TestId($"chat-emoji-{message.Id}-{idx}")"
                                        @onclick="() => ToggleReactionAsync(message.Id, emoji)">@emoji</button>
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>;
}
