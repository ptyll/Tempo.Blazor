@namespace Tempo.Blazor.Components.DataTable
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Filters
@using Tempo.Blazor.Components.Overlay

<div class="tm-view-manager">
    <button type="button" id="@_toggleId" @ref="_toggleRef" data-tm-id="@_toggleId" class="tm-btn tm-btn-outline @(Compact ? "tm-btn-sm" : null) tm-view-manager-toggle"
            aria-expanded="@(_isOpen ? "true" : "false")" aria-haspopup="dialog"
            title="@ToggleTitle" @onclick="ToggleDropdownAsync">
        <TmIcon Name="view-list" />
        <span class="@(ShowActiveViewName && _activeView is not null ? "tm-view-manager-toggle-name" : null)">@(ShowActiveViewName && _activeView is not null ? _activeView.Name : Loc["TmViewManager_Views"])</span>
        <TmIcon Name="chevron-down" />
    </button>

    <TmOverlayPanel Anchor="_toggleRef"
                    IsOpen="_isOpen"
                    IsOpenChanged="SetOpen"
                    Placement="OverlayPlacement.Bottom"
                    Align="OverlayAlign.End"
                    Role="dialog"
                    Title="@Loc["TmViewManager_Views"]"
                    Class="tm-view-manager-panel">
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="tm-view-error" role="alert">@_errorMessage</div>
            }

            @* Personal Views Section *@
            <div class="tm-view-section">
                <div class="tm-view-section-header">
                    <TmIcon Name="user" Size="IconSize.Sm" />
                    <span>@(Loc["TmViewManager_PersonalViews"])</span>
                </div>
                <div class="tm-view-list">
                    @foreach (var view in _views.Where(v => v.Scope == ViewScope.Personal))
                    {
                        <div class="tm-view-item-row">
                            <button type="button" class="tm-view-item @(_activeView?.Id == view.Id ? "tm-view-item--active" : "")"
                                 aria-current="@(_activeView?.Id == view.Id ? "true" : null)"
                                 @onclick="() => ApplyViewAsync(view)">
                                <span class="tm-view-item-name" title="@view.Name">@view.Name</span>
                                @if (view.IsDefault)
                                {
                                    <span class="tm-view-item-badge" aria-hidden="true">★</span>
                                    <span class="tm-sr-only">@Loc["TmViewManager_DefaultView"]</span>
                                }
                            </button>
                            @if (AllowSetDefault && !view.IsDefault)
                            {
                                <button type="button" aria-label="@SetDefaultLabel(view)" class="tm-view-set-default-btn" @onclick="() => RequestSetDefaultAsync(view)"><TmIcon Name="star" Size="IconSize.Sm" /></button>
                            }
                            @if (CanEditView(view))
                            {
                                <button type="button" class="tm-view-edit-btn" aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Loc["TmViewManager_EditNamed"], view.Name)" @onclick="() => OpenEditModal(view)">
                                    <TmIcon Name="edit" Size="IconSize.Sm" />
                                </button>
                            }
                            @if (CanDeleteView(view))
                            {
                                <button type="button" class="tm-view-delete-btn" aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Loc["TmViewManager_DeleteNamed"], view.Name)" @onclick="() => DeleteViewAsync(view)">
                                    <TmIcon Name="trash" Size="IconSize.Sm" />
                                </button>
                            }
                        </div>
                    }
                    @if (!_views.Any(v => v.Scope == ViewScope.Personal))
                    {
                        <div class="tm-empty-state tm-view-empty">
                            @(Loc["TmViewManager_NoPersonalViews"])
                        </div>
                    }
                </div>
            </div>

            @* Tenant Views Section *@
            @if (_views.Any(v => v.Scope == ViewScope.Tenant) || CanCreateTenantViews)
            {
                <div class="tm-view-section">
                    <div class="tm-view-section-header">
                        <TmIcon Name="building" Size="IconSize.Sm" />
                        <span>@(Loc["TmViewManager_TenantViews"])</span>
                    </div>
                    <div class="tm-view-list">
                        @foreach (var view in _views.Where(v => v.Scope == ViewScope.Tenant))
                        {
                            <div class="tm-view-item-row">
                                <button type="button" class="tm-view-item @(_activeView?.Id == view.Id ? "tm-view-item--active" : "")"
                                     aria-current="@(_activeView?.Id == view.Id ? "true" : null)"
                                     @onclick="() => ApplyViewAsync(view)">
                                    <span class="tm-view-item-name" title="@view.Name">@view.Name</span>
                                    @if (view.IsDefault)
                                    {
                                        <span class="tm-view-item-badge" aria-hidden="true">★</span>
                                        <span class="tm-sr-only">@Loc["TmViewManager_DefaultView"]</span>
                                    }
                                </button>
                                @if (AllowSetDefault && !view.IsDefault)
                                {
                                    <button type="button" aria-label="@SetDefaultLabel(view)" class="tm-view-set-default-btn" @onclick="() => RequestSetDefaultAsync(view)"><TmIcon Name="star" Size="IconSize.Sm" /></button>
                                }
                                @if (CanEditView(view))
                                {
                                    <button type="button" class="tm-view-edit-btn" aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Loc["TmViewManager_EditNamed"], view.Name)" @onclick="() => OpenEditModal(view)">
                                        <TmIcon Name="edit" Size="IconSize.Sm" />
                                    </button>
                                }
                                @if (CanDeleteView(view))
                                {
                                    <button type="button" class="tm-view-delete-btn" aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Loc["TmViewManager_DeleteNamed"], view.Name)" @onclick="() => DeleteViewAsync(view)">
                                        <TmIcon Name="trash" Size="IconSize.Sm" />
                                    </button>
                                }
                            </div>
                        }
                        @if (!_views.Any(v => v.Scope == ViewScope.Tenant))
                        {
                            <div class="tm-empty-state tm-view-empty">
                                @(Loc["TmViewManager_NoTenantViews"])
                            </div>
                        }
                    </div>
                </div>
            }

            @* Footer Actions *@
            <div class="tm-view-manager-footer">
                <button type="button" class="tm-btn tm-btn-primary tm-btn-sm tm-btn-block" @onclick="OpenCreateModal">
                    <TmIcon Name="plus" Size="IconSize.Sm" />
                    <span>@(Loc["TmViewManager_CreateNew"])</span>
                </button>
                @if (GetCurrentView != null)
                {
                    <button type="button" class="tm-btn tm-btn-secondary tm-btn-sm tm-btn-block tm-mt-2" @onclick="CreateViewFromCurrentAsync">
                        <TmIcon Name="duplicate" Size="IconSize.Sm" />
                        <span>@Loc["TmViewManager_SaveCurrent"]</span>
                    </button>
                }
            </div>
    </TmOverlayPanel>
</div>

@* The create/edit view dialog. TmModal gives it the sheet presentation on a mobile viewport, the
   focus trap and the sticky footer; the inner markup stays so the form's own classes keep working. *@
<TmModal Show="_showModal"
         Title="@(_saveCurrent ? Loc["TmViewManager_SaveCurrentTitle"] : _editingView == null ? Loc["TmViewManager_CreateTitle"] : Loc["TmViewManager_EditTitle"])"
         OnClose="CloseModal"
         ShowFooter="true"
         ShowCloseButton="true"
         InitialFocusTargetId="@_nameId"
         RestoreFocusTargetId="@_toggleId"
         MobilePresentation="MobilePresentation.Auto">
    <ChildContent>
        <div class="tm-view-modal">
                @if (_saveCurrent)
                {
                    <p class="tm-view-modal-helper">@Loc["TmViewManager_SaveCurrentHelper"]</p>
                }
                @* View Name *@
                <div class="tm-form-group tm-mb-4">
                    <label for="@_nameId" class="tm-form-label">@(Loc["TmViewManager_ViewName"])</label>
                    <TmTextInput Id="@_nameId" data-tm-id="@_nameId" @bind-Value="_viewName"
                                 Placeholder="@(Loc["TmViewManager_NamePlaceholder"])" />
                </div>

                @* Scope Selection *@
                <div class="tm-form-group tm-mb-4">
                    <label class="tm-form-label">@(Loc["TmViewManager_Visibility"])</label>
                    <div class="tm-view-radio-group">
                        <label class="tm-view-radio-label">
                            <input type="radio" name="@($"tm-view-scope-{_instanceId}")" value="Personal"
                                   checked="@(_viewScope == ViewScope.Personal)"
                                   @onchange="() => _viewScope = ViewScope.Personal" />
                            <span>@(Loc["TmViewManager_Personal"])</span>
                        </label>
                        @if (CanCreateTenantViews)
                        {
                            <label class="tm-view-radio-label">
                                <input type="radio" name="@($"tm-view-scope-{_instanceId}")" value="Tenant"
                                       checked="@(_viewScope == ViewScope.Tenant)"
                                       @onchange="() => _viewScope = ViewScope.Tenant" />
                                <span>@(Loc["TmViewManager_Tenant"])</span>
                            </label>
                        }
                    </div>
                </div>

                @* Column Selection *@
                <div class="tm-form-group tm-mb-4">
                    <label class="tm-form-label">
                        @(Loc["TmViewManager_Columns"])
                        <span class="tm-text-secondary">(@_selectedColumns.Count / @AvailableColumns.Count)</span>
                    </label>
                    <div class="tm-view-columns-list">
                        @foreach (var col in AvailableColumns)
                        {
                            <label class="tm-view-column-item">
                                <input type="checkbox"
                                       checked="@_selectedColumns.Contains(col.Key)"
                                       @onchange="e => ToggleColumn(col.Key, (bool)e.Value!)" />
                                <span>@col.Title</span>
                            </label>
                        }
                    </div>
                </div>

                @* Grouping Columns *@
                @if (AvailableGroupableColumns?.Count > 0)
                {
                    <div class="tm-form-group tm-mb-4">
                        <label class="tm-form-label">@(Loc["TmViewManager_Grouping"])</label>
                        <div class="tm-view-group-columns">
                            @foreach (var col in AvailableGroupableColumns)
                            {
                                <label class="tm-view-column-item">
                                    <input type="checkbox"
                                           checked="@_selectedGroupColumns.Contains(col.Key)"
                                           @onchange="e => ToggleGroupColumn(col.Key, (bool)e.Value!)" />
                                    <span>@col.Title</span>
                                </label>
                            }
                        </div>
                    </div>
                }

                @* Filter Builder *@
                @if (FilterDefinitions?.Any() == true)
                {
                    <div class="tm-form-group">
                        <label class="tm-form-label">@(Loc["TmViewManager_Filters"])</label>
                        <TmFilterBuilder FilterDefinitions="FilterDefinitions"
                                         ActiveFilters="_viewFilters"
                                         OnFiltersChanged="f => _viewFilters = f.ToList()"
                                         DisplayResolver="DisplayResolver"
                                         ShowClearAll="true" />
                    </div>
                }
        </div>
    </ChildContent>
    <Footer>
        <div class="tm-view-modal-footer">
        <button type="button" class="tm-btn tm-btn-ghost" @onclick="CloseModal">
            @(Loc["TmViewManager_Cancel"])
        </button>
        <button type="button" class="tm-btn tm-btn-primary" @onclick="SaveViewAsync"
                disabled="@(string.IsNullOrWhiteSpace(_viewName) || !_selectedColumns.Any())">
            @(_saveCurrent
                ? Loc["TmViewManager_SaveAsCopy"]
                : _editingView == null
                ? (Loc["TmViewManager_Create"])
                : (Loc["TmViewManager_Save"]))
        </button>
        </div>
    </Footer>
</TmModal>
