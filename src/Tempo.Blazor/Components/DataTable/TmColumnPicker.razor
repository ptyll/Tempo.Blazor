@namespace Tempo.Blazor.Components.DataTable
@using Tempo.Blazor.Components.Overlay

<div class="tm-column-picker @Class @(Disabled ? "tm-column-picker-disabled" : "")" @attributes="AdditionalAttributes">
    <button id="@(_open ? _toggleId : null)" class="tm-column-picker-toggle tm-btn tm-btn-outline tm-btn-sm"
            type="button"
            @ref="_toggleRef"
            aria-haspopup="true"
            aria-expanded="@_open.ToString().ToLowerInvariant()"
            aria-label="@(IconOnly ? Loc["TmDataTable_ColumnPicker"] : null)"
            title="@(IconOnly ? Loc["TmDataTable_ColumnPicker"] : null)"
            data-tm-toolbar-control="@(Toolbar is not null ? string.Empty : null)"
            @onclick="ToggleOpen">
        <span class="tm-icon-columns"><TmIcon Name="@IconNames.Columns" Size="IconSize.Sm" /></span>
        @* Inside a TmToolbar the label is wrapped in the text span (so the toolbar can hide it); outside one it
           stays the bare text node of the pre-toolbar markup (DataTable default-markup snapshots stay identical). *@
        @(Toolbar is null && !IconOnly ? Loc["TmDataTable_ColumnPicker"] : null)
        @if (Toolbar is not null && !IconOnly)
        {
            <span class="tm-toolbar-btn-text">@Loc["TmDataTable_ColumnPicker"]</span>
        }
    </button>

    @* The panel is a TmOverlayPanel: popover="manual" puts it in the browser top layer (no
       ancestor overflow can clip it), overlay.js anchors and flips it, and Escape or an outside
       pointerdown closes it. On a narrow viewport it presents as a content-height bottom sheet
       titled with the localized column-picker label. *@
    <TmOverlayPanel Anchor="_toggleRef"
                    IsOpen="_open"
                    IsOpenChanged="SetOpen"
                    Placement="OverlayPlacement.Bottom"
                    Align="OverlayAlign.End"
                    Role="dialog"
                    Title="@Loc["TmDataTable_ColumnPicker"]"
                    AriaLabel="@Loc["TmDataTable_ColumnPicker"]"
                    MobilePresentation="PanelPresentation.Auto"
                    Class="tm-column-picker-panel">
        <div class="tm-column-picker-items">
            @foreach (var col in Columns.Where(c => c.IsHideable))
            {
                <label class="tm-column-picker-item">
                    <input type="checkbox"
                           data-key="@col.Key"
                           checked="@col.IsVisible"
                           @onchange="() => Toggle(col.Key)" />
                    <span>@col.Title</span>
                </label>
            }
        </div>
        <div class="tm-column-picker-footer">
            <button class="tm-column-picker-reset tm-link-button"
                    type="button"
                    @onclick="Reset">
                @Loc["TmDataTable_ResetColumns"]
            </button>
        </div>
    </TmOverlayPanel>
</div>

@code {
    [Parameter] public IReadOnlyList<ColumnVisibilityItem> Columns { get; set; } = [];
    [Parameter] public EventCallback<string> OnToggleColumn { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Renders the toggle as an icon only (the localized label stays its accessible name and tooltip) - for a
    /// toolbar that shows no button text. Default <see langword="false"/> keeps the text.
    /// </summary>
    [Parameter] public bool IconOnly { get; set; }

    /// <summary>The toolbar the picker sits in, if any: the toggle then joins the toolbar's roving tab stop (with or without its label).</summary>
    [CascadingParameter] private Tempo.Blazor.Components.Toolbar.TmToolbar? Toolbar { get; set; }

    /// <summary>Additional CSS class(es).</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string _toggleId = $"tm-column-picker-{Guid.NewGuid():N}";
    private bool _open;
    private ElementReference _toggleRef;

    /// <summary>
    /// Opens the panel. The field is what <c>TmOverlayPanel</c> reads, and a caller invoking this
    /// from outside a render (a parent, a test) has no render of its own, so the method requests one.
    /// </summary>
    public void Open()
    {
        _open = true;
        StateHasChanged();
    }

    private void ToggleOpen() => _open = !_open;

    /// <summary>The overlay reports its own close (Escape, outside press); the field must follow.</summary>
    private void SetOpen(bool open) => _open = open;

    private Task Toggle(string key) => OnToggleColumn.InvokeAsync(key);

    private async Task Reset()
    {
        _open = false;
        await OnReset.InvokeAsync();
    }
}
