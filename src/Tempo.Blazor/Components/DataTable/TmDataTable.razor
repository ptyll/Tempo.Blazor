@namespace Tempo.Blazor.Components.DataTable
@inherits Tempo.Blazor.Components.TmComponentBase
@typeparam TItem
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.DataDisplay
@using Tempo.Blazor.Components.Inputs
@using Tempo.Blazor.Components.Filters
@using Tempo.Blazor.Components.Forms
@using Tempo.Blazor.Components.Dropdowns
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Components.Overlay
@using Tempo.Blazor.Interfaces
@using Tempo.Blazor.Models
@using Tempo.Blazor.Services

@* Hidden container to trigger TmDataTableColumn registration via CascadingValue. *@
<CascadingValue Value="this" IsFixed="true">
    <span style="display:none" aria-hidden="true">@ChildContent</span>
</CascadingValue>

<div class="@RootCssClass" @ref="_wrapperRef" @attributes="AdditionalAttributes">

    @* ── Toolbar ─────────────────────────────────────────────── *@
    @if (ShowToolbar && HasVisibleToolbarControls())
    {
        <div class="tm-data-table-toolbar">
            @* Left: Search (main action) *@
            @if (ShouldRenderSearch())
            {
                <div class="tm-data-table-toolbar-left">
                    <TmSearchInput Value="@_searchText"
                                   ValueChanged="OnSearchChangedAsync"
                                   Placeholder="@Loc["TmDataTable_SearchPlaceholder"]" />
                </div>
            }

            @* Right: Actions (column picker, view manager) *@
            <div class="tm-data-table-toolbar-right">
                @if (ShouldRenderColumnPicker())
                {
                    <TmColumnPicker @ref="_columnPicker" Columns="@GetColumnVisibilityItems()"
                                    OnToggleColumn="OnToggleColumnAsync"
                                    OnReset="OnResetColumnsAsync" />
                }
                @if (ShouldRenderViewManager())
                {
                    <TmViewManager Provider="ViewProvider"
                                   ViewContext="@ViewContext"
                                   Compact="@IsRedesigned"
                                   MobilePresentation="@(MobileLayout != DataTableMobileLayout.None ? PanelPresentation.Auto : PanelPresentation.Popover)"
                                   ShowActiveViewName="@ShowActiveViewName"
                                   AllowSetDefault="@AllowSetDefault"
                                   OnSetDefault="@OnSetDefault"
                                   OnViewApplied="ApplyViewAsync"
                                   GetCurrentView="GetCurrentView"
                                   GetCurrentFilters="() => _externalFilters"
                                   AvailableColumns="GetAvailableColumns()"
                                    AvailableGroupableColumns="GetAvailableGroupableColumns()"
                                   FilterDefinitions="ViewFilterDefinitions"
                                   DisplayResolver="DisplayResolver"
                                   CanCreateTenantViews="ViewCanCreateTenantViews"
                                   CurrentUserId="CurrentUserId"
                                   CurrentTenantId="CurrentTenantId" />
                }
                @if (ShouldRenderMobileSort())
                {
                    @* Hidden until the container is narrow (tm-data-table-mobile-only). The header is
                       display:none there, so this dropdown is the only sort surface. *@
                    <TmDropdown Text="@Loc["TmDataTable_MobileSort"]"
                                Class="tm-data-table-cards-toolbar__sort tm-data-table-mobile-only"
                                OutlineTrigger="true"
                                MobilePresentation="PanelPresentation.Auto"
                                OnSelect="OnCardSortSelectedAsync">
                        @foreach (var col in CardsSortableColumns)
                        {
                            <TmDropdownItem Value="@($"{col.Key}|asc")" Checked="@IsCardSortChecked(col, descending: false)">
                                @* The menu sits under a button already labelled "Sort", so the items carry
                                   only the column and the direction — repeating the verb in every entry
                                   doubled the list's length for scanning and for screen readers. *@
                                @Loc["TmDataTable_MobileSortAscending", col.Title]
                            </TmDropdownItem>
                            <TmDropdownItem Value="@($"{col.Key}|desc")" Checked="@IsCardSortChecked(col, descending: true)">
                                @Loc["TmDataTable_MobileSortDescending", col.Title]
                            </TmDropdownItem>
                        }
                        <TmDropdownItem Value="@("clear")">@Loc["TmDataTable_ColumnMenu_ClearSort"]</TmDropdownItem>
                    </TmDropdown>
                }
                @if (ShouldRenderMobileFilters())
                {
                    <button type="button" @ref="_cardsFilterTrigger" class="tm-btn tm-btn-outline tm-btn-sm tm-data-table-cards-toolbar__filter tm-data-table-mobile-only"
                            aria-haspopup="dialog" aria-expanded="@(_cardsFilterOpen ? "true" : "false")"
                            @onclick="OpenCardsFilterAsync">
                        @Loc.Plural("TmDataTable_MobileFilters", ActiveCardFilterCount)
                    </button>
                }
                @if (ShouldRenderExport())
                {
                    <div class="tm-data-table__export">
                        <TmDropdown Text="@(_isExporting ? Loc["TmDataTable_Exporting"] : Loc["TmDataTable_Export"])"
                                    Icon="@IconNames.Download"
                                    OutlineTrigger="@IsRedesigned"
                                    Disabled="_isExporting"
                                    Class="tm-data-table__export-control"
                                    Align="OverlayAlign.End"
                                    Offset="4"
                                     MobilePresentation="@(MobileLayout != DataTableMobileLayout.None ? PanelPresentation.Auto : PanelPresentation.Popover)"
                                    OnSelect="HandleExportSelectionAsync">
                            @if (ShowsExportScope)
                            {
                                <div role="group" aria-label="@Loc["TmDataTable_ExportScope"]">
                                    <TmDropdownItem Value="scope-all"
                                                    Checked="@(_exportScope == DataTableExportScope.All)"
                                                    KeepOpen="true"
                                                    Class="@ExportScopeItemClass(DataTableExportScope.All)"
                                                    AdditionalAttributes="@(new Dictionary<string, object> { ["data-export-scope"] = "all" })">
                                        <span class="tm-data-table__export-label">@Loc.Plural("TmDataTable_ExportScopeAllCount", ExportAllCount)</span>
                                        <span class="tm-data-table__export-description">@Loc["TmDataTable_ExportScopeAllDescription"]</span>
                                    </TmDropdownItem>
                                    <TmDropdownItem Value="scope-selected"
                                                    Checked="@(_exportScope == DataTableExportScope.Selected)"
                                                    AriaDisabled="@(_selectedItems.Count == 0)"
                                                    KeepOpen="true"
                                                    Class="@ExportScopeItemClass(DataTableExportScope.Selected)"
                                                    AdditionalAttributes="@ExportSelectedAttributes()">
                                        <span class="tm-data-table__export-label">@ExportSelectedLabel()</span>
                                        <span id="@(_selectedItems.Count == 0 ? _exportScopeEmptyId : null)" class="tm-data-table__export-description">@(_selectedItems.Count == 0 ? Loc["TmDataTable_ExportScopeSelectedEmpty"] : Loc["TmDataTable_ExportScopeSelectedDescription"])</span>
                                    </TmDropdownItem>
                                </div>
                                <div class="tm-dropdown-sep" role="separator"></div>
                            }
                            @if (IsRedesigned)
                            {
                                <TmDropdownItem Value="csv"
                                                Icon="@IconNames.FileText"
                                                Class="tm-data-table__export-item tm-data-table__export-item--rich"
                                                AdditionalAttributes="@(new Dictionary<string, object> { ["data-export-format"] = "csv" })">
                                    <span class="tm-data-table__export-label">@Loc["TmDataTable_ExportCsvShort"]</span>
                                    <span class="tm-data-table__export-description">@Loc["TmDataTable_ExportCsvDescription"]</span>
                                </TmDropdownItem>
                                @if (XlsxExporter is not null)
                                {
                                    <TmDropdownItem Value="xlsx"
                                                    Icon="@IconNames.Table"
                                                    Class="tm-data-table__export-item tm-data-table__export-item--rich"
                                                    AdditionalAttributes="@(new Dictionary<string, object> { ["data-export-format"] = "xlsx" })">
                                        <span class="tm-data-table__export-label">@Loc["TmDataTable_ExportXlsxShort"]</span>
                                        <span class="tm-data-table__export-description">@Loc["TmDataTable_ExportXlsxDescription"]</span>
                                    </TmDropdownItem>
                                }
                            }
                            else
                            {
                                <TmDropdownItem Value="csv"
                                                Class="tm-data-table__export-item"
                                                AdditionalAttributes="@(new Dictionary<string, object> { ["data-export-format"] = "csv" })">
                                    @Loc["TmDataTable_ExportCsv"]
                                </TmDropdownItem>
                                @if (XlsxExporter is not null)
                                {
                                    <TmDropdownItem Value="xlsx"
                                                    Class="tm-data-table__export-item"
                                                    AdditionalAttributes="@(new Dictionary<string, object> { ["data-export-format"] = "xlsx" })">
                                        @Loc["TmDataTable_ExportXlsx"]
                                    </TmDropdownItem>
                                }
                            }
                        </TmDropdown>
                    </div>
                }
            </div>
        </div>
    }

    @* ── External Filter Builder (when table has views) ────── *@
    @if (ShouldRenderExternalFilterBuilder())
    {
        <div class="tm-data-table-external-filters" @key="_activeViewId">
            <TmFilterBuilder FilterDefinitions="ExternalFilterDefinitions"
                             ActiveFilters="_externalFilters"
                             OnFiltersChanged="OnExternalFiltersChanged"
                             DisplayResolver="DisplayResolver"
                             ShowResultPreview="ShowFilterResultPreview"
                             ResultCountProvider="ResultCountProvider"
                             ResultCountKey="_resultCountVersion"
                             ShowClearAll="true" />
        </div>
    }

    @if (ShouldRenderFilterSummary() && _activeFilters.Count > 0)
    {
        <div class="tm-data-table-filter-summary">
            <span role="status" aria-live="polite">@Loc.Plural("TmDataTable_ActiveFilters", _activeFilters.Count)</span>
            <button type="button" class="tm-link-button" @onclick="ClearAllFiltersAsync">@Loc["TmDataTable_ClearFilters"]</button>
        </div>
    }
    @if (ShouldRenderFilterSummary())
    {
        @* Always present so the first filter change is announced too: a live region that is added to
           the page together with its text is often not spoken at all. *@
        <div class="tm-data-table-filter-summary-live tm-sr-only" role="status" aria-live="polite">@FilterSummaryAnnouncement</div>
    }

    @* ── Selection bar ────────────────────────────────────────── *@
    @if (_selectedItems.Count > 0)
    {
        <div class="tm-data-table-selection-bar">
            <span>@Loc.Plural("TmDataTable_BulkActions", _selectedItems.Count)</span>
            <button class="tm-link-button" type="button" @onclick="DeselectAllAsync">
                @Loc["TmDataTable_DeselectAll"]
            </button>
            @SelectionActions
        </div>
    }

    @* ── Grouping drop zone ────────────────────────────────────── *@
    @if (ShowGrouping)
    {
        <div class="tm-data-table-group-zone @(IsRedesigned ? "tm-data-table-group-zone--card" : null) @(_isDragOver ? "tm-data-table-group-zone--dragover" : "")"
             @ondragover="HandleGroupZoneDragOver"
             @ondragover:preventDefault="true"
             @ondrop="HandleGroupZoneDrop"
             @ondragenter="() => _isDragOver = true"
             @ondragleave="() => _isDragOver = false">
            @if (IsRedesigned)
            {
                <span class="tm-data-table-group-label-prefix">@Loc["TmDataTable_GroupBy"]</span>
            }
            @if (ShouldRenderAddGrouping())
            {
                <TmDropdown Text="@Loc["TmDataTable_AddGrouping"]" Class="tm-data-table-add-grouping" OnSelect="AddGroupColumn">
                    @foreach (var groupable in _columns.Where(c => c.Groupable && !_groupByColumns.Contains(c.Key)))
                    {
                        <TmDropdownItem Value="@groupable.Key">@groupable.Title</TmDropdownItem>
                    }
                </TmDropdown>
            }
            @if (_groupByColumns.Count == 0)
            {
                <span class="tm-data-table-group-placeholder">@Loc["TmDataTable_GroupDropPlaceholder"]</span>
            }
            else
            {
                @for (var i = 0; i < _groupByColumns.Count; i++)
                {
                    var index = i;
                    var colKey = _groupByColumns[i];
                    var col = _columns.FirstOrDefault(c => c.Key == colKey);
                    <div class="tm-data-table-group-chip"
                         draggable="true"
                         @ondragstart="() => OnChipDragStart(index)"
                         @ondrop="() => OnChipDrop(index)"
                         @ondragover:preventDefault="true">
                        <span>@(col?.Title ?? colKey)</span>
                        <button type="button"
                                class="tm-data-table-group-chip-remove"
                                aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Loc["TmDataTable_RemoveGrouping"], col?.Title ?? colKey)"
                                @onclick="() => HandleRemoveGroupChip(colKey)">
                            <TmIcon Name="@IconNames.X" Size="IconSize.Sm" />
                        </button>
                    </div>
                }
                <div class="tm-data-table-group-actions">
                    <button type="button" class="@(IsRedesigned ? "tm-link-button " : null)tm-data-table-group-expand-all"
                            @onclick="ExpandAllGroups">@Loc["TmDataTable_ExpandAll"]</button>
                    <button type="button" class="@(IsRedesigned ? "tm-link-button " : null)tm-data-table-group-collapse-all"
                            @onclick="CollapseAllGroups">@Loc["TmDataTable_CollapseAll"]</button>
                </div>
            }
        </div>
    }

    @* ── Cards filter sheet ───────────────────────────────────── *@
    @* The sort control is a TmDropdown inside the toolbar. The filter sheet stays here because it
       carries its own fields; the toolbar button opens it, and so does the column menu's Filter item. *@
    @if (ShouldRenderMobileFilters())
    {
        @* The sheet input gets its own id family (CardsFilterId): the header filter row stays in the
           DOM (only display:none) while the sheet is open, so reusing ColumnFilterId here would put
           the same id on two elements and could point TmFormField's label at the hidden header input. *@
        <TmOverlayPanel @ref="_cardsSheet" Anchor="_cardsFilterTrigger" IsOpen="_cardsFilterOpen" IsOpenChanged="SetCardsFilterOpenAsync"
                        Placement="OverlayPlacement.Bottom" Align="OverlayAlign.Start" Offset="4"
                        MobilePresentation="PanelPresentation.Auto" Role="dialog"
                        AriaLabel="@Loc.Plural("TmDataTable_MobileFilters", ActiveCardFilterCount)"
                        Title="@Loc.Plural("TmDataTable_MobileFilters", ActiveCardFilterCount)"
                        Class="tm-data-table-cards-sheet">
            @foreach (var col in CardsFilterableColumns)
            {
                <TmFormField Label="@col.Title" For="@CardsFilterId(col.Key)">
                    <TmColumnFilter ColumnKey="@col.Key"
                                    InputId="@CardsFilterId(col.Key)"
                                    ColumnTitle="@col.Title"
                                    FilterType="@col.FilterType"
                                    FilterOptions="@col.FilterOptions"
                                    FilterOperator="@col.FilterOperator"
                                    Value="@ColumnFilterValue(col.Key)"
                                    OnFilterChange="f => ApplyFilterAsync(col.Key, f)" />
                </TmFormField>
            }
            <div class="tm-data-table-cards-sheet__footer">
                <button type="button" class="tm-btn tm-btn-outline" @onclick="ClearAllFiltersAsync">
                    @Loc["TmDataTable_ClearAll"]
                </button>
                @* The sheet presentation already carries a Done button in the drawer header; rendering
                   the footer's one too put two identical "Done" controls on a phone. The footer Done
                   exists only for the anchored popover. *@
                @if (_cardsSheet is null || !_cardsSheet.IsSheet)
                {
                    <button type="button" class="tm-btn tm-btn-primary tm-data-table-cards-sheet__done" @onclick="() => SetCardsFilterOpenAsync(false)">
                        @Loc["Tm_Done"]
                    </button>
                }
            </div>
        </TmOverlayPanel>
    }

    @* ── Table ────────────────────────────────────────────────── *@
    <div class="@GetScrollContainerClass()" style="@GetScrollContainerStyle()">
        <table class="tm-data-table" role="grid" aria-rowcount="@(IsGrid ? GridAriaRowCount : null)" aria-colcount="@(IsGrid ? GridColumnCount : null)" @ref="_tableRef">
            @if (_visibleColumns.Count > 0 || Selectable)
            {
                <thead>
                    <tr role="@(IsGrid ? "row" : null)" aria-rowindex="@(IsGrid ? 1 : null)">
                        @if (HasDetail)
                        {
                            <th class="tm-col-expander" aria-hidden="@(GridHeaderIsActive ? null : "true")" role="@(GridHeaderIsActive ? "columnheader" : null)" aria-colindex="@(GridHeaderIsActive ? 1 : null)" tabindex="@(GridHeaderIsActive ? HeaderTabIndex(0) : null)" @onkeydown="@(GridHeaderIsActive ? EventCallback.Factory.Create<KeyboardEventArgs>(this, e => HandleGridHeaderKeyDownAsync(e, 0)) : default)" @onkeydown:stopPropagation="@GridHeaderIsActive"></th>
                        }
                        @if (Selectable)
                        {
                            var selectCol = HasDetail ? 1 : 0;
                            <th class="tm-col-check @(IsResponsiveScroll ? "tm-col-check--mobile-pinned" : null)" role="@(GridHeaderIsActive ? "columnheader" : null)" aria-colindex="@(GridHeaderIsActive ? selectCol + 1 : null)" tabindex="@(GridHeaderIsActive ? HeaderTabIndex(selectCol) : null)" @onkeydown="@(GridHeaderIsActive ? EventCallback.Factory.Create<KeyboardEventArgs>(this, e => HandleGridHeaderKeyDownAsync(e, selectCol)) : default)" @onkeydown:stopPropagation="@GridHeaderIsActive">
                                <input type="checkbox"
                                       @ref="_selectAllRef"
                                       aria-label="@Loc["TmDataTable_SelectAll"]"
                                       checked="@IsAllSelected"
                                       @onchange="ToggleSelectAllAsync" />
                            </th>
                        }
                        @{ var headerCol = GridDefaultColumn; }
                        @foreach (var col in _renderedCellColumns)
                        {
                            var thisHeaderCol = headerCol++;
                            @* A sortable header's control is a real <button> inside the <th>, not the <th>
                               itself. On a <button> BOTH Enter and Space are native activation — Space
                               included, because a button's default for Space is "click", where on the plain
                               <th tabindex="0"> it stayed "scroll one screen" and Blazor could not cancel
                               that default for one key only. The button wraps only the label and the sort
                               icon: the consumer's HeaderTemplate, the pin toggle and the resize handle
                               stay SIBLINGS of it, because interactive content cannot nest inside a
                               <button> (invalid HTML — the reason 2.8.x refused to wrap the whole header).
                               Clicking anywhere else in the header still sorts through the <th>'s own
                               @onclick — the mouse path is unchanged; the button adds the keyboard one.
                               A header that offers ONLY the pin keeps <th tabindex="0"> as its stop, as
                               2.8.22 established; a sortable header's stop is its button. *@
                            <th class="@GetHeaderClass(col)"
                                style="@GetColumnStyle(col)"
                                data-sortable="@col.Sortable.ToString().ToLower()"
                                role="@(GridHeaderIsActive ? "columnheader" : null)"
                                aria-colindex="@(GridHeaderIsActive ? thisHeaderCol + 1 : null)"
                                tabindex="@(GridHeaderIsActive ? HeaderTabIndex(thisHeaderCol) : IsPinOnlyHeader(col) ? "0" : null)"
                                @onkeydown:stopPropagation="@GridHeaderIsActive"
                                draggable="@(col.Groupable ? "true" : "false")"
                                aria-sort="@GetAriaSortValue(col)"
                                aria-keyshortcuts="@HeaderKeyShortcuts(col)"
                                @ondragstart="() => OnColumnDragStart(col.Key)"
                                @ondragend="OnColumnDragEnd"
                                @onkeydown="e => GridHeaderIsActive ? HandleGridHeaderKeyDownAsync(e, thisHeaderCol) : HandleHeaderKeyDownAsync(e, col)"
                                @onclick="e => SortByAsync(col, HeaderClickRequestsMultiSort(e))">
                                @if (col.HeaderTemplate is not null)
                                {
                                    @* The consumer's own controls live in here, and keydown BUBBLES: without
                                       this barrier every letter typed into a filter box inside the header
                                       reached the header's own key handler, so "prague" pinned and unpinned
                                       the column three times. WCAG 2.1.4 allows a single-character
                                       shortcut only while the component itself has focus, and focus on a
                                       DESCENDANT is not that.
                                       The barrier is STATELESS on purpose. 2.8.23 first shipped a flag set
                                       here and cleared by the header's own handler, which never ran for an
                                       intercepted key — so the flag survived and the user's NEXT genuine
                                       press on the header was spent clearing it. `:stopPropagation` carries
                                       nothing between events and cannot have that failure mode.
                                       IT NEEDS THE EMPTY HANDLER NEXT TO IT. The flag alone was measured
                                       NOT to stop the bubble: a dispatcher visits an ancestor because it
                                       has a handler there, and reads the propagation flag while it is
                                       visiting. With no handler the element is never visited and the flag
                                       is never read. `SwallowTemplateKey` does nothing and exists only to
                                       make this element a stop on the path.
                                       Only KEYDOWN is stopped: clicking a templated header has always
                                       sorted and still does — the click bubbles to the <th>. *@
                                    <span class="tm-col-header-content" @onkeydown="SwallowTemplateKey" @onkeydown:stopPropagation="true">
                                        @col.HeaderTemplate
                                    </span>
                                }
                                @if (col.Sortable)
                                {
                                    @* type="button" matters: inside a consumer's <form> the default
                                       type="submit" would submit the form on every sort. The button carries
                                       no @onclick of its own — its native click bubbles to the <th>, so
                                       Enter, Space and the mouse all take the same single path and a key
                                       can never double-fire a sort the way an explicit keydown handler did.
                                       The aria-label is emitted unconditionally: a control's name is a
                                       guarantee of the markup, not a side effect of which content path
                                       happened to render. It announces "Sort by {header}" PLUS the state
                                       the next activation reaches — ascending / descending / cleared —
                                       so the spoken name tracks the same tri-state cycle activation walks.
                                       The header text is the column Title, then SortLabel; a templated
                                       header with neither fails fast in DEBUG and falls back to a
                                       localized positional name in RELEASE. *@
                                    <button type="button"
                                            class="tm-th-sort"
                                            aria-label="@SortButtonAccessibleName(col)"
                                            title="@Loc["TmDataTable_MultiSortHint"]"
                                            aria-keyshortcuts="@HeaderKeyShortcuts(col)">
                                        @if (col.HeaderTemplate is null)
                                        {
                                            <span>@col.Title</span>
                                        }
                                        <span class="tm-sort-icon @GetSortIconClass(col)" aria-hidden="true"></span>
                                        @if (_sortDescriptors.Count > 1 && GetColumnSortIndex(col.Key) >= 0)
                                        {
                                            <span class="tm-sort-order" aria-hidden="true">@(GetColumnSortIndex(col.Key) + 1)</span>
                                        }
                                    </button>
                                }
                                else if (col.HeaderTemplate is null)
                                {
                                    <span>@col.Title</span>
                                }
                                @if (ShowColumnMenu && ColumnMenuMode == ColumnMenuMode.Menu)
                                {
                                    @* Menu mode replaces the standalone pin button: the same affordances
                                       live in one menu per data header, reached with M (see
                                       HandleHeaderKeyDownAsync). The trigger reference is captured into a
                                       per-column box, so each header anchors its own menu. *@
                                    var menu = ColumnMenuOf(col.Key);
                                    <button type="button"
                                            @ref="menu.Trigger.Current"
                                            tabindex="-1"
                                            class="tm-data-table-col-menu tm-data-table-col-menu-btn @(menu.IsOpen ? "tm-data-table-col-menu--open" : null)"
                                            aria-label="@Loc["TmDataTable_ColumnMenuFor", ColumnAccessibleName(col)]"
                                            aria-haspopup="menu"
                                            aria-expanded="@(menu.IsOpen ? "true" : "false")"
                                            aria-controls="@(menu.IsOpen ? ColumnMenuId(col.Key) : null)"
                                            data-column-key="@col.Key"
                                            data-testid="@TestId($"col-menu-{col.Key}")"
                                            @onclick:stopPropagation="true"
                                            @onkeydown:stopPropagation="true"
                                            @onkeyup:stopPropagation="true"
                                            @onclick="() => ToggleColumnMenuAsync(col)">
                                        <TmIcon Name="@IconNames.MoreVertical" Size="IconSize.Sm" />
                                    </button>
                                    <TmOverlayPanel Anchor="menu.Trigger.Current"
                                                    IsOpen="menu.IsOpen"
                                                    IsOpenChanged="open => SetColumnMenuOpenAsync(col, open)"
                                                    OnOpened="FocusColumnMenuAsync"
                                                    Placement="OverlayPlacement.Bottom"
                                                    Align="OverlayAlign.End"
                                                    Offset="4"
                                                    Role="menu"
                                                    Id="@ColumnMenuId(col.Key)"
                                                    AriaLabel="@Loc["TmDataTable_ColumnMenuFor", ColumnAccessibleName(col)]"
                                                    Title="@ColumnAccessibleName(col)"
                                                    MobilePresentation="@(MobileLayout != DataTableMobileLayout.None ? PanelPresentation.Auto : PanelPresentation.Popover)"
                                                    Class="tm-data-table-col-menu-panel"
                                                    @onkeydown="e => OnColumnMenuKeyDownAsync(col, e)">
                                        @foreach (var action in ColumnMenuActions(col))
                                        {
                                            if (action == "separator")
                                            {
                                                <div class="tm-dropdown-sep" role="separator"></div>
                                                continue;
                                            }
                                            var isSortDirection = action is "sort-asc" or "sort-desc";
                                            var isCurrentSort = action == ColumnMenuCheckedAction(col);
                                            <button type="button"
                                                    class="tm-dropdown-item"
                                                    role="@(isSortDirection ? "menuitemradio" : "menuitem")"
                                                    aria-checked="@(isSortDirection ? (isCurrentSort ? "true" : "false") : null)"
                                                    tabindex="-1"
                                                    data-action="@action"
                                                    @onclick="() => RunColumnMenuActionAsync(col, action)"
                                                    @onclick:stopPropagation="true">
                                                @* The leading check slot is the sighted counterpart of
                                                   aria-checked (WCAG 1.3.1/1.4.1): it renders on EVERY
                                                   item — empty on the plain menuitems — so all labels
                                                   share one alignment edge (see _dropdown.css). *@
                                                <span class="tm-dropdown-item__check" aria-hidden="true">
                                                    @if (isSortDirection && isCurrentSort)
                                                    {
                                                        <TmIcon Name="@IconNames.Check" Size="IconSize.Sm" />
                                                    }
                                                </span>
                                                @Loc[ColumnMenuActionKey(action)]
                                            </button>
                                        }
                                    </TmOverlayPanel>
                                }
                                else if (ShowColumnMenu)
                                {
                                    @* tabindex="-1": the pin is reachable from its header with P, not as a
                                       stop of its own. As a sequential stop it cost one extra Tab per
                                       column — six columns were eleven stops — and painted nothing until
                                       the header was hovered. *@
                                    <button type="button"
                                            tabindex="-1"
                                            class="tm-col-pin-btn @(GetPin(col) != ColumnPin.None ? "tm-col-pin-btn--active" : "")"
                                            title="@Loc["TmDataTable_PinColumn"]"
                                            aria-label="@Loc["TmDataTable_PinColumn"]"
                                            data-testid="@TestId($"pin-{col.Key}")"
                                            @onclick:stopPropagation="true"
                                            @onkeydown:stopPropagation="true"
                                            @onclick="() => CyclePinAsync(col)">
                                        <span aria-hidden="true">@GetPinGlyph(col)</span>
                                    </button>
                                }
                                @if (col.Resizable)
                                {
                                    @* A keyboard-operable separator (WCAG 2.5.7): the drag runs in
                                       data-table.js over the shared pointer-drag helper (attached once
                                       per table on the first render); arrows / Home / End resize here
                                       and commit through SetColumnWidthAsync. @onkeydown:stopPropagation
                                       fences the <th>'s sort handler (a key must not BOTH resize and
                                       sort); the empty SwallowHandleClick next to @onclick:stopPropagation
                                       makes the barrier real — a stop without a handler is never visited
                                       by the dispatcher, so the tap's click would otherwise sort.
                                       valuenow/valuemin/valuemax are always emitted: a focusable
                                       separator announces its value. data-col-key / data-min-width are
                                       what the JS gesture reads on press. *@
                                    <span class="tm-col-resize-handle"
                                          data-testid="@TestId($"resize-{col.Key}")"
                                          data-col-key="@col.Key"
                                          data-min-width="@MinColumnWidth"
                                          role="separator"
                                          aria-orientation="vertical"
                                          tabindex="0"
                                          aria-valuenow="@(GetPixelWidth(col) ?? DefaultPinnedWidth)"
                                          aria-valuemin="@MinColumnWidth"
                                          aria-valuemax="@(Math.Max(MaxColumnWidth, GetPixelWidth(col) ?? DefaultPinnedWidth))"
                                          aria-label="@Loc["TmDataTable_ResizeColumn", ResizeHandleAccessibleName(col)]"
                                          @onclick="SwallowHandleClick"
                                          @onclick:stopPropagation="true"
                                          @onkeydown="e => OnResizeHandleKeyAsync(col, e)"
                                          @onkeydown:stopPropagation="true"></span>
                                }
                            </th>
                        }
                        @if (HasEditActions)
                        {
                            <th class="tm-data-table__edit-actions" aria-hidden="true"></th>
                        }
                    </tr>
                    @if (_hasFilterRow)
                    {
                        <tr class="tm-filter-row" role="@(IsGrid ? "row" : null)" aria-rowindex="@(IsGrid ? 2 : null)">
                            @if (HasDetail) { <th></th> }
                            @if (Selectable) { <th></th> }
                            @foreach (var col in _visibleColumns)
                            {
                                <th>
                                    @if (col.Filterable)
                                    {
                                        <TmColumnFilter ColumnKey="@col.Key"
                                                        InputId="@(ColumnMenuMode == ColumnMenuMode.Menu ? ColumnFilterId(col.Key) : null)"
                                                        ColumnTitle="@col.Title"
                                                        FilterType="@col.FilterType"
                                                        FilterOptions="@col.FilterOptions"
                                                        FilterOperator="@col.FilterOperator"
                                                        Value="@ColumnFilterValue(col.Key)"
                                                        OnFilterChange="f => ApplyFilterAsync(col.Key, f)" />
                                        @if (ShouldRenderFilterSummary() && _activeFilters.Count > 0 && col.Key == _lastFilterableColumnKey)
                                        {
                                            <button type="button" class="tm-col-filter-clear-all" @onclick="ClearAllFiltersAsync">
                                                @Loc["TmDataTable_ClearFilters"]
                                            </button>
                                        }
                                    }
                                </th>
                            }
                            @if (HasEditActions) { <th class="tm-data-table__edit-actions" aria-hidden="true"></th> }
                        </tr>
                    }
                </thead>
            }
            <tbody>
                @if (_isLoading || IsLoading)
                {
                    @* Skeleton rows instead of one colspan spinner cell: the auto table layout
                       measures one cell per column exactly as it will with data, so the column
                       widths no longer jump when the rows arrive. Decorative only — aria-hidden,
                       the surrounding busy state is announced elsewhere. *@
                    for (var skeletonRow = 0; skeletonRow < 4; skeletonRow++)
                    {
                        <tr class="tm-data-table-loading-row" aria-hidden="true">
                            @if (HasDetail)
                            {
                                <td class="tm-col-expander"></td>
                            }
                            @if (Selectable)
                            {
                                <td class="tm-col-check"></td>
                            }
                            @foreach (var col in _renderedCellColumns)
                            {
                                <td class="@GetCellClass(col)" style="@GetColumnStyle(col)">
                                    <TmSkeleton Variant="SkeletonVariant.Text" />
                                </td>
                            }
                            @if (HasEditActions)
                            {
                                <td class="tm-data-table__edit-actions"></td>
                            }
                        </tr>
                    }
                }
                else if (_groupByColumns.Count > 0 && _groupedData is not null)
                {
                    @* ── Grouped rendering ── *@
                    @if (_groupedData.Count == 0 && !string.IsNullOrEmpty(EmptyTitle))
                    {
                        <tr>
                            <td colspan="@ColSpan" class="tm-data-table-empty-cell">
                                @* The empty state carries an icon and a localized supporting line, so the
                                   cell is not a bare string floating in the table (UX review, fix round 3). *@
                                <TmEmptyState Title="@EmptyTitle"
                                              Icon="@Tempo.Blazor.Components.Icons.IconNames.Database"
                                              Description="@Loc["TmDataTable_EmptyDescription"]" />
                            </td>
                        </tr>
                    }
                    else
                    {
                        @RenderGroupRows(_groupedData, 0)
                    }
                }
                else if (!_displayedItems.Any())
                {
                    @if (!string.IsNullOrEmpty(EmptyTitle))
                    {
                        <tr>
                            <td colspan="@ColSpan" class="tm-data-table-empty-cell">
                                @* The empty state carries an icon and a localized supporting line, so the
                                   cell is not a bare string floating in the table (UX review, fix round 3). *@
                                <TmEmptyState Title="@EmptyTitle"
                                              Icon="@Tempo.Blazor.Components.Icons.IconNames.Database"
                                              Description="@Loc["TmDataTable_EmptyDescription"]" />
                            </td>
                        </tr>
                    }
                }
                else if (ScrollMode == DataTableScrollMode.Virtualized)
                {
                    <Virtualize Items="@_displayedItems"
                                Context="rowItem"
                                ItemSize="VirtualItemSize"
                                OverscanCount="VirtualOverscanCount">
                        @{ var virtualRow = DisplayedIndexOf(rowItem); }
                        <tr class="@GetRowClass(rowItem)"
                            tabindex="@RowTabIndex()"
                            role="@(IsGrid ? "row" : null)"
                            aria-rowindex="@(IsGrid ? virtualRow + GridBodyRowOffset : null)"
                            @onclick="() => HandleRowClickAsync(rowItem)"
                            @onkeydown="e => HandleRowKeyDownAsync(e, rowItem)"
                            @onkeyup="e => HandleRowKeyUpAsync(e, rowItem)"
                            @attributes="GetRowAttributes(rowItem)">
                            @if (HasDetail)
                            {
                                <td class="tm-col-expander" role="@(IsGrid ? "gridcell" : null)" aria-colindex="@(IsGrid ? 1 : null)" data-grid-cell="@(IsGrid ? GridCellKey(virtualRow, 0) : null)" tabindex="@(IsGrid ? CellTabIndex(virtualRow, 0) : null)"
                                    @onkeydown="@(IsGrid ? EventCallback.Factory.Create<KeyboardEventArgs>(this, e => HandleGridKeyDownAsync(e, virtualRow, 0, rowItem)) : default)"
                                    @onfocusin="@(IsGrid ? EventCallback.Factory.Create<FocusEventArgs>(this, () => SyncGridCursor(virtualRow, 0)) : default)"
                                    @onkeydown:stopPropagation="@IsGrid" @onkeyup:stopPropagation="@IsGrid"></td>
                            }
                            @if (Selectable)
                            {
                                var virtualCheckCol = HasDetail ? 1 : 0;
                                <td class="tm-col-check @(IsResponsiveScroll ? "tm-col-check--mobile-pinned" : null)" role="@(IsGrid ? "gridcell" : null)" aria-colindex="@(IsGrid ? virtualCheckCol + 1 : null)" data-grid-cell="@(IsGrid ? GridCellKey(virtualRow, virtualCheckCol) : null)" tabindex="@(IsGrid ? CellTabIndex(virtualRow, virtualCheckCol) : null)"
                                    @onkeydown="@(IsGrid ? EventCallback.Factory.Create<KeyboardEventArgs>(this, e => HandleGridKeyDownAsync(e, virtualRow, virtualCheckCol, rowItem)) : default)"
                                    @onfocusin="@(IsGrid ? EventCallback.Factory.Create<FocusEventArgs>(this, () => SyncGridCursor(virtualRow, virtualCheckCol)) : default)"
                                    @onkeydown:stopPropagation="@IsGrid" @onkeyup:stopPropagation="@IsGrid">
                                    <input type="checkbox"
                                           aria-label="@Loc["TmDataTable_SelectRow"]"
                                           tabindex="@(IsGrid ? "-1" : null)"
                                           checked="@IsSelected(rowItem)"
                                           @onchange="e => ToggleRowSelectionAsync(rowItem, e)"
                                           @onkeydown:stopPropagation="true"
                                           @onkeyup:stopPropagation="true"
                                           @onclick:stopPropagation="true" />
                                </td>
                            }
                            @{ var virtualCol = GridDefaultColumn; }
                            @foreach (var col in _renderedCellColumns)
                            {
                                var cellCol = virtualCol++;
                                <td class="@GetCellClass(col)" style="@GetColumnStyle(col)" data-label="@(IsCardLayout ? col.Title : null)" data-card-role="@(IsMobileCards ? col.CardRole.ToString() : null)"
                                    role="@(IsGrid ? "gridcell" : null)" aria-colindex="@(IsGrid ? cellCol + 1 : null)" data-grid-cell="@(IsGrid ? GridCellKey(virtualRow, cellCol) : null)" tabindex="@(IsGrid ? CellTabIndex(virtualRow, cellCol) : null)"
                                    @onkeydown="@(IsGrid ? EventCallback.Factory.Create<KeyboardEventArgs>(this, e => HandleGridKeyDownAsync(e, virtualRow, cellCol, rowItem)) : default)"
                                    @onfocusin="@(IsGrid ? EventCallback.Factory.Create<FocusEventArgs>(this, () => SyncGridCursor(virtualRow, cellCol)) : default)"
                                    @onkeydown:stopPropagation="@IsGrid" @onkeyup:stopPropagation="@IsGrid">
                                    @if (col.CellTemplate is not null)
                                    {
                                        @col.CellTemplate(rowItem)
                                    }
                                    else
                                    {
                                        @col.Field?.Invoke(rowItem)
                                    }
                                </td>
                            }
                        </tr>
                    </Virtualize>
                }
                else
                {
                    @for (var rowIndex = 0; rowIndex < _displayedItems.Count; rowIndex++)
                    {
                        var rowItem = _displayedItems[rowIndex];
                        var currentRowIndex = rowIndex;
                        @if (Editable && IsEditingRow(currentRowIndex))
                        {
                            <CascadingValue Value="_editContext" IsFixed="false">
                                <tr class="tm-row-editing tm-data-table-row--editing @(_editHasErrors ? "tm-data-table-row--invalid" : null)" data-testid="@TestId("row-editing")" role="@(IsGrid ? "row" : null)" aria-rowindex="@(IsGrid ? currentRowIndex + GridBodyRowOffset : null)" @onkeydown="HandleEditKeyDownAsync" @onkeydown:stopPropagation="@IsGrid">
                                    @if (HasDetail)
                                    {
                                        <td class="tm-col-expander"></td>
                                    }
                                    @if (Selectable)
                                    {
                                        <td class="tm-col-check @(IsResponsiveScroll ? "tm-col-check--mobile-pinned" : null)"></td>
                                    }
                                    @foreach (var col in _renderedCellColumns)
                                    {
                                        <td class="@GetCellClass(col) @(col.Editable && col.EditTemplate is not null ? "tm-data-table-cell--editing" : null)" style="@GetColumnStyle(col)" data-label="@(IsCardLayout ? col.Title : null)" data-card-role="@(IsMobileCards ? col.CardRole.ToString() : null)">
                                            @if (!HasEditActions && ReferenceEquals(col, _visibleColumns[0]))
                                            {
                                                @RowEditValidator
                                            }
                                            @if (col.Editable && col.EditTemplate is not null)
                                            {
                                                @col.EditTemplate(rowItem)
                                            }
                                            else if (col.CellTemplate is not null)
                                            {
                                                @col.CellTemplate(rowItem)
                                            }
                                            else
                                            {
                                                @col.Field?.Invoke(rowItem)
                                            }
                                        </td>
                                    }
                                    @if (HasEditActions)
                                    {
                                        @if (EffectiveEditActionsMode != EditActionsMode.Footer)
                                        {
                                            <td class="tm-data-table__edit-actions @(IsMobileCards ? "tm-data-table__edit-actions--card-footer" : null)">
                                                @RowEditValidator
                                                <button type="button" class="tm-data-table__edit-action tm-data-table__edit-action--save"
                                                        aria-label="@Loc["TmDataTable_SaveRow"]" title="@Loc["TmDataTable_SaveRow"]"
                                                        data-testid="@TestId("edit-commit")"
                                                        @onkeydown:stopPropagation="true" @onclick:stopPropagation="true" @onclick="CommitEditAsync">
                                                    @if (EffectiveEditActionsMode == EditActionsMode.Text) { @Loc["TmDataTable_SaveRow"] } else { <TmIcon Name="save" /> }
                                                </button>
                                                <button type="button" class="tm-data-table__edit-action tm-data-table__edit-action--cancel"
                                                        aria-label="@Loc["TmDataTable_CancelEdit"]" title="@Loc["TmDataTable_CancelEdit"]"
                                                        data-testid="@TestId("edit-cancel")"
                                                        @onkeydown:stopPropagation="true" @onclick:stopPropagation="true" @onclick="CancelEditAsync">
                                                    @if (EffectiveEditActionsMode == EditActionsMode.Text) { @Loc["TmDataTable_CancelEdit"] } else { <TmIcon Name="x" /> }
                                                </button>
                                            </td>
                                        }
                                    }
                                </tr>
                                @if (HasEditActions && EffectiveEditActionsMode == EditActionsMode.Footer)
                                {
                                    <tr class="tm-data-table-row--edit-footer">
                                        <td class="tm-data-table__edit-actions" colspan="@EditFooterColSpan">
                                            <div class="tm-data-table__edit-footer-actions">
                                                @RowEditValidator
                                                <button type="button" class="tm-data-table__edit-action tm-data-table__edit-action--save" aria-label="@Loc["TmDataTable_SaveRow"]" title="@Loc["TmDataTable_SaveRow"]" data-testid="@TestId("edit-commit")" @onclick="CommitEditAsync"><TmIcon Name="save" /> @Loc["TmDataTable_SaveRow"]</button>
                                                <button type="button" class="tm-data-table__edit-action tm-data-table__edit-action--cancel" aria-label="@Loc["TmDataTable_CancelEdit"]" title="@Loc["TmDataTable_CancelEdit"]" data-testid="@TestId("edit-cancel")" @onclick="CancelEditAsync"><TmIcon Name="x" /> @Loc["TmDataTable_CancelEdit"]</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (_editHasErrors)
                                {
                                    <tr class="tm-data-table-row--validation">
                                        <td colspan="@ColSpan">
                                            <span class="tm-row-edit-error" role="alert" data-testid="@TestId("edit-error")">@Loc["TmDataTable_EditInvalid"]</span>
                                        </td>
                                    </tr>
                                }
                            </CascadingValue>
                        }
                        else
                        {
                            <tr class="@GetRowClass(rowItem)"
                                tabindex="@RowTabIndex()"
                                role="@(IsGrid ? "row" : null)"
                                aria-rowindex="@(IsGrid ? currentRowIndex + GridBodyRowOffset : null)"
                                @ondblclick="() => StartEditAtAsync(currentRowIndex, rowItem)"
                                @onclick="() => HandleRowClickAsync(rowItem)"
                                @onkeydown="e => HandleRowKeyDownAsync(e, rowItem)"
                                @onkeyup="e => HandleRowKeyUpAsync(e, rowItem)"
                                @attributes="GetRowAttributes(rowItem)">
                                @if (HasDetail)
                                {
                                    var expanderRow = currentRowIndex;
                                    <td class="tm-col-expander" role="@(IsGrid ? "gridcell" : null)" aria-colindex="@(IsGrid ? 1 : null)" data-grid-cell="@(IsGrid ? GridCellKey(expanderRow, 0) : null)" tabindex="@(IsGrid ? CellTabIndex(expanderRow, 0) : null)"
                                        @onkeydown="@(IsGrid ? EventCallback.Factory.Create<KeyboardEventArgs>(this, e => HandleGridKeyDownAsync(e, expanderRow, 0, rowItem)) : default)"
                                        @onfocusin="@(IsGrid ? EventCallback.Factory.Create<FocusEventArgs>(this, () => SyncGridCursor(expanderRow, 0)) : default)"
                                        @onkeydown:stopPropagation="@IsGrid" @onkeyup:stopPropagation="@IsGrid">
                                        <button type="button" class="tm-row-expander-btn"
                                                aria-label="@Loc["TmDataTable_ToggleDetail"]"
                                                aria-expanded="@IsRowExpanded(rowItem).ToString().ToLowerInvariant()"
                                                tabindex="@(IsGrid ? "-1" : null)"
                                                data-testid="@TestId("expander")"
                                                @onkeydown:stopPropagation="true"
                                                @onkeyup:stopPropagation="true"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => ToggleRowDetailAsync(rowItem)">
                                            <span class="tm-row-expander-icon @(IsRowExpanded(rowItem) ? "tm-row-expander-icon--open" : "")" aria-hidden="true"></span>
                                        </button>
                                    </td>
                                }
                                @if (Selectable)
                                {
                                    var checkCol = HasDetail ? 1 : 0;
                                    var checkRow = currentRowIndex;
                                    <td class="tm-col-check @(IsResponsiveScroll ? "tm-col-check--mobile-pinned" : null)" role="@(IsGrid ? "gridcell" : null)" aria-colindex="@(IsGrid ? checkCol + 1 : null)" data-grid-cell="@(IsGrid ? GridCellKey(checkRow, checkCol) : null)" tabindex="@(IsGrid ? CellTabIndex(checkRow, checkCol) : null)"
                                        @onkeydown="@(IsGrid ? EventCallback.Factory.Create<KeyboardEventArgs>(this, e => HandleGridKeyDownAsync(e, checkRow, checkCol, rowItem)) : default)"
                                        @onfocusin="@(IsGrid ? EventCallback.Factory.Create<FocusEventArgs>(this, () => SyncGridCursor(checkRow, checkCol)) : default)"
                                        @onkeydown:stopPropagation="@IsGrid" @onkeyup:stopPropagation="@IsGrid">
                                        <input type="checkbox"
                                               aria-label="@Loc["TmDataTable_SelectRow"]"
                                               tabindex="@(IsGrid ? "-1" : null)"
                                               checked="@IsSelected(rowItem)"
                                               @onchange="e => ToggleRowSelectionAsync(rowItem, e)"
                                               @onkeydown:stopPropagation="true"
                                               @onkeyup:stopPropagation="true"
                                               @onclick:stopPropagation="true" />
                                    </td>
                                }
                                @{ var colIndex = (HasDetail ? 1 : 0) + (Selectable ? 1 : 0); }
                                @foreach (var col in _renderedCellColumns)
                                {
                                    var cellCol = colIndex++;
                                    var cellRow = currentRowIndex;
                                    <td class="@GetCellClass(col)" style="@GetColumnStyle(col)" data-label="@(IsCardLayout ? col.Title : null)" data-card-role="@(IsMobileCards ? col.CardRole.ToString() : null)"
                                        role="@(IsGrid ? "gridcell" : null)" aria-colindex="@(IsGrid ? cellCol + 1 : null)" data-grid-cell="@(IsGrid ? GridCellKey(cellRow, cellCol) : null)" tabindex="@(IsGrid ? CellTabIndex(cellRow, cellCol) : null)"
                                        @onkeydown="@(IsGrid ? EventCallback.Factory.Create<KeyboardEventArgs>(this, e => HandleGridKeyDownAsync(e, cellRow, cellCol, rowItem)) : default)"
                                        @onfocusin="@(IsGrid ? EventCallback.Factory.Create<FocusEventArgs>(this, () => SyncGridCursor(cellRow, cellCol)) : default)"
                                        @onkeydown:stopPropagation="@IsGrid" @onkeyup:stopPropagation="@IsGrid">
                                        @if (col.CellTemplate is not null)
                                        {
                                            @col.CellTemplate(rowItem)
                                        }
                                        else
                                        {
                                            @col.Field?.Invoke(rowItem)
                                        }
                                    </td>
                                }
                                @if (HasEditActions)
                                {
                                    var editCol = GridDefaultColumn + _renderedCellColumns.Count;
                                    var editRow = currentRowIndex;
                                    <td class="tm-data-table__edit-actions @(IsMobileCards ? "tm-data-table__edit-actions--card-footer" : null)"
                                        role="@(IsGrid ? "gridcell" : null)" aria-colindex="@(IsGrid ? editCol + 1 : null)" data-grid-cell="@(IsGrid ? GridCellKey(editRow, editCol) : null)" tabindex="@(IsGrid ? CellTabIndex(editRow, editCol) : null)"
                                        @onkeydown="@(IsGrid ? EventCallback.Factory.Create<KeyboardEventArgs>(this, e => HandleGridKeyDownAsync(e, editRow, editCol, rowItem)) : default)"
                                        @onfocusin="@(IsGrid ? EventCallback.Factory.Create<FocusEventArgs>(this, () => SyncGridCursor(editRow, editCol)) : default)"
                                        @onkeydown:stopPropagation="@IsGrid" @onkeyup:stopPropagation="@IsGrid">
                                        <button type="button" class="tm-data-table__edit-action tm-data-table__edit-action--start"
                                                aria-label="@Loc["TmDataTable_EditRow"]" title="@Loc["TmDataTable_EditRow"]"
                                                tabindex="@(IsGrid ? "-1" : null)"
                                                @onkeydown:stopPropagation="true"
                                                @onkeyup:stopPropagation="true"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => StartEditAtAsync(currentRowIndex, rowItem)">
                                            <TmIcon Name="edit" />
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                        @if (HasDetail && IsRowExpanded(rowItem))
                        {
                            <tr class="tm-row-detail" data-testid="@TestId("row-detail")">
                                <td colspan="@ColSpan">@DetailTemplate!(rowItem)</td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
    @* The result count, announced. It lives outside the conditional summary so a filter that
       changes the count is spoken even when no summary slot is rendered, and it stays in the DOM
       so the live region is not created and destroyed with the number. *@
    <div class="tm-data-table-live-count tm-sr-only" aria-live="polite" aria-atomic="true">@ResultCountAnnouncement</div>

    @* ── Pagination ───────────────────────────────────────────── *@
    @if (PagerRenders)
    {
        <div class="@PaginationContainerClass" data-testid="@TestId("pagination-container")">
            @* Left: Info — rendered only when this is the chosen placement, so the range is not
               printed twice (the pagination bar below can state it instead). ShowResultSummary=false
               suppresses even this slot; with placement=Pagination the TmPagination below prints the
               range itself, so the line still exists exactly once. *@
            @if (PaginationInfoPlacement == DataTablePaginationInfoPlacement.Summary && ShowResultSummary != false)
            {
                <div class="tm-pagination-info" data-testid="@TestId("pagination-summary")">
                    @if (PaginationInfoTemplate is not null)
                    {
                        @PaginationInfoTemplate(CurrentPaginationInfo)
                    }
                    else
                    {
                        @Loc["TmDataTable_ShowingItems", CurrentPaginationInfo.StartItem, CurrentPaginationInfo.EndItem, _totalCount]
                    }
                </div>
            }

            @* Center: Page controls + Page size (vše v jednom) *@
            <div class="tm-pagination-center @(MobileLayout != DataTableMobileLayout.None ? "tm-data-table-pager--responsive" : null)">
                @* "Page X of Y" is a width decision, not a parameter: the label is in the markup always
                   and the container query reveals it below 640px, hiding the page numbers beside it. *@
                <span class="tm-data-table-page-label">@Loc["TmDataTable_CompactPage", _currentPage, _totalPages]</span>
                <TmPagination CurrentPage="@_currentPage"
                              TotalPages="@_totalPages"
                              TotalCount="@_totalCount"
                              PageSize="@_pageSize"
                              PageSizeOptions="PageSizeOptions"
                              ShowInfo="@(PaginationInfoPlacement == DataTablePaginationInfoPlacement.Pagination)"
                              TestIdPrefix="@TestIdPrefix"
                              AdditionalAttributes="PaginationAttributes"
                              OnPageChange="GoToPageAsync"
                              OnPageSizeChange="ChangePageSizeAsync" />
            </div>
        </div>
    }
    else if (ShowResultSummary == true)
    {
        @* No pager to carry the count — print it on its own. ResultSummaryInfo reports 1–total,
           because without a slicing pager that is the range the reader actually sees. *@
        <div class="tm-pagination-info" data-testid="@TestId("pagination-summary")">
            @if (PaginationInfoTemplate is not null)
            {
                @PaginationInfoTemplate(ResultSummaryInfo)
            }
            else
            {
                @(IsRedesigned ? Loc.Plural("TmDataTable_TotalItems", _totalCount) : Loc["TmDataTable_ShowingItems", ResultSummaryInfo.StartItem, ResultSummaryInfo.EndItem, _totalCount])
            }
        </div>
    }
</div>
