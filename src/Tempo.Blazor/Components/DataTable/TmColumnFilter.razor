@namespace Tempo.Blazor.Components.DataTable
@using Tempo.Blazor.Models

<div class="tm-col-filter">
    @if (FilterType == FilterType.Boolean)
    {
        <div class="tm-col-filter-input-wrap">
            <select class="tm-col-filter-select"
                    value="@_value"
                    aria-label="@AccessibleName"
                    @onchange="OnSelectChange">
                <option value=""></option>
                <option value="true">@Loc["Tm_Yes"]</option>
                <option value="false">@Loc["Tm_No"]</option>
            </select>
            @if (!string.IsNullOrEmpty(_value))
            {
                <button class="tm-col-filter-clear"
                        type="button"
                        aria-label="@Loc["Tm_Clear"]"
                        @onclick="Clear">
                    &#215;
                </button>
            }
        </div>
    }
    else if (FilterType == FilterType.Select)
    {
        <div class="tm-col-filter-input-wrap">
            <select class="tm-col-filter-select"
                    value="@_value"
                    aria-label="@AccessibleName"
                    @onchange="OnSelectChange">
                <option value=""></option>
                @if (FilterOptions != null)
                {
                    @foreach (var opt in FilterOptions)
                    {
                        <option value="@opt.Value">@opt.Label</option>
                    }
                }
            </select>
            @if (!string.IsNullOrEmpty(_value))
            {
                <button class="tm-col-filter-clear"
                        type="button"
                        aria-label="@Loc["Tm_Clear"]"
                        @onclick="Clear">
                    &#215;
                </button>
            }
        </div>
    }
    else
    {
        <div class="tm-col-filter-input-wrap">
            <input class="tm-col-filter-input"
                   type="@InputType"
                   value="@_value"
                   placeholder="@AccessibleName"
                   aria-label="@AccessibleName"
                   @oninput="OnInputChange" />
            @if (!string.IsNullOrEmpty(_value))
            {
                <button class="tm-col-filter-clear"
                        type="button"
                        aria-label="@Loc["Tm_Clear"]"
                        @onclick="Clear">
                    &#215;
                </button>
            }
        </div>
    }
</div>

@code {
    /// <summary>Column key sent with the emitted filter.</summary>
    [Parameter] public string ColumnKey { get; set; } = string.Empty;

    /// <summary>Control kind. Defaults to text.</summary>
    [Parameter] public FilterType FilterType { get; set; } = FilterType.Text;

    /// <summary>Options for a select filter.</summary>
    [Parameter] public IReadOnlyList<SelectOption<string>>? FilterOptions { get; set; }

    /// <summary>Raised when the filter value changes. Null clears the filter.</summary>
    [Parameter] public EventCallback<DataTableFilter?> OnFilterChange { get; set; }

    /// <summary>Column caption used in the accessible name and placeholder. Additive; omitted keeps the generic filter label.</summary>
    [Parameter] public string? ColumnTitle { get; set; }

    /// <summary>Controlled value. When set, it overwrites the inner text on every parameter update.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Raised with the new text when the user edits or clears a controlled filter.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Operator sent with the filter. Null or whitespace keeps the historical "contains".</summary>
    [Parameter] public string? FilterOperator { get; set; }

    private string _value = string.Empty;

    private string InputType => FilterType switch
    {
        FilterType.Number => "number",
        FilterType.Date   => "date",
        _                 => "text",
    };

    private string AccessibleName => string.IsNullOrWhiteSpace(ColumnTitle)
        ? Loc["TmDataTable_Filter"]
        : Loc["TmDataTable_FilterColumn", ColumnTitle];

    private string EffectiveOperator => string.IsNullOrWhiteSpace(FilterOperator)
        ? "contains"
        : FilterOperator;

    protected override void OnParametersSet()
    {
        if (Value is not null)
            _value = Value;
    }

    private Task OnInputChange(ChangeEventArgs e)
    {
        _value = e.Value?.ToString() ?? string.Empty;
        return EmitFilter();
    }

    private Task OnSelectChange(ChangeEventArgs e)
    {
        _value = e.Value?.ToString() ?? string.Empty;
        return EmitFilter();
    }

    private async Task EmitFilter()
    {
        await ValueChanged.InvokeAsync(_value);
        if (string.IsNullOrEmpty(_value))
        {
            await OnFilterChange.InvokeAsync(null);
            return;
        }

        await OnFilterChange.InvokeAsync(new DataTableFilter(ColumnKey, EffectiveOperator, _value));
    }

    private async Task Clear()
    {
        _value = string.Empty;
        await ValueChanged.InvokeAsync(_value);
        await OnFilterChange.InvokeAsync(null);
    }
}
