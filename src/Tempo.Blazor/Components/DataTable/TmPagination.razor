@namespace Tempo.Blazor.Components.DataTable
@inherits Tempo.Blazor.Components.TmComponentBase

<div class="tm-pagination @Class @(Disabled ? "tm-pagination-disabled" : "")"
     data-testid="@RootTestId("pagination")"
     @attributes="AdditionalAttributes">
    @if (ShowInfo)
    {
        <span class="tm-pagination-info" data-testid="@TestId("pagination-info")">
            @Loc["TmDataTable_Pagination", StartItem, EndItem, TotalCount]
        </span>
    }

    <div class="tm-pagination-controls">
        <button class="tm-pagination-btn tm-pagination-prev"
                data-testid="@TestId("pagination-prev")"
                @onclick="PrevPage"
                disabled="@(Disabled || CurrentPage <= 1)"
                aria-label="@Loc["Tm_Previous"]">
            &#8249;
        </button>

        @foreach (var pageNum in GetPageNumbers())
        {
            @if (pageNum == -1)
            {
                <span class="tm-pagination-ellipsis">&#8230;</span>
            }
            else
            {
                <button class="tm-page-btn @(pageNum == CurrentPage ? "tm-page-btn-active" : "")"
                        data-testid="@TestId($"pagination-page-{pageNum}")"
                        aria-current="@(pageNum == CurrentPage ? "page" : null)"
                        disabled="@Disabled"
                        @onclick="() => GoToPage(pageNum)">
                    @pageNum
                </button>
            }
        }

        <button class="tm-pagination-btn tm-pagination-next"
                data-testid="@TestId("pagination-next")"
                @onclick="NextPage"
                disabled="@(Disabled || CurrentPage >= TotalPages)"
                aria-label="@Loc["Tm_Next"]">
            &#8250;
        </button>
    </div>

    @if (PageSizeOptions is { Count: > 0 })
    {
        <div class="tm-pagination-size">
            <label class="tm-pagination-size-label">@Loc["TmDataTable_PageSize"]</label>
            <select class="tm-pagination-page-size"
                    data-testid="@TestId("pagination-page-size")"
                    value="@PageSize"
                    disabled="@Disabled"
                    aria-label="@Loc["TmDataTable_PageSize"]"
                    @onchange="OnPageSizeSelectChange">
                @foreach (var size in PageSizeOptions)
                {
                    <option value="@size" selected="@(size == PageSize)">@size</option>
                }
            </select>
        </div>
    }
</div>

@code {
    /// <summary>1-based index of the page currently displayed. Defaults to 1.</summary>
    [Parameter] public int CurrentPage { get; set; } = 1;

    /// <summary>Total number of pages.</summary>
    [Parameter] public int TotalPages { get; set; }

    /// <summary>Total number of items across all pages.</summary>
    [Parameter] public int TotalCount { get; set; }

    /// <summary>Number of items per page. Defaults to 25.</summary>
    [Parameter] public int PageSize { get; set; } = 25;

    /// <summary>Page sizes offered by the page size selector. When null or empty the selector is not rendered.</summary>
    [Parameter] public IReadOnlyList<int>? PageSizeOptions { get; set; }

    /// <summary>Invoked with the requested 1-based page number, already clamped to the valid range.</summary>
    [Parameter] public EventCallback<int> OnPageChange { get; set; }

    /// <summary>Invoked with the page size picked in the page size selector.</summary>
    [Parameter] public EventCallback<int> OnPageSizeChange { get; set; }

    /// <summary>Whether the pagination is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Whether the "X–Y of Z" item range label is rendered inside the pagination bar. Defaults to
    /// <c>true</c>, which is what a standalone pager needs. A host that already states the range next to
    /// the pager — as <c>TmDataTable</c> does with its own summary — sets this to <c>false</c> so the
    /// count is not printed twice.
    /// </summary>
    [Parameter] public bool ShowInfo { get; set; } = true;

    /// <summary>Additional CSS class.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Additional HTML attributes to apply to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private int StartItem => TotalCount == 0 ? 0 : (CurrentPage - 1) * PageSize + 1;
    private int EndItem => Math.Min(CurrentPage * PageSize, TotalCount);

    private Task PrevPage() => Disabled ? Task.CompletedTask : GoToPage(CurrentPage - 1);
    private Task NextPage() => Disabled ? Task.CompletedTask : GoToPage(CurrentPage + 1);

    private Task GoToPage(int page)
    {
        if (Disabled) return Task.CompletedTask;
        var clamped = Math.Clamp(page, 1, Math.Max(1, TotalPages));
        return OnPageChange.InvokeAsync(clamped);
    }

    private Task OnPageSizeSelectChange(ChangeEventArgs e)
    {
        if (Disabled) return Task.CompletedTask;
        if (int.TryParse(e.Value?.ToString(), out var size))
            return OnPageSizeChange.InvokeAsync(size);
        return Task.CompletedTask;
    }

    /// <summary>Computes which page numbers to show. -1 = ellipsis placeholder.</summary>
    private IEnumerable<int> GetPageNumbers()
    {
        if (TotalPages <= 7)
        {
            return Enumerable.Range(1, TotalPages);
        }

        var result = new List<int>();
        const int window = 2; // pages around current

        result.Add(1);

        int lo = Math.Max(2, CurrentPage - window);
        int hi = Math.Min(TotalPages - 1, CurrentPage + window);

        if (lo > 2) result.Add(-1); // left ellipsis
        for (int i = lo; i <= hi; i++) result.Add(i);
        if (hi < TotalPages - 1) result.Add(-1); // right ellipsis

        result.Add(TotalPages);
        return result;
    }
}
