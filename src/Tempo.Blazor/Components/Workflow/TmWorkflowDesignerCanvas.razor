@namespace Tempo.Blazor.Components.Workflow
@using System.Globalization
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="tm-wf-designer">
    <div class="tm-wf-canvas @(ReadOnly ? "tm-wf-canvas--readonly" : "") @Class"
         @onclick="HandleCanvasClick">
        <svg @ref="_svgRef"
             viewBox="@ViewBoxString"
             preserveAspectRatio="xMidYMid meet"
             width="100%"
             height="100%"
             tabindex="-1"
             aria-label="@Loc["TmWorkflowDesignerCanvas_Aria"]"
             role="group">

            <defs>
                @if (ShowGrid)
                {
                    <pattern id="wf-grid-@_instanceId" width="@GridSize" height="@GridSize"
                             patternUnits="userSpaceOnUse">
                        <circle cx="1" cy="1" r="0.5" fill="#d1d5db" />
                    </pattern>
                }
                <marker id="wf-arrow-@_instanceId"
                        markerWidth="10" markerHeight="7"
                        refX="10" refY="3.5"
                        orient="auto" markerUnits="strokeWidth">
                    <polygon points="0 0, 10 3.5, 0 7" fill="#6b7280" />
                </marker>
            </defs>

            @if (ShowGrid)
            {
                <rect x="@F(_viewBoxX)" y="@F(_viewBoxY)"
                      width="@F(_viewBoxW)" height="@F(_viewBoxH)"
                      fill="url(#wf-grid-@_instanceId)" />
            }

            @CanvasContent
        </svg>

        @if (_ctxMenuVisible && !ReadOnly)
        {
            @* A click inside the menu belongs to the menu: it never reaches the canvas click that
               would close the menu before the Connect-to submenu could show its targets. Escape
               closes it and returns the focus to the state it came from. *@
            <div class="tm-wf-context-menu" role="menu"
                 @ref="_ctxMenuRef"
                 @onclick:stopPropagation="true"
                 @onkeydown="HandleMenuKeyDown"
                 style="left: @(_ctxMenuClientX.ToString("0", System.Globalization.CultureInfo.InvariantCulture))px; top: @(_ctxMenuClientY.ToString("0", System.Globalization.CultureInfo.InvariantCulture))px;">
                @if (_ctxMenuStateId is not null && _ctxMenuMode == "connect")
                {
                    @foreach (var target in ConnectTargets(_ctxMenuStateId))
                    {
                        var capturedTarget = target;
                        <button class="tm-wf-context-menu__item" role="menuitem"
                                @onclick="@(() => ContextConnectTo(capturedTarget.Id))">
                            @capturedTarget.Name
                        </button>
                    }
                }
                else if (_ctxMenuStateId is not null)
                {
                    <button class="tm-wf-context-menu__item" role="menuitem"
                            @onclick="ContextSelectState">
                        @Loc["TmWorkflowDesignerCanvas_EditProperties"]
                    </button>
                    @if (ConnectTargets(_ctxMenuStateId).Count > 0)
                    {
                        <button class="tm-wf-context-menu__item" role="menuitem"
                                @onclick="@(() => SwitchToConnectMode())">
                            @Loc["TmWorkflowDesignerCanvas_ConnectTo"]
                        </button>
                    }
                    <div class="tm-wf-context-menu__divider" role="separator"></div>
                    <button class="tm-wf-context-menu__item tm-wf-context-menu__item--danger" role="menuitem"
                            @onclick="ContextDeleteState">
                        @Loc["TmWorkflowDesignerCanvas_DeleteState"]
                    </button>
                }
                else if (_ctxMenuTransitionId is not null)
                {
                    <button class="tm-wf-context-menu__item" role="menuitem"
                            @onclick="ContextSelectTransition">
                        @Loc["TmWorkflowDesignerCanvas_EditProperties"]
                    </button>
                    <div class="tm-wf-context-menu__divider" role="separator"></div>
                    <button class="tm-wf-context-menu__item tm-wf-context-menu__item--danger" role="menuitem"
                            @onclick="ContextDeleteTransition">
                        @Loc["TmWorkflowDesignerCanvas_DeleteTransition"]
                    </button>
                }
                else
                {
                    <button class="tm-wf-context-menu__item" role="menuitem"
                            @onclick="@(() => ContextAddState(CanvasStateType.Initial))">
                        <span class="tm-wf-toolbox__btn-icon tm-wf-toolbox__btn-icon--initial"></span>
                        @Loc["TmWorkflowDesignerCanvas_AddInitialState"]
                    </button>
                    <button class="tm-wf-context-menu__item" role="menuitem"
                            @onclick="@(() => ContextAddState(CanvasStateType.Intermediate))">
                        <span class="tm-wf-toolbox__btn-icon tm-wf-toolbox__btn-icon--intermediate"></span>
                        @Loc["TmWorkflowDesignerCanvas_AddState"]
                    </button>
                    <button class="tm-wf-context-menu__item" role="menuitem"
                            @onclick="@(() => ContextAddState(CanvasStateType.Final))">
                        <span class="tm-wf-toolbox__btn-icon tm-wf-toolbox__btn-icon--final"></span>
                        @Loc["TmWorkflowDesignerCanvas_AddFinalState"]
                    </button>
                }
            </div>
        }

        @* The single-pointer (and keyboard) alternative to pinch zoom — WCAG 2.5.7. *@
        <div class="tm-wf-zoom-overlay">
            <button type="button" class="tm-wf-zoom-overlay__btn"
                    aria-label="@Loc["TmWorkflowDesignerCanvas_ZoomOut"]"
                    @onclick="@(async () => await SetZoom(Math.Max(MinZoom, ZoomLevel - ZoomStep)))">&minus;</button>
            <button type="button" class="tm-wf-zoom-overlay__btn"
                    aria-label="@Loc["TmWorkflowDesignerCanvas_ZoomIn"]"
                    @onclick="@(async () => await SetZoom(Math.Min(MaxZoom, ZoomLevel + ZoomStep)))">+</button>
        </div>

        @* Announces the keyboard move/delete (the non-drag alternative) to assistive technology. *@
        <div class="tm-sr-only" role="status" aria-live="polite">@_announcement</div>
    </div>
</div>

@code {
    private const int DefaultW = 800;
    private const int DefaultH = 500;
    private const int NodeW = 140;
    private const int NodeH = 50;
    private const int PortR = 6;

    private readonly string _instanceId = Guid.NewGuid().ToString("N")[..8];
    private ElementReference _svgRef;
    private ElementReference _ctxMenuRef;
    private DotNetObjectReference<TmWorkflowDesignerCanvas>? _dotNetRef;
    private bool _jsInitialized;
    /// <summary>The ReadOnly value the JS side was last told about (OnParametersSetAsync pushes deltas).</summary>
    private bool _lastReadOnly;

    private double _viewBoxX;
    private double _viewBoxY;
    private double _viewBoxW = DefaultW;
    private double _viewBoxH = DefaultH;

    // Context menu state
    private bool _ctxMenuVisible;
    private double _ctxMenuClientX;
    private double _ctxMenuClientY;
    private double _ctxMenuSvgX;
    private double _ctxMenuSvgY;
    private string? _ctxMenuStateId;
    private string? _ctxMenuTransitionId;
    /// <summary>Context-menu sub-mode: null = commands, "connect" = pick the transition target.</summary>
    private string? _ctxMenuMode;

    // Keyboard accessibility: the roving tabindex inside the state group, the state whose focus
    // move is pending (applied through JS after the render that updated the tabindex), and the
    // live-region announcement of the keyboard commits.
    private string? _rovingStateId;
    private string? _pendingFocusStateId;
    private string? _announcement;
    /// <summary>The open context menu waits for the focus move to its first item.</summary>
    private bool _pendingMenuFocus;
    /// <summary>The last state was keyboard-deleted: the focus moves to the zoom button (or the svg).</summary>
    private bool _pendingFocusZoom;

    [Parameter, EditorRequired] public WorkflowCanvasDefinition? Definition { get; set; }
    [Parameter] public EventCallback<WorkflowCanvasDefinition> DefinitionChanged { get; set; }
    [Parameter] public bool ShowGrid { get; set; } = true;
    [Parameter] public int GridSize { get; set; } = 20;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback<CanvasState?> OnStateSelected { get; set; }
    [Parameter] public EventCallback<CanvasTransition?> OnTransitionSelected { get; set; }
    [Parameter] public string? SelectedStateId { get; set; }
    [Parameter] public string? SelectedTransitionId { get; set; }
    [Parameter] public string? Class { get; set; }

    /// <summary>Fires when zoom level changes (from mouse wheel or JS).</summary>
    [Parameter] public EventCallback<double> OnZoomLevelChanged { get; set; }

    /// <summary>Current zoom level (1.0 = 100%).</summary>
    public double ZoomLevel { get; private set; } = 1.0;

    private const double MinZoom = 0.25;
    private const double MaxZoom = 4.0;
    private const double ZoomStep = 0.25;

    private string ViewBoxString =>
        $"{F(_viewBoxX)} {F(_viewBoxY)} {F(_viewBoxW)} {F(_viewBoxH)}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingFocusStateId is not null && Definition is not null
            && Definition.States.Any(s => s.Id == _pendingFocusStateId))
        {
            var focusId = _pendingFocusStateId;
            _pendingFocusStateId = null;
            try
            {
                await JS.InvokeVoidAsync("tmWorkflowDesigner.focusState", _svgRef, focusId);
            }
            catch (JSException) { /* bUnit - no JS runtime */ }
            catch (InvalidOperationException) { /* prerender */ }
            catch (TaskCanceledException) { }
        }

        if (_pendingFocusZoom)
        {
            _pendingFocusZoom = false;
            try
            {
                await JS.InvokeVoidAsync("tmWorkflowDesigner.focusZoom", _svgRef);
            }
            catch (JSException) { /* bUnit - no JS runtime */ }
            catch (InvalidOperationException) { /* prerender */ }
            catch (TaskCanceledException) { }
        }

        if (_pendingMenuFocus)
        {
            _pendingMenuFocus = false;
            try
            {
                // The first item owns the focus when the menu opens (and after the Connect-to
                // switch replaced the items); tm-menu-nav roves the arrows from there.
                await JS.InvokeVoidAsync("tmWorkflowDesigner.focusMenu", _ctxMenuRef);
            }
            catch (JSException) { /* bUnit - no JS runtime */ }
            catch (InvalidOperationException) { /* prerender */ }
            catch (TaskCanceledException) { }
        }

        if (firstRender && !_jsInitialized)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("tmWorkflowDesigner.init", _svgRef, _dotNetRef, ReadOnly,
                    new { gridSize = GridSize, minZoom = MinZoom, maxZoom = MaxZoom });
                _jsInitialized = true;
                _lastReadOnly = ReadOnly;
            }
            catch (JSException) { /* bUnit - no JS runtime */ }
            catch (ObjectDisposedException) { /* disposed while the call was in flight */ }
            catch (InvalidOperationException) { /* prerender */ }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // A parent flipped ReadOnly after init: the JS gestures must follow (the init-time value
        // covers the first render).
        if (!_jsInitialized || ReadOnly == _lastReadOnly) return;
        _lastReadOnly = ReadOnly;
        try
        {
            await JS.InvokeVoidAsync("tmWorkflowDesigner.setReadOnly", _svgRef, ReadOnly);
        }
        catch (JSException) { /* bUnit - no JS runtime */ }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { /* prerender */ }
        catch (TaskCanceledException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsInitialized)
        {
            try { await JS.InvokeVoidAsync("tmWorkflowDesigner.destroy", _svgRef); }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            catch (InvalidOperationException) { }
            catch (TaskCanceledException) { }
        }
        _dotNetRef?.Dispose();
    }

    // ── JS callbacks ──

    [JSInvokable]
    public void OnNodeDragged(string stateId, double x, double y)
    {
        if (ReadOnly || Definition is null) return;
        var state = Definition.States.FirstOrDefault(s => s.Id == stateId);
        if (state is null) return;

        ApplyNodePosition(state, x, y);
        DefinitionChanged.InvokeAsync(Definition);
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The keyboard alternative to a node drag (Alt+arrow through <c>attachKeyboardMove</c>):
    /// one commit path with the drag (snap + DefinitionChanged) plus a live-region announcement.
    /// </summary>
    [JSInvokable]
    public void OnNodeKeyboardMoved(string stateId, double x, double y)
    {
        if (ReadOnly || Definition is null) return;
        var state = Definition.States.FirstOrDefault(s => s.Id == stateId);
        if (state is null) return;

        ApplyNodePosition(state, x, y);
        _announcement = Loc["TmWorkflowDesignerCanvas_StateMoved", state.Name, F(state.X), F(state.Y)];
        DefinitionChanged.InvokeAsync(Definition);
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Delete on a focused state — the keyboard alternative to the context-menu command. Before
    /// the removal the roving focus moves to a NEIGHBOUR (next, else previous): exactly one state
    /// keeps tabindex 0 and the focus lands there after the re-render. With no neighbour left the
    /// zoom button (the surviving canvas chrome) takes the focus.
    /// </summary>
    [JSInvokable]
    public void OnNodeKeyboardDeleted(string stateId)
    {
        if (ReadOnly || Definition is null) return;
        var state = Definition.States.FirstOrDefault(s => s.Id == stateId);
        if (state is null) return;

        var index = Definition.States.IndexOf(state);
        var neighbour = index + 1 < Definition.States.Count ? Definition.States[index + 1]
            : (index - 1 >= 0 ? Definition.States[index - 1] : null);
        if (neighbour is not null)
        {
            _rovingStateId = neighbour.Id;
            _pendingFocusStateId = neighbour.Id;
        }
        else
        {
            _rovingStateId = null;
            _pendingFocusStateId = null;
            _pendingFocusZoom = true;
        }

        RemoveState(stateId);
        _announcement = Loc["TmWorkflowDesignerCanvas_StateDeleted", state.Name];
        InvokeAsync(StateHasChanged);
    }

    private void ApplyNodePosition(CanvasState state, double x, double y)
    {
        // Snap to grid — the single commit path shared by the drag and the keyboard move.
        state.X = Math.Round(x / GridSize) * GridSize;
        state.Y = Math.Round(y / GridSize) * GridSize;
    }

    [JSInvokable]
    public void OnTransitionCreated(string fromId, string toId)
    {
        CreateTransition(fromId, toId);
    }

    private void CreateTransition(string fromId, string toId)
    {
        if (ReadOnly || Definition is null) return;
        // Reject self-loops
        if (fromId == toId) return;
        // Reject duplicates
        if (Definition.Transitions.Any(t => t.FromStateId == fromId && t.ToStateId == toId)) return;
        // Verify both states exist
        if (!Definition.States.Any(s => s.Id == fromId) || !Definition.States.Any(s => s.Id == toId)) return;

        var newTransition = new CanvasTransition
        {
            Id = Guid.NewGuid().ToString("N")[..8],
            FromStateId = fromId,
            ToStateId = toId,
            Label = "New"
        };
        Definition.Transitions.Add(newTransition);
        DefinitionChanged.InvokeAsync(Definition);
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnZoomChanged(double scale)
    {
        ZoomLevel = scale;
        OnZoomLevelChanged.InvokeAsync(scale);
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnViewBoxChanged(double x, double y, double w, double h)
    {
        _viewBoxX = x;
        _viewBoxY = y;
        _viewBoxW = w;
        _viewBoxH = h;
    }

    [JSInvokable]
    public void OnContextMenu(double svgX, double svgY, double clientX, double clientY, string? stateId, string? transitionId = null)
    {
        _ctxMenuSvgX = svgX;
        _ctxMenuSvgY = svgY;
        _ctxMenuClientX = clientX;
        _ctxMenuClientY = clientY;
        _ctxMenuStateId = stateId;
        _ctxMenuTransitionId = transitionId;
        _ctxMenuMode = null;
        _ctxMenuVisible = true;
        _pendingMenuFocus = true;
        InvokeAsync(StateHasChanged);
    }

    // ── Context menu actions ──

    private void CloseContextMenu() => _ctxMenuVisible = false;

    /// <summary>The "Connect to…" entry: the menu switches to the target list and keeps the focus.</summary>
    private void SwitchToConnectMode()
    {
        _ctxMenuMode = "connect";
        _pendingMenuFocus = true;
    }

    /// <summary>The states a transition FROM the given state may go to (every other state).</summary>
    private List<CanvasState> ConnectTargets(string fromStateId) =>
        Definition?.States.Where(s => s.Id != fromStateId).ToList() ?? [];

    /// <summary>
    /// Opens the state context menu from the KEYBOARD (Shift+F10 / ContextMenu key on a focused
    /// state). The pointer path is the svg <c>contextmenu</c> event; both feed the same menu.
    /// The menu first sits at the node's viewBox position and is then re-anchored to the
    /// JS-measured state rect minus the container rect — exact under zoom and pan.
    /// </summary>
    private void OpenContextMenuForState(CanvasState state)
    {
        _ctxMenuSvgX = state.X + NodeW / 2.0;
        _ctxMenuSvgY = state.Y + NodeH;
        _ctxMenuClientX = _ctxMenuSvgX;
        _ctxMenuClientY = _ctxMenuSvgY;
        _ctxMenuStateId = state.Id;
        _ctxMenuTransitionId = null;
        _ctxMenuMode = null;
        _ctxMenuVisible = true;
        _pendingMenuFocus = true;
        _ = PositionContextMenuAsync(state.Id);
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Re-anchors the open menu from the DOM measurement (state rect − canvas container rect).
    /// The fallback viewBox position stands when JS is unavailable or the menu moved on.
    /// </summary>
    private async Task PositionContextMenuAsync(string stateId)
    {
        if (!_jsInitialized) return;
        try
        {
            var point = await JS.InvokeAsync<double[]?>("tmWorkflowDesigner.stateMenuPoint", _svgRef, stateId);
            if (point is not { Length: 2 }) return;
            if (!_ctxMenuVisible || _ctxMenuStateId != stateId) return;
            _ctxMenuClientX = point[0];
            _ctxMenuClientY = point[1];
            await InvokeAsync(StateHasChanged);
        }
        catch (JSException) { /* bUnit - no JS runtime */ }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { /* prerender */ }
        catch (TaskCanceledException) { }
    }

    /// <summary>Escape in the open menu closes it and returns the focus to the originating state.</summary>
    private void HandleMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        var originStateId = _ctxMenuStateId;
        CloseContextMenu();
        if (originStateId is not null && Definition is not null
            && Definition.States.Any(s => s.Id == originStateId))
        {
            _rovingStateId = originStateId;
            _pendingFocusStateId = originStateId;
        }
    }

    private void ContextConnectTo(string toStateId)
    {
        if (_ctxMenuStateId is not null)
        {
            CreateTransition(_ctxMenuStateId, toStateId);
        }
        CloseContextMenu();
    }

    // ── State keyboard handling (focus, activation, menu) ──

    private string RovingStateId =>
        _rovingStateId is not null && Definition is not null && Definition.States.Any(s => s.Id == _rovingStateId)
            ? _rovingStateId
            : (Definition is not null && Definition.States.Count > 0 ? Definition.States[0].Id : string.Empty);

    private void HandleStateKeyDown(CanvasState state, KeyboardEventArgs e)
    {
        if (e.AltKey) return; // Alt+arrows belong to the JS keyboard move (attachKeyboardMove)

        switch (e.Key)
        {
            case "Enter" when !e.Repeat:
                // Emulated activation: an SVG group is not natively activatable (exactly once per press).
                SelectState(state);
                break;
            case "ArrowRight":
            case "ArrowDown":
                MoveRovingFocus(state, 1);
                break;
            case "ArrowLeft":
            case "ArrowUp":
                MoveRovingFocus(state, -1);
                break;
            case "F10" when e.ShiftKey:
            case "ContextMenu":
                OpenContextMenuForState(state);
                break;
            case "Escape" when _ctxMenuVisible:
                // The menu kept the focus open in principle; if it did not take it, Escape here
                // still closes it (the focus already sits on this state).
                CloseContextMenu();
                break;
        }
    }

    private void HandleStateKeyUp(CanvasState state, KeyboardEventArgs e)
    {
        // Space activates on KEYUP, where a native button fires its click (one activation per press).
        if (e.Key == " ") SelectState(state);
    }

    private void MoveRovingFocus(CanvasState state, int delta)
    {
        if (Definition is null || Definition.States.Count == 0) return;
        var index = Definition.States.FindIndex(s => s.Id == state.Id);
        if (index < 0) return;
        var target = Definition.States[Math.Clamp(index + delta, 0, Definition.States.Count - 1)];
        _rovingStateId = target.Id;
        // The focus move lands after the render that made the target the roving tab stop.
        _pendingFocusStateId = target.Id;
    }

    private void HandleCanvasClick()
    {
        if (_ctxMenuVisible) CloseContextMenu();
    }

    private void ContextAddState(CanvasStateType type)
    {
        AddState(type, _ctxMenuSvgX, _ctxMenuSvgY);
        CloseContextMenu();
    }

    private void ContextSelectState()
    {
        if (_ctxMenuStateId is not null && Definition is not null)
        {
            var state = Definition.States.FirstOrDefault(s => s.Id == _ctxMenuStateId);
            if (state is not null)
            {
                OnStateSelected.InvokeAsync(state);
            }
        }
        CloseContextMenu();
    }

    private void ContextDeleteState()
    {
        if (_ctxMenuStateId is not null)
        {
            RemoveState(_ctxMenuStateId);
        }
        CloseContextMenu();
    }

    private void ContextSelectTransition()
    {
        if (_ctxMenuTransitionId is not null && Definition is not null)
        {
            var transition = Definition.Transitions.FirstOrDefault(t => t.Id == _ctxMenuTransitionId);
            if (transition is not null)
            {
                OnTransitionSelected.InvokeAsync(transition);
            }
        }
        CloseContextMenu();
    }

    private void ContextDeleteTransition()
    {
        if (_ctxMenuTransitionId is not null)
        {
            RemoveTransition(_ctxMenuTransitionId);
        }
        CloseContextMenu();
    }

    // ── Public API for Toolbox ──

    public void AddState(CanvasStateType type, double x, double y)
    {
        if (Definition is null) return;

        var newState = new CanvasState
        {
            Id = Guid.NewGuid().ToString("N")[..8],
            Name = type switch
            {
                CanvasStateType.Initial => "Start",
                CanvasStateType.Final => "End",
                _ => "New state"
            },
            Type = type,
            X = Math.Round(x / GridSize) * GridSize,
            Y = Math.Round(y / GridSize) * GridSize
        };
        Definition.States.Add(newState);
        DefinitionChanged.InvokeAsync(Definition);
        InvokeAsync(StateHasChanged);
    }

    public void RemoveState(string stateId)
    {
        if (Definition is null) return;
        var state = Definition.States.FirstOrDefault(s => s.Id == stateId);
        if (state is null) return;

        Definition.States.Remove(state);
        Definition.Transitions.RemoveAll(t => t.FromStateId == stateId || t.ToStateId == stateId);
        DefinitionChanged.InvokeAsync(Definition);
        InvokeAsync(StateHasChanged);
    }

    public void RemoveTransition(string transitionId)
    {
        if (Definition is null) return;
        var transition = Definition.Transitions.FirstOrDefault(t => t.Id == transitionId);
        if (transition is null) return;

        Definition.Transitions.Remove(transition);
        DefinitionChanged.InvokeAsync(Definition);
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Sets zoom level programmatically. The JS <c>zoomTo</c> reports the new viewBox back as
    /// [x, y, w, h]; the fields are assigned from the result BEFORE StateHasChanged, so the
    /// Blazor-rendered viewBox attribute matches what the canvas now shows.
    /// </summary>
    public async Task SetZoom(double scale)
    {
        ZoomLevel = Math.Clamp(scale, MinZoom, MaxZoom);
        if (_jsInitialized)
        {
            try
            {
                var viewBox = await JS.InvokeAsync<double[]?>("tmWorkflowDesigner.zoomTo", _svgRef, ZoomLevel);
                if (viewBox is { Length: 4 })
                {
                    _viewBoxX = viewBox[0];
                    _viewBoxY = viewBox[1];
                    _viewBoxW = viewBox[2];
                    _viewBoxH = viewBox[3];
                }
            }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
            catch (TaskCanceledException) { }
        }
        await OnZoomLevelChanged.InvokeAsync(ZoomLevel);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Fits the canvas view to show all nodes. The JS <c>fitToView</c> reports the fit as one
    /// { scale, x, y, w, h } object; the zoom level and the viewBox fields are assigned from it
    /// before StateHasChanged.
    /// </summary>
    public async Task FitToView()
    {
        if (!_jsInitialized) return;

        try
        {
            var fit = await JS.InvokeAsync<WorkflowViewBox?>("tmWorkflowDesigner.fitToView", _svgRef, 40);
            if (fit is not null)
            {
                ZoomLevel = Math.Clamp(fit.Scale, MinZoom, MaxZoom);
                _viewBoxX = fit.X;
                _viewBoxY = fit.Y;
                _viewBoxW = fit.W;
                _viewBoxH = fit.H;
                await OnZoomLevelChanged.InvokeAsync(ZoomLevel);
            }
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        catch (TaskCanceledException) { }
        await InvokeAsync(StateHasChanged);
    }

    // ── Helpers ──

    private static string F(double v) =>
        v.ToString("0.##", CultureInfo.InvariantCulture);

    private static string GetDefaultColor(CanvasStateType type) => type switch
    {
        CanvasStateType.Initial => "#dbeafe",
        CanvasStateType.Final => "#dcfce7",
        _ => "#f3f4f6"
    };

    private Task SelectState(CanvasState state) => OnStateSelected.InvokeAsync(state);
    private Task SelectTransition(CanvasTransition transition) => OnTransitionSelected.InvokeAsync(transition);

    // ── SVG content via RenderTreeBuilder (avoids <text> vs @<text> Razor conflict) ──

    private RenderFragment CanvasContent => builder =>
    {
        if (Definition is null) return;
        var seq = 0;

        // ── Transitions ──
        foreach (var t in Definition.Transitions)
        {
            var from = Definition.States.FirstOrDefault(s => s.Id == t.FromStateId);
            var to = Definition.States.FirstOrDefault(s => s.Id == t.ToStateId);
            if (from is null || to is null) continue;

            var isSel = SelectedTransitionId == t.Id;
            var pathCss = "tm-wf-transition" + (isSel ? " tm-wf-transition--selected" : "");

            var fx = from.X + NodeW / 2.0;
            var fy = from.Y + NodeH / 2.0;
            var tx = to.X + NodeW / 2.0;
            var ty = to.Y + NodeH / 2.0;
            var dx = tx - fx;
            var cx1 = fx + dx * 0.4;
            var cx2 = tx - dx * 0.4;
            var pathD = $"M {F(fx)},{F(fy)} C {F(cx1)},{F(fy)} {F(cx2)},{F(ty)} {F(tx)},{F(ty)}";

            var capturedT = t;

            builder.OpenElement(seq++, "g");
            builder.AddAttribute(seq++, "class", pathCss);
            builder.AddAttribute(seq++, "data-transition-id", t.Id);
            builder.AddAttribute(seq++, "style", "cursor: pointer;");
            builder.AddAttribute(seq++, "onclick",
                EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(
                    this, () => SelectTransition(capturedT)));

            // Invisible wider hit area
            builder.OpenElement(seq++, "path");
            builder.AddAttribute(seq++, "d", pathD);
            builder.AddAttribute(seq++, "fill", "none");
            builder.AddAttribute(seq++, "stroke", "transparent");
            builder.AddAttribute(seq++, "stroke-width", "12");
            builder.CloseElement();

            // Visible path
            builder.OpenElement(seq++, "path");
            builder.AddAttribute(seq++, "d", pathD);
            builder.AddAttribute(seq++, "fill", "none");
            builder.AddAttribute(seq++, "stroke", t.Color ?? (isSel ? "#3b82f6" : "#9ca3af"));
            builder.AddAttribute(seq++, "stroke-width", isSel ? "3" : "2");
            builder.AddAttribute(seq++, "marker-end", $"url(#wf-arrow-{_instanceId})");
            builder.CloseElement();

            // Transition label
            if (t.Label is not null)
            {
                var lx = (fx + tx) / 2;
                var ly = (fy + ty) / 2 - 8;
                builder.OpenElement(seq++, "text");
                builder.AddAttribute(seq++, "class", "tm-wf-transition__label");
                builder.AddAttribute(seq++, "x", F(lx));
                builder.AddAttribute(seq++, "y", F(ly));
                builder.AddAttribute(seq++, "text-anchor", "middle");
                builder.AddAttribute(seq++, "font-size", "11");
                builder.AddAttribute(seq++, "fill", "#6b7280");
                builder.AddContent(seq++, t.Label);
                builder.CloseElement();
            }

            builder.CloseElement(); // g
        }

        // ── States ──
        foreach (var state in Definition.States)
        {
            var isSel = SelectedStateId == state.Id;
            var typeCss = state.Type switch
            {
                CanvasStateType.Initial => "tm-wf-state--initial",
                CanvasStateType.Final => "tm-wf-state--final",
                _ => "tm-wf-state--intermediate"
            };
            var stateCss = $"tm-wf-state {typeCss}" + (isSel ? " tm-wf-state--selected" : "");
            var fill = state.Color ?? GetDefaultColor(state.Type);
            var strokeColor = isSel ? "#3b82f6" : "#d1d5db";
            var strokeW = isSel ? "3" : "1.5";
            var capturedState = state;
            var typeLabel = state.Type switch
            {
                CanvasStateType.Initial => Loc["TmWorkflowDesignerCanvas_InitialState"],
                CanvasStateType.Final => Loc["TmWorkflowDesignerCanvas_FinalState"],
                _ => Loc["TmWorkflowDesignerCanvas_IntermediateState"]
            };

            builder.OpenElement(seq++, "g");
            builder.AddAttribute(seq++, "class", stateCss);
            builder.AddAttribute(seq++, "data-state-id", state.Id);
            builder.AddAttribute(seq++, "transform", $"translate({F(state.X)}, {F(state.Y)})");
            builder.AddAttribute(seq++, "style", "cursor: pointer;");
            // Focusable + named + roving: one tab stop inside the role=group canvas, the arrows
            // move the focus, Enter/Space activate (emulated — an SVG group is not natively so).
            builder.AddAttribute(seq++, "tabindex", state.Id == RovingStateId ? "0" : "-1");
            builder.AddAttribute(seq++, "role", "button");
            builder.AddAttribute(seq++, "aria-label",
                Loc["TmWorkflowDesignerCanvas_StateLabel", state.Name, typeLabel]);
            builder.AddAttribute(seq++, "onclick",
                EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(
                    this, () => SelectState(capturedState)));
            builder.AddAttribute(seq++, "onkeydown",
                EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.KeyboardEventArgs>(
                    this, e => HandleStateKeyDown(capturedState, e)));
            builder.AddAttribute(seq++, "onkeyup",
                EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.KeyboardEventArgs>(
                    this, e => HandleStateKeyUp(capturedState, e)));

            if (state.Type == CanvasStateType.Initial)
            {
                // Rounded pill
                builder.OpenElement(seq++, "rect");
                builder.AddAttribute(seq++, "width", NodeW.ToString());
                builder.AddAttribute(seq++, "height", NodeH.ToString());
                builder.AddAttribute(seq++, "rx", (NodeH / 2).ToString());
                builder.AddAttribute(seq++, "ry", (NodeH / 2).ToString());
                builder.AddAttribute(seq++, "fill", fill);
                builder.AddAttribute(seq++, "stroke", strokeColor);
                builder.AddAttribute(seq++, "stroke-width", strokeW);
                builder.CloseElement();
            }
            else if (state.Type == CanvasStateType.Final)
            {
                // Double border
                builder.OpenElement(seq++, "rect");
                builder.AddAttribute(seq++, "width", NodeW.ToString());
                builder.AddAttribute(seq++, "height", NodeH.ToString());
                builder.AddAttribute(seq++, "rx", "8");
                builder.AddAttribute(seq++, "ry", "8");
                builder.AddAttribute(seq++, "fill", fill);
                builder.AddAttribute(seq++, "stroke", strokeColor);
                builder.AddAttribute(seq++, "stroke-width", strokeW);
                builder.CloseElement();

                builder.OpenElement(seq++, "rect");
                builder.AddAttribute(seq++, "x", "4");
                builder.AddAttribute(seq++, "y", "4");
                builder.AddAttribute(seq++, "width", (NodeW - 8).ToString());
                builder.AddAttribute(seq++, "height", (NodeH - 8).ToString());
                builder.AddAttribute(seq++, "rx", "4");
                builder.AddAttribute(seq++, "ry", "4");
                builder.AddAttribute(seq++, "fill", "none");
                builder.AddAttribute(seq++, "stroke", strokeColor);
                builder.AddAttribute(seq++, "stroke-width", "1");
                builder.CloseElement();
            }
            else
            {
                // Standard rounded rect
                builder.OpenElement(seq++, "rect");
                builder.AddAttribute(seq++, "width", NodeW.ToString());
                builder.AddAttribute(seq++, "height", NodeH.ToString());
                builder.AddAttribute(seq++, "rx", "8");
                builder.AddAttribute(seq++, "ry", "8");
                builder.AddAttribute(seq++, "fill", fill);
                builder.AddAttribute(seq++, "stroke", strokeColor);
                builder.AddAttribute(seq++, "stroke-width", strokeW);
                builder.CloseElement();
            }

            // State label
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "class", "tm-wf-state__label");
            builder.AddAttribute(seq++, "x", (NodeW / 2).ToString());
            builder.AddAttribute(seq++, "y", (NodeH / 2 + 5).ToString());
            builder.AddAttribute(seq++, "text-anchor", "middle");
            builder.AddAttribute(seq++, "font-size", "13");
            builder.AddAttribute(seq++, "font-weight", "500");
            builder.AddAttribute(seq++, "fill", "#374151");
            builder.AddContent(seq++, state.Name);
            builder.CloseElement();

            // Connection port (right side) — only in edit mode
            if (!ReadOnly)
            {
                builder.OpenElement(seq++, "circle");
                builder.AddAttribute(seq++, "class", "tm-wf-port");
                builder.AddAttribute(seq++, "data-port", state.Id);
                builder.AddAttribute(seq++, "cx", NodeW.ToString());
                builder.AddAttribute(seq++, "cy", (NodeH / 2).ToString());
                builder.AddAttribute(seq++, "r", PortR.ToString());
                builder.AddAttribute(seq++, "fill", "#3b82f6");
                builder.AddAttribute(seq++, "stroke", "white");
                builder.AddAttribute(seq++, "stroke-width", "2");
                builder.CloseElement();
            }

            builder.CloseElement(); // g
        }
    };
}
