@namespace Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Abstractions.Layout
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Layout
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Helpers
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject ILogger<TmModal> Logger
@inject ILogger<OverlayLayout> LayoutLogger

@if (Show && Viewport is null && LayoutMode == TmLayoutMode.Auto && MobilePresentation == MobilePresentation.Auto)
{
    @* No viewport scope: measure the fixed overlay itself, so the first frame is not stuck on the
       initial mode. The probe is an internal component, so it is opened from C# — a tag in markup
       would compile to a literal HTML element and nothing would ever measure. *@
    @Probe
}
@if (Show)
{
    <div class="tm-modal-overlay @GetOverlayClasses() @Class"
         data-layout="@Context.CssModifier"
         @attributes="AdditionalAttributes"
         @onclick="HandleOverlayClick"
         @ref="_overlayElement">
        
        <div @ref="_panel" class="tm-modal-container @GetContainerClasses()" @onclick:stopPropagation>
            <TmFocusScope @ref="_scope"
                          Active="true"
                          Class="@ScopeClass"
                          AriaLabelledBy="@_titleId"
                          CloseOnEscape="CloseOnEscape"
                          OnEscape="HandleEscape"
                          RestoreFocusTarget="RestoreFocusTarget"
                          RestoreFocusTargetId="@RestoreFocusTargetId"
                          InitialFocusTargetId="@InitialFocusTargetId">
                
                @if (IsSheet && CloseOnOverlayClick)
                {
                    @* The grabber is decorative, but it is also the swipe target: without the
                       dismiss gesture it would paint a drag that does nothing. *@
                    <TmSheetHandle @ref="_handle" Decorative="true" />
                }

                @* Header *@
                <div class="tm-modal-header">
                    @if (!string.IsNullOrEmpty(Icon))
                    {
                        <div class="tm-modal-header-icon">
                            <TmIcon Name="@Icon" Size="IconSize.Lg" />
                        </div>
                    }
                    <div class="tm-modal-header-content">
                        @if (!string.IsNullOrEmpty(Title))
                        {
                            <h3 id="@_titleId" class="tm-modal-title">@Title</h3>
                        }
                        @if (!string.IsNullOrEmpty(Subtitle))
                        {
                            <p class="tm-modal-subtitle">@Subtitle</p>
                        }
                    </div>
                    @if (ShowCloseButton)
                    {
                        <button type="button"
                                class="tm-modal-close"
                                @onclick="OnClose"
                                aria-label="@Loc["TmModal_Close"]">
                            <TmIcon Name="x" Size="IconSize.Sm" />
                        </button>
                    }
                </div>
                
                @* Body *@
                <div class="tm-modal-body">
                    @ChildContent
                </div>
                
                @* Footer: only when there is something to put in it. An empty footer bar is a
                   stray border under the body. *@
                @if (ShowFooter && (Footer is not null || ShowDefaultFooterButtons))
                {
                    <div class="tm-modal-footer @FooterClass">
                        @if (Footer is not null)
                        {
                            @Footer
                        }
                        else if (ShowDefaultFooterButtons)
                        {
                            @if (ShowCancelButton)
                            {
                                <TmButton Variant="ButtonVariant.Ghost"
                                          OnClick="OnClose"
                                          Class="tm-modal-btn-cancel">
                                    @ResolvedCancelText
                                </TmButton>
                            }
                            @if (ShowOkButton)
                            {
                                <TmButton Variant="OkButtonVariant"
                                          OnClick="OnOkClick"
                                          Disabled="OkButtonDisabled"
                                          Class="tm-modal-btn-ok">
                                    @ResolvedOkText
                                </TmButton>
                            }
                        }
                    </div>
                }
            </TmFocusScope>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    
    [Parameter] public ModalSize Size { get; set; } = ModalSize.Medium;
    [Parameter] public ModalPosition Position { get; set; } = ModalPosition.Center;

    /// <summary>
    /// How the modal presents on a narrow viewport. <see cref="MobilePresentation.Auto"/> follows the
    /// viewport scope: a sheet on mobile, a dialog otherwise. A forced value renders that
    /// presentation without measuring, so a test can render it without a DOM.
    /// </summary>
    [Parameter] public MobilePresentation MobilePresentation { get; set; } = MobilePresentation.Auto;

    /// <summary>How the footer buttons are arranged. Inline keeps them side by side at every width.</summary>
    [Parameter] public FooterLayout FooterLayout { get; set; } = FooterLayout.Inline;

    /// <summary>
    /// The layout the modal renders. <see cref="TmLayoutMode.Auto"/> follows the viewport scope; a
    /// forced value never measures, so a test can render a mode without a DOM.
    /// </summary>
    [Parameter] public TmLayoutMode LayoutMode { get; set; } = TmLayoutMode.Auto;

    /// <summary>The layout rendered before the first measurement. Desktop unless the host says otherwise.</summary>
    [Parameter] public TmLayoutMode InitialMode { get; set; } = TmLayoutMode.Desktop;

    /// <summary>
    /// Raised when the rendered layout changes. The initial value is not a change. Never pair
    /// <see cref="LayoutMode"/> with this callback: it reports the resolved mode, and a two-way bind
    /// would pin that mode.
    /// </summary>
    [Parameter] public EventCallback<TmLayoutMode> ResolvedLayoutChanged { get; set; }
    [Parameter] public bool Animated { get; set; } = true;
    
    [Parameter] public bool ShowCloseButton { get; set; } = true;
    [Parameter] public bool ShowFooter { get; set; } = true;
    [Parameter] public bool ShowDefaultFooterButtons { get; set; } = false;
    [Parameter] public bool ShowOkButton { get; set; } = true;
    [Parameter] public bool ShowCancelButton { get; set; } = true;
    /// <summary>Label of the OK button. Null falls back to the localized "OK".</summary>
    [Parameter] public string? OkButtonText { get; set; }
    /// <summary>Label of the cancel button. Null falls back to the localized "Cancel".</summary>
    [Parameter] public string? CancelButtonText { get; set; }
    [Parameter] public ButtonVariant OkButtonVariant { get; set; } = ButtonVariant.Primary;
    [Parameter] public bool OkButtonDisabled { get; set; } = false;
    
    [Parameter] public bool CloseOnOverlayClick { get; set; } = true;
    [Parameter] public bool CloseOnEscape { get; set; } = true;
    
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnOk { get; set; }
    [Parameter] public EventCallback OnOpen { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
    
    /// <summary>The element focus returns to when the modal closes.</summary>
    [Parameter] public ElementReference? RestoreFocusTarget { get; set; }

    /// <summary>The id of the restore target, for a target rendered outside this modal.</summary>
    [Parameter] public string? RestoreFocusTargetId { get; set; }

    /// <summary>The id of the element that receives focus when the modal opens.</summary>
    [Parameter] public string? InitialFocusTargetId { get; set; }

    /// <summary>The viewport's layout. A modal is positioned against the viewport, not its container.</summary>
    [CascadingParameter(Name = TmLayoutScopes.Viewport)] public TmLayoutContext? Viewport { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private string ResolvedOkText => string.IsNullOrEmpty(OkButtonText) ? Loc["Tm_Ok"] : OkButtonText;
    private string ResolvedCancelText => string.IsNullOrEmpty(CancelButtonText) ? Loc["Tm_Cancel"] : CancelButtonText;

    private ElementReference _overlayElement;
    private ElementReference _panel;
    private TmSheetHandle? _handle;
    private string _titleId = Guid.NewGuid().ToString("N");
    private bool _wasShown;
    private bool _gestureAttached;
    private bool _disposed;
    private SheetInterop? _sheet;
    private DotNetObjectReference<TmModal>? _dotNetRef;
    private TmFocusScope? _scope;
    private readonly OverlayLayout _layout = new();

    private TmLayoutContext Context => _layout.Resolve(LayoutMode, Viewport, InitialMode);

    /// <summary>
    /// The internal viewport probe, opened from C# because a Razor tag binds only to public
    /// components (an internal tag compiles to a literal element under a suppressed RZ10012).
    /// </summary>
    private RenderFragment Probe => builder =>
    {
        builder.OpenComponent<ViewportProbe>(0);
        builder.AddComponentParameter(1, nameof(ViewportProbe.OnMeasured),
            EventCallback.Factory.Create<TmLayoutMode>(this, OnProbed));
        builder.CloseComponent();
    };

    private bool IsSheet => ResolvedPresentation == MobilePresentation.Sheet;

    private MobilePresentation ResolvedPresentation => MobilePresentation == MobilePresentation.Auto
        ? (Context.IsMobile ? MobilePresentation.Sheet : MobilePresentation.Dialog)
        : MobilePresentation;

    private string ScopeClass => $"tm-modal {GetModalClasses()}{(IsSheet ? " tm-sheet__panel" : "")}";

    private string FooterClass => FooterLayout == FooterLayout.Stacked
        ? "tm-modal-footer--stacked"
        : "tm-modal-footer--inline";

    protected override async Task OnParametersSetAsync()
    {
        await ReportResolved();

        if (Show && !_wasShown)
        {
            _wasShown = true;
            await OnOpen.InvokeAsync();
        }
        else if (!Show && _wasShown)
        {
            _wasShown = false;
        }
    }

    private Task ReportResolved() => _layout.ReportAsync(
        Context.Resolved, mode => ResolvedLayoutChanged.InvokeAsync(mode));

    private Task OnProbed(TmLayoutMode mode)
    {
        _layout.Measured(mode);
        OverlayLayout.HintOnce(LayoutLogger);
        return ReportResolved();
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The sheet module tracks the on-screen keyboard so the footer stays visible. A modal sheet
        // has no snap points, so the module only ever applies the keyboard offset.
        if (Show && IsSheet && !_gestureAttached)
        {
            _gestureAttached = true;
            await AttachGestureAsync();
        }
        else if ((!Show || !IsSheet) && _gestureAttached)
        {
            _gestureAttached = false;
            await DetachGestureAsync();
        }
    }

    private async Task AttachGestureAsync()
    {
        if (_disposed) return;
        _sheet ??= new SheetInterop(JS);
        _dotNetRef ??= DotNetObjectReference.Create(this);
        // The visible panel is the gesture target, not the container: the container fills the
        // viewport, so a swipe on it would dismiss from anywhere on the screen. A null handle still
        // tracks the viewport, so the sheet lifts for the keyboard even when it cannot be swiped.
        ElementReference? handle = CloseOnOverlayClick && _handle is not null ? _handle.Element : null;
        var panel = _scope?.Element ?? _panel;
        await _sheet.AttachAsync(handle, panel, Array.Empty<double>(), CloseOnOverlayClick, _dotNetRef);
        if (_disposed) await _sheet.DetachAsync();
    }

    private Task DetachGestureAsync() => _sheet is null ? Task.CompletedTask : _sheet.DetachAsync();

    /// <summary>Invoked by the sheet module when a downward swipe dismisses the sheet.</summary>
    [JSInvokable]
    public Task HandleSheetDismissedAsync() => InvokeAsync(HandleOverlayClick);

    /// <summary>A modal sheet sizes to its content, so a reported snap changes nothing.</summary>
    [JSInvokable]
    public Task HandleSheetSnappedAsync(int index) => Task.CompletedTask;

    /// <summary>The keyboard opened or closed. The stylesheet reads the gap; the callback exists because the module calls it.</summary>
    [JSInvokable]
    public Task HandleSheetKeyboardAsync(bool open) => Task.CompletedTask;

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        if (_sheet is not null) await _sheet.DisposeAsync();
        _dotNetRef?.Dispose();
        if (_scope is not null) await _scope.DisposeAsync();
    }


    private async Task HandleOverlayClick()
    {
        if (CloseOnOverlayClick)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task HandleEscape()
    {
        if (CloseOnEscape)
        {
            await OnClose.InvokeAsync();
        }
    }
    
    private async Task OnOkClick()
    {
        await OnOk.InvokeAsync();
    }
    
    private string GetOverlayClasses()
    {
        var classes = new List<string>();
        if (Animated) classes.Add("tm-modal--animated");
        if (Show) classes.Add("tm-modal--visible");
        classes.Add(ResolvedPresentation switch
        {
            MobilePresentation.Sheet => "tm-modal--sheet tm-sheet tm-sheet--anchored tm-sheet--content",
            MobilePresentation.Fullscreen => "tm-modal--fullscreen-presentation",
            _ => "tm-modal--dialog"
        });
        if (Position == ModalPosition.Bottom) classes.Add("tm-modal--bottom-flush");
        return string.Join(" ", classes);
    }
    
    private string GetContainerClasses()
    {
        var classes = new List<string>();
        classes.Add(Position switch
        {
            ModalPosition.Top => "tm-modal--top",
            // Anchored: the panel sits flush with the bottom edge, with no gap below it.
            ModalPosition.Bottom => "tm-modal--bottom tm-modal--bottom-anchored tm-modal--bottom-flush",
            _ => "tm-modal--center"
        });
        return string.Join(" ", classes);
    }
    
    private string GetModalClasses()
    {
        var classes = new List<string>();
        classes.Add(Size switch
        {
            ModalSize.Small => "tm-modal--sm",
            ModalSize.Large => "tm-modal--lg",
            ModalSize.XLarge => "tm-modal--xl",
            ModalSize.Fullscreen => "tm-modal--fullscreen",
            _ => "tm-modal--md"
        });
        return string.Join(" ", classes);
    }
}


