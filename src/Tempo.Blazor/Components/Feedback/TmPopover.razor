@namespace Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Overlay

<div class="tm-popover tm-popover--@PositionCss @Class" @attributes="AdditionalAttributes" @onkeydown="HandleKeyDown">
    <div class="tm-popover__trigger"
         @ref="_triggerRef"
         role="button"
         tabindex="0"
         aria-expanded="@(IsVisible ? "true" : "false")"
         @onclick="Toggle"
         @onkeydown="HandleTriggerKeyDown">
        @* Consumer trigger content may contain a native <button> — its bubbled Enter/Space would
           hit the emulating handler on top of the native click. The keydown fence keeps exactly
           one activation per press (Escape is unaffected: overlay.js consumes it at the window). *@
        <span class="tm-popover__trigger-content" @onkeydown:stopPropagation="true">
            @TriggerContent
        </span>
    </div>

    @* The body is a TmOverlayPanel: popover="manual" puts it in the browser top layer, so an
       ancestor's overflow (modal body, scrolling column) can no longer clip it, and overlay.js
       repositions it on scroll/resize, flipping sides when the preferred one has no room. The
       resolved side lands on data-tm-placement, which the arrow CSS reads. *@
    <TmOverlayPanel Anchor="_triggerRef"
                    IsOpen="IsVisible"
                    IsOpenChanged="SetOpenAsync"
                    Placement="@PanelPlacement"
                    Align="OverlayAlign.Center"
                    Offset="8"
                    CloseOnOutsidePointerDown="CloseOnClickOutside"
                    Class="tm-popover__body">
        @if (ShowArrow)
        {
            <div class="tm-popover__arrow"></div>
        }
        @ChildContent
    </TmOverlayPanel>
</div>

@code {
    private bool _internalOpen;
    private ElementReference _triggerRef;

    /// <summary>Trigger content.</summary>
    [Parameter, EditorRequired] public RenderFragment TriggerContent { get; set; } = default!;

    /// <summary>Popover body content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Preferred position relative to trigger — the panel flips to the opposite side when there is no room.</summary>
    [Parameter] public PopoverPosition Position { get; set; } = PopoverPosition.Bottom;

    /// <summary>Controlled open state.</summary>
    [Parameter] public bool? IsOpen { get; set; }

    /// <summary>Fires when open state changes.</summary>
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>Show arrow pointing to trigger.</summary>
    [Parameter] public bool ShowArrow { get; set; } = true;

    /// <summary>Close when clicking outside.</summary>
    [Parameter] public bool CloseOnClickOutside { get; set; } = true;

    /// <summary>Additional CSS class.</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsVisible => IsOpen ?? _internalOpen;

    private string PositionCss => Position switch
    {
        PopoverPosition.Top => "top",
        PopoverPosition.Left => "left",
        PopoverPosition.Right => "right",
        _ => "bottom"
    };

    private OverlayPlacement PanelPlacement => Position switch
    {
        PopoverPosition.Top => OverlayPlacement.Top,
        PopoverPosition.Left => OverlayPlacement.Left,
        PopoverPosition.Right => OverlayPlacement.Right,
        _ => OverlayPlacement.Bottom
    };

    private async Task SetOpenAsync(bool open)
    {
        if (IsOpen.HasValue)
        {
            await IsOpenChanged.InvokeAsync(open);
        }
        else
        {
            _internalOpen = open;
        }
    }

    private async Task Toggle()
    {
        await SetOpenAsync(!IsVisible);
    }

    private async Task Close()
    {
        await SetOpenAsync(false);
    }

    // Keyboard emulation is REQUIRED here (unlike on TmButton): the trigger is
    // a div[role=button], not a native <button>, so the browser never produces
    // a click for Enter/Space on its own.
    private async Task HandleTriggerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
        {
            await Toggle();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && IsVisible)
        {
            await Close();
        }
    }
}
