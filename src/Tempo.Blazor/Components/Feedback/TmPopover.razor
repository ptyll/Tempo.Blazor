@namespace Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Abstractions.Layout
@using Tempo.Blazor.Components.Overlay

<div class="tm-popover tm-popover--@PositionCss @Class" @attributes="AdditionalAttributes">
    <div class="tm-popover__trigger"
         @ref="_triggerRef"
         role="button"
         tabindex="0"
         aria-expanded="@(IsVisible ? "true" : "false")"
         @onclick="Toggle"
         @onkeydown="HandleTriggerKeyDown"
         @onkeyup="HandleTriggerKeyUp">
        @* Consumer trigger content may contain a native <button> — its bubbled Enter/Space would
           hit the emulating handler on top of the native click. The fences keep exactly one
           activation per press — keyup is fenced too because Space now activates on keyup (N162);
           Escape is unaffected either way: overlay.js consumes it at the window. *@
        <span class="tm-popover__trigger-content" @onkeydown:stopPropagation="true" @onkeyup:stopPropagation="true">
            @TriggerContent
        </span>
    </div>

    @* The body is a TmOverlayPanel: popover="manual" puts it in the browser top layer, so an
       ancestor's overflow (modal body, scrolling column) can no longer clip it, and overlay.js
       repositions it on scroll/resize, flipping sides when the preferred one has no room. The
       resolved side lands on data-tm-placement, which the arrow CSS reads. On a narrow viewport
       (MobilePresentation=Auto) the body presents as a content-height bottom sheet. *@
    <TmOverlayPanel Anchor="_triggerRef"
                    IsOpen="IsVisible"
                    IsOpenChanged="SetOpenAsync"
                    Placement="@PanelPlacement"
                    Align="OverlayAlign.Center"
                    Offset="8"
                    CloseOnOutsidePointerDown="CloseOnClickOutside"
                    Title="@Title"
                    MobilePresentation="MobilePresentation"
                    LayoutMode="LayoutMode"
                    InitialMode="InitialMode"
                    ResolvedLayoutChanged="ResolvedLayoutChanged"
                    Class="tm-popover__body">
        @if (ShowArrow)
        {
            <div class="tm-popover__arrow"></div>
        }
        @ChildContent
    </TmOverlayPanel>
</div>

@code {
    private bool _internalOpen;
    private ElementReference _triggerRef;

    /// <summary>Trigger content.</summary>
    [Parameter, EditorRequired] public RenderFragment TriggerContent { get; set; } = default!;

    /// <summary>Popover body content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Preferred position relative to trigger — the panel flips to the opposite side when there is no room.</summary>
    [Parameter] public PopoverPosition Position { get; set; } = PopoverPosition.Bottom;

    /// <summary>Controlled open state.</summary>
    [Parameter] public bool? IsOpen { get; set; }

    /// <summary>Fires when open state changes.</summary>
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>Show arrow pointing to trigger.</summary>
    [Parameter] public bool ShowArrow { get; set; } = true;

    /// <summary>Close when clicking outside.</summary>
    [Parameter] public bool CloseOnClickOutside { get; set; } = true;

    /// <summary>
    /// Title of the sheet header when the body presents as a bottom sheet on a narrow viewport.
    /// Falls back to <see cref="TmOverlayPanel.AriaLabel"/> and then to a generic localized
    /// "Menu", so the sheet dialog is always named. The popover does not render it.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>
    /// How the body presents on a narrow viewport. <see cref="PanelPresentation.Auto"/> follows the
    /// viewport scope: a content-height bottom sheet on mobile, the anchored popover otherwise.
    /// A forced value renders that presentation without measuring, so a test can render it without
    /// a DOM.
    /// </summary>
    [Parameter] public PanelPresentation MobilePresentation { get; set; } = PanelPresentation.Auto;

    /// <summary>
    /// The layout the body presentation resolves from. <see cref="TmLayoutMode.Auto"/> follows the
    /// viewport scope; a forced value never measures, so a test can render a mode without a DOM.
    /// </summary>
    [Parameter] public TmLayoutMode LayoutMode { get; set; } = TmLayoutMode.Auto;

    /// <summary>The layout rendered before the first measurement. Desktop unless the host says otherwise.</summary>
    [Parameter] public TmLayoutMode InitialMode { get; set; } = TmLayoutMode.Desktop;

    /// <summary>
    /// Raised when the resolved layout changes. The initial value is not a change. Never pair
    /// <see cref="LayoutMode"/> with this callback: it reports the resolved mode, and a two-way bind
    /// would pin that mode.
    /// </summary>
    [Parameter] public EventCallback<TmLayoutMode> ResolvedLayoutChanged { get; set; }

    /// <summary>Additional CSS class.</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsVisible => IsOpen ?? _internalOpen;

    private string PositionCss => Position switch
    {
        PopoverPosition.Top => "top",
        PopoverPosition.Left => "left",
        PopoverPosition.Right => "right",
        _ => "bottom"
    };

    private OverlayPlacement PanelPlacement => Position switch
    {
        PopoverPosition.Top => OverlayPlacement.Top,
        PopoverPosition.Left => OverlayPlacement.Left,
        PopoverPosition.Right => OverlayPlacement.Right,
        _ => OverlayPlacement.Bottom
    };

    private async Task SetOpenAsync(bool open)
    {
        if (IsOpen.HasValue)
        {
            await IsOpenChanged.InvokeAsync(open);
        }
        else
        {
            _internalOpen = open;
        }
    }

    private async Task Toggle()
    {
        await SetOpenAsync(!IsVisible);
    }

    private async Task Close()
    {
        await SetOpenAsync(false);
    }

    // Keyboard emulation is REQUIRED here (unlike on TmButton): the trigger is a div[role=button],
    // not a native <button>, so the browser never produces a click for Enter/Space on its own.
    // Enter fires on KEYDOWN (native buttons do the same, including auto-repeat while held — the
    // e.Repeat guard keeps a held key from re-toggling on every repeat event) — Space fires on
    // KEYUP ONLY, matching the native <button> contract exactly
    // (docs/keyboard-activation-convention.md). Splitting them this way also kills the held-Space
    // double-toggle: a keydown auto-repeat burst never reaches the keyup handler, only the single
    // release does (N162).
    private async Task HandleTriggerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.Repeat)
        {
            await Toggle();
        }
    }

    private async Task HandleTriggerKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == " ")
        {
            await Toggle();
        }
    }

    @* No wrapper-level Escape handler: overlay.js consumes Escape in the window capture phase
       (CloseOnEscape is always true here) and routes it through NotifyDismissedAsync — a
       bubbling handler on this div could never run in a real browser (N169). *@
}
