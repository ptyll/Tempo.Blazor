@namespace Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Components.Inputs
@using Tempo.Blazor.Helpers
@implements IAsyncDisposable

@if (Show)
{
    <div class="tm-modal-overlay tm-modal--animated @GetVisibleClass() @Class"
         @attributes="AdditionalAttributes"
         @onclick="HandleOverlayClick">
        <div class="tm-modal-container tm-modal--center" @onclick:stopPropagation="true">
            <div class="tm-dialog @GetDialogClasses()"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="@_titleId"
                 tabindex="-1"
                 @ref="_dialogElement"
                 @onkeyup="HandleKeyUp">
                
                @* Icon *@
                <div class="tm-dialog-icon">
                    <TmIcon Name="@GetIconName()" Size="IconSize.Xl" />
                </div>
                
                @* Content *@
                <div class="tm-dialog-content">
                    @if (!string.IsNullOrEmpty(Title))
                    {
                        <h3 id="@_titleId" class="tm-dialog-title">@Title</h3>
                    }
                    @if (!string.IsNullOrEmpty(Message))
                    {
                        <p class="tm-dialog-message">@Message</p>
                    }
                    
                    @* Prompt Input *@
                    @if (Type == DialogType.Prompt)
                    {
                        <div class="tm-dialog-input-wrapper">
                            <TmTextInput @bind-Value="_promptValue"
                                         Placeholder="@PromptPlaceholder"
                                         Class="tm-dialog-input"
                                         @onkeyup="HandlePromptKeyUp" />
                        </div>
                    }
                    
                    @* Custom Content *@
                    @if (Type == DialogType.Custom)
                    {
                        @ChildContent
                    }
                </div>
                
                @* Footer Buttons *@
                <div class="tm-dialog-footer">
                    @if (Type == DialogType.Alert)
                    {
                        <TmButton Variant="GetOkButtonVariant()"
                                  OnClick="OnOkClick"
                                  Class="tm-dialog-btn-ok">
                            @ResolvedOkText
                        </TmButton>
                    }
                    else if (Type == DialogType.Confirm || Type == DialogType.Prompt)
                    {
                        <TmButton Variant="ButtonVariant.Ghost"
                                  OnClick="OnCancelClick"
                                  Class="tm-dialog-btn-cancel">
                            @ResolvedCancelText
                        </TmButton>
                        <TmButton Variant="GetOkButtonVariant()"
                                  OnClick="OnOkClick"
                                  Disabled="IsOkDisabled()"
                                  Class="tm-dialog-btn-ok">
                            @ResolvedOkText
                        </TmButton>
                    }
                    else if (Type == DialogType.Custom && FooterContent is not null)
                    {
                        @FooterContent
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public DialogType Type { get; set; } = DialogType.Alert;
    [Parameter] public DialogVariant Variant { get; set; } = DialogVariant.Info;
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public string? DefaultValue { get; set; }
    [Parameter] public string PromptPlaceholder { get; set; } = "Enter value...";
    [Parameter] public bool IsDangerous { get; set; } = false;
    
    /// <summary>
    /// Text of the confirm button. Defaults to the localized <c>Tm_Ok</c> — pass a value to override it.
    /// </summary>
    [Parameter] public string? OkButtonText { get; set; }

    /// <summary>
    /// Text of the dismiss button. Defaults to the localized <c>Tm_Cancel</c> — pass a value to override it.
    /// </summary>
    [Parameter] public string? CancelButtonText { get; set; }
    
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    
    [Parameter] public EventCallback<bool?> OnResult { get; set; }
    [Parameter] public EventCallback<string?> OnPromptResult { get; set; }

    /// <summary>When true, pressing Escape cancels the dialog. Defaults to true (current behavior).</summary>
    [Parameter] public bool CloseOnEscape { get; set; } = true;

    /// <summary>
    /// When true, clicking the backdrop cancels the dialog. Defaults to false so a decision
    /// prompt is not dismissed by an accidental outside click (current behavior).
    /// </summary>
    [Parameter] public bool CloseOnOverlayClick { get; set; } = false;

    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    /// <summary>The confirm label: the caller's text, or the localized default when none was passed.</summary>
    private string ResolvedOkText => string.IsNullOrEmpty(OkButtonText) ? Loc["Tm_Ok"] : OkButtonText;

    /// <summary>The dismiss label: the caller's text, or the localized default when none was passed.</summary>
    private string ResolvedCancelText => string.IsNullOrEmpty(CancelButtonText) ? Loc["Tm_Cancel"] : CancelButtonText;

    private ElementReference _dialogElement;
    private string _titleId = Guid.NewGuid().ToString("N");
    private string _promptValue = string.Empty;
    private bool _wasShown;
    private bool _shouldActivateTrap;
    private FocusTrap? _focusTrap;

    protected override async Task OnParametersSetAsync()
    {
        if (Show && !_wasShown)
        {
            _wasShown = true;
            _shouldActivateTrap = true;
            _promptValue = DefaultValue ?? string.Empty;
        }
        else if (!Show && _wasShown)
        {
            _wasShown = false;
            await DeactivateTrapAsync();
        }
    }

    // Traps Tab focus inside the dialog and restores focus to the trigger on close.
    // Escape is handled at element level (HandleKeyUp) — focus is trapped inside the dialog.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldActivateTrap && Show)
        {
            _shouldActivateTrap = false;
            _focusTrap ??= new FocusTrap(JS);
            await _focusTrap.ActivateAsync<TmDialog>(_dialogElement);
        }
    }

    private async Task DeactivateTrapAsync()
    {
        if (_focusTrap is not null)
        {
            await _focusTrap.DeactivateAsync();
        }
    }

    private void HandleOverlayClick()
    {
        if (CloseOnOverlayClick)
        {
            OnCancelClick();
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_focusTrap is not null)
        {
            await _focusTrap.DisposeAsync();
        }
    }
    
    private string GetVisibleClass() => Show ? "tm-modal--visible" : "";
    
    private string GetDialogClasses()
    {
        var classes = new List<string> { $"tm-dialog--{Type.ToString().ToLowerInvariant()}" };
        
        if (IsDangerous)
        {
            classes.Add("tm-dialog--dangerous");
        }
        else
        {
            classes.Add(Variant switch
            {
                DialogVariant.Success => "tm-dialog--success",
                DialogVariant.Warning => "tm-dialog--warning",
                DialogVariant.Error => "tm-dialog--error",
                _ => "tm-dialog--info"
            });
        }
        
        return string.Join(" ", classes);
    }
    
    private string GetIconName()
    {
        if (IsDangerous) return "alert-triangle";
        
        return Type switch
        {
            DialogType.Alert => Variant switch
            {
                DialogVariant.Success => "check-circle",
                DialogVariant.Warning => "alert-triangle",
                DialogVariant.Error => "x-circle",
                _ => "info"
            },
            DialogType.Confirm => "help-circle",
            DialogType.Prompt => "edit",
            _ => "info"
        };
    }
    
    private ButtonVariant GetOkButtonVariant()
    {
        if (IsDangerous) return ButtonVariant.Danger;
        
        return Variant switch
        {
            DialogVariant.Success => ButtonVariant.Primary,
            DialogVariant.Error => ButtonVariant.Danger,
            _ => ButtonVariant.Primary
        };
    }
    
    private bool IsOkDisabled()
    {
        return Type == DialogType.Prompt && string.IsNullOrWhiteSpace(_promptValue);
    }
    
    private void OnOkClick()
    {
        if (Type == DialogType.Prompt)
        {
            OnPromptResult.InvokeAsync(_promptValue);
        }
        else
        {
            OnResult.InvokeAsync(true);
        }
    }
    
    private void OnCancelClick()
    {
        if (Type == DialogType.Prompt)
        {
            OnPromptResult.InvokeAsync(null);
        }
        else
        {
            OnResult.InvokeAsync(false);
        }
    }
    
    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (CloseOnEscape && e.Key == "Escape")
        {
            OnCancelClick();
        }
    }
    
    private void HandlePromptKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_promptValue))
        {
            OnOkClick();
        }
    }
}


