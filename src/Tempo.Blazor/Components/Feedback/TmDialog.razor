@namespace Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Abstractions.Layout
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Layout
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Components.Inputs
@using Tempo.Blazor.Helpers
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject ILogger<TmDialog> Logger
@inject ILogger<OverlayLayout> LayoutLogger


@if (Show && Viewport is null && LayoutMode == TmLayoutMode.Auto && MobilePresentation == MobilePresentation.Auto)
{
    @* No viewport scope: measure the fixed overlay itself. The probe is an internal component, so
       it is opened from C# — a tag in markup would compile to a literal HTML element. *@
    @Probe
}
@if (Show)
{
    <div class="tm-modal-overlay tm-modal--animated @GetVisibleClass() @PresentationClass @Class"
         data-layout="@Context.CssModifier"
         @ref="_overlayElement"
         @attributes="AdditionalAttributes"
         @onclick="HandleOverlayClick">
        <div @ref="_panel" class="tm-modal-container tm-modal--center" @onclick:stopPropagation="true">
            <TmFocusScope @ref="_scope"
                          Active="true"
                          DialogRole="@(IsDangerous ? "alertdialog" : "dialog")"
                          Class="@ScopeClass"
                          AriaLabelledBy="@_titleId"
                          CloseOnEscape="CloseOnEscape"
                          OnEscape="HandleEscape"
                          RestoreFocusTarget="RestoreFocusTarget"
                          RestoreFocusTargetId="@RestoreFocusTargetId">

                @if (IsSheet && CloseOnOverlayClick)
                {
                    @* The grabber is decorative, but it is also the swipe target: without the
                        dismiss gesture it would paint a drag that does nothing. *@
                    <TmSheetHandle @ref="_handle" Decorative="true" />
                }
                
                @* Icon *@
                <div class="tm-dialog-icon">
                    <TmIcon Name="@GetIconName()" Size="IconSize.Xl" />
                </div>
                
                @* Content *@
                @* The scroller is keyboard-reachable (tabindex="0", WCAG 2.1.1) and, when it has a
                   title, a named region — focus lands where the message starts and the reader
                   announces what it is. *@
                <div class="tm-dialog-content" tabindex="0" role="@ContentRole" aria-labelledby="@ContentLabelledBy">
                    @if (!string.IsNullOrEmpty(Title))
                    {
                        <h3 id="@_titleId" class="tm-dialog-title">@Title</h3>
                    }
                    @if (!string.IsNullOrEmpty(Message))
                    {
                        <p class="tm-dialog-message">@Message</p>
                    }
                    
                    @* Prompt Input *@
                    @if (Type == DialogType.Prompt)
                    {
                        <div class="tm-dialog-input-wrapper">
                            <TmTextInput @bind-Value="_promptValue"
                                         Placeholder="@ResolvedPromptPlaceholder"
                                         Class="tm-dialog-input"
                                         @onkeyup="HandlePromptKeyUp" />
                        </div>
                    }
                    
                    @* Custom Content *@
                    @if (Type == DialogType.Custom)
                    {
                        @ChildContent
                    }
                </div>
                
                @* Footer Buttons *@
                <div class="tm-dialog-footer @FooterClass @(Layout == DialogLayout.Inline ? "tm-dialog-footer--own-row" : null)">
                    @if (Type == DialogType.Alert)
                    {
                        <TmButton Variant="GetOkButtonVariant()"
                                  OnClick="OnOkClick"
                                  Class="tm-dialog-btn-ok"
                                  AdditionalAttributes="@(ButtonTitle(ResolvedOkText))">
                            @ResolvedOkText
                        </TmButton>
                    }
                    else if (Type == DialogType.Confirm || Type == DialogType.Prompt)
                    {
                        <TmButton Variant="ButtonVariant.Ghost"
                                  OnClick="OnCancelClick"
                                  Class="tm-dialog-btn-cancel"
                                  AdditionalAttributes="@(ButtonTitle(ResolvedCancelText))">
                            @ResolvedCancelText
                        </TmButton>
                        <TmButton Variant="GetOkButtonVariant()"
                                  OnClick="OnOkClick"
                                  Disabled="IsOkDisabled()"
                                  Class="tm-dialog-btn-ok"
                                  AdditionalAttributes="@(ButtonTitle(ResolvedOkText))">
                            @ResolvedOkText
                        </TmButton>
                    }
                    else if (Type == DialogType.Custom && FooterContent is not null)
                    {
                        @FooterContent
                    }
                </div>
            </TmFocusScope>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public DialogType Type { get; set; } = DialogType.Alert;
    [Parameter] public DialogVariant Variant { get; set; } = DialogVariant.Info;
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public string? DefaultValue { get; set; }
    /// <summary>Placeholder of the prompt input. Null falls back to the localized text.</summary>
    [Parameter] public string? PromptPlaceholder { get; set; }
    [Parameter] public bool IsDangerous { get; set; } = false;

    /// <summary>
    /// An icon name from the registry. Null keeps the icon the variant and type imply, so an existing
    /// dialog looks exactly as it did.
    /// </summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Where the icon sits relative to the content. Centered keeps it above the title.</summary>
    [Parameter] public DialogLayout Layout { get; set; } = DialogLayout.Centered;

    /// <summary>
    /// How the dialog presents on a narrow viewport. <see cref="MobilePresentation.Auto"/> follows the
    /// viewport scope: a sheet on mobile, a dialog otherwise.
    /// </summary>
    [Parameter] public MobilePresentation MobilePresentation { get; set; } = MobilePresentation.Auto;

    /// <summary>How the footer buttons are arranged. Inline keeps them side by side at every width.</summary>
    [Parameter] public FooterLayout FooterLayout { get; set; } = FooterLayout.Inline;

    /// <summary>The layout the dialog renders. A forced value renders that mode without a DOM.</summary>
    [Parameter] public TmLayoutMode LayoutMode { get; set; } = TmLayoutMode.Auto;

    /// <summary>The layout rendered before the first measurement. Desktop unless the host says otherwise.</summary>
    [Parameter] public TmLayoutMode InitialMode { get; set; } = TmLayoutMode.Desktop;

    /// <summary>
    /// Raised when the rendered layout changes. The initial value is not a change. Never pair
    /// <see cref="LayoutMode"/> with this callback.
    /// </summary>
    [Parameter] public EventCallback<TmLayoutMode> ResolvedLayoutChanged { get; set; }
    
    /// <summary>
    /// Text of the confirm button. Defaults to the localized <c>Tm_Ok</c> — pass a value to override it.
    /// </summary>
    [Parameter] public string? OkButtonText { get; set; }

    /// <summary>
    /// Text of the dismiss button. Defaults to the localized <c>Tm_Cancel</c> — pass a value to override it.
    /// </summary>
    [Parameter] public string? CancelButtonText { get; set; }
    
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    
    [Parameter] public EventCallback<bool?> OnResult { get; set; }
    [Parameter] public EventCallback<string?> OnPromptResult { get; set; }

    /// <summary>When true, pressing Escape cancels the dialog. Defaults to true (current behavior).</summary>
    [Parameter] public bool CloseOnEscape { get; set; } = true;

    /// <summary>
    /// When true, clicking the backdrop cancels the dialog. Defaults to false so a decision
    /// prompt is not dismissed by an accidental outside click (current behavior).
    /// </summary>
    [Parameter] public bool CloseOnOverlayClick { get; set; } = false;

    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>The element focus returns to when the dialog closes.</summary>
    [Parameter] public ElementReference? RestoreFocusTarget { get; set; }

    /// <summary>The id of the restore target, for a target rendered outside this dialog.</summary>
    [Parameter] public string? RestoreFocusTargetId { get; set; }

    /// <summary>The viewport's layout. A dialog is positioned against the viewport, not its container.</summary>
    [CascadingParameter(Name = TmLayoutScopes.Viewport)] public TmLayoutContext? Viewport { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    /// <summary>The confirm label: the caller's text, or the localized default when none was passed.</summary>
    private string ResolvedOkText => string.IsNullOrEmpty(OkButtonText) ? Loc["Tm_Ok"] : OkButtonText;

    /// <summary>The dismiss label: the caller's text, or the localized default when none was passed.</summary>
    private string ResolvedCancelText => string.IsNullOrEmpty(CancelButtonText) ? Loc["Tm_Cancel"] : CancelButtonText;

    /// <summary>The prompt placeholder: the caller's text, or the localized default when none was passed.</summary>
    private string ResolvedPromptPlaceholder => string.IsNullOrEmpty(PromptPlaceholder) ? Loc["TmDialog_PromptPlaceholder"] : PromptPlaceholder;

    /// <summary>The full label as the title: a truncated sheet-footer label keeps its text reachable.</summary>
    private Dictionary<string, object> ButtonTitle(string label) => new(StringComparer.Ordinal) { ["title"] = label };

    private string _titleId = Guid.NewGuid().ToString("N");
    private TmSheetHandle? _handle;
    private ElementReference _panel;
    private ElementReference _overlayElement;
    private string _promptValue = string.Empty;
    private bool _wasShown;
    private bool _gestureAttached;
    private bool _disposed;
    private SheetInterop? _sheet;
    private DotNetObjectReference<TmDialog>? _dotNetRef;
    private TmFocusScope? _scope;
    private readonly OverlayLayout _layout = new();

    private TmLayoutContext Context => _layout.Resolve(LayoutMode, Viewport, InitialMode);

    /// <summary>
    /// The internal viewport probe, opened from C# because a Razor tag binds only to public
    /// components (an internal tag compiles to a literal element under a suppressed RZ10012).
    /// </summary>
    private RenderFragment Probe => builder =>
    {
        builder.OpenComponent<ViewportProbe>(0);
        builder.AddComponentParameter(1, nameof(ViewportProbe.OnMeasured),
            EventCallback.Factory.Create<TmLayoutMode>(this, OnProbed));
        builder.CloseComponent();
    };

    private MobilePresentation ResolvedPresentation => MobilePresentation == MobilePresentation.Auto
        ? (Context.IsMobile ? MobilePresentation.Sheet : MobilePresentation.Dialog)
        : MobilePresentation;

    private bool IsSheet => ResolvedPresentation == MobilePresentation.Sheet;

    /// <summary>A titled scroller is a named region; without a title the attributes would dangle.</summary>
    private string? ContentRole => string.IsNullOrEmpty(Title) ? null : "region";

    private string? ContentLabelledBy => string.IsNullOrEmpty(Title) ? null : _titleId;

    private string PresentationClass => ResolvedPresentation switch
    {
        MobilePresentation.Sheet => "tm-modal--sheet tm-sheet tm-sheet--anchored tm-sheet--content",
        MobilePresentation.Fullscreen => "tm-modal--fullscreen-presentation",
        _ => "tm-modal--dialog"
    };

    private string ScopeClass => $"tm-dialog {GetDialogClasses()}{(IsSheet ? " tm-sheet__panel" : "")}";

    private string FooterClass => FooterLayout == FooterLayout.Stacked
        ? "tm-modal-footer--stacked"
        : "tm-modal-footer--inline";

    protected override async Task OnParametersSetAsync()
    {
        await ReportResolved();

        if (Show && !_wasShown)
        {
            _wasShown = true;
            _promptValue = DefaultValue ?? string.Empty;
        }
        else if (!Show && _wasShown)
        {
            _wasShown = false;
        }
    }

    private Task ReportResolved() => _layout.ReportAsync(
        Context.Resolved, mode => ResolvedLayoutChanged.InvokeAsync(mode));

    private Task OnProbed(TmLayoutMode mode)
    {
        _layout.Measured(mode);
        OverlayLayout.HintOnce(LayoutLogger);
        return ReportResolved();
    }

    private Task HandleOverlayClick() => CloseOnOverlayClick ? OnCancelClick() : Task.CompletedTask;

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var sheet = Show && ResolvedPresentation == MobilePresentation.Sheet;
        if (sheet && !_gestureAttached)
        {
            _gestureAttached = true;
            await AttachGestureAsync();
        }
        else if (!sheet && _gestureAttached)
        {
            _gestureAttached = false;
            await DetachGestureAsync();
        }
    }

    private async Task AttachGestureAsync()
    {
        if (_disposed) return;
        _sheet ??= new SheetInterop(JS);
        _dotNetRef ??= DotNetObjectReference.Create(this);
        // The scope element is the visible panel. A null handle still tracks the viewport, so a
        // sheet that cannot be swiped still lifts above the keyboard.
        ElementReference? handle = CloseOnOverlayClick && _handle is not null ? _handle.Element : null;
        var panel = _scope?.Element ?? _panel;
        await _sheet.AttachAsync(handle, panel, Array.Empty<double>(), CloseOnOverlayClick, _dotNetRef);
        if (_disposed) await _sheet.DetachAsync();
    }

    private Task DetachGestureAsync() => _sheet is null ? Task.CompletedTask : _sheet.DetachAsync();

    /// <summary>Invoked by the sheet module when a downward swipe dismisses the sheet.</summary>
    [JSInvokable]
    public Task HandleSheetDismissedAsync() => InvokeAsync(OnCancelClick);

    /// <summary>A dialog sheet sizes to its content, so a reported snap changes nothing.</summary>
    [JSInvokable]
    public Task HandleSheetSnappedAsync(int index) => Task.CompletedTask;

    /// <summary>The keyboard opened or closed. The stylesheet reads the gap; the callback exists because the module calls it.</summary>
    [JSInvokable]
    public Task HandleSheetKeyboardAsync(bool open) => Task.CompletedTask;

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        if (_sheet is not null) await _sheet.DisposeAsync();
        _dotNetRef?.Dispose();
        if (_scope is not null) await _scope.DisposeAsync();
    }
    
    private string GetVisibleClass() => Show ? "tm-modal--visible" : "";
    
    private string GetDialogClasses()
    {
        var classes = new List<string>
        {
            $"tm-dialog--{Type.ToString().ToLowerInvariant()}",
            Layout == DialogLayout.Inline ? "tm-dialog--inline" : "tm-dialog--centered"
        };
        
        if (IsDangerous)
        {
            classes.Add("tm-dialog--dangerous");
        }
        else
        {
            classes.Add(Variant switch
            {
                DialogVariant.Success => "tm-dialog--success",
                DialogVariant.Warning => "tm-dialog--warning",
                DialogVariant.Error => "tm-dialog--error",
                _ => "tm-dialog--info"
            });
        }
        
        return string.Join(" ", classes);
    }
    
    private string GetIconName()
    {
        if (!string.IsNullOrEmpty(Icon)) return Icon;
        if (IsDangerous) return "alert-triangle";
        
        return Type switch
        {
            DialogType.Alert => Variant switch
            {
                DialogVariant.Success => "check-circle",
                DialogVariant.Warning => "alert-triangle",
                DialogVariant.Error => "x-circle",
                _ => "info"
            },
            DialogType.Confirm => "help-circle",
            DialogType.Prompt => "edit",
            _ => "info"
        };
    }
    
    private ButtonVariant GetOkButtonVariant()
    {
        if (IsDangerous) return ButtonVariant.Danger;
        
        return Variant switch
        {
            DialogVariant.Success => ButtonVariant.Primary,
            DialogVariant.Error => ButtonVariant.Danger,
            _ => ButtonVariant.Primary
        };
    }
    
    private bool IsOkDisabled()
    {
        return Type == DialogType.Prompt && string.IsNullOrWhiteSpace(_promptValue);
    }
    
    private async Task OnOkClick()
    {
        if (Type == DialogType.Prompt)
        {
            await OnPromptResult.InvokeAsync(_promptValue);
        }
        else
        {
            await OnResult.InvokeAsync(true);
        }
    }
    
    private async Task OnCancelClick()
    {
        if (Type == DialogType.Prompt)
        {
            await OnPromptResult.InvokeAsync(null);
        }
        else
        {
            await OnResult.InvokeAsync(false);
        }
    }
    
    private Task HandleEscape() => CloseOnEscape ? OnCancelClick() : Task.CompletedTask;
    
    private async Task HandlePromptKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_promptValue))
        {
            await OnOkClick();
        }
    }
}


