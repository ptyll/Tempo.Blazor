@namespace Tempo.Blazor.Components.Feedback

@if (IsSpan)
{
    <span class="@CssClass @Class" style="@Style" @attributes="AdditionalAttributes"></span>
}
else
{
    <div class="@CssClass @Class" style="@Style" @attributes="AdditionalAttributes"></div>
}

@code {
    /// <summary>Shape variant. Defaults to Text.</summary>
    [Parameter] public SkeletonVariant Variant { get; set; } = SkeletonVariant.Text;

    /// <summary>Optional CSS width (e.g. "200px", "100%").</summary>
    [Parameter] public string? Width { get; set; }

    /// <summary>Optional CSS height (e.g. "40px", "1rem").</summary>
    [Parameter] public string? Height { get; set; }

    /// <summary>Additional CSS class.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Root element the skeleton renders as: <see cref="TmRootElement.Div"/> (default) or
    /// <see cref="TmRootElement.Span"/>. A skeleton inside PHRASING content (a whole-card
    /// <c>&lt;a&gt;</c>/<c>&lt;button&gt;</c> target such as <c>TmStatCard</c>) passes
    /// <see cref="TmRootElement.Span"/> so no block element is nested in an inline one.
    /// <see cref="TmRootElement.Div"/> keeps the historical markup, so a host that never sets the
    /// parameter renders exactly what it rendered before; an undefined enum value falls back to
    /// <c>div</c> as well.
    /// </summary>
    [Parameter] public TmRootElement Element { get; set; } = TmRootElement.Div;

    private bool IsSpan => Element == TmRootElement.Span;

    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => Variant switch
    {
        SkeletonVariant.Circle => "tm-skeleton tm-skeleton-circle",
        SkeletonVariant.Rect   => "tm-skeleton tm-skeleton-rect",
        _                      => "tm-skeleton tm-skeleton-text"
    };

    private string Style
    {
        get
        {
            var parts = new List<string>(2);
            if (!string.IsNullOrEmpty(Width))  parts.Add($"width: {Width}");
            if (!string.IsNullOrEmpty(Height)) parts.Add($"height: {Height}");
            return string.Join("; ", parts);
        }
    }
}
