@namespace Tempo.Blazor.Components.Actions
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Abstractions.Layout
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Components.Layout
@using Tempo.Blazor.Components.Overlay
@using Tempo.Blazor.Helpers
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.Extensions.Logging
@inject ILogger<OverlayLayout> LayoutLogger

@* F5 mobile action bar. The bar belongs to its component's container: the default
   StickyContainer placement sticks inside the component's own container (position: sticky,
   never fixed against the viewport). FixedViewport is a deliberate opt-in and resolves
   its visibility from the viewport scope like every other viewport-anchored surface
   (decision F1-LAYOUT-CONTRACT). The "More" menu composes TmOverlayPanel (F3): the
   anchored popover on desktop, the shared bottom-sheet primitive on a mobile viewport —
   sheet, gesture, focus and top-layer logic are never copied here. *@

@if (Placement == ActionBarPlacement.FixedViewport && Viewport is null && LayoutMode == TmLayoutMode.Auto)
{
    @* No viewport scope: measure the viewport itself so the first frame is not stuck on
       InitialMode. The probe is internal, so it is opened from C# — a tag in markup would
       compile to a literal element and nothing would ever measure. *@
    @Probe
}

@if (Placement == ActionBarPlacement.FixedViewport)
{
    <div class="@RootClasses"
         data-layout="@Context.CssModifier"
         @attributes="AdditionalAttributes">
        @RenderBar(Context)
    </div>
}
else
{
    @* In-container placements resolve from the nearest unnamed layout context: the observer
       measures this component's own root unless an ancestor already decided (F1 contract). *@
    <TmLayoutObserver LayoutMode="LayoutMode"
                      InitialMode="InitialMode"
                      ResolvedLayoutChanged="OnResolvedLayoutChanged"
                      IsContainer="false"
                      Class="@RootClasses"
                      AdditionalAttributes="AdditionalAttributes">
        <LayoutContent Context="context">
            @RenderBar(context)
        </LayoutContent>
    </TmLayoutObserver>
}

@code {
    private readonly OverlayLayout _layout = new();
    private readonly string _morePanelId = $"tm-mab-more-{Guid.NewGuid():N}";
    private readonly string _moreButtonId = $"tm-mab-more-btn-{Guid.NewGuid():N}";
    private TmOverlayPanel? _morePanel;
    private ElementReference _moreButton;
    private ElementReference _firstMenuItem;
    private bool _focusMoreItemPending;
    private bool _focusMoreAfterClose;
    private bool _moreOpen;
    private bool _moreTriggerRendered;

    /// <summary>
    /// The actions. The bar and the "More" menu render in Items order — <see cref="TmActionItem.Priority"/>
    /// is only an overflow rank: the lowest-priority items move into the menu first, ties drop
    /// the last item first (partitioned by <c>ActionOverflowLayout</c>).
    /// </summary>
    [Parameter] public IReadOnlyList<TmActionItem>? Items { get; set; }

    /// <summary>
    /// Content the bar belongs to — rendered above it at every layout (never hidden with the
    /// bar). For <see cref="ActionBarPlacement.FixedViewport"/> the region gets a bottom padding
    /// equal to the bar height while the bar renders, so the last content stays reachable with
    /// no overlap (at 320 and 390 alike); <see cref="ActionBarPlacement.StickyContainer"/> and
    /// <see cref="ActionBarPlacement.Inline"/> bars sit in flow at the end of the content and
    /// reserve nothing — a padding reserve there would double-book an empty band at scroll end.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// How many actions stay on the bar before the rest overflow into the "More" menu.
    /// Values below 1 are treated as 1. Default 3.
    /// </summary>
    [Parameter] public int MaxVisible { get; set; } = 3;

    /// <summary>Where the bar anchors. Default <see cref="ActionBarPlacement.StickyContainer"/>.</summary>
    [Parameter] public ActionBarPlacement Placement { get; set; } = ActionBarPlacement.StickyContainer;

    /// <summary>The "More" menu trigger label. Falls back to the localized default.</summary>
    [Parameter] public string? MoreLabel { get; set; }

    /// <summary>Accessible name of the bar (<c>role="group"</c>). Falls back to the localized default.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>
    /// The layout the visibility resolves from. <see cref="TmLayoutMode.Auto"/> follows the
    /// container (or the viewport scope for <see cref="ActionBarPlacement.FixedViewport"/>);
    /// a forced value never measures, so a test can render the bar without a DOM. The bar hides
    /// whenever the resolved layout is above the mobile breakpoint (tablet and desktop); the
    /// <see cref="ChildContent"/> always renders.
    /// </summary>
    [Parameter] public TmLayoutMode LayoutMode { get; set; } = TmLayoutMode.Auto;

    /// <summary>The layout rendered before the first measurement. Desktop unless the host says otherwise.</summary>
    [Parameter] public TmLayoutMode InitialMode { get; set; } = TmLayoutMode.Desktop;

    /// <summary>
    /// Raised when the resolved layout changes. The initial value is not a change. Never pair
    /// <see cref="LayoutMode"/> with this callback: it reports the resolved mode, and a two-way
    /// bind would pin that mode.
    /// </summary>
    [Parameter] public EventCallback<TmLayoutMode> ResolvedLayoutChanged { get; set; }

    /// <summary>Extra CSS classes for the component root.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Additional HTML attributes applied to the component root.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>The viewport's layout — only <see cref="ActionBarPlacement.FixedViewport"/> resolves from it.</summary>
    [CascadingParameter(Name = TmLayoutScopes.Viewport)] public TmLayoutContext? Viewport { get; set; }

    private string RootClasses => string.Join(" ", new[]
    {
        "tm-mobile-action-bar",
        Placement switch
        {
            ActionBarPlacement.FixedViewport => "tm-mobile-action-bar--fixed",
            ActionBarPlacement.Inline => "tm-mobile-action-bar--inline",
            _ => "tm-mobile-action-bar--sticky",
        },
        // X2: with no ChildContent the root itself is the sticky box — otherwise the bar's
        // containing block is its own root and sticky could never move (the bare TmDashboard
        // reference case).
        ChildContent is null ? "tm-mobile-action-bar--bare" : null,
        Class,
    }.Where(static c => !string.IsNullOrWhiteSpace(c)));

    private TmLayoutContext Context => _layout.Resolve(LayoutMode, Viewport, InitialMode);

    private string EffectiveMoreLabel => MoreLabel ?? Loc["TmMobileActionBar_More"];

    private string EffectiveAriaLabel => AriaLabel ?? Loc["TmMobileActionBar_AriaLabel"];

    private int EffectiveMaxVisible => Math.Max(1, MaxVisible);

    private string BarModifierClass => Placement switch
    {
        ActionBarPlacement.FixedViewport => "tm-mobile-action-bar__bar--fixed",
        ActionBarPlacement.Inline => "tm-mobile-action-bar__bar--inline",
        _ => "tm-mobile-action-bar__bar--sticky",
    };

    /// <summary>The bar body: the host content region (when given) and the action group itself.
    /// The content region renders at every layout — only the role=group bar is gated on the
    /// mobile breakpoint.</summary>
    private RenderFragment<TmLayoutContext> RenderBar => context => builder =>
    {
        builder.OpenRegion(0);

        var items = Items ?? [];
        var showBar = context.IsMobile && items.Count > 0;

        if (ChildContent is not null)
        {
            // The modifier marks "the bar renders"; which placement consumes the reserve is the
            // stylesheet's decision (today: only FixedViewport — X2 (b)).
            var bodyClass = showBar
                ? "tm-mobile-action-bar__body tm-mobile-action-bar__body--with-bar"
                : "tm-mobile-action-bar__body";
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", bodyClass);
            builder.AddContent(2, ChildContent);
            builder.CloseElement();
        }

        if (!showBar)
        {
            builder.CloseRegion();
            return;
        }

        var (visible, overflow) = ActionOverflowLayout.Partition(items, EffectiveMaxVisible);
        var moreDisabled = overflow.Count > 0 && overflow.All(static item => item.Disabled);
        _moreTriggerRendered = overflow.Count > 0;

        builder.OpenElement(3, "div");
        builder.AddAttribute(4, "class", $"tm-mobile-action-bar__bar {BarModifierClass}");
        // role="group" (not "toolbar"): the 2.8.17 guard ships no toolbar role without a roving
        // tabindex mechanism — a set of plain buttons with an accessible name is an honest group.
        builder.AddAttribute(5, "role", "group");
        builder.AddAttribute(6, "aria-label", EffectiveAriaLabel);

        // Y9: keyed elements must be SIBLINGS for the differ to compare their keys — the earlier
        // per-item regions scoped each key to its own region, so mutation order was never
        // key-compared. Each item owns a fixed 16-slot stride; only the key carries identity.
        for (var i = 0; i < visible.Count; i++)
        {
            var item = visible[i];
            var seq = 10 + (i * 16);
            // X3: the bar's own tile button (icon over a two-line label), never .tm-btn — the
            // .tm-btn contract (fixed height, nowrap label) made labels illegible at 320/390.
            // The full label stays in the DOM (clamped to two lines), so no title attribute is
            // needed — it would only duplicate the accessible name.
            builder.OpenElement(seq, "button");
            builder.AddAttribute(seq + 1, "type", "button");
            builder.AddAttribute(seq + 2, "class", "tm-mobile-action-bar__action tm-touch-target");
            builder.AddAttribute(seq + 3, "disabled", item.Disabled);
            builder.AddAttribute(seq + 4, "data-action-id", string.IsNullOrEmpty(item.Id) ? item.Label : item.Id);
            builder.SetKey(string.IsNullOrEmpty(item.Id) ? item : item.Id);
            builder.AddAttribute(seq + 5, "onclick", EventCallback.Factory.Create(this, () => InvokeItemAsync(item)));
            if (!string.IsNullOrEmpty(item.Icon))
            {
                builder.OpenElement(seq + 6, "span");
                builder.AddAttribute(seq + 7, "class", "tm-mobile-action-bar__icon");
                builder.OpenComponent<TmIcon>(seq + 8);
                builder.AddAttribute(seq + 9, "Name", item.Icon);
                builder.AddAttribute(seq + 10, "Size", IconSize.Sm);
                builder.CloseComponent();
                builder.CloseElement();
            }
            builder.OpenElement(seq + 11, "span");
            builder.AddAttribute(seq + 12, "class", "tm-mobile-action-bar__label-text");
            builder.AddContent(seq + 13, item.Label);
            builder.CloseElement();
            builder.CloseElement();
        }

        if (overflow.Count > 0)
        {
            // The More trigger is a raw button (the dashboard's own pattern): the panel gets its
            // element as an explicit Anchor, so the popover positions against it and the sheet's
            // focus restore resolves the trigger by element reference — never a stale node.
            builder.OpenRegion(2);
            builder.OpenElement(0, "button");
            builder.AddAttribute(1, "type", "button");
            // The trigger needs an id: TmOverlayPanel's sheet restores focus through
            // Anchor.Id — without it a programmatic CloseMoreAsync leaves focus on <body>.
            builder.AddAttribute(2, "id", _moreButtonId);
            // Y6: the trigger is a tile like every other action (icon over the label) — the CSS
            // shares the tile rules through the class list, not by doubling __action (that class
            // is the test hook that counts the bar's items).
            builder.AddAttribute(3, "class", "tm-mobile-action-bar__more tm-touch-target");
            builder.AddAttribute(4, "onclick", EventCallback.Factory.Create(this, OpenMoreAsync));
            builder.AddAttribute(5, "aria-haspopup", "menu");
            builder.AddAttribute(6, "aria-expanded", _moreOpen ? "true" : "false");
            builder.AddAttribute(7, "aria-controls", _morePanelId);
            // X11: an overflow of nothing but disabled items has nothing to invoke.
            builder.AddAttribute(8, "disabled", moreDisabled);
            builder.OpenElement(9, "span");
            builder.AddAttribute(10, "class", "tm-mobile-action-bar__icon");
            builder.OpenComponent<TmIcon>(11);
            builder.AddAttribute(12, "Name", IconNames.MoreHorizontal);
            builder.AddAttribute(13, "Size", IconSize.Sm);
            builder.CloseComponent();
            builder.CloseElement();
            builder.OpenElement(14, "span");
            builder.AddAttribute(15, "class", "tm-mobile-action-bar__label-text");
            builder.AddContent(16, EffectiveMoreLabel);
            builder.CloseElement();
            // After the attributes and content: an element-reference capture may not sit between
            // an element frame and its attributes (RenderTreeBuilder assertion).
            builder.AddElementReferenceCapture(17, reference => _moreButton = reference);
            builder.CloseElement();

            builder.OpenComponent<TmOverlayPanel>(18);
            builder.AddComponentParameter(19, "Id", _morePanelId);
            builder.AddComponentParameter(20, "Anchor", _moreButton);
            // X4: the panel carries the bar's own surface class — without it the zero-specificity
            // reset leaves the popover transparent (container-mobile on a desktop viewport).
            builder.AddComponentParameter(21, "Class", "tm-mobile-action-bar__menu-panel");
            builder.AddComponentParameter(22, "Role", "menu");
            builder.AddComponentParameter(23, "Title", EffectiveMoreLabel);
            builder.AddComponentParameter(24, "MobilePresentation", PanelPresentation.Auto);
            builder.AddComponentParameter(25, "InitialMode", context.Resolved);
            // Y1 (R2-M1): the bar is the single owner of the open state. The panel runs CONTROLLED:
            // every close path — item select, CloseMoreAsync, sheet Done, backdrop, swipe, Escape,
            // outside pointer — funnels through IsOpenChanged, so aria-expanded can never go stale
            // (the round-2 probe caught it stuck "true" after sheet closes, which raise neither
            // OnDismissed nor a visible close event in uncontrolled mode).
            builder.AddComponentParameter(26, "IsOpen", _moreOpen);
            builder.AddComponentParameter(27, "IsOpenChanged",
                EventCallback.Factory.Create<bool>(this, HandleMoreOpenChanged));
            // OnOpened stays only for the post-open focus move (the m3 contract).
            builder.AddComponentParameter(28, "OnOpened", EventCallback.Factory.Create(this, HandleMoreOpened));
            builder.AddAttribute(29, "ChildContent", (RenderFragment)(b => BuildMenu(b, overflow)));
            builder.AddComponentReferenceCapture(30, value => _morePanel = (TmOverlayPanel)value);
            builder.CloseComponent();
            builder.CloseRegion();
        }

        builder.CloseElement();
        builder.CloseRegion();
    };

    private void BuildMenu(RenderTreeBuilder builder, IReadOnlyList<TmActionItem> overflow)
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "tm-mobile-action-bar__menu");
        var capturedFirstEnabled = false;
        for (var i = 0; i < overflow.Count; i++)
        {
            var item = overflow[i];
            var seq = i * 16;
            builder.OpenElement(seq, "button");
            builder.AddAttribute(seq + 1, "type", "button");
            builder.AddAttribute(seq + 2, "role", "menuitem");
            builder.AddAttribute(seq + 3, "class", "tm-mobile-action-bar__menu-item");
            builder.AddAttribute(seq + 4, "disabled", item.Disabled);
            builder.AddAttribute(seq + 5, "data-action-id", string.IsNullOrEmpty(item.Id) ? item.Label : item.Id);
            builder.SetKey(string.IsNullOrEmpty(item.Id) ? item : item.Id);
            builder.AddAttribute(seq + 6, "onclick", EventCallback.Factory.Create(this, () => InvokeMenuItemAsync(item)));
            if (!string.IsNullOrEmpty(item.Icon))
            {
                builder.OpenComponent<TmIcon>(seq + 7);
                builder.AddAttribute(seq + 8, "Name", item.Icon);
                builder.AddAttribute(seq + 9, "Size", IconSize.Sm);
                builder.CloseComponent();
            }
            builder.OpenElement(seq + 10, "span");
            builder.AddAttribute(seq + 11, "class", "tm-mobile-action-bar__menu-label");
            builder.AddContent(seq + 12, item.Label);
            builder.CloseElement();
            if (!capturedFirstEnabled && !item.Disabled)
            {
                // X11: the initial focus skips disabled items — focus() on a disabled button is a
                // no-op and would leave focus on <body>.
                capturedFirstEnabled = true;
                // After the attributes and content: an element-reference capture may not sit
                // between an element frame and its attributes (RenderTreeBuilder assertion).
                builder.AddElementReferenceCapture(seq + 13, reference => _firstMenuItem = reference);
            }
            builder.CloseElement();
        }
        builder.CloseElement();
    }

    private async Task InvokeItemAsync(TmActionItem item)
    {
        if (item.Disabled)
        {
            return;
        }

        await item.OnClick.InvokeAsync();
    }

    private async Task InvokeMenuItemAsync(TmActionItem item)
    {
        // Default (KeepMenuOpen=false): close first — the sheet pops down and focus returns to
        // the "More" trigger before the action runs, so the action runs with no menu
        // bookkeeping behind it. KeepMenuOpen=true is for actions that open another surface:
        // the sheet stays, the surface promotes AFTER it and always paints above it
        // (top-layer order = open order, docs/overlays.md rule 8), and closing the surface
        // returns focus to this menuitem.
        if (!item.KeepMenuOpen && _morePanel is not null)
        {
            // X5: the light popover close does not restore focus (overlay.js close() leaves it
            // wherever the destroyed menu had it — often <body>), so the bar restores it
            // itself: flag consumed in OnAfterRenderAsync, the TmDropdown.SelectItemAsync pattern.
            _focusMoreAfterClose = true;
            await _morePanel.CloseAsync();
            // Y8 (TmDropdown.SelectItemAsync pattern): force the close re-render NOW and let it
            // complete before the action runs — the focus restore to the trigger lands inside
            // OnAfterRenderAsync, so an action that moves focus elsewhere wins deterministically
            // instead of racing a late restore.
            StateHasChanged();
            await Task.Yield();
        }

        if (!item.Disabled)
        {
            await item.OnClick.InvokeAsync();
        }
    }

    private void OpenMoreAsync()
    {
        // Y1: the bar owns the open state — flipping the flag re-renders the controlled panel open.
        _moreOpen = true;
    }

    /// <summary>
    /// Closes the "More" menu when it is open (a no-op otherwise). Use after a confirmed
    /// <see cref="TmActionItem.KeepMenuOpen"/> action — e.g. the host's delete flow closes the
    /// sheet once the user confirms; focus returns to the "More" trigger (the flag is consumed
    /// in OnAfterRenderAsync, so the restore survives a sibling surface that also disposes in
    /// the same render batch and would otherwise land focus on &lt;body&gt;).
    /// </summary>
    public Task CloseMoreAsync()
    {
        // Y2: a closed menu is a strict no-op — arming the focus restore unconditionally stole
        // focus from wherever the user was (review round 2, R2-M1 companion finding).
        if (!_moreOpen || _morePanel is null)
        {
            return Task.CompletedTask;
        }

        _focusMoreAfterClose = true;
        return _morePanel.SetOpenAsync(false);
    }

    /// <summary>Fires once per open, after the panel is actually displayed (the m3 contract).</summary>
    private void HandleMoreOpened()
    {
        // Sheet mode and popover mode both move focus to the first ENABLED menuitem, gated on
        // OnOpened so the focus cannot land on a still-hidden panel.
        _focusMoreItemPending = true;
    }

    /// <summary>
    /// The controlled panel's open-state callback (Y1): the single place that mirrors the panel's
    /// real state into <c>aria-expanded</c> — it fires for programmatic closes AND every user
    /// gesture (sheet Done, backdrop, swipe, Escape, outside pointer), which the uncontrolled
    /// <c>OnDismissed</c> path could not see.
    /// </summary>
    private void HandleMoreOpenChanged(bool open)
    {
        _moreOpen = open;
        if (!open)
        {
            _focusMoreItemPending = false;
        }
    }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (Placement == ActionBarPlacement.FixedViewport)
        {
            await ReportResolved();
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusMoreItemPending)
        {
            _focusMoreItemPending = false;
            try
            {
                await _firstMenuItem.FocusAsync();
            }
            catch (InvalidOperationException)
            {
                // The menu closed before the focus move (fast Escape): nothing to focus.
            }
        }

        if (_focusMoreAfterClose)
        {
            _focusMoreAfterClose = false;
            if (!_moreTriggerRendered)
            {
                // Y2: the trigger left the DOM (the bar hid or the overflow emptied) before the
                // restore could run — drop the flag instead of stealing focus later, whenever the
                // trigger happens to come back.
                return;
            }

            try
            {
                await _moreButton.FocusAsync(preventScroll: true);
            }
            catch (InvalidOperationException)
            {
                // The trigger left the DOM before the focus move: nothing to focus.
            }
        }
    }

    private Task OnResolvedLayoutChanged(TmLayoutMode mode) => ResolvedLayoutChanged.InvokeAsync(mode);

    private Task OnProbed(TmLayoutMode mode)
    {
        _layout.Measured(mode);
        OverlayLayout.HintOnce(LayoutLogger);
        return ReportResolved();
    }

    private Task ReportResolved() => _layout.ReportAsync(
        Context.Resolved, mode => ResolvedLayoutChanged.InvokeAsync(mode));

    /// <summary>
    /// The internal viewport probe, opened from C# because a Razor tag binds only to public
    /// components (an internal tag compiles to a literal element under a suppressed RZ10012).
    /// </summary>
    private RenderFragment Probe => builder =>
    {
        builder.OpenComponent<ViewportProbe>(0);
        builder.AddComponentParameter(1, nameof(ViewportProbe.OnMeasured),
            EventCallback.Factory.Create<TmLayoutMode>(this, OnProbed));
        builder.CloseComponent();
    };
}
