@namespace Tempo.Blazor.Components.Dropdowns
@using Tempo.Blazor.Abstractions.Layout
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Components.Overlay
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div @ref="_wrapperRef" class="tm-dropdown-wrapper @(Disabled ? "tm-dropdown-disabled" : "") @Class" @attributes="AdditionalAttributes">
    <button type="button"
            @ref="_triggerRef"
            class="tm-dropdown-trigger"
            aria-expanded="@_isOpen.ToString().ToLowerInvariant()"
            aria-haspopup="true"
            @onclick="Toggle">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <TmIcon Name="@Icon" Size="IconSize.Sm" />
        }
        <span>@Text</span>
        <TmIcon Name="@((_isOpen ? IconNames.ChevronUp : IconNames.ChevronDown))" Size="IconSize.Sm" />
    </button>

    @* The menu is a TmOverlayPanel: popover="manual" puts it in the browser top layer, so an
       ancestor's overflow (modal body, scrolling column) can no longer clip it, and overlay.js
       repositions it on scroll/resize, flipping above the trigger when there is no room below.
       On a narrow viewport (MobilePresentation=Auto) the same menu presents as a content-height
       bottom sheet titled with the trigger text. *@
    <TmOverlayPanel Anchor="_triggerRef"
                    IsOpen="_isOpen"
                    IsOpenChanged="SetOpen"
                    OnOpened="FocusFirstItemAsync"
                    Placement="Placement"
                    Align="Align"
                    Offset="Offset"
                    Role="menu"
                    Title="@(string.IsNullOrEmpty(Text) ? null : Text)"
                    MobilePresentation="MobilePresentation"
                    LayoutMode="LayoutMode"
                    InitialMode="InitialMode"
                    ResolvedLayoutChanged="ResolvedLayoutChanged"
                    Class="tm-dropdown-menu">
        <CascadingValue Value="this">
            @ChildContent
        </CascadingValue>
    </TmOverlayPanel>
</div>

@code {
    /// <summary>Trigger button label.</summary>
    [Parameter] public string Text { get; set; } = string.Empty;

    /// <summary>Optional leading icon on the trigger button.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Fires when a dropdown item is selected (value = item key).</summary>
    [Parameter] public EventCallback<string> OnSelect { get; set; }

    /// <summary>Menu content — typically TmDropdownItem elements.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Preferred side of the trigger the menu opens on. Default Bottom.</summary>
    [Parameter] public OverlayPlacement Placement { get; set; } = OverlayPlacement.Bottom;

    /// <summary>Cross-axis alignment of the menu against the trigger. Default Start.</summary>
    [Parameter] public OverlayAlign Align { get; set; } = OverlayAlign.Start;

    /// <summary>Gap in pixels between trigger and menu. Default 4.</summary>
    [Parameter] public int Offset { get; set; } = 4;

    /// <summary>
    /// How the menu presents on a narrow viewport. <see cref="PanelPresentation.Auto"/> follows the
    /// viewport scope: a content-height bottom sheet with the trigger text as its title on mobile,
    /// the anchored popover otherwise. A forced value renders that presentation without measuring.
    /// </summary>
    [Parameter] public PanelPresentation MobilePresentation { get; set; } = PanelPresentation.Auto;

    /// <summary>
    /// The layout the menu presentation resolves from. <see cref="TmLayoutMode.Auto"/> follows the
    /// viewport scope; a forced value never measures, so a test can render a mode without a DOM.
    /// </summary>
    [Parameter] public TmLayoutMode LayoutMode { get; set; } = TmLayoutMode.Auto;

    /// <summary>The layout rendered before the first measurement. Desktop unless the host says otherwise.</summary>
    [Parameter] public TmLayoutMode InitialMode { get; set; } = TmLayoutMode.Desktop;

    /// <summary>
    /// Raised when the resolved layout changes. The initial value is not a change. Never pair
    /// <see cref="LayoutMode"/> with this callback: it reports the resolved mode, and a two-way bind
    /// would pin that mode.
    /// </summary>
    [Parameter] public EventCallback<TmLayoutMode> ResolvedLayoutChanged { get; set; }

    /// <summary>Additional CSS class for the root element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Disables the dropdown.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Additional HTML attributes.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool _isOpen;
    private bool _focusTriggerAfterClose;
    private ElementReference _triggerRef;
    private ElementReference _wrapperRef;
    private IJSObjectReference? _menuNav;
    private bool _disposed;

    private void Toggle()
    {
        if (Disabled) return;
        _isOpen = !_isOpen;
    }

    private void SetOpen(bool open)
    {
        _isOpen = open;
    }

    /// <summary>Called by TmDropdownItem when an item is selected.</summary>
    public async Task SelectItemAsync(string value)
    {
        if (Disabled) return;
        // N319: close BEFORE invoking the handler. The menu is a top-layer popover — a dialog
        // the handler opens would render UNDER the still-open menu (and the first Escape would
        // close the menu, not the dialog). The yield lets the close re-render hide the popover.
        _isOpen = false;
        // docs/overlays.md rule 4: a selection close does not route through overlay.js, so the
        // dropdown restores focus to the trigger itself — otherwise a keyboard selection leaves
        // focus on <body> (review finding T3). FocusAsync lands in OnAfterRenderAsync, after the
        // close re-render (the pattern from docs/keyboard-activation-convention.md).
        _focusTriggerAfterClose = true;
        StateHasChanged();
        await Task.Yield();
        await OnSelect.InvokeAsync(value);
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusTriggerAfterClose)
        {
            return;
        }
        _focusTriggerAfterClose = false;
        try
        {
            await _triggerRef.FocusAsync(preventScroll: true);
        }
        catch (InvalidOperationException)
        {
            // The trigger left the DOM with the close (a conditional host): nothing to focus.
        }
    }

    /// <summary>
    /// A menu opened from the keyboard must hand focus to its first enabled item, or the roving keys
    /// (which listen on the menu) are unreachable. Fires once per open, after the panel is displayed;
    /// best-effort - without JS the menu keeps the native Tab order.
    /// </summary>
    private async Task FocusFirstItemAsync()
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            _menuNav ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Tempo.Blazor/js/tm-menu-nav.js");
            if (_disposed || _menuNav is null)
            {
                return;
            }

            await _menuNav.InvokeAsync<bool>("focusFirst", _wrapperRef);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException
            or ObjectDisposedException or InvalidOperationException)
        {
            // Best-effort: a torn-down circuit or a missing module must never fail the open.
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        var module = _menuNav;
        _menuNav = null;
        if (module is null)
        {
            return;
        }

        try
        {
            await module.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
        }
    }

    // No wrapper-level Escape handler: overlay.js consumes Escape in the window capture phase
    // and routes it through TmOverlayPanel.NotifyDismissedAsync — a bubbling handler on this
    // div could never run in a real browser (dead-branch sweep, N169 follow-up).
}
