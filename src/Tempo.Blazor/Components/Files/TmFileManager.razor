@namespace Tempo.Blazor.Components.Files
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Abstractions.Interfaces
@using Tempo.Blazor.Abstractions.Models
@using Tempo.Blazor.Abstractions.Shared
@inject ITmLocalizer Loc

<div class="tm-file-manager @(Disabled ? "tm-file-manager--disabled" : "") @Class" @attributes="AdditionalAttributes" tabindex="0" @onkeydown="HandleKeyDown">
    <!-- Toolbar — stopPropagation keeps toolbar keydowns out of the grid
         handler: these are native <button> elements, and a bubbled Enter would
         also open/delete the keyboard-focused item on top of the button's own
         click. -->
    <div class="tm-file-manager__toolbar" @onkeydown:stopPropagation="true">
        <div class="tm-file-manager__toolbar-group">
            @if (ShowNewFolderButton && !Disabled)
            {
                <button type="button" class="tm-file-manager__toolbar-button" @onclick="CreateFolderAsync">
                    <TmIcon Name="folder-plus" />
                    <span>@Loc["TmFileManager_NewFolder"]</span>
                </button>
            }
            @if (ShowUploadButton && !Disabled)
            {
                <label class="tm-file-manager__toolbar-button tm-file-manager__upload">
                    <TmIcon Name="upload" />
                    <span>@Loc["TmFileManager_Upload"]</span>
                    <InputFile style="display:none" multiple OnChange="HandleFileSelectedAsync" />
                </label>
            }
            @if (ShowDeleteButton && !Disabled)
            {
                <button type="button" class="tm-file-manager__toolbar-button" @onclick="DeleteSelectedAsync" disabled="@(_selectedItems.Count == 0)">
                    <TmIcon Name="trash" />
                    <span>@Loc["TmFileManager_Delete"]</span>
                </button>
            }
            @if (ShowRenameButton && !Disabled)
            {
                <button type="button" class="tm-file-manager__toolbar-button" @onclick="StartRenameAsync" disabled="@(_selectedItems.Count != 1)">
                    <TmIcon Name="edit" />
                    <span>@Loc["TmFileManager_Rename"]</span>
                </button>
            }
        </div>

        <div class="tm-file-manager__toolbar-group">
            <button type="button" class="tm-file-manager__view-toggle @(ViewMode == FileManagerViewMode.List ? "tm-file-manager__view-toggle--active" : "")" @onclick="() => SetViewMode(FileManagerViewMode.List)" title="@Loc["TmFileManager_ListView"]">
                <TmIcon Name="list" />
            </button>
            <button type="button" class="tm-file-manager__view-toggle @(ViewMode == FileManagerViewMode.Grid ? "tm-file-manager__view-toggle--active" : "")" @onclick="() => SetViewMode(FileManagerViewMode.Grid)" title="@Loc["TmFileManager_GridView"]">
                <TmIcon Name="grid" />
            </button>
        </div>
    </div>

    <!-- Breadcrumb — same isolation as the toolbar (native <button> items). -->
    <div class="tm-file-manager__breadcrumb" @onkeydown:stopPropagation="true">
        <button type="button" class="tm-file-manager__breadcrumb-root" @onclick="NavigateToRoot">
            <TmIcon Name="home" />
        </button>
        @foreach (var segment in _breadcrumbSegments)
        {
            <span class="tm-file-manager__breadcrumb-separator">/</span>
            <button type="button" class="tm-file-manager__breadcrumb-item" @onclick="() => NavigateTo(segment.Path)">
                @segment.Name
            </button>
        }
    </div>

    <!-- Main area: Sidebar + Content -->
    <div class="tm-file-manager__main">
        <!-- Folder Tree Sidebar -->
        @if (ShowFolderTree)
        {
            @* Same isolation as the toolbar: folder buttons are native
               <button> elements — keep their keys out of the grid handler. *@
            <div class="tm-file-manager__sidebar" @onkeydown:stopPropagation="true">
                <div class="tm-file-manager__sidebar-header">
                    <span class="tm-file-manager__sidebar-title">@Loc["TmFileManager_Folders"]</span>
                </div>
                <div class="tm-file-manager__folder-list">
                    @if (_folderTree is not null)
                    {
                        @foreach (var folder in _folderTree)
                        {
                            <button type="button"
                                    class="tm-file-manager__folder-item @GetFolderClass(folder)"
                                    @onclick="() => NavigateTo(folder.Path)">
                                <TmIcon Name="@(folder.Path == _currentPath ? "folder-open" : "folder")" />
                                <span>@folder.Name</span>
                            </button>
                        }
                    }
                </div>
            </div>
        }

        <!-- Content Area -->
        <div class="tm-file-manager__content tm-file-manager__content--@(_viewMode.ToString().ToLowerInvariant())" @ref="_contentRef">
            @if (_items.Count == 0)
            {
                <div class="tm-file-manager__empty">
                    <TmIcon Name="inbox" Class="tm-file-manager__empty-icon" />
                    <p class="tm-file-manager__empty-text">@Loc["TmFileManager_EmptyFolder"]</p>
                </div>
            }
            else
            {
                @foreach (var item in _items)
                {
                    <div class="tm-file-manager__item @GetItemClass(item)"
                         @onclick="(MouseEventArgs e) => HandleItemClickAsync(item, e)"
                         @ondblclick="() => OnItemDoubleClickAsync(item)">
                        <div class="tm-file-manager__item-icon">
                            <TmIcon Name="@GetItemIcon(item)" />
                        </div>
                        <div class="tm-file-manager__item-info">
                            @if (_renamingItem == item)
                            {
                                <input type="text" class="tm-file-manager__item-rename-input"
                                       @ref="_renameInputRef"
                                       @bind="_renameValue"
                                       @bind:event="oninput"
                                       @onblur="CommitRenameAsync"
                                       @onkeydown="HandleRenameKeyDown"
                                       @onkeydown:stopPropagation
                                       @onclick:stopPropagation />
                            }
                            else
                            {
                                <span class="tm-file-manager__item-name">@item.Name</span>
                            }
                            @if (ViewMode == FileManagerViewMode.List)
                            {
                                <span class="tm-file-manager__item-meta">
                                    @(item.IsDirectory ? Loc["TmFileManager_Folder"] : FormatSize(item.Size))
                                    @(item.ModifiedDate.HasValue ? $" • {item.ModifiedDate.Value:dd.MM.yyyy HH:mm}" : "")
                                </span>
                            }
                        </div>
                        @if (!item.IsDirectory && item.ScanStatus is FileScanStatus.Blocked)
                        {
                            <span class="tm-file-scan-badge tm-file-scan-badge--blocked"
                                  data-testid="@TestId("file-scan-blocked")"
                                  title="@(item.ScanMessage ?? Loc["TmFileScan_Blocked"])">@Loc["TmFileScan_Blocked"]</span>
                        }
                        else if (!item.IsDirectory && item.ScanStatus is FileScanStatus.Pending)
                        {
                            <span class="tm-file-scan-badge tm-file-scan-badge--pending"
                                  data-testid="@TestId("file-scan-pending")"
                                  title="@Loc["TmFileScan_Pending"]">@Loc["TmFileScan_Pending"]</span>
                        }
                        @if (ViewMode == FileManagerViewMode.List && !item.IsDirectory)
                        {
                            <span class="tm-file-manager__item-size">@FormatSize(item.Size)</span>
                        }
                    </div>
                }
            }
        </div>
    </div>

    @* Overlay layer: upload progress + dialogs contain native <button>s whose
       keydowns must not bubble into the grid handler (Enter on a dialog button
       would also open the focused item). *@
    <div @onkeydown:stopPropagation="true">
    <TmFileUploadProgress Uploads="_uploads"
                          OnCancel="CancelUploadAsync"
                          OnResume="ResumeUploadAsync"
                          OnDismiss="DismissUpload" />

    <!-- Delete Confirmation Dialog -->
    <TmDialog Type="DialogType.Confirm"
              Variant="DialogVariant.Warning"
              Show="@_showDeleteDialog"
              Title="@Loc["TmFileManager_DeleteTitle"]"
              Message="@string.Format(Loc["TmFileManager_DeleteMessage"], _itemsToDelete.Count)"
              OkButtonText="@Loc["TmFileManager_ConfirmDelete"]"
              CancelButtonText="@Loc["TmFileManager_CancelDelete"]"
              IsDangerous="true"
              OnResult="HandleDeleteDialogResult" />
    </div>

</div>
