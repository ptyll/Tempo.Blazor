@namespace Tempo.Blazor.Components.Icons

@if (_resolvedSvg is not null)
{
    <svg @attributes="AdditionalAttributes"
         class="@CssClass"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="@StrokeWidth.ToString(System.Globalization.CultureInfo.InvariantCulture)"
         stroke-linecap="round"
         stroke-linejoin="round"
         aria-hidden="true"
         focusable="false">
        @((MarkupString)_resolvedSvg)
    </svg>
}
else
{
    <span class="tm-icon-unknown" aria-hidden="true"></span>
}

@code {
    /// <summary>Icon name — use IconNames constants (e.g. IconNames.Check).</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    /// <summary>Display size of the icon.</summary>
    [Parameter] public IconSize Size { get; set; } = IconSize.Md;

    /// <summary>Color variant of the icon. Default inherits from parent (currentColor).</summary>
    [Parameter] public IconColor Color { get; set; } = IconColor.Current;

    /// <summary>SVG stroke-width. Default is 2.</summary>
    [Parameter] public double StrokeWidth { get; set; } = 2;

    /// <summary>Additional HTML attributes passed to the svg element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // Resolved SVG content: built-in path, registry content, or null (= fallback span)
    private string? _resolvedSvg;

    // Perf plan N9.3: icons are leaf components repeated ~35x in the document editor toolbar alone —
    // when nothing they display changed, skip the render entirely.
    private int? _lastRenderSignature;

    // Built-in resolution memo: the switch is evaluated once per distinct icon name for the app
    // lifetime (bounded by the finite set of names used).
    private static readonly System.Collections.Concurrent.ConcurrentDictionary<string, string?> BuiltInSvgCache =
        new(StringComparer.Ordinal);

    protected override void OnParametersSet()
    {
        ResolveSvg();
        // Blazor does not consult ShouldRender for the initial render -- seed the signature once so
        // the second render is compared against the first (not treated as a change).
        _lastRenderSignature ??= ComputeRenderSignature();
    }

    private void ResolveSvg()
    {
        var builtIn = BuiltInSvgCache.GetOrAdd(Name ?? string.Empty, static name =>
        {
            var svg = GetBuiltInSvg(name);
            return string.IsNullOrEmpty(svg) ? null : svg;
        });
        if (builtIn is not null)
        {
            _resolvedSvg = builtIn;
            return;
        }

        // Fallback 1: custom IconRegistry (direct dict or registered providers)
        var registered = IconRegistry.Resolve(Name);
        if (registered is not null)
        {
            _resolvedSvg = registered;
            return;
        }

        // Fallback 2: render <span class="tm-icon-unknown">
        _resolvedSvg = null;
    }

    protected override bool ShouldRender()
    {
        var signature = ComputeRenderSignature();
        if (_lastRenderSignature == signature)
        {
            return false;
        }

        _lastRenderSignature = signature;
        return true;
    }

    private int ComputeRenderSignature()
        => HashCode.Combine(
            Name,
            (int)Size,
            (int)Color,
            StrokeWidth,
            _resolvedSvg,
            AttributesContentHash(AdditionalAttributes));

    // Fáze 23 (code review N9.3): CaptureUnmatchedValues staví NOVÝ dictionary při každém parent
    // renderu — identity hash byl tedy pokaždé jiný a render gating pro ikony s extra atributy
    // tiše nefungoval. Hash se počítá z obsahu (pořadí-necitlivě přes XOR akumulaci).
    private static int AttributesContentHash(Dictionary<string, object>? attributes)
    {
        if (attributes is null || attributes.Count == 0)
        {
            return 0;
        }

        var hash = 0;
        foreach (var (key, value) in attributes)
        {
            hash ^= HashCode.Combine(key, value?.ToString());
        }

        return hash;
    }

    private string CssClass
    {
        get
        {
            var sizeClass = Size switch
            {
                IconSize.Xs => "tm-icon-xs",
                IconSize.Sm => "tm-icon-sm",
                IconSize.Md => "tm-icon-md",
                IconSize.Lg => "tm-icon-lg",
                IconSize.Xl => "tm-icon-xl",
                _           => "tm-icon-md"
            };
            var colorClass = Color switch
            {
                IconColor.Primary => "tm-icon-primary",
                IconColor.Danger  => "tm-icon-danger",
                IconColor.Success => "tm-icon-success",
                IconColor.Warning => "tm-icon-warning",
                IconColor.Muted   => "tm-icon-muted",
                _                 => "tm-icon-current"
            };
            return $"tm-icon {sizeClass} {colorClass}";
        }
    }

