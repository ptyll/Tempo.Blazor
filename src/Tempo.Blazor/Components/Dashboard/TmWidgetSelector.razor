@namespace Tempo.Blazor.Components.Dashboard
@using Tempo.Blazor.Abstractions.Layout
@using Tempo.Blazor.Helpers
@using Tempo.Blazor.Interfaces
@using Tempo.Blazor.Models
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Inputs

@* The selector is a TmModal surface (B12): dialog role, aria-modal, focus trap, Escape and the
   scroll lock come from the modal, which also presents as a bottom sheet on a mobile layout
   (F2 foundation). Fáze 6: the resolved layout — never a viewport media query — decides between
   the desktop/tablet category sidebar and the mobile chip radio group; the cards show a pastel
   category tile, a spaced size label and a persistent plus, and CloseOnSelect=false keeps the
   selector open while the added card flips to a green "Added" badge with a live announcement.
   The E2E/test contract class .tm-widget-selector-modal stays on the content root. *@
<TmModal Show="true"
         Size="ModalSize.XLarge"
         LayoutMode="LayoutMode"
         Title="@Loc["TmWidgetSelector_Title"]"
         Subtitle="@Loc["TmWidgetSelector_Subtitle"]"
         OnClose="OnClose">
    <ChildContent>
        @if (Viewport is null && LayoutMode == TmLayoutMode.Auto)
        {
            @* No viewport scope: measure like the modal does, so the sidebar/chip switch is not
               stuck on desktop for the first frame. Internal component — opened from C# (RZ10012). *@
            @Probe
        }
        <div class="tm-widget-selector-modal" data-layout="@Context.CssModifier">

            @* Search ──────────────────────────────────────────── *@
            <div class="tm-widget-selector-search">
                <TmSearchInput @bind-Value="_searchText"
                               Placeholder="@Loc["TmWidgetSelector_SearchPlaceholder"]" />
            </div>

            @* Content ─────────────────────────────────────────── *@
            <div class="tm-widget-selector-content">

                @* Category Sidebar (desktop + tablet) ──────────── *@
                @if (!IsMobile)
                {
                    <div class="tm-widget-selector-sidebar">
                        <div class="tm-widget-selector-categories">
                            <button type="button"
                                    class="tm-widget-selector-category @(_selectedCategory == null ? "tm-widget-selector-category--active" : "")"
                                    aria-pressed="@(_selectedCategory == null ? "true" : "false")"
                                    @onclick="() => SelectCategory(null)">
                                <TmIcon Name="grid" Size="IconSize.Sm" />
                                <span>@Loc["TmWidgetSelector_AllWidgets"]</span>
                                <span class="tm-widget-selector-count">@GetTotalWidgetCount()</span>
                            </button>

                            @foreach (var category in GetCategories())
                            {
                                var count = GetWidgetCountByCategory(category.Id);
                                if (count > 0)
                                {
                                    <button type="button"
                                            class="tm-widget-selector-category @(_selectedCategory == category.Id ? "tm-widget-selector-category--active" : "") @GetCategoryColorClass(category.Id)"
                                            aria-pressed="@(_selectedCategory == category.Id ? "true" : "false")"
                                            @onclick="() => SelectCategory(category.Id)"
                                            style="@GetCategoryColorStyle(category.Id)">
                                        <TmIcon Name="@category.Icon" Size="IconSize.Sm" />
                                        <span>@GetCategoryName(category)</span>
                                        <span class="tm-widget-selector-count">@count</span>
                                    </button>
                                }
                            }
                        </div>
                    </div>
                }
                else
                {
                    @* Category chips (mobile): a horizontal radio group with counts — filtering
                       stays reachable where the sidebar is hidden. Native buttons carry role=radio
                       + aria-checked; activation is the browser's own Enter/Space handling. *@
                    <div class="tm-widget-selector-chips" role="radiogroup"
                         aria-label="@Loc["TmWidgetSelector_Categories"]">
                        <button type="button" role="radio"
                                class="tm-widget-selector-chip"
                                aria-checked="@(_selectedCategory == null ? "true" : "false")"
                                @onclick="() => SelectCategory(null)">
                            <span>@Loc["TmWidgetSelector_AllWidgets"]</span>
                            <span class="tm-widget-selector-chip-count">@GetTotalWidgetCount()</span>
                        </button>

                        @foreach (var category in GetCategories())
                        {
                            var count = GetWidgetCountByCategory(category.Id);
                            if (count > 0)
                            {
                                <button type="button" role="radio"
                                        class="tm-widget-selector-chip @GetCategoryColorClass(category.Id)"
                                        aria-checked="@(_selectedCategory == category.Id ? "true" : "false")"
                                        @onclick="() => SelectCategory(category.Id)"
                                        style="@GetCategoryColorStyle(category.Id)">
                                    <TmIcon Name="@category.Icon" Size="IconSize.Sm" />
                                    <span>@GetCategoryName(category)</span>
                                    <span class="tm-widget-selector-chip-count">@count</span>
                                </button>
                            }
                        }
                    </div>
                }

                @* Widget Grid ────────────────────────────────────── *@
                <div class="tm-widget-selector-widgets">
                    @if (_filteredWidgets.Any())
                    {
                        <div class="tm-widget-selector-grid">
                            @foreach (var widget in _filteredWidgets)
                            {
                                @* A native button: Enter/Space activate it exactly once without
                                   emulation; a widget that cannot be added stays focusable and
                                   announces aria-disabled instead of being removed from the tab
                                   order. The card's children are phrasing content, and the
                                   description span is referenced by aria-describedby so the
                                   announced name stays the localized "Add {0}" instruction. *@
                                <button type="button"
                                        class="tm-widget-card @(!CanAddWidget(widget) ? "tm-widget-card--disabled" : "")"
                                        aria-disabled="@(CanAddWidget(widget) ? "false" : "true")"
                                        aria-label="@string.Format(Loc["TmWidgetSelector_AddWidgetAria"], widget.Name)"
                                        aria-describedby="@GetDescriptionId(widget)"
                                        @onclick="() => SelectWidget(widget)">

                                    <span class="tm-widget-card-icon @GetCategoryColorClass(widget.Category)" style="@GetCategoryColorStyle(widget.Category)" aria-hidden="true">
                                        <TmIcon Name="@ResolveWidgetIcon(widget)" Size="IconSize.Lg" />
                                    </span>

                                    <span class="tm-widget-card-info">
                                        <span class="tm-widget-card-title">@widget.Name</span>
                                        <span class="tm-widget-card-desc" id="@GetDescriptionId(widget)">@widget.Description</span>
                                        <span class="tm-widget-card-meta">
                                            <span class="tm-widget-card-size" aria-hidden="true">@widget.DefaultWidth × @widget.DefaultHeight</span>
                                            @if (GetAddedCount(widget) > 0)
                                            {
                                                <span class="tm-widget-card-badge tm-widget-card-badge--added">
                                                    <TmIcon Name="check" Size="IconSize.Sm" />
                                                    @(widget.AllowMultiple
                                                        ? string.Format(Loc["TmWidgetSelector_AddedCount"], GetAddedCount(widget))
                                                        : Loc["TmWidgetSelector_Added"])
                                                </span>
                                            }
                                        </span>
                                    </span>

                                    @if (CanAddWidget(widget))
                                    {
                                        @* The plus is always painted (never hover-revealed): a
                                           coarse pointer cannot hover, so an affordance that starts
                                           at opacity 0 would not exist for touch. *@
                                        <span class="tm-widget-card-add" aria-hidden="true">
                                            <TmIcon Name="plus" Size="IconSize.Sm" />
                                        </span>
                                    }
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="tm-widget-selector-empty">
                            <TmIcon Name="search" Size="IconSize.Xl" />
                            <p>@Loc["TmWidgetSelector_NoWidgets"]</p>
                            <span>@Loc["TmWidgetSelector_NoWidgetsHint"]</span>
                        </div>
                    }
                </div>
            </div>

            @* Polite live region: with CloseOnSelect=false the modal stays open, so the addition
               is announced here instead of through the closing surface. *@
            <div class="tm-widget-selector-live" role="status" aria-live="polite">@_liveMessage</div>
        </div>
    </ChildContent>
    <Footer>
        <div class="tm-widget-selector-footer">
            <span class="tm-widget-selector-hint">
                <TmIcon Name="info" Size="IconSize.Sm" />
                @Loc["TmWidgetSelector_Hint"]
            </span>
            <TmButton Variant="ButtonVariant.Primary" OnClick="OnClose">
                @Loc["TmWidgetSelector_Done"]
            </TmButton>
        </div>
    </Footer>
</TmModal>

@code {
    /// <summary>Registry of the widgets the host offers; null renders an empty selector.</summary>
    [Parameter] public IWidgetRegistry? WidgetRegistry { get; set; }

    /// <summary>Ids of the widgets already on the dashboard — single-instance ones among them cannot be added again.</summary>
    [Parameter] public List<string> ExistingWidgets { get; set; } = [];

    /// <summary>Raised when the user activates an addable widget card.</summary>
    [Parameter] public EventCallback<WidgetDefinition> OnSelect { get; set; }

    /// <summary>Raised when the selector should close (Escape, close button, Done, backdrop).</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Whether selecting a widget closes the selector. Defaults to <c>true</c> (the historical
    /// behaviour). With <c>false</c> the selector stays open: the added card flips to the green
    /// "Added" state, a multiple-instance widget grows an added counter, and a polite live region
    /// announces the addition (DA1).
    /// </summary>
    [Parameter] public bool CloseOnSelect { get; set; } = true;

    /// <summary>
    /// The layout the selector renders. <see cref="TmLayoutMode.Auto"/> follows the viewport scope;
    /// a forced value pins the presentation — including the mobile chip row and the bottom sheet —
    /// for tests and embedded hosts. Never a viewport media query.
    /// </summary>
    [Parameter] public TmLayoutMode LayoutMode { get; set; } = TmLayoutMode.Auto;

    private string _searchText = "";
    private string? _selectedCategory;
    private string _liveMessage = "";
    // Every add this session made, one entry per instance — a multiple-instance widget grows a
    // count (2 adds → "Added (2)") before the host echoes the ids back.
    private readonly List<string> _sessionAddedIds = [];

    /// <summary>The viewport's layout (a modal is positioned against the viewport, not a container).</summary>
    [CascadingParameter(Name = TmLayoutScopes.Viewport)] private TmLayoutContext? Viewport { get; set; }

    private readonly OverlayLayout _layout = new();

    /// <summary>
    /// The internal viewport probe, opened from C# because an internal tag compiles to a literal
    /// element (RZ10012) — the same route TmModal uses when no viewport scope cascades in.
    /// </summary>
    private RenderFragment Probe => builder =>
    {
        builder.OpenComponent<ViewportProbe>(0);
        builder.AddComponentParameter(1, nameof(ViewportProbe.OnMeasured),
            EventCallback.Factory.Create<TmLayoutMode>(this, mode => _layout.Measured(mode)));
        builder.CloseComponent();
    };

    /// <summary>
    /// The resolved layout — the same resolution the inner TmModal performs, so the sidebar/chip
    /// switch and the data-layout attribute never disagree with the sheet presentation.
    /// </summary>
    private TmLayoutContext Context => _layout.Resolve(LayoutMode, Viewport, TmLayoutMode.Desktop);

    private bool IsMobile => Context.IsMobile;

    private IEnumerable<WidgetDefinition> _filteredWidgets => FilterWidgets();

    private IEnumerable<WidgetDefinition> FilterWidgets()
    {
        if (WidgetRegistry is null) return Enumerable.Empty<WidgetDefinition>();

        var widgets = WidgetRegistry.GetAllWidgets();

        // Filter by category
        if (!string.IsNullOrEmpty(_selectedCategory))
        {
            widgets = widgets.Where(w => w.Category == _selectedCategory);
        }

        // Filter by search
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var term = _searchText.Trim().ToLowerInvariant();
            widgets = widgets.Where(w =>
                w.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (w.Description?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        return widgets.OrderBy(w => w.Category).ThenBy(w => w.Name);
    }

    private IEnumerable<WidgetCategory> GetCategories()
    {
        if (WidgetRegistry is null) return Enumerable.Empty<WidgetCategory>();
        return WidgetRegistry.GetCategories().OrderBy(c => c.Order);
    }

    // Localizes built-in category names by id; falls back to the model's Name for custom categories.
    private string GetCategoryName(WidgetCategory category)
    {
        var key = $"TmDashboard_Category_{category.Id}";
        var localized = Loc[key];
        return localized == key ? category.Name : localized;
    }

    private int GetTotalWidgetCount()
    {
        return WidgetRegistry?.GetAllWidgets().Count() ?? 0;
    }

    private int GetWidgetCountByCategory(string categoryId)
    {
        return WidgetRegistry?.GetWidgetsByCategory(categoryId).Count() ?? 0;
    }

    // Category → colour resolution lives in the shared DashboardCategoryStyles helper so the
    // dashboard's widget icon tile and this selector's cards/sidebar stay one colour per category.
    private static string GetCategoryColorClass(string categoryId)
        => DashboardCategoryStyles.GetColorClass(categoryId);

    private string GetCategoryColorStyle(string categoryId)
        => DashboardCategoryStyles.GetColorStyle(categoryId, GetCategories());

    // Icon resolution goes through the same shared helper as the dashboard's header tile, so a
    // definition with the model default ("widget") shows the Box glyph here too — not the
    // empty tm-icon-unknown span.
    private static string ResolveWidgetIcon(WidgetDefinition widget)
        => DashboardWidgetIcons.ResolveIcon(widget.Icon);

    private void SelectCategory(string? categoryId)
    {
        _selectedCategory = categoryId;
    }

    // How many instances of the widget are on the dashboard: the host's list plus the adds this
    // session made that the host has not echoed back yet (CloseOnSelect=false keeps the selector
    // open across renders, so the union must never double count).
    private int GetAddedCount(WidgetDefinition widget)
    {
        var hostCount = 0;
        foreach (var id in ExistingWidgets)
        {
            if (id == widget.Id) hostCount++;
        }

        foreach (var id in _sessionAddedIds)
        {
            if (id == widget.Id && !ExistingWidgets.Contains(id)) hostCount++;
        }

        return hostCount;
    }

    private bool CanAddWidget(WidgetDefinition widget)
    {
        if (widget.AllowMultiple) return true;
        return GetAddedCount(widget) == 0;
    }

    /// <summary>Id of the card's description span — the card button points at it via aria-describedby.</summary>
    private static string GetDescriptionId(WidgetDefinition widget) => $"tm-widget-card-desc-{widget.Id}";

    private async Task SelectWidget(WidgetDefinition widget)
    {
        if (!CanAddWidget(widget)) return;
        _sessionAddedIds.Add(widget.Id);
        await OnSelect.InvokeAsync(widget);

        if (CloseOnSelect)
        {
            await OnClose.InvokeAsync();
            return;
        }

        // DA1: stay open, flip the card to the added state and announce the addition politely.
        _liveMessage = widget.AllowMultiple
            ? string.Format(Loc["TmWidgetSelector_AddedCount"], GetAddedCount(widget))
            : string.Format(Loc["TmWidgetSelector_Added"], widget.Name);
    }
}
