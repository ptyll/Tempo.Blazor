@namespace Tempo.Blazor.Components.Dashboard
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Components.Forms
@using Tempo.Blazor.Interfaces
@using Tempo.Blazor.Models
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Components.Actions
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Feedback
@using Tempo.Blazor.Components.Inputs
@using Tempo.Blazor.Components.Overlay
@using Tempo.Blazor.Abstractions.Layout
@using System.Text.Json
@using Microsoft.JSInterop
@using Tempo.Blazor.Helpers
@implements IAsyncDisposable

<TmLayoutObserver LayoutMode="LayoutMode" InitialMode="InitialMode" ResolvedLayoutChanged="OnResolvedLayoutChanged" IsContainer="false" Class="tm-dashboard-layout">
<LayoutContent Context="mode">
@* A named region (F3): several dashboards on one page stay distinguishable. The h2 names it
   through aria-labelledby whenever it renders (even tm-sr-only); without a heading the resolved
   title falls back to aria-label. *@
<div class="tm-dashboard @(_isEditMode ? "tm-dashboard--edit" : "") @(IsCompactEditMode(mode) ? "tm-dashboard--compact-edit" : "") @AppearanceClass tm-dashboard--@mode.CssModifier @Class"
     data-layout="@mode.CssModifier"
     role="region"
     aria-labelledby="@(HasHeading ? _titleElementId : null)"
     aria-label="@(HasHeading ? null : HeaderTitle)"
     @ref="_dashboardElement">
    
    @* ── Toolbar ─────────────────────────────────────────────── *@
    @* ShowHeader=false hides the chrome in view mode; in edit mode the toolbar renders anyway —
       it is the only surface that carries Save/Cancel (edit mode is reachable through the empty
       state's CTA even with the header hidden). *@
    @if (ShowHeader || _isEditMode)
    {
    <div class="tm-dashboard-toolbar @ToolbarModifiers">
        <div class="tm-dashboard-toolbar-left">
            @if (HeaderStart is not null)
            {
                <div class="tm-dashboard-header-start">@HeaderStart</div>
            }
            @if (_isEditMode && _isEditingName)
            {
                @* Inline edit mode - always show name input. The form is the Enter-to-apply
                   contract (implicit submission, docs/keyboard-activation-convention.md) and Escape
                   is the container-level dismiss: it cancels the edit wherever focus sits inside. *@
                <form class="tm-dashboard-name-edit" @onsubmit="SaveNameEdit" @onsubmit:preventDefault
                      @onkeydown="HandleNameEditKeyDown">
                    <TmTextInput @bind-Value="_editingName"
                                 Placeholder="@Loc["TmDashboard_NamePlaceholder"]"
                                 Class="tm-dashboard-name-input"
                                 AutoFocus="true" />
                    <button type="submit" class="tm-btn tm-btn-primary tm-btn-sm"
                            title="@Loc["TmDashboard_ApplyName"]"
                            aria-label="@Loc["TmDashboard_ApplyName"]">
                        <TmIcon Name="check" Size="IconSize.Sm" />
                    </button>
                    <button type="button" class="tm-btn tm-btn-ghost tm-btn-sm" @onclick="CancelNameEdit"
                            title="@Loc["Tm_Cancel"]"
                            aria-label="@Loc["Tm_Cancel"]">
                        <TmIcon Name="x" Size="IconSize.Sm" />
                    </button>
                </form>
            }
            else if (_isEditMode)
            {
                @* Edit mode: the heading is always visible (the user must see what they rename).
                   With a host Title the h2 names the page and the dashboard's own name moves into
                   a secondary span next to it, so the rename pencil always sits by the text it edits. *@
                <div class="tm-dashboard-title-wrapper">
                    <h2 class="tm-dashboard-title" id="@_titleElementId">@HeaderTitle</h2>
                    @if (Title is not null)
                    {
                        <span class="tm-dashboard-name">@(_currentDashboard?.Name ?? Loc["TmDashboard_DefaultName"])</span>
                    }
                    <button type="button" class="tm-btn tm-btn-ghost tm-btn-icon tm-btn-sm"
                            @ref="_renameButton"
                            @onclick="StartNameEdit"
                            title="@Loc["TmDashboard_Rename"]"
                            aria-label="@Loc["TmDashboard_Rename"]">
                        <TmIcon Name="edit" Size="IconSize.Sm" />
                    </button>
                </div>
                <span class="tm-dashboard-edit-badge">@Loc["TmDashboard_EditMode"]</span>
            }
            else if (ShowTitle)
            {
                @* View mode: the heading names the page. Without a host Title the name already
                   shows in the switcher trigger, so the h2 stays in the DOM (screen readers and
                   existing selectors) but is visually hidden. *@
                var titleHidden = Title is null && DashboardProvider is not null;
                <div class="tm-dashboard-heading">
                    <h2 class="tm-dashboard-title @(titleHidden ? "tm-sr-only" : "")" id="@_titleElementId">@HeaderTitle</h2>
                    @if (!string.IsNullOrEmpty(Subtitle))
                    {
                        <p class="tm-dashboard-subtitle">@Subtitle</p>
                    }
                </div>
            }
            @if (!_isEditMode && DashboardProvider is not null)
            {
                <div class="tm-dashboard-views" @ref="_viewsElement">
                    @* Select-like trigger (F2): it shows the CURRENT dashboard's name, so the
                       accessible name must contain that visible text (WCAG 2.5.3) — hence the
                       formatted SwitcherAriaLabel instead of the bare word "Dashboards". *@
                    <button type="button" class="tm-dashboard-switcher"
                            @ref="_dashboardsButton"
                            id="@_dashboardsButtonId"
                            @onclick="ToggleDashboardMenu"
                            aria-haspopup="menu"
                            aria-expanded="@(_showDashboardMenu ? "true" : "false")"
                            aria-label="@string.Format(Loc["TmDashboard_SwitcherAriaLabel"], SwitcherName)">
                        <TmIcon Name="@IconNames.Grid" Size="IconSize.Sm" class="tm-dashboard-switcher__icon" />
                        <span class="tm-dashboard-switcher__label">@SwitcherName</span>
                        <TmIcon Name="@IconNames.ChevronDown" Size="IconSize.Sm" class="tm-dashboard-switcher__chevron" />
                    </button>
                    @if (_showDashboardMenu)
                    {
                            @* The menu is a TmOverlayPanel (the TmDropdown pattern): overlay.js puts
                               it in the browser top layer, positions it against the trigger and owns
                               the Escape/outside/Tab-out dismissal (focus returns to the anchor);
                               TmOverlayPanel attaches the shared tm-menu-nav module to this
                               Role="menu" panel, and OnOpened hands focus to the first item. Each
                               dashboard row is a role="none" wrapper around a NATIVE select button
                               and native per-row action buttons — Enter/Space activate natively,
                               exactly once per press (docs/keyboard-activation-convention.md).
                               Align=Start + MatchAnchorWidth: the trigger now sits on the LEFT of
                               the header and the menu at least spans it. MobilePresentation=Auto
                               (F3): the anchored popover on desktop/tablet, a bottom sheet with
                               the "Dashboards" title on a phone. *@
                            <TmOverlayPanel Anchor="_dashboardsButton"
                                            IsOpen="_showDashboardMenu"
                                            IsOpenChanged="SetDashboardMenuOpen"
                                            OnOpened="FocusFirstMenuItemAsync"
                                            Placement="OverlayPlacement.Bottom"
                                            Align="OverlayAlign.Start"
                                            MatchAnchorWidth="true"
                                            Role="menu"
                                            AriaLabelledBy="@_dashboardsButtonId"
                                            Title="@Loc["TmDashboard_Dashboards"]"
                                            MobilePresentation="PanelPresentation.Auto"
                                            Class="tm-dashboard-menu">
                                <div class="tm-dashboard-menu-header" role="presentation">
                                    <span>@Loc["TmDashboard_MyDashboards"]</span>
                                </div>
                                @foreach (var dash in _availableDashboards)
                                {
                                    var isCurrent = _currentDashboard?.Id == dash.Id;
                                    @* role="none": the row is layout only — its interactive children
                                       are real buttons the menu keyboard roves across. *@
                                    <div class="tm-dashboard-menu-item @(isCurrent ? "tm-dashboard-menu-item--active" : "")"
                                         role="none">
                                        <button type="button" role="menuitem" tabindex="-1"
                                                class="tm-dashboard-menu-item__select"
                                                aria-current="@(isCurrent ? "true" : null)"
                                                aria-describedby="@(dash.IsDefault ? $"{_dashboardsButtonId}-default-hint" : null)"
                                                @onclick="() => LoadDashboard(dash.Id)">
                                            <TmIcon Name="layout" Size="IconSize.Sm" />
                                            <span>@dash.Name</span>
                                        </button>
                                        <span class="tm-dashboard-menu-actions" role="presentation">
                                            @if (dash.IsDefault)
                                            {
                                                @* A visible text label marks the default dashboard:
                                                   the meaning ("default") is readable and the
                                                   absence of delete is explained by the hint row
                                                   below, not just a bare starred icon (Fáze 7). *@
                                                <span class="tm-dashboard-menu-default">
                                                    <TmIcon Name="star" Size="IconSize.Sm" />
                                                    @Loc["TmDashboard_Default"]
                                                </span>
                                            }
                                            else
                                            {
                                                @if (isCurrent)
                                                {
                                                    @* The actions carry the dashboard NAME (the row
                                                       no longer does), so a screen reader announces
                                                       which dashboard they target. *@
                                                    <button type="button" role="menuitem" tabindex="-1"
                                                            class="tm-dashboard-menu-action"
                                                            title="@string.Format(Loc["TmDashboard_SetAsDefaultNamed"], dash.Name)"
                                                            aria-label="@string.Format(Loc["TmDashboard_SetAsDefaultNamed"], dash.Name)"
                                                            @onclick="() => SetAsDefault(dash.Id)">
                                                        <TmIcon Name="star" Size="IconSize.Sm" />
                                                    </button>
                                                }
                                                <button type="button" role="menuitem" tabindex="-1"
                                                        class="tm-dashboard-menu-action tm-dashboard-menu-action--danger"
                                                        title="@string.Format(Loc["TmDashboard_DeleteNamed"], dash.Name)"
                                                        aria-label="@string.Format(Loc["TmDashboard_DeleteNamed"], dash.Name)"
                                                        @onclick="() => DeleteDashboard(dash.Id)">
                                                    <TmIcon Name="trash" Size="IconSize.Sm" />
                                                </button>
                                            }
                                        </span>
                                        @if (dash.IsDefault)
                                        {
                                            @* The hint is the LAST child of the row, not a child
                                               of the inline actions span: inside the actions it
                                               competes for the row width and squeezes the name to
                                               zero (ellipsised away). As a full-width second line
                                               it wraps under the name — and aria-describedby on
                                               the select button links it to the menuitem so
                                               screen readers hear it (Fáze 7). *@
                                            <span class="tm-dashboard-menu-default-hint"
                                                  id="@($"{_dashboardsButtonId}-default-hint")">@Loc["TmDashboard_DefaultCannotDelete"]</span>
                                        }
                                    </div>
                                }
                                <div class="tm-dashboard-menu-divider" role="separator"></div>
                                <button type="button" role="menuitem" tabindex="-1"
                                        class="tm-dashboard-menu-item tm-dashboard-menu-item--action"
                                        @onclick="() => CreateNewDashboard()">
                                    <TmIcon Name="plus" Size="IconSize.Sm" />
                                    <span>@Loc["TmDashboard_CreateNewDashboard"]</span>
                                </button>
                            </TmOverlayPanel>
                        }
                    </div>
                }
        </div>

        <div class="tm-dashboard-toolbar-right">
            @if (_isEditMode)
            {
                @* One primary element per region (F2 UX §2.4): "Save changes" is THE primary
                   action of edit mode; "Add widget" is secondary, "Cancel" ghost. *@
                <button type="button" class="tm-btn tm-btn-secondary" data-testid="@TestId("dashboard-add-widget")"
                        @ref="_addWidgetButton" @onclick="OpenWidgetSelector">
                    <TmIcon Name="plus" Size="IconSize.Sm" />
                    <span>@Loc["TmDashboard_AddWidget"]</span>
                </button>
                <button type="button" class="tm-btn tm-btn-primary" @onclick="SaveLayout">
                    <TmIcon Name="save" Size="IconSize.Sm" />
                    <span>@Loc["TmDashboard_SaveChanges"]</span>
                </button>
                <button type="button" class="tm-btn tm-btn-ghost" @onclick="CancelEdit">
                    <TmIcon Name="x" Size="IconSize.Sm" />
                    <span>@Loc["TmDashboard_CancelEdit"]</span>
                </button>
            }
            else
            {
                @* Host actions render BEFORE the Edit button: DOM order = tab order. *@
                @if (HeaderActions is not null)
                {
                    <div class="tm-dashboard-header-actions">@HeaderActions</div>
                }
                @if (AllowEdit)
                {
                    @* A native button because the focus return after edit mode needs @ref
                       (TmButton does not expose its ElementReference). The Edit entry is the
                       primary action of the view header, so no title on top of the visible text. *@
                    <button type="button" class="tm-btn tm-btn-primary"
                            @ref="_editButton"
                            data-testid="@TestId("dashboard-edit")"
                            @onclick="() => EnterEditMode()">
                        <TmIcon Name="@IconNames.Edit" Size="IconSize.Sm" />
                        <span>@Loc["TmDashboard_Edit"]</span>
                    </button>
                }
            }
        </div>
    </div>
    }

    @* ── Grid Container ───────────────────────────────────────── *@
    @if (_isEditMode && mode.IsDesktop)
    {
        @* F4: shared keyboard contract of every drag handle, referenced through aria-describedby. *@
        <p class="tm-sr-only" id="@_dragInstructionsId">@Loc["TmDashboard_DragHandleInstructions"]</p>
    }
    <div class="tm-dashboard-grid-container">
        <div class="tm-dashboard-grid"
             style="--grid-columns: @(_currentDashboard?.Grid.Columns ?? 12);
                    --row-height: @(_currentDashboard?.Grid.RowHeight ?? 60)px;
                    --grid-gap: @(_currentDashboard?.Grid.Gap ?? 16)px;">
            
            @* Grid Background (visible in edit mode) *@
            @if (_isEditMode && mode.IsDesktop)
            {
                <div class="tm-dashboard-grid-bg">
                    @for (int i = 0; i < (_currentDashboard?.Grid.Columns ?? 12); i++)
                    {
                        <div class="tm-dashboard-grid-col"></div>
                    }
                </div>
            }
            
            @* Widgets ───────────────────────────────────────────── *@
            @{
                // One sort per render drives both the DOM order below and the --tm-w-order values:
                // Tab and the screen reader follow the visual (Y, X) order in every mode (F3, M-2).
                // Positions change only at drop/resize end, which re-render right after — so no DOM
                // node moves under an active pointer, and @key preserves focus and child state.
                var (orderedWidgets, widgetOrder) = WidgetLayout();
            }
            @foreach (var widget in orderedWidgets)
            {
                var definition = WidgetRegistry?.GetWidget(widget.WidgetId);
                // Fáze 5: the JS resize clamps through these data-* attributes (grid cells,
                // emitted from the WidgetDefinition / GridConfig; max 0 = unlimited). The
                // authoritative clamp stays in C# — the values mirror it for the live preview.
                var minWidth = Math.Max(1, definition?.MinWidth ?? 1);
                var maxWidth = definition is { MaxWidth: > 0 } ? Math.Min(definition.MaxWidth, Columns) : Columns;
                var minHeight = Math.Max(1, definition?.MinHeight ?? 1);
                var maxHeight = definition is { MaxHeight: > 0 } ? definition.MaxHeight : 0;
                <div class="tm-widget @GetWidgetClasses(widget)"
                     style="@GetWidgetStyles(widget, widgetOrder)"
                     @key="widget.InstanceId"
                     data-instance-id="@widget.InstanceId"
                     data-min-w="@minWidth"
                     data-max-w="@maxWidth"
                     data-min-h="@minHeight"
                     data-max-h="@maxHeight">

                    @* Widget Header ───────────────────────────────── *@
                    @* Fáze 5: no @ondragstart/@ondragend here any more — the move gesture is the
                       shared pointer-drag.js helper attached by dashboard.js on the drag handle
                       (mouse, touch and pen). The handle button keeps the keyboard grab mode. *@
                    <div class="tm-widget-header">

                        <div class="tm-widget-header-left">
                            @if (_isEditMode && CanDrag(widget, mode))
                            {
                                @* F4: the drag handle is a real button — keyboard reachable, with a
                                   grab mode (Enter/Space, arrows, Shift+arrows, Escape) announced
                                   through the live region below. Enter/Space activate NATIVELY
                                   (onclick — never emulated, so the onkeydown arm keeps its hands
                                   off them); the onkeydown arm only emulates the NON-native keys
                                   (arrows/Shift+arrows/Escape) per the container-emulation half of
                                   docs/keyboard-activation-convention.md. Arrow keys may scroll the
                                   page while grabbed — the widget follows the announcement, and
                                   fencing the button would suppress the native Enter/Space click. *@
                                <button type="button"
                                        class="tm-widget-drag-handle"
                                        title="@Loc["TmDashboard_DragToMove"]"
                                        aria-label="@Loc["TmDashboard_DragToMove"]"
                                        aria-describedby="@_dragInstructionsId"
                                        aria-pressed="@(_grabbedWidget == widget ? "true" : "false")"
                                        data-instance-id="@widget.InstanceId"
                                        @onclick="() => ToggleGrab(widget)"
                                        @onkeydown="e => HandleHandleKeyDown(e, widget)">
                                    <TmIcon Name="grip-vertical" Size="IconSize.Sm" />
                                </button>
                            }
                            @if (IsCompactEditMode(mode) && IsDraggable(widget))
                            {
                                @* F4 compact edit mode (tablet portrait, mobile): reorder WITHOUT
                                    drag — Move up / Move down swap the card with its (Y, X)
                                    neighbour. The buttons are named for the widget they act on via
                                    aria-describedby (the title), like the collapse chevron. *@
                                <span class="tm-widget-move-group" role="group" aria-label="@GetWidgetName(widget)">
                                    <button type="button"
                                            class="tm-widget-btn tm-widget-move-btn tm-widget-move-btn--up"
                                            disabled="@(!CanMoveUp(widget))"
                                            aria-label="@Loc["TmDashboard_MoveUp"]"
                                            aria-describedby="@GetWidgetTitleId(widget)"
                                            title="@Loc["TmDashboard_MoveUp"]"
                                            @onclick="() => MoveWidgetUp(widget)">
                                        <TmIcon Name="chevron-up" Size="IconSize.Sm" />
                                    </button>
                                    <button type="button"
                                            class="tm-widget-btn tm-widget-move-btn tm-widget-move-btn--down"
                                            disabled="@(!CanMoveDown(widget))"
                                            aria-label="@Loc["TmDashboard_MoveDown"]"
                                            aria-describedby="@GetWidgetTitleId(widget)"
                                            title="@Loc["TmDashboard_MoveDown"]"
                                            @onclick="() => MoveWidgetDown(widget)">
                                        <TmIcon Name="chevron-down" Size="IconSize.Sm" />
                                    </button>
                                </span>
                            }
                            @if (ShowWidgetIcons)
                            {
                                @* 40px category tile (F2): the colour rides the shared
                                   tm-dashboard-category--{id} class (built-ins) or the inline
                                   --category-color (host categories), tinted with
                                   --tm-dashboard-category-tint over the surface. *@
                                <span class="tm-widget-icon @(definition is null ? "" : DashboardCategoryStyles.GetColorClass(definition.Category))"
                                      style="@(definition is null ? "" : DashboardCategoryStyles.GetColorStyle(definition.Category, GetCategories()))"
                                      aria-hidden="true">
                                    <TmIcon Name="@GetWidgetIcon(definition)" Size="IconSize.Md" />
                                </span>
                            }
                            <div class="tm-widget-heading">
                                <h3 class="tm-widget-title" id="@GetWidgetTitleId(widget)">@(widget.CustomTitle ?? GetWidgetName(widget))</h3>
                                @if (ShowWidgetDescriptions && !string.IsNullOrEmpty(definition?.Description))
                                {
                                    <p class="tm-widget-description" id="@GetWidgetDescriptionId(widget)">@definition!.Description</p>
                                }
                            </div>
                        </div>

                        <div class="tm-widget-header-actions">
                            @if (!_isEditMode)
                            {
                                @* Host slot before the chevron: DOM order = tab order; view mode
                                   only, because edit mode owns the header. *@
                                @if (WidgetHeaderActions is not null)
                                {
                                    <div class="tm-widget-host-actions">@WidgetHeaderActions(widget)</div>
                                }
                                @if (CanCollapse(widget))
                                {
                                    @* aria-describedby points at the widget title, so N identical
                                       "Collapse" controls are announced with the widget they act on. *@
                                    <button type="button" class="tm-widget-btn" @onclick="() => ToggleCollapse(widget)"
                                            aria-expanded="@(widget.IsCollapsed ? "false" : "true")"
                                            aria-controls="@(widget.IsCollapsed ? null : GetWidgetContentId(widget))"
                                            aria-describedby="@GetWidgetTitleId(widget)"
                                            title="@(widget.IsCollapsed ? Loc["TmDashboard_Expand"] : Loc["TmDashboard_Collapse"])"
                                            aria-label="@(widget.IsCollapsed ? Loc["TmDashboard_Expand"] : Loc["TmDashboard_Collapse"])">
                                        <TmIcon Name="@(widget.IsCollapsed ? "chevron-down" : "chevron-up")" Size="IconSize.Sm" />
                                    </button>
                                }
                            }
                            else
                            {
                                <button type="button" class="tm-widget-btn tm-widget-btn--danger"
                                        @onclick="() => RemoveWidget(widget)"
                                        aria-describedby="@GetWidgetTitleId(widget)"
                                        title="@Loc["TmDashboard_RemoveWidget"]"
                                        aria-label="@Loc["TmDashboard_RemoveWidget"]">
                                    <TmIcon Name="trash" Size="IconSize.Sm" />
                                </button>
                            }
                        </div>
                    </div>
                    
                    @* Widget Content ──────────────────────────────── *@
                    @if (!widget.IsCollapsed)
                    {
                        <div class="tm-widget-content" id="@GetWidgetContentId(widget)">
                            @RenderWidgetContent(widget)
                        </div>
                    }
                    
                    @* Resize Handles (edit mode only) ─────────────── *@
                    @* Fáze 5: no @onmousedown — the resize gesture is the shared pointer-drag.js
                       helper attached by dashboard.js (threshold 0, so every press on a handle
                       is a resize; Escape/pointercancel roll the widget back). *@
                    @if (_isEditMode && CanResize(widget, mode))
                    {
                        <div class="tm-widget-resize-handle tm-widget-resize-se"></div>
                        <div class="tm-widget-resize-handle tm-widget-resize-sw"></div>
                        <div class="tm-widget-resize-handle tm-widget-resize-ne"></div>
                        <div class="tm-widget-resize-handle tm-widget-resize-nw"></div>
                        <div class="tm-widget-resize-handle tm-widget-resize-e"></div>
                        <div class="tm-widget-resize-handle tm-widget-resize-w"></div>
                        <div class="tm-widget-resize-handle tm-widget-resize-s"></div>
                        <div class="tm-widget-resize-handle tm-widget-resize-n"></div>
                    }
                </div>
            }

        </div>
    </div>
    
    @* ── Empty State ─────────────────────────────────────────── *@
    @if (!_widgets.Any())
    {
        <div class="tm-dashboard-empty">
            <div class="tm-dashboard-empty-icon">
                <TmIcon Name="layout" Size="IconSize.Xl" />
            </div>
            <h3>@Loc["TmDashboard_NoWidgets"]</h3>
            <p>@Loc["TmDashboard_AddWidgets"]</p>
            @* The CTA is the empty state's main task, so it stays primary (a deliberate second
               primary beside the header Edit) — but only when editing is allowed at all; without
               AllowEdit the entry point would silently do nothing (F2 UX §5.6/§5.9). *@
            @if (!_isEditMode && AllowEdit)
            {
                <button type="button" class="tm-btn tm-btn-primary" @onclick="() => EnterEditMode()">
                    <TmIcon Name="plus" Size="IconSize.Sm" />
                    <span>@Loc["TmDashboard_AddWidgets"]</span>
                </button>
            }
        </div>
    }

    @* ── Live region (edit mode): grabs, moves, resizes, drops and cancels ── *@
    @if (_isEditMode)
    {
        <div class="tm-dashboard-live-region tm-sr-only" aria-live="polite" role="status">@_moveAnnouncement</div>
    }

    @* ── Mobile action bar (edit mode, mobile layout only) ────── *@
    @* The edit actions move from the wrapping toolbar into the component-scoped action bar
       (F5): 3 actions fit the bar, the rest would overflow into its "More" sheet. The desktop
       toolbar stays untouched; on mobile the data-layout rule hides it (see _dashboard.css). *@
    @if (_isEditMode && mode.IsMobile)
    {
        <TmMobileActionBar Items="@_editModeActions"
                           AriaLabel="@Loc["TmDashboard_EditMode"]"
                           data-testid="@TestId("dashboard-action-bar")" />
    }
</div>

@* ── Widget Selector Modal ───────────────────────────────────── *@
@if (_showWidgetSelector)
{
    <TmWidgetSelector
        WidgetRegistry="WidgetRegistry"
        ExistingWidgets="_widgets.Select(w => w.WidgetId).ToList()"
        CloseOnSelect="CloseOnSelect"
        OnSelect="OnWidgetSelected"
        OnClose="() => _showWidgetSelector = false" />
}

@* ── New Dashboard Name Modal ────────────────────────────────── *@
@* Auto presents this as a bottom sheet on a mobile viewport and a centered dialog otherwise. *@
<TmModal Show="_showNewDashboardDialog"
         Title="@Loc["TmDashboard_CreateNewDashboard"]"
         OnClose="CancelNewDashboard"
         RestoreFocusTarget="_dashboardsButton"
         RestoreFocusTargetId="@_dashboardsButtonId"
         InitialFocusTargetId="@_newDashboardNameId"
         ShowFooter="true"
         ShowDefaultFooterButtons="false"
         MobilePresentation="MobilePresentation.Auto"
         Class="tm-dashboard-create-modal">
    <ChildContent>
        @* The form is the Enter-to-create contract: implicit submission runs the same handler as
           the footer button (docs/keyboard-activation-convention.md — no emulated Enter on the input). *@
        <form @onsubmit="ConfirmCreateDashboard" @onsubmit:preventDefault>
            <TmFormField Label="@Loc["TmDashboard_DashboardName"]">
                <TmTextInput Id="@_newDashboardNameId"
                             @bind-Value="_newDashboardName"
                             AutoFocus="true"
                             Placeholder="@Loc["TmDashboard_NameExample"]" />
            </TmFormField>
        </form>
    </ChildContent>
    <Footer>
        @* Footer convention of the F2 foundation: Cancel secondary/outlined, Create primary —
           the sheet presentation splits the inline footer 50/50 with ≥48px touch targets. *@
        <TmButton Variant="ButtonVariant.Secondary" OnClick="CancelNewDashboard">@Loc["Tm_Cancel"]</TmButton>
        <TmButton Variant="ButtonVariant.Primary"
                  OnClick="ConfirmCreateDashboard"
                  Disabled="string.IsNullOrWhiteSpace(_newDashboardName)">@Loc["Tm_Create"]</TmButton>
    </Footer>
</TmModal>

@* ── Delete Dashboard Confirmation Dialog ───────────────────── *@
@* A destructive confirm stacks its buttons and presents as a sheet on a phone. *@
<TmDialog Type="DialogType.Confirm"
          Show="_showDeleteDialog"
          Title="@Loc["TmDashboard_DeleteDashboard"]"
          RestoreFocusTarget="_dashboardsButton"
          RestoreFocusTargetId="@_dashboardsButtonId"
          Message="@string.Format(Loc["TmDashboard_DeleteDashboardConfirm"], _dashboardToDeleteName)"
          OnResult="HandleDeleteDialogResult"
          OkButtonText="@Loc["Tm_Delete"]"
          CancelButtonText="@Loc["Tm_Cancel"]"
          IsDangerous="true"
          Icon="@IconNames.Trash2"
          MobilePresentation="MobilePresentation.Auto"
          FooterLayout="FooterLayout.Stacked" />
</LayoutContent>
</TmLayoutObserver>
