<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- NuGet Package Metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>Tempo.Blazor</PackageId>
<Version>2.8.23</Version>
    <Authors>ptyll</Authors>
    <Description>Comprehensive Blazor component library with 100+ components. Supports WebAssembly, Server, and InteractiveAuto render modes. Multi-targets .NET 8/9/10. Includes multilingual support (EN/CS), CSS variable theming, and dark mode. Optional FluentValidation integration is available through Tempo.Blazor.FluentValidation.</Description>
    <PackageTags>blazor;components;ui;server;wasm;interactive-auto;localization</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ptyll/Tempo.Blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ptyll/Tempo.Blazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="wwwroot\js\**\*.test.mjs" />
    <Content Remove="wwwroot\js\**\__tests__\**" />
    <Content Remove="wwwroot\js\**\*.md" />
    <None Include="wwwroot\js\**\*.test.mjs" Pack="false" Visible="false" />
    <None Include="wwwroot\js\**\__tests__\**" Pack="false" Visible="false" />
    <None Include="wwwroot\js\**\*.md" Pack="false" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="8.0.12" />
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="8.0.12" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.3" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.3" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="9.0.3" />
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.3" />
  </ItemGroup>

  <!-- Include README in NuGet package -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
    <None Include="AGENT.md" Pack="true" PackagePath="\" Condition="Exists('AGENT.md')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tempo.Blazor.Abstractions\Tempo.Blazor.Abstractions.csproj" />
  </ItemGroup>

  <!-- ═══ Localization: JSON resources embedded in the MAIN assembly ═══
       Component strings live in Resources/TmResources[.<culture>].json and are read by
       JsonTmStringLocalizer. JSON embedded in the main assembly resolves identically under Blazor
       Server and WebAssembly, unlike resx/ResourceManager (satellite assemblies are not loaded in
       the browser and the embedded neutral .resources is not resolved → raw keys under WASM). -->
  <ItemGroup>
    <!-- WithCulture=false stops the SDK inferring a culture from the ".cs."/".fr." in the file name
         (which would route them into satellite assemblies — exactly what breaks under WASM). All
         three embed into the main Tempo.Blazor.dll. -->
    <EmbeddedResource Include="Resources/TmResources.json">
      <WithCulture>false</WithCulture>
      <LogicalName>Tempo.Blazor.Resources.TmResources.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources/TmResources.cs.json">
      <WithCulture>false</WithCulture>
      <LogicalName>Tempo.Blazor.Resources.TmResources.cs.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources/TmResources.fr.json">
      <WithCulture>false</WithCulture>
      <LogicalName>Tempo.Blazor.Resources.TmResources.fr.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Tempo.Blazor.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- ═══ CSS Bundling: merge all @imports into a single file ═══ -->

  <ItemGroup>
    <CssBundleInputs Include="wwwroot\css\**\*.css" Exclude="wwwroot\css\tempo-blazor.bundled.css" />
  </ItemGroup>

  <UsingTask TaskName="BundleCss" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <InputFile ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
      <Minify ParameterType="System.Boolean" Required="false" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
try
{
    var content = File.ReadAllText(InputFile, System.Text.Encoding.UTF8);
    var baseDir = Path.GetDirectoryName(InputFile);
    var importRegex = new Regex(@"@import\s+[""']([^""']+)[""']\s*;");

    content = importRegex.Replace(content, match =>
    {
        var relativePath = match.Groups[1].Value;
        var fullPath = Path.GetFullPath(Path.Combine(baseDir, relativePath));
        if (File.Exists(fullPath))
        {
            var imported = File.ReadAllText(fullPath, System.Text.Encoding.UTF8);
            return "/* === " + relativePath + " === */\n" + imported;
        }
        Log.LogWarning("CSS import not found: " + fullPath);
        return match.Value;
    });

    if (Minify)
    {
        // Remove CSS comments (but not inside content: "..." strings)
        content = Regex.Replace(content, @"/\*[\s\S]*?\*/", "");
        // Collapse runs of whitespace to single space
        content = Regex.Replace(content, @"\s+", " ");
        // Remove space around structural characters.
        // '+' and '~' are DELIBERATELY absent from this class. They are sibling combinators
        // in a selector, but inside calc() they are ARITHMETIC operators, and css-values-3
        // §8.1 requires whitespace on BOTH sides of '+' and '-' there. Stripping it turned
        // every `calc(100% + 8px)` in the bundle into `calc(100%+8px)`, which is invalid and
        // makes the browser drop the whole declaration. Measured 30 such operators across 29
        // calc() expressions in the bundle this line was fixed in; the same measurement on
        // today's bundle gives 32, because _tabs.css has since gone back to deriving
        // --tm-tab-row-height with two additions of its own. 30 is what the defect WAS, 32 is
        // what reverting this line would break now - do not read either as a constant.
        // Leaving the space around a combinator is valid CSS and costs 96 bytes (48 operators
        // x 2 spaces). '>' stays: it is not a math operator, and no math function in the
        // bundle contains one. Guarded from the other side by CssBundleCalcWhitespaceTests,
        // which asserts on the COMMITTED BUNDLE, not on the sources - the sources were fine
        // all along, so a guard over them would have measured a permanently green population.
        content = Regex.Replace(content, @"\s*([{};:,>])\s*", "$1");
        // Restore newline after } for minimal readability
        content = content.Replace("}", "}\n");
        content = content.Trim();
    }

    Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
    File.WriteAllText(OutputFile, content, System.Text.Encoding.UTF8);
    Log.LogMessage(Microsoft.Build.Framework.MessageImportance.High,
        "CSS bundle created: " + OutputFile + " (" + content.Length + " bytes)");
}
catch (Exception ex)
{
    Log.LogError("BundleCss failed: " + ex.Message);
}
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="BundleCssFiles" BeforeTargets="ResolveProjectStaticWebAssets;GenerateNuspec;Pack" Inputs="wwwroot\css\tempo-blazor.css;@(CssBundleInputs)" Outputs="wwwroot\css\tempo-blazor.bundled.css">
    <BundleCss InputFile="$(MSBuildProjectDirectory)\wwwroot\css\tempo-blazor.css" OutputFile="$(MSBuildProjectDirectory)\wwwroot\css\tempo-blazor.bundled.css" Minify="true" />
  </Target>

  <!-- There is deliberately NO Clean-time delete of the bundled stylesheet.
       wwwroot\css\tempo-blazor.bundled.css is a TRACKED SOURCE, not a build artefact: five tests reach
       for it at its committed location - four read its content (TmSignatureCaptureTests,
       CodeEditorWrapStylesheetTests, CssBundleCalcWhitespaceTests, OrphanClassCssContractTests) and
       CssBundlerInputSourceTests asserts that it exists there at all - and
       CssBundleCalcWhitespaceTests asserts on the COMMITTED bundle on purpose. The former
       CleanBundledCss target ran a Delete BeforeTargets="Clean", which made `dotnet clean` leave the
       working tree with a tracked file missing, and — because the no-incremental build switch means
       Rebuild, i.e. Clean followed by Build — opened a window in which a dependent resolving Tempo's
       static web assets could find no file. That window was reported once, 2026-08-22; the MSB4018
       counts that used to stand here carried neither a commit nor a command to remeasure them, so
       they are DROPPED rather than restated. That window is state-dependent, not certain: measured
       2026-08-23 on efa8bc5c with the Delete still in place, `dotnet build TempoBlazor.slnx -c
       Release` with the no-incremental switch was rc=0 in 4 of 4 full runs. (That switch cannot be
       spelled out here: a double hyphen is illegal inside an XML comment and MSBuild refuses to load
       the project.) What IS deterministic, and is the reason
       this target is gone, was read out of a -v:d log of the same day: CleanBundledCss ran 4x and the
       first one logged the file's removal. Removing the delete does not stop the bundler, but it does
       change WHEN it runs: BundleCssFiles above is driven by its Inputs/Outputs, so a build over an
       up-to-date bundle now skips it (with the delete, the missing output forced a rebundle every
       time). Measured 2026-08-23: after `touch` of wwwroot/css/tokens.css the same full build logged
       "CSS bundle created" and the bundle's mtime moved, while its bytes - and therefore git status -
       did not change. -->

</Project>
