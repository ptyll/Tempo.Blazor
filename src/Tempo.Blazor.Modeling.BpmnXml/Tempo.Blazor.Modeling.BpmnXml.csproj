<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <PackageId>Tempo.Blazor.Modeling.BpmnXml</PackageId>
    <Version>2.11.0</Version>
    <!-- The exporter writes exporterVersion into every BPMN document; a commit-hash suffix would
         churn the committed export goldens on every commit. The same applies to the CI version
         stamp (-p:Version=<base>-ci-<timestamp> on main pushes in publish-nuget*.yml) —
         BpmnExportBuilder.ExporterVersion cuts every prerelease/build-metadata suffix off the
         informational version so exports stay reproducible across build environments. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>ptyll</Authors>
    <Title>Tempo.Blazor.Modeling.BpmnXml</Title>
    <Description>Headless BPMN 2.0 XML converter for Tempo.Blazor Modeling: deterministic, loss-reporting import of BPMN 2.0 XML into ModelingModelDto. Zero UI dependencies — safe to reference from API/service projects.</Description>
    <PackageTags>blazor;modeling;bpmn;bpmn2;xml;import;converter;headless</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ptyll/Tempo.Blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ptyll/Tempo.Blazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tempo.Blazor.Abstractions\Tempo.Blazor.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
